---
interface Props {
  contents: Array<{ id: string; label: string }>;
}
const { contents } = Astro.props;
---

{contents.length > 0 && (
  <nav class="documentation-contents" aria-label="On this page">
    <p>On this page</p>
    <ul>
      {contents.map(({ id, label }) => (
        <li><a href={`#${id}`}>{label}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  .documentation-contents { color: var(--sys-color-on-srf-variant); font-size: 0.875rem; line-height: 1.6; }
  p { color: var(--sys-color-on-srf); margin: 0 0 1rem; }
  ul { display: grid; gap: 0.5rem; padding: 0 0 0 1rem; margin: 0; list-style: none; border-left: 1px solid var(--sys-color-outline-variant); }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--sys-color-on-srf); text-decoration: underline; text-underline-offset: 0.2em; }
</style>
