---
import Menu from './ui/Menu.astro';

interface Props {
  contents: Array<{ id: string; label: string }>;
}
const { contents } = Astro.props;
---

{contents.length > 0 && (
  <nav class="documentation-contents" aria-label="On this page" data-documentation-contents>
    <p>On this page</p>
    <div class="documentation-contents__outline">
      <Menu as="ul" backplate={false}>
        {contents.map(({ id, label }) => (
          <li><a class="dev-btn dev-btn--ghost dev-btn--align-start dev-btn--fill dev-menu__item" href={`#${id}`}>{label}</a></li>
        ))}
      </Menu>
    </div>
  </nav>
)}

<script>
  import { createPageScope, onPageLoad } from '../lib/pageLifecycle';

  onPageLoad(() => {
    const navigation = document.querySelector('[data-documentation-contents]');
    if (!navigation) return;
    const entries = [...navigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
      .map(link => ({ link, heading: document.getElementById(link.getAttribute('href')!.slice(1)) }))
      .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => Boolean(entry.heading));
    if (!entries.length) return;
    const scope = createPageScope();
    let scheduled = false;
    const update = () => {
      scheduled = false;
      let current = entries[0];
      for (const entry of entries) {
        const offset = parseFloat(getComputedStyle(entry.heading).scrollMarginTop) || 0;
        if (entry.heading.getBoundingClientRect().top <= offset + 1) current = entry;
      }
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1) current = entries.at(-1)!;
      for (const entry of entries) {
        if (entry === current) entry.link.setAttribute('aria-current', 'location');
        else entry.link.removeAttribute('aria-current');
      }
    };
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      scope.frame(update);
    };
    scope.listen(window, 'scroll', schedule, { passive: true });
    scope.listen(window, 'resize', schedule);
    scope.listen(window, 'hashchange', schedule);
    update();
    return () => scope.destroy();
  });
</script>

<style>
  .documentation-contents { color: var(--sys-color-on-srf-variant); font-size: 0.875rem; line-height: 1.6; }
  p { color: var(--sys-color-on-srf); margin: 0 0 1rem; }
  .documentation-contents__outline { padding-left: 4px; border-left: 1px solid var(--sys-color-outline-variant); }
  a { white-space: normal; text-align: left; color: var(--sys-color-on-srf-variant); }
  a:hover, a[aria-current='location'] { color: var(--sys-color-on-srf); }
  a[aria-current='location']::after { content: ''; position: absolute; left: calc(-0.5rem - 1px); top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--sys-color-on-srf-variant); pointer-events: none; }
</style>
