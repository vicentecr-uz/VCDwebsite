---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SectionSidebarNav from './SectionSidebarNav.astro';
import ProjectImageCropTuner from './project/ProjectImageCropTuner.astro';
import ProjectImageGridTuner from './project/ProjectImageGridTuner.astro';
import '../styles/project.css';

type SectionLink = {
  id: string;
  label: string;
};

type SectionGroup = {
  label: string;
  children: SectionLink[];
  defaultOpen?: boolean;
};

interface Props {
  title: string;
  description: string;
  /** @deprecated Not shown on Webflow-style pages; kept for other project stubs */
  year?: string;
  tags?: string[];
  /** Widescreen section nav (same component as Styles). */
  sectionLinks?: Array<SectionLink | SectionGroup>;
  sectionNavLabel?: string;
}

const { title, description, sectionLinks, sectionNavLabel = 'Project sections' } = Astro.props;
const showDevTools = import.meta.env.DEV;
const hasSidebar = Array.isArray(sectionLinks) && sectionLinks.length > 0;
---

<Layout title={`${title} — Vicente Cruz`} description={description}>
  <div class="project-page flex flex-col min-h-dvh">
    <Header title={title} />

    {hasSidebar ? (
      <div class="project-layout flex-1">
        <SectionSidebarNav
          sectionLinks={sectionLinks}
          ariaLabel={sectionNavLabel}
          desktopOnly
          enableEasingDevPanel={false}
        />
        <main class="project-page__main">
          <slot />
        </main>
      </div>
    ) : (
      <main class="project-page__main flex-1">
        <slot />
      </main>
    )}

    <Footer />
  </div>
  {showDevTools && <ProjectImageCropTuner />}
  {showDevTools && <ProjectImageGridTuner />}
</Layout>
