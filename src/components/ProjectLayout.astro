---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SectionSidebarNav from './SectionSidebarNav.astro';
import ProjectImageGridTuner from './project/ProjectImageGridTuner.astro';
import ProjectImageCarouselTuner from './project/ProjectImageCarouselTuner.astro';
import ProjectImageCaptionTuner from './project/ProjectImageCaptionTuner.astro';
import ProjectSectionNavEditor from './project/ProjectSectionNavEditor.astro';
import ProjectCaptionShadow from './project/ProjectCaptionShadow.astro';
import {
  deriveNavFromOutline,
  resolveProjectOutline,
  type OutlineEntry,
  type SectionNavItem,
} from '../lib/projectOutline';
import '../styles/project.css';

interface Props {
  title: string;
  description: string;
  /** @deprecated Not shown on Webflow-style pages; kept for other project stubs */
  year?: string;
  tags?: string[];
  /**
   * Flat Obsidian-style outline (preferred). Sidebar tree is derived.
   * Falls back to `sectionLinks` when omitted.
   */
  outline?: OutlineEntry[];
  /** Derived or legacy nested sidebar tree. Prefer `outline`. */
  sectionLinks?: SectionNavItem[];
  sectionNavLabel?: string;
  /** Project JSON document key for DEV section-nav editing. */
  sectionNavDocument?: string;
}

const {
  title,
  description,
  outline: outlineProp,
  sectionLinks: sectionLinksProp,
  sectionNavLabel = 'Project sections',
  sectionNavDocument,
} = Astro.props;

const outline = resolveProjectOutline({
  outline: outlineProp,
  nav: sectionLinksProp,
});
const sectionLinks = sectionLinksProp?.length
  ? sectionLinksProp
  : deriveNavFromOutline(outline);

const showDevTools = import.meta.env.DEV;
const hasSidebar = Array.isArray(sectionLinks) && sectionLinks.length > 0;
const navDocument = sectionNavDocument ?? '';
---

<Layout title={`${title} — Vicente Cruz`} description={description}>
  <div
    class="project-page flex flex-col min-h-dvh"
    data-section-nav-root={hasSidebar ? '' : undefined}
    data-section-nav-document={hasSidebar && navDocument ? navDocument : undefined}
    data-section-nav={hasSidebar ? JSON.stringify(sectionLinks) : undefined}
    data-section-outline={hasSidebar ? JSON.stringify(outline) : undefined}
  >
    <Header title={title} wordmarkAsH1 />

    {hasSidebar ? (
      <div class="project-layout flex-1">
        <SectionSidebarNav
          sectionLinks={sectionLinks}
          ariaLabel={sectionNavLabel}
          desktopOnly
        />
        <main class="project-page__main" data-section-nav-main>
          <slot />
        </main>
      </div>
    ) : (
      <main class="project-page__main flex-1">
        <slot />
      </main>
    )}

    <Footer />
  </div>
  {showDevTools && <ProjectImageGridTuner />}
  {showDevTools && <ProjectImageCarouselTuner />}
  {showDevTools && <ProjectImageCaptionTuner />}
  {showDevTools && hasSidebar && navDocument && <ProjectSectionNavEditor />}
  <ProjectCaptionShadow />
</Layout>
