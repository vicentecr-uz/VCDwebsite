---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectImageCropTuner from './project/ProjectImageCropTuner.astro';
import '../styles/project.css';

interface Props {
  title: string;
  description: string;
  /** @deprecated Not shown on Webflow-style pages; kept for other project stubs */
  year?: string;
  tags?: string[];
}

const { title, description } = Astro.props;
const showDevTools = import.meta.env.DEV;
---

<Layout title={`${title} — Vicente Cruz`} description={description}>
  <div class="project-page flex flex-col min-h-dvh">
    <Header title={title} />

    <main class="project-page__main flex-1">
      <slot />
    </main>

    <Footer />
  </div>
  {showDevTools && <ProjectImageCropTuner />}
</Layout>
