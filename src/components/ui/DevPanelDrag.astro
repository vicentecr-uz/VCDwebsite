<script>
  import { onPageLoad, createPageScope } from '../../lib/pageLifecycle';

  const dispose = onPageLoad(() => {
    const scope = createPageScope();
    const ownObserver = <T extends { disconnect(): void }>(observer: T): T => {
      scope.add(() => observer.disconnect());
      return observer;
    };

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

  const initDraggableDevPanels = () => {
    document.querySelectorAll<HTMLElement>('[data-dev-panel-draggable]').forEach((panel) => {
      if (panel.dataset.devPanelDragInitialized === 'true') return;
      const dragHandle = panel.querySelector<HTMLElement>('[data-drag-handle]');
      if (!dragHandle) return;
      panel.dataset.devPanelDragInitialized = 'true';

      let pointerId: number | null = null;
      let startX = 0;
      let startY = 0;
      let originLeft = 0;
      let originTop = 0;
      let frame: number | null = null;
      let pendingLeft = 0;
      let pendingTop = 0;
      let userPositioned = false;
      let pendingReclamp = false;

      const clampPosition = (left: number, top: number) => ({
        left: clamp(left, 0, Math.max(0, window.innerWidth - panel.offsetWidth)),
        top: clamp(top, 0, Math.max(0, window.innerHeight - panel.offsetHeight)),
      });

      const applyPendingPosition = () => {
        frame = null;
        const next = clampPosition(pendingLeft, pendingTop);
        panel.style.translate = `${next.left - originLeft}px ${next.top - originTop}px`;
      };

      const schedulePosition = (left: number, top: number) => {
        pendingLeft = left;
        pendingTop = top;
        if (frame === null) frame = scope.frame(applyPendingPosition);
      };

      const commitPosition = (left: number, top: number) => {
        const next = clampPosition(left, top);
        if (frame !== null) cancelAnimationFrame(frame);
        frame = null;
        panel.style.translate = 'none';
        panel.style.left = `${next.left}px`;
        panel.style.top = `${next.top}px`;
        userPositioned = true;
        pendingReclamp = false;
      };

      const reclampPosition = () => {
        if (!panel.isConnected || panel.getClientRects().length === 0) {
          pendingReclamp = true;
          return;
        }
        pendingReclamp = false;
        const rect = panel.getBoundingClientRect();
        const next = clampPosition(rect.left, rect.top);
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
        panel.style.translate = 'none';
        panel.style.left = `${next.left}px`;
        panel.style.top = `${next.top}px`;
      };

      const anchorToLeftTop = () => {
        const rect = panel.getBoundingClientRect();
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
        panel.style.left = `${rect.left}px`;
        panel.style.top = `${rect.top}px`;
        panel.style.translate = 'none';
        return rect;
      };

      const endDrag = (event: PointerEvent) => {
        if (pointerId !== event.pointerId) return;
        commitPosition(originLeft + event.clientX - startX, originTop + event.clientY - startY);
        pointerId = null;
        panel.classList.remove('is-dragging');
        if (dragHandle.hasPointerCapture(event.pointerId)) dragHandle.releasePointerCapture(event.pointerId);
      };

      const cancelDrag = (event: PointerEvent) => {
        if (pointerId !== event.pointerId) return;
        commitPosition(pendingLeft, pendingTop);
        pointerId = null;
        panel.classList.remove('is-dragging');
        if (dragHandle.hasPointerCapture(event.pointerId)) dragHandle.releasePointerCapture(event.pointerId);
      };

      scope.listen(dragHandle, 'pointerdown', (event) => {
        if (pointerId !== null || event.button !== 0 || event.isPrimary === false || event.target instanceof Element && event.target.closest('[data-drag-ignore]')) return;
        event.preventDefault();
        const rect = anchorToLeftTop();
        const next = clampPosition(rect.left, rect.top);
        originLeft = next.left;
        originTop = next.top;
        pendingLeft = originLeft;
        pendingTop = originTop;
        panel.style.left = `${originLeft}px`;
        panel.style.top = `${originTop}px`;
        startX = event.clientX;
        startY = event.clientY;
        pointerId = event.pointerId;
        panel.classList.add('is-dragging');
        dragHandle.setPointerCapture(event.pointerId);
      });

      scope.listen(dragHandle, 'pointermove', (event) => {
        if (pointerId !== event.pointerId) return;
        schedulePosition(originLeft + event.clientX - startX, originTop + event.clientY - startY);
      });

      scope.listen(dragHandle, 'pointerup', endDrag);
      scope.listen(dragHandle, 'pointercancel', cancelDrag);
      scope.listen(dragHandle, 'lostpointercapture', (event: PointerEvent) => {
        if (pointerId !== event.pointerId) return;
        commitPosition(pendingLeft, pendingTop);
        pointerId = null;
        panel.classList.remove('is-dragging');
      });

      scope.listen(window, 'resize', () => {
        if (!userPositioned || pointerId !== null) return;
        reclampPosition();
      });

      ownObserver(new ResizeObserver(() => {
        if (!userPositioned || !pendingReclamp || pointerId !== null) return;
        reclampPosition();
      })).observe(panel);
    });
  };

  initDraggableDevPanels();
    return () => scope.destroy();
  });
  import.meta.hot?.dispose(dispose);
</script>
