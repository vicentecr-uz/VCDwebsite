---
interface Props {
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['ui-panel-actions', className]} {...rest}>
  <slot />
</div>

<style>
  .ui-panel-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    width: 100%;
    padding-top: var(--dev-panel-spacing);
  }
</style>
