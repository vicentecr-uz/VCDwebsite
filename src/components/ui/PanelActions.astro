---
interface Props {
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['ui-panel-actions', className]} {...rest}>
  <slot />
</div>

<style>
  .ui-panel-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5em;
    padding-top: 1em;
    border-top: 1px solid var(--sys-color-outline-variant);
  }
</style>
