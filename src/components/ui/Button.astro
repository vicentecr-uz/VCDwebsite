---
interface Props {
  emphasis?: 'ghost' | 'soft' | 'filled' | 'page' | 'danger';
  label: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  selected?: boolean;
  align?: 'center' | 'start';
  width?: 'hug' | 'fill';
  [key: string]: any;
}

const {
  emphasis = 'soft',
  label,
  type = 'button',
  disabled = false,
  selected = false,
  align = 'center',
  width = 'hug',
  class: className,
  ...rest
} = Astro.props;

const hasIcon = Astro.slots.has('icon');
---

<button
  type={type}
  disabled={disabled}
  aria-pressed={selected ? 'true' : undefined}
  class:list={[
    'ui-button',
    `ui-button--${emphasis}`,
    `ui-button--align-${align}`,
    { 'is-selected': selected, 'ui-button--fill': width === 'fill' },
    className,
  ]}
  {...rest}
>
  {hasIcon && (
    <span class="ui-button__icon">
      <slot name="icon" />
    </span>
  )}
  <slot>{label}</slot>
</button>

<style>
  .ui-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px;
    border: none;
    border-radius: var(--dev-radius-control);
    min-height: var(--dev-control-height);
    box-sizing: border-box;
    font: var(--dev-text-label);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease,
      transform var(--motion-press-duration) ease-out;
  }

  .ui-button::before {
    content: '';
    position: absolute;
    inset: calc(var(--dev-hit-inset) * -1);
  }

  .ui-button--align-start {
    justify-content: flex-start;
  }

  .ui-button--fill {
    width: 100%;
  }

  .ui-button__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  .ui-button__icon :global(svg) {
    display: block;
  }

  .ui-button:focus-visible {
    outline: 2px solid var(--sys-color-outline);
    outline-offset: 2px;
  }

  .ui-button:active:not(:disabled) {
    transform: scale(var(--motion-press-scale));
  }

  .ui-button:disabled {
    opacity: var(--dev-opacity-disabled);
    cursor: not-allowed;
    pointer-events: none;
  }

  .ui-button--ghost {
    background: var(--comp-button-ghost-container);
    color: var(--comp-button-label);
    min-width: 0;
  }

  .ui-button--ghost:hover,
  .ui-button--ghost.is-selected {
    background: var(--comp-button-ghost-container-hover);
  }

  .ui-button--ghost:active {
    background: var(--comp-button-ghost-container-pressed);
  }

  .ui-button--soft {
    background: var(--comp-button-soft-container);
    color: var(--comp-button-label);
    min-width: var(--dev-control-min-width);
  }

  .ui-button--soft:hover,
  .ui-button--soft.is-selected {
    background: var(--comp-button-soft-container-hover);
  }

  .ui-button--soft:active {
    background: var(--comp-button-soft-container-pressed);
  }

  .ui-button--filled {
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
    min-width: var(--dev-control-min-width);
  }

  .ui-button--filled:hover,
  .ui-button--filled:active {
    background: var(--comp-button-filled-container-hover);
  }

  .ui-button--page {
    background: var(--comp-button-page-container);
    color: var(--comp-button-label);
    min-width: var(--dev-control-min-width);
  }

  .ui-button--page:hover,
  .ui-button--page.is-selected {
    background: var(--comp-button-page-container-hover);
  }

  .ui-button--page:active {
    background: var(--comp-button-page-container-pressed);
  }

  .ui-button--danger {
    background: var(--comp-button-danger-container);
    color: var(--comp-button-danger-label);
    min-width: var(--dev-control-min-width);
  }

  .ui-button--danger:hover {
    background: var(--comp-button-danger-container-hover);
  }

  .ui-button--danger:active {
    background: var(--comp-button-danger-container-pressed);
  }
</style>
