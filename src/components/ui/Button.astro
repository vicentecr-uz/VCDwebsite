---
import '../../styles/dev-chrome.css';

interface Props {
  emphasis?: 'ghost' | 'soft' | 'filled' | 'page' | 'danger';
  label: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  selected?: boolean;
  align?: 'center' | 'start';
  width?: 'hug' | 'fill';
  [key: string]: any;
}

const {
  emphasis = 'soft',
  label,
  type = 'button',
  disabled = false,
  selected = false,
  align = 'center',
  width = 'hug',
  class: className,
  ...rest
} = Astro.props;

const hasIcon = Astro.slots.has('icon');
---

<button
  type={type}
  disabled={disabled}
  aria-pressed={selected ? 'true' : undefined}
  class:list={[
    'dev-btn',
    `dev-btn--${emphasis}`,
    `dev-btn--align-${align}`,
    { 'is-selected': selected, 'dev-btn--fill': width === 'fill' },
    className,
  ]}
  {...rest}
>
  {hasIcon && (
    <span class="dev-btn__icon">
      <slot name="icon" />
    </span>
  )}
  <slot>{label}</slot>
</button>
