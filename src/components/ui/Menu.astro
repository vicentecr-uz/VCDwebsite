---
import '../../styles/dev-chrome.css';

// Assemble a menu from Button rows (class="dev-menu__item", emphasis ghost,
// align start, width fill) and Hairline separators; the menu owns the spacing.
// size="page" is for menus opened from page-sized buttons (16px rows).
interface Props {
  size?: 'dev' | 'page';
  as?: 'div' | 'ul';
  backplate?: boolean;
  [key: string]: any;
}

const { size = 'dev', as: Tag = 'div', backplate = true, class: className, ...rest } = Astro.props;
---

<Tag class:list={['dev-menu', size === 'page' && 'dev-menu--page', !backplate && 'dev-menu--bare', className]} {...rest}>
  <slot />
</Tag>
