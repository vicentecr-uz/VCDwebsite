---
interface Props {
  label: string;
  [key: string]: any;
}

const { label, class: className, ...rest } = Astro.props;
---

<span class:list={['ui-badge', className]} {...rest}>{label}</span>

<style>
  .ui-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    /* 5px is a literal in Figma — no radius token exists for it. */
    border-radius: 5px;
    background: var(--comp-button-soft-container);
    color: var(--sys-color-on-srf);
    font: var(--dev-text-badge);
    white-space: nowrap;
  }
</style>
