---
import '../../styles/dev-chrome.css';

interface Props {
  title: string;
  layout?: 'portrait' | 'landscape';
  titleTag?: 'p' | 'h1';
  showLights?: boolean;
  /** Session-only header dragging for temporary panels. */
  draggable?: boolean;
  [key: string]: any;
}

const { title, layout = 'portrait', titleTag: Title = 'p', showLights = true, draggable = false, class: className, ...rest } = Astro.props;
const DragBehavior = draggable ? (await import('./DevPanelDrag.astro')).default : null;
---

<div class:list={['dev-panel', 'dev-surface', `dev-panel--${layout}`, className]} data-dev-panel-draggable={draggable || undefined} {...rest}>
  <header class="dev-panel__header" data-drag-handle={draggable || undefined}>
    <Title class="dev-panel__title">{title}</Title>
    {showLights && (
      <span class="dev-panel__lights" aria-hidden="true">
        <span class="dev-panel__light"></span>
        <span class="dev-panel__light"></span>
      </span>
    )}
  </header>
  <div class="dev-panel__body">
    <slot />
  </div>
</div>

{DragBehavior && <DragBehavior />}

<style>
  .dev-panel[data-dev-panel-draggable] [data-drag-handle] {
    min-height: 44px;
    touch-action: none;
    user-select: none;
    cursor: grab;
  }

  .dev-panel[data-dev-panel-draggable].is-dragging [data-drag-handle] {
    cursor: grabbing;
  }
</style>
