---
import '../../styles/dev-chrome.css';

interface Props {
  title: string;
  layout?: 'portrait' | 'landscape';
  [key: string]: any;
}

const { title, layout = 'portrait', class: className, ...rest } = Astro.props;
---

<div class:list={['dev-panel', `dev-panel--${layout}`, className]} {...rest}>
  <header class="dev-panel__header">
    <p class="dev-panel__title">{title}</p>
    <span class="dev-panel__lights" aria-hidden="true">
      <span class="dev-panel__light"></span>
      <span class="dev-panel__light"></span>
    </span>
  </header>
  <div class="dev-panel__body">
    <slot />
  </div>
</div>
