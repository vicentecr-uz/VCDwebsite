---
interface Props {
  title: string;
  [key: string]: any;
}

const { title, class: className, ...rest } = Astro.props;
---

<div class:list={['ui-dev-panel', className]} {...rest}>
  <header class="ui-dev-panel__header">
    <h2>{title}</h2>
  </header>
  <div class="ui-dev-panel__body">
    <slot />
  </div>
</div>

<style>
  .ui-dev-panel {
    width: 352px;
    background: var(--sys-color-srf-container-low);
    border: 1px solid var(--sys-color-outline);
    border-radius: var(--radius-control);
    overflow: hidden;
  }

  .ui-dev-panel__header {
    padding: 1em;
    border-bottom: 1px solid var(--sys-color-outline);
  }

  .ui-dev-panel__header h2 {
    margin: 0;
    font-size: 0.92em;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sys-color-on-srf);
  }

  .ui-dev-panel__body {
    padding: 1em;
  }
</style>
