---
interface Props {
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<span class:list={['ui-hairline', className]} role="presentation" {...rest} />

<style>
  /* Figma's Hairline description names sys.color.outline-variant, but the
     node's actual fill binding resolves to #d3d3d6 = sys.color.outline;
     the binding is what LGTM renders, so it wins here. */
  .ui-hairline {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--sys-color-outline);
  }
</style>
