---
import '../../styles/dev-chrome.css';

interface Props {
  orientation?: 'horizontal' | 'vertical';
  [key: string]: any;
}

const { orientation = 'horizontal', class: className, ...rest } = Astro.props;
---

<span
  class:list={['dev-hairline', orientation === 'vertical' && 'dev-hairline--vertical', className]}
  role="presentation"
  {...rest}
/>
