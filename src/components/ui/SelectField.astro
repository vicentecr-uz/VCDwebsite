---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';
import { sizeIcon } from '../../lib/icons';

type SelectOption = { value: string; label: string; icon?: string };
type SelectGroup = { label: string; options: SelectOption[] };

interface Props {
  label: string;
  options: Array<SelectOption | SelectGroup>;
  value?: string;
  disabled?: boolean;
  hidden?: boolean;
  hideLabel?: boolean;
  [key: string]: any;
}

const {
  label,
  options,
  value,
  disabled = false,
  hidden,
  hideLabel = false,
  class: className,
  id: providedId,
  ...rest
} = Astro.props;

const fieldRest: Record<string, unknown> = {};
const selectRest: Record<string, unknown> = {};

for (const [key, propValue] of Object.entries(rest)) {
  if (key === 'data-caption-overlay-only' || key.endsWith('-wrap')) {
    fieldRest[key] = propValue;
  } else {
    selectRest[key] = propValue;
  }
}

const isGroup = (item: SelectOption | SelectGroup): item is SelectGroup =>
  Array.isArray((item as SelectGroup).options);

// The trigger needs a stable id for aria-controls / aria-activedescendant
// and so Field can point a real <label for> at it via labelFor.
const triggerId = typeof providedId === 'string' && providedId
  ? providedId
  : `dev-select-${Math.random().toString(36).slice(2, 9)}`;
const listboxId = `${triggerId}-listbox`;

type FlatOption = { value: string; label: string; iconSvg: string | null };

const flatOptions: FlatOption[] = [];
for (const item of options) {
  const source = isGroup(item) ? item.options : [item];
  for (const opt of source) {
    flatOptions.push({
      value: opt.value,
      label: opt.label,
      iconSvg: opt.icon ? sizeIcon(opt.icon, 16) : null,
    });
  }
}

const selectedOption = flatOptions.find((opt) => opt.value === value) ?? flatOptions[0] ?? null;
---

<Field label={label} labelId={`${triggerId}-label`} labelFor={triggerId} class={[className, hideLabel ? 'dev-field--no-label' : null]} hidden={hidden} {...fieldRest}>
  <slot name="labelAccessory" slot="labelAccessory" />
  <select
    disabled={disabled}
    class="dev-select__native"
    tabindex="-1"
    aria-hidden="true"
    {...selectRest}
  >
    {options.map((item) =>
      isGroup(item) ? (
        <optgroup label={item.label}>
          {item.options.map((opt) => <option value={opt.value} selected={opt.value === selectedOption?.value} data-icon-svg={opt.icon ? sizeIcon(opt.icon, 16) : undefined}>{opt.label}</option>)}
        </optgroup>
      ) : (
        <option value={item.value} selected={item.value === selectedOption?.value} data-icon-svg={item.icon ? sizeIcon(item.icon, 16) : undefined}>{item.label}</option>
      ),
    )}
  </select>
  <button
    type="button"
    id={triggerId}
    class="dev-field__input dev-field__input--select dev-select__trigger"
    disabled={disabled}
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-label={hideLabel ? label : undefined}
    aria-labelledby={hideLabel ? undefined : `${triggerId}-label`}
    data-dev-select-trigger
  >
    <span class="dev-select__trigger-icon" data-dev-select-icon aria-hidden="true" set:html={selectedOption?.iconSvg ?? ''} />
    <span class="dev-select__trigger-label" data-dev-select-label>{selectedOption?.label ?? ''}</span>
  </button>
  <ul
    class="dev-select__listbox"
    role="listbox"
    aria-labelledby={`${triggerId}-label`}
    id={listboxId}
    popover="manual"
    data-dev-select-listbox
  >
    {flatOptions.map((opt, index) => (
      <li
        role="option"
        id={`${triggerId}-option-${index}`}
        class="dev-btn dev-btn--ghost dev-btn--align-start dev-btn--fill dev-select__option"
        aria-selected={opt.value === selectedOption?.value ? 'true' : 'false'}
        data-value={opt.value}
      >
        {opt.iconSvg && <span class="dev-select__option-icon" aria-hidden="true" set:html={opt.iconSvg} />}
        <span class="dev-select__option-label">{opt.label}</span>
      </li>
    ))}
  </ul>
</Field>

<script>
  import { initSelectFields } from '../../lib/selectField';

  const lifecycle = new AbortController();
  let dispose: (() => void) | undefined;
  const cleanup = () => {
    dispose?.();
    dispose = undefined;
  };
  const init = () => {
    cleanup();
    dispose = initSelectFields();
  };

  init();
  document.addEventListener('astro:before-swap', cleanup, { signal: lifecycle.signal });
  document.addEventListener('astro:page-load', init, { signal: lifecycle.signal });
  window.addEventListener('pagehide', cleanup, { signal: lifecycle.signal });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) init();
  }, { signal: lifecycle.signal });
  import.meta.hot?.dispose(() => {
    cleanup();
    lifecycle.abort();
  });
</script>
