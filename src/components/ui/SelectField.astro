---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';

interface Props {
  label: string;
  options: { value: string; label: string }[];
  value?: string;
  disabled?: boolean;
  [key: string]: any;
}

const { label, options, value, disabled = false, class: className, ...rest } = Astro.props;
---

<Field label={label} class={className}>
  <select value={value} disabled={disabled} class="dev-field__input dev-field__input--select" {...rest}>
    {options.map((opt) => <option value={opt.value}>{opt.label}</option>)}
  </select>
</Field>
