---
import Field from './Field.astro';

interface Props {
  label: string;
  id: string;
  unit?: string;
  /** compact: the label sits inside the track and the value is right-aligned; no label row. */
  variant?: 'default' | 'compact';
  [key: string]: any;
}

const { label, id, unit = '', variant = 'default', class: className, ...rest } = Astro.props;
const compact = variant === 'compact';
const labelId = `${id}-label`;
---

<Field label={label} labelId={labelId} labelFor={id} class:list={['dev-field--range', compact && 'dev-field--no-label', className]}>
  <Fragment slot="labelAccessory"><slot name="labelAccessory" /></Fragment>
  <div class:list={['dev-range-field', compact && 'dev-range-field--compact']} data-dev-range-field>
    {compact && <span class="dev-range-field__label" aria-hidden="true">{label}</span>}
    <output class="dev-range-field__output" for={id} data-range-output>{unit}</output>
    <input
      {...rest}
      id={id}
      class="dev-range-field__input"
      type="range"
      aria-labelledby={labelId}
      data-range-unit={unit}
    />
    <span class="dev-range-field__edit" data-range-edit>
      <input type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label={`${label} value`} data-native-text-field />
      {unit && <span aria-hidden="true">{unit}</span>}
    </span>
  </div>
</Field>

<script>
  import { createPageScope, onPageLoad } from '../../lib/pageLifecycle';

  const format = (input: HTMLInputElement) => {
    const min = Number(input.min);
    const max = Number(input.max || 100);
    const value = Number(input.value);
    const progress = max > min ? (value - min) / (max - min) : 0;
    const unit = input.dataset.rangeUnit || '';
    const output = input.parentElement?.querySelector<HTMLOutputElement>('[data-range-output]');
    const valueText = `${input.value}${unit}`;
    input.parentElement?.style.setProperty('--range-progress', String(progress));
    input.setAttribute('aria-valuetext', valueText);
    if (output) output.textContent = valueText;
    const edit = input.parentElement?.querySelector<HTMLInputElement>('[data-range-edit] input');
    if (edit && !input.parentElement?.classList.contains('is-editing')) {
      edit.value = input.value;
      edit.style.width = `${Math.max(1, input.value.length)}ch`;
    }
  };

  // Pressing anywhere on the track grips the thumb where it is; the value moves by how far the pointer travels.
  const bindGrip = (input: HTMLInputElement, scope: ReturnType<typeof createPageScope>) => {
    let grip: { id: number; x: number; value: number; changed: boolean } | undefined;
    const emit = (type: string) => input.dispatchEvent(new (input.ownerDocument.defaultView ?? window).Event(type, { bubbles: true }));
    // The native control would jump the thumb to the pointer.
    scope.listen(input, 'mousedown', (event) => { if (event.button === 0) event.preventDefault(); });
    scope.listen(input, 'pointerdown', (event) => {
      if (event.button !== 0 || input.disabled) return;
      grip = { id: event.pointerId, x: event.clientX, value: Number(input.value), changed: false };
      input.setPointerCapture(event.pointerId);
      input.focus({ preventScroll: true });
    });
    scope.listen(input, 'pointermove', (event) => {
      if (!grip || event.pointerId !== grip.id) return;
      const min = Number(input.min || 0);
      const max = Number(input.max || 100);
      const step = Number(input.step) || 1;
      const travel = Math.max(1, input.getBoundingClientRect().width - 16);
      const raw = grip.value + (event.clientX - grip.x) / travel * (max - min);
      const next = String(Math.min(max, Math.max(min, min + Math.round((raw - min) / step) * step)));
      if (next === input.value) return;
      input.value = next;
      grip.changed = true;
      emit('input');
    });
    const release = (event: PointerEvent) => {
      if (!grip || event.pointerId !== grip.id) return;
      const changed = grip.changed;
      grip = undefined;
      if (changed) emit('change');
    };
    scope.listen(input, 'pointerup', release);
    scope.listen(input, 'pointercancel', release);
  };

  // Click the value to type one: Enter or clicking away commits, Escape puts the old value back.
  const bindEdit = (input: HTMLInputElement, scope: ReturnType<typeof createPageScope>) => {
    const field = input.parentElement;
    const wrap = field?.querySelector<HTMLElement>('[data-range-edit]');
    const edit = wrap?.querySelector<HTMLInputElement>('input');
    if (!field || !wrap || !edit) return;
    let stopKeys: (() => void) | undefined;
    const finish = (commit: boolean) => {
      if (!field.classList.contains('is-editing')) return;
      field.classList.remove('is-editing');
      stopKeys?.();
      stopKeys = undefined;
      const typed = Number.parseFloat(edit.value);
      if (commit && Number.isFinite(typed)) {
        const min = Number(input.min || 0);
        const max = Number(input.max || 100);
        const step = Number(input.step) || 1;
        const next = String(Math.min(max, Math.max(min, min + Math.round((typed - min) / step) * step)));
        if (next !== input.value) {
          const View = input.ownerDocument.defaultView ?? window;
          input.value = next;
          input.dispatchEvent(new View.Event('input', { bubbles: true }));
          input.dispatchEvent(new View.Event('change', { bubbles: true }));
        }
      }
      format(input);
      if (edit.ownerDocument.activeElement === edit) edit.blur();
    };
    scope.listen(wrap, 'pointerdown', (event) => {
      if (event.target === edit || input.disabled) return;
      event.preventDefault();
      edit.focus();
    });
    scope.listen(edit, 'focus', () => {
      if (input.disabled) { edit.blur(); return; }
      field.classList.add('is-editing');
      edit.select();
      // The window hears keys before any page-level Escape handling can blur the field and commit it.
      const view = edit.ownerDocument.defaultView ?? window;
      const onKey = (event: KeyboardEvent) => {
        if (event.key !== 'Enter' && event.key !== 'Escape') return;
        event.preventDefault();
        event.stopImmediatePropagation();
        finish(event.key === 'Enter');
      };
      view.addEventListener('keydown', onKey, true);
      stopKeys = () => view.removeEventListener('keydown', onKey, true);
    });
    scope.listen(edit, 'input', () => { edit.style.width = `${Math.max(1, edit.value.length)}ch`; });
    scope.listen(edit, 'blur', () => finish(true));
    scope.add(() => stopKeys?.());
  };

  const dispose = onPageLoad(() => {
    const scope = createPageScope();
    document.querySelectorAll<HTMLInputElement>('[data-dev-range-field] input[type="range"]').forEach((input) => {
      scope.listen(input, 'input', () => format(input));
      scope.listen(input, 'change', () => format(input));
      scope.listen(input, 'vcd:range-refresh', () => format(input));
      bindGrip(input, scope);
      bindEdit(input, scope);
      format(input);
    });
    return () => scope.destroy();
  });
  import.meta.hot?.dispose(dispose);
</script>

<style>
  :global(.dev-field--range > .dev-field__value),
  :global(.dev-field.dev-field--range:hover:not(.dev-field--quiet) > .dev-field__value),
  :global(.dev-field.dev-field--range > .dev-field__value:has(:focus-visible)) {
    padding: 0;
    background: transparent;
    --on-surface-faint: var(--sys-color-on-srf-container-faint);
  }

  .dev-range-field {
    --range-thumb-width: 4px;
    --range-track-inset: 8px;
    --range-fill-color: var(--sys-color-srf-container-high);
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--dev-control-height);
    overflow: hidden;
    border-radius: inherit;
    corner-shape: inherit;
    /* Track and fill are one painted shape, so no second rounded edge shows the track through at the
       corners. The fill runs one inset past the thumb and meets the far edge at the maximum. */
    --range-fill-end: calc(2 * var(--range-track-inset) + (100% - 2 * var(--range-track-inset)) * var(--range-progress, 0));
    background: linear-gradient(to right, var(--range-fill-color) var(--range-fill-end), var(--comp-field-container) var(--range-fill-end));
  }

  .dev-range-field::after {
    content: '';
    position: absolute;
    pointer-events: none;
    top: 50%;
    left: calc(var(--range-track-inset) + (100% - 2 * var(--range-track-inset)) * var(--range-progress, 0));
    width: var(--range-thumb-width);
    height: 20px;
    translate: -50% -50%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--sys-color-on-srf-subtle) 70%, var(--range-fill-color));
  }

  .dev-range-field__output {
    position: absolute;
    inset-inline-start: 18px;
    z-index: 1;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }

  .dev-range-field__label {
    position: absolute;
    inset-inline-start: 14px;
    z-index: 1;
    pointer-events: none;
    font: var(--dev-text-field-label);
    color: var(--sys-color-on-srf-variant);
  }

  .dev-range-field--compact .dev-range-field__output {
    inset-inline: auto 14px;
  }

  .dev-range-field__edit {
    position: absolute;
    inset-block: 4px;
    inset-inline-start: 4px;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-inline: 14px 10px;
    border-radius: calc((var(--dev-radius-control) - 4px) * var(--continuous-corner-scale, 1));
    background: var(--sys-color-srf);
    font-variant-numeric: tabular-nums;
    opacity: 0;
    cursor: text;
    transition: opacity 120ms ease-out;
  }

  .dev-range-field--compact .dev-range-field__edit {
    inset-inline: auto 4px;
    padding-inline: 10px;
  }

  .dev-range-field.is-editing .dev-range-field__edit { opacity: 1; }

  .dev-range-field__edit input {
    box-sizing: content-box;
    min-width: 1ch;
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-variant-numeric: inherit;
    color: inherit;
    text-align: end;
  }

  .dev-range-field:has(.dev-range-field__input:disabled) .dev-range-field__edit { pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .dev-range-field__edit { transition: none; }
  }

  .dev-range-field__input {
    width: 100%;
    height: var(--dev-control-height);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    appearance: none;
    border: 0;
    border-radius: inherit;
    outline: 0;
    background: transparent;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .dev-range-field__input::-webkit-slider-runnable-track { background: transparent; }
  .dev-range-field__input::-moz-range-track { background: transparent; }
  .dev-range-field__input::-webkit-slider-thumb { width: 16px; height: 1px; appearance: none; opacity: 0; }
  .dev-range-field__input::-moz-range-thumb { width: 16px; height: 1px; border: 0; opacity: 0; }
  .dev-range-field:has(.dev-range-field__input:focus-visible) { outline: 2px solid var(--sys-color-on-srf); outline-offset: 1px; }
  .dev-range-field:has(.dev-range-field__input:disabled) { opacity: var(--dev-opacity-disabled); }
  .dev-range-field__input:disabled { cursor: default; }
</style>
