---
interface Props {
  label: string;
  [key: string]: any;
}

const { label, class: className, ...rest } = Astro.props;
---

<div class:list={['ui-segmented-control', className]} role="group" aria-label={label} {...rest}>
  <slot />
</div>

<style>
  .ui-segmented-control {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.25em;
    border: 1px solid var(--sys-color-outline);
    background: var(--sys-color-srf-container-low);
    /* Concentric with the buttons: outer radius = inner radius + the gap
       between the two edges (padding + border width). */
    border-radius: calc(var(--radius-control) + 0.25em + 1px);
  }
</style>
