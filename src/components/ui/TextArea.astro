---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  rows?: number;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, rows = 3, class: className, ...rest } = Astro.props;
---

<Field label={label} class={className}>
  <textarea
    placeholder={placeholder}
    disabled={disabled}
    class="dev-field__input dev-field__input--area"
    style={`--rows: ${rows}`}
    {...rest}
  >{value}</textarea>
</Field>
