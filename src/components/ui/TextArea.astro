---
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  rows?: number;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, rows = 3, class: className, ...rest } = Astro.props;
---

<Field label={label} class={className}>
  <textarea
    placeholder={placeholder}
    disabled={disabled}
    class="ui-text-area__textarea"
    style={`--rows: ${rows}`}
    {...rest}
  >{value}</textarea>
</Field>

<style>
  .ui-text-area__textarea {
    background: transparent;
    border: none;
    outline: none;
    width: 100%;
    font: inherit;
    color: inherit;
    line-height: 1.4;
    resize: vertical;
    field-sizing: content;
    min-height: calc(1.4em * var(--rows, 3));
  }

  .ui-text-area__textarea:disabled {
    opacity: 0.5;
  }
</style>
