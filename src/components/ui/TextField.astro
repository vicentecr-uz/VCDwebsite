---
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, class: className, ...rest } = Astro.props;
---

<Field label={label} class={className}>
  <input type="text" value={value} placeholder={placeholder} disabled={disabled} class="ui-text-field__input" {...rest} />
</Field>

<style>
  .ui-text-field__input {
    background: transparent;
    border: none;
    outline: none;
    width: 100%;
    font: inherit;
    color: inherit;
  }

  .ui-text-field__input:disabled {
    opacity: 0.5;
  }
</style>
