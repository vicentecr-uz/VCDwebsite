---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  hideLabel?: boolean;
  prefix?: string;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, hideLabel = false, prefix, type = 'text', class: className, id, ...rest } = Astro.props;
const inputId = typeof id === 'string' && id.trim() ? id : `text-field-${Math.random().toString(36).slice(2, 8)}`;
const enhanced = ['text', 'search', 'url', 'tel', 'password'].includes(type);
const inputProps = {
  id: inputId, type, value, placeholder, disabled,
  class: 'dev-field__input', 'aria-label': hideLabel ? label : undefined, ...rest,
};
---

<Field label={label} labelFor={inputId} class={[className, hideLabel ? 'dev-field--no-label' : null]}>
  {enhanced ? (
    <sabi-input class="dev-text-field" data-dev-text-field>
      {prefix && <span class="dev-text-field__prefix" aria-hidden="true">{prefix}</span>}
      <input {...inputProps} />
      <slot name="trail" />
    </sabi-input>
  ) : (
    <>
      <input {...inputProps} />
      <slot name="trail" />
    </>
  )}
</Field>
