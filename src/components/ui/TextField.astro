---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  hideLabel?: boolean;
  prefix?: string;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, hideLabel = false, prefix, class: className, id, ...rest } = Astro.props;
const inputId = typeof id === 'string' && id.trim() ? id : `text-field-${Math.random().toString(36).slice(2, 8)}`;
---

<Field label={label} labelFor={inputId} class={[className, hideLabel ? 'dev-field--no-label' : null]}>
  <div class:list={['dev-text-field', prefix ? 'dev-text-field--prefix' : 'dev-text-field--native']} data-dev-text-field>
    <div class="dev-text-field__track" data-dev-text-field-track>
      <div class="dev-text-field__content">
        {prefix && <span class="dev-text-field__prefix" aria-hidden="true">{prefix}</span>}
        <input id={inputId} type="text" value={value} placeholder={placeholder} disabled={disabled} class="dev-field__input" aria-label={hideLabel ? label : undefined} {...rest} />
        <slot name="trail" />
      </div>
    </div>
    <span class="dev-text-field__measure" aria-hidden="true"></span>
  </div>
</Field>
