---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  hideLabel?: boolean;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, hideLabel = false, class: className, ...rest } = Astro.props;
---

<Field label={label} class={[className, hideLabel ? 'dev-field--no-label' : null]}>
  <input
    type="text"
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    class="dev-field__input"
    aria-label={hideLabel ? label : undefined}
    {...rest}
  />
</Field>
