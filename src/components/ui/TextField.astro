---
import '../../styles/dev-chrome.css';
import Field from './Field.astro';

interface Props {
  label: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  [key: string]: any;
}

const { label, value, placeholder, disabled = false, class: className, ...rest } = Astro.props;
---

<Field label={label} class={className}>
  <input type="text" value={value} placeholder={placeholder} disabled={disabled} class="dev-field__input" {...rest} />
</Field>
