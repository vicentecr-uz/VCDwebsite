---
/** Dev-only employer view preview switcher (Alt+V, sessionStorage). */
---

<div class="dev-view-switcher" data-dev-view-switcher aria-hidden="true">
  <div class="dev-view-switcher__backdrop" data-dev-view-backdrop aria-hidden="true"></div>
  <div
    class="dev-view-switcher__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dev-view-switcher-title"
  >
    <p class="dev-view-switcher__eyebrow">Dev preview</p>
    <h2 id="dev-view-switcher-title" class="dev-view-switcher__title">Employer view</h2>
    <p class="dev-view-switcher__hint">Alt+V to open · Esc to close</p>
    <label class="dev-view-switcher__field">
      <span class="dev-view-switcher__label">Preview as</span>
      <select class="dev-view-switcher__select" data-dev-view-select aria-label="Preview employer view">
        <option value="">Public site</option>
      </select>
    </label>
  </div>
</div>

<script>
  const STORAGE_KEY = 'vcd-dev-view';

  const initDevViewSwitcher = async () => {
    const root = document.querySelector<HTMLElement>('[data-dev-view-switcher]');
    const backdrop = root?.querySelector<HTMLElement>('[data-dev-view-backdrop]');
    const select = root?.querySelector<HTMLSelectElement>('[data-dev-view-select]');
    if (!root || !backdrop || !select) return;

    const isTypingTarget = (target: EventTarget | null) =>
      Boolean(
        target instanceof HTMLElement
        && target.closest('input, textarea, select, [contenteditable="true"]'),
      );

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      root.toggleAttribute('aria-hidden', !open);
      root.toggleAttribute('inert', !open);
      document.documentElement.classList.toggle('is-dev-view-switcher-open', open);
      if (open) {
        requestAnimationFrame(() => select.focus());
      }
    };

    const close = () => setOpen(false);
    const toggle = () => setOpen(!root.classList.contains('is-open'));

    try {
      const response = await fetch('/api/dev-views');
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || 'Could not load views.');

      for (const view of payload.views ?? []) {
        const option = document.createElement('option');
        option.value = view.id;
        option.textContent = view.title || view.id;
        select.append(option);
      }
    } catch {
      select.disabled = true;
    }

    select.value = sessionStorage.getItem(STORAGE_KEY) || '';

    const setViewCookie = (viewId: string) => {
      if (viewId) {
        document.cookie = `${STORAGE_KEY}=${encodeURIComponent(viewId)}; path=/; SameSite=Lax`;
      } else {
        document.cookie = `${STORAGE_KEY}=; path=/; max-age=0; SameSite=Lax`;
      }
    };

    select.addEventListener('change', () => {
      if (select.value) {
        sessionStorage.setItem(STORAGE_KEY, select.value);
        setViewCookie(select.value);
      } else {
        sessionStorage.removeItem(STORAGE_KEY);
        setViewCookie('');
      }
      window.location.reload();
    });

    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyV') {
        if (isTypingTarget(event.target)) return;
        event.preventDefault();
        toggle();
        return;
      }

      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        event.preventDefault();
        event.stopPropagation();
        close();
      }
    });
  };

  initDevViewSwitcher();
</script>

<style>
  .dev-view-switcher {
    --dev-view-switcher-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --dev-view-switcher-duration: 0.48s;
    position: fixed;
    inset: 0;
    z-index: 95;
    display: grid;
    place-items: center;
    padding: max(1em, env(safe-area-inset-top))
      max(1em, env(safe-area-inset-right))
      max(1em, env(safe-area-inset-bottom))
      max(1em, env(safe-area-inset-left));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dev-view-switcher-duration) var(--dev-view-switcher-ease),
      visibility 0s linear var(--dev-view-switcher-duration);
  }

  .dev-view-switcher.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dev-view-switcher-duration) var(--dev-view-switcher-ease),
      visibility 0s;
  }

  .dev-view-switcher__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.9);
  }

  .dev-view-switcher__panel {
    position: relative;
    z-index: 1;
    width: min(22em, 100%);
    margin: 0;
    padding: 1.25em 1.35em 1.35em;
    border-radius: var(--radius-control-smooth);
    background: var(--color-bg);
    box-shadow: 0 0.5em 2em rgb(0 0 0 / 0.12);
    transform: translateY(0.4em) scale(0.985);
    transition: transform var(--dev-view-switcher-duration) var(--dev-view-switcher-ease);
  }

  .dev-view-switcher.is-open .dev-view-switcher__panel {
    transform: translateY(0) scale(1);
  }

  .dev-view-switcher__eyebrow {
    margin: 0 0 0.35em;
    color: var(--color-text-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dev-view-switcher__title {
    margin: 0;
    color: var(--color-text);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .dev-view-switcher__hint {
    margin: 0.45em 0 1em;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    letter-spacing: -0.01em;
  }

  .dev-view-switcher__field {
    display: grid;
    gap: 0.45em;
    margin: 0;
  }

  .dev-view-switcher__label {
    color: var(--color-text-soft);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dev-view-switcher__select {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-control) - 0.15em);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.2;
    padding: 0.65em 0.75em;
    cursor: pointer;
  }

  .dev-view-switcher__select:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-view-switcher,
    .dev-view-switcher__panel {
      transition: none;
    }
  }
</style>
