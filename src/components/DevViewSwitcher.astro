---
/** Dev-only employer view preview switcher (Alt+V, sessionStorage). */
import viewRegistry from '../content/views/_registry.json';

const devViews = import.meta.env.DEV ? (viewRegistry.views ?? []) : [];
---

<div class="dev-view-switcher" data-dev-view-switcher aria-hidden="true">
  <div class="dev-view-switcher__backdrop" data-dev-view-backdrop aria-hidden="true"></div>
  <div
    class="dev-view-switcher__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dev-view-switcher-title"
  >
    <p class="dev-view-switcher__eyebrow">Dev preview</p>
    <h2 id="dev-view-switcher-title" class="dev-view-switcher__title">Employer view</h2>
    <p class="dev-view-switcher__hint">Alt+V to open · Esc to cancel</p>
    <label class="dev-view-switcher__field">
      <span class="dev-view-switcher__label">Preview as</span>
      <select class="dev-view-switcher__select" data-dev-view-select aria-label="Preview employer view">
        <option value="">Public site</option>
        {devViews.map((view) => <option value={view.id}>{view.title || view.id}</option>)}
      </select>
    </label>
    <div class="dev-view-switcher__actions">
      <button type="button" class="dev-view-switcher__cancel" data-dev-view-cancel>Cancel</button>
      <button type="button" class="dev-view-switcher__apply" data-dev-view-apply disabled>Apply</button>
    </div>
  </div>
</div>

<script>
  import { confirmBeforeDevReload, switchDevView } from '../scripts/devViewContext';

  const initDevViewSwitcher = () => {
    const root = document.querySelector('[data-dev-view-switcher]');
    const backdrop = root?.querySelector('[data-dev-view-backdrop]');
    const select = root?.querySelector('[data-dev-view-select]');
    const applyButton = root?.querySelector('[data-dev-view-apply]');
    const cancelButton = root?.querySelector('[data-dev-view-cancel]');
    if (!root || !backdrop || !select || !applyButton || !cancelButton) return;
    if (root.dataset.devViewSwitcherReady === 'true') return;
    root.dataset.devViewSwitcherReady = 'true';

    // The server decides the active view; mirror it from <html data-view-id>.
    const activeView = document.documentElement.dataset.viewId || '';
    select.value = activeView;

    const isTypingTarget = (target) =>
      Boolean(
        target instanceof HTMLElement
        && target.closest('input, textarea, select, [contenteditable="true"]')
        && !target.closest('[data-dev-view-switcher]'),
      );

    const setOpen = (open) => {
      root.classList.toggle('is-open', open);
      root.toggleAttribute('aria-hidden', !open);
      root.toggleAttribute('inert', !open);
      document.documentElement.classList.toggle('is-dev-view-switcher-open', open);
      if (open) requestAnimationFrame(() => select.focus());
    };
    const close = () => setOpen(false);

    const syncApplyState = () => {
      applyButton.disabled = select.disabled || select.value === activeView;
    };

    const open = () => {
      select.value = activeView;
      syncApplyState();
      setOpen(true);
    };

    const cancel = () => {
      select.value = activeView;
      syncApplyState();
      close();
    };

    const toggle = () => (root.classList.contains('is-open') ? cancel() : open());

    const apply = async () => {
      const nextView = select.value;
      if (nextView === activeView) {
        close();
        return;
      }
      if (!confirmBeforeDevReload()) return;

      select.disabled = true;
      cancelButton.disabled = true;
      applyButton.disabled = true;
      applyButton.textContent = 'Switching…';
      try {
        await switchDevView(nextView);
        // On success the page reloads into the new view; nothing more to do.
      } catch (error) {
        select.disabled = false;
        cancelButton.disabled = false;
        applyButton.disabled = false;
        applyButton.textContent = 'Apply';
        syncApplyState();
        window.alert(error instanceof Error ? error.message : 'Could not switch view.');
      }
    };

    syncApplyState();
    select.addEventListener('change', syncApplyState);
    applyButton.addEventListener('click', apply);
    cancelButton.addEventListener('click', cancel);
    backdrop.addEventListener('click', cancel);

    document.addEventListener('keydown', (event) => {
      if (event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyV') {
        if (isTypingTarget(event.target)) return;
        event.preventDefault();
        toggle();
        return;
      }
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        event.preventDefault();
        event.stopPropagation();
        cancel();
      }
    });
  };

  initDevViewSwitcher();
</script>

<style>
  .dev-view-switcher {
    --dev-view-switcher-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --dev-view-switcher-duration: 0.48s;
    position: fixed;
    inset: 0;
    z-index: 95;
    display: grid;
    place-items: center;
    padding: max(1em, env(safe-area-inset-top))
      max(1em, env(safe-area-inset-right))
      max(1em, env(safe-area-inset-bottom))
      max(1em, env(safe-area-inset-left));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dev-view-switcher-duration) var(--dev-view-switcher-ease),
      visibility 0s linear var(--dev-view-switcher-duration);
  }

  .dev-view-switcher.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--dev-view-switcher-duration) var(--dev-view-switcher-ease),
      visibility 0s;
  }

  .dev-view-switcher__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.9);
  }

  .dev-view-switcher__panel {
    position: relative;
    z-index: 1;
    width: min(22em, 100%);
    margin: 0;
    padding: 1.25em 1.35em 1.35em;
    border-radius: var(--radius-control-smooth);
    background: var(--color-bg);
    box-shadow: 0 0.5em 2em rgb(0 0 0 / 0.12);
    transform: translateY(0.4em) scale(0.985);
    transition: transform var(--dev-view-switcher-duration) var(--dev-view-switcher-ease);
  }

  .dev-view-switcher.is-open .dev-view-switcher__panel {
    transform: translateY(0) scale(1);
  }

  .dev-view-switcher__eyebrow {
    margin: 0 0 0.35em;
    color: var(--color-text-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dev-view-switcher__title {
    margin: 0;
    color: var(--color-text);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .dev-view-switcher__hint {
    margin: 0.45em 0 1em;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    letter-spacing: -0.01em;
  }

  .dev-view-switcher__field {
    display: grid;
    gap: 0.45em;
    margin: 0;
  }

  .dev-view-switcher__label {
    color: var(--color-text-soft);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dev-view-switcher__select {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-control) - 0.15em);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.2;
    padding: 0.65em 0.75em;
    cursor: pointer;
  }

  .dev-view-switcher__select:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .dev-view-switcher__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    justify-content: flex-end;
    margin-top: 1.15em;
  }

  .dev-view-switcher__actions button {
    padding: 0.55em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-control) - 0.15em);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
  }

  .dev-view-switcher__actions button:hover:not(:disabled) {
    background: var(--color-surface-soft);
  }

  .dev-view-switcher__actions button:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .dev-view-switcher__apply {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
  }

  .dev-view-switcher__apply:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-text) 88%, white);
    border-color: color-mix(in srgb, var(--color-text) 88%, white);
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-view-switcher,
    .dev-view-switcher__panel {
      transition: none;
    }
  }
</style>
