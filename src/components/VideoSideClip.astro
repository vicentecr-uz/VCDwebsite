---
// A skateboard that peeks out from under a video once it plays. Picking it tucks it back under
// and blur-fades a portrait clip into the top corner of the frame; picking the clip undoes that.
// Sits beside a ProjectVideo inside a positioned parent that is the video's size.
interface Props {
  /** Root-relative clip URL. */
  src: string;
  label: string;
  /** Root-relative artwork for the board; the drawn stand-in shows without it. */
  art?: string;
}

const { src, label, art } = Astro.props;
---

<div class="side-clip" data-side-clip data-clip-src={src} data-clip-label={label}>
  <button type="button" class="side-clip__item" aria-label={`Play ${label} clip`} tabindex="-1">
    {art ? <img src={art} alt="" /> : (
      <!-- Original stand-in drawing. -->
      <svg viewBox="0 0 64 64" aria-hidden="true"><g transform="rotate(-18 32 32)"><rect x="5" y="24" width="54" height="11" rx="5.5" fill="#ff5a3c"/><rect x="9" y="26" width="46" height="3" rx="1.5" fill="#ffd166"/><circle cx="18" cy="41" r="5.5" fill="#1d1d1f"/><circle cx="46" cy="41" r="5.5" fill="#1d1d1f"/><circle cx="18" cy="41" r="2" fill="#fff"/><circle cx="46" cy="41" r="2" fill="#fff"/></g></svg>
    )}
  </button>
</div>

<style is:global>
  .side-clip {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .side-clip__item {
    position: absolute;
    top: 9%;
    left: 100%;
    z-index: 0;
    width: max(44px, 17cqi);
    height: max(44px, 17cqi);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Tucked under the video until it plays, and again while its clip is open. */
    translate: -105% 0;
    rotate: -6deg;
    transition: translate 520ms cubic-bezier(0.34, 1.45, 0.64, 1);
  }

  /* Nothing covers it until the video has painted, so it stays out of sight until play. */
  .side-clip:not([data-revealed]) .side-clip__item {
    visibility: hidden;
  }

  .side-clip[data-revealed]:not([data-open]) .side-clip__item {
    pointer-events: auto;
    translate: -52% 0;
  }

  /* Going back under is a plain ease: an overshoot would poke out the far side. */
  .side-clip[data-open] .side-clip__item {
    transition: translate 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .side-clip[data-revealed]:not([data-open]) .side-clip__item:hover {
      translate: -38% 0;
    }
  }

  .side-clip__item:focus-visible {
    outline: 2px solid var(--sys-color-outline);
    outline-offset: 2px;
    border-radius: var(--radius-control);
  }

  .side-clip__item :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* The clip: a portrait card in the frame's top corner, on the side the board came from. */
  .side-clip__card {
    position: absolute;
    top: 4%;
    right: 5%;
    z-index: 1;
    width: 34%;
    aspect-ratio: 9 / 16;
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius-card) * var(--continuous-corner-scale, 1) * 0.75);
    corner-shape: var(--squircle-shape);
    overflow: hidden;
    background: #1d1d1f;
    box-shadow: 0 10px 30px rgb(0 0 0 / 30%);
    cursor: pointer;
    opacity: 0;
    filter: blur(12px);
    transition: opacity 400ms ease, filter 400ms ease;
  }

  .side-clip__card[data-open] {
    opacity: 1;
    filter: blur(0);
  }

  .side-clip__card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    outline: 1px solid rgb(255 255 255 / 12%);
    outline-offset: -1px;
    pointer-events: none;
  }

  .side-clip__card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .side-clip__card:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .side-clip__item,
    .side-clip[data-open] .side-clip__item { transition: none; }
    .side-clip__card { filter: none; transition: opacity 400ms ease; }
  }
</style>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  const dispose = onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-side-clip]');
    const item = root?.querySelector<HTMLButtonElement>('.side-clip__item');
    const player = root?.parentElement?.querySelector<HTMLElement>('[data-project-video]');
    const video = player?.querySelector<HTMLVideoElement>('video[data-project-inline-video]');
    if (!root || !item || !player || !video) return;
    const controller = new AbortController();
    const { signal } = controller;
    let card: HTMLButtonElement | undefined;

    const close = () => {
      const closing = card;
      card = undefined;
      root.removeAttribute('data-open');
      if (!closing) return;
      closing.removeAttribute('data-open');
      closing.querySelector('video')?.pause();
      setTimeout(() => closing.remove(), 400);
    };
    const open = () => {
      if (card) return;
      const next = document.createElement('button');
      next.type = 'button';
      next.className = 'side-clip__card';
      // Keeps the card out of the player's own auto-hide.
      next.setAttribute('noautohide', '');
      next.setAttribute('aria-label', `Hide ${root.dataset.clipLabel} clip`);
      const clip = document.createElement('video');
      clip.muted = true;
      clip.loop = true;
      clip.playsInline = true;
      clip.preload = 'auto';
      clip.src = root.dataset.clipSrc ?? '';
      next.append(clip);
      next.addEventListener('click', (event) => { event.stopPropagation(); close(); item.focus({ preventScroll: true }); }, { signal });
      (video.parentElement ?? player).append(next);
      card = next;
      root.setAttribute('data-open', '');
      requestAnimationFrame(() => next.setAttribute('data-open', ''));
      if (!video.paused) clip.play().catch(() => {});
    };

    item.addEventListener('click', open, { signal });
    video.addEventListener('play', () => {
      root.setAttribute('data-revealed', '');
      item.tabIndex = 0;
      card?.querySelector('video')?.play().catch(() => {});
    }, { signal });
    video.addEventListener('pause', () => card?.querySelector('video')?.pause(), { signal });

    return () => {
      controller.abort();
      card?.remove();
      root.removeAttribute('data-open');
      root.removeAttribute('data-revealed');
    };
  });
  import.meta.hot?.dispose(dispose);
</script>
