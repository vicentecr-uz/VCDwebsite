---
import DevOverlay from './DevOverlay.astro';
import eyeIcon from 'lucide-static/icons/eye.svg?raw';
import eyeOffIcon from 'lucide-static/icons/eye-off.svg?raw';
import { sizeIcon } from '../lib/icons';

const eyeIconSvg = sizeIcon(eyeIcon, 16);
const eyeOffIconSvg = sizeIcon(eyeOffIcon, 16);
---

<DevOverlay
  storageKey="gallery-pages"
  panelKey="gallery-pages"
  layout="landscape"
  defaultHidden
>
  <div
    class="dev-gallery-pages"
    data-dev-gallery-pages
    data-eye-icon={eyeIconSvg}
    data-eye-off-icon={eyeOffIconSvg}
  >
    <div class="dev-gallery-pages__filters dev-segmented" role="group" aria-label="Gallery filter">
      <button type="button" data-gallery-filter="all" class="dev-btn dev-btn--ghost is-active">All</button>
      <button type="button" data-gallery-filter="on" class="dev-btn dev-btn--ghost">On this page</button>
      <button type="button" data-gallery-filter="off" class="dev-btn dev-btn--ghost">Not on page</button>
    </div>

    <p class="dev-gallery-pages__status" data-gallery-status aria-live="polite">Loading…</p>
    <div class="dev-gallery-pages__grid" data-gallery-grid></div>
  </div>
</DevOverlay>

<script>
  import { projectImage } from '../lib/images';
  import { resolveDevPanelTitle } from '../lib/devPanelTitles';
  import { isPlaceholderCoverSrc } from '../lib/placeholderCover.mjs';
  import {
    hasCropVariants,
    imageSourceDims,
    listingCoverDefaultAspects,
    listingCoverDevEditAttrs,
  } from '../lib/projectImageFrame';
  import {
    hoverCropStyle,
    normalizeImageVariants,
    responsiveImageStyle,
    type ImageVariants,
  } from '../lib/responsiveImage';

  /** @typedef {{
   *   slug: string,
   *   title: string,
   *   status: string,
   *   onGallery: boolean,
   *   hasCover: boolean,
   *   image: string,
   *   coverUrl: string,
   *   bg: string,
   *   dark: boolean,
   *   full: boolean,
   *   subtitle: string,
   *   hoverImage: string,
   *   order: number,
   *   variants: ImageVariants,
   *   hoverVariants?: ImageVariants,
   *   hoverDark?: boolean,
   *   srcWidth?: number,
   *   srcHeight?: number,
   * }} GalleryPage */

  type GridOrderEntry = { type: 'project'; slug: string; order: number; full: boolean };

  const initDevGalleryPages = () => {
    const root = document.querySelector<HTMLElement>('[data-dev-gallery-pages]');
    const panel = root?.closest<HTMLElement>('[data-dev-overlay]');
    if (!root || !panel) return;
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const gridEl = root.querySelector<HTMLElement>('[data-gallery-grid]');
    const statusEl = root.querySelector<HTMLElement>('[data-gallery-status]');
    const countEl = root.querySelector<HTMLElement>('[data-gallery-count]');
    const overlayTitle = panel.querySelector<HTMLElement>('.dev-overlay__title');
    const filterButtons = root.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]');
    const eyeIconHtml = root.dataset.eyeIcon || '';
    const eyeOffIconHtml = root.dataset.eyeOffIcon || '';

    /** @type {GalleryPage[]} */
    let pages = [];
    /** @type {Set<string>} */
    let selected = new Set();
    /** @type {Set<string>} */
    let baseline = new Set();
    /** @type {GridOrderEntry[]} */
    let baselineOrder: GridOrderEntry[] = [];
    /** @type {string[]} */
    let baselinePagesOrder: string[] = [];
    /** @type {'all' | 'on' | 'off'} */
    let filter = 'all';
    /** @type {'home' | 'work' | 'play' | ''} */
    let activeGrid = '';
    /** @type {Map<string, HTMLElement>} */
    const detachedItems = new Map();
    /** @type {Map<string, HTMLElement>} */
    const createdItems = new Map();

    let drag: { pointerId: number; slug: string; cancel: () => void } | null = null;
    const DRAG_THRESHOLD = 4;
    const GRID_GAP = 8;
    const GRID_COLUMNS = 3;
    let layoutCapsRaf = 0;
    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const readLandscapeDefaultInnerWidth = () => {
      const styles = getComputedStyle(document.documentElement);
      const panelWidth = Number.parseFloat(styles.getPropertyValue('--dev-panel-width-landscape')) || 597;
      const panelPad = Number.parseFloat(styles.getPropertyValue('--dev-panel-pad')) || 12;
      return panelWidth - 2 * panelPad;
    };

    /** Thumb width from the signed 597px landscape body, not the current resize. */
    const computeThumbWidth = () => {
      const innerBodyW = readLandscapeDefaultInnerWidth();
      if (!gridEl) {
        return Math.round((innerBodyW - (GRID_COLUMNS - 1) * GRID_GAP) / GRID_COLUMNS);
      }
      const gridStyle = getComputedStyle(gridEl);
      const gridPadX = Number.parseFloat(gridStyle.paddingLeft) + Number.parseFloat(gridStyle.paddingRight);
      const available = innerBodyW - gridPadX - (GRID_COLUMNS - 1) * GRID_GAP;
      return Math.round(available / GRID_COLUMNS);
    };

    const viewportCapPx = () => {
      const em = Number.parseFloat(getComputedStyle(panel).fontSize) || 16;
      return {
        width: window.innerWidth - 2 * em,
        height: window.innerHeight - 2 * em,
      };
    };

    const measureOverlayHug = (): { width: number; height: number } | null => {
      if (panel.hidden) return null;
      const prevWidth = panel.style.width;
      const prevHeight = panel.style.height;
      const prevMaxWidth = panel.style.maxWidth;
      const prevMaxHeight = panel.style.maxHeight;
      panel.style.width = '';
      panel.style.height = '';
      panel.style.maxWidth = '';
      panel.style.maxHeight = '';
      const width = panel.offsetWidth;
      const height = panel.offsetHeight;
      panel.style.width = prevWidth;
      panel.style.height = prevHeight;
      panel.style.maxWidth = prevMaxWidth;
      panel.style.maxHeight = prevMaxHeight;
      if (!width || !height) return null;
      return { width, height };
    };

    const applyLayoutCaps = () => {
      if (panel.hidden) return;
      if (panel.classList.contains('is-minimized')) return;
      root.style.setProperty('--dev-gallery-thumb-w', `${computeThumbWidth()}px`);
      const hug = measureOverlayHug();
      if (!hug) return;

      const minLandscape = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--dev-panel-min-width-landscape'),
      ) || 344;
      const viewport = viewportCapPx();

      if (hug.width < minLandscape) {
        panel.style.minWidth = `${hug.width}px`;
        panel.style.maxWidth = `${hug.width}px`;
      } else {
        panel.style.minWidth = '';
        panel.style.maxWidth = `${Math.min(hug.width, viewport.width)}px`;
      }
      panel.style.maxHeight = `${Math.min(hug.height, viewport.height)}px`;

      const capW = Number.parseFloat(panel.style.maxWidth);
      const capH = Number.parseFloat(panel.style.maxHeight);
      const inlineW = Number.parseFloat(panel.style.width);
      const inlineH = Number.parseFloat(panel.style.height);
      if (Number.isFinite(inlineW) && Number.isFinite(capW) && inlineW > capW) {
        panel.style.width = '';
      }
      if (Number.isFinite(inlineH) && Number.isFinite(capH) && inlineH > capH) {
        panel.style.height = '';
      }
    };

    const scheduleLayoutCaps = () => {
      if (layoutCapsRaf) return;
      layoutCapsRaf = requestAnimationFrame(() => {
        layoutCapsRaf = 0;
        applyLayoutCaps();
      });
    };

    const coverDefaultAspect = (full: boolean, grid: string) =>
      listingCoverDefaultAspects(
        grid as 'home' | 'work' | 'play',
        full,
      );

    const currentGrid = (): 'home' | 'work' | 'play' | '' => {
      const grid = document.querySelector<HTMLElement>('[data-dev-project-grid]');
      const id = grid?.dataset.devProjectGrid;
      return id === 'home' || id === 'work' || id === 'play' ? id : '';
    };

    const gridLabel = (grid: string) => (
      grid === 'home' ? 'Home' : grid === 'work' ? 'Work' : grid === 'play' ? 'Play' : 'Gallery'
    );

    const setStatus = (message: string) => {
      if (statusEl) statusEl.textContent = message;
    };

    const setsEqual = (left: Set<string>, right: Set<string>) => {
      if (left.size !== right.size) return false;
      for (const value of left) {
        if (!right.has(value)) return false;
      }
      return true;
    };

    const ordersEqual = (left: GridOrderEntry[], right: GridOrderEntry[]) =>
      JSON.stringify(left) === JSON.stringify(right);

    const listingGrid = () => document.querySelector<HTMLElement>(
      activeGrid ? `[data-dev-project-grid="${activeGrid}"]` : '[data-dev-project-grid]',
    );

    const captureGridOrder = (): GridOrderEntry[] => {
      const grid = listingGrid();
      if (!grid) return [];
      return [...grid.querySelectorAll<HTMLElement>('.project-grid__item:not(.project-grid__item--new)')]
        .map((item, index) => {
          const slug = item.dataset.devProjectSlug;
          const full = item.classList.contains('project-grid__item--full');
          if (slug) return { type: 'project' as const, slug, order: index + 1, full };
          return null;
        })
        .filter((entry): entry is GridOrderEntry => entry !== null);
    };

    const isDirty = () =>
      !setsEqual(selected, baseline) || !ordersEqual(captureGridOrder(), baselineOrder);

    const pageBySlug = (slug: string) => pages.find((page) => page.slug === slug);

    const draggableCardOrder = (): string[] =>
      gridEl
        ? [...gridEl.querySelectorAll<HTMLElement>('.dev-gallery-pages__card.is-selected')]
            .map((el) => el.dataset.gallerySlug || '')
            .filter(Boolean)
        : [];

    const cardEl = (slug: string) =>
      gridEl?.querySelector<HTMLElement>(`.dev-gallery-pages__card[data-gallery-slug="${slug}"]`) ?? null;

    const reorderCardsToMatch = (order: string[]) => {
      let prev: HTMLElement | null = null;
      for (const slug of order) {
        const el = cardEl(slug);
        if (!el) continue;
        if (prev) prev.after(el);
        prev = el;
      }
    };

    const applyOrderToLiveGrid = (order: string[]) => {
      const grid = listingGrid();
      if (!grid) return;
      let prev: HTMLElement | null = null;
      for (const slug of order) {
        const el = grid.querySelector<HTMLElement>(`[data-dev-project-slug="${slug}"]`);
        if (!el) continue;
        if (prev) prev.after(el);
        prev = el;
      }
    };

    const applyPagesOrder = (order: string[]) => {
      const rank = new Map(order.map((slug, index) => [slug, index]));
      const ordered = pages
        .filter((page) => rank.has(page.slug))
        .sort((a, b) => (rank.get(a.slug) ?? 0) - (rank.get(b.slug) ?? 0));
      const rest = pages.filter((page) => !rank.has(page.slug));
      pages = [...ordered, ...rest];
    };

    // Mirrors the server's load-time sort (on-gallery first, hidden last) after an
    // in-session toggle — the partition is stable, so a card just hidden lands at
    // the end rather than holding its old slot.
    const sortPagesByMembership = () => {
      pages = [
        ...pages.filter((page) => selected.has(page.slug)),
        ...pages.filter((page) => !selected.has(page.slug)),
      ];
    };

    const attachCardDrag = (card: HTMLElement, button: HTMLElement, page: GalleryPage, isOn: boolean) => {
      if (!isOn) return;

      button.addEventListener('pointerdown', (event: PointerEvent) => {
        if (event.button !== 0 || drag) return;
        card.classList.add('is-pressing');
        const pointerId = event.pointerId;
        const startX = event.clientX;
        const startY = event.clientY;
        const preDragOrder = draggableCardOrder();
        let active = false;
        let baseX = startX;
        let baseY = startY;
        // Blocks re-evaluating a swap target until the previous FLIP transition
        // has settled, so getBoundingClientRect() isn't read mid-animation.
        let swapLockedUntil = 0;

        // Document-level: before the drag threshold there is no pointer capture,
        // so a press that releases off the card would never reach a button-level
        // listener — leaving `drag` set and blocking every later drag.
        const cleanupListeners = () => {
          document.removeEventListener('pointermove', onMove);
          document.removeEventListener('pointerup', onUp);
          document.removeEventListener('pointercancel', onCancel);
        };

        const finish = () => {
          cleanupListeners();
          if (button.hasPointerCapture(pointerId)) button.releasePointerCapture(pointerId);
          card.classList.remove('is-dragging');
          card.classList.remove('is-pressing');
          card.style.transform = '';
          drag = null;
        };

        const abort = () => {
          if (active) reorderCardsToMatch(preDragOrder);
          finish();
        };

        const onMove = (moveEvent: PointerEvent) => {
          if (moveEvent.pointerId !== pointerId) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;
          if (!active) {
            if (Math.hypot(dx, dy) < DRAG_THRESHOLD) return;
            active = true;
            button.setPointerCapture(pointerId);
            card.classList.add('is-dragging');
          }
          moveEvent.preventDefault();
          const clientX = moveEvent.clientX;
          const clientY = moveEvent.clientY;
          card.style.transform = `translate(${clientX - baseX}px, ${clientY - baseY}px) scale(1.04)`;

          if (performance.now() < swapLockedUntil) return;

          const order = draggableCardOrder();
          const curIndex = order.indexOf(page.slug);
          if (curIndex === -1 || order.length < 2) return;

          // Only other cards are drop targets: the dragged card is transformed to
          // follow the pointer, so it sits a fixed distance from it (zero when
          // grabbed dead centre) and would win any nearest-centre test forever.
          let nearest = -1;
          for (const [index, slug] of order.entries()) {
            if (slug === page.slug) continue;
            const rect = cardEl(slug)?.getBoundingClientRect();
            if (!rect) continue;
            // Shrunken hit zone (middle 50% x 50%): a full-rect test lets the card
            // that just landed under the pointer swap straight back next move.
            const insetX = rect.width * 0.25;
            const insetY = rect.height * 0.25;
            if (clientX >= rect.left + insetX && clientX <= rect.right - insetX
              && clientY >= rect.top + insetY && clientY <= rect.bottom - insetY) {
              nearest = index;
              break;
            }
          }
          if (nearest === -1 || nearest === curIndex) return;

          const reduced = prefersReducedMotion();
          const firstRects = reduced
            ? null
            : new Map(
                order
                  .filter((slug) => slug !== page.slug)
                  .map((slug) => [slug, cardEl(slug)?.getBoundingClientRect() ?? null]),
              );

          const newOrder = [...order];
          newOrder.splice(curIndex, 1);
          newOrder.splice(nearest, 0, page.slug);

          const beforeLeft = card.offsetLeft;
          const beforeTop = card.offsetTop;
          reorderCardsToMatch(newOrder);
          if (!reduced) swapLockedUntil = performance.now() + 160;
          const afterLeft = card.offsetLeft;
          const afterTop = card.offsetTop;
          baseX += afterLeft - beforeLeft;
          baseY += afterTop - beforeTop;
          card.style.transform = `translate(${clientX - baseX}px, ${clientY - baseY}px) scale(1.04)`;

          if (!reduced && firstRects) {
            for (const [slug, firstRect] of firstRects) {
              if (!firstRect) continue;
              const el = cardEl(slug);
              if (!el) continue;
              const lastRect = el.getBoundingClientRect();
              const invertX = firstRect.left - lastRect.left;
              const invertY = firstRect.top - lastRect.top;
              if (!invertX && !invertY) continue;
              el.style.transition = 'none';
              el.style.transform = `translate(${invertX}px, ${invertY}px)`;
              requestAnimationFrame(() => {
                el.style.transition = '';
                el.style.transform = '';
              });
            }
          }
        };

        const onUp = (upEvent: PointerEvent) => {
          if (upEvent.pointerId !== pointerId) return;
          if (!active) {
            finish();
            return;
          }
          const finalOrder = draggableCardOrder();
          finish();
          applyPagesOrder(finalOrder);
          applyOrderToLiveGrid(finalOrder);
          syncPending();
          syncCount();
        };

        const onCancel = (cancelEvent: PointerEvent) => {
          if (cancelEvent.pointerId !== pointerId) return;
          abort();
        };

        drag = { pointerId, slug: page.slug, cancel: abort };

        document.addEventListener('pointermove', onMove);
        document.addEventListener('pointerup', onUp);
        document.addEventListener('pointercancel', onCancel);
      });
    };

    const buildGridCard = (page: GalleryPage): HTMLElement | null => {
      const template = document.querySelector<HTMLTemplateElement>('[data-dev-grid-card-template]');
      const seed = template?.content.firstElementChild;
      if (!(seed instanceof HTMLElement)) {
        console.warn('[DevGalleryPages] Missing [data-dev-grid-card-template] — cannot add gallery card.');
        return null;
      }

      const grid = activeGrid;
      if (grid !== 'home' && grid !== 'work' && grid !== 'play') {
        console.warn('[DevGalleryPages] No active grid when building card.');
        return null;
      }

      const item = seed.cloneNode(true) as HTMLElement;
      const isTeaser = page.status === 'teaser';
      const isImage = page.status === 'image';
      const isUnlinked = isTeaser || isImage;
      const defaultAspects = coverDefaultAspect(page.full, grid);
      const srcDims = imageSourceDims(page);
      const variants = page.variants;
      const hoverVariants = page.hoverVariants;
      const hasCoverCrop = hasCropVariants(variants);
      const hasHoverCrop = hasCropVariants(hoverVariants);
      const hasCrop = hasCoverCrop || hasHoverCrop;
      const normalizedCover = hasCoverCrop || hasCrop
        ? normalizeImageVariants(variants, defaultAspects, srcDims)
        : undefined;
      const normalizedHover = hasHoverCrop && hoverVariants
        ? normalizeImageVariants(hoverVariants, defaultAspects, null)
        : undefined;
      const coverStyle = [
        normalizedCover ? responsiveImageStyle(normalizedCover, srcDims) : '',
        normalizedHover ? hoverCropStyle(normalizedHover) : '',
        page.bg ? `background-color:${page.bg}` : '',
      ].filter(Boolean).join(';') || undefined;
      const hoverDark = typeof page.hoverDark === 'boolean' ? page.hoverDark : page.dark;

      item.dataset.devProjectSlug = page.slug;
      item.classList.toggle('project-grid__item--full', Boolean(page.full));
      item.dataset.devStatus = page.status;
      item.dataset.devBg = page.bg;
      item.dataset.devDark = page.dark ? 'true' : 'false';
      if (page.hoverImage) {
        item.dataset.devHoverImage = page.hoverImage;
        item.dataset.devHoverDark = hoverDark ? 'true' : 'false';
      } else {
        delete item.dataset.devHoverImage;
        delete item.dataset.devHoverDark;
      }

      const statusBtn = item.querySelector<HTMLElement>('[data-dev-project-status]');
      if (statusBtn) statusBtn.dataset.devProjectStatus = page.slug;
      const hoverBtn = item.querySelector<HTMLElement>('[data-dev-project-hover]');
      if (hoverBtn) {
        hoverBtn.dataset.devProjectHover = page.slug;
        hoverBtn.dataset.devHoverChipFor = page.title;
      }
      const spanBtn = item.querySelector<HTMLElement>('[data-dev-project-span]');
      if (spanBtn) {
        spanBtn.dataset.devProjectSpan = page.slug;
        spanBtn.setAttribute('aria-label', `Span columns for ${page.title}`);
      }
      const settingsBtn = item.querySelector<HTMLElement>('[data-dev-project-settings]');
      if (settingsBtn) {
        settingsBtn.dataset.devProjectSettings = page.slug;
        settingsBtn.setAttribute('aria-label', `Card settings for ${page.title}`);
      }
      item.querySelectorAll<HTMLElement>('[data-dev-edit-trigger="image"]').forEach((cropBtn) => {
        cropBtn.setAttribute('aria-label', `Crop cover for ${page.title}`);
        cropBtn.title = 'Crop cover';
      });

      let card = item.querySelector<HTMLElement>('.project-grid__card');
      if (isUnlinked && card instanceof HTMLAnchorElement) {
        const div = document.createElement('div');
        div.className = `${card.className}${isTeaser ? ' project-grid__card--teaser' : ''}`.trim();
        div.setAttribute('aria-disabled', 'true');
        if (isTeaser) {
          div.dataset.devTeaserSlug = page.slug;
          div.dataset.devTeaserHref = `/${page.slug}`;
        }
        while (card.firstChild) div.appendChild(card.firstChild);
        card.replaceWith(div);
        card = div;
      } else if (card instanceof HTMLAnchorElement) {
        card.href = `/${page.slug}`;
        card.classList.remove('project-grid__card--teaser');
      }

      const cover = item.querySelector<HTMLElement>('.project-grid__cover');
      if (cover) {
        const isPlaceholder = !page.hasCover || isPlaceholderCoverSrc(page.image);
        cover.dataset.devCoverDrop = page.slug;
        cover.dataset.devListingCover = grid;
        if (isPlaceholder) cover.dataset.devCoverEmpty = 'true';
        else delete cover.dataset.devCoverEmpty;

        cover.classList.toggle('project-grid__cover--has-hover', Boolean(page.hoverImage));
        cover.classList.toggle('project-grid__cover--hover-cropped', hasHoverCrop);
        cover.classList.toggle('overflow-hidden', !hasCrop);
        cover.classList.toggle('project-cropped', hasCrop);
        cover.classList.toggle('project-responsive-image', hasCrop);
        if (coverStyle) {
          cover.setAttribute('style', coverStyle);
        } else {
          cover.removeAttribute('style');
        }

        const editAttrs = listingCoverDevEditAttrs(page.slug, grid, {
          variants,
          hoverVariants,
          srcWidth: page.srcWidth,
          srcHeight: page.srcHeight,
        }, Boolean(page.full));
        for (const [key, value] of Object.entries(editAttrs)) {
          if (value === '') cover.removeAttribute(key);
          else cover.setAttribute(key, value);
        }

        const baseImg = cover.querySelector<HTMLImageElement>('.project-grid__img--base');
        if (baseImg) {
          baseImg.src = page.hasCover
            ? (page.coverUrl || projectImage(page.image))
            : projectImage('black-token.svg');
          baseImg.alt = page.title;
        }

        const hoverImg = cover.querySelector<HTMLImageElement>('.project-grid__img--hover');
        if (hoverImg) {
          if (page.hoverImage) {
            hoverImg.src = projectImage(page.hoverImage);
            hoverImg.hidden = false;
          } else {
            hoverImg.removeAttribute('src');
            hoverImg.hidden = true;
          }
        }

        const titleEl = cover.querySelector<HTMLElement>('[data-dev-project-title]');
        if (titleEl) titleEl.textContent = page.title;

        const subtitleEl = cover.querySelector<HTMLElement>('[data-dev-project-subtitle]');
        if (subtitleEl) subtitleEl.textContent = page.subtitle ?? '';

        if (isTeaser && grid !== 'play') {
          let teaserLabel = cover.querySelector<HTMLElement>('[data-dev-project-teaser-label]');
          if (!teaserLabel) {
            const row = cover.querySelector('.flex.items-baseline');
            if (row) {
              teaserLabel = document.createElement('span');
              teaserLabel.className = 'project-grid__teaser-label font-bold';
              teaserLabel.dataset.devProjectTeaserLabel = '';
              teaserLabel.dataset.placeholder = 'Teaser label';
              teaserLabel.textContent = 'Coming soon';
              row.append(teaserLabel);
            }
          }
        } else {
          cover.querySelector('[data-dev-project-teaser-label]')?.remove();
        }
      }

      if (typeof window.__vcdSyncStatusChip === 'function') {
        window.__vcdSyncStatusChip(item, page.status);
      } else {
        console.warn('[DevGalleryPages] __vcdSyncStatusChip unavailable — status chip may be stale.');
      }

      if (typeof window.__vcdEnableCardEditing === 'function') {
        window.__vcdEnableCardEditing(item);
      } else {
        console.warn('[DevGalleryPages] __vcdEnableCardEditing unavailable — card may not be editable.');
      }

      return item;
    };

    const applyMembershipPreview = () => {
      const grid = listingGrid();
      if (!grid || !activeGrid) return;
      const anchor = grid.querySelector('.project-grid__item--new');

      for (const [slug, item] of [...createdItems]) {
        if (selected.has(slug)) continue;
        item.remove();
        createdItems.delete(slug);
      }

      for (const slug of [...selected]) {
        const existing = grid.querySelector<HTMLElement>(`[data-dev-project-slug="${slug}"]`);
        if (existing) continue;

        const detached = detachedItems.get(slug);
        if (detached) {
          // Re-add lands at the end — expected; order dirtiness keeps Revert available.
          if (anchor) grid.insertBefore(detached, anchor);
          else grid.append(detached);
          detachedItems.delete(slug);
          continue;
        }

        const page = pageBySlug(slug);
        if (!page) continue;
        const created = buildGridCard(page);
        if (!created) continue;
        createdItems.set(slug, created);
        if (anchor) grid.insertBefore(created, anchor);
        else grid.append(created);
      }

      for (const item of [...grid.querySelectorAll<HTMLElement>('.project-grid__item[data-dev-project-slug]')]) {
        const slug = item.dataset.devProjectSlug;
        if (!slug || selected.has(slug)) continue;
        if (createdItems.has(slug)) {
          item.remove();
          createdItems.delete(slug);
          continue;
        }
        detachedItems.set(slug, item);
        item.remove();
      }
    };

    const restoreMembershipPreview = () => {
      selected = new Set(baseline);
      applyPagesOrder(baselinePagesOrder);
      const grid = listingGrid();
      if (!grid) {
        detachedItems.clear();
        createdItems.clear();
        return;
      }

      const byProject = new Map<string, HTMLElement>();

      for (const item of grid.querySelectorAll<HTMLElement>('.project-grid__item:not(.project-grid__item--new)')) {
        const slug = item.dataset.devProjectSlug;
        if (slug) byProject.set(slug, item);
      }
      for (const [slug, item] of detachedItems) byProject.set(slug, item);
      for (const [slug, item] of createdItems) byProject.set(slug, item);

      const anchor = grid.querySelector('.project-grid__item--new');
      for (const entry of baselineOrder) {
        const item = byProject.get(entry.slug);
        if (!item) continue;
        item.classList.toggle('project-grid__item--full', entry.full);
        if (anchor) grid.insertBefore(item, anchor);
        else grid.append(item);
      }

      for (const [slug, item] of [...createdItems]) {
        if (baseline.has(slug)) continue;
        item.remove();
        createdItems.delete(slug);
      }
      for (const item of [...grid.querySelectorAll<HTMLElement>('[data-dev-project-slug]')]) {
        const slug = item.dataset.devProjectSlug;
        if (slug && !baseline.has(slug)) item.remove();
      }

      detachedItems.clear();
      createdItems.clear();
    };

    const syncPending = () => {
      if (!activeGrid) return;
      const pendingId = `gallery-membership:${activeGrid}`;
      if (!isDirty()) {
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
        return;
      }
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'gallery-membership',
          payload: {
            grid: activeGrid,
            slugs: [...selected],
            items: captureGridOrder(),
          },
          revert: () => {
            restoreMembershipPreview();
            renderGrid();
            syncCount();
          },
        },
      }));
    };

    const visiblePages = () => pages.filter((page) => {
      const on = selected.has(page.slug);
      if (filter === 'on') return on;
      if (filter === 'off') return !on;
      return true;
    });

    const syncCount = () => {
      if (!countEl) return;
      const onCount = selected.size;
      countEl.textContent = isDirty()
        ? `${onCount} on this gallery · unsaved`
        : `${onCount} on this gallery`;
    };

    const renderGrid = () => {
      if (!gridEl) return;
      if (drag) drag.cancel();
      const list = visiblePages();
      gridEl.replaceChildren();

      if (!list.length) {
        setStatus(filter === 'on'
          ? 'No pages on this gallery yet.'
          : filter === 'off'
            ? 'Every project page is already on this gallery.'
            : 'No project pages found.');
        syncCount();
        scheduleLayoutCaps();
        return;
      }

      setStatus(`${list.length} page${list.length === 1 ? '' : 's'}`);

      for (const page of list) {
        const card = document.createElement('div');
        card.className = 'dev-gallery-pages__card';
        card.dataset.gallerySlug = page.slug;
        const isOn = selected.has(page.slug);
        card.classList.toggle('is-selected', isOn);
        card.classList.toggle('is-off', !isOn);
        card.classList.toggle('is-placeholder', !page.hasCover);

        const thumb = document.createElement('div');
        thumb.className = 'dev-gallery-pages__thumb';
        thumb.title = page.title;
        // Native <img> drag hijacks the pointer once it starts — it never fires pointermove,
        // so the custom reorder drag couldn't clear its threshold. Kill native drag outright.
        thumb.draggable = false;
        thumb.addEventListener('dragstart', (event) => event.preventDefault());

        if (page.hasCover) {
          const img = document.createElement('img');
          img.src = page.coverUrl || projectImage(page.image);
          img.alt = '';
          img.loading = 'lazy';
          img.draggable = false;
          thumb.append(img);
        } else {
          const name = document.createElement('span');
          name.className = 'dev-gallery-pages__placeholder-title';
          name.textContent = page.title;
          thumb.append(name);
        }

        const badge = document.createElement('button');
        badge.type = 'button';
        badge.className = 'dev-gallery-pages__badge dev-eye';
        badge.innerHTML = isOn ? eyeIconHtml : eyeOffIconHtml;
        badge.setAttribute(
          'aria-label',
          `${page.title}${isOn ? ' (shown on this gallery)' : ' (hidden from this gallery)'}`,
        );
        badge.setAttribute('aria-pressed', isOn ? 'true' : 'false');
        badge.draggable = false;
        badge.addEventListener('dragstart', (event) => event.preventDefault());

        badge.addEventListener('click', () => {
          if (selected.has(page.slug)) selected.delete(page.slug);
          else selected.add(page.slug);
          sortPagesByMembership();
          applyMembershipPreview();
          renderGrid();
          syncCount();
          syncPending();
        });
        attachCardDrag(card, thumb, page, isOn);

        card.append(badge, thumb);
        gridEl.append(card);
      }

      syncCount();
      scheduleLayoutCaps();
    };

    const loadPages = async () => {
      if (!activeGrid) return;
      setStatus('Loading…');
      const response = await fetch(`/api/gallery-membership?grid=${encodeURIComponent(activeGrid)}`);
      const payload = await response.json();
      if (!response.ok) throw new Error(payload.error || 'Could not load gallery pages.');
      pages = Array.isArray(payload.pages) ? payload.pages : [];
      selected = new Set(
        pages.filter((page) => page.onGallery).map((page) => page.slug),
      );
      baseline = new Set(selected);
      detachedItems.clear();
      createdItems.clear();
      baselineOrder = captureGridOrder();
      baselinePagesOrder = pages.map((page) => page.slug);
      renderGrid();
    };

    const openPanel = () => {
      const grid = currentGrid();
      if (!grid) return;
      activeGrid = grid;
      if (overlayTitle) overlayTitle.textContent = resolveDevPanelTitle('gallery-pages', { suffix: gridLabel(grid) });
      window.dispatchEvent(new CustomEvent('vcd:dev-mode-request', { detail: { active: true } }));
      panel.hidden = false;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', { detail: { panel } }));
      void loadPages().catch((error) => {
        setStatus(error instanceof Error ? error.message : 'Could not load gallery pages.');
      });
    };

    const closePanel = () => {
      if (drag) drag.cancel();
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', { detail: { panel } }));
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = button.getAttribute('data-gallery-filter');
        if (next !== 'all' && next !== 'on' && next !== 'off') return;
        filter = next;
        filterButtons.forEach((entry) => {
          entry.classList.toggle('is-active', entry.getAttribute('data-gallery-filter') === filter);
        });
        renderGrid();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drag) {
        event.preventDefault();
        event.stopImmediatePropagation();
        drag.cancel();
        return;
      }

      if (event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyP') {
        if (!currentGrid()) return;
        event.preventDefault();
        if (panel.hidden) openPanel();
        else closePanel();
        return;
      }

      if (event.key !== 'Escape') return;
      if (panel.hidden) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      closePanel();
    }, true);

    window.addEventListener('vcd:dev-pending-committed', () => {
      if (!activeGrid) return;
      baseline = new Set(selected);
      baselineOrder = captureGridOrder();
      baselinePagesOrder = pages.map((page) => page.slug);
      detachedItems.clear();
      createdItems.clear();
      for (const page of pages) {
        page.onGallery = selected.has(page.slug);
      }
      syncCount();
      renderGrid();
    });

    window.addEventListener('vcd:dev-mode-change', ((event: CustomEvent<{ active?: boolean }>) => {
      if (event.detail?.active) return;
      if (drag) drag.cancel();
      if (!panel.hidden) closePanel();
    }) as EventListener);

    window.addEventListener('vcd:dev-edit-open', ((event: CustomEvent<{ panel?: HTMLElement }>) => {
      if (event.detail?.panel !== panel) return;
      scheduleLayoutCaps();
    }) as EventListener);

    new MutationObserver(() => {
      if (!panel.hidden) scheduleLayoutCaps();
    }).observe(panel, { attributes: true, attributeFilter: ['hidden', 'class'] });
  };

  initDevGalleryPages();
</script>

<style is:global>
  .dev-overlay[data-dev-panel-key='gallery-pages'] {
    z-index: 50;
  }

  .dev-overlay[data-dev-panel-key='gallery-pages'] .dev-overlay__body {
    overflow-y: hidden;
  }

  .dev-gallery-pages {
    --dev-gallery-thumb-h: calc(var(--dev-gallery-thumb-w) * 3 / 4);
    display: flex;
    flex-direction: column;
    gap: var(--dev-panel-content-gap);
  }

  .dev-gallery-pages__status,
  .dev-gallery-pages__count {
    margin: 0;
    font: var(--dev-text-status);
    color: var(--sys-color-on-srf-variant);
  }

  .dev-gallery-pages__filters {
    flex-wrap: wrap;
    align-self: flex-start;
  }

  .dev-gallery-pages__grid {
    display: grid;
    grid-template-columns: repeat(3, var(--dev-gallery-thumb-w, 1fr));
    grid-auto-rows: var(--dev-gallery-thumb-h);
    align-content: start;
    gap: 8px;
    width: max-content;
    max-width: 100%;
    height: max-content;
    flex: 0 0 auto;
    padding: 0.15em;
  }

  .dev-gallery-pages__card {
    position: relative;
    width: var(--dev-gallery-thumb-w);
    height: var(--dev-gallery-thumb-h);
    min-height: var(--dev-gallery-thumb-h);
    max-height: var(--dev-gallery-thumb-h);
    flex-shrink: 0;
    align-self: start;
    border: 0;
    border-radius: var(--dev-radius-control);
    overflow: hidden;
    background: var(--sys-color-srf-container);
    transition: transform 150ms ease;
  }

  .dev-gallery-pages__card.is-dragging {
    z-index: 2;
    transition: none;
    box-shadow: 0 8px 19px rgb(0 0 0 / 0.28);
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-gallery-pages__card {
      transition: none;
    }
  }

  .dev-gallery-pages__card.is-selected {
    box-shadow: inset 0 0 0 1px var(--sys-color-outline);
  }

  .dev-gallery-pages__thumb {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 8px;
    border: 0;
    background: transparent;
    cursor: default;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .dev-gallery-pages__card.is-selected .dev-gallery-pages__thumb {
    cursor: grab;
    touch-action: none;
  }

  .dev-gallery-pages__card.is-dragging .dev-gallery-pages__thumb {
    cursor: grabbing;
  }

  .dev-gallery-pages__card.is-pressing .dev-gallery-pages__thumb {
    cursor: grabbing;
  }

  .dev-gallery-pages__thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: inherit;
  }

  .dev-gallery-pages__placeholder-title {
    position: relative;
    z-index: 0;
    max-width: 100%;
    color: var(--sys-color-on-srf-subtle);
    font: var(--dev-text-status);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    cursor: inherit;
  }

  /* Dimmed thumbnail, not a disabled control — deliberately not the 45%
     opacity/disabled token used for disabled controls. */
  .dev-gallery-pages__card.is-off .dev-gallery-pages__thumb img {
    opacity: 0.55;
  }

  .dev-gallery-pages__card.is-off.is-placeholder .dev-gallery-pages__placeholder-title {
    opacity: 0.55;
  }
</style>
