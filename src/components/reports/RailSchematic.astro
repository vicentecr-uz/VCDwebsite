---
import Button from '../ui/Button.astro';
import SegmentedControl from '../ui/SegmentedControl.astro';
import '../../styles/reportPrototypes.css';
---

<div class="rails" data-rails data-type="writeup">
  <div class="rails__stage" data-stage>
    <div class="rails__viewport" data-viewport>
      <div class="rails__sidebar" data-part="sidebar"><i></i><i></i><i></i><i></i></div>
      <div class="rails__column">
        <div class="rails__media"></div>
        <div class="rails__text"><i></i><i></i><i></i></div>
        <div class="rails__media rails__media--wide"></div>
        <div class="rails__text"><i></i><i></i></div>
      </div>
      <div class="rails__contents" data-part="contents"><i></i><i></i><i></i></div>
    </div>
  </div>
  <div class="rails__controls">
    <SegmentedControl label="Page type" data-slide-selection data-types>
      <Button emphasis="ghost" width="fill" label="Case study" data-value="case" />
      <Button emphasis="ghost" width="fill" label="Write-up" data-value="writeup" selected />
      <Button emphasis="ghost" width="fill" label="Both rails" data-value="both" />
    </SegmentedControl>
    <div class="proto-group">
      <div class="proto-row"><span class="dev-field__label" id="rails-width">Viewport</span><output class="proto-status" data-output></output></div>
      <input class="proto-slider" type="range" min="360" max="1680" step="8" value="1280" aria-labelledby="rails-width" data-width />
    </div>
  </div>
</div>

<script>
  import { choiceGroup } from '../../lib/reportPrototype';

  const root = document.querySelector<HTMLElement>('[data-rails]')!;
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
  const slider = root.querySelector<HTMLInputElement>('[data-width]')!;
  const output = root.querySelector<HTMLElement>('[data-output]')!;

  // Shipped numbers, in px at a 16px root: text 37.5em, media 50em, sidebar from 78.5em,
  // contents rail from 70em beside a write-up or 97em beside the media column.
  const TEXT = 600, MEDIA = 800, GAP = 48, RAIL = 192, SIDEBAR = 200, MARGIN = 16;
  const render = () => {
    const width = Number(slider.value);
    const type = root.dataset.type!;
    const column = type === 'writeup' ? TEXT : Math.min(MEDIA, width - 2 * MARGIN);
    const text = Math.min(TEXT, width - (width < 640 ? 64 : 2 * MARGIN));
    const fits = (rail: number) => width >= column + 2 * (GAP + rail + MARGIN);
    const sidebar = type !== 'writeup' && fits(SIDEBAR);
    const contents = type !== 'case' && fits(RAIL);
    const scale = Math.min(1, stage.clientWidth / width);
    viewport.style.width = `${width}px`;
    viewport.style.marginLeft = `${-width / 2}px`;
    viewport.style.scale = String(scale);
    viewport.style.setProperty('--column', `${Math.min(column, width - 2 * MARGIN)}px`);
    viewport.style.setProperty('--text', `${text}px`);
    root.querySelector<HTMLElement>('[data-part="sidebar"]')!.dataset.shown = String(sidebar);
    root.querySelector<HTMLElement>('[data-part="contents"]')!.dataset.shown = String(contents);
    slider.style.setProperty('--v', String((width - 360) / 1320));
    output.textContent = `${width}px · ${(width / 16).toFixed(1)}em`;
  };
  slider.addEventListener('input', render);
  choiceGroup(root.querySelector('[data-types]'), (value) => { root.dataset.type = value; render(); });
  new ResizeObserver(render).observe(stage);
  render();
</script>

<style>
  .rails {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-unit) * 2);
    width: min(100%, 34rem);
  }

  .rails__stage {
    position: relative;
    height: 17rem;
    overflow: hidden;
    border-radius: var(--radius-control-smooth);
    background: var(--sys-color-srf-container-low);
  }

  .rails__viewport {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    justify-content: center;
    height: 800px;
    padding-top: 96px;
    box-sizing: border-box;
    background: var(--sys-color-srf);
    transform-origin: top center;
  }

  .rails__column { display: flex; flex-direction: column; align-items: center; gap: 48px; width: var(--column); }
  .rails__column, .rails__text, .rails__media { transition: width 300ms cubic-bezier(0.32, 0.72, 0, 1); }
  .rails__text { display: flex; flex-direction: column; gap: 18px; width: var(--text); }
  .rails i { display: block; height: 10px; border-radius: 999px; background: var(--sys-color-srf-container-high); }
  .rails__text i:last-child { width: 60%; }
  .rails__media { width: var(--text); aspect-ratio: 16 / 9; border-radius: 12px; background: var(--sys-color-srf-container); }
  .rails__media--wide { width: var(--column); }

  .rails__sidebar, .rails__contents {
    position: absolute;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    opacity: 0;
    transition: opacity 200ms ease, translate 300ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .rails__sidebar { right: calc(50% + var(--column) / 2 + 48px); width: 200px; translate: 12px; }
  .rails__contents { left: calc(50% + var(--column) / 2 + 48px); width: 192px; padding-left: 14px; border-left: 2px solid var(--sys-color-srf-container-high); translate: -12px; }
  .rails__sidebar i, .rails__contents i { background: var(--sys-color-on-srf-variant); }
  .rails__sidebar i:nth-child(odd) { width: 70%; }
  .rails__contents i:nth-child(even) { width: 60%; }
  .rails :is(.rails__sidebar, .rails__contents)[data-shown='true'] { opacity: 1; translate: 0; }

  .rails__controls { display: flex; flex-direction: column; gap: var(--dev-panel-content-gap); }

  @media (prefers-reduced-motion: reduce) {
    .rails__column, .rails__text, .rails__media { transition: none; }
    .rails__sidebar, .rails__contents { translate: 0; transition: opacity 200ms ease; }
  }
</style>
