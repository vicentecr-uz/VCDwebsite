---
import Hairline from '../ui/Hairline.astro';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import { sizeIcon } from '../../lib/icons';
import '../../styles/reportPrototypes.css';

const commands = [
  ['Insert', 'Image', ''], ['Insert', 'Text section', ''], ['Insert', 'Section header', ''], ['Insert', 'Carousel', ''], ['Insert', 'Interactive demo', ''],
  ['Page', 'Page settings', ''], ['Page', 'Save', '⌘ S'], ['Page', 'Save & Publish', '⌘ ⇧ S'], ['Page', 'Preview on Mobile', '⌥ 3'],
  ['Go to', 'Pages', ''], ['Go to', 'Asset manager', '⌥ A'], ['Go to', 'Styles', ''],
  ['Edit', 'Leave Edit', '⌥ E'], ['Edit', 'Log new issue', '⌥ I'], ['Edit', 'Shortcuts', '?'],
];
---

<div class="command dev-surface" data-command>
  <label class="command__search">
    <span class="command__icon" aria-hidden="true" set:html={sizeIcon(searchIcon, 16)} />
    <input type="text" role="combobox" aria-expanded="true" aria-controls="command-list" aria-autocomplete="list" aria-label="Command" placeholder="Command" autocomplete="off" spellcheck="false" data-input />
    <kbd class="command__key">esc</kbd>
  </label>
  <Hairline />
  <ul class="command__list" id="command-list" role="listbox" aria-label="Commands" data-list>
    {commands.map(([group, label, keys], index) => (
      <li class="command__item dev-btn dev-btn--ghost dev-btn--align-start dev-btn--fill" role="option" id={`command-${index}`} data-group={group} data-label={label}>
        <span class="command__label">{label}</span>
        {keys && <span class="command__keys">{keys.split(' ').map((key) => <kbd class="command__key">{key}</kbd>)}</span>}
      </li>
    ))}
    <li class="command__empty proto-status" data-empty hidden>No matches</li>
  </ul>
  <Hairline />
  <p class="command__status proto-status" role="status" data-status>↑ ↓ ↵</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-command]')!;
  const input = root.querySelector<HTMLInputElement>('[data-input]')!;
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const items = [...list.querySelectorAll<HTMLElement>('[role="option"]')];
  let active = 0;

  const visible = () => items.filter((item) => !item.hidden);
  const highlight = (index: number, scroll = true) => {
    const shown = visible();
    active = shown.length ? (index + shown.length) % shown.length : 0;
    items.forEach((item) => item.setAttribute('aria-selected', String(item === shown[active])));
    if (shown[active]) {
      input.setAttribute('aria-activedescendant', shown[active].id);
      if (scroll) shown[active].scrollIntoView({ block: 'nearest' });
    }
  };
  const filter = () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let group = '';
    for (const item of items) {
      const text = `${item.dataset.group} ${item.dataset.label}`.toLowerCase();
      item.hidden = !words.every((word) => text.includes(word));
      // A group heading is the first visible row of each group.
      item.toggleAttribute('data-heading', !item.hidden && item.dataset.group !== group);
      if (!item.hidden) group = item.dataset.group!;
    }
    empty.hidden = visible().length > 0;
    highlight(0);
  };
  const run = (item?: HTMLElement) => {
    if (!item) return;
    status.textContent = `${item.dataset.group} · ${item.dataset.label}`;
    input.value = '';
    filter();
  };

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') { event.preventDefault(); highlight(active + 1); }
    if (event.key === 'ArrowUp') { event.preventDefault(); highlight(active - 1); }
    if (event.key === 'Enter') run(visible()[active]);
    if (event.key === 'Escape') { input.value = ''; filter(); status.textContent = '↑ ↓ ↵'; }
  });
  list.addEventListener('pointermove', (event) => {
    const item = (event.target as Element).closest<HTMLElement>('[role="option"]');
    if (item && item.getAttribute('aria-selected') !== 'true') highlight(visible().indexOf(item), false);
  });
  list.addEventListener('click', (event) => { run((event.target as Element).closest<HTMLElement>('[role="option"]') ?? undefined); input.focus(); });
  filter();
</script>

<style>
  .command {
    display: flex;
    flex-direction: column;
    width: min(100%, 24rem);
    border-radius: calc(var(--dev-radius-panel) * var(--continuous-corner-scale, 1));
    corner-shape: var(--squircle-shape);
    font-family: var(--font-sans);
    color: var(--sys-color-on-srf);
  }

  .command__search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 14px 12px;
  }

  .command__icon { display: inline-flex; color: var(--sys-color-on-srf-subtle); }

  .command__search input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: none;
    color: inherit;
    font: 400 16px/20px var(--font-sans);
  }

  .command__search input::placeholder { color: var(--sys-color-on-srf-subtle); }
  .command :global(.dev-hairline) { background: var(--sys-color-outline-subtle); }

  .command__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 17rem;
    margin: 0;
    padding: 4px;
    overflow-y: auto;
    list-style: none;
    scrollbar-width: none;
    scroll-padding-block: 28px 4px;
  }

  .command__item {
    --dev-btn-hit-inset: 0;
    justify-content: space-between;
    flex: 0 0 auto;
    padding-inline: 10px;
    font: var(--dev-text-menu-item);
    cursor: default;
  }

  .command__item[hidden] { display: none; }
  .command__item[aria-selected='true'] { background: var(--comp-button-ghost-container-hover); }

  .command__item[data-heading] { margin-top: 26px; }
  .command__item[data-heading]:first-child { margin-top: 22px; }

  .command__item[data-heading]::after {
    content: attr(data-group);
    position: absolute;
    left: 10px;
    bottom: calc(100% + 6px);
    color: var(--sys-color-on-srf-subtle);
    font: var(--dev-text-status);
    pointer-events: none;
  }

  .command__keys { display: inline-flex; gap: 3px; }

  .command__key {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 5px;
    box-sizing: border-box;
    border-radius: calc(5px * var(--continuous-corner-scale, 1));
    corner-shape: var(--squircle-shape);
    background: var(--sys-color-srf-container-low);
    box-shadow: inset 0 -1px 0 var(--sys-color-outline-variant);
    color: var(--sys-color-on-srf-variant);
    font: 500 11px/1 var(--font-sans);
  }

  .command__item[aria-selected='true'] .command__key { background: var(--sys-color-srf); }
  .command__empty { padding: 12px 10px; }
  .command__status { margin: 0; padding: 10px 14px; letter-spacing: 0.1em; }
  .command__status:not(:empty) { min-height: 12px; }
</style>
