---
import Button from '../ui/Button.astro';
import ToastStack from '../ui/ToastStack.astro';
import '../../styles/reportPrototypes.css';
---

<div class="toasts" data-toasts>
  <div class="toasts__triggers">
    <Button label="Save" data-toast="Saved" />
    <Button label="Publish" data-toast="Published" data-action="View" />
    <Button label="Delete block" data-toast="Image block deleted" data-action="Undo" />
  </div>
  <ToastStack />
</div>

<script>
  document.querySelector('[data-toasts]')?.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>('[data-toast]');
    if (trigger) window.dispatchEvent(new CustomEvent('vcd:edit-toast', {
      detail: { message: trigger.dataset.toast, action: trigger.dataset.action },
    }));
  });
</script>

<style>
  .toasts { display: flex; flex-direction: column; align-items: center; justify-content: space-between; align-self: stretch; width: 100%; }
  .toasts__triggers { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--dev-panel-spacing); }
</style>
