---
import Button from '../ui/Button.astro';
import ToastStack from '../ui/ToastStack.astro';
import '../../styles/reportPrototypes.css';
---

<div class="toasts" data-toasts>
  <div class="toasts__triggers">
    <Button label="Save" data-toast="Saved" data-icon="success" />
    <Button label="Publish" data-toast="Published" data-icon="publish" />
    <Button label="Delete block" data-toast="Image block deleted" data-icon="delete" data-demo-delete />
  </div>
  <ToastStack />
</div>

<script>
  import { createPageScope, onPageLoad } from '../../lib/pageLifecycle';

  onPageLoad(() => {
    const demo = document.querySelector('[data-toasts]');
    const stack = demo?.querySelector('[data-toast-stack]');
    if (!demo || !stack) return;
    const scope = createPageScope();
    const show = (message: string, icon: string, action?: { label: string; run: () => void }) => {
      stack.dispatchEvent(new CustomEvent('vcd:edit-toast', { detail: { message, icon, action } }));
    };
    scope.listen(demo, 'click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-toast]');
      if (!trigger?.dataset.toast) return;
      const action = trigger.hasAttribute('data-demo-delete')
        ? { label: 'Undo', run: () => show('Image block restored', 'success') }
        : undefined;
      show(trigger.dataset.toast, trigger.dataset.icon ?? 'info', action);
    });
    return scope.destroy;
  });
</script>

<style>
  .toasts { display: flex; flex-direction: column; align-items: center; justify-content: space-between; align-self: stretch; width: 100%; }
  .toasts__triggers { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--dev-panel-spacing); }
</style>
