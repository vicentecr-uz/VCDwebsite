---
import chevronIcon from 'lucide-static/icons/chevron-right.svg?raw';
import { sizeIcon } from '../../lib/icons';
import '../../styles/reportPrototypes.css';

const dives = [
  { title: 'Research notes', meta: '4 min', lines: 3, media: true },
  { title: 'Rejected directions', meta: '6 images', lines: 2, media: false },
];
---

<div class="proto-page dive" data-dive>
  <div class="proto-lines"><span></span></div>
  <div class="proto-lines"><span></span><span></span><span></span></div>
  <div class="dive__set">
    {dives.map((dive, index) => (
      <section class="dive__item">
        <h2 class="dive__heading">
          <button class="dive__toggle" type="button" aria-expanded="false" aria-controls={`dive-${index}`}>
            <span class="dive__chevron" aria-hidden="true" set:html={sizeIcon(chevronIcon, 16)} />
            <span class="dive__title">{dive.title}</span>
            <span class="dive__meta">{dive.meta}</span>
          </button>
        </h2>
        <div class="dive__panel" id={`dive-${index}`} inert>
          <div class="dive__content">
            <div class="proto-lines"><span></span><span></span>{dive.lines > 2 && <span></span>}</div>
            {dive.media
              ? <div class="dive__media"><img class="proto-media" src="/demo-fixtures/studio.svg" width="1200" height="800" alt="" /></div>
              : <div class="dive__strip">{[0, 1, 2].map(() => <span></span>)}</div>}
            <div class="proto-lines"><span></span><span></span></div>
          </div>
        </div>
      </section>
    ))}
  </div>
  <div class="proto-lines"><span></span><span></span><span></span></div>
</div>

<script>
  document.querySelector('[data-dive]')!.addEventListener('click', (event) => {
    const toggle = (event.target as Element).closest<HTMLButtonElement>('.dive__toggle');
    if (!toggle) return;
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    document.getElementById(toggle.getAttribute('aria-controls')!)!.inert = !open;
  });
</script>

<style>
  .dive { align-self: start; }
  .dive__set { display: flex; flex-direction: column; }
  .dive__item { border-top: 1px solid var(--sys-color-outline-subtle); }
  .dive__item:last-child { border-bottom: 1px solid var(--sys-color-outline-subtle); }
  .dive__heading { margin: 0; font: inherit; }

  .dive__toggle {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: calc(var(--space-unit) / 2);
    width: 100%;
    padding: var(--space-unit) 0;
    border: 0;
    background: none;
    color: var(--sys-color-on-srf);
    font-family: var(--font-sans);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    text-align: left;
    cursor: pointer;
  }

  .dive__chevron {
    display: inline-flex;
    align-self: center;
    color: var(--sys-color-on-srf-subtle);
    transition: rotate 250ms cubic-bezier(0.32, 0.72, 0, 1), color 150ms ease;
  }

  .dive__toggle[aria-expanded='true'] .dive__chevron { rotate: 90deg; }
  .dive__title { font-weight: var(--text-heading-2-weight); }
  .dive__meta { margin-left: auto; color: var(--sys-color-on-srf-subtle); font-variant-numeric: tabular-nums; }

  @media (hover: hover) and (pointer: fine) {
    .dive__toggle:hover .dive__chevron { color: var(--sys-color-on-srf); }
  }

  .dive__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .dive__toggle[aria-expanded='true'] + .dive__panel,
  .dive__heading:has([aria-expanded='true']) + .dive__panel { grid-template-rows: 1fr; }

  .dive__content {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-unit) * 2);
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .dive__content > :first-child { margin-top: var(--space-unit); }
  .dive__content > :last-child { margin-bottom: calc(var(--space-unit) * 2); }
  .dive__heading:has([aria-expanded='true']) + .dive__panel .dive__content { opacity: 1; }

  .dive__media { aspect-ratio: 16 / 9; overflow: hidden; border-radius: calc(var(--radius-control-smooth) * var(--continuous-corner-scale, 1)); corner-shape: var(--squircle-shape); }
  .dive__strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-unit); }
  .dive__strip span { aspect-ratio: 1; border-radius: calc(var(--radius-control-smooth) * var(--continuous-corner-scale, 1)); corner-shape: var(--squircle-shape); background: var(--sys-color-srf-container-low); }

  @media (prefers-reduced-motion: reduce) {
    .dive__panel, .dive__chevron { transition: none; }
  }
</style>
