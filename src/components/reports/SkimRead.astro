---
import Button from '../ui/Button.astro';
import SegmentedControl from '../ui/SegmentedControl.astro';
import '../../styles/reportPrototypes.css';

const sections = [
  { title: 'Research', lead: 'Four weeks in workshops, watching how a blade gets changed with gloves on.', lines: 3, media: 3 },
  { title: 'Mechanism', lead: 'One thumb travel does two jobs: it frees the blade and presents it.', lines: 2, media: 4 },
  { title: 'Outcome', lead: 'On shelves in 2026, with an iF Design Award.', lines: 2, media: 2 },
];
---

<div class="skim" data-skim data-mode="read">
  <div class="skim__frame">
  <div class="skim__viewport" tabindex="0" aria-label="Case study" data-viewport>
    <article class="skim__page">
      <div class="skim__hero"><img class="proto-media" src="/demo-fixtures/studio.svg" width="1200" height="800" alt="" /></div>
      {sections.map((section) => (
        <section class="skim__section">
          <h2 class="skim__title">{section.title}</h2>
          <p class="skim__lead">{section.lead}</p>
          <div class="skim__fold"><div class="proto-lines">{Array.from({ length: section.lines + 2 }, () => <span></span>)}</div></div>
          <div class="skim__media" style={`--count:${section.media}`}>
            {Array.from({ length: section.media }, (_, index) => <span style={`--position:${index * 33}%`}></span>)}
          </div>
          <div class="skim__fold"><div class="proto-lines">{Array.from({ length: section.lines }, () => <span></span>)}</div></div>
        </section>
      ))}
    </article>
  </div>
  <div class="skim__map" aria-hidden="true"><span data-thumb></span></div>
  </div>
  <div class="skim__bar">
    <span class="proto-status" data-length></span>
    <SegmentedControl label="Reading mode" data-slide-selection data-modes>
      <Button emphasis="ghost" label="Read" data-value="read" selected />
      <Button emphasis="ghost" label="Skim" data-value="skim" />
    </SegmentedControl>
  </div>
</div>

<script>
  import { choiceGroup } from '../../lib/reportPrototype';

  const root = document.querySelector<HTMLElement>('[data-skim]')!;
  const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
  const thumb = root.querySelector<HTMLElement>('[data-thumb]')!;
  const length = root.querySelector<HTMLElement>('[data-length]')!;

  // The rail is the page at scale: the thumb is the share of it on screen.
  const measure = () => {
    const share = viewport.clientHeight / viewport.scrollHeight;
    thumb.style.height = `${share * 100}%`;
    thumb.style.top = `${(viewport.scrollTop / viewport.scrollHeight) * 100}%`;
    const screens = viewport.scrollHeight / viewport.clientHeight;
    length.textContent = `${screens.toFixed(1)} screens`;
  };
  viewport.addEventListener('scroll', measure, { passive: true });
  new ResizeObserver(measure).observe(viewport.firstElementChild!);
  choiceGroup(root.querySelector('[data-modes]'), (value) => { root.dataset.mode = value; });
  measure();
</script>

<style>
  .skim {
    display: flex;
    flex-direction: column;
    gap: var(--space-unit);
    width: min(100%, 26rem);
  }

  .skim__frame { display: flex; height: 25rem; }
  .skim__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-unit); }
  .skim__bar :global(.dev-segmented) { width: auto; }

  .skim__viewport {
    flex: 1;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to bottom, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
  }

  .skim__viewport:focus-visible { outline: 2px solid var(--sys-color-on-srf); outline-offset: 4px; }

  .skim__page {
    display: flex;
    flex-direction: column;
    padding-block: 1.5rem;
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
  }

  .skim__hero { aspect-ratio: 16 / 9; overflow: hidden; border-radius: calc(var(--radius-control-smooth) * var(--continuous-corner-scale, 1)); corner-shape: var(--squircle-shape); }
  .skim__section { display: flex; flex-direction: column; padding-top: 3rem; transition: padding 500ms cubic-bezier(0.32, 0.72, 0, 1); }
  .skim__title { margin: 0; font-size: inherit; font-weight: var(--text-heading-2-weight); }
  .skim__lead { margin: 0; color: var(--sys-color-on-srf); }

  .skim__fold {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 500ms cubic-bezier(0.32, 0.72, 0, 1), opacity 250ms ease;
  }

  .skim__fold > * { min-height: 0; overflow: hidden; padding-top: calc(var(--space-unit) * 2); }

  /* Read: media stacks full width. Skim: the same run becomes one row, a strip to open. */
  .skim__media {
    display: grid;
    grid-template-columns: repeat(var(--columns, 1), minmax(0, 1fr));
    gap: var(--space-unit);
    padding-top: calc(var(--space-unit) * 2);
  }

  .skim__media span {
    aspect-ratio: 3 / 2;
    border-radius: calc(var(--radius-control-smooth) * var(--continuous-corner-scale, 1));
    corner-shape: var(--squircle-shape);
    background: url('/demo-fixtures/studio.preview.webp') var(--position) 50% / 220% auto var(--sys-color-srf-container-low);
  }

  [data-mode='skim'] .skim__fold { grid-template-rows: 0fr; opacity: 0; }
  [data-mode='skim'] .skim__media { --columns: 4; }
  [data-mode='skim'] .skim__media span { aspect-ratio: 1; }
  [data-mode='skim'] .skim__section { padding-top: 2rem; }

  .skim__map {
    position: relative;
    width: 3px;
    margin: 1.5rem 0 1.5rem 1rem;
    border-radius: 999px;
    background: var(--sys-color-srf-container);
  }

  .skim__map span {
    position: absolute;
    inset-inline: 0;
    border-radius: inherit;
    corner-shape: inherit;
    background: var(--sys-color-on-srf-faint);
    transition: height 500ms cubic-bezier(0.32, 0.72, 0, 1);
  }


  @media (prefers-reduced-motion: reduce) {
    .skim__fold { transition: opacity 250ms ease; }
    .skim__section, .skim__map span { transition: none; }
  }
</style>
