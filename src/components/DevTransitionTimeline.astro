<aside class="dev-transition-timeline" data-dev-transition-timeline hidden aria-label="Transition timeline">
  <div class="dev-transition-timeline__head"><div><span>Load timeline</span><strong data-transition-current>Navigation / DOM</strong></div><button type="button" data-transition-fade>Fade here</button><button type="button" data-transition-replay>Replay</button></div>
  <input type="range" min="0" max="1000" value="0" step="1" aria-label="Scrub transition simulation" data-transition-scrubber />
  <div class="dev-transition-timeline__track"><i data-transition-playhead></i></div><ol data-transition-milestones></ol>
</aside>
<style>
  .dev-transition-timeline { position: fixed; inset: auto 16px max(12px, env(safe-area-inset-bottom)); z-index: 101; padding: 12px 16px 10px; border-radius: var(--dev-radius-panel); color: var(--sys-color-on-srf); background: var(--sys-color-srf); box-shadow: var(--dev-surface-shadow); font: var(--dev-text-label); }
  .dev-transition-timeline__head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; } .dev-transition-timeline__head > div { flex: 1; } .dev-transition-timeline__head span { display: block; color: var(--sys-color-on-srf-subtle); font: var(--dev-text-badge); letter-spacing: .08em; text-transform: uppercase; }
  .dev-transition-timeline button { border: 0; border-radius: var(--dev-radius-control); padding: 6px 10px; color: var(--sys-color-on-srf); background: var(--sys-color-srf-variant); font: var(--dev-text-label); cursor: pointer; }
  .dev-transition-timeline__track { position: relative; height: 3px; background: var(--sys-color-srf-variant); } .dev-transition-timeline__track i { position: absolute; top: -4px; left: 0; width: 2px; height: 11px; background: var(--sys-color-on-srf); }
  .dev-transition-timeline input { display: block; width: 100%; height: 18px; margin: 0; accent-color: var(--sys-color-on-srf); cursor: ew-resize; }
  .dev-transition-timeline ol { display: flex; flex-wrap: wrap; gap: 5px 16px; margin: 10px 0 0; padding: 0; list-style: none; } .dev-transition-timeline li { color: var(--sys-color-on-srf-subtle); font: var(--dev-text-badge); } .dev-transition-timeline li[data-seen='true'] { color: var(--sys-color-on-srf); }
  @media (max-width: 640px) { .dev-transition-timeline { inset-inline: 8px; } .dev-transition-timeline__head { flex-wrap: wrap; } }
</style>
<script>
  const timeline = document.querySelector<HTMLElement>('[data-dev-transition-timeline]');
  if (timeline && new URLSearchParams(location.search).get('dev-transition') === 'scrub') {
    timeline.hidden = false; const overlay = document.getElementById('transition-overlay'); const scrubber = timeline.querySelector<HTMLInputElement>('[data-transition-scrubber]'); const playhead = timeline.querySelector<HTMLElement>('[data-transition-playhead]'); const current = timeline.querySelector<HTMLElement>('[data-transition-current]'); const list = timeline.querySelector<HTMLOListElement>('[data-transition-milestones]');
    const labels: Record<string, string> = { 'navigation-dom': 'Navigation / DOM', 'thumb-ready': 'Visible thumb', 'fonts-ready': 'Fonts ready', 'readiness-satisfied': 'Readiness satisfied', 'opaque-paint': 'Opaque paint', 'fade-authorized': 'Fade authorized', 'veil-fade-start': 'Veil fade start', 'veil-fade-end': 'Veil fade end', 'preview-gate-open': 'Preview gate open', 'preview-fetch-start': 'Preview fetch start', 'preview-swap-ready': 'Preview swap ready' };
    const buffer = ((window as Window & { __vcdTransitionMilestones?: Array<{ name: string; time: number; index?: number }> }).__vcdTransitionMilestones ?? []); const start = buffer[0]?.time ?? 0; const fadeAt = { value: 1 };
    const record = (event: { name: string; time: number; index?: number }) => { const item = document.createElement('li'); item.dataset.seen = 'true'; item.dataset.time = String(event.time); item.textContent = `${labels[event.name] ?? event.name}${event.index ? ` ${event.index}` : ''} · ${Math.round(event.time - start)}ms`; list?.appendChild(item); if (current) current.textContent = labels[event.name] ?? event.name; };
    buffer.forEach(record); window.addEventListener('vcd:transition-milestone', (event) => record((event as CustomEvent<{ name: string; time: number; index?: number }>).detail));
    const render = () => { const value = Number(scrubber?.value ?? 0) / 1000; if (playhead) playhead.style.left = `${value * 100}%`; if (overlay) { overlay.style.animation = 'none'; overlay.style.opacity = value < fadeAt.value ? '1' : String(Math.max(0, 1 - (value - fadeAt.value) / .0625)); } list?.querySelectorAll<HTMLElement>('li').forEach((item) => { item.hidden = Number(item.dataset.time) > start + value * 4000; }); };
    scrubber?.addEventListener('input', render); timeline.querySelector('[data-transition-fade]')?.addEventListener('click', () => { fadeAt.value = Number(scrubber?.value ?? 0) / 1000; render(); }); timeline.querySelector('[data-transition-replay]')?.addEventListener('click', () => window.location.reload());
    const observer = new MutationObserver((mutations) => mutations.forEach((mutation) => { const name = mutation.attributeName === 'data-image-preview-upgrading' ? 'preview-fetch-start' : mutation.attributeName === 'data-image-upgraded' ? 'preview-swap-ready' : ''; if (name) record({ name, time: performance.now() }); })); observer.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['data-image-preview-upgrading', 'data-image-upgraded'] }); render();
  }
</script>
