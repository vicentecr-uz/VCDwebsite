---
import DevOverlay from './DevOverlay.astro';
---

<DevOverlay
  title="Log new issue"
  storageKey="log-issue"
  panelKey="log-issue"
  defaultHidden
>
    <div class="dev-log-issue" data-dev-log-issue>
      <label class="dev-log-issue__field">
        <span>Title</span>
        <input type="text" data-log-title autocomplete="off" spellcheck="true" />
      </label>

      <label class="dev-log-issue__field">
        <span>Description</span>
        <textarea data-log-body rows="5" spellcheck="true"></textarea>
      </label>

      <div
        class="dev-log-issue__drop"
        data-log-drop
        tabindex="0"
        role="button"
        aria-label="Attach screenshots or recordings"
      >
        <p class="dev-log-issue__drop-label" data-log-drop-label>
          Drop screenshots or recordings
        </p>
        <ul class="dev-log-issue__files" data-log-files hidden></ul>
        <input
          type="file"
          data-log-file-input
          accept="image/*,video/*"
          multiple
          hidden
        />
      </div>

      <div class="dev-log-issue__row">
        <label class="dev-log-issue__field">
          <span>Label</span>
          <select data-log-label required>
            <option value="">Select…</option>
          </select>
        </label>
        <label class="dev-log-issue__field">
          <span>Page</span>
          <select data-log-page-label>
            <option value="">Select…</option>
          </select>
        </label>
      </div>

      <label class="dev-log-issue__field">
        <span>Milestone</span>
        <select data-log-milestone required>
          <option value="">Select…</option>
        </select>
      </label>

      <div class="dev-log-issue__pick-block">
        <div class="dev-log-issue__pick-head">
          <button type="button" class="dev-log-issue__clear" data-log-clear hidden>
            Clear
          </button>
        </div>
        <button type="button" class="dev-log-issue__pick" data-log-pick>
          Pick element on page
        </button>
        <p class="dev-log-issue__picked" data-log-picked hidden></p>
      </div>

      <div class="dev-log-issue__actions">
        <button type="button" data-log-cancel>Cancel</button>
        <button type="button" class="dev-log-issue__primary" data-log-submit>Log issue</button>
      </div>

      <div class="dev-log-issue__veil" data-log-veil hidden>
        <div class="dev-log-issue__veil-card" data-log-veil-card>
          <p class="dev-log-issue__veil-message" data-log-veil-message></p>
          <div class="dev-log-issue__veil-actions" data-log-veil-actions hidden>
            <button type="button" data-log-veil-no>No</button>
            <button type="button" class="dev-log-issue__primary" data-log-veil-yes>Yes</button>
          </div>
        </div>
      </div>
    </div>
  </DevOverlay>

<div class="dev-log-issue-pick-outline" data-log-pick-outline hidden></div>

<script>
  type Attachment = { filename: string; data: string; mimeType: string };

  const initDevLogIssue = () => {
    const root = document.querySelector<HTMLElement>('[data-dev-log-issue]');
    const panel = root?.closest<HTMLElement>('[data-dev-overlay]');
    const outline = document.querySelector<HTMLElement>('[data-log-pick-outline]');
    if (!root || !panel || !outline) return;
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const titleInput = root.querySelector<HTMLInputElement>('[data-log-title]');
    const bodyInput = root.querySelector<HTMLTextAreaElement>('[data-log-body]');
    const drop = root.querySelector<HTMLElement>('[data-log-drop]');
    const dropLabel = root.querySelector<HTMLElement>('[data-log-drop-label]');
    const filesList = root.querySelector<HTMLElement>('[data-log-files]');
    const fileInput = root.querySelector<HTMLInputElement>('[data-log-file-input]');
    const labelSelect = root.querySelector<HTMLSelectElement>('[data-log-label]');
    const pageLabelSelect = root.querySelector<HTMLSelectElement>('[data-log-page-label]');
    const milestoneSelect = root.querySelector<HTMLSelectElement>('[data-log-milestone]');
    const pickButton = root.querySelector<HTMLButtonElement>('[data-log-pick]');
    const clearPickButton = root.querySelector<HTMLButtonElement>('[data-log-clear]');
    const pickedNote = root.querySelector<HTMLElement>('[data-log-picked]');
    const cancelButton = root.querySelector<HTMLButtonElement>('[data-log-cancel]');
    const submitButton = root.querySelector<HTMLButtonElement>('[data-log-submit]');
    const veil = root.querySelector<HTMLElement>('[data-log-veil]');
    const veilCard = root.querySelector<HTMLElement>('[data-log-veil-card]');
    const veilMessage = root.querySelector<HTMLElement>('[data-log-veil-message]');
    const veilActions = root.querySelector<HTMLElement>('[data-log-veil-actions]');
    const veilNo = root.querySelector<HTMLButtonElement>('[data-log-veil-no]');
    const veilYes = root.querySelector<HTMLButtonElement>('[data-log-veil-yes]');

    if (
      !titleInput || !bodyInput || !drop || !dropLabel || !filesList || !fileInput
      || !labelSelect || !pageLabelSelect || !milestoneSelect || !pickButton || !clearPickButton || !pickedNote
      || !cancelButton || !submitButton || !veil || !veilCard || !veilMessage
      || !veilActions || !veilNo || !veilYes
    ) return;

    let attachments: Attachment[] = [];
    let pickMode = false;
    let pickedContext = '';
    let metaBranch = '';
    let veilMode: 'idle' | 'cancel' | 'logging' | 'done' = 'idle';
    /** How we opened the cancel confirm — Esc again means Yes; Cancel-click then Esc means No. */
    let cancelConfirmSource: 'escape' | 'button' | null = null;
    let pageLabelTouched = false;
    /** Page labels the API returned — used to validate auto-picks. */
    let pageLabelOptions: string[] = [];

    const isDirty = () => Boolean(
      titleInput.value.trim()
      || bodyInput.value.trim()
      || attachments.length
      || pickedContext
      || labelSelect.value
      || pageLabelSelect.value
      || milestoneSelect.value,
    );

    const setPickedContext = (value: string, note: string) => {
      pickedContext = value;
      const hasPick = Boolean(value) || Boolean(note);
      pickedNote.hidden = !hasPick;
      pickedNote.textContent = note;
      clearPickButton.hidden = !value;
    };

    const clearPickedElement = () => {
      setPickedContext('', '');
    };

    const resetForm = () => {
      titleInput.value = '';
      bodyInput.value = '';
      attachments = [];
      labelSelect.value = '';
      pageLabelSelect.value = '';
      pageLabelTouched = false;
      milestoneSelect.value = '';
      renderFiles();
      clearPickedElement();
      hideVeil();
      stopPickMode();
    };

    /** Infer which page-area label fits the current URL / DOM. */
    const inferPageLabelFromDocument = () => {
      if (document.querySelector('[data-dev-project-drop-zone], .project-page')) {
        return 'project pages';
      }
      const grid = document.querySelector<HTMLElement>('[data-dev-project-grid]');
      if (grid?.dataset.devProjectGrid === 'home') return 'home page';
      if (grid?.dataset.devProjectGrid === 'work' || grid?.dataset.devProjectGrid === 'play') {
        return 'gallery pages';
      }
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      if (path === '/') return 'home page';
      if (path === '/about') return 'about page';
      if (path === '/work' || path === '/play') return 'gallery pages';
      return '';
    };

    /** Prefer element context over the bare URL when picking. */
    const inferPageLabelFromElement = (target: Element) => {
      if (target.closest(
        '[data-dev-project-drop-zone], .project-page, [data-dev-document], '
        + '[data-dev-text-document], [data-dev-section-deletable], [data-section-nav-root]',
      )) {
        return 'project pages';
      }
      const grid = target.closest<HTMLElement>('[data-dev-project-grid]');
      if (grid?.dataset.devProjectGrid === 'home') return 'home page';
      if (grid?.dataset.devProjectGrid === 'work' || grid?.dataset.devProjectGrid === 'play') {
        return 'gallery pages';
      }
      if (target.closest('.listing-main')) {
        return inferPageLabelFromDocument();
      }
      return inferPageLabelFromDocument();
    };

    const applyPageLabel = (name: string, { force = false } = {}) => {
      if (!name || !pageLabelOptions.includes(name)) return;
      if (!force && pageLabelTouched) return;
      pageLabelSelect.value = name;
    };

    const autoFillPageLabel = (target?: Element) => {
      const inferred = target
        ? inferPageLabelFromElement(target)
        : inferPageLabelFromDocument();
      applyPageLabel(inferred, { force: Boolean(target) });
    };

    const openPanel = () => {
      panel.hidden = false;
      void loadMeta().then(() => autoFillPageLabel());
      requestAnimationFrame(() => titleInput.focus());
    };

    const closePanel = () => {
      stopPickMode();
      hideVeil();
      panel.hidden = true;
      resetForm();
    };

    let veilMotionTimer = 0;
    let veilMotionGeneration = 0;

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clearVeilMotion = () => {
      if (veilMotionTimer) {
        window.clearTimeout(veilMotionTimer);
        veilMotionTimer = 0;
      }
    };

    /**
     * Covering veils fade only (no rise). Standalone panels use DevOverlay's
     * fade+rise. Keep both paths animated — nothing in this chrome should pop.
     */
    const showVeil = () => {
      clearVeilMotion();
      veilMotionGeneration += 1;
      veil.hidden = false;
      veil.classList.remove('is-dev-log-veil-open');
      void veil.offsetWidth;
      if (prefersReducedMotion()) {
        veil.classList.add('is-dev-log-veil-open');
        return;
      }
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          veil.classList.add('is-dev-log-veil-open');
        });
      });
    };

    const hideVeil = () => {
      clearVeilMotion();
      const generation = ++veilMotionGeneration;
      veilActions.hidden = true;
      veilMode = 'idle';
      cancelConfirmSource = null;
      veil.classList.remove('is-dev-log-veil-open');

      const finish = () => {
        if (generation !== veilMotionGeneration) return;
        veil.hidden = true;
      };

      if (prefersReducedMotion() || veil.hidden) {
        finish();
        return;
      }
      veilMotionTimer = window.setTimeout(finish, 200);
    };

    const showCancelConfirm = (source: 'escape' | 'button') => {
      cancelConfirmSource = source;
      veilMode = 'cancel';
      veilMessage.textContent = 'Are you sure you want to cancel?';
      veilActions.hidden = false;
      showVeil();
    };

    /** Same as the Cancel button: confirm if dirty, otherwise close. */
    const requestCancel = (source: 'escape' | 'button') => {
      if (!isDirty()) {
        closePanel();
        return;
      }
      showCancelConfirm(source);
    };

    const showLoggingVeil = (message: string) => {
      veilMode = 'logging';
      veilMessage.textContent = message;
      veilActions.hidden = true;
      showVeil();
    };

    const fileToAttachment = (file: File) => new Promise<Attachment>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = String(reader.result || '');
        const comma = result.indexOf(',');
        const data = comma >= 0 ? result.slice(comma + 1) : result;
        resolve({
          filename: file.name,
          data,
          mimeType: file.type || 'application/octet-stream',
        });
      };
      reader.onerror = () => reject(new Error(`Could not read ${file.name}`));
      reader.readAsDataURL(file);
    });

    const renderFiles = () => {
      filesList.replaceChildren();
      if (!attachments.length) {
        filesList.hidden = true;
        dropLabel.hidden = false;
        return;
      }
      dropLabel.hidden = true;
      filesList.hidden = false;
      attachments.forEach((file, index) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = file.filename;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.textContent = 'Remove';
        remove.addEventListener('click', (event) => {
          event.stopPropagation();
          attachments.splice(index, 1);
          renderFiles();
        });
        li.append(name, remove);
        filesList.append(li);
      });
    };

    const addFiles = async (list: FileList | File[]) => {
      const incoming = [...list].filter((file) => (
        file.type.startsWith('image/') || file.type.startsWith('video/')
      ));
      if (!incoming.length) return;
      const next = await Promise.all(incoming.map(fileToAttachment));
      attachments.push(...next);
      renderFiles();
    };

    const loadMeta = async () => {
      try {
        const response = await fetch('/api/dev-issue');
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not load labels.');
        metaBranch = String(payload.branch || '');
        labelSelect.replaceChildren(new Option('Select…', ''));
        for (const name of payload.labels || []) {
          labelSelect.append(new Option(String(name), String(name)));
        }
        pageLabelOptions = (payload.pageLabels || []).map(String);
        pageLabelSelect.replaceChildren(new Option('Select…', ''));
        for (const name of pageLabelOptions) {
          pageLabelSelect.append(new Option(name, name));
        }
        milestoneSelect.replaceChildren(new Option('Select…', ''));
        for (const milestone of payload.milestones || []) {
          milestoneSelect.append(
            new Option(String(milestone.title), String(milestone.title)),
          );
        }
      } catch (error) {
        dropLabel.textContent = error instanceof Error
          ? error.message
          : 'Could not reach the issue API.';
      }
    };

    /** Walk up for section / document / path context already on the DOM. */
    const describeElement = (target: Element | null) => {
      if (!(target instanceof Element)) return null;
      const section = target.closest<HTMLElement>('[data-dev-section-deletable]');
      const type = section?.dataset.devSectionDeletable
        || target.closest<HTMLElement>('[data-dev-grid-target]')?.dataset.devGridTarget
        || target.closest<HTMLElement>('[data-dev-carousel-target]')?.dataset.devCarouselTarget
        || target.closest<HTMLElement>('[data-dev-image-target]')?.dataset.devImageTarget
        || 'element';

      const spacingHost = target.closest<HTMLElement>('[data-dev-spacing-document][data-dev-spacing-path]');
      const docHost = target.closest<HTMLElement>('[data-dev-document], [data-dev-text-document], [data-dev-spacing-document]');
      const documentKey = spacingHost?.dataset.devSpacingDocument
        || docHost?.dataset.devDocument
        || docHost?.dataset.devTextDocument
        || docHost?.dataset.devSpacingDocument
        || '';

      let pathLabel = '';
      const tryPath = (raw: string | undefined) => {
        if (!raw) return;
        try {
          const parts = JSON.parse(raw) as Array<string | number>;
          if (!Array.isArray(parts) || !parts.length) return;
          // Prefer section root: ["sections", N, ...] → sections[N]
          if (parts[0] === 'sections' && typeof parts[1] === 'number') {
            pathLabel = `sections[${parts[1]}]`;
            return;
          }
          pathLabel = parts.map(String).join('.');
        } catch {
          // ignore
        }
      };

      tryPath(spacingHost?.dataset.devSpacingPath);
      if (!pathLabel) {
        const pathHost = target.closest<HTMLElement>(
          '[data-dev-image-path], [data-dev-grid-path], [data-dev-carousel-path], [data-dev-text-path]',
        );
        tryPath(
          pathHost?.dataset.devImagePath
          || pathHost?.dataset.devGridPath
          || pathHost?.dataset.devCarouselPath
          || pathHost?.dataset.devTextPath,
        );
      }

      if (!documentKey && !pathLabel) return null;
      const file = documentKey
        ? `src/content/projects/${documentKey}.json`
        : 'unknown document';
      return `${pathLabel || '—'} — ${type} — ${file}`;
    };

    const stopPickMode = () => {
      if (!pickMode) return;
      pickMode = false;
      pickButton.classList.remove('is-active');
      pickButton.textContent = 'Pick element on page';
      outline.hidden = true;
      document.documentElement.classList.remove('is-dev-log-picking');
    };

    const startPickMode = () => {
      pickMode = true;
      pickButton.classList.add('is-active');
      pickButton.textContent = 'Click an element… (Esc to cancel)';
      document.documentElement.classList.add('is-dev-log-picking');
      // Hide the panel so the page is visible to pick against; reopen after.
      panel.hidden = true;
    };

    const placeOutline = (el: Element) => {
      const rect = el.getBoundingClientRect();
      outline.hidden = false;
      outline.style.top = `${rect.top}px`;
      outline.style.left = `${rect.left}px`;
      outline.style.width = `${rect.width}px`;
      outline.style.height = `${rect.height}px`;
    };

    const buildContextBlock = () => {
      const lines = [
        '',
        '---',
        `Page: ${window.location.href}`,
        `Branch: ${metaBranch || '(unknown)'}`,
        `Viewport: ${window.innerWidth}×${window.innerHeight}`,
      ];
      if (pickedContext) lines.push(`Element: ${pickedContext}`);
      return lines.join('\n');
    };

    const submitIssue = async () => {
      const title = titleInput.value.trim();
      const description = bodyInput.value.trim();
      const label = labelSelect.value;
      const pageLabel = pageLabelSelect.value;
      const milestone = milestoneSelect.value;

      if (!title) {
        titleInput.focus();
        return;
      }
      if (!description) {
        bodyInput.focus();
        return;
      }
      if (!label) {
        labelSelect.focus();
        return;
      }
      if (!milestone) {
        milestoneSelect.focus();
        return;
      }

      showLoggingVeil('Logging issue…');
      submitButton.disabled = true;
      cancelButton.disabled = true;

      try {
        const response = await fetch('/api/dev-issue', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            title,
            body: `${description}${buildContextBlock()}`,
            label,
            pageLabel: pageLabel || undefined,
            milestone,
            attachments,
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not create the issue.');

        const number = payload.number ? `#${payload.number}` : 'created';
        veilMode = 'done';
        veilMessage.textContent = `Logged ${number}`;
        if (payload.url) {
          const link = document.createElement('a');
          link.href = payload.url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = payload.url;
          veilMessage.append(document.createElement('br'), link);
        }
        window.setTimeout(() => closePanel(), 1600);
      } catch (error) {
        hideVeil();
        veilMode = 'idle';
        dropLabel.hidden = false;
        dropLabel.textContent = error instanceof Error
          ? error.message
          : 'Could not create the issue.';
      } finally {
        submitButton.disabled = false;
        cancelButton.disabled = false;
      }
    };

    drop.addEventListener('click', () => fileInput.click());
    drop.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        fileInput.click();
      }
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) void addFiles(fileInput.files);
      fileInput.value = '';
    });
    drop.addEventListener('dragover', (event) => {
      event.preventDefault();
      drop.classList.add('is-dragover');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-dragover'));
    drop.addEventListener('drop', (event) => {
      event.preventDefault();
      drop.classList.remove('is-dragover');
      if (event.dataTransfer?.files?.length) void addFiles(event.dataTransfer.files);
    });

    pageLabelSelect.addEventListener('change', () => {
      pageLabelTouched = true;
    });

    pickButton.addEventListener('click', () => {
      if (pickMode) stopPickMode();
      else startPickMode();
    });

    clearPickButton.addEventListener('click', () => {
      clearPickedElement();
    });

    document.addEventListener('pointermove', (event) => {
      if (!pickMode) return;
      const el = document.elementFromPoint(event.clientX, event.clientY);
      if (!el || el === outline || panel.contains(el)) {
        outline.hidden = true;
        return;
      }
      const host = el.closest<HTMLElement>(
        '[data-dev-section-deletable], [data-dev-grid-target], [data-dev-carousel-target], [data-dev-image-target], [data-dev-spacing-document], section, [id]',
      ) || el;
      placeOutline(host);
    }, true);

    document.addEventListener('click', (event) => {
      if (!pickMode) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const el = event.target;
      if (!(el instanceof Element)) return;
      const description = describeElement(el);
      stopPickMode();
      panel.hidden = false;
      autoFillPageLabel(el);
      if (description) {
        setPickedContext(description, description);
      } else {
        setPickedContext(
          '',
          'No mapped section under that click — page/branch context will still be attached.',
        );
      }
    }, true);

    cancelButton.addEventListener('click', (event) => {
      if (event.altKey) {
        closePanel();
        return;
      }
      requestCancel('button');
    });

    veilNo.addEventListener('click', () => hideVeil());
    veilYes.addEventListener('click', () => closePanel());
    submitButton.addEventListener('click', () => void submitIssue());

    // Capture Esc so cancel-confirm / pick-mode / form-dismiss win over DevModeController.
    document.addEventListener('keydown', (event) => {
      if (event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyI') {
        event.preventDefault();
        if (panel.hidden) openPanel();
        else if (veilMode === 'cancel') hideVeil();
        else titleInput.focus();
        return;
      }

      if (event.key !== 'Escape') return;

      if (pickMode) {
        event.preventDefault();
        event.stopImmediatePropagation();
        stopPickMode();
        panel.hidden = false;
        return;
      }

      if (panel.hidden) return;

      if (veilMode === 'cancel') {
        event.preventDefault();
        event.stopImmediatePropagation();
        // Esc opened the confirm → Esc again confirms (Yes).
        // Cancel button opened it → Esc goes back one step (No).
        if (cancelConfirmSource === 'escape') closePanel();
        else hideVeil();
        return;
      }

      if (veilMode === 'logging' || veilMode === 'done') return;

      // Form open: Esc acts like Cancel.
      event.preventDefault();
      event.stopImmediatePropagation();
      requestCancel('escape');
    }, true);
  };

  initDevLogIssue();
</script>

<style>
  :global(.dev-overlay[data-dev-panel-key='log-issue']) {
    width: min(28em, calc(100vw - 2em));
    z-index: 55; /* above gallery-pages panel (z-index: 50) when both are open */
  }

  .dev-log-issue {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65em;
    font-size: 0.85rem;
  }

  .dev-log-issue__field {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    color: var(--sys-color-on-srf-muted);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dev-log-issue__field input,
  .dev-log-issue__field textarea,
  .dev-log-issue__field select {
    width: 100%;
    border: 0;
    /* Plain radius — no corner-shape. Hyperellipse moves fill onto a
       z-index:-1 ::before; inside the overlay's backdrop-filter stacking
       context that layer drops behind the surface and the fill vanishes on
       focus (same fight as project chips — see project.css). */
    border-radius: var(--radius-control);
    background-color: var(--sys-color-srf-container-high);
    padding: 0.55em 0.65em;
    color: var(--sys-color-on-srf);
    font: inherit;
    font-size: 0.85rem;
    letter-spacing: normal;
    text-transform: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .dev-log-issue__field input:focus,
  .dev-log-issue__field textarea:focus,
  .dev-log-issue__field select:focus,
  .dev-log-issue__field input:focus-visible,
  .dev-log-issue__field textarea:focus-visible,
  .dev-log-issue__field select:focus-visible {
    background-color: var(--sys-color-srf-container-high);
    /* Inset ring — outer outline is clipped by DevOverlay__surface overflow. */
