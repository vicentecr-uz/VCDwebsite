---
import SelectField from './ui/SelectField.astro';

const inputModeOptions = [
  { value: 'auto', label: 'Auto' },
  { value: 'mouse', label: 'Mouse' },
  { value: 'trackpad', label: 'Trackpad' },
];
---

<dialog class="image-lightbox" data-image-lightbox aria-label="Image viewer">
  <div class="image-lightbox__viewer" data-image-lightbox-viewer tabindex="0" role="group" aria-label="Image viewer" aria-keyshortcuts="Escape + - 0 ArrowUp ArrowDown ArrowLeft ArrowRight">
    <img class="image-lightbox__image" data-image-lightbox-image alt="" draggable="false" />
    <span class="image-lightbox__demo-pointer" data-image-lightbox-demo-pointer="one" aria-hidden="true"></span>
    <span class="image-lightbox__demo-pointer" data-image-lightbox-demo-pointer="two" aria-hidden="true"></span>
    <p class="image-lightbox__error" data-image-lightbox-error role="status" hidden>Image could not be loaded.</p>
    <div class="image-lightbox__input-mode">
      <SelectField label="Input mode" hideLabel data-image-lightbox-input-mode options={inputModeOptions} />
    </div>
  </div>
</dialog>

<script>
  import { IMAGE_LIGHTBOX_MAX_SCALE, distance, midpoint, panForPinch, type Point } from '../lib/imageLightbox';
  import { gsap } from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(CustomEase);
  const gestureEase = CustomEase.create('vcdLightboxGesture', '0.4,0,0.2,1');
  const repositionEase = gsap.parseEase('power2.out');

  const bindImageLightbox = (dialog: HTMLDialogElement) => {
    const viewer = dialog.querySelector<HTMLElement>('[data-image-lightbox-viewer]');
    const image = dialog.querySelector<HTMLImageElement>('[data-image-lightbox-image]');
    const error = dialog.querySelector<HTMLElement>('[data-image-lightbox-error]');
    if (!viewer || !image || !error) return () => {};
    const demoOne = viewer.querySelector<HTMLElement>('[data-image-lightbox-demo-pointer="one"]');
    const demoTwo = viewer.querySelector<HTMLElement>('[data-image-lightbox-demo-pointer="two"]');
    if (!demoOne || !demoTwo) return () => {};
    const inputModeSelect = viewer.querySelector<HTMLSelectElement>('[data-image-lightbox-input-mode]');
    type View = { x: number; y: number; scale: number; rotation: number };
    type Gesture = 'drag' | 'pan' | 'pinch' | 'rotate' | 'blocked' | null;
    const fit = (): View => ({ x: 0, y: 0, scale: 1, rotation: 0 });
    const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));
    const angle = (a: Point, b: Point) => Math.atan2(b.y - a.y, b.x - a.x) * 180 / Math.PI;
    const angleDelta = (a: number, b: number) => ((a - b + 540) % 360) - 180;
    const uprightRotation = (rotation: number) => Math.round(rotation / 360) * 360;
    const resistedRotation = (rotation: number) => {
      const upright = uprightRotation(rotation);
      const delta = rotation - upright;
      return Math.abs(delta) <= 20 ? upright + delta * .1 : rotation;
    };
    const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isInteractiveControl = (target: EventTarget | null) => target instanceof Element && Boolean(target.closest('select,button,input,textarea,.image-lightbox__input-mode,.dev-select__listbox,[role="option"],[contenteditable="true"],[contenteditable="plaintext-only"]'));
    const isInputModePopupOpen = () => Boolean(viewer.querySelector('.dev-select__listbox:popover-open'));
    let view = fit();
    let start = fit();
    let velocity = fit();
    let lastSample = 0;
    let opener: HTMLImageElement | null = null;
    let restoreKeyboardFocus = false;
    let gesture: Gesture = null;
    let feedback: 'drag' | 'pinch' | null = null;
    let moved = false;
    let armed = false;
    let allowUnderzoom = false;
    let startPoint: Point = { x: 0, y: 0 };
    let startMidpoint = startPoint;
    let startDistance = 1;
    let startAngle = 0;
    let rotationTravel = 0;
    let lastPointer: Point | null = null;
    let nativeZoomPoint: Point | null = null;
    const pointers = new Map<number, Point>();
    let nativeGesture = false;
    let nativeUntil = 0;
    let wheelPinch: boolean | null = null;
    type InputMode = 'auto' | 'mouse' | 'trackpad';
    const inputModeStorageKey = 'vcd:image-lightbox-input-mode';
    const validInputMode = (value: string | null): InputMode => value === 'mouse' || value === 'trackpad' ? value : 'auto';
    let inputMode: InputMode = 'auto';
    try { inputMode = validInputMode(localStorage.getItem(inputModeStorageKey)); } catch {}
    if (inputModeSelect) inputModeSelect.value = inputMode;
    let autoWheelConfidence: 'mouse' | 'trackpad' | null = null;
    let mouseBurstEvidence = 0;
    let wheelInputMode: 'mouse' | 'trackpad' | null = null;
    let wheelStart: View | null = null;
    let wheelTrackpadOffset: Point = { x: 0, y: 0 };
    let wheelTrackpadDismissEligible = false;
    let wheelTrackpadActive = false;
    let coarseBurstSamples = 0;
    let coarseBurstSign = 0;
    let coarseBurstMagnitude = 0;
    let coarseBurstRegular = true;
    let burstStrongTrackpad = false;
    let wheelTimer: number | null = null;
    let closeTimer: number | null = null;
    let revealFrame = 0;
    let springFrame = 0;
    let rotationFrame = 0;
    let rawRotation = 0;
    let rotationTarget = 0;
    let rotationOffset = 0;
    let rotationResisted = true;
    let pointerRotationTarget: number | null = null;
    let session = 0;
    let observer: MutationObserver | null = null;
    let cancelOriginalLoad: (() => void) | null = null;
    let showingPreview = false;
    let demoFrame = 0;
    let demoTimer: number | null = null;
    let demoActive = false;
    let demoSession = 0;
    let demoStarted = false;
    let demoDismissing = false;
    let demoInteracted = false;
    const demoStorageKey = 'vcd:image-lightbox-demo-seen';

    const threshold = () => clamp(Math.min(viewer.clientWidth, viewer.clientHeight) * .22, 90, 150);
    const centre = (): Point => {
      const rect = viewer.getBoundingClientRect();
      return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
    };
    const clampPan = () => {
      const radians = view.rotation * Math.PI / 180;
      const width = (Math.abs(Math.cos(radians)) * image.offsetWidth + Math.abs(Math.sin(radians)) * image.offsetHeight) * view.scale;
      const height = (Math.abs(Math.sin(radians)) * image.offsetWidth + Math.abs(Math.cos(radians)) * image.offsetHeight) * view.scale;
      const baseScale = Math.max(view.scale, 1);
      const x = Math.max(0, width / baseScale * (baseScale - 1) / 2);
      const y = Math.max(0, height / baseScale * (baseScale - 1) / 2);
      view.x = clamp(view.x, -x, x);
      view.y = clamp(view.y, -y, y);
    };
    const progress = () => feedback === 'drag'
      ? Math.hypot(view.x, view.y) / threshold()
      : feedback === 'pinch' ? Math.max(0, (1 - view.scale) / .25) : 0;
    const render = () => {
      const amount = progress();
      armed = amount >= 1 && (demoDismissing || gesture === 'drag' || gesture === 'pinch' || nativeGesture || wheelPinch === true || wheelTrackpadActive);
      image.classList.toggle('is-armed', armed);
      const dismissScale = reducedMotion() ? 1 : 1 - .08 * clamp(amount, 0, 1);
      image.style.transform = `translate(${view.x}px, ${view.y}px) rotate(${view.rotation}deg) scale(${view.scale * dismissScale})`;
      image.style.opacity = String(armed ? .1 : 1 - .3 * clamp(amount, 0, 1));
    };
    const stopSpring = () => {
      cancelAnimationFrame(springFrame); springFrame = 0;
      cancelAnimationFrame(rotationFrame); rotationFrame = 0;
      image.classList.remove('is-settling');
    };
    const beginRotation = () => {
      rawRotation = view.rotation;
      rotationTarget = resistedRotation(rawRotation);
      rotationOffset = view.rotation - rotationTarget;
      rotationResisted = Math.abs(rawRotation - uprightRotation(rawRotation)) <= 20;
    };
    const updateRotation = (rotation: number) => {
      rawRotation = rotation;
      const resisted = Math.abs(rotation - uprightRotation(rotation)) <= 20;
      const target = resistedRotation(rotation);
      if (resisted !== rotationResisted) rotationOffset = view.rotation - target;
      rotationResisted = resisted;
      rotationTarget = target;
      view.rotation = target + rotationOffset;
      if (!rotationOffset || rotationFrame) return;
      let last = performance.now();
      const tick = (now: number) => {
        const dt = Math.max(0, now - last); last = now;
        const previous = view.rotation;
        rotationOffset *= Math.exp(-dt / 45);
        if (Math.abs(rotationOffset) < .01) rotationOffset = 0;
        view.rotation = rotationTarget + rotationOffset;
        velocity.rotation = dt ? (view.rotation - previous) / (dt / 1000) : 0;
        render();
        rotationFrame = rotationOffset ? requestAnimationFrame(tick) : 0;
      };
      rotationFrame = requestAnimationFrame(tick);
    };
    const clearWheel = () => {
      if (wheelTimer !== null) window.clearTimeout(wheelTimer);
      wheelTimer = null;
      wheelPinch = null;
      wheelInputMode = null;
      wheelStart = null;
      wheelTrackpadOffset = { x: 0, y: 0 };
      wheelTrackpadDismissEligible = false;
      wheelTrackpadActive = false;
    };
    const releasePointers = () => {
      const ids = [...pointers.keys()];
      pointers.clear();
      for (const id of ids) if (viewer.hasPointerCapture?.(id)) viewer.releasePointerCapture(id);
      viewer.classList.remove('is-dragging');
    };
    const reset = () => {
      stopSpring(); clearWheel(); releasePointers();
      view = fit(); gesture = null; feedback = null; nativeGesture = false; nativeZoomPoint = null; lastPointer = null; nativeUntil = 0; pointerRotationTarget = null;
      render();
    };
    const clearDemo = () => {
      if (demoFrame) cancelAnimationFrame(demoFrame);
      demoFrame = 0;
      if (demoTimer !== null) window.clearTimeout(demoTimer);
      demoTimer = null;
      demoActive = false; demoDismissing = false;
      demoOne.classList.remove('is-visible'); demoTwo.classList.remove('is-visible');
    };
    const interruptDemo = () => {
      demoInteracted = true;
      if (!demoActive && !demoFrame && demoTimer === null) return;
      clearDemo(); feedback = null; render();
    };
    const demoReady = () => dialog.open && dialog.classList.contains('is-visible') && closeTimer === null && image.complete && image.naturalWidth > 0;
    const startDemo = (openingSession: number) => {
      if (restoreKeyboardFocus || reducedMotion() || !demoReady() || demoStarted || demoActive || demoTimer !== null || demoInteracted || session !== openingSession) return;
      try { if (sessionStorage.getItem(demoStorageKey)) return; } catch {}
      demoActive = true; demoSession = openingSession;
      const touchDemo = matchMedia('(pointer: coarse)').matches;
      const dismissal = touchDemo ? 'swipe' : (['tap', 'pan', 'pinch'] as const)[Math.floor(Math.random() * 3)];
      const dismissalAngle = Math.random() * Math.PI * 2;
      let origin = 0;
      const setPointer = (node: HTMLElement, x: number, y: number, scale = .88) => {
        node.style.transform = `translate(${x - 22}px, ${y - 22}px) scale(${scale})`;
        node.classList.add('is-visible');
      };
      const tick = (now: number) => {
        if (!demoActive || demoSession !== session || !dialog.open || closeTimer !== null) { clearDemo(); return; }
        const elapsed = now - origin;
        if (dismissal === 'tap' && elapsed >= 3340) { view = fit(); feedback = null; render(); dismiss(); return; }
        const point = centre();
        const rect = viewer.getBoundingClientRect();
        const x = point.x - rect.left;
        const y = point.y - rect.top;
        const pan = { x: Math.min(80, image.offsetWidth * .65, Math.max(0, viewer.clientWidth / 2 - 114)), y: Math.min(40, image.offsetHeight * .65) };
        const zoomAnchor = { x: Math.min(8, viewer.clientWidth * .02), y: -Math.min(28, image.offsetHeight * .06) };
        const panAnchor = { x: -Math.min(24, viewer.clientWidth * .04), y: Math.min(28, image.offsetHeight * .05) };
        const outAnchor = { x: Math.min(20, viewer.clientWidth * .04), y: -Math.min(24, image.offsetHeight * .035) };
        const closeAnchor = { x: Math.min(36, viewer.clientWidth * .08), y: Math.min(48, image.offsetHeight * .1) };
        const tapY = Math.max(8, (viewer.clientHeight - image.offsetHeight) / 4);
        const closingAnchor = { x: closeAnchor.x, y: dismissal === 'tap' ? tapY - y : closeAnchor.y };
        const singleFinger = dismissal === 'tap' || dismissal === 'swipe';
        const leftOffset = dismissal === 'pinch' ? { x: -56, y: 26 } : { x: -36, y: 12 };
        const rightOffset = dismissal === 'pinch' ? { x: 56, y: -16 } : dismissal === 'pan' ? { x: 36, y: -8 } : { x: 0, y: 0 };
        const zoomBase = { x: zoomAnchor.x * (1 - 2.3), y: zoomAnchor.y * (1 - 2.3) };
        const panEnd = { x: clamp(zoomBase.x + pan.x, -image.offsetWidth * .65, image.offsetWidth * .65), y: clamp(zoomBase.y + pan.y, -image.offsetHeight * .65, image.offsetHeight * .65) };
        if (elapsed < 300) {
          const pressed = 1 - .12 * repositionEase(clamp((elapsed - 120) / 100, 0, 1));
          setPointer(demoOne, x + zoomAnchor.x - 56, y + zoomAnchor.y + 26, pressed); setPointer(demoTwo, x + zoomAnchor.x + 56, y + zoomAnchor.y - 16, pressed);
        } else if (elapsed < 1100) {
          const scale = 1 + gestureEase((elapsed - 300) / 800) * 1.3;
          setPointer(demoOne, x + zoomAnchor.x - 56 * scale, y + zoomAnchor.y + 26 * scale); setPointer(demoTwo, x + zoomAnchor.x + 56 * scale, y + zoomAnchor.y - 16 * scale);
          view = { x: zoomAnchor.x * (1 - scale), y: zoomAnchor.y * (1 - scale), scale, rotation: 0 }; clampPan(); render();
        } else if (elapsed < 1250) {
          const amount = repositionEase((elapsed - 1100) / 150);
          setPointer(demoTwo, x + zoomAnchor.x + (panAnchor.x - zoomAnchor.x) * amount + 128.8 - 72.8 * amount, y + zoomAnchor.y + (panAnchor.y - zoomAnchor.y) * amount - 36.8 + 28.8 * amount, 1);
          if (touchDemo) demoOne.classList.remove('is-visible');
          else setPointer(demoOne, x + zoomAnchor.x + (panAnchor.x - zoomAnchor.x) * amount - 128.8 + 72.8 * amount, y + zoomAnchor.y + (panAnchor.y - zoomAnchor.y) * amount + 59.8 - 47.8 * amount, 1);
          view = { x: zoomBase.x, y: zoomBase.y, scale: 2.3, rotation: 0 }; clampPan(); render();
        } else if (elapsed < 1900) {
          const amount = gestureEase((elapsed - 1250) / 650);
          setPointer(demoTwo, x + panAnchor.x + 56 + amount * pan.x, y + panAnchor.y - 8 + amount * pan.y);
          if (touchDemo) demoOne.classList.remove('is-visible');
          else setPointer(demoOne, x + panAnchor.x - 56 + amount * pan.x, y + panAnchor.y + 12 + amount * pan.y);
          view = { x: zoomBase.x + pan.x * amount, y: zoomBase.y + pan.y * amount, scale: 2.3, rotation: 0 };
          clampPan(); render();
        } else if (elapsed < 2050) {
          const amount = gestureEase((elapsed - 1900) / 150);
          const anchorX = panAnchor.x + (outAnchor.x - panAnchor.x) * amount;
          const anchorY = panAnchor.y + (outAnchor.y - panAnchor.y) * amount;
          setPointer(demoTwo, x + anchorX + 56 + (92 - 56) * amount + pan.x * (1 - amount), y + anchorY - 8 + (-101.2 + 8) * amount + pan.y * (1 - amount), 1);
          if (touchDemo) demoOne.classList.remove('is-visible');
          else setPointer(demoOne, x + anchorX - 56 + (-96.6 + 56) * amount + pan.x * (1 - amount), y + anchorY + 12 + (82.8 - 12) * amount + pan.y * (1 - amount), 1);
          view = { x: panEnd.x, y: panEnd.y, scale: 2.3, rotation: 0 }; clampPan(); render();
        } else if (elapsed < 2800) {
          const scale = 2.3 - gestureEase((elapsed - 2050) / 750) * 1.3;
          setPointer(demoOne, x + outAnchor.x - 42 * scale, y + outAnchor.y + 36 * scale);
          setPointer(demoTwo, x + outAnchor.x + 40 * scale, y + outAnchor.y - 44 * scale);
          const focal = { x: point.x + outAnchor.x, y: point.y + outAnchor.y };
          const translated = panForPinch(panEnd, focal, focal, 2.3, scale, point);
          view = { x: translated.x, y: translated.y, scale, rotation: 0 };
          clampPan(); render();
        } else if (elapsed < 3100) {
          const amount = (dismissal === 'pinch' ? repositionEase : gestureEase)((elapsed - 2800) / 300);
          if (singleFinger) demoOne.classList.remove('is-visible');
          else setPointer(demoOne, x + outAnchor.x - 42 + (closingAnchor.x + leftOffset.x - outAnchor.x + 42) * amount, y + outAnchor.y + 36 + (closingAnchor.y + leftOffset.y - outAnchor.y - 36) * amount, 1);
          setPointer(demoTwo, x + outAnchor.x + 40 + (closingAnchor.x + rightOffset.x - outAnchor.x - 40) * amount, y + outAnchor.y - 44 + (closingAnchor.y + rightOffset.y - outAnchor.y + 44) * amount, 1);
          view = fit(); render();
        } else if (elapsed < 3550) {
          if (dismissal === 'pinch') {
            const scale = 1 - gestureEase((elapsed - 3100) / 450) * .3;
            demoDismissing = true; feedback = 'pinch';
            setPointer(demoOne, x + closeAnchor.x - 56 * scale, y + closeAnchor.y + 26 * scale); setPointer(demoTwo, x + closeAnchor.x + 56 * scale, y + closeAnchor.y - 16 * scale);
            view = { x: closeAnchor.x * (1 - scale), y: closeAnchor.y * (1 - scale), scale, rotation: 0 }; render();
          } else if (dismissal === 'tap') {
            const scale = elapsed < 3220
              ? 1 - repositionEase(clamp((elapsed - 3100) / 100, 0, 1)) * .12
              : .88 + repositionEase(clamp((elapsed - 3220) / 100, 0, 1)) * .12;
            demoOne.classList.remove('is-visible'); setPointer(demoTwo, x + closingAnchor.x, y + closingAnchor.y, scale);
            view = fit(); feedback = null; render();
          } else {
            const progress = gestureEase((elapsed - 3100) / 450);
            const distance = threshold() * 1.2 * progress;
            const dx = Math.cos(dismissalAngle) * distance; const dy = Math.sin(dismissalAngle) * distance;
            demoDismissing = true; feedback = 'drag';
            if (singleFinger) demoOne.classList.remove('is-visible');
            else setPointer(demoOne, x + closingAnchor.x + leftOffset.x + dx, y + closingAnchor.y + leftOffset.y + dy);
            setPointer(demoTwo, x + closingAnchor.x + rightOffset.x + dx, y + closingAnchor.y + rightOffset.y + dy);
            view = { x: dx, y: dy, scale: 1, rotation: reducedMotion() ? 0 : clamp(dx / threshold() * 12, -12, 12) }; render();
          }
        } else if (elapsed < 3750) {
          demoOne.classList.remove('is-visible'); demoTwo.classList.remove('is-visible');
        } else {
          dismiss(); return;
        }
        demoFrame = requestAnimationFrame(tick);
      };
      demoTimer = window.setTimeout(() => {
        demoTimer = null;
        if (!demoActive || demoSession !== session || !demoReady()) { clearDemo(); return; }
        try { if (sessionStorage.getItem(demoStorageKey)) { clearDemo(); return; } } catch {}
        demoStarted = true;
        try { sessionStorage.setItem(demoStorageKey, '1'); } catch {}
        origin = performance.now();
        demoFrame = requestAnimationFrame(tick);
      }, 250);
    };
    const springHome = (target: View = { ...fit(), rotation: uprightRotation(view.rotation) }) => {
      stopSpring();
      if (reducedMotion()) { image.classList.add('is-settling'); view = target; feedback = null; render(); return; }
      let last = performance.now();
      const started = last;
      const keys = ['x', 'y', 'scale', 'rotation'] as const;
      const tick = (now: number) => {
        let remaining = Math.min((now - last) / 1000, .032);
        last = now;
        while (remaining > 0) {
          const dt = Math.min(remaining, .008);
          for (const key of keys) {
            velocity[key] += (-450 * (view[key] - target[key]) - 32 * velocity[key]) * dt;
            view[key] += velocity[key] * dt;
          }
          remaining -= dt;
        }
        render();
        const settled = keys.every(key => Math.abs(view[key] - target[key]) < .001 && Math.abs(velocity[key]) < .01);
        if (settled || now - started > 1200) {
          view = target; feedback = null; springFrame = 0; render();
        } else springFrame = requestAnimationFrame(tick);
      };
      springFrame = requestAnimationFrame(tick);
    };
    const finishDismiss = () => {
      if (closeTimer !== null) window.clearTimeout(closeTimer);
      closeTimer = null;
      observer?.disconnect();
      clearDemo();
      cancelOriginalLoad?.();
      showingPreview = false;
      if (dialog.open) dialog.close();
      image.removeAttribute('src'); image.alt = ''; image.style.backgroundColor = '';
      image.style.removeProperty('transition');
      error.hidden = true;
      error.textContent = 'Image could not be loaded.';
      reset();
      const target = opener; opener = null;
      if (target?.isConnected) {
        target.focus({ preventScroll: true });
        // Pointer dismissal must not leave a clipped focus outline on a carousel image.
        if (!restoreKeyboardFocus) target.blur();
      }
    };
    const dismiss = (immediate = false) => {
      if (!dialog.open) return;
      const closingSession = ++session;
      cancelAnimationFrame(revealFrame); revealFrame = 0;
      clearDemo(); cancelOriginalLoad?.();
      stopSpring(); clearWheel(); releasePointers(); nativeGesture = false;
      dialog.classList.remove('is-visible');
      image.style.transition = 'opacity 150ms ease'; image.style.opacity = '0';
      if (closeTimer !== null) window.clearTimeout(closeTimer);
      if (immediate) { finishDismiss(); return; }
      closeTimer = window.setTimeout(() => { if (session === closingSession) finishDismiss(); }, 150);
    };
    const open = (target: HTMLImageElement, keyboard = false) => {
      if (!target.dataset.imageOriginal || document.documentElement.classList.contains('is-dev-mode') || !dialog.isConnected || typeof dialog.showModal !== 'function') return;
      if (closeTimer !== null) window.clearTimeout(closeTimer);
      closeTimer = null;
      const openingSession = ++session;
      cancelAnimationFrame(revealFrame);
      cancelOriginalLoad?.();
      reset(); moved = false; nativeUntil = 0;
      clearDemo(); demoStarted = false; demoInteracted = false;
      opener = target;
      restoreKeyboardFocus = keyboard;
      image.style.removeProperty('transition');
      image.style.backgroundColor = getComputedStyle(target).getPropertyValue('--project-image-background').trim() || 'transparent';
      image.alt = target.alt;
      const source = target.dataset.imageOriginal;
      const loadedPreview = target.complete && target.naturalWidth > 0 ? (target.currentSrc || target.src) : '';
      const sameSource = loadedPreview && new URL(loadedPreview, document.baseURI).href === new URL(source, document.baseURI).href;
      const aspect = target.naturalWidth > 0 && target.naturalHeight > 0 ? target.naturalWidth / target.naturalHeight : 0;
      if (aspect) image.style.setProperty('--image-aspect', String(aspect));
      else image.style.removeProperty('--image-aspect');
      showingPreview = Boolean(loadedPreview && !sameSource);
      image.src = loadedPreview || source;
      error.hidden = true; error.textContent = 'Image could not be loaded.';
      if (loadedPreview && !sameSource) {
        const loader = document.createElement('img');
        let cancelled = false;
        const current = () => !cancelled && session === openingSession && dialog.open && closeTimer === null;
        const cleanup = () => {
          cancelled = true;
          loader.removeEventListener('load', loaded);
          loader.removeEventListener('error', failed);
          loader.removeAttribute('src');
          if (cancelOriginalLoad === cleanup) cancelOriginalLoad = null;
        };
        const failed = () => {
          if (current()) { error.textContent = 'Full-resolution image could not be loaded.'; error.hidden = false; }
          cleanup();
        };
        const loaded = async () => {
          if (!current()) return;
          try { if (typeof loader.decode === 'function') await loader.decode(); }
          catch { failed(); return; }
          if (!current()) return;
          if (!loader.naturalWidth || !loader.naturalHeight) { failed(); return; }
          showingPreview = false; error.hidden = true;
          image.src = source;
          cleanup();
        };
        cancelOriginalLoad = cleanup;
        loader.addEventListener('load', loaded, { once: true });
        loader.addEventListener('error', failed, { once: true });
        loader.src = source;
      }
      viewer.removeAttribute('data-keyboard-focus');
      if (!dialog.open) dialog.showModal();
      observer?.disconnect();
      observer = new MutationObserver(() => { if (opener && !opener.isConnected) dismiss(); });
      observer.observe(document.body, { childList: true, subtree: true });
      revealFrame = requestAnimationFrame(() => {
        revealFrame = requestAnimationFrame(() => { if (session === openingSession && dialog.open) { dialog.classList.add('is-visible'); if (!keyboard) startDemo(openingSession); } });
      });
      viewer.focus({ preventScroll: true });
    };
    const eligibleImage = (event: Event): HTMLImageElement | null => {
