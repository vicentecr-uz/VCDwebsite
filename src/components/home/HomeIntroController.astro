---
import ProjectSections from '../project/ProjectSections.astro';
import { ADAPTIVE_PAGE_COLUMNS_ENABLED, pageColumnStyle } from '../../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../../lib/projectStack';
import type { PageDocument } from '../../lib/projects';
import revealConfig from '../../lib/homeRevealConfig.json';
import { renderHomeIntroAction } from '../../lib/homeIntroAction';

interface Props {
  page: PageDocument;
}

const { page } = Astro.props;
const sections = page.sections.map((section) => section.type === 'bodyText'
  ? { ...section, paragraphs: (section.paragraphs as string[]).map(renderHomeIntroAction) }
  : section);
const columnStyle = ADAPTIVE_PAGE_COLUMNS_ENABLED ? pageColumnStyle(page.sections) : undefined;
const introTranslateY = (revealConfig.intro as typeof revealConfig.intro & { translateYPx?: number }).translateYPx ?? 0;
---

<section
  id="home-intro-surface"
  data-home-intro-surface
  data-page-viewport
  data-state="pending"
  data-reduced-motion-preview="false"
  aria-label="Introduction"
  style={`${columnStyle ?? ''};--home-intro-exit-duration:${revealConfig.intro.durationMs}ms;--home-intro-exit-blur:${revealConfig.intro.blurPx}px;--home-intro-exit-scale:${revealConfig.intro.scale};--home-intro-exit-y:-${introTranslateY}px`}
>
  <div class="home-intro-surface__column">
    <div class="listing-main">
      <div data-dev-project-drop-zone data-page-document="home-intro">
        <ProjectSections documentKey="home-intro" sections={sections} introHeight={page.introHeight} />
        <div
          class:list={[projectStackClass(page.trailingSpacing ?? 'none')]}
          {...(spacingDevAttrs('home-intro', ['sections', page.sections.length], page.trailingSpacing ?? 'none', { writePath: ['trailingSpacing'] }) ?? {})}
          data-home-intro-sentinel
        />
      </div>
    </div>
  </div>
  <span data-home-intro-cursor aria-hidden="true">Enter</span>
</section>

<script is:inline data-astro-rerun>
  try {
    if (sessionStorage.getItem('vcd:home-intro-seen') === 'true') {
      const surface = document.getElementById('home-intro-surface');
      if (surface) {
        surface.dataset.state = 'dismissed';
        surface.hidden = true;
        surface.inert = true;
      }
    }
  } catch {}
</script>

<script>
  import { bindHomeIntro } from '../../scripts/homeIntro';
  import { onPageLoad } from '../../lib/pageLifecycle';
  const dispose = onPageLoad(() => bindHomeIntro()?.teardown);
  import.meta.hot?.dispose(dispose);
</script>

<style>
  #home-intro-surface {
    position: fixed;
    inset: 0;
    z-index: 55;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--sys-color-srf);
    color: var(--sys-color-on-srf);
    isolation: isolate;
    opacity: 1;
  }

  #home-intro-surface[data-state='dismissing'] .home-intro-surface__column {
    opacity: 0;
    filter: blur(var(--home-intro-exit-blur));
    transform: translateY(var(--home-intro-exit-y)) scale(var(--home-intro-exit-scale));
    transition: opacity var(--home-intro-exit-duration) ease, filter var(--home-intro-exit-duration) ease, transform var(--home-intro-exit-duration) ease;
    pointer-events: none;
  }

  #home-intro-surface[data-state='dismissed'] {
    display: none;
  }

  .home-intro-surface__column {
    min-height: 100%;
    padding-inline: var(--page-gutter);
  }

  #home-intro-surface :global([data-home-intro-okay]) {
    position: relative;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 10%, transparent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
    transition: text-decoration-color 150ms ease;
  }

  #home-intro-surface :global(button[data-home-intro-okay])::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  #home-intro-surface :global([data-home-intro-cursor]) {
    position: fixed;
    top: 0;
    left: 0;
    display: none;
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 2;
    font: inherit;
    font-size: var(--text-body-size);
    font-weight: var(--text-body-weight);
    line-height: var(--text-body-leading);
    letter-spacing: var(--text-body-tracking);
    white-space: nowrap;
  }

  #home-intro-surface[data-home-intro-cursor-active='true'] {
    cursor: none;
  }

  #home-intro-surface[data-home-intro-cursor-active='true'] :global(a),
  #home-intro-surface[data-home-intro-cursor-active='true'] :global(button),
  #home-intro-surface[data-home-intro-cursor-active='true'] :global(input),
  #home-intro-surface[data-home-intro-cursor-active='true'] :global(textarea),
  #home-intro-surface[data-home-intro-cursor-active='true'] :global(select),
  #home-intro-surface[data-home-intro-cursor-active='true'] :global([contenteditable='true']) {
    cursor: auto;
  }

  #home-intro-surface[data-home-intro-pointer='mouse'] :global(button[data-home-intro-okay]) {
    opacity: 0;
    pointer-events: none;
  }

  #home-intro-surface :global(button[data-home-intro-okay]):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    opacity: 1;
    pointer-events: auto;
  }

  #home-intro-surface[data-state='editing'] :global([data-home-intro-okay]) {
    cursor: text;
  }

  @media (hover: hover) and (pointer: fine) {
    #home-intro-surface :global(button[data-home-intro-okay]):hover {
      text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #home-intro-surface[data-state='dismissing'] .home-intro-surface__column {
      filter: none;
      transform: none;
    }
  }

  #home-intro-surface[data-reduced-motion-preview='true'][data-state='dismissing'] .home-intro-surface__column {
    filter: none;
    transform: none;
  }
</style>
