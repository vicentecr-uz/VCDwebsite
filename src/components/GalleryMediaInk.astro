<script>
  import { bindCaptionMediaInk } from '../scripts/bindCaptionMediaInk';
  import { bindGalleryHoverFill } from '../scripts/clampGalleryHoverFill';
  import { bindGalleryMediaInk } from '../scripts/bindGalleryMediaInk';
  import { bindMobileGalleryReveal } from '../scripts/mobileGalleryReveal';

  let teardownGallery: (() => void) | undefined;
  let teardownHoverFill: (() => void) | undefined;
  let teardownCaptions: (() => void) | undefined;
  let teardownMobileReveal: (() => void) | undefined;

  function mount() {
    teardownGallery?.();
    teardownHoverFill?.();
    teardownCaptions?.();
    teardownMobileReveal?.();
    teardownGallery = bindGalleryMediaInk();
    teardownHoverFill = bindGalleryHoverFill();
    teardownCaptions = bindCaptionMediaInk();
    teardownMobileReveal = bindMobileGalleryReveal();
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    teardownGallery?.();
    teardownHoverFill?.();
    teardownCaptions?.();
    teardownMobileReveal?.();
    teardownGallery = undefined;
    teardownHoverFill = undefined;
    teardownCaptions = undefined;
    teardownMobileReveal = undefined;
  });
</script>
