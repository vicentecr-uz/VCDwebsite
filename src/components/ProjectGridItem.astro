---
import cropIcon from 'lucide-static/icons/crop.svg?raw';
import columns2Icon from 'lucide-static/icons/columns-2.svg?raw';
import eyeOffIcon from 'lucide-static/icons/eye-off.svg?raw';
import filePenIcon from 'lucide-static/icons/file-pen.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import imageIcon from 'lucide-static/icons/image.svg?raw';
import imagesIcon from 'lucide-static/icons/images.svg?raw';
import squareArrowRightEnterIcon from 'lucide-static/icons/square-arrow-right-enter.svg?raw';
import type { ProjectStatus } from '../lib/projects';
import { projectImage, projectImageTier } from '../lib/images';
import { isPlaceholderCoverSrc } from '../lib/placeholderCover.mjs';
import { sizeIcon } from '../lib/icons';
import {
  hoverCropStyle,
  normalizeImageVariants,
  responsiveImageStyle,
} from '../lib/responsiveImage';
import {
  hasCropVariants,
  imageSourceDims,
  listingCoverDefaultAspects,
  listingCoverDevEditAttrs,
  joinMediaStyles,
} from '../lib/projectImageFrame';
import type { ProjectGridItem } from './ProjectGrid.astro';

interface Props {
  item: ProjectGridItem;
  variant: 'home' | 'work' | 'play';
}

const { item, variant } = Astro.props;
const isDev = import.meta.env.DEV;

const cropIconSvg = sizeIcon(cropIcon, 14);
const spanIconSvg = sizeIcon(columns2Icon, 14);
const hoverIconSvg = sizeIcon(imagesIcon, 14);
/** Open page — Lucide `square-arrow-right-enter`. */
const openPageIconSvg = sizeIcon(squareArrowRightEnterIcon, 14);
const statusIcons = {
  published: sizeIcon(globeIcon, 14),
  draft: sizeIcon(filePenIcon, 14),
  teaser: sizeIcon(eyeOffIcon, 14),
  image: sizeIcon(imageIcon, 14),
} as const;

const isPlayPlaceholder = variant === 'play' && !item.href && !item.teaser;
const status = (item.status ?? 'published') as ProjectStatus;
const isTeaser = Boolean(item.teaser);
const isImage = status === 'image';
const showOpenPageChip = status === 'draft' || status === 'teaser';
const isStatic = isPlayPlaceholder || isImage || (isTeaser && !isDev);
const statusIconSvg = statusIcons[status as keyof typeof statusIcons] ?? statusIcons.published;
const defaultAspects = listingCoverDefaultAspects(variant, Boolean(item.full));
const srcDims = imageSourceDims(item);
const hasCoverCrop = hasCropVariants(item.variants);
const hasHoverCrop = hasCropVariants(item.hoverVariants);
const hasCrop = hasCoverCrop || hasHoverCrop;
const normalizedCover = hasCoverCrop || hasCrop
  ? normalizeImageVariants(item.variants, defaultAspects, srcDims)
  : undefined;
const normalizedHover = hasHoverCrop && item.hoverVariants
  ? normalizeImageVariants(item.hoverVariants, defaultAspects, null)
  : undefined;
const coverStyle = joinMediaStyles(
  normalizedCover ? responsiveImageStyle(normalizedCover, srcDims) : undefined,
  normalizedHover ? hoverCropStyle(normalizedHover) : undefined,
  item.bg ? `--project-grid-background:${item.bg};background-color:${item.bg}` : undefined,
);
const projectEditable = isDev && Boolean(item.slug);
const isPlaceholderCover = isPlaceholderCoverSrc(item.image);
const projectEditAttrs = projectEditable
  ? listingCoverDevEditAttrs(item.slug!, variant, item, Boolean(item.full))
  : undefined;
const editAttrs = projectEditAttrs;

const hoverDark = item.hoverDark ?? item.dark;

const showHoverImg = item.hoverImage || projectEditable;
---

<li
  class:list={['project-grid__item', item.full && 'project-grid__item--full']}
  data-dev-project-slug={item.slug}
  data-dev-status={status}
  data-dev-bg={item.bg}
  data-dev-dark={item.dark ? 'true' : 'false'}
  data-dev-hover-dark={item.hoverImage ? (hoverDark ? 'true' : 'false') : undefined}
  data-dev-hover-image={item.hoverImage || undefined}
  data-mobile-inset={item.mobileInset === true ? 'true' : 'false'}
  data-mobile-bleed-eligible="true"
>
  {isStatic ? (
    <div
      class:list={[
        'project-grid__card',
        'block',
        isPlayPlaceholder && 'project-grid__card--placeholder',
        isTeaser && 'project-grid__card--teaser',
      ]}
      aria-disabled="true"
      data-dev-teaser-slug={isTeaser ? item.slug : undefined}
      data-dev-teaser-href={isTeaser ? item.href ?? `/${item.slug}` : undefined}
    >
      <div
        class:list={[
          'project-grid__cover',
          'relative',
          !hasCrop && 'overflow-hidden',
          item.hoverImage && 'project-grid__cover--has-hover',
          hasHoverCrop && 'project-grid__cover--hover-cropped',
          hasCrop && 'project-cropped project-responsive-image',
          (projectEditable) && 'dev-image-edit-target',
        ]}
        style={coverStyle}
        data-dev-cover-drop={projectEditable ? item.slug : undefined}
        data-dev-listing-cover={projectEditable ? variant : undefined}
        data-dev-cover-empty={isPlaceholderCover ? 'true' : undefined}
        {...(editAttrs ?? {})}
      >
        <div class="project-grid__stack">
          {hasCrop ? (
            <div class="project-crop-clip">
              {isPlaceholderCover ? (
              <img
                alt={item.title}
                class="project-grid__img project-grid__img--base"
                hidden
              />
              ) : (
              <img
                src={projectImageTier(item.image, 'thumb')}
                data-image-preview={projectImageTier(item.image, 'preview')}
                alt={item.title}
                class="project-grid__img project-grid__img--base"
                loading="eager"
              />
              )}
              {showHoverImg && (
                <div class="project-grid__hover-layer" aria-hidden="true">
                <img
                  src={item.hoverImage ? projectImageTier(item.hoverImage, 'thumb') : undefined}
                  data-image-preview={item.hoverImage ? projectImageTier(item.hoverImage, 'preview') : undefined}
                  alt=""
                  class="project-grid__img project-grid__img--hover"
                  loading="eager"
                  hidden={!item.hoverImage}
                  aria-hidden="true"
                />
                </div>
              )}
            </div>
          ) : (
            <>
              {isPlaceholderCover ? (
              <img
                alt={item.title}
                class="project-grid__img project-grid__img--base w-full h-full object-cover"
                hidden
              />
              ) : (
              <img
                src={projectImageTier(item.image, 'thumb')}
                data-image-preview={projectImageTier(item.image, 'preview')}
                alt={item.title}
                class="project-grid__img project-grid__img--base w-full h-full object-cover"
                loading="eager"
              />
              )}
              {showHoverImg && (
                <div class="project-grid__hover-layer" aria-hidden="true">
                <img
                  src={item.hoverImage ? projectImageTier(item.hoverImage, 'thumb') : undefined}
                  data-image-preview={item.hoverImage ? projectImageTier(item.hoverImage, 'preview') : undefined}
                  alt=""
                  class="project-grid__img project-grid__img--hover w-full h-full object-cover"
                  loading="eager"
                  hidden={!item.hoverImage}
                  aria-hidden="true"
                />
                </div>
              )}
            </>
          )}
        </div>
        {isDev && item.slug && (
          <div class="project-grid__drop-veil" data-dev-drop-veil="active" aria-hidden="true">
            <span class="project-grid__drop-label" data-dev-drop-label>Replace cover image</span>
          </div>
        )}
        {projectEditable && (
          <div class="project-grid__drop-veil project-grid__drop-veil--hover-empty" aria-hidden="true">
            <span class="project-grid__drop-label">Drop hover image</span>
          </div>
        )}
        {isPlaceholderCover && projectEditable && (
          <div class="project-grid__drop-veil project-grid__drop-veil--cover-empty" aria-hidden="true">
            <span class="project-grid__drop-label">Drop cover image</span>
          </div>
        )}
        <div class="project-grid__meta absolute bottom-0 left-0 right-0">
          <div class="flex items-baseline gap-2">
            <h2
              class="project-grid__title font-bold"
              data-dev-project-title
              data-placeholder="Title"
            >{item.title}</h2>
            {(item.subtitle || isDev) && (
              <span
                class="project-grid__subtitle"
                data-dev-project-subtitle
                data-placeholder={variant === 'play' ? 'Meta' : 'Year'}
              >{item.subtitle ?? ''}</span>
            )}
            {isTeaser && variant !== 'play' && (
              <span
                class="project-grid__teaser-label font-bold"
                data-dev-project-teaser-label
                data-placeholder="Teaser label"
              >{item.teaserLabel ?? 'Coming soon'}</span>
            )}
          </div>
        </div>
      </div>
    </div>
  ) : (
    <a href={item.href} class="project-grid__card block">
      <div
        class:list={[
          'project-grid__cover',
          'relative',
          !hasCrop && 'overflow-hidden',
          item.hoverImage && 'project-grid__cover--has-hover',
          hasHoverCrop && 'project-grid__cover--hover-cropped',
          hasCrop && 'project-cropped project-responsive-image',
          (projectEditable) && 'dev-image-edit-target',
        ]}
        style={coverStyle}
        data-dev-cover-drop={projectEditable ? item.slug : undefined}
        data-dev-listing-cover={projectEditable ? variant : undefined}
        data-dev-cover-empty={isPlaceholderCover ? 'true' : undefined}
        {...(editAttrs ?? {})}
      >
        <div class="project-grid__stack">
          {hasCrop ? (
            <div class="project-crop-clip">
              {isPlaceholderCover ? (
              <img
                alt={item.title}
                class="project-grid__img project-grid__img--base"
                hidden
              />
              ) : (
              <img
                src={projectImageTier(item.image, 'thumb')}
                data-image-preview={projectImageTier(item.image, 'preview')}
                alt={item.title}
                class="project-grid__img project-grid__img--base"
                loading="eager"
              />
              )}
              {showHoverImg && (
                <div class="project-grid__hover-layer" aria-hidden="true">
                <img
                  src={item.hoverImage ? projectImageTier(item.hoverImage, 'thumb') : undefined}
                  data-image-preview={item.hoverImage ? projectImageTier(item.hoverImage, 'preview') : undefined}
                  alt=""
                  class="project-grid__img project-grid__img--hover"
                  loading="eager"
                  hidden={!item.hoverImage}
                  aria-hidden="true"
                />
                </div>
              )}
            </div>
          ) : (
            <>
              {isPlaceholderCover ? (
              <img
                alt={item.title}
                class="project-grid__img project-grid__img--base w-full h-full object-cover"
                hidden
              />
              ) : (
              <img
                src={projectImageTier(item.image, 'thumb')}
                data-image-preview={projectImageTier(item.image, 'preview')}
                alt={item.title}
                class="project-grid__img project-grid__img--base w-full h-full object-cover"
                loading="eager"
              />
              )}
              {showHoverImg && (
                <div class="project-grid__hover-layer" aria-hidden="true">
                <img
                  src={item.hoverImage ? projectImageTier(item.hoverImage, 'thumb') : undefined}
                  data-image-preview={item.hoverImage ? projectImageTier(item.hoverImage, 'preview') : undefined}
                  alt=""
                  class="project-grid__img project-grid__img--hover w-full h-full object-cover"
                  loading="eager"
                  hidden={!item.hoverImage}
                  aria-hidden="true"
                />
                </div>
              )}
            </>
          )}
        </div>
        {isDev && item.slug && (
          <div class="project-grid__drop-veil" data-dev-drop-veil="active" aria-hidden="true">
            <span class="project-grid__drop-label" data-dev-drop-label>Replace cover image</span>
          </div>
        )}
        {projectEditable && (
          <div class="project-grid__drop-veil project-grid__drop-veil--hover-empty" aria-hidden="true">
            <span class="project-grid__drop-label">Drop hover image</span>
          </div>
        )}
        {isPlaceholderCover && projectEditable && (
          <div class="project-grid__drop-veil project-grid__drop-veil--cover-empty" aria-hidden="true">
            <span class="project-grid__drop-label">Drop cover image</span>
          </div>
        )}
        <div class="project-grid__meta absolute bottom-0 left-0 right-0">
          <div class="flex items-baseline gap-2">
            <h2
              class="project-grid__title font-bold"
              data-dev-project-title
              data-placeholder="Title"
            >{item.title}</h2>
            {(item.subtitle || isDev) && (
              <span
                class="project-grid__subtitle"
                data-dev-project-subtitle
                data-placeholder={variant === 'play' ? 'Meta' : 'Year'}
              >{item.subtitle ?? ''}</span>
            )}
            {isTeaser && variant !== 'play' && (
              <span
                class="project-grid__teaser-label font-bold"
                data-dev-project-teaser-label
                data-placeholder="Teaser label"
              >{item.teaserLabel ?? 'Coming soon'}</span>
            )}
          </div>
        </div>
      </div>
    </a>
  )}
  {projectEditable && (
    <div class="project-grid__chips project-grid__chips--start" data-dev-mode-only>
      <div class="project-grid__status-wrap">
        <button
          type="button"
          class="project-grid__chip"
          data-dev-project-status={item.slug}
          aria-label={`Visibility: ${status}`}
          aria-haspopup="listbox"
          aria-expanded="false"
          title={`Visibility: ${status}`}
        >
          <span class="project-grid__chip-icon" aria-hidden="true" set:html={statusIconSvg} />
        </button>
        <div class="project-grid__status-menu" data-dev-status-menu hidden role="listbox">
          <button type="button" role="option" data-dev-status-option="published" aria-selected={status === 'published'}>
            Public
          </button>
          <button type="button" role="option" data-dev-status-option="image" aria-selected={status === 'image'}>
            Image
          </button>
          <button type="button" role="option" data-dev-status-option="teaser" aria-selected={status === 'teaser'}>
            Teaser
          </button>
          <button type="button" role="option" data-dev-status-option="draft" aria-selected={status === 'draft'}>
            Draft
          </button>
        </div>
      </div>
      {showOpenPageChip && item.slug && (
        <a
          class="project-grid__chip"
          href={`/${item.slug}`}
          data-dev-project-open={item.slug}
          aria-label={`Open ${item.title || item.slug}`}
          title="Open page"
        >
          <span class="project-grid__chip-icon" aria-hidden="true" set:html={openPageIconSvg} />
        </a>
      )}
    </div>
  )}
  {projectEditable && (
    <div class="project-grid__chips project-grid__chips--end" data-dev-mode-only>
      <button
        type="button"
        class="project-grid__chip"
        data-dev-edit-trigger="image"
        aria-label={`Crop cover for ${item.title}`}
        title="Crop cover"
      >
        <span class="project-grid__chip-icon" aria-hidden="true" set:html={cropIconSvg} />
      </button>
      <button
        type="button"
        class="project-grid__chip"
        data-dev-project-hover={item.slug}
        data-dev-hover-chip-for={item.title}
        aria-label={`${item.title}: showing cover image — switch to hover image`}
        aria-pressed="false"
        title="Showing cover image — switch to hover image"
      >
        <span class="project-grid__chip-icon" aria-hidden="true" set:html={hoverIconSvg} />
      </button>
      <button
        type="button"
        class="project-grid__chip"
        data-dev-project-span={item.slug}
        aria-label={`Span columns for ${item.title}`}
        aria-pressed="false"
        title="Span columns"
      >
        <span class="project-grid__chip-icon" aria-hidden="true" set:html={spanIconSvg} />
      </button>
    </div>
  )}
  {projectEditable && (
    <div class="project-grid__chips project-grid__chips--end-bottom" data-dev-mode-only>
      <button
        type="button"
        class="project-grid__chip"
        data-dev-project-settings={item.slug}
        aria-label={`Edit card for ${item.title}`}
        aria-haspopup="dialog"
        title="Edit card"
      >
        Edit card
      </button>
    </div>
  )}
</li>
