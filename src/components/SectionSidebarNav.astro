---
type SectionLink = {
  id: string;
  label: string;
};

type SectionGroup = {
  label: string;
  children: SectionLink[];
  defaultOpen?: boolean;
};

interface Props {
  sectionLinks: Array<SectionLink | SectionGroup>;
  sectionSelector?: string;
  ariaLabel?: string;
  earlyRampVh?: number;
  holdVh?: number;
  endRampVh?: number;
  clickOffsetPx?: number;
  clickLockMs?: number;
  enableEasingDevPanel?: boolean;
  defaultEasingPreset?: string;
  /** Hide below the fixed-sidebar breakpoint (project case studies). */
  desktopOnly?: boolean;
}

const {
  sectionLinks,
  sectionSelector = '.section-block[id]',
  ariaLabel = 'Page sections',
  earlyRampVh = 0.3,
  holdVh = 0.25,
  endRampVh = 0.25,
  clickOffsetPx = 152,
  clickLockMs = 700,
  enableEasingDevPanel = false,
  defaultEasingPreset = 'customBezier',
  desktopOnly = false,
} = Astro.props;

const navId = `section-sidebar-nav-${Math.random().toString(36).slice(2, 10)}`;
const easingOptions = [
  { key: 'nativeSmooth', label: 'Browser native smooth' },
  { key: 'appleOut', label: 'Apple easeOut' },
  { key: 'appleInOut', label: 'Apple easeInOut' },
  { key: 'easeOutCubic', label: 'Ease Out Cubic' },
  { key: 'easeOutQuint', label: 'Ease Out Quint' },
  { key: 'easeInOutSoft', label: 'Soft In/Out' },
  { key: 'standardWeb', label: 'CSS ease' },
  { key: 'customBezier', label: 'Custom (Bezier editor)' },
];
---

<aside
  class:list={['section-sidebar-nav', desktopOnly && 'section-sidebar-nav--desktop-only']}
  data-nav-id={navId}
  aria-label={ariaLabel}
  data-section-selector={sectionSelector}
  data-early-ramp-vh={earlyRampVh}
  data-hold-vh={holdVh}
  data-end-ramp-vh={endRampVh}
  data-click-offset-px={clickOffsetPx}
  data-click-lock-ms={clickLockMs}
  data-default-easing={defaultEasingPreset}
>
  <ul class="section-sidebar-nav__list">
    {sectionLinks.map((item) => (
      'children' in item ? (
        <li class="section-sidebar-nav__group-item">
          <details class="section-sidebar-nav__group" open={item.defaultOpen}>
            <summary class="section-sidebar-nav__summary">
              <svg viewBox="0 0 8 12" aria-hidden="true">
                <path d="M1.5 1.5 6 6l-4.5 4.5"></path>
              </svg>
              <span>{item.label}</span>
            </summary>
            <div class="section-sidebar-nav__group-content">
              <ul class="section-sidebar-nav__children">
                {item.children.map((link) => (
                  <li>
                    <a href={`#${link.id}`} class="section-sidebar-nav__link">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </li>
      ) : (
        <li>
          <a href={`#${item.id}`} class="section-sidebar-nav__link section-sidebar-nav__root-link">
            {item.label}
          </a>
        </li>
      )
    ))}
  </ul>
</aside>

{
  enableEasingDevPanel && (
    <div class="section-sidebar-nav-devpanel" data-panel-for={navId}>
      <p class="section-sidebar-nav-devpanel__title">Scroll easing playground</p>
      <div class="section-sidebar-nav-devpanel__grid">
        {easingOptions.map((option) => (
          <button type="button" class="section-sidebar-nav-devpanel__btn" data-easing-key={option.key}>
            {option.label}
          </button>
        ))}
      </div>
      <div class="section-sidebar-nav-devpanel__sliders">
        <p class="section-sidebar-nav-devpanel__subhead">Custom cubic-bezier</p>
        <div class="section-sidebar-nav-devpanel__bezier-editor" data-bezier-editor>
          <svg
            class="section-sidebar-nav-devpanel__bezier-graph"
            data-bezier-graph
            viewBox="0 0 100 100"
            role="img"
            aria-label="Bezier curve editor"
          >
            <rect x="0" y="0" width="100" height="100" class="section-sidebar-nav-devpanel__bezier-bg"></rect>
            <polyline
              points="0,100 14,100 23,100 20,0 41,0 100,0"
              class="section-sidebar-nav-devpanel__bezier-guides"
              data-bezier-guides
            ></polyline>
            <path
              d="M 0 100 L 100 0"
              class="section-sidebar-nav-devpanel__bezier-path"
              data-bezier-path
            ></path>
            <circle cx="12" cy="65" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p1"></circle>
            <circle cx="28" cy="35" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p2"></circle>
            <circle cx="55" cy="12" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p3"></circle>
            <circle cx="82" cy="0" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p4"></circle>
            <circle cx="0" cy="100" r="2.1" class="section-sidebar-nav-devpanel__bezier-endpoint"></circle>
            <circle cx="100" cy="0" r="2.1" class="section-sidebar-nav-devpanel__bezier-endpoint"></circle>
          </svg>
          <p class="section-sidebar-nav-devpanel__bezier-helper">Drag the four control points (degree 5).</p>
        </div>
        <p class="section-sidebar-nav-devpanel__curve-readout" data-curve-readout>
          bezier5((0.14, 0.00), (0.23, 0.00), (0.20, 1.00), (0.41, 1.00))
        </p>
      </div>
      <p class="section-sidebar-nav-devpanel__hint">Pick a curve, then click section links to test.</p>
    </div>
  )
}

<script>
  const parseNumber = (value, fallback) => {
    const n = Number(value);
    return Number.isFinite(n) ? n : fallback;
  };

  const initSectionSidebarNav = (nav) => {
    if (!(nav instanceof HTMLElement) || nav.dataset.initialized === 'true') return;
    nav.dataset.initialized = 'true';

    const sectionSelector = nav.dataset.sectionSelector || '.section-block[id]';
    const earlyRampVh = parseNumber(nav.dataset.earlyRampVh, 0.3);
    const holdVh = parseNumber(nav.dataset.holdVh, 0.25);
    const endRampVh = parseNumber(nav.dataset.endRampVh, 0.25);
    const clickOffsetPx = parseNumber(nav.dataset.clickOffsetPx, 152);
    const clickLockMs = parseNumber(nav.dataset.clickLockMs, 700);

    const sections = Array.from(document.querySelectorAll(sectionSelector));
    const navLinks = Array.from(nav.querySelectorAll('.section-sidebar-nav__link'));
    const navGroups = Array.from(nav.querySelectorAll('.section-sidebar-nav__group'));
    let manualLockUntil = 0;
    let scrollRafId = 0;
    let isAutoScrolling = false;
    /** Groups the user expanded via the header — stay open until they close them. */
    const pinnedOpenGroups = new WeakSet();
    const storageKey = 'sectionSidebarNavEasingPreset_v2';
    const customCurveStorageKey = 'sectionSidebarNavCustomCurve_v2';
    const navId = nav.dataset.navId || '';
    const panel = navId
      ? document.querySelector(`.section-sidebar-nav-devpanel[data-panel-for="${navId}"]`)
      : null;

    const clamp01 = (value) => Math.min(1, Math.max(0, value));
    const round2 = (value) => (Math.round(value * 100) / 100).toFixed(2);

    const binomial = (n, k) => {
      if (k < 0 || k > n) return 0;
      if (k === 0 || k === n) return 1;
      let result = 1;
      const kk = Math.min(k, n - k);
      for (let i = 1; i <= kk; i += 1) {
        result = (result * (n - kk + i)) / i;
      }
      return result;
    };

    const flatToControlPairs = (flatPoints) => {
      const controls = [];
      for (let i = 0; i < flatPoints.length; i += 2) {
        controls.push([clamp01(Number(flatPoints[i])), clamp01(Number(flatPoints[i + 1]))]);
      }
      return controls;
    };

    const evaluateBezierPoint = (allPoints, t) => {
      const n = allPoints.length - 1;
      let x = 0;
      let y = 0;
      for (let i = 0; i <= n; i += 1) {
        const basis = binomial(n, i) * (1 - t) ** (n - i) * t ** i;
        x += basis * allPoints[i][0];
        y += basis * allPoints[i][1];
      }
      return [x, y];
    };

    const createBezierEaser = (flatControlPoints) => {
      const controls = flatToControlPairs(flatControlPoints);
      const points = [[0, 0], ...controls, [1, 1]];

      const solveCurveT = (xTarget) => {
        let lower = 0;
        let upper = 1;
        let t = xTarget;
        for (let i = 0; i < 16; i += 1) {
          const [x] = evaluateBezierPoint(points, t);
          const error = x - xTarget;
          if (Math.abs(error) < 0.0005) return t;
          if (error > 0) upper = t;
          else lower = t;
          t = (lower + upper) / 2;
        }
        return t;
      };

      return (x) => {
        const xTarget = clamp01(x);
        const t = solveCurveT(xTarget);
        const [, y] = evaluateBezierPoint(points, t);
        return clamp01(y);
      };
    };

    const easingPresets = {
      nativeSmooth: { label: 'Browser native smooth', native: true },
      appleOut: { label: 'Apple easeOut', points: [0, 0, 0.58, 1] },
      appleInOut: { label: 'Apple easeInOut', points: [0.42, 0, 0.58, 1] },
      easeOutCubic: { label: 'Ease Out Cubic', points: [0.215, 0.61, 0.355, 1] },
      // Tuned to preserve quick pickup while easing off earlier.
      easeOutQuint: { label: 'Ease Out Quint', points: [0.2, 0.9, 0.32, 1] },
      easeInOutSoft: { label: 'Soft In/Out', points: [0.25, 0.1, 0.25, 1] },
      standardWeb: { label: 'CSS ease', points: [0.25, 0.1, 0.25, 1] },
      customBezier: { label: 'Custom (Bezier editor)', points: [0.14, 0, 0.23, 0, 0.2, 1, 0.41, 1] },
    };

    const getStoredPreset = () => {
      try {
        return window.localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    };

    const savePreset = (key) => {
      try {
        window.localStorage.setItem(storageKey, key);
      } catch {
        // Ignore storage failures in private mode.
      }
    };

    const getStoredCustomCurve = () => {
      try {
        const raw = window.localStorage.getItem(customCurveStorageKey);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return null;
        const numbers = parsed.map((value) => Number(value));
        if (numbers.some((n) => !Number.isFinite(n))) return null;
        if (numbers.length === 8) return numbers.map((n) => clamp01(n));
        if (numbers.length === 4) {
          // Migrate prior cubic custom curve to a quintic control polygon.
          const [p1x, p1y, p2x, p2y] = numbers.map((n) => clamp01(n));
          return [
            p1x,
            p1y,
            clamp01((2 * p1x + p2x) / 3),
            clamp01((2 * p1y + p2y) / 3),
            clamp01((p1x + 2 * p2x) / 3),
            clamp01((p1y + 2 * p2y) / 3),
            p2x,
            p2y,
          ];
        }
        return null;
      } catch {
        return null;
      }
    };

    const saveCustomCurve = (points) => {
      try {
        window.localStorage.setItem(customCurveStorageKey, JSON.stringify(points));
      } catch {
        // Ignore storage failures in private mode.
      }
    };

    let currentEasingKey = nav.dataset.defaultEasing || 'appleOut';
    const storedPreset = getStoredPreset();
    if (storedPreset && easingPresets[storedPreset]) {
      currentEasingKey = storedPreset;
    } else if (!easingPresets[currentEasingKey]) {
      currentEasingKey = 'appleOut';
    }
    const storedCustomCurve = getStoredCustomCurve();
    if (storedCustomCurve) {
      easingPresets.customBezier.points = storedCustomCurve;
    }
    let currentEaser = createBezierEaser(easingPresets.appleOut.points);
    let useNativeSmooth = false;

    const curveReadout = panel instanceof HTMLElement ? panel.querySelector('[data-curve-readout]') : null;
    const bezierGraph = panel instanceof HTMLElement ? panel.querySelector('[data-bezier-graph]') : null;
    const bezierPath = panel instanceof HTMLElement ? panel.querySelector('[data-bezier-path]') : null;
    const bezierGuides = panel instanceof HTMLElement ? panel.querySelector('[data-bezier-guides]') : null;
    const bezierHandles = panel instanceof HTMLElement ? Array.from(panel.querySelectorAll('[data-handle]')) : [];

    const normalizeQuinticControls = (flatPoints) => flatPoints.map((n) => clamp01(Number(n)));

    const setCustomCurvePoints = (points, { persist = true } = {}) => {
      easingPresets.customBezier.points = normalizeQuinticControls(points);
      if (persist) saveCustomCurve(easingPresets.customBezier.points);
      if (currentEasingKey === 'customBezier') {
        currentEaser = createBezierEaser(easingPresets.customBezier.points);
      }
      updateCurveUI();
    };

    const updateCurveUI = () => {
      const controls = flatToControlPairs(easingPresets.customBezier.points);

      if (curveReadout) {
        const controlText = controls.map(([x, y]) => `(${round2(x)}, ${round2(y)})`).join(', ');
        curveReadout.textContent = `bezier5(${controlText})`;
      }
      const allPoints = [[0, 0], ...controls, [1, 1]];
      const svgPoints = allPoints.map(([x, y]) => [x * 100, (1 - y) * 100]);

      if (bezierPath) {
        const sampleCount = 42;
        let d = '';
        for (let i = 0; i <= sampleCount; i += 1) {
          const t = i / sampleCount;
          const [x, y] = evaluateBezierPoint(allPoints, t);
          const sx = x * 100;
          const sy = (1 - y) * 100;
          d += `${i === 0 ? 'M' : 'L'} ${sx} ${sy} `;
        }
        bezierPath.setAttribute('d', d.trim());
      }
      if (bezierGuides) {
        bezierGuides.setAttribute('points', svgPoints.map(([x, y]) => `${x},${y}`).join(' '));
      }
      bezierHandles.forEach((handleEl) => {
        if (!(handleEl instanceof SVGElement)) return;
        const handleName = handleEl.getAttribute('data-handle');
        if (!handleName) return;
        const index = Number(handleName.replace('p', '')) - 1;
        const point = svgPoints[index + 1];
        if (!point) return;
        handleEl.setAttribute('cx', `${point[0]}`);
        handleEl.setAttribute('cy', `${point[1]}`);
      });
    };

    const syncPanelSelection = (selectedKey) => {
      if (!(panel instanceof HTMLElement)) return;
      panel.querySelectorAll('[data-easing-key]').forEach((button) => {
        const isSelected = button.getAttribute('data-easing-key') === selectedKey;
        button.classList.toggle('is-selected', isSelected);
        button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });
    };

    const setEasingPreset = (key, persist = true) => {
      if (!easingPresets[key]) return;
      currentEasingKey = key;
      const preset = easingPresets[key];
      useNativeSmooth = Boolean(preset.native);
      if (!useNativeSmooth && preset.points) {
        currentEaser = createBezierEaser(preset.points);
      }
      syncPanelSelection(key);
      if (persist) savePreset(key);
    };

    if (panel instanceof HTMLElement) {
      panel.querySelectorAll('[data-easing-key]').forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.getAttribute('data-easing-key');
          if (!key) return;
          setEasingPreset(key);
        });
      });

      if (bezierGraph instanceof SVGElement) {
        const toCurvePoint = (clientX, clientY) => {
          const rect = bezierGraph.getBoundingClientRect();
          const x = clamp01((clientX - rect.left) / rect.width);
          const y = clamp01(1 - (clientY - rect.top) / rect.height);
          return [x, y];
        };

        const startHandleDrag = (handleName, pointerId) => {
          const onPointerMove = (moveEvent) => {
            const [x, y] = toCurvePoint(moveEvent.clientX, moveEvent.clientY);
            const nextPoints = [...easingPresets.customBezier.points];
            const handleIndex = Number(handleName.replace('p', '')) - 1;
            if (Number.isNaN(handleIndex) || handleIndex < 0 || handleIndex > 3) return;
            const xIndex = handleIndex * 2;
            nextPoints[xIndex] = x;
            nextPoints[xIndex + 1] = y;
            setCustomCurvePoints(nextPoints);
            if (currentEasingKey !== 'customBezier') {
              setEasingPreset('customBezier');
            }
          };

          const stopDrag = () => {
            window.removeEventListener('pointermove', onPointerMove);
            window.removeEventListener('pointerup', stopDrag);
            window.removeEventListener('pointercancel', stopDrag);
          };

          if (bezierGraph.setPointerCapture) {
            try {
              bezierGraph.setPointerCapture(pointerId);
            } catch {
              // Ignore capture failures.
            }
          }
          window.addEventListener('pointermove', onPointerMove);
          window.addEventListener('pointerup', stopDrag);
          window.addEventListener('pointercancel', stopDrag);
        };

        bezierHandles.forEach((handleEl) => {
          if (!(handleEl instanceof SVGElement)) return;
          handleEl.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            const handleName = handleEl.getAttribute('data-handle');
            if (!handleName) return;
            startHandleDrag(handleName, event.pointerId);
          });
        });
      }
    }
    updateCurveUI();
    setEasingPreset(currentEasingKey, false);

    /**
     * Animate details expand/collapse with the same easing curve as section
     * click-scroll. Pixel height (not 0fr↔1fr) avoids the common end-of-motion
     * hitch; `[open]` is only cleared after the close animation finishes.
     */
    const groupAnimTokens = new WeakMap();
    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const groupIsVisuallyOpen = (group) => {
      if (!(group instanceof HTMLDetailsElement) || !group.open) return false;
      const content = group.querySelector('.section-sidebar-nav__group-content');
      return !(content instanceof HTMLElement && content.classList.contains('is-collapsing'));
    };

    const clearGroupAnimStyles = (content) => {
      content.style.transition = '';
      content.style.height = '';
      content.style.opacity = '';
      content.style.overflow = '';
      content.style.gridTemplateRows = '';
    };

    const animateGroup = (group, shouldOpen) => {
      if (!(group instanceof HTMLDetailsElement)) return Promise.resolve();

      const content = group.querySelector('.section-sidebar-nav__group-content');
      if (!(content instanceof HTMLElement)) {
        group.open = shouldOpen;
        return Promise.resolve();
      }

      // Skip if already at (or animating toward) the requested state — otherwise
      // scroll-spy would restart mid-expand every frame.
      if (shouldOpen) {
        if (group.open && !content.classList.contains('is-collapsing')) {
          return Promise.resolve();
        }
      } else if (!group.open || content.classList.contains('is-collapsing')) {
        return Promise.resolve();
      }

      if (prefersReducedMotion()) {
        content.classList.remove('is-expanding', 'is-collapsing');
        clearGroupAnimStyles(content);
        group.open = shouldOpen;
        return Promise.resolve();
      }

      const token = {};
      groupAnimTokens.set(group, token);
      const isStale = () => groupAnimTokens.get(group) !== token;
      const durationMs = 480;

      return new Promise((resolve) => {
        let rafId = 0;
        let settled = false;

        const finish = () => {
          if (settled || isStale()) return;
          settled = true;
          if (rafId) cancelAnimationFrame(rafId);
          content.classList.remove('is-expanding', 'is-collapsing');
          clearGroupAnimStyles(content);
          resolve();
        };

        content.style.transition = 'none';
        content.style.overflow = 'hidden';
        content.style.gridTemplateRows = '1fr';

        // Continue from the live height when reversing mid-animation.
        const liveHeight = content.getBoundingClientRect().height;
        let startHeight = 0;
        let endHeight = 0;

        if (shouldOpen) {
          content.classList.remove('is-collapsing');
          content.classList.add('is-expanding');
          group.open = true;
          content.style.height = 'auto';
          content.style.opacity = content.style.opacity || '0';
          endHeight = content.scrollHeight;
          startHeight = liveHeight;
          content.style.height = `${startHeight}px`;
        } else {
          content.classList.remove('is-expanding');
          content.classList.add('is-collapsing');
          group.open = true;
          startHeight = liveHeight > 0 ? liveHeight : content.scrollHeight;
          endHeight = 0;
          content.style.height = `${startHeight}px`;
          if (!content.style.opacity) content.style.opacity = '1';
        }

        const startOpacity = Number.parseFloat(content.style.opacity);
        const fromOpacity = Number.isFinite(startOpacity) ? startOpacity : shouldOpen ? 0 : 1;
        const toOpacity = shouldOpen ? 1 : 0;

        void content.offsetHeight;
        const startedAt = performance.now();

        const tick = (now) => {
          if (isStale()) {
            if (rafId) cancelAnimationFrame(rafId);
            return;
          }
          const progress = Math.min((now - startedAt) / durationMs, 1);
          const eased = currentEaser(progress);
          const height = startHeight + (endHeight - startHeight) * eased;
          content.style.height = `${Math.max(0, height)}px`;
          content.style.opacity = String(fromOpacity + (toOpacity - fromOpacity) * eased);

          if (progress < 1) {
            rafId = requestAnimationFrame(tick);
            return;
          }

          if (!shouldOpen) group.open = false;
          finish();
        };

        rafId = requestAnimationFrame(tick);
      });
    };

    const setActiveLink = (id) => {
      let activeGroup = null;
      navLinks.forEach((link) => {
        const href = link.getAttribute('href');
        const isActive = href === `#${id}`;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'true');
          const group = link.closest('.section-sidebar-nav__group');
          if (group instanceof HTMLDetailsElement) activeGroup = group;
        } else {
          link.removeAttribute('aria-current');
        }
      });

      /**
       * Auto accordion: open the active link's group, close others — unless the
       * user pinned a group open by expanding its header manually. Closing a
       * pinned group clears the pin so scroll auto-behaviour resumes.
       *
       * Open/close animate in parallel so the next group title moves up while
       * outgoing sub-links fade out and incoming ones fade in.
       */
      navGroups.forEach((group) => {
        if (!(group instanceof HTMLDetailsElement)) return;
        if (group === activeGroup) {
          animateGroup(group, true);
          return;
        }
        if (!pinnedOpenGroups.has(group)) {
          animateGroup(group, false);
        }
      });
    };

    navGroups.forEach((group) => {
      if (!(group instanceof HTMLDetailsElement)) return;
      const summary = group.querySelector(':scope > summary');
      if (!(summary instanceof HTMLElement)) return;
      summary.addEventListener('click', (event) => {
        event.preventDefault();
        const willBeOpen = !groupIsVisuallyOpen(group);
        if (willBeOpen) pinnedOpenGroups.add(group);
        else pinnedOpenGroups.delete(group);
        animateGroup(group, willBeOpen);
      });
    });
    const getActiveSectionId = () => {
      const viewportHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const maxScroll = Math.max(docHeight - viewportHeight, 1);
      const currentScroll = Math.min(Math.max(window.scrollY, 0), maxScroll);

      const earlyRampDistance = viewportHeight * earlyRampVh;
      const holdOffset = viewportHeight * holdVh;
      const endRampDistance = viewportHeight * endRampVh;
      const endRampStart = Math.max(maxScroll - endRampDistance, earlyRampDistance);
      const endOffset = Math.max(viewportHeight - 12, holdOffset);

      let activationOffset = holdOffset;
      if (currentScroll <= earlyRampDistance) {
        const t = earlyRampDistance === 0 ? 1 : currentScroll / earlyRampDistance;
        activationOffset = holdOffset * t;
      } else if (currentScroll >= endRampStart) {
        const distance = Math.max(maxScroll - endRampStart, 1);
        const t = (currentScroll - endRampStart) / distance;
        activationOffset = holdOffset + (endOffset - holdOffset) * t;
      }

      const pivot = window.scrollY + activationOffset;
      let activeId = sections[0]?.id;

      for (const section of sections) {
        if (section.offsetTop <= pivot) {
          activeId = section.id;
        } else {
          break;
        }
      }

      if (window.scrollY + viewportHeight >= docHeight - 2) {
        return sections[sections.length - 1]?.id;
      }

      return activeId;
    };

    if (sections.length && navLinks.length) {
      let ticking = false;
      const updateActiveFromScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            if (isAutoScrolling) {
              ticking = false;
              return;
            }
            if (performance.now() < manualLockUntil) {
              ticking = false;
              return;
            }
            const activeId = getActiveSectionId();
            if (activeId) setActiveLink(activeId);
            ticking = false;
          });
          ticking = true;
        }
      };

      navLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          const href = link.getAttribute('href');
          if (!href || !href.startsWith('#')) return;

          const id = href.slice(1);
          const target = document.getElementById(id);
          if (!target) return;

          event.preventDefault();

          const startY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight;
          const viewportHeight = window.innerHeight;
          const maxScroll = Math.max(docHeight - viewportHeight, 0);
          const rect = target.getBoundingClientRect();
          const sectionHeight = rect.height;
          /**
           * Short sections pin near the top (under the header offset).
           * Tall ones (≥ ~65% of the viewport) centre vertically so large
           * images aren't cropped awkwardly at the fold.
           */
          const centerThreshold = viewportHeight * 0.65;
          const rawTargetTop = sectionHeight >= centerThreshold
            ? startY + rect.top - (viewportHeight - sectionHeight) / 2
            : startY + rect.top - clickOffsetPx;
          const targetTop = Math.min(Math.max(rawTargetTop, 0), maxScroll);
          const distance = targetTop - startY;

          setActiveLink(id);
          window.history.replaceState(null, '', href);

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || Math.abs(distance) < 2) {
            manualLockUntil = performance.now() + Math.min(clickLockMs, 120);
            window.scrollTo(0, targetTop);
            return;
          }

          if (useNativeSmooth) {
            manualLockUntil = performance.now() + clickLockMs;
            isAutoScrolling = true;
            window.scrollTo({ top: targetTop, behavior: 'smooth' });
            window.setTimeout(() => {
              isAutoScrolling = false;
              setActiveLink(id);
              updateActiveFromScroll();
            }, clickLockMs);
            return;
          }

          const duration = Math.min(900, Math.max(480, Math.abs(distance) * 0.55));
          manualLockUntil = performance.now() + Math.max(clickLockMs, duration + 100);

          if (scrollRafId) cancelAnimationFrame(scrollRafId);
          isAutoScrolling = true;
          let animationStart = 0;

          const animateScroll = (timestamp) => {
            if (animationStart === 0) animationStart = timestamp;
            const elapsed = timestamp - animationStart;
            const progress = Math.min(elapsed / duration, 1);
            const eased = currentEaser(progress);
            window.scrollTo(0, startY + distance * eased);

            if (progress < 1) {
              scrollRafId = requestAnimationFrame(animateScroll);
            } else {
              scrollRafId = 0;
              isAutoScrolling = false;
              setActiveLink(id);
              requestAnimationFrame(updateActiveFromScroll);
            }
          };

          scrollRafId = requestAnimationFrame(animateScroll);
        });
      });

      updateActiveFromScroll();
      window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
      window.addEventListener('resize', updateActiveFromScroll);
    }
  };

  document.querySelectorAll('.section-sidebar-nav').forEach((nav) => initSectionSidebarNav(nav));
</script>

