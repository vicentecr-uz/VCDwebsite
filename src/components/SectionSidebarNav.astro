---
type SectionLink = {
  id: string;
  label: string;
  outlineId?: string;
};

type SectionGroup = {
  label: string;
  children: SectionLink[];
  defaultOpen?: boolean;
  id?: string;
  anchor?: string;
};

interface Props {
  sectionLinks: Array<SectionLink | SectionGroup>;
  sectionSelector?: string;
  ariaLabel?: string;
  earlyRampVh?: number;
  holdVh?: number;
  endRampVh?: number;
  clickOffsetPx?: number;
  clickLockMs?: number;
  enableEasingDevPanel?: boolean;
  defaultEasingPreset?: string;
  /** Hide below the fixed-sidebar breakpoint (project case studies). */
  desktopOnly?: boolean;
}

const {
  sectionLinks,
  sectionSelector = '.section-block[id]',
  ariaLabel = 'Page sections',
  earlyRampVh = 0.3,
  holdVh = 0.25,
  endRampVh = 0.25,
  clickOffsetPx = 152,
  clickLockMs = 700,
  enableEasingDevPanel = import.meta.env.DEV,
  defaultEasingPreset = 'customBezier',
  desktopOnly = false,
} = Astro.props;

const navId = `section-sidebar-nav-${Math.random().toString(36).slice(2, 10)}`;
const easingOptions = [
  { key: 'nativeSmooth', label: 'Browser native smooth' },
  { key: 'appleOut', label: 'Apple easeOut' },
  { key: 'appleInOut', label: 'Apple easeInOut' },
  { key: 'easeOutCubic', label: 'Ease Out Cubic' },
  { key: 'easeOutQuint', label: 'Ease Out Quint' },
  { key: 'easeInOutSoft', label: 'Soft In/Out' },
  { key: 'standardWeb', label: 'CSS ease' },
  { key: 'customBezier', label: 'Custom (Bezier editor)' },
];
---

<aside
  class:list={['section-sidebar-nav', desktopOnly && 'section-sidebar-nav--desktop-only', sectionLinks.length === 0 && 'section-sidebar-nav--empty']}
  data-nav-id={navId}
  data-section-sidebar
  aria-label={ariaLabel}
  data-section-selector={sectionSelector}
  data-early-ramp-vh={earlyRampVh}
  data-hold-vh={holdVh}
  data-end-ramp-vh={endRampVh}
  data-click-offset-px={clickOffsetPx}
  data-click-lock-ms={clickLockMs}
  data-default-easing={defaultEasingPreset}
>
  <div class="section-sidebar-nav__scroll" data-section-sidebar-scroll>
    <ul class="section-sidebar-nav__list" data-section-sidebar-list>
    {sectionLinks.map((item) => (
      'children' in item ? (
        <li class="section-sidebar-nav__group-item" data-section-nav-group data-outline-id={item.id} data-outline-kind="group" data-nav-anchor={item.anchor} data-nav-label={item.label}>
          <details class="section-sidebar-nav__group" open={item.defaultOpen}>
            <summary class="section-sidebar-nav__summary">
              <svg viewBox="0 0 8 12" aria-hidden="true">
                <path d="M1.5 1.5 6 6l-4.5 4.5"></path>
              </svg>
              <span data-section-nav-label>{item.label}</span>
            </summary>
            <div class="section-sidebar-nav__group-content">
              <ul class="section-sidebar-nav__children">
                {item.children.map((link) => (
                  <li data-section-nav-link data-nav-id={link.id} data-outline-id={link.outlineId || link.id} data-outline-kind="section" data-nav-label={link.label}>
                    <a href={`#${link.id}`} class="section-sidebar-nav__link">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </li>
      ) : (
        <li data-section-nav-link data-nav-id={item.id} data-outline-id={item.outlineId || item.id} data-outline-kind="section" data-nav-label={item.label}>
          <a href={`#${item.id}`} class="section-sidebar-nav__link section-sidebar-nav__root-link">
            {item.label}
          </a>
        </li>
      )
    ))}
    </ul>
    {enableEasingDevPanel && (
      <div
        class="section-sidebar-nav__scroll-preview-spacer"
        data-scroll-preview-spacer
        hidden
        aria-hidden="true"
      ></div>
    )}
  </div>
</aside>

{
  enableEasingDevPanel && (
    <div class="section-sidebar-nav-devpanel" data-panel-for={navId}>
      <div class="section-sidebar-nav-devpanel__tabs" role="tablist" aria-label="Easing target">
        <button
          type="button"
          class="section-sidebar-nav-devpanel__tab"
          role="tab"
          data-easing-target="scroll"
          aria-selected="false"
        >
          Scroll
        </button>
        <button
          type="button"
          class="section-sidebar-nav-devpanel__tab is-selected"
          role="tab"
          data-easing-target="accordion"
          aria-selected="true"
        >
          Accordion
        </button>
      </div>
      <p class="section-sidebar-nav-devpanel__title" data-panel-title>Accordion easing playground</p>
      <div class="section-sidebar-nav-devpanel__grid">
        {easingOptions.map((option) => (
          <button
            type="button"
            class="section-sidebar-nav-devpanel__btn"
            data-easing-key={option.key}
            data-native-only={option.key === 'nativeSmooth' ? 'true' : undefined}
          >
            {option.label}
          </button>
        ))}
      </div>
      <div class="section-sidebar-nav-devpanel__sliders">
        <p class="section-sidebar-nav-devpanel__subhead">Custom cubic-bezier</p>
        <div class="section-sidebar-nav-devpanel__bezier-editor" data-bezier-editor>
          <svg
            class="section-sidebar-nav-devpanel__bezier-graph"
            data-bezier-graph
            viewBox="0 0 100 100"
            role="img"
            aria-label="Bezier curve editor"
          >
            <rect x="0" y="0" width="100" height="100" class="section-sidebar-nav-devpanel__bezier-bg"></rect>
            <polyline
              points="0,100 14,100 23,100 20,0 41,0 100,0"
              class="section-sidebar-nav-devpanel__bezier-guides"
              data-bezier-guides
            ></polyline>
            <path
              d="M 0 100 L 100 0"
              class="section-sidebar-nav-devpanel__bezier-path"
              data-bezier-path
            ></path>
            <circle cx="12" cy="65" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p1"></circle>
            <circle cx="28" cy="35" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p2"></circle>
            <circle cx="55" cy="12" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p3"></circle>
            <circle cx="82" cy="0" r="3.3" class="section-sidebar-nav-devpanel__bezier-handle" data-handle="p4"></circle>
            <circle cx="0" cy="100" r="2.1" class="section-sidebar-nav-devpanel__bezier-endpoint"></circle>
            <circle cx="100" cy="0" r="2.1" class="section-sidebar-nav-devpanel__bezier-endpoint"></circle>
          </svg>
          <p class="section-sidebar-nav-devpanel__bezier-helper">Drag the four control points (degree 5).</p>
        </div>
        <p class="section-sidebar-nav-devpanel__curve-readout" data-curve-readout>
          bezier5((0.46, 0.00), (0.16, 1.00), (0.41, 1.00), (0.70, 1.00))
        </p>
      </div>
      <p class="section-sidebar-nav-devpanel__hint" data-panel-hint>
        Pick a curve, then expand/collapse sidebar groups to test.
      </p>
      <div class="section-sidebar-nav-devpanel__tools">
        <button
          type="button"
          class="section-sidebar-nav-devpanel__btn section-sidebar-nav-devpanel__btn--wide"
          data-scroll-fade-preview-toggle
          aria-pressed="false"
        >
          Scroll fade preview
        </button>
      </div>
    </div>
  )
}

<script>
  const parseNumber = (value, fallback) => {
    const n = Number(value);
    return Number.isFinite(n) ? n : fallback;
  };

  const initSectionSidebarNav = (nav) => {
    if (!(nav instanceof HTMLElement) || nav.dataset.initialized === 'true') return;
    nav.dataset.initialized = 'true';

    const sectionSelector = nav.dataset.sectionSelector || '.section-block[id]';
    const earlyRampVh = parseNumber(nav.dataset.earlyRampVh, 0.3);
    const holdVh = parseNumber(nav.dataset.holdVh, 0.25);
    const endRampVh = parseNumber(nav.dataset.endRampVh, 0.25);
    const clickOffsetPx = parseNumber(nav.dataset.clickOffsetPx, 152);
    const clickLockMs = parseNumber(nav.dataset.clickLockMs, 700);

    // Live queries — Section Editor may rebuild sidebar DOM without a full reload.
    const getSections = () => Array.from(document.querySelectorAll(sectionSelector));
    const getNavLinks = () => Array.from(nav.querySelectorAll('.section-sidebar-nav__link'));
    const getNavGroups = () => Array.from(nav.querySelectorAll('.section-sidebar-nav__group'));
    const getScrollShell = () =>
      nav.querySelector('[data-section-sidebar-scroll]');
    const getNavList = () =>
      nav.querySelector('[data-section-sidebar-list]');
    let manualLockUntil = 0;
    let scrollRafId = 0;
    let isAutoScrolling = false;
    /** Groups the user expanded via the header — stay open until they close them. */
    const pinnedOpenGroups = new WeakSet();
    /** Groups the user collapsed via the header — stay closed only while
     * scrollspy remains inside that group (cleared when leaving). */
    const pinnedClosedGroups = new WeakSet();
    /** Section editor (level 2): keep all groups open; only highlight the active link. */
    let sectionEditorKeepOpen = false;

    const isSectionEditorActive = () =>
      document.documentElement.classList.contains('show-section-nav-editor') &&
      document.documentElement.classList.contains('is-dev-mode');

    const activateSectionEditorSidebar = () => {
      sectionEditorKeepOpen = true;
      getNavGroups().forEach((group) => {
        if (!(group instanceof HTMLDetailsElement)) return;
        pinnedOpenGroups.add(group);
        pinnedClosedGroups.delete(group);
      });
    };

    const deactivateSectionEditorSidebar = () => {
      sectionEditorKeepOpen = false;
      getNavGroups().forEach((group) => {
        if (!(group instanceof HTMLDetailsElement)) return;
        pinnedOpenGroups.delete(group);
        pinnedClosedGroups.delete(group);
      });
    };
    const navId = nav.dataset.navId || '';
    const panel = navId
      ? document.querySelector(`.section-sidebar-nav-devpanel[data-panel-for="${navId}"]`)
      : null;

    const clamp01 = (value) => Math.min(1, Math.max(0, value));
    const round2 = (value) => (Math.round(value * 100) / 100).toFixed(2);

    const binomial = (n, k) => {
      if (k < 0 || k > n) return 0;
      if (k === 0 || k === n) return 1;
      let result = 1;
      const kk = Math.min(k, n - k);
      for (let i = 1; i <= kk; i += 1) {
        result = (result * (n - kk + i)) / i;
      }
      return result;
    };

    const flatToControlPairs = (flatPoints) => {
      const controls = [];
      for (let i = 0; i < flatPoints.length; i += 2) {
        controls.push([clamp01(Number(flatPoints[i])), clamp01(Number(flatPoints[i + 1]))]);
      }
      return controls;
    };

    const evaluateBezierPoint = (allPoints, t) => {
      const n = allPoints.length - 1;
      let x = 0;
      let y = 0;
      for (let i = 0; i <= n; i += 1) {
        const basis = binomial(n, i) * (1 - t) ** (n - i) * t ** i;
        x += basis * allPoints[i][0];
        y += basis * allPoints[i][1];
      }
      return [x, y];
    };

    const createBezierEaser = (flatControlPoints) => {
      const controls = flatToControlPairs(flatControlPoints);
      const points = [[0, 0], ...controls, [1, 1]];

      const solveCurveT = (xTarget) => {
        let lower = 0;
        let upper = 1;
        let t = xTarget;
        for (let i = 0; i < 16; i += 1) {
          const [x] = evaluateBezierPoint(points, t);
          const error = x - xTarget;
          if (Math.abs(error) < 0.0005) return t;
          if (error > 0) upper = t;
          else lower = t;
          t = (lower + upper) / 2;
        }
        return t;
      };

      return (x) => {
        const xTarget = clamp01(x);
        const t = solveCurveT(xTarget);
        const [, y] = evaluateBezierPoint(points, t);
        return clamp01(y);
      };
    };

    const normalizeQuinticControls = (flatPoints) => flatPoints.map((n) => clamp01(Number(n)));

    const migrateStoredCurve = (raw) => {
      try {
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return null;
        const numbers = parsed.map((value) => Number(value));
        if (numbers.some((n) => !Number.isFinite(n))) return null;
        if (numbers.length === 8) return numbers.map((n) => clamp01(n));
        if (numbers.length === 4) {
          const [p1x, p1y, p2x, p2y] = numbers.map((n) => clamp01(n));
          return [
            p1x,
            p1y,
            clamp01((2 * p1x + p2x) / 3),
            clamp01((2 * p1y + p2y) / 3),
            clamp01((p1x + 2 * p2x) / 3),
            clamp01((p1y + 2 * p2y) / 3),
            p2x,
            p2y,
          ];
        }
        return null;
      } catch {
        return null;
      }
    };

    const createEasingController = ({
      storageKey,
      customCurveStorageKey,
      defaultKey,
      defaultCustomPoints,
      allowNative = true,
    }) => {
      const presets = {
        nativeSmooth: { label: 'Browser native smooth', native: true },
        appleOut: { label: 'Apple easeOut', points: [0, 0, 0.58, 1] },
        appleInOut: { label: 'Apple easeInOut', points: [0.42, 0, 0.58, 1] },
        easeOutCubic: { label: 'Ease Out Cubic', points: [0.215, 0.61, 0.355, 1] },
        easeOutQuint: { label: 'Ease Out Quint', points: [0.2, 0.9, 0.32, 1] },
        easeInOutSoft: { label: 'Soft In/Out', points: [0.25, 0.1, 0.25, 1] },
        standardWeb: { label: 'CSS ease', points: [0.25, 0.1, 0.25, 1] },
        customBezier: {
          label: 'Custom (Bezier editor)',
          points: [...defaultCustomPoints],
        },
      };

      const readStored = (key) => {
        try {
          return window.localStorage.getItem(key);
        } catch {
          return null;
        }
      };

      const writeStored = (key, value) => {
        try {
          window.localStorage.setItem(key, value);
        } catch {
          // Ignore storage failures in private mode.
        }
      };

      const storedCurve = migrateStoredCurve(readStored(customCurveStorageKey));
      if (storedCurve) presets.customBezier.points = storedCurve;

      let currentKey = defaultKey;
      const storedPreset = readStored(storageKey);
      if (storedPreset && presets[storedPreset] && (allowNative || !presets[storedPreset].native)) {
        currentKey = storedPreset;
      } else if (!presets[currentKey] || (!allowNative && presets[currentKey].native)) {
        currentKey = allowNative ? 'appleOut' : 'easeInOutSoft';
      }

      let easer = createBezierEaser(presets.appleOut.points);
      let useNative = false;

      const applyKey = (key) => {
        const preset = presets[key];
        if (!preset) return;
        if (!allowNative && preset.native) return;
        currentKey = key;
        useNative = Boolean(preset.native);
        if (!useNative && preset.points) {
          easer = createBezierEaser(preset.points);
        }
      };

      applyKey(currentKey);

      return {
        allowNative,
        getKey: () => currentKey,
        getEaser: () => easer,
        getUseNative: () => useNative,
        getCustomPoints: () => presets.customBezier.points,
        setPreset(key, persist = true) {
          if (!presets[key]) return;
          if (!allowNative && presets[key].native) return;
          applyKey(key);
          if (persist) writeStored(storageKey, key);
        },
        setCustomPoints(points, persist = true) {
          presets.customBezier.points = normalizeQuinticControls(points);
          if (persist) writeStored(customCurveStorageKey, JSON.stringify(presets.customBezier.points));
          if (currentKey === 'customBezier') {
            easer = createBezierEaser(presets.customBezier.points);
          }
        },
      };
    };

    const scrollEasing = createEasingController({
      storageKey: 'sectionSidebarNavEasingPreset_v2',
      customCurveStorageKey: 'sectionSidebarNavCustomCurve_v2',
      defaultKey: nav.dataset.defaultEasing || 'customBezier',
      defaultCustomPoints: [0.14, 0, 0.23, 0, 0.2, 1, 0.41, 1],
      allowNative: true,
    });

    // Tuned in the Accordion easing playground (2026-07-19).
    const accordionEasing = createEasingController({
      storageKey: 'sectionSidebarNavAccordionEasing_v1',
      customCurveStorageKey: 'sectionSidebarNavAccordionCurve_v1',
      defaultKey: 'customBezier',
      defaultCustomPoints: [0.46, 0, 0.16, 1, 0.41, 1, 0.7, 1],
      allowNative: false,
    });

    const easingTargets = {
      scroll: scrollEasing,
      accordion: accordionEasing,
    };

    let activeEasingTarget = 'accordion';
    // Live-bound so scroll animation always uses the latest scroll preset.
    const currentEaser = (t) => scrollEasing.getEaser()(t);
    const accordionEaser = (t) => accordionEasing.getEaser()(t);
    let useNativeSmooth = scrollEasing.getUseNative();

    const syncNativeFlag = () => {
      useNativeSmooth = scrollEasing.getUseNative();
    };

    const panelTitle = panel instanceof HTMLElement ? panel.querySelector('[data-panel-title]') : null;
    const panelHint = panel instanceof HTMLElement ? panel.querySelector('[data-panel-hint]') : null;
    const curveReadout = panel instanceof HTMLElement ? panel.querySelector('[data-curve-readout]') : null;
    const bezierGraph = panel instanceof HTMLElement ? panel.querySelector('[data-bezier-graph]') : null;
    const bezierPath = panel instanceof HTMLElement ? panel.querySelector('[data-bezier-path]') : null;
    const bezierGuides = panel instanceof HTMLElement ? panel.querySelector('[data-bezier-guides]') : null;
    const bezierHandles = panel instanceof HTMLElement ? Array.from(panel.querySelectorAll('[data-handle]')) : [];

    const activeController = () => easingTargets[activeEasingTarget] || accordionEasing;

    const updateCurveUI = () => {
      const controller = activeController();
      const controls = flatToControlPairs(controller.getCustomPoints());

      if (curveReadout) {
        const controlText = controls.map(([x, y]) => `(${round2(x)}, ${round2(y)})`).join(', ');
        curveReadout.textContent = `bezier5(${controlText})`;
      }
      const allPoints = [[0, 0], ...controls, [1, 1]];
      const svgPoints = allPoints.map(([x, y]) => [x * 100, (1 - y) * 100]);

      if (bezierPath) {
        const sampleCount = 42;
        let d = '';
        for (let i = 0; i <= sampleCount; i += 1) {
          const t = i / sampleCount;
          const [x, y] = evaluateBezierPoint(allPoints, t);
          const sx = x * 100;
          const sy = (1 - y) * 100;
          d += `${i === 0 ? 'M' : 'L'} ${sx} ${sy} `;
        }
        bezierPath.setAttribute('d', d.trim());
      }
      if (bezierGuides) {
        bezierGuides.setAttribute('points', svgPoints.map(([x, y]) => `${x},${y}`).join(' '));
      }
      bezierHandles.forEach((handleEl) => {
        if (!(handleEl instanceof SVGElement)) return;
        const handleName = handleEl.getAttribute('data-handle');
        if (!handleName) return;
        const index = Number(handleName.replace('p', '')) - 1;
        const point = svgPoints[index + 1];
        if (!point) return;
        handleEl.setAttribute('cx', `${point[0]}`);
        handleEl.setAttribute('cy', `${point[1]}`);
      });
    };

    const syncPanelSelection = () => {
      if (!(panel instanceof HTMLElement)) return;
      const controller = activeController();
      const selectedKey = controller.getKey();

      panel.querySelectorAll('[data-easing-key]').forEach((button) => {
        const key = button.getAttribute('data-easing-key');
        const isNativeOnly = button.getAttribute('data-native-only') === 'true';
        if (isNativeOnly) {
          button.hidden = !controller.allowNative;
        }
        const isSelected = key === selectedKey;
        button.classList.toggle('is-selected', isSelected);
        button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      });

      panel.querySelectorAll('[data-easing-target]').forEach((tab) => {
        const isActive = tab.getAttribute('data-easing-target') === activeEasingTarget;
        tab.classList.toggle('is-selected', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      if (panelTitle) {
        panelTitle.textContent =
          activeEasingTarget === 'scroll' ? 'Scroll easing playground' : 'Accordion easing playground';
      }
      if (panelHint) {
        panelHint.textContent =
          activeEasingTarget === 'scroll'
            ? 'Pick a curve, then click section links to test.'
            : 'Pick a curve, then expand/collapse sidebar groups to test.';
      }
    };

    const setEasingPreset = (key, persist = true) => {
      activeController().setPreset(key, persist);
      if (activeEasingTarget === 'scroll') syncNativeFlag();
      syncPanelSelection();
      updateCurveUI();
    };

    const setCustomCurvePoints = (points, { persist = true } = {}) => {
      const controller = activeController();
      controller.setCustomPoints(points, persist);
      if (controller.getKey() !== 'customBezier') {
        controller.setPreset('customBezier', persist);
      }
      if (activeEasingTarget === 'scroll') syncNativeFlag();
      syncPanelSelection();
      updateCurveUI();
    };

    if (panel instanceof HTMLElement) {
      panel.querySelectorAll('[data-easing-target]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-easing-target');
          if (target !== 'scroll' && target !== 'accordion') return;
          activeEasingTarget = target;
          syncPanelSelection();
          updateCurveUI();
        });
      });

      panel.querySelectorAll('[data-easing-key]').forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.getAttribute('data-easing-key');
          if (!key) return;
          setEasingPreset(key);
        });
      });

      const scrollFadePreviewToggle = panel.querySelector('[data-scroll-fade-preview-toggle]');
      const scrollPreviewSpacer = nav.querySelector('[data-scroll-preview-spacer]');
      const setScrollFadePreview = (enabled) => {
        nav.classList.toggle('is-scroll-fade-preview', enabled);
        if (scrollPreviewSpacer instanceof HTMLElement) {
          scrollPreviewSpacer.hidden = !enabled;
        }
        if (scrollFadePreviewToggle instanceof HTMLButtonElement) {
          scrollFadePreviewToggle.setAttribute('aria-pressed', enabled ? 'true' : 'false');
          scrollFadePreviewToggle.classList.toggle('is-selected', enabled);
          scrollFadePreviewToggle.textContent = enabled
            ? 'Scroll fade preview on'
            : 'Scroll fade preview';
        }
        updateSidebarScrollChrome();
      };

      scrollFadePreviewToggle?.addEventListener('click', () => {
        setScrollFadePreview(!nav.classList.contains('is-scroll-fade-preview'));
      });

      if (bezierGraph instanceof SVGElement) {
        const toCurvePoint = (clientX, clientY) => {
          const rect = bezierGraph.getBoundingClientRect();
          const x = clamp01((clientX - rect.left) / rect.width);
          const y = clamp01(1 - (clientY - rect.top) / rect.height);
          return [x, y];
        };

        const startHandleDrag = (handleName, pointerId) => {
          const onPointerMove = (moveEvent) => {
            const [x, y] = toCurvePoint(moveEvent.clientX, moveEvent.clientY);
            const nextPoints = [...activeController().getCustomPoints()];
            const handleIndex = Number(handleName.replace('p', '')) - 1;
            if (Number.isNaN(handleIndex) || handleIndex < 0 || handleIndex > 3) return;
            const xIndex = handleIndex * 2;
            nextPoints[xIndex] = x;
            nextPoints[xIndex + 1] = y;
            setCustomCurvePoints(nextPoints);
          };

          const stopDrag = () => {
            window.removeEventListener('pointermove', onPointerMove);
            window.removeEventListener('pointerup', stopDrag);
            window.removeEventListener('pointercancel', stopDrag);
          };

          if (bezierGraph.setPointerCapture) {
            try {
              bezierGraph.setPointerCapture(pointerId);
            } catch {
              // Ignore capture failures.
            }
          }
          window.addEventListener('pointermove', onPointerMove);
          window.addEventListener('pointerup', stopDrag);
          window.addEventListener('pointercancel', stopDrag);
        };

        bezierHandles.forEach((handleEl) => {
          if (!(handleEl instanceof SVGElement)) return;
          handleEl.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            const handleName = handleEl.getAttribute('data-handle');
            if (!handleName) return;
            startHandleDrag(handleName, event.pointerId);
          });
        });
      }
    }
    syncPanelSelection();
    updateCurveUI();
    syncNativeFlag();

    /**
     * Animate details expand/collapse with a dedicated easing curve (tunable in
     * the Accordion tab of the playground). Pixel height (not 0fr↔1fr) avoids
     * the common end-of-motion hitch; `[open]` is only cleared after close finishes.
     */
    /**
     * Single source of truth for in-flight accordion motion: one entry per group.
     * A single RAF ticks them all, so overlapping triggers (fast scroll-spy) can
     * never clobber each other's cleanup or leak container state.
     */
    const groupAnims = new Map();
    let animRafId = 0;
    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const groupIsVisuallyOpen = (group) => {
      if (!(group instanceof HTMLDetailsElement) || !group.open) return false;
      const content = group.querySelector('.section-sidebar-nav__group-content');
      return !(content instanceof HTMLElement && content.classList.contains('is-collapsing'));
    };

    const clearLinkAnimStyles = (content) => {
      content.querySelectorAll('.section-sidebar-nav__children > li').forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        row.style.opacity = '';
      });
      content.querySelectorAll('.section-sidebar-nav__link').forEach((link) => {
        if (!(link instanceof HTMLElement)) return;
        link.style.transition = '';
      });
      const children = content.querySelector('.section-sidebar-nav__children');
      if (children instanceof HTMLElement) {
        children.style.overflow = '';
        children.style.paddingTop = '';
      }
    };

    const clearGroupAnimStyles = (content) => {
      content.style.transition = '';
      content.style.height = '';
      content.style.opacity = '';
      content.style.overflow = '';
      content.style.minHeight = '';
      content.style.gridTemplateRows = '';
      content.style.display = '';
      content.style.position = '';
      content.style.visibility = '';
      content.style.width = '';
      content.style.left = '';
      content.style.top = '';
      clearLinkAnimStyles(content);
    };

    const updateSidebarScrollChrome = () => {
      const scrollShell = getScrollShell();
      if (!(scrollShell instanceof HTMLElement)) return;

      const em = parseFloat(getComputedStyle(nav).fontSize) || 16;
      const fadeEm = 1.25;
      const fadeInset = em * 0.5;
      const internalFade =
        scrollShell.scrollTop > fadeInset
          ? Math.min(em * fadeEm, scrollShell.scrollTop - fadeInset + em * 0.35)
          : 0;
      const fadePx = internalFade;

      scrollShell.classList.toggle('has-top-fade', fadePx > 0);
      scrollShell.style.setProperty('--sidebar-top-fade', `${fadePx}px`);

      const needsScroll = scrollShell.scrollHeight > scrollShell.clientHeight + 1;
      scrollShell.classList.toggle('is-scrollable', needsScroll);
    };

    const updateAnimatingClass = () => {
      const animating = groupAnims.size > 0;
      nav.classList.toggle('is-accordion-animating', animating);
      if (!animating) updateSidebarScrollChrome();
    };

    /**
     * Per-group measurement cache. Open height, row bands, and pad-top only
     * change when layout width / font-size changes, so we measure once and reuse
     * across every expand/collapse. WeakMap keys are the <details> elements, so a
     * Section Editor DOM rebuild (new elements) invalidates automatically; a
     * resize invalidates the rest by resetting the map.
     */
    let measureCache = new WeakMap();
    const getGroupMeasure = (group, content) => {
      let m = measureCache.get(group);
      if (!m) {
        const openHeight = measureOpenHeight(content);
        m = {
          openHeight,
          bands: measureLinkBands(content, openHeight),
        };
        measureCache.set(group, m);
      }
      return m;
    };

    /**
     * List height controller: while any group animates, drive the list's
     * min-height along one eased curve toward the projected total. This holds a
     * floor under the container so the summed child boxes can't dip for a frame
     * at the expand/collapse boundary (the start-of-animation jerk).
     */
    let listCtrl = null;

    const recomputeListCtrl = () => {
      const list = getNavList();
      if (!(list instanceof HTMLElement) || groupAnims.size === 0) {
        listCtrl = null;
        return;
      }
      const now = performance.now();
      const startH = list.getBoundingClientRect().height;
      let delta = 0;
      let maxRemaining = 0;
      groupAnims.forEach((anim) => {
        delta += anim.toHeight - anim.content.getBoundingClientRect().height;
        maxRemaining = Math.max(maxRemaining, anim.durationMs - (now - anim.startTime));
      });
      listCtrl = {
        startH,
        targetH: startH + delta,
        startTime: now,
        durationMs: Math.max(1, maxRemaining),
      };
    };

    const clearListCtrl = () => {
      const list = getNavList();
      if (list instanceof HTMLElement) list.style.minHeight = '';
      listCtrl = null;
    };

    const measureLinkBands = (content, heightPx = null) => {
      const bands = [];
      const prev = {
        height: content.style.height,
        overflow: content.style.overflow,
        gridTemplateRows: content.style.gridTemplateRows,
        position: content.style.position,
        visibility: content.style.visibility,
        pointerEvents: content.style.pointerEvents,
        width: content.style.width,
        left: content.style.left,
        top: content.style.top,
      };

      const width =
        content.getBoundingClientRect().width ||
        content.parentElement?.getBoundingClientRect().width ||
        0;

      content.style.gridTemplateRows = '1fr';
      content.style.overflow = 'visible';
      content.style.position = 'absolute';
      content.style.visibility = 'hidden';
      content.style.pointerEvents = 'none';
      content.style.left = '0';
      content.style.top = '0';
      if (width > 0) content.style.width = `${width}px`;
      if (heightPx !== null) content.style.height = `${heightPx}px`;

      const contentTop = content.getBoundingClientRect().top;
      content.querySelectorAll('.section-sidebar-nav__children > li').forEach((li) => {
        if (!(li instanceof HTMLElement)) return;
        const rect = li.getBoundingClientRect();
        bands.push({
          row: li,
          top: rect.top - contentTop,
          height: rect.height,
        });
      });

      content.style.height = prev.height;
      content.style.overflow = prev.overflow;
      content.style.gridTemplateRows = prev.gridTemplateRows;
      content.style.position = prev.position;
      content.style.visibility = prev.visibility;
      content.style.pointerEvents = prev.pointerEvents;
      content.style.width = prev.width;
      content.style.left = prev.left;
      content.style.top = prev.top;

      return bands;
    };

    /**
     * Row fades keyed to visible height — same mapping for expand and collapse,
     * so the two directions are literal mirrors. Bottom-first slices: as height
     * shrinks, lower rows clear first; as it grows, upper rows appear first —
     * but only after a short headroom (`1 - FADE_TRAVEL_RATIO`) so a neighbor's
     * label never sits on top of rows that are still fading in (expand) or that
     * haven't finished fading out (collapse).
     */
    const FADE_TRAVEL_RATIO = 0.88;

    const applyLinkOpacitiesForHeight = (bands, visibleHeight, travelExtent) => {
      if (!bands.length || travelExtent <= 0) return;

      const count = bands.length;
      const fadeTravel = travelExtent * FADE_TRAVEL_RATIO;
      const slice = fadeTravel / count;

      // Bottom-first: index 0 is the lowest row. Opacity is a function of height
      // alone — direction does not get its own curve.
      const sorted = [...bands].sort((a, b) => b.top - a.top);
      sorted.forEach((band, index) => {
        const fadeHigh = travelExtent - index * slice;
        const fadeLow = fadeHigh - slice;
        const span = Math.max(fadeHigh - fadeLow, 1);
        let opacity = 1;
        if (visibleHeight <= fadeLow) opacity = 0;
        else if (visibleHeight < fadeHigh) opacity = (visibleHeight - fadeLow) / span;
        band.row.style.opacity = String(Math.max(0, Math.min(1, opacity)));
      });
    };

    const setGroupAnimOverflow = (content) => {
      content.style.overflow = 'visible';
      const children = content.querySelector('.section-sidebar-nav__children');
      if (children instanceof HTMLElement) children.style.overflow = 'visible';
    };

    const setGroupAnimDisplay = (content) => {
      content.style.display = 'block';
    };

    const getChevronSvg = (group) => group.querySelector('.section-sidebar-nav__summary svg');

    const getChevronDegrees = (group) => {
      const svg = getChevronSvg(group);
      if (svg instanceof SVGElement) {
        const match = svg.style.transform.match(/rotate\(([-\d.]+)deg\)/);
        if (match) return parseFloat(match[1]);
      }
      return group.open ? 90 : 0;
    };

    const applyChevronDegrees = (group, degrees) => {
      const svg = getChevronSvg(group);
      if (!(svg instanceof SVGElement)) return;
      svg.style.transition = 'none';
      svg.style.transform = `rotate(${degrees}deg)`;
    };

    const clearChevronDegrees = (group) => {
      const svg = getChevronSvg(group);
      if (!(svg instanceof SVGElement)) return;
      svg.style.transition = '';
      svg.style.transform = '';
    };

    /** Duration scales with travel distance (taller groups take longer; no per-link constants). */
    const durationForTravel = (travelPx) => {
      const em = parseFloat(getComputedStyle(nav).fontSize) || 16;
      const msPerEm = 220;
      const travelEm = travelPx / em;
      return Math.min(720, Math.max(320, travelEm * msPerEm));
    };

    /**
     * Natural open height without putting full height into document flow.
     * (height:auto in-flow was shoving sibling group titles to their end
     * positions for a frame, so expand looked like a jump vs collapse.)
     */
    const measureOpenHeight = (content) => {
      const width =
        content.getBoundingClientRect().width ||
        content.parentElement?.getBoundingClientRect().width ||
        0;

      const prev = {
        height: content.style.height,
        opacity: content.style.opacity,
        overflow: content.style.overflow,
        gridTemplateRows: content.style.gridTemplateRows,
        position: content.style.position,
        visibility: content.style.visibility,
        width: content.style.width,
        left: content.style.left,
        top: content.style.top,
      };

      content.style.gridTemplateRows = '1fr';
      content.style.overflow = 'visible';
      content.style.height = 'auto';
      content.style.position = 'absolute';
      content.style.visibility = 'hidden';
      content.style.pointerEvents = 'none';
      content.style.left = '0';
      content.style.top = '0';
      if (width > 0) content.style.width = `${width}px`;

      const height = content.scrollHeight;

      content.style.height = prev.height;
      content.style.opacity = prev.opacity;
      content.style.overflow = prev.overflow;
      content.style.gridTemplateRows = prev.gridTemplateRows;
      content.style.position = prev.position;
      content.style.visibility = prev.visibility;
      content.style.width = prev.width;
      content.style.left = prev.left;
      content.style.top = prev.top;
      content.style.pointerEvents = '';

      return height;
    };

    const finishGroupAnim = (group) => {
      const anim = groupAnims.get(group);
      if (!anim) return;
      groupAnims.delete(group);
      if (!anim.shouldOpen) group.open = false;
      anim.content.classList.remove('is-expanding', 'is-collapsing');
      clearGroupAnimStyles(anim.content);
      clearChevronDegrees(group);
    };

    const tickGroupAnims = (now) => {
      animRafId = 0;
      let anyActive = false;

      groupAnims.forEach((anim, group) => {
        const progress =
          anim.durationMs > 0 ? Math.min((now - anim.startTime) / anim.durationMs, 1) : 1;
        const eased = accordionEaser(progress);
        const height = anim.fromHeight + (anim.toHeight - anim.fromHeight) * eased;
        const clampedHeight = Math.max(0, height);
        anim.content.style.height = `${clampedHeight}px`;
        applyLinkOpacitiesForHeight(anim.bands, clampedHeight, anim.travelExtent);
        const chevronDeg =
          anim.chevronFrom + (anim.chevronTo - anim.chevronFrom) * eased;
        applyChevronDegrees(group, chevronDeg);

        if (progress >= 1) finishGroupAnim(group);
        else anyActive = true;
      });

      const list = getNavList();
      if (list instanceof HTMLElement) {
        if (groupAnims.size === 0) {
          clearListCtrl();
        } else if (listCtrl) {
          const p =
            listCtrl.durationMs > 0
              ? Math.min((now - listCtrl.startTime) / listCtrl.durationMs, 1)
              : 1;
          const e = accordionEaser(p);
          list.style.minHeight = `${listCtrl.startH + (listCtrl.targetH - listCtrl.startH) * e}px`;
        }
      }

      updateAnimatingClass();
      if (anyActive) animRafId = requestAnimationFrame(tickGroupAnims);
    };

    const ensureAnimTicker = () => {
      if (!animRafId) animRafId = requestAnimationFrame(tickGroupAnims);
    };

    /**
     * Start (or retarget) a single group's expand/collapse. Reversing mid-flight
     * continues from the current visible height instead of snapping — and because
     * all groups share one ticker + one map entry each, concurrent scroll-spy
     * triggers can't orphan inline styles or container state.
     */
    const startGroupAnim = (group, shouldOpen) => {
      if (!(group instanceof HTMLDetailsElement)) return;

      const content = group.querySelector('.section-sidebar-nav__group-content');
      if (!(content instanceof HTMLElement)) {
        group.open = shouldOpen;
        return;
      }

      const existing = groupAnims.get(group);
      // Already heading to the requested state — don't restart every scroll frame.
      if (existing) {
        if (existing.shouldOpen === shouldOpen) return;
      } else if (shouldOpen ? group.open : !group.open) {
        return;
      }

      if (prefersReducedMotion()) {
        groupAnims.delete(group);
        content.classList.remove('is-expanding', 'is-collapsing');
        clearGroupAnimStyles(content);
        group.open = shouldOpen;
        updateAnimatingClass();
        return;
      }

      content.style.transition = 'none';
      content.style.opacity = '1';
      content.querySelectorAll('.section-sidebar-nav__link').forEach((link) => {
        if (link instanceof HTMLElement) link.style.transition = 'none';
      });

      const fromHeight = content.getBoundingClientRect().height;
      const chevronFrom = getChevronDegrees(group);
      const chevronTo = shouldOpen ? 90 : 0;
      setGroupAnimDisplay(content);
      setGroupAnimOverflow(content);
      content.style.gridTemplateRows = '1fr';
      content.style.minHeight = '0';

      const measure = getGroupMeasure(group, content);
      const { openHeight, bands } = measure;
      const endHeight = shouldOpen ? openHeight : 0;
      const toHeight = endHeight;
      // Row fade timing spans the full open height either way, so the sequence
      // reads the same whether it's a full run or a mid-flight reversal.
      const travelExtent = openHeight;

      if (shouldOpen) {
        content.classList.remove('is-collapsing');
        content.classList.add('is-expanding');
        if (!group.open) group.open = true;
        content.style.height = `${fromHeight}px`;
      } else {
        content.classList.remove('is-expanding');
        content.classList.add('is-collapsing');
        group.open = true; // keep painted until the close finishes
        content.style.height = `${fromHeight}px`;
      }

      void content.offsetHeight;
      applyLinkOpacitiesForHeight(bands, fromHeight, travelExtent);
      applyChevronDegrees(group, chevronFrom);

      groupAnims.set(group, {
        content,
        shouldOpen,
        fromHeight,
        toHeight,
        endHeight,
        bands,
        travelExtent,
        chevronFrom,
        chevronTo,
        startTime: performance.now(),
        durationMs: durationForTravel(Math.abs(toHeight - fromHeight)),
      });

      recomputeListCtrl();
      updateAnimatingClass();
      ensureAnimTicker();
    };

    const animateGroups = (entries) => {
      // Collapses before expands so sibling layout settles before a group opens.
      [...entries]
        .sort((a, b) => Number(a.shouldOpen) - Number(b.shouldOpen))
        .forEach(({ group, shouldOpen }) => startGroupAnim(group, shouldOpen));
    };

    const animateGroup = (group, shouldOpen) => startGroupAnim(group, shouldOpen);

    /** Level 2: open collapsed groups only — never auto-close. */
    const openClosedGroups = () => {
      const batch = getNavGroups()
        .filter((group) => group instanceof HTMLDetailsElement && !groupIsVisuallyOpen(group))
        .map((group) => ({ group, shouldOpen: true }));
      if (!batch.length) return;
      animateGroups(batch);
      batch.forEach(({ group }) => {
        pinnedOpenGroups.add(group);
        pinnedClosedGroups.delete(group);
      });
    };

    /**
     * When the active section's group is collapsed, highlight the group header
     * so the user can still see which group they're in.
     */
    const syncActiveGroupHighlight = (activeGroup) => {
      getNavGroups().forEach((group) => {
        if (!(group instanceof HTMLDetailsElement)) return;
        const summary = group.querySelector('.section-sidebar-nav__summary');
        if (!(summary instanceof HTMLElement)) return;
        const showGroupActive =
          group === activeGroup && !groupIsVisuallyOpen(group);
        summary.classList.toggle('is-active', showGroupActive);
      });
    };

    const setActiveLink = (id) => {
      let activeGroup = null;
      getNavLinks().forEach((link) => {
        const href = link.getAttribute('href');
        const isActive = href === `#${id}`;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'true');
          const group = link.closest('.section-sidebar-nav__group');
          if (group instanceof HTMLDetailsElement) activeGroup = group;
        } else {
          link.removeAttribute('aria-current');
        }
      });

      if (sectionEditorKeepOpen) {
        if (activeGroup instanceof HTMLDetailsElement && !groupIsVisuallyOpen(activeGroup)) {
          pinnedOpenGroups.add(activeGroup);
          pinnedClosedGroups.delete(activeGroup);
          animateGroup(activeGroup, true);
        }
        syncActiveGroupHighlight(null);
        return;
      }

      /**
     * Auto accordion: open the active link's group, close others — unless the
     * user pinned a group open/closed via its header. A manual close only
     * sticks while scrollspy stays inside that group; leaving clears the pin
     * so scrolling back in opens it again. While closed, the group header
     * carries the active highlight.
     *
     * Open/close animate in parallel so the next group title moves up while
     * outgoing sub-links fade out and incoming ones fade in.
     */
      const batch = [];
      getNavGroups().forEach((group) => {
        if (!(group instanceof HTMLDetailsElement)) return;
        // Manual collapse only lasts for this visit inside the group.
        if (pinnedClosedGroups.has(group) && group !== activeGroup) {
          pinnedClosedGroups.delete(group);
        }
        if (group === activeGroup) {
          if (pinnedClosedGroups.has(group)) {
            batch.push({ group, shouldOpen: false });
            return;
          }
          batch.push({ group, shouldOpen: true });
          return;
        }
        if (!pinnedOpenGroups.has(group)) {
          batch.push({ group, shouldOpen: false });
        }
      });
      if (batch.length) animateGroups(batch);
      syncActiveGroupHighlight(activeGroup);
    };

    let ticking = false;
    const updateActiveFromScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (isAutoScrolling) {
            ticking = false;
            return;
          }
          if (performance.now() < manualLockUntil) {
            ticking = false;
            return;
          }
          if (!getSections().length || !getNavLinks().length) {
            ticking = false;
            return;
          }
          const activeId = getActiveSectionId();
          if (activeId) setActiveLink(activeId);
          ticking = false;
        });
        ticking = true;
      }
    };

    // Event delegation so Section Editor DOM rebuilds keep working.
    nav.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const summary = target.closest('.section-sidebar-nav__summary');
      if (summary instanceof HTMLElement && nav.contains(summary)) {
        const group = summary.closest('.section-sidebar-nav__group');
        if (!(group instanceof HTMLDetailsElement)) return;
        event.preventDefault();
        const willBeOpen = !groupIsVisuallyOpen(group);
        if (willBeOpen) {
          pinnedOpenGroups.add(group);
          pinnedClosedGroups.delete(group);
        } else {
          pinnedOpenGroups.delete(group);
          pinnedClosedGroups.add(group);
        }
        animateGroup(group, willBeOpen);
        const activeLink = nav.querySelector('.section-sidebar-nav__link.is-active');
        const activeGroup = activeLink?.closest('.section-sidebar-nav__group') ?? null;
        syncActiveGroupHighlight(
          activeGroup instanceof HTMLDetailsElement ? activeGroup : null,
        );
        return;
      }

      // Section Editor owns sidebar link clicks while active.
      if (
        document.documentElement.classList.contains('show-section-nav-editor') &&
        document.documentElement.classList.contains('is-dev-mode')
      ) {
        return;
      }

      const link = target.closest('.section-sidebar-nav__link');
      if (!(link instanceof HTMLAnchorElement) || !nav.contains(link)) return;

      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;

      const id = href.slice(1);
      const scrollTarget = document.getElementById(id);
      if (!scrollTarget) return;

      event.preventDefault();

      const startY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      const viewportHeight = window.innerHeight;
      const maxScroll = Math.max(docHeight - viewportHeight, 0);
      const rect = scrollTarget.getBoundingClientRect();
      const sectionHeight = rect.height;
      /**
       * Short sections pin near the top (under the header offset).
       * Hero-sized ones (~0.65–2x the viewport) centre vertically so large
       * images aren't cropped awkwardly at the fold. Anything taller than
       * that is a catalog/wrapper section (e.g. the whole component
       * library), not a single hero — centring on its full height would
       * land the scroll somewhere in its middle, so it falls back to the
       * top offset instead.
       */
      const centerThreshold = viewportHeight * 0.65;
      const centerCeiling = viewportHeight * 2;
      const shouldCenter = sectionHeight >= centerThreshold && sectionHeight <= centerCeiling;
      const rawTargetTop = shouldCenter
        ? startY + rect.top - (viewportHeight - sectionHeight) / 2
        : startY + rect.top - clickOffsetPx;
      const targetTop = Math.min(Math.max(rawTargetTop, 0), maxScroll);
      const distance = targetTop - startY;

      setActiveLink(id);
      window.history.replaceState(null, '', href);

      const useNativeSmooth = scrollEasing.getUseNative();
      const currentEaser = scrollEasing.getEaser();

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || Math.abs(distance) < 2) {
        manualLockUntil = performance.now() + Math.min(clickLockMs, 120);
        window.scrollTo(0, targetTop);
        return;
      }

      if (useNativeSmooth) {
        manualLockUntil = performance.now() + clickLockMs;
        isAutoScrolling = true;
        window.scrollTo({ top: targetTop, behavior: 'smooth' });
        window.setTimeout(() => {
          isAutoScrolling = false;
          setActiveLink(id);
          updateActiveFromScroll();
        }, clickLockMs);
        return;
      }

      const duration = Math.min(900, Math.max(480, Math.abs(distance) * 0.55));
      manualLockUntil = performance.now() + Math.max(clickLockMs, duration + 100);

      if (scrollRafId) cancelAnimationFrame(scrollRafId);
      isAutoScrolling = true;
      let animationStart = 0;

      const animateScroll = (timestamp) => {
        if (animationStart === 0) animationStart = timestamp;
        const elapsed = timestamp - animationStart;
        const progress = Math.min(elapsed / duration, 1);
        const eased = currentEaser(progress);
        window.scrollTo(0, startY + distance * eased);

        if (progress < 1) {
          scrollRafId = requestAnimationFrame(animateScroll);
        } else {
          scrollRafId = 0;
          isAutoScrolling = false;
          setActiveLink(id);
          requestAnimationFrame(updateActiveFromScroll);
        }
      };

      scrollRafId = requestAnimationFrame(animateScroll);
    });

    const getActiveSectionId = () => {
      const sections = getSections();
      const viewportHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const maxScroll = Math.max(docHeight - viewportHeight, 1);
      const currentScroll = Math.min(Math.max(window.scrollY, 0), maxScroll);

      const earlyRampDistance = viewportHeight * earlyRampVh;
      const holdOffset = viewportHeight * holdVh;
      const endRampDistance = viewportHeight * endRampVh;
      const endRampStart = Math.max(maxScroll - endRampDistance, earlyRampDistance);
      const endOffset = Math.max(viewportHeight - 12, holdOffset);

      let activationOffset = holdOffset;
      if (currentScroll <= earlyRampDistance) {
        const t = earlyRampDistance === 0 ? 1 : currentScroll / earlyRampDistance;
        activationOffset = holdOffset * t;
      } else if (currentScroll >= endRampStart) {
        const distance = Math.max(maxScroll - endRampStart, 1);
        const t = (currentScroll - endRampStart) / distance;
        activationOffset = holdOffset + (endOffset - holdOffset) * t;
      }

      const pivot = window.scrollY + activationOffset;
      let activeId = sections[0]?.id;

      for (const section of sections) {
        if (section.offsetTop <= pivot) {
          activeId = section.id;
        } else {
          break;
        }
      }

      if (window.scrollY + viewportHeight >= docHeight - 2) {
        return sections[sections.length - 1]?.id;
      }

      return activeId;
    };

    window.addEventListener('vcd:section-nav-editor-change', ((event) => {
      const active = Boolean(event.detail?.active);
      if (active) {
        activateSectionEditorSidebar();
        // Sync runs in the next listener; open any still-collapsed groups after DOM settles.
        requestAnimationFrame(() => openClosedGroups());
      } else {
        deactivateSectionEditorSidebar();
        requestAnimationFrame(() => updateActiveFromScroll());
      }
    }) as EventListener);

    window.addEventListener('vcd:section-nav-sidebar-synced', () => {
      if (!sectionEditorKeepOpen) return;
      openClosedGroups();
    });

    if (isSectionEditorActive()) {
      activateSectionEditorSidebar();
      requestAnimationFrame(() => openClosedGroups());
    }

    updateActiveFromScroll();
    updateSidebarScrollChrome();
    window.addEventListener('scroll', () => {
      updateActiveFromScroll();
      updateSidebarScrollChrome();
    }, { passive: true });
    window.addEventListener('resize', () => {
      // Width / font-size may change → cached open heights & row bands are stale.
      measureCache = new WeakMap();
      updateActiveFromScroll();
      updateSidebarScrollChrome();
    });
    const scrollShell = getScrollShell();
    if (scrollShell instanceof HTMLElement) {
      scrollShell.addEventListener(
        'scroll',
        () => {
          requestAnimationFrame(updateSidebarScrollChrome);
        },
        { passive: true },
      );
    }

    // Section Editor can add/remove rows inside a reused group element, which
    // would leave the measurement cache stale. Watch structure only (not
    // attributes) so our style-only animation writes never trigger it.
    const navList = getNavList();
    if (navList instanceof HTMLElement && 'MutationObserver' in window) {
      new MutationObserver(() => {
        measureCache = new WeakMap();
      }).observe(navList, { childList: true, subtree: true });
    }
  };

  document.querySelectorAll('.section-sidebar-nav').forEach((nav) => initSectionSidebarNav(nav));
</script>

