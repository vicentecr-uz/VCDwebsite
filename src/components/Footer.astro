---
const year = new Date().getFullYear();
---

<footer class="mt-auto" style="padding: var(--space-unit) 0;">
  <p class="footer-text" style="font-family: var(--font-sans); font-weight: 700; letter-spacing: -0.03em; font-size: 1.1rem; line-height: 1;">
    © Vicente Cruz {year}
  </p>
</footer>

<style>
  .footer-text {
    color: #e3e3e3;
    transition: color 0.2s ease;
    cursor: default;
  }
  .footer-text:hover {
    color: #d1d1d1;
  }
</style>
