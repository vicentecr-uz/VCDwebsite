---
import DevThemeToggle from './DevThemeToggle.astro';
const year = new Date().getFullYear();
const showDevTools = import.meta.env.DEV;
---

<footer class="mt-auto" style="padding: var(--space-unit) 0; display: flex; align-items: center; justify-content: space-between; gap: var(--space-unit);">
  <p class="footer-text" style="font-family: var(--font-sans); font-weight: var(--text-subheading-weight); letter-spacing: var(--text-subheading-tracking); font-size: var(--text-subheading-size); line-height: 1;">
    © Vicente Cruz {year}
  </p>
  {showDevTools && <DevThemeToggle />}
</footer>

<style>
  .footer-text {
    color: var(--comp-footer-rest);
    transition: color 0.2s ease;
    cursor: default;
  }
  .footer-text:hover {
    color: var(--comp-footer-hover);
  }
</style>
