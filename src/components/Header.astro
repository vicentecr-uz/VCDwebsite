---
interface Props {
  title?: string;
  linkHref?: string;
}
const { title = 'Vicente Cruz', linkHref = '/' } = Astro.props;
---
<header class="flex items-center justify-between" style="padding: 0.85em 1em; position: sticky; top: 0; background-color: #ffffff; z-index: 10;">
  <a
    href={linkHref}
    class="hover:opacity-60 transition-opacity duration-200"
    style="font-family: var(--font-sans); font-size: 2.0em; line-height: 1; font-weight: 700; letter-spacing: -0.05ch;"
  >
    {title}
  </a>

  <nav>
    <a
      href={linkHref}
      class="block transition-opacity duration-200 opacity-100 hover:opacity-70"
    >
      <img
        src="/images/LG%20Square.svg"
        alt="Logo"
        style="height: 2.0rem; width: 2.0rem; display: block;"
      />
    </a>
  </nav>
</header>
