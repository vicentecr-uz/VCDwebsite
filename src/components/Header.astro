    font-size: var(--header-wordmark-size);
    line-height: 1;
    font-weight: var(--text-wordmark-weight);
    letter-spacing: -0.05ch;
    /* The hidden sizer is what sets the header row height. Trim it to
       cap-to-baseline so the row is the text's optical height rather than its
