---
interface Props {
  title?: string;
  /** DEV: JSON document whose `title` the page name writes to in Edit mode. */
  titleDocument?: string;
  /** @deprecated Use nav menu on all pages; kept for non–nav-menu fallback only. */
  linkHref?: string;
  navMenu?: boolean;
  wordmarkAsH1?: boolean;
}

import headerSettings from '../content/settings/header.json';
import type { SvgComponent } from 'astro/types';
import headerTitleBridgeSource from '../scripts/headerTitleBridge.js?raw';

const logoModules = import.meta.glob<{ default: SvgComponent }>('../../media/**/*.svg', { eager: true });
const logoPath = headerSettings.logoPath;
const logoAssetPath = logoPath.startsWith('/images/')
  ? decodeURIComponent(logoPath.slice('/images/'.length))
  : '';
const logoModuleKey = `../../media/${logoAssetPath}`;
const Logo = logoModules[logoModuleKey]?.default;

if (!Logo) {
  throw new Error(`Header logo asset is missing or invalid: ${logoPath}`);
}

const {
  title = headerSettings.siteTitle,
  titleDocument = '',
  linkHref = '/',
  navMenu = true,
  wordmarkAsH1 = false,
} = Astro.props;
const titleEditAttrs = import.meta.env.DEV && titleDocument
  ? {
      'data-dev-text-document': titleDocument,
      'data-dev-text-path': JSON.stringify(['title']),
      'data-dev-text-kind': 'text',
    }
  : undefined;
const WordmarkTag = wordmarkAsH1 ? 'h1' : 'span';
const homeWordmark = headerSettings.siteTitle.replace(' ', '\u00a0');
const wordmark = title.replace(' ', '\u00a0');
const showWordmarkSwap = title !== headerSettings.siteTitle;
const pageChars = [...wordmark];
const homeChars = [...homeWordmark];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === '/';
const brandHref = isHome ? null : '/';
const menuLinks = headerSettings.menuLinks.map((link) => ({
  ...link,
  navigationTitle: (link.href.replace(/\/+$/, '') || '/') === '/' ? headerSettings.siteTitle :
    link.href.replace(/\/+$/, '') === '/play' ? 'Play' : link.href.replace(/\/+$/, '') === '/about' ? headerSettings.siteTitle : undefined,
  isCurrent: (link.href.replace(/\/+$/, '') || '/') === currentPath,
}));
---

{navMenu ? (
  <div class="header-menu-backdrop" aria-hidden="true"></div>
  <div class="site-header-slot">
  <header class="site-header site-header--nav-menu">
    <div class="site-header__bg" aria-hidden="true"></div>
    <div class="site-header__row">
      <div class:list={['header-trigger', 'header-trigger--start', isHome && 'header-trigger--home']} data-header-title-swap={showWordmarkSwap ? 'true' : 'false'}>
        <span class="header-trigger__sizer" aria-hidden="true">
          {showWordmarkSwap ? (
            <span class="header-trigger__sizer-track">
              <span>{wordmark}</span>
              <span>{homeWordmark}</span>
            </span>
          ) : (
            wordmark
          )}
        </span>
        <div class="header-trigger__panel">
          <div class="header-trigger__panel-bg" aria-hidden="true"></div>
          <div class="header-trigger__brand">
            {brandHref ? (
              <a
                href={brandHref}
                data-header-navigation-title={headerSettings.siteTitle}
                class:list={['header-trigger__brand-link', showWordmarkSwap && 'header-trigger__brand-link--swap']}
                aria-label="Home"
              >
                <span class="header-trigger__wordmark-stack">
                  <WordmarkTag class="header-trigger__wordmark header-trigger__wordmark--page" aria-hidden="false">
                    {pageChars.map((char) => (
                      <span class="header-trigger__char">{char === ' ' ? '\u00a0' : char}</span>
                    ))}
                  </WordmarkTag>
                  <span class="header-trigger__wordmark header-trigger__wordmark--home" aria-hidden="true">
                    {homeChars.map((char) => (
                      <span class="header-trigger__char">{char === ' ' ? '\u00a0' : char}</span>
                    ))}
                  </span>
                </span>
                {titleEditAttrs && (
                  <WordmarkTag class="header-trigger__wordmark header-trigger__wordmark--edit" {...titleEditAttrs}>
                    {wordmark}
                  </WordmarkTag>
                )}
              </a>
            ) : (
              <>
                <span class="header-trigger__wordmark-stack">
                  <WordmarkTag class="header-trigger__wordmark header-trigger__wordmark--page" aria-hidden="false">
                    {pageChars.map((char) => (
                      <span class="header-trigger__char">{char === ' ' ? '\u00a0' : char}</span>
                    ))}
                  </WordmarkTag>
                  <span class="header-trigger__wordmark header-trigger__wordmark--home" aria-hidden="true">
                    {homeChars.map((char) => (
                      <span class="header-trigger__char">{char === ' ' ? '\u00a0' : char}</span>
                    ))}
                  </span>
                </span>
                {titleEditAttrs && (
                  <WordmarkTag class="header-trigger__wordmark header-trigger__wordmark--edit" {...titleEditAttrs}>
                    {wordmark}
                  </WordmarkTag>
                )}
              </>
            )}
          </div>
          <ul class="header-menu" role="list">
            {menuLinks.map((link) => (
              <li class:list={['header-menu__item', link.isCurrent && 'header-menu__item--current-page']}>
                <a
                  href={link.href}
                  data-header-navigation-title={link.navigationTitle}
                  class="header-menu__link"
                  aria-current={link.isCurrent ? 'page' : undefined}
                  data-current-page={link.isCurrent ? '' : undefined}
                >
                  <span class="header-menu__link-label">{link.label}</span>
                </a>
                {link.isCurrent && (
                  <span class="header-menu__current-note" data-current-page-note aria-hidden="true">
                    You are on this page
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="header-trigger header-trigger--end">
        <span class="header-trigger__sizer header-trigger__sizer--logo" aria-hidden="true">
          <span class="header-trigger__logo">
            <Logo width="100%" height="100%" fill="currentColor" aria-hidden="true" focusable="false" />
          </span>
        </span>
        <div class="header-trigger__panel">
          <div class="header-trigger__panel-bg" aria-hidden="true"></div>
          <div class="header-trigger__brand" data-dev-mode-trigger>
            {brandHref ? (
              <a href={brandHref} class="header-trigger__brand-link" aria-label="Home" data-header-navigation-title={headerSettings.siteTitle}>
                <span class="header-trigger__logo" aria-hidden="true">
                  <Logo width="100%" height="100%" fill="currentColor" aria-hidden="true" focusable="false" />
                </span>
              </a>
            ) : (
              <span
                class="header-trigger__logo"
                role="img"
                aria-label="Logo"
              >
                <Logo width="100%" height="100%" fill="currentColor" aria-hidden="true" focusable="false" />
              </span>
            )}
          </div>
          <ul class="header-menu" role="list">
            {menuLinks.map((link) => (
              <li class:list={['header-menu__item', link.isCurrent && 'header-menu__item--current-page']}>
                <a
                  href={link.href}
                  data-header-navigation-title={link.navigationTitle}
                  class="header-menu__link"
                  aria-current={link.isCurrent ? 'page' : undefined}
                  data-current-page={link.isCurrent ? '' : undefined}
                >
                  <span class="header-menu__link-label">{link.label}</span>
                </a>
                {link.isCurrent && (
                  <span class="header-menu__current-note" data-current-page-note aria-hidden="true">
                    You are on this page
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </header>
  </div>
) : (
  <div class="site-header-slot">
  <header class="site-header">
    <div class="site-header__bg" aria-hidden="true"></div>
    <div class="site-header__row">
      <a
        href={linkHref}
        class="header-link header-link--wordmark hover:opacity-60 transition-opacity duration-200"
        style="font-family: var(--font-sans); font-size: var(--header-wordmark-size); line-height: 1; font-weight: var(--text-wordmark-weight); letter-spacing: -0.05ch;"
      >
        {title}
      </a>

      <nav>
        <a
          href={linkHref}
          class="header-link block transition-opacity duration-200 opacity-100 hover:opacity-70"
          aria-label="Logo"
        >
          <span class="header-trigger__logo" aria-hidden="true">
            <Logo width="100%" height="100%" fill="currentColor" aria-hidden="true" focusable="false" />
          </span>
        </a>
      </nav>
    </div>
  </header>
  </div>
)}

<script is:inline set:html={headerTitleBridgeSource}></script>

<script is:inline>
  (() => {
    const slot = document.querySelector('.site-header-slot');
    const root = document.documentElement;
    let pending = null;
    try {
      const raw = sessionStorage.getItem('vcd:header-navigation');
      sessionStorage.removeItem('vcd:header-navigation');
      if (raw) pending = JSON.parse(raw);
    } catch { pending = null; }
    if (!slot || !pending || typeof pending.href !== 'string' || pending.href !== location.href ||
      typeof pending.title !== 'string' || !pending.title.trim() || pending.title.length > 300 ||
      typeof pending.time !== 'number' || !Number.isFinite(pending.time) ||
      Date.now() - pending.time < 0 || Date.now() - pending.time > 10000) return;

    const carriedMenus = Array.isArray(pending.openMenus) ? [...new Set(pending.openMenus.filter((side) => side === 'start' || side === 'end'))].slice(0, 2) : [];
    carriedMenus.forEach((side) => {
      const trigger = document.querySelector(`.header-trigger--${side}`);
      if (!trigger) return;
      trigger.classList.add('is-menu-open');
      trigger.dataset.menuOpen = 'true';
      trigger.dataset.menuSurfaceOpen = '';
      trigger.dataset.menuCarriedNavigation = '';
      trigger.querySelectorAll('.header-menu__link').forEach((link) => { link.style.opacity = '1'; link.style.setProperty('--menu-link-duration', '0s'); link.style.setProperty('--menu-link-delay', '0s'); });
    });
    if (carriedMenus.length) { root.style.setProperty('--header-menu-surface-duration', '0s'); root.style.setProperty('--header-menu-surface-delay', '0s'); }
    const start = document.querySelector('.header-trigger--start');
    const home = start?.querySelector('.header-trigger__wordmark--home');
    const page = start?.querySelector('.header-trigger__wordmark--page');
    if (!start || !home || !page) return;
    if (pending.targetTitle && pending.fromGeometry && pending.toGeometry && window.__vcdHeaderTitleBridge) {
      const bridge = window.__vcdHeaderTitleBridge(pending, false);
      if (bridge) {
        slot.__vcdTitleBridge = bridge;
        slot.dataset.headerCarriedNavigation = '';
        slot.dataset.headerNavigationTitle = pending.title;
        root.dataset.headerNavigation = '';
        window.addEventListener('pagereveal', (event) => {
          window.__vcdHeaderNavigationTransition = event.viewTransition?.finished ?? Promise.resolve();
        }, { once: true });
        return;
      }
    }
    const carriedTitle = pending.title.replace(/ /g, '\u00a0');
    const originalChars = home.__vcdOriginalHeaderChars ??= [...home.querySelectorAll('.header-trigger__char')];
    if (!originalChars[0]) return;
    const pendingMargins = Array.isArray(pending.margins) && pending.margins.length === [...carriedTitle].length &&
      pending.margins.every((margin) => typeof margin === 'number' && Number.isFinite(margin) && Math.abs(margin) <= 1)
      ? pending.margins : null;
    home.replaceChildren(...[...carriedTitle].map((char, index) => {
      const span = originalChars[0].cloneNode(false);
      span.className = 'header-trigger__char';
      span.textContent = char;
      span.style.setProperty('--char-duration', '0s');
      span.style.setProperty('--char-delay', '0s');
      span.style.setProperty('--char-blur', '0px');
      if (pendingMargins) span.style.marginLeft = `${pendingMargins[index]}em`;
      return span;
    }));
    home.setAttribute('aria-hidden', 'false');
    page.setAttribute('aria-hidden', 'true');
    home.querySelectorAll('.header-trigger__char').forEach((char) => { char.style.setProperty('--char-duration', '0s'); char.style.setProperty('--char-delay', '0s'); char.style.opacity = '1'; });
    page.querySelectorAll('.header-trigger__char').forEach((char) => { char.style.setProperty('--char-duration', '0s'); char.style.setProperty('--char-delay', '0s'); char.style.opacity = '0'; });
    start.classList.add('is-wordmark-swapped');
    slot.dataset.headerCarriedNavigation = '';
    slot.dataset.headerNavigationTitle = pending.title;
    root.dataset.headerNavigation = '';
    if (pending.title.replace(/\s+/g, ' ').trim() === page.textContent?.replace(/\s+/g, ' ').trim()) {
      slot.dataset.headerNavigationSame = '';
    }
    window.addEventListener('pagereveal', (event) => {
      window.__vcdHeaderNavigationTransition = event.viewTransition?.finished ?? Promise.resolve();
    }, { once: true });
  })();
</script>

<script>
  // Touch / no-hover devices open the menu on tap instead of on hover.
  const tapModeMq = window.matchMedia('(hover: none), (pointer: coarse)');
  const isTapMode = () => tapModeMq.matches;
  const isDevEditing = () => document.documentElement.classList.contains('is-dev-mode');
  const adaptivePageColumnsEnabled = document.documentElement.hasAttribute('data-adaptive-page-columns');

  const header = document.querySelector('.site-header');
  const headerSlot = document.querySelector('.site-header-slot');
  const menuSurfaceRoot = header?.closest<HTMLElement>('#site-wrapper') ?? document.documentElement;

  const setMenuSurfaceTiming = (
    duration: number,
    delay = 0,
    easing = 'cubic-bezier(0.22, 1, 0.36, 1)',
  ) => {
    menuSurfaceRoot.style.setProperty('--header-menu-surface-duration', `${duration}s`);
    menuSurfaceRoot.style.setProperty('--header-menu-surface-delay', `${delay}s`);
    menuSurfaceRoot.style.setProperty('--header-menu-surface-easing', easing);
  };

  const syncMenuSurfaceInlineSize = (trigger: HTMLElement) => {
    // The panel keeps the wider brand/menu hover corridor; only its painted
    // background follows the menu's intrinsic width.
    const menu = trigger.querySelector<HTMLElement>('.header-menu');
    const panel = trigger.querySelector<HTMLElement>('.header-trigger__panel');
    if (!menu || !panel) return;
    trigger.style.setProperty(
      '--header-menu-inline-size',
      `${menu.getBoundingClientRect().width}px`,
    );
    const panelRect = panel.getBoundingClientRect();
    const outerSpace = trigger.classList.contains('header-trigger--end')
      ? document.documentElement.clientWidth - panelRect.right
      : panelRect.left;
    trigger.style.setProperty('--header-menu-outer-space', `${Math.max(0, outerSpace)}px`);
    trigger.style.setProperty('--header-menu-viewport-size', `${document.documentElement.clientWidth}px`);
  };

  // Latched when a downward scroll closes the menu, and released once the
  // pointer is off the header. Two jobs: it stops the still-:hover-ing cursor
  // from re-opening the menu it just closed, and it HOLDS the header in the
  // mode it was in — docked stays docked, which is what keeps the close from
  // handing the header straight to the dock/ride flap. It must not stand in
  // for "the menu is closed": making isMenuOpen() lie is what let the header
  // ride away mid-close. Hover-only — in tap mode there is no pointer to wait
  // on, so it is never latched there (it would freeze the header forever).
  // Declared at script scope so both the scroll handler and the menu
  // listeners see it.
  let menuScrollClosed = false;

  if (header) {
    const REVEAL_PX = 4; // cumulative up-scroll before the docked fade-in

    let lastY = window.scrollY;
    let trend: 'up' | 'down' | null = null;
    let anchorY = window.scrollY;
    // 'flow' | 'docked' | 'riding' — riding = absolute at the spot it was
    // released, scrolling away with the page until it docks or reaches home.
    let mode: 'flow' | 'docked' | 'riding' = 'flow';
    const headerChromeHeight = () => {
      const value = Number.parseFloat(getComputedStyle(header).getPropertyValue('--header-chrome-height'));
      return Number.isFinite(value) && value >= 0 ? value : 100;
    };
    const logicalHeaderRect = () => {
      const rect = header.getBoundingClientRect();
      const extension = headerChromeHeight();
      return {
        top: rect.top + extension,
        bottom: rect.bottom,
        height: Math.max(0, rect.height - extension),
        left: rect.left,
        width: rect.width,
      };
    };
    let headerHeight = Math.max(0, header.offsetHeight - headerChromeHeight());
    let viewportWidth = document.documentElement.clientWidth;
    let ticking = false;
    let updateFrame: number | null = null;
    let offscreenTimer: ReturnType<typeof setTimeout> | null = null;
    let mobileHeader = false;

    const isSectionReorderDragging = () =>
      document.documentElement.classList.contains('is-section-reorder-dragging');

    const isMenuOpen = () => header.matches(':has(.header-trigger.is-menu-open)');

    // Whether the pointer or the keyboard is actually ON the header. This, not
    // the is-menu-open class, is what may hold the header still. The class
    // outlives the visual close by the whole close animation (~0.5s), so a
    // hold gated on the class alone can be latched after the pointer has
    // already left — and since mouseleave has by then fired for the last time,
    // nothing would ever release it and the header stays docked for good.
    // Reading it live means the hold cannot outlive the interaction. Tap
    // devices have no hover to read, so there the menu being open is the whole
    // story.
    const isHeaderEngaged = () =>
      isTapMode() ||
      !!header.querySelector('.header-trigger:hover') ||
      header.contains(document.activeElement);

    // The slot claims the header's flow height no matter where the header
    // itself is (flow / fixed / absolute), so the page below never jumps.
    const syncSlot = () => {
      headerHeight = Math.max(0, header.offsetHeight - headerChromeHeight());
      if (headerSlot instanceof HTMLElement) {
        headerSlot.style.height = `${headerHeight}px`;
      }
    };
    syncSlot();

    // Horizontal geometry for the out-of-flow modes. The always-in-flow slot
    // is the only safe measure — never read the positioned header, or the
    // width compounds. A fixed header with unset left/right shrink-wraps to
    // its content; this pins the box to the slot's current x/width. Recapture
    // at apply time so a scrollbar that appears after first paint (images,
    // fonts) cannot leave a stale wider dock. rect.left is already
    // viewport-relative, which is exactly what fixed positioning wants — do
    // NOT add scrollX (that double-counts the gutter and shoves it right).
    let geoLeft = 0;
    let geoWidth = 0;
    const captureGeo = () => {
      if (!(headerSlot instanceof HTMLElement)) return;
      const rect = headerSlot.getBoundingClientRect();
      geoLeft = rect.left;
      geoWidth = rect.width;
    };
    // Capture synchronously to guard the gap before the font recapture can run.
    captureGeo();
    void document.fonts?.ready.then(() => captureGeo());
    document.fonts?.addEventListener('loadingdone', () => captureGeo());

    const applyGeo = () => {
      captureGeo();
      header.style.left = `${geoLeft}px`;
      header.style.width = `${geoWidth}px`;
    };

    const clearGeo = () => {
      header.style.removeProperty('left');
      header.style.removeProperty('width');
    };

    const setMode = (next: 'flow' | 'docked' | 'riding', fade = false, slide = false) => {
      if (mode === next) return;
      // Capture the offset BEFORE switching modes, so the slide starts from
      // exactly where the header is visually sitting. Works from riding
      // (absolute) or from a partially-scrolled-out flow position.
      const slideFrom = slide ? Math.max(0, -logicalHeaderRect().top) : null;
      if (offscreenTimer !== null) {
        clearTimeout(offscreenTimer);
        offscreenTimer = null;
      }
      header.classList.remove('is-scrolled-hidden');
      mode = next;
      header.classList.toggle('is-docked', mode === 'docked');
      header.classList.toggle('is-riding', mode === 'riding');
      header.style.transition = '';
      header.style.opacity = '';
      header.style.pointerEvents = '';
      header.style.transform = '';
      if (mode === 'docked') {
        // Fixed at the viewport top, box pinned to its flow x/width.
        header.style.top = `${-headerChromeHeight()}px`;
        if (window.innerWidth <= 767) {
          header.style.left = '0';
          header.style.width = '100%';
        } else {
          applyGeo();
        }
        if (slide && slideFrom !== null) {
          // Menu opened while partially hidden: dock (fixed, top 0) but start
          // translated UP by the off-screen amount, then ease the transform to
          // 0 so it slides down into place. A transition on `top` can't run
          // across a position swap, so the slide has to be a transform.
          header.style.transition = 'none';
          header.style.transform = `translateY(${-slideFrom}px)`;
          // Commit the start value with a forced reflow rather than a rAF. The
          // slide is triggered by the menu opening, i.e. from a pointer/focus
          // handler — a rAF scheduled there lands in the SAME style recalc as
          // the handler, so start and end transforms coalesce and nothing
          // animates. Reading offsetHeight flushes layout, so the start value
          // is real before the transition is armed.
          void header.offsetHeight;
          header.style.transition = 'transform 0.3s ease';
          header.style.transform = 'translateY(0)';
        } else if (fade) {
          // Reveal from fully off-screen: fade in at full height. Docking
          // while partly visible is instant — it just stops scrolling away.
          header.style.transition = 'none';
          header.style.opacity = '0';
          requestAnimationFrame(() => {
            header.style.transition = '';
            header.style.opacity = '1';
          });
        }
      } else if (mode === 'riding') {
        // Absolute at the current visual spot: rides away with the page.
        // Absolute positions against the slot (position: relative), which is
        // ALREADY at the correct x-offset in the content column — so left must
        // be 0, not the viewport-relative geoLeft (that would double-count the
        // gutter and shove it right). Width 100% tracks the slot live, so a
        // later scrollbar cannot leave a stale pixel width.
        header.style.top = `${window.scrollY - headerChromeHeight()}px`;
        header.style.left = '0';
        header.style.width = '100%';
      } else {
        header.style.top = '';
        clearGeo();
      }
    };

    const syncMobileHeaderMode = () => {
      const isMobile = window.innerWidth <= 767;
      if (isMobile) {
        if (updateFrame !== null) {
          cancelAnimationFrame(updateFrame);
          updateFrame = null;
          ticking = false;
        }
        if (offscreenTimer !== null) {
          clearTimeout(offscreenTimer);
          offscreenTimer = null;
        }
        if (mode !== 'docked') setMode('docked');
        header.classList.remove('is-scrolled-hidden');
        header.style.opacity = '';
        header.style.pointerEvents = '';
        header.style.transform = '';
      } else if (mobileHeader) {
        if (mode !== 'flow') setMode('flow');
        header.classList.remove('is-scrolled-hidden');
      }
      mobileHeader = isMobile;
    };

    // Opening a menu or navigating with a partly visible header uses the
    // same docking slide; neither interaction requires a scroll frame.
    document.addEventListener('header:navigation-start', () => {
      const rect = logicalHeaderRect();
      if (rect.top < 0 && rect.bottom > 0 && document.documentElement.hasAttribute('data-header-navigation')) {
        setMode('docked', false, true);
      }
    });

    header.addEventListener('header:trigger-open', () => {
      // Riding is always at or above the viewport top (it docks the moment its
      // top comes back down to 0), so both cases are "not fully in place".
      if (mode === 'riding' || logicalHeaderRect().top < 0) {
        setMode('docked', false, true);
      }
    });

    // The header row spans whatever block it is currently over, so the wordmark
    // and logo line up with the content behind them instead of with one
    // page-wide column. Measured from the rendered block, which already
    // accounts for the text vs media caps, constrained percentages and narrow
    // viewports — none of that is re-derived here.
    //
    // No feedback loop: a block's width comes from the column and its own cap,
    // never from the header row. The server-rendered --page-header-width (the
    // first block, from pageColumnStyle) is the pre-JS value this replaces.
    const BLOCK_SELECTOR = '.project-block, .project-image, .project-image-grid, .project-image-carousel';
    const siteWrapper = document.querySelector<HTMLElement>('#site-wrapper');
    let appliedHeaderWidthPx = 0;

    /** Commit width only while fully off-screen; the next fade masks the swap. */
    const syncHeaderWidth = (probeEdge: number, initialize = false) => {
      if (!adaptivePageColumnsEnabled || !siteWrapper) return;
      const headerRect = logicalHeaderRect();
      if (!initialize && (mode !== 'flow' || headerRect.bottom > 0)) return;

      const blocks = Array.from(document.querySelectorAll<HTMLElement>(BLOCK_SELECTOR)).filter(
        (block) => !block.closest('.component-preview'),
      );
      if (!blocks.length) return;

      // Keep a short first text block in charge of the gap until its successor reaches the probe edge.
      const firstBlock = blocks[0];
      const nextBlock = blocks[1];
      const firstTextStillLeads = firstBlock.matches('.project-block--text') &&
        (!nextBlock || nextBlock.getBoundingClientRect().top > probeEdge);
      let current = firstBlock;
      if (!firstTextStillLeads) {
        for (const block of blocks) {
          current = block;
          if (block.getBoundingClientRect().bottom > probeEdge) break;
        }
      }

      const widthPx = Math.round(current.getBoundingClientRect().width);
      if (widthPx === appliedHeaderWidthPx) return;
      // Only the page's first text block may return the header to its narrower width.
      const isFirstTextBlock = current === firstBlock && current.matches('.project-block--text');
      if (appliedHeaderWidthPx > 0 && widthPx < appliedHeaderWidthPx && !isFirstTextBlock) return;

      appliedHeaderWidthPx = widthPx;
      siteWrapper.style.setProperty('--page-header-width', `${widthPx}px`);
    };

    const update = () => {
      updateFrame = null;
      const y = window.scrollY;
      document.documentElement.classList.toggle('is-page-top', y <= 8);
      if (window.innerWidth <= 767) {
        syncMobileHeaderMode();
        lastY = y;
        ticking = false;
        return;
      }
      const headerRect = logicalHeaderRect();
      // Once the flow header is fully off-screen, keep its next reveal width
      // current using the docked footprint. Never write while it is visible.
      if (mode === 'flow' && headerRect.bottom <= 0) {
        syncHeaderWidth(headerHeight);
      }

      document.documentElement.classList.toggle('is-page-top', y <= 8);

      if (isSectionReorderDragging()) {
        // At the page top the in-flow header stays visible; deep, hide it so
        // auto-scroll during the drag doesn't leave a stale bar on screen.
        header.classList.toggle('is-scrolled-hidden', y > 8);
        trend = null;
        lastY = y;
        ticking = false;
        return;
      }

      const headerEngaged = isHeaderEngaged();
      // Belt and braces: the latch can't survive the pointer leaving, however
      // it got set. mouseleave clears it too, but only when it actually fires.
      if (!headerEngaged) menuScrollClosed = false;

      const menuOpen = isMenuOpen();
      if (headerEngaged && (menuOpen || menuScrollClosed)) {
        // A real downward scroll closes the menu, once, with its normal close
        // animation (not the instant force-close). Latching first means the
        // next frames don't re-dispatch the close and restart its stagger.
        if (menuOpen && !menuScrollClosed && y > lastY + 1) {
          // Tap mode never latches: there's no pointer to release it, so the
          // hold below would never end and the header would freeze docked.
          menuScrollClosed = !isTapMode();
          document.querySelectorAll<HTMLElement>('.header-trigger.is-menu-open').forEach((t) => {
            t.dispatchEvent(new CustomEvent('header:request-close'));
          });
        }
        // Freeze the mode while the pointer is on the header and the menu is
        // open or just scroll-closed: docked STAYS docked (closing the menu is
        // not a reason to undock — it rides away on a later scroll, once the
        // pointer is off it), and a header still in flow at the page top keeps
        // scrolling away natively. Docking on open is the trigger-open
        // listener's job, so there's nothing to decide here.
        header.classList.remove('is-scrolled-hidden');
        trend = null;
        lastY = y;
        ticking = false;
        return;
      }

      // Genuine direction reversal resets the anchor, so cumulative distance is
      // measured from the turning point — a frame-to-frame delta never crosses
      // the threshold on a slow scroll (~1-2px/frame).
      if (y > lastY && trend !== 'down') {
        trend = 'down';
        anchorY = lastY;
      } else if (y < lastY && trend !== 'up') {
        trend = 'up';
        anchorY = lastY;
      }

      if (mode === 'docked') {
        // Reached the very top with upward momentum: hand back to flow so the
        // header springs with the page's rubber-band instead of staying pinned.
        if (y <= 0) {
          setMode('flow');
          trend = null;
          anchorY = y;
        } else if (y > anchorY) {
          // No threshold: the instant you scroll down from docked, it rides —
          // any dead-zone reads as the header catching on a few pixels late.
          // Release at the current spot: absolute at scrollY, so it scrolls
          // away with the page from the top edge; fade after it leaves the viewport.
          setMode('riding');
          trend = 'down';
          anchorY = y;
        }
      } else if (mode === 'riding') {
        const rect = logicalHeaderRect();
        if (trend === 'up' && rect.top >= 0) {
          // Rode back down and its top reached the viewport top: dock, no fade.
          setMode('docked');
        } else if (rect.bottom <= 0) {
          if (trend === 'up' && anchorY - y > REVEAL_PX) {
            setMode('docked', true);
          } else if (offscreenTimer === null) {
            // Safari can paint above the viewport: finish fading before relocating.
            header.style.transition = '';
            header.style.opacity = '';
            header.classList.add('is-scrolled-hidden');
            offscreenTimer = setTimeout(() => {
              offscreenTimer = null;
              if (mode === 'riding' && logicalHeaderRect().bottom <= 0) {
                setMode('flow');
                header.classList.add('is-scrolled-hidden');
              }
            }, 350);
          }
        } else {
          if (offscreenTimer !== null) clearTimeout(offscreenTimer);
          offscreenTimer = null;
          header.classList.remove('is-scrolled-hidden');
        }
      } else if (trend === 'up' && anchorY - y > REVEAL_PX) {
        const rect = logicalHeaderRect();
        if (rect.bottom <= 0 && y > headerHeight) {
          // Fully off-screen: dock + fade in at full height. Small threshold
          // stays here so a stray 1px nudge deep in the page doesn't flash it.
          // Final same-frame sync before docking. The fade then reveals the
          // already-correct row; there is no visible width transition.
          syncHeaderWidth(headerHeight);
          setMode('docked', true);
        }
        // Partly visible and scrolling up: leave it in flow — it rides down
        // with the page natively. It only docks once it has fully left and
        // come back via a ride (handled in the riding branch), so there's no
        // teleport-to-top jump.
      }

      if (mode !== 'riding') {
        header.classList.toggle('is-scrolled-hidden', mode === 'flow' && logicalHeaderRect().bottom <= 0);
      }

      lastY = y;
      ticking = false;
    };

    document.documentElement.classList.toggle('is-page-top', window.scrollY <= 8);

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          updateFrame = requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    // Sections added or removed while authoring — dispatched by DevPageColumn.
    document.addEventListener('vcd:page-column-changed', () => {
      syncHeaderWidth(headerHeight);
    });

    void document.fonts?.ready.then(() => syncHeaderWidth(headerHeight));
    syncMobileHeaderMode();
    syncSlot();
    captureGeo();
    syncHeaderWidth(logicalHeaderRect().bottom, true);

    window.addEventListener('resize', () => {
      const nextViewportWidth = document.documentElement.clientWidth;
      if (nextViewportWidth === viewportWidth) return;
      viewportWidth = nextViewportWidth;
      syncMobileHeaderMode();
      syncHeaderWidth(headerHeight);
      syncSlot();
      document
        .querySelectorAll<HTMLElement>('.header-trigger')
        .forEach(syncMenuSurfaceInlineSize);
      // Height-only resizes (including Safari's address-bar movement) keep the
      // current scroll mode and vertical geometry. Width changes can update the
      // clean in-flow measurement without swapping riding/docked positions.
      captureGeo();
      if (mode === 'docked') {
        if (window.innerWidth <= 767) {
          header.style.left = '0';
          header.style.width = '100%';
        } else {
          applyGeo();
        }
      }
      else if (mode === 'riding') {
        header.style.left = '0';
        header.style.width = '100%';
      }
    });
  }

  /** Instant reset — used on pagehide / bfcache restore so open menu state isn't frozen. */
  const forceCloseMenus = (preserveNavigation = false) => {
    if (preserveNavigation && document.documentElement.hasAttribute('data-header-navigation')) return;
    menuScrollClosed = false;
    const active = document.activeElement;
    if (active instanceof HTMLElement && active.closest('.site-header--nav-menu')) {
      active.blur();
    }

    setMenuSurfaceTiming(0);

    document.querySelectorAll<HTMLElement>('.header-trigger').forEach((trigger) => {
      const links = [...trigger.querySelectorAll<HTMLElement>('.header-menu__link')];
      if (trigger.dataset.menuCloseTimer) {
        clearTimeout(Number(trigger.dataset.menuCloseTimer));
        delete trigger.dataset.menuCloseTimer;
      }
      trigger.classList.remove('is-menu-open');
      delete trigger.dataset.menuOpen;
      delete trigger.dataset.menuSurfaceOpen;
      links.forEach((link) => {
        link.style.setProperty('--menu-link-delay', '0s');
        link.style.setProperty('--menu-link-duration', '0s');
        link.style.opacity = '0';
      });
    });

    document.dispatchEvent(new CustomEvent('header:force-close', { detail: { preserveNavigation } }));
  };

  document.querySelectorAll<HTMLElement>('.header-trigger').forEach((trigger) => {
    const links = [...trigger.querySelectorAll<HTMLElement>('.header-menu__link')];
    const panelBg = trigger.querySelector('.header-trigger__panel-bg') as HTMLElement | null;
    if (!links.length || !panelBg) return;

    syncMenuSurfaceInlineSize(trigger);
    void document.fonts?.ready.then(() => syncMenuSurfaceInlineSize(trigger));

    const MENU_SURFACE_ORIGINAL_DURATION = 0.48;
    const MENU_LINK_ORIGINAL_DURATION = 0.3;
    const MENU_LINK_ORIGINAL_FIRST_DELAY = 0.06;
    const MENU_LINK_ORIGINAL_STAGGER = 0.08;
    const MENU_TIMELINE_OPEN_DURATION = 0.25;
    const MENU_TIMELINE_CLOSE_DURATION = 0.18;
    const MENU_SURFACE_ENTRY_EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const MENU_SURFACE_EXIT_EASING = 'cubic-bezier(0.64, 0, 0.78, 0)';
    const MENU_LINK_ENTRY_EASING = 'ease';
    const MENU_LINK_EXIT_EASING = 'cubic-bezier(0.75, 0, 0.75, 0.9)';
    const timelineEnd = Math.max(
      MENU_SURFACE_ORIGINAL_DURATION,
      MENU_LINK_ORIGINAL_FIRST_DELAY +
        Math.max(links.length - 1, 0) * MENU_LINK_ORIGINAL_STAGGER +
        MENU_LINK_ORIGINAL_DURATION,
    );
    const openScale = MENU_TIMELINE_OPEN_DURATION / timelineEnd;
    const closeScale = MENU_TIMELINE_CLOSE_DURATION / timelineEnd;
    const closeLayoutMs = Math.ceil(MENU_TIMELINE_CLOSE_DURATION * 1000) + 32;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    let navigationClosing = false;
    let navigationOutgoing = false;

    const clearCloseTimer = () => {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = undefined;
      delete trigger.dataset.menuCloseTimer;
    };

    const setMenuSurface = (open: boolean) => {
      if (open) {
        setMenuSurfaceTiming(
          MENU_SURFACE_ORIGINAL_DURATION * openScale,
          0,
          MENU_SURFACE_ENTRY_EASING,
        );
        delete trigger.dataset.menuSurfaceOpen;
        void panelBg.offsetHeight;
        trigger.dataset.menuSurfaceOpen = '';
      } else {
        setMenuSurfaceTiming(
          MENU_SURFACE_ORIGINAL_DURATION * closeScale,
          (timelineEnd - MENU_SURFACE_ORIGINAL_DURATION) * closeScale,
          MENU_SURFACE_EXIT_EASING,
        );
        delete trigger.dataset.menuSurfaceOpen;
      }
    };

    const setOpenStagger = () => {
      links.forEach((link, i) => {
        link.style.setProperty(
          '--menu-link-delay',
          `${(MENU_LINK_ORIGINAL_FIRST_DELAY + i * MENU_LINK_ORIGINAL_STAGGER) * openScale}s`,
        );
        link.style.setProperty('--menu-link-duration', `${MENU_LINK_ORIGINAL_DURATION * openScale}s`);
        link.style.setProperty('--menu-link-easing', MENU_LINK_ENTRY_EASING);
        link.style.opacity = '1';
      });
    };

    const setCloseStagger = () => {
      links.forEach((link, i) => {
        const originalDelay = MENU_LINK_ORIGINAL_FIRST_DELAY + i * MENU_LINK_ORIGINAL_STAGGER;
        link.style.setProperty(
          '--menu-link-delay',
          `${Math.max(0, timelineEnd - (originalDelay + MENU_LINK_ORIGINAL_DURATION)) * closeScale}s`,
        );
        link.style.setProperty('--menu-link-duration', `${MENU_LINK_ORIGINAL_DURATION * closeScale}s`);
        link.style.setProperty('--menu-link-easing', MENU_LINK_EXIT_EASING);
        link.style.opacity = '0';
      });
    };

    const isOpen = () => trigger.dataset.menuOpen === 'true';
    const previewSide = trigger.classList.contains('header-trigger--end') ? 'end' : 'start';
    let previewPinned = false;

    const openMenu = (event?: Event) => {
      if (navigationClosing || isOpen()) return;
      if (isDevEditing() && trigger.classList.contains('header-trigger--start')) return;
      if (import.meta.env.DEV) {
        const pinnedSide = document.documentElement.dataset.headerSurfacePreview;
        if (pinnedSide && pinnedSide !== previewSide) return;
      }

      // If a higher layer (e.g. page-top gap chips) is under the pointer, don't expand.
      if (event instanceof MouseEvent) {
        document.dispatchEvent(
          new CustomEvent('dev:sync-gap-proximity', {
            detail: { clientX: event.clientX, clientY: event.clientY },
          }),
        );
        const hit = document.elementFromPoint(event.clientX, event.clientY);
        if (hit?.closest('.dev-gap-toolbar')) return;
      }

      clearCloseTimer();
      trigger.classList.add('is-menu-open');
      trigger.dataset.menuOpen = 'true';
      setOpenStagger();
      syncMenuSurfaceInlineSize(trigger);
      setMenuSurface(true);
      // Bubbles: the scroll state machine listens on .site-header to dock the
      // header when the menu opens. The per-trigger listeners are on the
      // target itself, so they're unaffected.
      trigger.dispatchEvent(new CustomEvent('header:trigger-open', { bubbles: true }));
    };

    /**
     * @param force Bypass the :hover gate on removing `is-menu-open`. A
     *   scroll-close happens with the cursor still parked on the trigger, so
     *   the normal gate would leave the class on forever — the class then
     *   reads as "open" on later frames and flaps the header's mode. Focus is
     *   still honoured by the interaction-specific close guards below.
     */
    const closeMenu = (force = false) => {
      if (previewPinned || navigationOutgoing) return;
      if (!isOpen()) return;
      delete trigger.dataset.menuOpen;
      setCloseStagger();
      setMenuSurface(false);
      clearCloseTimer();
      closeTimer = setTimeout(() => {
        closeTimer = undefined;
        delete trigger.dataset.menuCloseTimer;
        if ((force || !trigger.matches(':hover')) && (navigationClosing || !trigger.contains(document.activeElement))) {
          trigger.classList.remove('is-menu-open');
        }
      }, closeLayoutMs);
      trigger.dataset.menuCloseTimer = String(closeTimer);
      trigger.dispatchEvent(new CustomEvent('header:trigger-close'));
    };

    if (import.meta.env.DEV) {
      document.addEventListener('vcd:header-surface-preview', ((event: CustomEvent<{ side?: 'start' | 'end' | null }>) => {
        const side = event.detail?.side ?? null;
        if (side === previewSide) {
          previewPinned = true;
          document.documentElement.dataset.headerSurfacePreview = side;
          openMenu();
        } else if (previewPinned || document.documentElement.dataset.headerSurfacePreview === previewSide) {
          previewPinned = false;
          if (document.documentElement.dataset.headerSurfacePreview === previewSide) {
            delete document.documentElement.dataset.headerSurfacePreview;
          }
          closeMenu(true);
        }
      }) as EventListener);
      document.addEventListener('header:force-close', () => {
        previewPinned = false;
        if (document.documentElement.dataset.headerSurfacePreview === previewSide) {
          delete document.documentElement.dataset.headerSurfacePreview;
        }
      });
    }

    document.addEventListener('header:force-close', () => {
      navigationClosing = false;
      navigationOutgoing = false;
    });

    if (trigger.dataset.menuCarriedNavigation !== undefined) {
      delete trigger.dataset.menuCarriedNavigation;
      navigationClosing = true;
      const finishCarriedClose = () => {
        if (!navigationClosing || navigationOutgoing) return;
        requestAnimationFrame(() => { if (navigationClosing && !navigationOutgoing) closeMenu(true); });
      };
      const revealOverlay = document.querySelector<HTMLElement>('#transition-overlay');
      if (revealOverlay?.dataset.vcdInitialReveal === 'complete' || !revealOverlay || revealOverlay.hidden) finishCarriedClose();
      else window.addEventListener('vcd:initial-reveal-complete', finishCarriedClose, { once: true });
    }

    // Tapping a link focuses it in some mobile browsers; ignore that focus so it
    // doesn't open the menu before the click handler can toggle it.
    let lastPointerDownAt = -Infinity;
    const isPointerDrivenFocus = () => performance.now() - lastPointerDownAt < 700;

    trigger.addEventListener('pointerdown', () => {
      lastPointerDownAt = performance.now();
    });

    document.addEventListener('header:navigation-start', (event) => {
      navigationClosing = true;
      navigationOutgoing = true;
      const pending = event.detail?.pending;
      if (pending && isOpen() && !pending.openMenus?.includes(previewSide)) pending.openMenus = [...(pending.openMenus || []), previewSide];
    });
    document.addEventListener('header:navigation-cancel', () => {
      navigationClosing = false;
      navigationOutgoing = false;
      if (isOpen() && !trigger.matches(':hover') && !trigger.contains(document.activeElement)) closeMenu(true);
    });

    trigger.addEventListener('mouseenter', (event) => {
      if (isTapMode()) return;
      if (menuScrollClosed) return;
      openMenu(event);
    });
    trigger.addEventListener('mouseleave', () => {
      if (previewPinned) return;
      if (isTapMode()) return;
      menuScrollClosed = false;
      const active = document.activeElement;
      if (active instanceof HTMLElement && trigger.contains(active)) {
        if (active.matches(':focus-visible')) return;
        active.blur();
      }
      closeMenu();
    });
    // Scroll-driven close: run the normal animated close, not the instant
    // force-close, so the menu fades/staggers out like a mouse-leave.
    trigger.addEventListener('header:request-close', () => {
      closeMenu(true);
    });
    trigger.addEventListener('focusin', () => {
      if (isTapMode() && isPointerDrivenFocus()) return;
      openMenu();
    });
    trigger.addEventListener('focusout', (event) => {
      if (!trigger.contains(event.relatedTarget as Node | null)) {
        if (!isTapMode() && trigger.matches(':hover')) return;
        closeMenu();
      }
    });

    // Tap mode: first tap opens, tap outside (or on the panel background) closes.
    // While open, the wordmark / logo works as the home link it looks like.
    // Capture phase: the page-transition script listens on the anchor itself and
    // bails on defaultPrevented, so we have to get in before it.
    trigger.addEventListener(
      'click',
      (event) => {
        if (!isTapMode()) return;
        if (isDevEditing() && trigger.classList.contains('header-trigger--start')) return;

        const target = event.target as Element | null;
        if (target?.closest('.header-menu__link')) return;

        if (!isOpen()) {
          event.preventDefault();
          openMenu();
          return;
        }

        if (target?.closest('.header-trigger__brand-link')) return;

        const active = document.activeElement;
        if (active instanceof HTMLElement && trigger.contains(active)) active.blur();
        closeMenu();
      },
      true,
    );

    document.addEventListener('click', (event) => {
      if (!isTapMode() || !isOpen()) return;
      if (trigger.contains(event.target as Node | null)) return;

      const active = document.activeElement;
      if (active instanceof HTMLElement && trigger.contains(active)) active.blur();
      closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      const active = document.activeElement;
      if (active instanceof HTMLElement && trigger.contains(active)) active.blur();
      closeMenu();
    });
  });

  // Switching between hover and tap (rotation, devtools emulation, external
  // pointer) leaves stale open state behind — reset it.
  tapModeMq.addEventListener('change', () => forceCloseMenus());

  // Reset menu state when the document is restored from bfcache.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) forceCloseMenus();
  });
  window.addEventListener('pagehide', () => {
    forceCloseMenus(true);
  });

  // Kerning for the split wordmark.
  //
  // Each letter sits in its own inline <span> so it can be animated on its own.
  // Chromium and Gecko usually shape straight through those boundaries so the
  // font's kerning survives; WebKit doesn't, and a char carrying a non-zero
  // margin can stop it anywhere. Rather than predict which of those applies —
  // it varies by engine and even by layout path — measure the word twice: once
  // as one unsplit text node (always fully shaped, so it's ground truth) and
  // once as the live spans, then feed the residual back as per-char margins.
  //
  // Self-correcting by construction: where the engine already kerns, the
  // residual is zero and nothing is written; where it doesn't, this supplies
  // exactly the advance it dropped. Applying a margin can itself change whether
  // the engine shapes across that boundary, so re-measure and settle rather
  // than trusting one pass. Everything comes from the loaded font, so there's
  // no per-pair table and it follows whatever the page name happens to be.
  const KERN_MAX_PASSES = 3;
  const KERN_TOLERANCE_PX = 0.02;

  /** Correctly-shaped left offset of every character, via one unsplit text node. */
  const measureShapedOffsets = (wordmark: HTMLElement, text: string) => {
    const style = getComputedStyle(wordmark);
    const probe = document.createElement('span');
    Object.assign(probe.style, {
      position: 'absolute',
      top: '-9999px',
      left: '0',
      visibility: 'hidden',
      whiteSpace: 'nowrap',
      fontFamily: style.fontFamily,
      fontSize: style.fontSize,
      fontWeight: style.fontWeight,
      fontStyle: style.fontStyle,
      fontKerning: style.fontKerning,
      fontFeatureSettings: style.fontFeatureSettings,
      letterSpacing: style.letterSpacing,
    });
    probe.textContent = text;
    document.body.appendChild(probe);

    const textNode = probe.firstChild;
    const origin = probe.getBoundingClientRect().left;
    const offsets: number[] = [];
    if (textNode) {
      for (let i = 0; i < text.length; i++) {
        const range = document.createRange();
        range.setStart(textNode, i);
        range.setEnd(textNode, i + 1);
        offsets.push(range.getBoundingClientRect().left - origin);
      }
    }
    probe.remove();
    return offsets;
  };

  const applyWordmarkKerning = () => {
    document.querySelectorAll<HTMLElement>('.header-trigger__wordmark').forEach((wordmark) => {
      const chars = [...wordmark.querySelectorAll<HTMLElement>('.header-trigger__char')];
      if (chars.length < 2) return;

      // An unrendered wordmark measures as zero and would poison every residual.
      if (!wordmark.getBoundingClientRect().width) return;

      const text = chars.map((char) => char.textContent ?? '').join('');
      const target = measureShapedOffsets(wordmark, text);
      // Range offsets are per code unit; a surrogate pair would desync them
      // from the per-character spans, so only proceed when they line up.
      if (target.length !== chars.length) return;

      const fontSize = parseFloat(getComputedStyle(wordmark).fontSize) || 1;
      // Read back in px — margins are written in em, so the inline style's own
      // number is the wrong unit to resume from on a re-run.
      const applied = chars.map((char) => parseFloat(getComputedStyle(char).marginLeft) || 0);

      for (let pass = 0; pass < KERN_MAX_PASSES; pass++) {
        const origin = wordmark.getBoundingClientRect().left;
        const residual = chars.map(
          (char, i) => target[i] - (char.getBoundingClientRect().left - origin),
        );
        // Margins accumulate down the line, so each char only needs the part of
        // its residual that its predecessor didn't already account for.
        let settled = true;
        for (let i = 1; i < chars.length; i++) {
          const correction = residual[i] - residual[i - 1];
          if (Math.abs(correction) < KERN_TOLERANCE_PX) continue;
          applied[i] += correction;
          settled = false;
        }
        if (settled) break;

        for (let i = 1; i < chars.length; i++) {
          // em so it survives a resize without re-measuring. Cleared rather than
          // set to 0 so an untouched boundary stays shapeable by the engine.
          chars[i].style.marginLeft = applied[i] ? `${applied[i] / fontSize}em` : '';
        }
      }
    });
  };

  // Metrics are only final once the real face is in — fallback measurements
  // would be corrected on swap anyway, so just wait.
  void document.fonts?.ready.then(applyWordmarkKerning);
  document.fonts?.addEventListener('loadingdone', applyWordmarkKerning);

  const startTrigger = document.querySelector('.header-trigger--start');
  const wordmarkStack = startTrigger?.querySelector('.header-trigger__wordmark-stack');

  if (startTrigger && wordmarkStack) {
    const pageWordmark = wordmarkStack.querySelector('.header-trigger__wordmark--page') as HTMLElement | null;
    const pageChars = [
      ...wordmarkStack.querySelectorAll<HTMLElement>('.header-trigger__wordmark--page .header-trigger__char'),
    ];
    const homeWordmarkEl = wordmarkStack.querySelector('.header-trigger__wordmark--home');
    let homeChars = [
      ...wordmarkStack.querySelectorAll<HTMLElement>('.header-trigger__wordmark--home .header-trigger__char'),
    ];

    const FADE_OUT_STAGGER = 0.03;
    const FADE_OUT_DURATION = 0.15;
    const FADE_IN_DURATION = 0.25;
    const FADE_IN_STAGGER_START = 0.04;
    const FADE_IN_STAGGER_END = 0.09;
    const BLUR_PX = 4;

    let wordmarkIsOpen = false;
    let navigationOutgoing = false;
    let wordmarkRunToken = 0;
    let wordmarkFadeInFrame: number | undefined;
    let navigationRestoreTimer: number | undefined;

    const invalidateWordmarkRun = () => {
      wordmarkRunToken += 1;
      if (navigationRestoreTimer !== undefined) {
        window.clearTimeout(navigationRestoreTimer);
        navigationRestoreTimer = undefined;
      }
      if (wordmarkFadeInFrame !== undefined) {
        cancelAnimationFrame(wordmarkFadeInFrame);
        wordmarkFadeInFrame = undefined;
      }
    };

    const setCharFadeOut = (chars: HTMLElement[], stagger: number, duration: number, baseDelay = 0) => {
      chars.forEach((char, i) => {
        char.style.setProperty('--char-delay', `${baseDelay + i * stagger}s`);
        char.style.setProperty('--char-duration', `${duration}s`);
        char.style.setProperty('--char-easing', 'ease');
        char.style.setProperty('--char-blur', `${BLUR_PX}px`);
        char.style.opacity = '0';
      });
    };

    const progressiveStaggerDelay = (
      index: number,
      total: number,
      staggerStart: number,
      staggerEnd: number,
    ) => {
      let delay = 0;

      for (let j = 0; j < index; j++) {
        const progress = total > 1 ? j / (total - 1) : 0;
        delay += staggerStart + progress * (staggerEnd - staggerStart);
      }

      return delay;
    };

    const applyWordmarkFadeIn = (chars: HTMLElement[], baseDelay = 0) => {
      // Snap to blurred/invisible, then fade + deblur into place (staggered)
      if (wordmarkFadeInFrame !== undefined) cancelAnimationFrame(wordmarkFadeInFrame);
      const runToken = wordmarkRunToken;
      chars.forEach((char) => {
        char.style.setProperty('--char-duration', '0s');
        char.style.setProperty('--char-delay', '0s');
        char.style.setProperty('--char-blur', `${BLUR_PX}px`);
        char.style.opacity = '0';
      });

      wordmarkFadeInFrame = requestAnimationFrame(() => {
        wordmarkFadeInFrame = undefined;
        if (runToken !== wordmarkRunToken) return;
        chars.forEach((char, i) => {
          const delay =
            baseDelay + progressiveStaggerDelay(i, chars.length, FADE_IN_STAGGER_START, FADE_IN_STAGGER_END);

          char.style.setProperty('--char-delay', `${delay}s`);
          char.style.setProperty('--char-duration', `${FADE_IN_DURATION}s`);
          char.style.setProperty('--char-easing', 'ease');
          char.style.setProperty('--char-blur', '0px');
          char.style.opacity = '1';
        });
      });
    };

    const getFadeOutEnd = (count: number) =>
      Math.max(0, (count - 1) * FADE_OUT_STAGGER + FADE_OUT_DURATION);

    const getFadeInEnd = (count: number, baseDelay: number) =>
      baseDelay +
      progressiveStaggerDelay(
        Math.max(0, count - 1),
        count,
        FADE_IN_STAGGER_START,
        FADE_IN_STAGGER_END,
      ) +
      FADE_IN_DURATION;

    const titleEntryEnd = Math.max(
      getFadeOutEnd(pageChars.length),
      getFadeInEnd(homeChars.length, 0),
    );
    const titleCloseScale = 0.18 / titleEntryEnd;

    const applyWordmarkOpen = () => {
      setCharFadeOut(pageChars, FADE_OUT_STAGGER, FADE_OUT_DURATION);
      applyWordmarkFadeIn(homeChars);

      pageWordmark?.setAttribute('aria-hidden', 'true');
      homeWordmarkEl?.setAttribute('aria-hidden', 'false');
    };

    const applyWordmarkClose = () => {
      homeChars.forEach((char, i) => {
        char.style.setProperty(
          '--char-delay',
          `${Math.max(0, titleEntryEnd - (progressiveStaggerDelay(i, homeChars.length, FADE_IN_STAGGER_START, FADE_IN_STAGGER_END) + FADE_IN_DURATION)) * titleCloseScale}s`,
        );
        char.style.setProperty('--char-duration', `${FADE_IN_DURATION * titleCloseScale}s`);
        char.style.setProperty('--char-easing', 'cubic-bezier(0.75, 0, 0.75, 0.9)');
        char.style.setProperty('--char-blur', `${BLUR_PX}px`);
        char.style.opacity = '0';
      });
      pageChars.forEach((char, i) => {
        char.style.setProperty(
          '--char-delay',
          `${Math.max(0, titleEntryEnd - (i * FADE_OUT_STAGGER + FADE_OUT_DURATION)) * titleCloseScale}s`,
        );
        char.style.setProperty('--char-duration', `${FADE_OUT_DURATION * titleCloseScale}s`);
        char.style.setProperty('--char-easing', 'cubic-bezier(0.75, 0, 0.75, 0.9)');
        char.style.setProperty('--char-blur', '0px');
        char.style.opacity = '1';
      });

      pageWordmark?.setAttribute('aria-hidden', 'false');
      homeWordmarkEl?.setAttribute('aria-hidden', 'true');
    };

    const restoreHomeWordmark = () => {
      if (!homeWordmarkEl) return;
      const homeState = homeWordmarkEl as HTMLElement & { __vcdOriginalHeaderChars?: HTMLElement[] };
      const originalChars = homeState.__vcdOriginalHeaderChars;
      if (!originalChars) return;
      homeWordmarkEl.replaceChildren(...originalChars);
      delete homeState.__vcdOriginalHeaderChars;
      homeChars = [...homeWordmarkEl.querySelectorAll<HTMLElement>('.header-trigger__char')];
      homeWordmarkEl.setAttribute('aria-hidden', 'true');
      homeChars.forEach((char) => {
        char.style.setProperty('--char-duration', '0s');
        char.style.setProperty('--char-delay', '0s');
        char.style.setProperty('--char-blur', '0px');
        char.style.opacity = '0';
      });
      applyWordmarkKerning();
    };

    const clearNavigationState = () => {
      document.documentElement.removeAttribute('data-header-navigation');
      headerSlot?.removeAttribute('data-header-carried-navigation');
      headerSlot?.removeAttribute('data-header-navigation-title');
      headerSlot?.removeAttribute('data-header-navigation-same');
    };
    const clearNavigationTitleState = () => {
      headerSlot?.removeAttribute('data-header-navigation-title');
      headerSlot?.removeAttribute('data-header-navigation-same');
    };

    const runNavigationTitleSwap = () => {
      const bridge = headerSlot?.__vcdTitleBridge as { cleanup: () => void; finishesAt: number } | undefined;
      if (bridge) {
        const token = wordmarkRunToken;
        const transitionFinished = (window as Window & { __vcdHeaderNavigationTransition?: Promise<unknown> }).__vcdHeaderNavigationTransition;
        const wait = Promise.all([document.fonts?.ready ?? Promise.resolve(), transitionFinished ?? Promise.resolve()]);
        void wait.then(() => new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())))).then(() => {
          if (token !== wordmarkRunToken || headerSlot?.__vcdTitleBridge !== bridge) return;
          navigationRestoreTimer = window.setTimeout(() => {
            navigationRestoreTimer = undefined;
            if (token !== wordmarkRunToken || headerSlot?.__vcdTitleBridge !== bridge) return;
            bridge.cleanup();
            delete headerSlot.__vcdTitleBridge;
            clearNavigationTitleState();
            startTrigger.classList.remove('is-wordmark-swapped');
          }, Math.max(0, bridge.finishesAt - Date.now()));
        });
        return;
      }
      if (!headerSlot?.dataset.headerNavigationTitle) return;
      const carriedTitle = headerSlot?.dataset.headerNavigationTitle?.replace(/ /g, '\u00a0');
      if (!carriedTitle || !pageWordmark || !homeWordmarkEl) return;
      const sameTitle = headerSlot?.dataset.headerNavigationSame !== undefined;
      const navigationToken = wordmarkRunToken;
      const startSwap = () => {
        if (navigationToken !== wordmarkRunToken || !headerSlot?.dataset.headerNavigationTitle) return;
        if (sameTitle) {
          restoreHomeWordmark();
          startTrigger.classList.remove('is-wordmark-swapped');
          pageWordmark.setAttribute('aria-hidden', 'false');
          pageChars.forEach((char) => { char.style.setProperty('--char-duration', '0s'); char.style.setProperty('--char-delay', '0s'); char.style.setProperty('--char-blur', '0px'); char.style.opacity = '1'; });
          clearNavigationTitleState();
          applyWordmarkKerning();
          return;
        }
        invalidateWordmarkRun();
        const runToken = wordmarkRunToken;
        wordmarkIsOpen = false;
        startTrigger.classList.add('is-wordmark-swapped');
        setCharFadeOut(homeChars, FADE_OUT_STAGGER, FADE_OUT_DURATION);
        applyWordmarkFadeIn(pageChars);
        pageWordmark.setAttribute('aria-hidden', 'false');
        homeWordmarkEl.setAttribute('aria-hidden', 'true');
        navigationRestoreTimer = window.setTimeout(() => {
          navigationRestoreTimer = undefined;
          if (runToken !== wordmarkRunToken) return;
          restoreHomeWordmark();
          clearNavigationTitleState();
          startTrigger.classList.remove('is-wordmark-swapped');
          applyWordmarkKerning();
        }, Math.ceil(Math.max(getFadeOutEnd(homeChars.length), getFadeInEnd(pageChars.length, 0)) * 1000) + 40);
      };
      const afterNativeTransition = () => {
        requestAnimationFrame(() => requestAnimationFrame(startSwap));
      };
      const transitionFinished = (window as Window & { __vcdHeaderNavigationTransition?: Promise<unknown> }).__vcdHeaderNavigationTransition;
      const fontsReady = document.fonts?.ready ?? Promise.resolve();
      void Promise.all([fontsReady, transitionFinished ?? Promise.resolve()]).then(afterNativeTransition, afterNativeTransition);
    };

    const runWordmarkOpen = () => {
      invalidateWordmarkRun();
      wordmarkIsOpen = true;
      startTrigger.classList.add('is-wordmark-swapped');
      applyWordmarkOpen();
    };

    const runWordmarkClose = () => {
      invalidateWordmarkRun();
      const runToken = wordmarkRunToken;
      wordmarkIsOpen = false;
      applyWordmarkClose();
      window.setTimeout(() => {
        if (runToken !== wordmarkRunToken || navigationOutgoing) return;
        startTrigger.classList.remove('is-wordmark-swapped');
      }, 180 + 32);
    };

    const onWordmarkPointerActive = () => {
      if (isDevEditing()) return;
      if (navigationOutgoing) return;
      if (startTrigger.dataset.headerTitleSwap !== 'true') return;
      if (headerSlot?.__vcdTitleBridge) {
        headerSlot.__vcdTitleBridge.cleanup();
        delete headerSlot.__vcdTitleBridge;
      }
      if (headerSlot?.dataset.headerNavigationTitle) {
        invalidateWordmarkRun();
        restoreHomeWordmark();
        clearNavigationTitleState();
      }
      if (!wordmarkIsOpen) runWordmarkOpen();
    };

    const onWordmarkPointerInactive = () => {
      if (navigationOutgoing) return;
      if (wordmarkIsOpen) runWordmarkClose();
    };

    document.addEventListener('header:navigation-start', (event) => {
      navigationOutgoing = true;
      const pending = (event as CustomEvent<{ pending?: Record<string, unknown> }>).detail?.pending;
      if (!pending?.targetTitle || !window.__vcdHeaderTitleBridge) return;
      const bridge = window.__vcdHeaderTitleBridge(pending, true);
      if (bridge) {
        headerSlot.__vcdTitleBridge = bridge;
        document.documentElement.dataset.headerNavigation = '';
      }
    });
    document.addEventListener('header:navigation-cancel', () => {
      navigationOutgoing = false;
      if (headerSlot?.__vcdTitleBridge) {
        headerSlot.__vcdTitleBridge.cleanup();
        delete headerSlot.__vcdTitleBridge;
      }
    });

    startTrigger.addEventListener('mouseenter', onWordmarkPointerActive);
    startTrigger.addEventListener('focusin', onWordmarkPointerActive);
    startTrigger.addEventListener('mouseleave', onWordmarkPointerInactive);
    startTrigger.addEventListener('focusout', (event) => {
      if (!startTrigger.contains(event.relatedTarget as Node | null)) {
        onWordmarkPointerInactive();
      }
    });

    // Tap mode has no hover to follow — swap with the menu itself.
    startTrigger.addEventListener('header:trigger-open', onWordmarkPointerActive);
    startTrigger.addEventListener('header:trigger-close', onWordmarkPointerInactive);

    if (import.meta.env.DEV) {
      const startBrand = startTrigger.querySelector<HTMLAnchorElement>('.header-trigger__brand-link');
      const startBrandHref = startBrand?.getAttribute('href') ?? '';
      const syncStartBrandForEdit = (active: boolean) => {
        if (!startBrand) return;
        if (active) startBrand.removeAttribute('href');
        else if (startBrandHref) startBrand.setAttribute('href', startBrandHref);
      };
      syncStartBrandForEdit(isDevEditing());
      window.addEventListener('vcd:dev-mode-change', ((event: CustomEvent<{ active?: boolean }>) => {
        const active = Boolean(event.detail?.active);
        syncStartBrandForEdit(active);
        if (!active) return;
        startTrigger.dispatchEvent(new CustomEvent('header:request-close'));
        document.dispatchEvent(new CustomEvent('header:force-close'));
      }) as EventListener);
    }

    // Instant wordmark reset when menu force-closes (pagehide / bfcache).
    document.addEventListener('header:force-close', (event) => {
      const preserveNavigation = (event as CustomEvent<{ preserveNavigation?: boolean }>).detail?.preserveNavigation;
      if (preserveNavigation && navigationOutgoing) return;
      if (!preserveNavigation && headerSlot?.__vcdTitleBridge) {
        headerSlot.__vcdTitleBridge.cleanup();
        delete headerSlot.__vcdTitleBridge;
      }
      if (!preserveNavigation) navigationOutgoing = false;
      invalidateWordmarkRun();
      wordmarkIsOpen = false;
      startTrigger.classList.remove('is-wordmark-swapped');
      pageChars.forEach((char) => {
        char.style.setProperty('--char-duration', '0s');
        char.style.setProperty('--char-delay', '0s');
        char.style.setProperty('--char-blur', '0px');
        char.style.opacity = '1';
      });
      homeChars.forEach((char) => {
        char.style.setProperty('--char-duration', '0s');
        char.style.setProperty('--char-delay', '0s');
        char.style.setProperty('--char-blur', '0px');
        char.style.opacity = '0';
      });
      pageWordmark?.setAttribute('aria-hidden', 'false');
      homeWordmarkEl?.setAttribute('aria-hidden', 'true');
      restoreHomeWordmark();
      if (!preserveNavigation) clearNavigationState();
    });

    window.addEventListener('vcd:initial-reveal-complete', () => {
      document.documentElement.removeAttribute('data-header-navigation');
    }, { once: true });
    runNavigationTitleSwap();
  }

  const currentPageLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-current-page]'),
  ];
  const currentPageNotes = [
    ...document.querySelectorAll<HTMLElement>('[data-current-page-note]'),
  ];
  const currentPageItems = currentPageLinks
    .map((link) => link.closest<HTMLElement>('.header-menu__item'))
    .filter((item): item is HTMLElement => Boolean(item));
  const reduceMotionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
  const currentPageStorageKey = 'vcd:header-current-page-message-complete';
  let currentPageClickCount = 0;
  let suppressNextCurrentPageClick = false;
  let completionStored = false;
  try {
    completionStored = window.localStorage.getItem(currentPageStorageKey) === 'true';
  } catch {
    completionStored = false;
  }
  const storySequence = completionStored ? 'returning' : 'main';
  const trackingWindow = window as Window & {
    __vcdHeaderStoryStages?: Set<string>;
    umami?: { track?: (name: string, data: { sequence: string; stage: string }) => void | Promise<unknown> };
  };
  // This Set deduplicates within one document; Umami Visits provide cross-reload aggregation.
  const trackedStoryStages = trackingWindow.__vcdHeaderStoryStages ??= new Set<string>();
  const trackStoryStage = (stage: string) => {
    const script = document.querySelector<HTMLScriptElement>('script[data-website-id]');
    const domains = script?.dataset.domains?.split(/[\s,]+/).filter(Boolean) ?? [];
    const pathname = location.pathname.replace(/\/+$/, '') || '/';
    const track = trackingWindow.umami?.track;
    if (!script || typeof track !== 'function' || !domains.includes(location.hostname) || pathname === '/analytics' ||
      pathname === '/dev' || pathname.startsWith('/dev/')) return;
    try {
      if (window.localStorage.getItem('umami.disabled')) return;
    } catch {
      return;
    }
    const eventName = `header-story-${storySequence}-${stage}`;
    if (trackedStoryStages.has(eventName)) return;
    trackedStoryStages.add(eventName);
    try {
      const result = track.call(trackingWindow.umami, eventName, { sequence: storySequence, stage });
      if (result && typeof result.then === 'function') result.catch(() => {});
    } catch {
      // Analytics failures must not affect the header interaction.
    }
  };

  const messageForClick = (count: number) => {
    if (completionStored) return count === 2 ? 'ah, you again' : count === 3 ? 'welcome back' : null;
    return ({
      1: 'You are on this page', 2: 'You are on this page', 3: 'You are on this page',
      4: 'chill out', 5: 'bro can you read', 6: 'are you dumb?',
      7: "ahh, i see, you're curious", 8: 'how long this will go, right?',
      9: 'well just stop', 10: "i'm not playing", 11: 'seriously',
      12: "alright, that's it", 13: 'go on, click it again, see what happens',
    } as Record<number, string>)[count] ?? null;
  };

  let currentPageRemoved = false;
  let idleTimer: number | null = null;
  let idlePhase: 'none' | 'good-boy' | 'hey' = 'none';
  let needsResume = false;
  let readingReadyAt = 0;
  let pendingReveal = false;
  const now = () => performance.now();
  const storyIsLocked = () => pendingReveal || now() < readingReadyAt;
  const clearStoryLock = () => { pendingReveal = false; readingReadyAt = 0; };
  const noteTimers = new Map<HTMLElement, number>();
  const cancelAnimations = (element: HTMLElement) => element.getAnimations().forEach((animation) => animation.cancel());
  const animatePanelWidth = (trigger: HTMLElement, update: () => void, animate = true) => {
    const panelBg = trigger.querySelector<HTMLElement>('.header-trigger__panel-bg');
    const before = panelBg?.getBoundingClientRect().width ?? 0;
    // Only cancel the width FLIP; menu open/close owns the CSS surface transitions.
    panelBg?.getAnimations().filter((animation) => !(animation instanceof CSSTransition)).forEach((animation) => animation.cancel());
    update();
    if (!animate || !panelBg || reduceMotionMq.matches || before <= 0) return;
    const after = panelBg.getBoundingClientRect().width;
    if (after <= 0 || Math.abs(after - before) < 0.5) return;
    panelBg.animate([{ transform: `scaleX(${before / after})` }, { transform: 'scaleX(1)' }], {
      duration: 180, easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
    });
  };
  const cancelNote = (note: HTMLElement) => {
    clearTimeout(noteTimers.get(note));
    noteTimers.delete(note);
    cancelAnimations(note);
  };
  const cancelIdle = () => {
    if (idleTimer !== null) window.clearTimeout(idleTimer);
    idleTimer = null;
  };
  const menuIsOpen = () => currentPageNotes.some((note) => note.closest<HTMLElement>('.header-trigger')?.dataset.menuOpen === 'true');
  const showMessage = (text: string, weight = 400, animate = true, stage?: string) => currentPageNotes.forEach((note) => {
    note.setAttribute('aria-live', note.closest<HTMLElement>('.header-trigger')?.dataset.menuOpen === 'true' ? 'polite' : 'off');
    setNote(note, text, weight, animate, stage);
  });
  const stageForClick = (count: number) => {
    if (completionStored) return count === 2 ? 'again' : count === 3 ? 'welcome' : undefined;
    if (count === 1) return 'notice';
    if (count === 2) return 'notice-emphasis';
    if (count === 3) return 'notice-strong';
    return ({
      4: 'chill', 5: 'read', 6: 'hold', 7: 'curious', 8: 'how-long', 9: 'stop',
      10: 'not-playing', 11: 'seriously', 12: 'warning', 13: 'last-chance',
    } as Record<number, string>)[count];
  };
  const scheduleIdle = () => {
    cancelIdle();
    idleTimer = window.setTimeout(() => {
      idleTimer = null;
      if (!menuIsOpen() || currentPageRemoved) return;
      idlePhase = 'good-boy';
      showMessage("who's a good boy?", 400, true, 'idle-good-boy');
      idleTimer = window.setTimeout(() => {
        idleTimer = null;
        if (!menuIsOpen() || currentPageRemoved || idlePhase !== 'good-boy') return;
        currentPageNotes.forEach(hideCurrentPageNote);
        idleTimer = window.setTimeout(() => { idleTimer = null; idlePhase = 'none'; }, 100);
      }, 3100);
    }, 3100);
  };
  const setNote = (note: HTMLElement, text: string, weight: number, animate: boolean, stage?: string) => {
    const animateText = animate && !(note.classList.contains('is-visible') && note.textContent === text);
    cancelNote(note);
    const trigger = note.closest<HTMLElement>('.header-trigger');
    if (!trigger) return;
    const open = trigger.dataset.menuOpen === 'true';
    const reveal = () => {
      noteTimers.delete(note);
      const visible = trigger.dataset.menuOpen === 'true' && !document.hidden;
      animatePanelWidth(trigger, () => {
        note.textContent = text;
        note.style.fontWeight = String(weight);
        note.style.color = weight >= 900 ? 'var(--sys-color-link-soft-hover)' :
          weight >= 700 ? 'color-mix(in srgb, var(--sys-color-link-soft), var(--sys-color-link-soft-hover) 50%)' : '';
        note.classList.toggle('is-visible', open);
        note.setAttribute('aria-hidden', String(!open));
        syncMenuSurfaceInlineSize(trigger);
      }, animate);
      if (stage && visible) trackStoryStage(stage);
      if (stage && visible) {
        pendingReveal = false;
        readingReadyAt = now() + (animateText && open ? 150 : 0) + (text.length >= 25 ? 1500 : 1000);
      }
      if (animateText && open) note.animate([
        { opacity: 0, filter: reduceMotionMq.matches ? 'none' : 'blur(4px)' },
        { opacity: 0.48, filter: 'blur(0px)' },
      ], { duration: 150, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
    };
    if (animateText && open && note.classList.contains('is-visible')) {
      if (stage && open && !document.hidden) pendingReveal = true;
      note.animate([
        { opacity: 0.48, filter: 'blur(0px)' },
        { opacity: 0, filter: reduceMotionMq.matches ? 'none' : 'blur(4px)' },
      ], { duration: 100, easing: 'ease-out', fill: 'forwards' });
      noteTimers.set(note, window.setTimeout(() => { cancelAnimations(note); reveal(); }, 100));
    } else reveal();
  };
  const hideCurrentPageNote = (note: HTMLElement) => {
    cancelNote(note);
    note.setAttribute('aria-hidden', 'true');
    if (currentPageRemoved || !note.classList.contains('is-visible')) return;
    note.animate([
      { opacity: 0.48, filter: 'blur(0px)' },
      { opacity: 0, filter: reduceMotionMq.matches ? 'none' : 'blur(4px)' },
    ], { duration: 100, easing: 'ease-out', fill: 'forwards' });
    noteTimers.set(note, window.setTimeout(() => {
      cancelNote(note);
      const trigger = note.closest<HTMLElement>('.header-trigger');
      if (trigger) animatePanelWidth(trigger, () => {
        note.classList.remove('is-visible');
        syncMenuSurfaceInlineSize(trigger);
      });
      else note.classList.remove('is-visible');
    }, 100));
  };
  const removeCurrentPage = (focusFallback = false) => {
    cancelIdle();
    if (currentPageRemoved) return;
    const visible = menuIsOpen() && !document.hidden;
    currentPageRemoved = true;
    if (visible) trackStoryStage('completed');
    const active = document.activeElement;
    const focused = active instanceof HTMLElement && currentPageLinks.includes(active as HTMLAnchorElement);
    const activeTrigger = active instanceof HTMLElement ? active.closest<HTMLElement>('.header-trigger') : null;
    const fallback = activeTrigger?.querySelector<HTMLAnchorElement>('.header-menu__link:not([data-current-page])');
    currentPageNotes.forEach(cancelNote);
    currentPageItems.forEach((item) => {
      item.style.setProperty('--current-page-row-height', `${item.getBoundingClientRect().height}px`);
      item.classList.add('is-removing');
      item.setAttribute('inert', '');
      item.setAttribute('aria-hidden', 'true');
      item.animate([
        { opacity: 1, filter: 'blur(0px)' },
        { opacity: 0, filter: reduceMotionMq.matches ? 'none' : 'blur(4px)' },
      ], { duration: focusFallback ? 0 : 100, easing: 'ease-out', fill: 'forwards' });
    });
    if (focused && focusFallback) fallback?.focus();
    else if (focused && active instanceof HTMLElement) active.blur();
    try { window.localStorage.setItem(currentPageStorageKey, 'true'); } catch { /* Storage is optional; this visit still completes. */ }
    window.setTimeout(() => {
      currentPageItems.forEach((item) => {
        const trigger = item.closest<HTMLElement>('.header-trigger');
        const finish = () => {
          item.classList.remove('is-removing');
          item.classList.add('is-removed');
          cancelAnimations(item);
          if (trigger) syncMenuSurfaceInlineSize(trigger);
        };
        if (trigger) animatePanelWidth(trigger, finish, !focusFallback);
        else finish();
      });
    }, focusFallback ? 0 : 100);
  };

  const messageWeight = () => !completionStored && currentPageClickCount === 3 ? 900 :
    !completionStored && currentPageClickCount === 2 ? 700 : 400;
  const pauseMessages = () => {
    cancelIdle();
    if (idlePhase !== 'none') {
      idlePhase = 'none';
      currentPageClickCount = 10;
    }
    needsResume = currentPageClickCount >= (completionStored ? 2 : 1);
  };
  const trackExposure = (trigger: HTMLElement | null) => {
    if (trigger?.dataset.menuOpen === 'true' && !currentPageRemoved && !document.hidden &&
      currentPageItems.some((item) => !item.classList.contains('is-removed'))) trackStoryStage('exposed');
  };
  currentPageNotes.forEach((note) => {
    const trigger = note.closest<HTMLElement>('.header-trigger');
    trigger?.addEventListener('header:trigger-close', () => {
      clearStoryLock();
      pauseMessages();
      hideCurrentPageNote(note);
    });
    trigger?.addEventListener('header:trigger-open', () => {
      cancelNote(note);
      trackExposure(trigger);
      if (needsResume && !currentPageRemoved) showMessage('You are on this page', 400, false);
      else {
        note.classList.remove('is-visible');
        syncMenuSurfaceInlineSize(trigger);
      }
    });
  });
  document.addEventListener('header:force-close', () => {
    clearStoryLock();
    pauseMessages();
    currentPageNotes.forEach((note) => {
      cancelNote(note);
      note.classList.remove('is-visible');
      note.setAttribute('aria-hidden', 'true');
    });
  });
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) return;
    clearStoryLock();
    pauseMessages();
    currentPageNotes.forEach(hideCurrentPageNote);
  });

  currentPageLinks.forEach((link) => {
    link.addEventListener(
      'click',
      (event) => {
        event.preventDefault();
        if (currentPageRemoved || suppressNextCurrentPageClick) {
          suppressNextCurrentPageClick = false;
          return;
        }
        if (storyIsLocked()) return;
        cancelIdle();
        if (needsResume) {
          needsResume = false;
          showMessage(messageForClick(currentPageClickCount) ?? 'You are on this page', messageWeight(), event.detail > 0,
            stageForClick(currentPageClickCount));
          if (!completionStored && currentPageClickCount === 9) scheduleIdle();
          return;
        }
        if (idlePhase === 'good-boy') {
          idlePhase = 'hey';
          currentPageClickCount = 10;
          showMessage('HEY', 400, event.detail > 0, 'idle-hey');
          idleTimer = window.setTimeout(() => {
            idleTimer = null;
            idlePhase = 'none';
            showMessage("i'm not playing", 400, true, 'not-playing');
          }, 800);
          return;
        }
        if (idlePhase === 'hey') {
          idlePhase = 'none';
          showMessage("i'm not playing", 400, event.detail > 0, 'not-playing');
          return;
        }
        currentPageClickCount += 1;
        if (currentPageClickCount === 1) {
          trackExposure(link.closest<HTMLElement>('.header-trigger'));
          if (menuIsOpen() && !document.hidden) trackStoryStage('started');
        }

        const label = link.querySelector<HTMLElement>('.header-menu__link-label');
        const shakeCutoff = completionStored ? 2 : 7;
        if (label && currentPageClickCount >= shakeCutoff) {
          cancelAnimations(label);
          label.classList.remove('is-error-shaking');
        }
        if (event.detail > 0 && !reduceMotionMq.matches && label && currentPageClickCount < shakeCutoff) {
          cancelAnimations(label);
          label.classList.remove('is-error-shaking');
          const strength = completionStored ? 0.45 : currentPageClickCount <= 3
            ? 0.5 + (currentPageClickCount - 1) * 0.5 : 0.4;
          label.style.setProperty('--current-shake-strength', String(strength));
          label.style.setProperty('--current-shake-duration', completionStored || currentPageClickCount >= 4 ? '0.15s' : '0.24s');
          void label.offsetWidth;
          label.classList.add('is-error-shaking');
        }
        if (completionStored && currentPageClickCount >= 4) return removeCurrentPage(event.detail === 0);
        if (!completionStored && currentPageClickCount >= 14) return removeCurrentPage(event.detail === 0);
        const message = messageForClick(currentPageClickCount);
        if (!message) return;
        const weight = messageWeight();
        const stage = stageForClick(currentPageClickCount);
        currentPageNotes.forEach((note) => {
          note.setAttribute('aria-live', note.closest('.header-trigger') === link.closest('.header-trigger') ? 'polite' : 'off');
          setNote(note, message, weight, event.detail > 0, stage);
        });
        if (!completionStored && currentPageClickCount === 9) scheduleIdle();
      },
      true,
    );
    link.addEventListener('pointerdown', (event) => {
      if (storyIsLocked()) return;
      if (event.pointerType === 'mouse' && event.button === 0 &&
        ((completionStored && currentPageClickCount === 3) || (!completionStored && currentPageClickCount === 13)) && !needsResume) {
        event.preventDefault();
        suppressNextCurrentPageClick = true;
        removeCurrentPage(false);
      }
    }, true);
  });

  // DEV-only: Section Editor is toggled via Alt+E (see DevModeController).
</script>

