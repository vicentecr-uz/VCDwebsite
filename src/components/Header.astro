---
interface Props {
  title?: string;
  /** @deprecated Use nav menu on all pages; kept for non–nav-menu fallback only. */
  linkHref?: string;
  navMenu?: boolean;
}

import headerSettings from '../content/settings/header.json';

const {
  title = headerSettings.siteTitle,
  linkHref = '/',
  navMenu = true,
} = Astro.props;
const homeWordmark = headerSettings.siteTitle.replace(' ', '\u00a0');
const wordmark = title.replace(' ', '\u00a0');
const showWordmarkSwap = title !== headerSettings.siteTitle;
const pageChars = [...wordmark];
const homeChars = [...homeWordmark];
const isHome = Astro.url.pathname === '/';
const brandHref = isHome ? null : '/';

const menuLinks = headerSettings.menuLinks;
---

{navMenu ? (
  <header class="site-header site-header--nav-menu">
    <div class="site-header__bg" aria-hidden="true"></div>
    <div class="header-menu-backdrop" aria-hidden="true"></div>
    <div class="site-header__row">
      <div class:list={['header-trigger', 'header-trigger--start', isHome && 'header-trigger--home']}>
        <span class="header-trigger__sizer" aria-hidden="true">
          {showWordmarkSwap ? (
            <span class="header-trigger__sizer-track">
              <span>{wordmark}</span>
              <span>{homeWordmark}</span>
            </span>
          ) : (
            wordmark
          )}
        </span>
        <div class="header-trigger__panel">
          <div class="header-trigger__panel-bg" aria-hidden="true"></div>
          <div class="header-trigger__brand">
            {brandHref ? (
              <a
                href={brandHref}
                class:list={['header-trigger__brand-link', showWordmarkSwap && 'header-trigger__brand-link--swap']}
              >
                {showWordmarkSwap ? (
                  <span class="header-trigger__wordmark-stack">
                    <span class="header-trigger__wordmark header-trigger__wordmark--page" aria-hidden="false">
                      {pageChars.map((char) => (
                        <span class="header-trigger__char">{char === ' ' ? '\u00a0' : char}</span>
                      ))}
                    </span>
                    <span class="header-trigger__wordmark header-trigger__wordmark--home" aria-hidden="true">
                      {homeChars.map((char) => (
                        <span class="header-trigger__char">{char === ' ' ? '\u00a0' : char}</span>
                      ))}
                    </span>
                  </span>
                ) : (
                  <span class="header-trigger__wordmark">{wordmark}</span>
                )}
              </a>
            ) : (
              <span class="header-trigger__wordmark">{wordmark}</span>
            )}
          </div>
          <ul class="header-menu" role="list">
            {menuLinks.map((link) => (
              <li>
                <a href={link.href} class="header-menu__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="header-trigger header-trigger--end">
        <span class="header-trigger__sizer header-trigger__sizer--logo" aria-hidden="true">
          <span
            class="header-trigger__logo"
            style={`--logo-src: url("${headerSettings.logoPath}")`}
          ></span>
        </span>
        <div class="header-trigger__panel">
          <div class="header-trigger__panel-bg" aria-hidden="true"></div>
          <div class="header-trigger__brand" data-dev-mode-trigger>
            {brandHref ? (
              <a href={brandHref} class="header-trigger__brand-link" aria-label="Home">
                <span
                  class="header-trigger__logo"
                  style={`--logo-src: url("${headerSettings.logoPath}")`}
                  aria-hidden="true"
                ></span>
              </a>
            ) : (
              <span
                class="header-trigger__logo"
                style={`--logo-src: url("${headerSettings.logoPath}")`}
                role="img"
                aria-label="Logo"
              ></span>
            )}
          </div>
          <ul class="header-menu" role="list">
            {menuLinks.map((link) => (
              <li>
                <a href={link.href} class="header-menu__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </header>
) : (
  <header class="site-header">
    <div class="site-header__bg" aria-hidden="true"></div>
    <div class="site-header__row">
      <a
        href={linkHref}
        class="header-link hover:opacity-60 transition-opacity duration-200"
        style="font-family: var(--font-sans); font-size: 2.4em; line-height: 1; font-weight: 700; letter-spacing: -0.05ch;"
      >
        {title}
      </a>

      <nav>
        <a
          href={linkHref}
          class="header-link block transition-opacity duration-200 opacity-100 hover:opacity-70"
          aria-label="Logo"
        >
          <span
            class="header-trigger__logo"
            style={`--logo-src: url("${headerSettings.logoPath}")`}
            aria-hidden="true"
          ></span>
        </a>
      </nav>
    </div>
  </header>
)}

<script>
  const header = document.querySelector('.site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const isMenuOpen = () =>
      header.matches(
        ':has(.header-trigger:hover, .header-trigger:focus-within, .header-trigger.is-menu-open)',
      );

    const update = () => {
      const y = window.scrollY;

      if (isMenuOpen() || y <= 8) {
        header.classList.remove('is-scrolled-hidden');
      } else if (y > lastY + 4) {
        header.classList.add('is-scrolled-hidden');
      } else if (y < lastY - 4) {
        header.classList.remove('is-scrolled-hidden');
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }

  const setMenuBackdropVisible = (visible: boolean) => {
    document
      .querySelector('.site-header--nav-menu')
      ?.classList.toggle('is-menu-backdrop-visible', visible);
  };

  document.querySelectorAll<HTMLElement>('.header-trigger').forEach((trigger) => {
    const links = [...trigger.querySelectorAll('.header-menu__link')];
    if (!links.length) return;

    const panelBg = trigger.querySelector('.header-trigger__panel-bg') as HTMLElement | null;
    const closeLayoutMs =
      Math.ceil(Math.max(0.38, (links.length - 1) * 0.04 + 0.15) * 1000) + 32;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const setPanelReveal = (open: boolean) => {
      if (!panelBg) return;

      if (open) {
        trigger.style.setProperty('--panel-bg-duration', '0.48s');
        trigger.style.setProperty('--panel-bg-delay', '0s');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            trigger.style.setProperty('--menu-reveal', '1');
          });
        });
      } else {
        trigger.style.setProperty('--panel-bg-duration', '0.38s');
        trigger.style.setProperty('--panel-bg-delay', '0s');
        trigger.style.setProperty('--menu-reveal', '0');
      }
    };

    const setOpenStagger = () => {
      links.forEach((link, i) => {
        link.style.setProperty('--menu-link-delay', `${0.06 + i * 0.08}s`);
        link.style.setProperty('--menu-link-duration', '0.3s');
        link.style.opacity = '1';
      });
    };

    const setCloseStagger = () => {
      links.forEach((link, i) => {
        const reverseIndex = links.length - 1 - i;
        link.style.setProperty('--menu-link-delay', `${reverseIndex * 0.04}s`);
        link.style.setProperty('--menu-link-duration', '0.15s');
        link.style.opacity = '0';
      });
    };

    const openMenu = () => {
      if (closeTimer) clearTimeout(closeTimer);
      trigger.style.setProperty('--menu-reveal', '0');
      trigger.classList.add('is-menu-open');
      setMenuBackdropVisible(true);
      setOpenStagger();
      setPanelReveal(true);
    };

    const closeMenu = () => {
      setMenuBackdropVisible(false);
      setCloseStagger();
      setPanelReveal(false);
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        if (!trigger.matches(':hover') && !trigger.contains(document.activeElement)) {
          trigger.classList.remove('is-menu-open');
        }
      }, closeLayoutMs);
    };

    trigger.addEventListener('mouseenter', openMenu);
    trigger.addEventListener('focusin', openMenu);
    trigger.addEventListener('mouseleave', closeMenu);
    trigger.addEventListener('focusout', (event) => {
      if (!trigger.contains(event.relatedTarget as Node | null)) {
        closeMenu();
      }
    });
  });

  const startTrigger = document.querySelector('.header-trigger--start');
  const wordmarkStack = startTrigger?.querySelector('.header-trigger__wordmark-stack');

  if (startTrigger && wordmarkStack) {
    const pageWordmark = wordmarkStack.querySelector('.header-trigger__wordmark--page') as HTMLElement | null;
    const pageChars = [
      ...wordmarkStack.querySelectorAll<HTMLElement>('.header-trigger__wordmark--page .header-trigger__char'),
    ];
    const homeWordmarkEl = wordmarkStack.querySelector('.header-trigger__wordmark--home');
    const homeChars = [
      ...wordmarkStack.querySelectorAll<HTMLElement>('.header-trigger__wordmark--home .header-trigger__char'),
    ];
    const brandLink = startTrigger.querySelector('.header-trigger__brand-link');

    const FADE_OUT_STAGGER = 0.03;
    const FADE_OUT_DURATION = 0.15;
    const FADE_IN_DURATION = 0.25;
    const FADE_IN_STAGGER_START = 0.04;
    const FADE_IN_STAGGER_END = 0.09;
    const CLOSE_IN_BASE_DELAY = FADE_OUT_DURATION * 0.45;
    const BLUR_PX = 4;

    let wordmarkIsOpen = false;
    let wordmarkAnimating = false;

    const setCharFadeOut = (chars: HTMLElement[], stagger: number, duration: number, baseDelay = 0) => {
      chars.forEach((char, i) => {
        char.style.setProperty('--char-delay', `${baseDelay + i * stagger}s`);
        char.style.setProperty('--char-duration', `${duration}s`);
        char.style.setProperty('--char-easing', 'ease');
        char.style.setProperty('--char-blur', `${BLUR_PX}px`);
        char.style.opacity = '0';
      });
    };

    const progressiveStaggerDelay = (
      index: number,
      total: number,
      staggerStart: number,
      staggerEnd: number,
    ) => {
      let delay = 0;

      for (let j = 0; j < index; j++) {
        const progress = total > 1 ? j / (total - 1) : 0;
        delay += staggerStart + progress * (staggerEnd - staggerStart);
      }

      return delay;
    };

    const applyWordmarkFadeIn = (chars: HTMLElement[], baseDelay = 0) => {
      // Snap to blurred/invisible, then fade + deblur into place (staggered)
      chars.forEach((char) => {
        char.style.setProperty('--char-duration', '0s');
        char.style.setProperty('--char-delay', '0s');
        char.style.setProperty('--char-blur', `${BLUR_PX}px`);
        char.style.opacity = '0';
      });

      requestAnimationFrame(() => {
        chars.forEach((char, i) => {
          const delay =
            baseDelay + progressiveStaggerDelay(i, chars.length, FADE_IN_STAGGER_START, FADE_IN_STAGGER_END);

          char.style.setProperty('--char-delay', `${delay}s`);
          char.style.setProperty('--char-duration', `${FADE_IN_DURATION}s`);
          char.style.setProperty('--char-easing', 'ease');
          char.style.setProperty('--char-blur', '0px');
          char.style.opacity = '1';
        });
      });
    };

    const getFadeOutEnd = (count: number) =>
      Math.max(0, (count - 1) * FADE_OUT_STAGGER + FADE_OUT_DURATION);

    const getFadeInEnd = (count: number, baseDelay: number) =>
      baseDelay +
      progressiveStaggerDelay(
        Math.max(0, count - 1),
        count,
        FADE_IN_STAGGER_START,
        FADE_IN_STAGGER_END,
      ) +
      FADE_IN_DURATION;

    const waitForWordmarkTransition = (durationSec: number) =>
      new Promise<void>((resolve) => {
        window.setTimeout(resolve, durationSec * 1000 + 32);
      });

    const applyWordmarkOpen = () => {
      setCharFadeOut(pageChars, FADE_OUT_STAGGER, FADE_OUT_DURATION);
      applyWordmarkFadeIn(homeChars);

      pageWordmark?.setAttribute('aria-hidden', 'true');
      homeWordmarkEl?.setAttribute('aria-hidden', 'false');
      brandLink?.setAttribute('aria-label', 'Vicente Cruz');
    };

    const applyWordmarkClose = () => {
      setCharFadeOut(homeChars, FADE_OUT_STAGGER, FADE_OUT_DURATION);
      applyWordmarkFadeIn(pageChars, CLOSE_IN_BASE_DELAY);

      pageWordmark?.setAttribute('aria-hidden', 'false');
      homeWordmarkEl?.setAttribute('aria-hidden', 'true');
      brandLink?.removeAttribute('aria-label');
    };

    const isWordmarkHoverActive = () =>
      startTrigger.matches(':hover') || startTrigger.contains(document.activeElement);

    const syncWordmarkHover = () => {
      if (wordmarkAnimating) return;

      const hoverActive = isWordmarkHoverActive();

      if (hoverActive && !wordmarkIsOpen) {
        void runWordmarkOpen();
      } else if (!hoverActive && wordmarkIsOpen) {
        void runWordmarkClose();
      }
    };

    const runWordmarkOpen = async () => {
      if (wordmarkAnimating) return;

      wordmarkAnimating = true;
      startTrigger.classList.add('is-wordmark-swapped');
      applyWordmarkOpen();

      const duration = Math.max(
        FADE_OUT_DURATION,
        getFadeInEnd(homeChars.length, 0),
      );

      await waitForWordmarkTransition(duration);

      wordmarkIsOpen = true;
      wordmarkAnimating = false;
      syncWordmarkHover();
    };

    const runWordmarkClose = async () => {
      if (wordmarkAnimating) return;

      wordmarkAnimating = true;
      applyWordmarkClose();

      const duration = Math.max(
        getFadeOutEnd(homeChars.length),
        getFadeInEnd(pageChars.length, CLOSE_IN_BASE_DELAY),
      );

      await waitForWordmarkTransition(duration);

      wordmarkIsOpen = false;
      wordmarkAnimating = false;
      startTrigger.classList.remove('is-wordmark-swapped');
      syncWordmarkHover();
    };

    const onWordmarkPointerActive = () => {
      if (wordmarkAnimating) return;
      if (!wordmarkIsOpen) void runWordmarkOpen();
    };

    const onWordmarkPointerInactive = () => {
      if (wordmarkAnimating) return;
      if (wordmarkIsOpen) void runWordmarkClose();
    };

    startTrigger.addEventListener('mouseenter', onWordmarkPointerActive);
    startTrigger.addEventListener('focusin', onWordmarkPointerActive);
    startTrigger.addEventListener('mouseleave', onWordmarkPointerInactive);
    startTrigger.addEventListener('focusout', (event) => {
      if (!startTrigger.contains(event.relatedTarget as Node | null)) {
        onWordmarkPointerInactive();
      }
    });
  }
</script>

<style>
  .site-header {
    --header-menu-link-size: 1.2em;
    position: sticky;
    top: 0;
    z-index: 15;
    padding: 1em 0;
    transition: opacity 0.35s ease;
  }

  .site-header.is-scrolled-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .site-header__bg {
    position: absolute;
    inset: 0;
    background-color: #ffffff;
    z-index: 0;
    pointer-events: none;
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 2;
  }

  /* ── Homepage nav menu ── */

  .site-header--nav-menu {
    z-index: 15;
  }

  .header-menu-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    transition: opacity 0.48s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 0;
  }

  .site-header--nav-menu.is-menu-backdrop-visible .header-menu-backdrop {
    opacity: 1;
  }

  .site-header--nav-menu .site-header__row {
    z-index: 1;
  }

  .header-trigger {
    --hitbox-pad: 1em;
    --menu-gap: 0.7em;
    --menu-reveal: 0;
    --menu-link-color-duration: 0.45s;
    --menu-link-color-hover-duration: 0.15s;
    --panel-bg-duration: 0.48s;
    --panel-bg-delay: 0s;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    display: grid;
  }

  .header-trigger__sizer {
    grid-area: 1 / 1;
    visibility: hidden;
    pointer-events: none;
  }

  .header-trigger__sizer:not(.header-trigger__sizer--logo) {
    font-family: var(--font-sans);
    font-size: 2.4em;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.05ch;
  }

  .header-trigger__sizer--logo {
    display: block;
    line-height: 0;
  }

  .header-trigger__sizer-track {
    display: inline-grid;
  }

  .header-trigger__sizer-track > span {
    grid-area: 1 / 1;
  }

  .header-trigger__panel {
    position: absolute;
    top: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    margin: calc(-1 * var(--hitbox-pad));
    padding: var(--hitbox-pad);
    overflow: visible;
  }

  .header-trigger__panel-bg {
    --feather: 7em;
    --panel-bottom-radius: 7em;
    --panel-bottom-pad: 1em;
    position: absolute;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
    transition: height var(--panel-bg-duration) cubic-bezier(0.22, 1, 0.36, 1) var(--panel-bg-delay);
  }

  .header-trigger__panel-bg::before {
    content: '';
    position: absolute;
    background: #ffffff;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .header-trigger.is-menu-open .header-trigger__panel-bg,
  .header-trigger:focus-within .header-trigger__panel-bg {
    opacity: 1;
  }

  .header-trigger--home .header-trigger__panel {
    cursor: default;
  }

  .header-trigger--home .header-trigger__brand,
  .header-trigger--home .header-trigger__wordmark {
    cursor: default;
  }

  .header-trigger--home .header-menu__link {
    cursor: pointer;
  }

  .header-trigger--start .header-trigger__panel-bg {
    top: 0;
    left: 0;
    right: calc(-0.75 * var(--feather));
    bottom: auto;
    height: calc(var(--menu-reveal) * (100% + var(--panel-bottom-pad) + var(--feather)));
  }

  .header-trigger--start .header-trigger__panel-bg::before {
    inset: 0;
    right: calc(-0.75 * var(--feather));
    -webkit-mask-image:
      linear-gradient(
        to bottom,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      linear-gradient(
        to right,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      radial-gradient(
        130% 130% at 100% 100%,
        transparent 0,
        transparent calc(var(--panel-bottom-radius) * 0.68),
        #000 calc(var(--panel-bottom-radius) * 0.98)
      );
    mask-image:
      linear-gradient(
        to bottom,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      linear-gradient(
        to right,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      radial-gradient(
        130% 130% at 100% 100%,
        transparent 0,
        transparent calc(var(--panel-bottom-radius) * 0.68),
        #000 calc(var(--panel-bottom-radius) * 0.98)
      );
  }

  .header-trigger--end .header-trigger__panel-bg {
    top: 0;
    left: calc(-0.75 * var(--feather));
    right: 0;
    bottom: auto;
    height: calc(var(--menu-reveal) * (100% + var(--panel-bottom-pad) + var(--feather)));
  }

  .header-trigger--end .header-trigger__panel-bg::before {
    inset: 0;
    left: calc(-0.75 * var(--feather));
    -webkit-mask-image:
      linear-gradient(
        to bottom,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      linear-gradient(
        to left,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      radial-gradient(
        130% 130% at 0 100%,
        transparent 0,
        transparent calc(var(--panel-bottom-radius) * 0.68),
        #000 calc(var(--panel-bottom-radius) * 0.98)
      );
    mask-image:
      linear-gradient(
        to bottom,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      linear-gradient(
        to left,
        #000 0%,
        #000 calc(100% - var(--feather)),
        rgb(0 0 0 / 0.82) calc(100% - var(--feather) * 0.72),
        rgb(0 0 0 / 0.48) calc(100% - var(--feather) * 0.44),
        rgb(0 0 0 / 0.18) calc(100% - var(--feather) * 0.18),
        transparent 100%
      ),
      radial-gradient(
        130% 130% at 0 100%,
        transparent 0,
        transparent calc(var(--panel-bottom-radius) * 0.68),
        #000 calc(var(--panel-bottom-radius) * 0.98)
      );
  }

  .header-trigger__brand,
  .header-menu {
    position: relative;
    z-index: 2;
  }

  .header-trigger--start .header-trigger__panel {
    left: 0;
    align-items: flex-start;
    width: max-content;
  }

  .header-trigger--end .header-trigger__panel {
    right: 0;
    align-items: flex-end;
    width: max-content;
  }

  .header-trigger__brand {
    flex-shrink: 0;
  }

  .header-trigger__brand-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .header-trigger__brand-link--swap,
  .header-trigger__brand-link--swap:hover {
    opacity: 1;
    width: fit-content;
  }

  .header-trigger--end .header-trigger__brand-link {
    line-height: 0;
  }

  .header-trigger__wordmark {
    font-family: var(--font-sans);
    font-size: 2.4em;
