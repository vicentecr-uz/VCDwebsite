  .site-header__row {
    display: flex;
    /* Logo is taller than the trimmed wordmark; centre so the inset above
       the caps equals the inset below the baseline. */
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  /* Fallback header (no nav menu): no hidden sizer here, so the wordmark link
     itself sets the row — trim both ends. */
  .header-link--wordmark {
    margin-block: calc(-1 * var(--wordmark-trim));
  }

  /* ── Homepage nav menu ── */

  .site-header--nav-menu {
    z-index: 50;
  }

  .header-menu-backdrop {
    position: fixed;
    inset: 0;
    background-color: color-mix(in srgb, var(--sys-color-srf) 90%, transparent);
    opacity: 0;
    transition:
      opacity 0.48s cubic-bezier(0.22, 1, 0.36, 1)
      var(--menu-backdrop-close-delay, 0.09s);
    pointer-events: none;
    /* Above page content (sections sit at 25), below the header bar (50). */
    z-index: 40;
  }

  .header-menu-backdrop.is-menu-backdrop-visible {
    opacity: 1;
