---
/** Drag-to-reorder project cards on Home / Work / Play when grid editor mode is active. */
---

<script>
  const GRID_SELECTOR = '[data-dev-project-grid]';

  type ListingOrderEntry =
    | { type: 'project'; slug: string; order: number; full: boolean }
    | { type: 'play-link'; id: string; order: number };

  let gridEditorActive = false;
  let dragItem: HTMLElement | null = null;
  let dragGrid: HTMLElement | null = null;
  let dragPointerId: number | null = null;
  let keyboardGrabItem: HTMLElement | null = null;
  let keyboardGrabGrid: HTMLElement | null = null;
  let keyboardGrabSnapshot: ListingOrderEntry[] | null = null;
  const baselines = new Map<string, ListingOrderEntry[]>();

  const grids = () => [...document.querySelectorAll<HTMLElement>(GRID_SELECTOR)];

  const gridItems = (grid: HTMLElement) => [
    ...grid.querySelectorAll<HTMLElement>('.project-grid__item:not(.project-grid__item--new)'),
  ];

  const captureOrder = (grid: HTMLElement): ListingOrderEntry[] => (
    gridItems(grid).map((item, index) => {
      const slug = item.dataset.devProjectSlug;
      const playLink = item.dataset.devPlayLink;
      const full = item.classList.contains('project-grid__item--full');
      if (slug) return { type: 'project', slug, order: index + 1, full };
      if (playLink) return { type: 'play-link', id: playLink, order: index + 1 };
      return null;
    }).filter((item): item is ListingOrderEntry => item !== null)
  );

  const ordersMatch = (left: ListingOrderEntry[], right: ListingOrderEntry[]) =>
    JSON.stringify(left) === JSON.stringify(right);

  const restoreOrder = (grid: HTMLElement, items: ListingOrderEntry[]) => {
    const anchor = grid.querySelector('.project-grid__item--new');
    for (const entry of items) {
      const selector = entry.type === 'project'
        ? `[data-dev-project-slug="${entry.slug}"]`
        : `[data-dev-play-link="${entry.id}"]`;
      const item = grid.querySelector<HTMLElement>(selector);
      if (!item) continue;
      if (entry.type === 'project') {
        item.classList.toggle('project-grid__item--full', entry.full);
      }
      if (anchor) grid.insertBefore(item, anchor);
      else grid.append(item);
    }
  };

  const viewIdForPayload = () => document.documentElement.dataset.viewId || undefined;

  const syncPending = (grid: HTMLElement) => {
    const gridId = grid.dataset.devProjectGrid;
    if (!gridId || !['home', 'work', 'play'].includes(gridId)) return;

    if (!baselines.has(gridId)) {
      baselines.set(gridId, captureOrder(grid));
    }

    const baseline = baselines.get(gridId) ?? [];
    const current = captureOrder(grid);
    const pendingId = `listing-order:${gridId}`;

    if (ordersMatch(baseline, current)) {
      grid.classList.remove('is-grid-order-dirty');
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
      return;
    }

    grid.classList.add('is-grid-order-dirty');
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
      detail: {
        id: pendingId,
        kind: 'listing-order',
        payload: {
          grid: gridId,
          items: current,
          viewId: viewIdForPayload(),
        },
        revert: () => {
          restoreOrder(grid, structuredClone(baseline));
          grid.classList.remove('is-grid-order-dirty');
        },
      },
    }));
  };

  const captureBaselines = () => {
    grids().forEach((grid) => {
      const gridId = grid.dataset.devProjectGrid;
      if (gridId) baselines.set(gridId, captureOrder(grid));
    });
  };

  const itemLabel = (item: HTMLElement) =>
    item.querySelector('.project-grid__title')?.textContent?.trim() || 'item';

  const setGridItemReorderable = (active: boolean) => {
    grids().forEach((grid) => {
      grid.setAttribute('aria-dropeffect', active ? 'move' : 'none');
      gridItems(grid).forEach((item) => {
        item.draggable = false;
        item.tabIndex = active ? 0 : -1;
        item.setAttribute('aria-grabbed', 'false');
        item.toggleAttribute('data-dev-grid-draggable', active);
        if (active) {
          item.setAttribute('aria-label', `Reorder ${itemLabel(item)}`);
        } else {
          item.removeAttribute('aria-label');
        }
      });
    });
  };

  const clearDropTargets = () => {
    grids().forEach((grid) => {
      grid.querySelectorAll('.is-grid-drop-target').forEach((node) => {
        node.classList.remove('is-grid-drop-target');
      });
    });
  };

  const insertRelativeToHover = (
    grid: HTMLElement,
    item: HTMLElement,
    hoverItem: HTMLElement,
    clientY: number,
  ) => {
    const rect = hoverItem.getBoundingClientRect();
    const before = clientY < rect.top + rect.height / 2;
    grid.insertBefore(item, before ? hoverItem : hoverItem.nextSibling);
  };

  const hoverItemAtPoint = (grid: HTMLElement, clientX: number, clientY: number) => {
    const hovered = document.elementFromPoint(clientX, clientY);
    if (!(hovered instanceof HTMLElement)) return null;
    const hoverItem = hovered.closest<HTMLElement>('.project-grid__item:not(.project-grid__item--new)');
    if (!hoverItem || !grid.contains(hoverItem)) return null;
    return hoverItem;
  };

  const finishPointerDrag = () => {
    if (gridEditorActive && dragGrid) syncPending(dragGrid);
    if (dragItem) {
      dragItem.classList.remove('is-grid-dragging');
      if (dragPointerId != null) {
        try {
          dragItem.releasePointerCapture(dragPointerId);
        } catch {
          // Pointer may already be released.
        }
      }
    }
    clearDropTargets();
    dragItem = null;
    dragGrid = null;
    dragPointerId = null;
  };

  const releaseKeyboardGrab = (revert: boolean) => {
    if (!keyboardGrabItem) return;
    const grid = keyboardGrabGrid;
    keyboardGrabItem.classList.remove('is-grid-keyboard-grabbed');
    keyboardGrabItem.setAttribute('aria-grabbed', 'false');
    keyboardGrabItem = null;
    keyboardGrabGrid = null;

    if (revert && grid && keyboardGrabSnapshot) {
      restoreOrder(grid, keyboardGrabSnapshot);
    }
    keyboardGrabSnapshot = null;

    if (grid) syncPending(grid);
  };

  const moveKeyboardGrab = (delta: number) => {
    if (!keyboardGrabItem || !keyboardGrabGrid) return;
    const items = gridItems(keyboardGrabGrid);
    const index = items.indexOf(keyboardGrabItem);
    const targetIndex = index + delta;
    if (targetIndex < 0 || targetIndex >= items.length) return;

    const target = items[targetIndex];
    keyboardGrabGrid.insertBefore(
      keyboardGrabItem,
      delta > 0 ? target.nextSibling : target,
    );
    syncPending(keyboardGrabGrid);
  };

  const onGridEditorChange = (active: boolean) => {
    gridEditorActive = active;
    if (active) {
      captureBaselines();
    } else {
      finishPointerDrag();
      releaseKeyboardGrab(true);
    }
    setGridItemReorderable(active);
  };

  window.addEventListener('vcd:listing-grid-editor-change', ((event: CustomEvent<{ active?: boolean }>) => {
    onGridEditorChange(Boolean(event.detail?.active));
  }) as EventListener);

  window.addEventListener('vcd:dev-pending-committed', () => {
    grids().forEach((grid) => {
      const gridId = grid.dataset.devProjectGrid;
      if (!gridId) return;
      baselines.set(gridId, captureOrder(grid));
      grid.classList.remove('is-grid-order-dirty');
    });
  });

  window.addEventListener('vcd:dev-pending-reverted', () => {
    grids().forEach((grid) => grid.classList.remove('is-grid-order-dirty'));
  });

  document.addEventListener('pointerdown', (event) => {
    if (!gridEditorActive || keyboardGrabItem) return;
    if (event.button !== 0) return;

    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const item = target.closest<HTMLElement>('.project-grid__item[data-dev-grid-draggable]');
    if (!item) return;

    const grid = item.closest<HTMLElement>(GRID_SELECTOR);
    if (!grid) return;

    dragItem = item;
    dragGrid = grid;
    dragPointerId = event.pointerId;
    item.classList.add('is-grid-dragging');
    item.setPointerCapture(event.pointerId);
    event.preventDefault();
  });

  document.addEventListener('pointermove', (event) => {
    if (!gridEditorActive || !dragItem || dragPointerId !== event.pointerId) return;

    const grid = dragGrid ?? dragItem.closest<HTMLElement>(GRID_SELECTOR);
    if (!grid) return;

    const hoverItem = hoverItemAtPoint(grid, event.clientX, event.clientY);
    gridItems(grid).forEach((item) => item.classList.remove('is-grid-drop-target'));
    if (!hoverItem || hoverItem === dragItem) return;

    hoverItem.classList.add('is-grid-drop-target');
    insertRelativeToHover(grid, dragItem, hoverItem, event.clientY);
  });

  document.addEventListener('pointerup', (event) => {
    if (!dragItem || dragPointerId !== event.pointerId) return;
    finishPointerDrag();
  });

  document.addEventListener('pointercancel', (event) => {
    if (!dragItem || dragPointerId !== event.pointerId) return;
    finishPointerDrag();
  });

  document.addEventListener('keydown', (event) => {
    if (!gridEditorActive) return;
    if (event.altKey || event.ctrlKey || event.metaKey) return;

    const target = event.target;
    const focusedItem = target instanceof HTMLElement
      ? target.closest<HTMLElement>('.project-grid__item[data-dev-grid-draggable]')
      : null;

    if (keyboardGrabItem) {
      if (event.key === ' ' || event.key === 'Enter') {
        event.preventDefault();
        event.stopPropagation();
        releaseKeyboardGrab(false);
        return;
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        releaseKeyboardGrab(true);
        return;
      }

      if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
        event.preventDefault();
        event.stopPropagation();
        moveKeyboardGrab(-1);
        return;
      }

      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
        event.preventDefault();
        event.stopPropagation();
        moveKeyboardGrab(1);
        return;
      }
      return;
    }

    if (!focusedItem) return;

    if (event.key === ' ' || event.key === 'Enter') {
      event.preventDefault();
      event.stopPropagation();
      const grid = focusedItem.closest<HTMLElement>(GRID_SELECTOR);
      if (!grid) return;
      keyboardGrabItem = focusedItem;
      keyboardGrabGrid = grid;
      keyboardGrabSnapshot = captureOrder(grid);
      focusedItem.classList.add('is-grid-keyboard-grabbed');
      focusedItem.setAttribute('aria-grabbed', 'true');
    }
  });
</script>

<style is:global>
  .show-listing-grid-editor [data-dev-project-grid] {
    outline: 1px dashed #b8b4ab;
    outline-offset: 0.35em;
  }

  .show-listing-grid-editor [data-dev-project-grid].is-grid-order-dirty {
    outline-style: solid;
    outline-color: #6f6b62;
  }

  .show-listing-grid-editor .project-grid__item[data-dev-grid-draggable] {
    cursor: grab;
    touch-action: none;
  }

  .show-listing-grid-editor .project-grid__item.is-grid-dragging,
  .show-listing-grid-editor .project-grid__item.is-grid-keyboard-grabbed {
    opacity: 0.55;
    cursor: grabbing;
    outline: 2px solid #6f6b62;
    outline-offset: 2px;
  }

  .show-listing-grid-editor .project-grid__item.is-grid-drop-target {
    outline: 2px solid #6f6b62;
    outline-offset: 2px;
  }

  .show-listing-grid-editor .project-grid__item[data-dev-grid-draggable] .project-grid__card {
    pointer-events: none;
  }

  .show-listing-grid-editor .project-grid__item--new,
  .show-listing-grid-editor .project-grid__settings {
    display: none;
  }
</style>
