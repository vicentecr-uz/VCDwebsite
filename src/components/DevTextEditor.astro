    border-radius: var(--dev-radius-control);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior: contain;
    touch-action: pan-x;
    /* Parent toolbar is pointer-events: none; re-enable so menu items are clickable. */
    pointer-events: auto;
