  }

  /* Keep gap controls out of the way while editing text. */
  .is-dev-mode.is-dev-text-caret .dev-gap-toolbar__add,
  .is-dev-mode.is-dev-text-caret .dev-gap-toolbar__spacing {
    opacity: 0;
    pointer-events: none;
  }

  /* Tuner open: force-hide even dirty / near chips (same as asset manager). */
  html.is-dev-tuner-open .dev-gap-toolbar__add,
  html.is-dev-tuner-open .dev-gap-toolbar__spacing {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .dev-gap-toolbar__add {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 8px;
    border: 0;
    /* Standalone here, not inside the master's pill segment: a 72px-wide
       floating + in the middle of a page gap is not what the master draws,
       so min-width stays 0 (72px belongs to the pill's spacing chips). */
    min-width: 0;
    min-height: var(--dev-control-height);
    border-radius: var(--dev-radius-control);
    background: var(--comp-button-soft-container);
    color: var(--comp-button-label);
    font: var(--dev-text-label);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .dev-gap-toolbar__add > span {
    display: inline-flex;
    width: 16px;
    height: 16px;
  }

  .dev-gap-toolbar__add :global(svg) {
    display: block;
  }

  .dev-gap-toolbar__add:hover,
  .dev-gap-toolbar__add:focus-visible,
  .dev-gap-toolbar__add:active,
  .dev-gap-toolbar__add[aria-expanded='true'] {
    background: var(--comp-button-soft-container-hover);
    transform: scale(1.08);
  }

  .dev-gap-toolbar__add:active,
  .dev-gap-toolbar__add[aria-expanded='true'] {
    box-shadow: 0 0.35em 1.1em rgb(0 0 0 / 0.16);
  }

  /* Master: menu has no surface of its own — a bare column, each item
     carries its own fill/border/shadow. */
  .dev-gap-toolbar__menu {
    position: absolute;
    top: calc(100% + 0.35em);
    left: 50%;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 10em;
    transform: translateX(-50%);
    /* Parent toolbar is pointer-events: none; re-enable so menu items are clickable. */
    pointer-events: auto;
  }

  .dev-gap-toolbar__menu[hidden] {
    display: none;
  }

  /* Page emphasis, Align=Start. */
  .dev-gap-toolbar__menu button {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    min-width: var(--dev-control-min-width);
    min-height: var(--dev-control-height);
    box-sizing: border-box;
    padding: 8px;
    border: 1px solid var(--sys-color-srf-container-low);
    border-radius: var(--dev-radius-control);
    background: var(--comp-button-page-container);
    color: var(--comp-button-label);
    font: var(--dev-text-label);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 7px 9.5px rgb(0 0 0 / 0.08);
  }

  .dev-gap-toolbar__menu button:hover {
    background: var(--comp-button-page-container-hover);
  }

  .dev-gap-toolbar__menu button:active {
    background: var(--comp-button-page-container-pressed);
  }

  /* Spacing Toolbar Base (630:5633). */
  .dev-gap-toolbar__spacing {
    position: absolute;
    right: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border: 1px solid var(--sys-color-srf-container-low);
    border-radius: 12px;
    background: var(--sys-color-srf);
    box-shadow: 0 7px 19px rgb(0 0 0 / 0.08);
  }

  /* Ghost Button Base at 72px. */
  .dev-spacing-control__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 72px;
    min-height: var(--dev-control-height);
    box-sizing: border-box;
    padding: 8px;
    border: 0;
    border-radius: var(--dev-radius-control);
    background: var(--comp-button-ghost-container);
    color: var(--comp-button-label);
    font: var(--dev-text-label);
    cursor: pointer;
    white-space: nowrap;
  }

  .dev-spacing-control__btn:hover {
    background: var(--comp-button-ghost-container-hover);
  }

  /* Divergence: the signed master shows the current chip on
     button/ghost/container-hover, the same fill a hovered chip gets, so a
     selected chip would be indistinguishable from a hovered one. This group
     is a radio — exactly one option is always on — so active borrows the
     Filled tokens instead, matching the Format bar's active treatment. */
  .dev-spacing-control__btn.is-active {
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
  }

  /* Affordance the static master doesn't draw — its chips are label-only. */
  .dev-spacing-control__mark {
    display: block;
    width: 1.1em;
    border-radius: 999px;
    background: currentColor;
    flex-shrink: 0;
  }

  .dev-spacing-control__mark--related {
    height: 0.12em;
  }

  .dev-spacing-control__mark--group {
    height: 0.2em;
  }

  .dev-spacing-control__mark--section {
    height: 0.28em;
  }

  .dev-spacing-control__mark--major {
    height: 0.45em;
  }

  .dev-spacing-control__mark--none {
    height: 0;
    width: 1.1em;
    border: 1px solid currentColor;
    background: transparent;
    box-sizing: border-box;
    border-radius: 1px;
  }

  /*
    Dirty spacing: highlight the margin-top gap above the block (the thing
    you're editing), not the content box. Same positioning model as the
    gap toolbar — no spacer section in the DOM.

    Use ::before — ::after is the section-delete hit bridge
    ([data-dev-section-deletable]::after). Sharing one pseudo collapsed the
    gap outline into a small dashed box over the content.
  */
  .is-dev-mode [data-dev-spacing-document].is-dev-spacing-dirty {
    position: relative;
  }

  .is-dev-mode [data-dev-spacing-document].is-dev-spacing-dirty::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: var(--space-section);
    box-sizing: border-box;
    border: 1px dashed color-mix(in srgb, var(--sys-color-on-srf-variant) 55%, transparent);
    pointer-events: none;
    z-index: 35;
  }

  .is-dev-mode [data-dev-spacing-document].is-dev-spacing-dirty.project-stack--related::before {
    height: var(--space-related);
  }

  .is-dev-mode [data-dev-spacing-document].is-dev-spacing-dirty.project-stack--group::before {
    height: var(--space-group);
  }

  .is-dev-mode [data-dev-spacing-document].is-dev-spacing-dirty.project-stack--major::before {
    height: var(--space-major);
  }

  .is-dev-mode [data-dev-spacing-document].is-dev-spacing-dirty.project-stack--none::before,
  .is-dev-mode
    .project-stack--flush
    + [data-dev-spacing-document].is-dev-spacing-dirty.project-stack--flush::before {
    content: none;
  }

  .is-dev-mode
    .project-stack--precede-related
    + [data-dev-spacing-document].is-dev-spacing-dirty:not(.project-stack--related):not(
      .project-stack--group
    ):not(.project-stack--section):not(.project-stack--major):not(.project-stack--none)::before {
    height: var(--space-related);
  }

  /* ── Section delete (DEV) ───────────────────────────────── */
  /*
    Delete uses a right gutter bridge (::after). Drag uses a real bridge element
    in DevSectionReorderEditor so it can sit below the handle in the stack.
  */
  .is-dev-mode [data-dev-section-deletable]::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: -4.5em;
    width: 4.5em;
    z-index: 1;
    pointer-events: none;
  }

  .is-dev-mode
    [data-dev-section-deletable].is-dev-section-controls-visible::after,
  .is-dev-mode [data-dev-section-deletable]:hover::after {
    pointer-events: auto;
  }

  .dev-section-delete {
    position: absolute;
    /* Track the media box, not the full-width section. Vars are published by
       syncDragHandleAnchor in DevSectionReorderEditor. */
    top: var(--dev-section-anchor-y, 50%);
    right: var(--dev-section-inset-end, 0px);
    left: auto;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    /* Same chip scale as .dev-image-edit-trigger — --radius-control is em-based. */
    border-radius: var(--radius-control);
    /* Icon-only at rest; fill + scale on hover; shadow only on press.
       Mirrors .dev-section-drag-handle in DevSectionReorderEditor. */
    background: transparent;
    padding: 0.45em 0.55em;
    color: var(--sys-color-on-srf);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translate(calc(100% + 0.55em), -50%);
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .dev-section-delete[hidden] {
    display: none;
  }

  /*
    Below 40em the gutter is 16px but a chip plus its gap needs ~36px, so the
    outward translate lands trash off the right edge and its ::after bridge
    sets the document's scroll width (section right + 4.5em), making the page
    scroll sideways — issue #100. Flip the chip inside the media box and drop
    the bridge; it only spans the gutter gap, which is gone once the chip sits
    on the block. Mirrors .dev-section-drag-handle in DevSectionReorderEditor.
  */
  @media (max-width: 40em) {
    .dev-section-delete {
      transform: translate(-0.55em, -50%);
    }

    .is-dev-mode [data-dev-section-deletable]::after {
      content: none;
    }
  }

  /*
    Delete is a sibling of the gap toolbar under the same section. Hovering
    + / spacing / the add menu still matches section:hover (descendants count
    even when painted in the margin gap) — exclude those so trash stays put.
  */
  .is-dev-mode
    [data-dev-section-deletable].is-dev-section-controls-visible:not(
      :has(> .dev-gap-toolbar :hover, > .dev-gap-toolbar:focus-within)
    )
    > .dev-section-delete,
  .is-dev-mode
    [data-dev-section-deletable]:hover:not(
      :has(> .dev-gap-toolbar :hover, > .dev-gap-toolbar:focus-within)
    )
    > .dev-section-delete,
  .is-dev-mode
    [data-dev-section-deletable]:focus-within:not(:has(> .dev-gap-toolbar:focus-within))
    > .dev-section-delete,
  .is-dev-mode .dev-section-delete:hover,
  .is-dev-mode .dev-section-delete:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .dev-section-delete:hover,
  .dev-section-delete:focus-visible,
  .dev-section-delete:active {
    background: color-mix(in srgb, var(--sys-color-srf-container) 92%, transparent);
    backdrop-filter: blur(8px);
    transform: translate(calc(100% + 0.55em), -50%) scale(1.08);
  }

  .dev-section-delete:active {
    box-shadow: 0 0.35em 1.1em rgb(0 0 0 / 0.16);
  }

  @media (max-width: 40em) {
    .dev-section-delete:hover,
    .dev-section-delete:focus-visible,
    .dev-section-delete:active {
      transform: translate(-0.55em, -50%) scale(1.08);
    }
  }

  /*
    Keep delete out of the way while editing text (same as gap toolbar).

    !important because this is a global state that has to beat every local
    reveal, and it loses the specificity race otherwise: clicking into a text
    field puts the section in :focus-within, and the reveal above carries a
    :not(:has(…)) worth two classes, so it outweighs this selector. Editing
    text also means hovering the section, so the :hover reveal lands too.
    Same reason html.is-dev-mode-exiting force-hides this chip set in
    DevModeController — see the note there.

    Only the value is forced; the 0.15s opacity transition still applies, so
    the chips fade rather than snap on caret and on click-away.
  */
  .is-dev-mode.is-dev-text-caret [data-dev-section-deletable] > .dev-section-delete,
  .is-dev-mode.is-dev-text-caret [data-dev-section-deletable]::after,
  .is-dev-mode.is-dev-text-caret [data-dev-section-deletable].is-dev-section-controls-visible
    > .dev-section-delete {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>
