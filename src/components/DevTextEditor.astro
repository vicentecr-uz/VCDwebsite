  .dev-gap-toolbar__add:active,
  .dev-gap-toolbar__add[aria-expanded='true'] {
    background: var(--comp-button-ghost-container-pressed);
  }

  /* The menu shares the pill surface and lays its options out in one row. */
  .dev-gap-toolbar__menu {
    display: flex;
    flex: 1 1 auto;
    flex-direction: row;
    gap: 4px;
    min-width: 0;
    max-width: 100%;
    opacity: 1;
