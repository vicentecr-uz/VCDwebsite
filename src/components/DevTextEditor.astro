---
import triangleAlertIcon from 'lucide-static/icons/triangle-alert.svg?raw';
import boldIcon from 'lucide-static/icons/bold.svg?raw';
import italicIcon from 'lucide-static/icons/italic.svg?raw';
import underlineIcon from 'lucide-static/icons/underline.svg?raw';
import linkIcon from 'lucide-static/icons/link.svg?raw';
import trashIcon from 'lucide-static/icons/trash-2.svg?raw';
import checkIcon from 'lucide-static/icons/check.svg?raw';
import pilcrowIcon from 'lucide-static/icons/pilcrow.svg?raw';
import heading1Icon from 'lucide-static/icons/heading-1.svg?raw';
import heading2Icon from 'lucide-static/icons/heading-2.svg?raw';
import { sizeIcon } from '../lib/icons';
import '../styles/gapSpacingControl.css';
import SelectField from './ui/EditorSelectField.astro';
import TextField from './ui/TextField.astro';
import ProjectAward from './project/ProjectAward.astro';
import SaveBar from './ui/SaveBar.astro';

const publishWarnSvg = sizeIcon(triangleAlertIcon, 16);
const formatBoldSvg = sizeIcon(boldIcon, 16);
const formatItalicSvg = sizeIcon(italicIcon, 16);
const formatUnderlineSvg = sizeIcon(underlineIcon, 16);
const formatLinkSvg = sizeIcon(linkIcon, 16);
const formatTrashSvg = sizeIcon(trashIcon, 16);
const formatCheckSvg = sizeIcon(checkIcon, 16);
const formatPilcrowSvg = sizeIcon(pilcrowIcon, 16);
const formatHeading1Svg = sizeIcon(heading1Icon, 16);
const formatHeading2Svg = sizeIcon(heading2Icon, 16);
---

<template data-award-template><ProjectAward documentKey="award-template" sectionPath={['sections', 0]} spacing="group" /></template>

<div class="dev-text-action-stack">
  <SaveBar data-dev-text-actions hidden>
      <span class="dev-text-actions__warn" data-dev-text-warn hidden set:html={publishWarnSvg} />
      <span class="dev-text-actions__status" data-dev-text-status aria-live="polite"></span>
      <span class="dev-text-actions__branch" data-dev-text-branch hidden></span>
      <button type="button" data-dev-text-revert>Revert changes</button>
      <button type="button" data-dev-text-save>Save</button>
      <button type="button" data-dev-text-commit-styles hidden>Publish styles</button>
      <button type="button" class="dev-text-actions__save" data-dev-text-publish>Save &amp; Publish</button>
  </SaveBar>

  <SaveBar data-dev-branch-update-actions hidden>
      <span class="dev-text-actions__status" data-dev-branch-update-status aria-live="polite">Update available</span>
      <button type="button" class="dev-text-actions__save" data-dev-branch-update>Update</button>
  </SaveBar>

</div>

<div class="dev-text-format dev-surface" data-dev-text-format hidden>
  <div class="dev-text-format__surface">
    <div class="dev-text-format__buttons">
      <SelectField
        class="dev-text-format__block-style"
        hideLabel
        label="Block style"
        data-dev-block-style
        value="bodyText"
        options={[
          { value: 'bodyText', label: 'Text', icon: formatPilcrowSvg },
          { value: 'sectionTitle:2', label: 'Heading 1', icon: formatHeading1Svg },
          { value: 'sectionTitle:3', label: 'Heading 2', icon: formatHeading2Svg },
        ]}
      />
      <span class="dev-hairline dev-hairline--vertical" role="presentation"></span>
      <SelectField
        class="dev-text-format__emphasis-style"
        hideLabel
        label="Text tone"
        data-dev-emphasis-style
        value="default"
        options={[
          { value: 'emphasis', label: 'Emphasis' },
          { value: 'default', label: 'Default' },
          { value: 'subtle', label: 'Subtle' },
        ]}
      />
      <SelectField
        class="dev-text-format__wrap-style"
        hideLabel
        label="Wrapping"
        data-dev-wrap-style
        value="auto"
        options={[
          { value: 'auto', label: 'Auto' },
          { value: 'normal', label: 'Normal' },
          { value: 'pretty', label: 'Pretty' },
          { value: 'balance', label: 'Balance' },
        ]}
      />
      <span class="dev-hairline dev-hairline--vertical" role="presentation"></span>
      <div class="dev-text-format__inline" data-dev-format-inline>
        <button type="button" data-dev-format="bold" title="Bold (⌘B)" aria-label="Bold" aria-pressed="false">
          <span class="dev-text-format__icon" aria-hidden="true" set:html={formatBoldSvg} />
        </button>
        <button type="button" data-dev-format="italic" title="Italic (⌘I)" aria-label="Italic" aria-pressed="false">
          <span class="dev-text-format__icon" aria-hidden="true" set:html={formatItalicSvg} />
        </button>
        <button type="button" data-dev-format="underline" title="Underline (⌘U)" aria-label="Underline" aria-pressed="false">
          <span class="dev-text-format__icon" aria-hidden="true" set:html={formatUnderlineSvg} />
        </button>
        <button type="button" data-dev-format="link" title="Link (⌘K)" aria-label="Link" aria-pressed="false">
          <span class="dev-text-format__icon" aria-hidden="true" set:html={formatLinkSvg} />
        </button>
      </div>
    </div>
    <form class="dev-text-format__link" data-dev-text-link-panel aria-hidden="true">
      <button type="button" data-dev-text-unlink title="Remove link" aria-label="Remove link">
        <span class="dev-text-format__icon" aria-hidden="true" set:html={formatTrashSvg} />
      </button>
      <TextField class="dev-text-format__link-input" label="Link URL" hideLabel inputmode="url" data-dev-text-link-input placeholder="google.com" autocomplete="off" spellcheck="false" />
      <button type="submit" title="Apply link" aria-label="Apply link">
        <span class="dev-text-format__icon" aria-hidden="true" set:html={formatCheckSvg} />
      </button>
    </form>
  </div>
</div>

<div class="dev-text-format-sel" data-dev-text-format-sel hidden></div>

<script>
  import { bindProjectAwardEditors } from '../scripts/projectAwardEditor';
  import { normalizeHref } from '../lib/normalizeHref.mjs';
  import { editsRemovedMedia, sectionEditTarget, withDevEditTarget } from '../scripts/devEditTarget';
  import { PARAGRAPH_PLACEHOLDER_ATTRIBUTE, paragraphTextWrap, explicitParagraphTextWrap, refreshParagraphWrapping, normalizeTextWrap, serializeInlineHtml, readParagraphsValue, readPlainDomText, clipboardParagraphHtml, escapeTextHtml } from '../lib/devTextDom';
  import { insertRightIndentTab, removeRightIndentTab, breakRightIndentTab } from '../lib/devTextRightTab';
  import { installHistoryShortcuts, pageHistory } from '../lib/devHistory';
  import {
    initMountedSectionCovers,
    isDevContentEditing,
    mountInsertedSection,
    syncDevModeOnSection,
  } from '../scripts/devSectionMount';
  import {
    initDevSectionOutlineSync,
    disposeDevSectionOutlineSync,
    getDevSectionOutline,
    setDevSectionOutline,
    syncDevSectionOutlineSidebar,
    remapDevSectionOutlineId,
  } from '../scripts/devSectionOutlineSync';
  import { normalizeOutline, outlineAnchorId, type OutlineEntry } from '../lib/projectOutline';
  import {
    buildIndexMapFromOrder,
    DEV_PATH_ATTRS,
    getDropZone,
    getSectionRoots,
    getSectionRootsInDomOrder,
    remapSectionPaths,
    resetSectionOrderIds,
    shiftSectionOrderIds,
  } from '../scripts/devSectionPaths';
  import trashIcon from 'lucide-static/icons/trash-2.svg?raw';
  import plusIcon from 'lucide-static/icons/plus.svg?raw';
  import rotateIcon from 'lucide-static/icons/rotate-ccw.svg?raw';
  import { sizeIcon } from '../lib/icons';
  import {
    projectStackClass,
    resolveProjectStackSpacing,
    reorderProjectStackSpacingSeams,
    setProjectStackSpacingAtViewport,
    type ProjectStackSpacingResolved,
    type ProjectStackSpacingValue,
    type ProjectStackSpacingViewport,
  } from '../lib/projectStack';
  import { restoreCarouselActiveItem } from '../lib/projectImageCarousel';
  import { createPageScope, onPageLoad } from '../lib/pageLifecycle';
  import {
    spacingButtonsHtml, pinGapToolbar as pinGapToolbarTop, unpinGapToolbar,
    GAP_ENTRY_RADIUS as SPACING_ENTRY_RADIUS_PX, GAP_RETENTION_RADIUS as SPACING_RETENTION_RADIUS_PX,
    GAP_INTENT_DELAY as SPACING_INTENT_DELAY_MS, GAP_FAST_POINTER as SPACING_FAST_POINTER_PX_PER_MS,
  } from '../lib/gapSpacingControl';

  const disposePage = onPageLoad(() => {
  const pageScope = createPageScope();
  type EditableTextValue = string | string[];
  type SpacingValue = ProjectStackSpacingValue;
  type SpacingMap = ProjectStackSpacingResolved;

  interface EditableTextState {
    element: HTMLElement;
    document: string;
    path: Array<string | number>;
    kind: 'text' | 'paragraphs';
    savedValue: EditableTextValue;
  }

  interface EditableSpacingState {
    element: HTMLElement;
    control: HTMLElement;
    addButton: HTMLButtonElement;
    spacingGroup: HTMLElement;
    resetButton: HTMLButtonElement;
    menu: HTMLElement;
    document: string;
    path: Array<string | number>;
    writePath: Array<string | number>;
    savedValue: SpacingMap;
    visualSavedValue: SpacingMap;
    currentValue: SpacingMap;
    introHeight: EditableIntroHeightState | null;
    resetVisibilitySynced: boolean;
  }

  interface EditableIntroHeightState {
    element: HTMLElement;
    input: HTMLInputElement;
    document: string;
    path: Array<string | number>;
    savedValue: number;
    currentValue: number;
  }

  type InsertableSectionType = 'bodyText' | 'sectionTitle' | 'projectDetails' | 'award' | 'image' | 'imageGrid' | 'imageCarousel';

  const cloneSpacing = (value: SpacingMap): SpacingMap => ({ ...value });
  const spacingEqual = (left: SpacingMap, right: SpacingMap) => (
    left.desktop === right.desktop && left.tablet === right.tablet && left.mobile === right.mobile
  );
  const currentSpacingViewport = (): ProjectStackSpacingViewport => {
    if (window.innerWidth <= 767) return 'mobile';
    if (window.innerWidth <= 991) return 'tablet';
    return 'desktop';
  };

  const spacingParentViewport = (viewport: ProjectStackSpacingViewport): ProjectStackSpacingViewport | null => {
    if (viewport === 'tablet') return 'desktop';
    if (viewport === 'mobile') return 'tablet';
    return null;
  };

  const isSpacingStackParent = (el: HTMLElement | null): el is HTMLElement =>
    Boolean(
      el && (
        el.hasAttribute('data-dev-project-drop-zone') ||
        el.classList.contains('project-page__main')
      ),
    );

  const isPageTopSpacingBlock = (element: HTMLElement) => {
    const parent = element.parentElement;
    if (!isSpacingStackParent(parent)) return false;
    const siblings = [...parent.children].filter(
      (child): child is HTMLElement =>
        child instanceof HTMLElement && child.hasAttribute('data-dev-spacing-document'),
    );
    return siblings[0] === element;
  };

  const isPageBottomSpacingBlock = (element: HTMLElement) => {
    const parent = element.parentElement;
    if (!isSpacingStackParent(parent)) return false;
    const siblings = [...parent.children].filter(
      (child): child is HTMLElement =>
        child instanceof HTMLElement && child.hasAttribute('data-dev-spacing-document'),
    );
    return siblings.at(-1) === element;
  };

  /** Intro blocks sit flush under the header, so their page-top spacing toolbar is redundant. */
  const suppressGalleryPageTopSpacing = (element: HTMLElement, pageTop: boolean) => {
    if (!pageTop) return false;
    const documentKey = element.dataset.devSpacingDocument;
    if (documentKey !== 'home' && documentKey !== 'play') return false;
    return element.dataset.devIntro === 'true';
  };

  let editorAbortController: AbortController | null = null;
  let branchUpdatePollTimer: ReturnType<typeof setInterval> | null = null;

  const applySpacingClass = (element: HTMLElement, spacing: SpacingMap) => {
    const active = spacing[currentSpacingViewport()];
    const desktopClasses = projectStackClass(spacing).split(/\s+/)
      .filter((name) => name !== `project-stack--${spacing.desktop}`);
    element.className = element.className
      .split(/\s+/)
      .filter((name) => !/^project-stack--(?:related|group|section|major|none|tablet-|mobile-)/.test(name))
      .concat(`project-stack--${active}`, desktopClasses)
      .filter(Boolean)
      .join(' ');
    element.dataset.devSpacingValue = active;
    element.dataset.devSpacingValues = JSON.stringify(spacing);
  };

  const followsHiddenTitle = (element: HTMLElement) => {
    const prev = element.previousElementSibling;
    if (!(prev instanceof HTMLElement)) return false;
    const title = prev.querySelector<HTMLElement>(':scope > .project-section-title');
    return Boolean(title && getComputedStyle(title).display === 'none');
  };

  const initDevTextEditor = () => {


    const actions = document.querySelector<HTMLElement>('[data-dev-text-actions]');
    const saveButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-save]');
    const publishButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-publish]');
    const commitStylesButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-commit-styles]');
    const revertButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-revert]');
    const status = actions?.querySelector<HTMLElement>('[data-dev-text-status]');
    const branchLabel = actions?.querySelector<HTMLElement>('[data-dev-text-branch]');
    const warnLabel = actions?.querySelector<HTMLElement>('[data-dev-text-warn]');
    const branchUpdateActions = document.querySelector<HTMLElement>('[data-dev-branch-update-actions]');
    const branchUpdateButton = branchUpdateActions?.querySelector<HTMLButtonElement>('[data-dev-branch-update]');
    const branchUpdateStatus = branchUpdateActions?.querySelector<HTMLElement>('[data-dev-branch-update-status]');
    const formatBar = document.querySelector<HTMLElement>('[data-dev-text-format]');
    const formatSel = document.querySelector<HTMLElement>('[data-dev-text-format-sel]');
    const linkPanel = formatBar?.querySelector<HTMLFormElement>('[data-dev-text-link-panel]');
    const linkInput = formatBar?.querySelector<HTMLInputElement>('[data-dev-text-link-input]');
    const unlinkButton = formatBar?.querySelector<HTMLButtonElement>('[data-dev-text-unlink]');
    const blockStyleSelect = formatBar?.querySelector<HTMLSelectElement>('[data-dev-block-style]');
    const emphasisStyleSelect = formatBar?.querySelector<HTMLSelectElement>('[data-dev-emphasis-style]');
    const wrapStyleSelect = formatBar?.querySelector<HTMLSelectElement>('[data-dev-wrap-style]');
    const emphasisStyleField = formatBar?.querySelector<HTMLElement>('.dev-text-format__emphasis-style');
    const wrapStyleField = formatBar?.querySelector<HTMLElement>('.dev-text-format__wrap-style');
    const formatInline = formatBar?.querySelector<HTMLElement>('[data-dev-format-inline]');
    const formatButtons = formatBar
      ? [...formatBar.querySelectorAll<HTMLButtonElement>('[data-dev-format]')]
      : [];
    const textElements = [
      ...document.querySelectorAll<HTMLElement>('[data-dev-text-document][data-dev-text-path]'),
    ];
    const spacingElements = [
      ...document.querySelectorAll<HTMLElement>('[data-dev-spacing-document][data-dev-spacing-path]'),
    ];
    if (!actions || !saveButton || !publishButton || !commitStylesButton || !revertButton || !status || !branchLabel || !warnLabel) return;
    if (!branchUpdateActions || !branchUpdateButton || !branchUpdateStatus) return;
    if (!formatBar || !formatSel || !linkPanel || !linkInput || !unlinkButton || !blockStyleSelect || !emphasisStyleSelect || !wrapStyleSelect || !emphasisStyleField || !formatInline) return;

    const isFormatBarTarget = (node: Node | null) => {
      if (!node) return false;
      if (formatBar.contains(node)) return true;
      const element = node instanceof Element ? node : node.parentElement;
      const popup = element?.closest<HTMLElement>('[data-editor-select-popup]');
      const trigger = popup?.dataset.editorSelectOwner ? document.getElementById(popup.dataset.editorSelectOwner) : null;
      return Boolean(trigger && formatBar.contains(trigger));
    };

    editorAbortController?.abort();
    editorAbortController = new AbortController();
    const editorSignal = editorAbortController.signal;
    const phoneEditor = window.matchMedia('(max-width: 40em)');
    const siteHeader = document.querySelector<HTMLElement>('.site-header');
    let headerInertBeforeTyping: boolean | null = null;
    const canEditText = (element: HTMLElement) =>
      !phoneEditor.matches || element.dataset.devTextDocument !== 'header-settings';
    const syncFormatControlOrder = () => {
      const row = formatInline.parentElement;
      if (!row || (phoneEditor.matches ? row.firstElementChild : row.lastElementChild) === formatInline) return;
      const focused = document.activeElement;
      if (phoneEditor.matches) row.prepend(formatInline);
      else row.append(formatInline);
      if (focused instanceof HTMLElement && formatInline.contains(focused)) focused.focus({ preventScroll: true });
    };
    syncFormatControlOrder();
    phoneEditor.addEventListener('change', syncFormatControlOrder, { signal: editorSignal });
    installHistoryShortcuts(editorSignal);
    bindProjectAwardEditors(editorSignal);
    if (branchUpdatePollTimer) clearInterval(branchUpdatePollTimer);
    branchUpdatePollTimer = null;

    document.documentElement.dataset.devTextEditorInit = '1';
    initDevSectionOutlineSync();

    type PendingMediaChange = {
      id: string;
      kind: 'crop' | 'grid' | 'carousel' | 'caption' | 'listing-order' | 'section-order' | 'placeholder-fill' | 'style-token' | 'section-nav' | 'media-remove' | 'project-settings' | 'gallery-membership' | 'project-details-rows' | 'annotation';
      payload: Record<string, unknown>;
      revert: () => void;
      prepare?: () => Record<string, unknown>;
      /** Live section root for placeholder fills — index is read from it at Save. */
      root?: HTMLElement;
    };

    type PendingSectionDelete = {
      documentKey: string;
      deletedIndex: number;
      root: HTMLElement;
      insertBefore: ChildNode | null;
      textStates: EditableTextState[];
      spacingState: EditableSpacingState | null;
      pendingMedia: PendingMediaChange[];
      pendingInsert?: PendingSectionInsert;
      persistedInsert?: PersistedMediaInsert;
      converts: PendingBlockConvert[];
      restoreToken?: string;
      outlineRevert: {
        document: string;
        action: 'insert';
        outlineEntries: OutlineEntry[];
        index: number;
        type?: string;
        section: Record<string, unknown>;
      };
    };

    type PendingSectionInsert = {
      documentKey: string;
      index: number;
      type: string;
      restoreToken?: string;
      spacing: SpacingValue;
      sectionId: string;
      root: HTMLElement;
      textStates: EditableTextState[];
      spacingState: EditableSpacingState | null;
      level?: 2 | 3;
      intro?: boolean;
    };

    type PersistedMediaInsert = {
      documentKey: string;
      index: number;
      root: HTMLElement;
      section: Record<string, unknown>;
    };

    type PendingBlockConvert = {
      documentKey: string;
      index: number;
      from: 'bodyText' | 'sectionTitle';
      to: 'bodyText' | 'sectionTitle';
      level?: 2 | 3;
      root: HTMLElement;
      previousRoot: HTMLElement;
      previousTextElement: HTMLElement;
      previousPath: Array<string | number>;
      previousKind: EditableTextState['kind'];
      previousSpacingState: EditableSpacingState | null;
      previousRootId?: string;
      outlineAction?: 'insert' | 'delete';
      outlineSectionId?: string;
      outlineTitle?: string;
      textState: EditableTextState;
      replacedRoot: boolean;
      skipPersist?: boolean;
    };

    const pendingMedia = new Map<string, PendingMediaChange>();
    const pendingSectionDeletes: PendingSectionDelete[] = [];
    const pendingSectionInserts: PendingSectionInsert[] = [];
    const persistedMediaInserts: PersistedMediaInsert[] = [];
    const pendingBlockConverts: PendingBlockConvert[] = [];
    const serverSectionIds = new Map<string, Map<string, string>>();
    const persistedChanges = new WeakSet<PendingMediaChange>();

    const cleanText = (value: string) => value.replaceAll('\u00a0', ' ');
    const createParagraphPlaceholderBreak = () => {
      const br = document.createElement('br');
      br.setAttribute(PARAGRAPH_PLACEHOLDER_ATTRIBUTE, 'true');
      return br;
    };
    const fillParagraph = (paragraph: HTMLElement, html: string) => {
      paragraph.removeAttribute('data-text-wrap');
      if (html) paragraph.innerHTML = html;
      else paragraph.replaceChildren(createParagraphPlaceholderBreak());
    };
    const readValue = (state: Pick<EditableTextState, 'element' | 'kind'>): EditableTextValue =>
      state.kind === 'paragraphs'
        ? readParagraphsValue(state.element)
        : readPlainDomText(state.element);
    const valuesMatch = (left: EditableTextValue, right: EditableTextValue) =>
      JSON.stringify(left) === JSON.stringify(right);
    const renderValue = (state: EditableTextState, value: EditableTextValue) => {
      if (state.kind === 'paragraphs' && Array.isArray(value)) {
        const texts = value.length ? value : [''];
        const paragraphs = texts.map((text) => {
          const paragraph = document.createElement('p');
          fillParagraph(paragraph, text);
          return paragraph;
        });
        state.element.replaceChildren(...paragraphs);
        return;
      }
      state.element.textContent = typeof value === 'string' ? value : value.join('\n');
    };

    const textStates = textElements.flatMap<EditableTextState>((element) => {
      try {
        const path = JSON.parse(element.dataset.devTextPath || '[]');
        if (!Array.isArray(path) || !element.dataset.devTextDocument) return [];
        const state: EditableTextState = {
          element,
          document: element.dataset.devTextDocument,
          path,
          kind: element.dataset.devTextKind === 'paragraphs' ? 'paragraphs' : 'text',
          savedValue: '',
        };
        state.savedValue = readValue(state);
        return [state];
      } catch {
        return [];
      }
    });

    const syncSpacingControl = (state: EditableSpacingState) => {
      const viewport = currentSpacingViewport();
      const active = state.currentValue[viewport];
      state.control.querySelectorAll<HTMLButtonElement>('[data-dev-spacing-option]').forEach((button) => {
        button.classList.toggle('is-active', button.dataset.devSpacingOption === active);
      });
      const parentViewport = spacingParentViewport(viewport);
      const shouldShowReset = Boolean(
        parentViewport && state.currentValue[viewport] !== state.currentValue[parentViewport],
      );
      const wasShowingReset = !state.resetButton.hidden;
      state.resetButton.hidden = !shouldShowReset;
      if (parentViewport) {
        const parentLabel = parentViewport === 'desktop' ? 'desktop' : 'tablet';
        state.resetButton.title = `Reset to ${parentLabel}`;
        state.resetButton.setAttribute('aria-label', `Reset to ${parentLabel}`);
      }
      if (shouldShowReset && state.resetVisibilitySynced && !wasShowingReset) {
        state.resetButton.classList.remove('is-dev-spacing-reset-revealing');
        void state.resetButton.offsetWidth;
        state.resetButton.classList.add('is-dev-spacing-reset-revealing');
      }
      state.resetVisibilitySynced = true;
      applySpacingClass(state.element, state.currentValue);
      const dirty = !spacingEqual(state.currentValue, state.visualSavedValue);
      state.element.classList.toggle('is-dev-spacing-dirty', dirty);
    };

    const bindSpacingReset = (state: EditableSpacingState) => {
      state.resetButton.addEventListener('animationend', () => {
        state.resetButton.classList.remove('is-dev-spacing-reset-revealing');
      }, { signal: editorSignal });
      state.resetButton.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        state.resetButton.blur();
        const viewport = currentSpacingViewport();
        const parentViewport = spacingParentViewport(viewport);
        if (!parentViewport || state.currentValue[viewport] === state.currentValue[parentViewport]) return;
        pinGapToolbarTop(state.control);
        state.currentValue = setProjectStackSpacingAtViewport(
          state.currentValue,
          viewport,
          state.currentValue[parentViewport],
        );
        applySpacingClass(state.element, state.currentValue);
        window.dispatchEvent(new Event('vcd:intro-layout-sync'));
        syncSpacingControl(state);
        updateActions();
      }, { signal: editorSignal });
    };

    const syncIntroHeightControl = (state: EditableIntroHeightState) => {
      state.input.value = String(state.currentValue);
      state.element.dataset.devIntroHeightValue = String(state.currentValue);
      state.element.style.setProperty('--intro-height', String(state.currentValue));
      state.element.classList.toggle(
        'is-dev-intro-height-dirty',
        state.currentValue !== state.savedValue,
      );
      document.querySelectorAll<HTMLInputElement>(
        `[data-dev-intro-height-input][data-dev-intro-height-document="${CSS.escape(state.document)}"]`,
      ).forEach((input) => {
        input.value = String(state.currentValue);
      });
    };

    const bindIntroHeightInput = (state: EditableIntroHeightState) => {
      state.input.addEventListener('input', () => {
        const value = Number(state.input.value);
        if (!Number.isInteger(value) || value < 1 || value > 100) return;
        state.currentValue = value;
        state.element.dataset.devIntroHeightValue = String(value);
        state.element.style.setProperty('--intro-height', String(value));
        state.element.classList.toggle('is-dev-intro-height-dirty', value !== state.savedValue);
        window.dispatchEvent(new Event('vcd:intro-layout-sync'));
        spacingStates.forEach((candidate) => {
          if (candidate.document !== state.document || !candidate.introHeight || candidate.introHeight === state) return;
          candidate.introHeight.currentValue = value;
          syncIntroHeightControl(candidate.introHeight);
        });
        stickyStatus = '';
        updateActions();
      }, { signal: editorSignal });
      const commit = () => {
        const raw = state.input.value.trim();
        const value = Number(state.input.value);
        state.currentValue = raw && Number.isFinite(value)
          ? Math.min(100, Math.max(1, Math.round(value)))
          : state.currentValue;
        spacingStates.forEach((candidate) => {
          if (candidate.document !== state.document || !candidate.introHeight) return;
          candidate.introHeight.currentValue = state.currentValue;
          syncIntroHeightControl(candidate.introHeight);
        });
        window.dispatchEvent(new Event('vcd:intro-layout-sync'));
        syncIntroHeightControl(state);
        updateActions();
      };
      state.input.addEventListener('change', commit, { signal: editorSignal });
      state.input.addEventListener('blur', commit, { signal: editorSignal });
      state.input.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        state.input.blur();
      }, { signal: editorSignal });
    };

    const restoreGapToolbarTop = (control: HTMLElement) => {
      if (control.classList.contains('is-intro-leading-gap')) {
        control.style.top = 'calc(min(var(--intro-outer-air, 0px), var(--space-group)) / -2)';
      } else if (control.classList.contains('is-intro-trailing-gap')) {
        control.style.top = 'calc(0px - var(--intro-outer-air, 0px) + min(var(--intro-outer-air, 0px), var(--space-group)) / 2)';
      } else {
        control.style.removeProperty('top');
      }
    };

    const unpinGapToolbarTop = (control: HTMLElement) => {
      unpinGapToolbar(control);
      restoreGapToolbarTop(control);
    };

    const bindSpacingOptionClicks = (state: EditableSpacingState) => {
      state.control.querySelectorAll<HTMLButtonElement>('[data-dev-spacing-option]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          // Don't leave focus on the chip — that kept the freeze + scroll-lock
          // until a click elsewhere, instead of releasing on pointer leave.
          button.blur();
          const next = button.dataset.devSpacingOption as SpacingValue;
          const viewport = currentSpacingViewport();
          if (!next || next === state.currentValue[viewport]) return;
          // Pin before the margin changes — after applySpacingClass the
          // absolute midpoint has already moved.
          pinGapToolbarTop(state.control);
          const current = setProjectStackSpacingAtViewport(state.currentValue, viewport, next);
          state.currentValue = current;
          applySpacingClass(state.element, current);
          window.dispatchEvent(new Event('vcd:intro-layout-sync'));
          syncSpacingControl(state);
          updateActions();
        }, { signal: editorSignal });
      });
    };

    const rebuildSpacingOptionButtons = (
      state: EditableSpacingState,
      pageTop: boolean,
      pageBottom: boolean,
    ) => {
      state.spacingGroup.innerHTML = spacingButtonsHtml(pageTop, pageBottom);
      bindSpacingOptionClicks(state);
      syncSpacingControl(state);
      state.control.dataset.pageTop = pageTop ? 'true' : 'false';
      state.control.dataset.pageBottom = pageBottom ? 'true' : 'false';
    };

    /**
     * Page boundaries offer 0. When structure changes, rebuild option sets and
     * only coerce a former page-top 0 that has actually moved into the stack.
     */
    const syncPageTopSpacingControls = (coerce = true) => {
      spacingStates.forEach((state) => {
        const pageTop = isPageTopSpacingBlock(state.element);
        const pageBottom = isPageBottomSpacingBlock(state.element);
        const wasPageTop = state.control.dataset.pageTop === 'true';
        state.control.toggleAttribute(
          'data-dev-suppress-gallery-page-top',
          suppressGalleryPageTopSpacing(state.element, pageTop),
        );

        if (coerce && pageTop && !wasPageTop) {
          // Became page-top with between-sibling default — page top should be flush.
          const current = cloneSpacing(state.currentValue);
          const saved = cloneSpacing(state.savedValue);
          const visualSaved = cloneSpacing(state.visualSavedValue);
          (['desktop', 'tablet', 'mobile'] as const).forEach((viewport) => {
            if (current[viewport] === 'group' && saved[viewport] === 'group') {
              current[viewport] = 'none';
              saved[viewport] = 'none';
              visualSaved[viewport] = 'none';
            }
          });
          state.currentValue = current;
          state.savedValue = saved;
          state.visualSavedValue = visualSaved;
        }

        if (coerce && !pageTop && wasPageTop) {
          const current = cloneSpacing(state.currentValue);
          const saved = cloneSpacing(state.savedValue);
          const visualSaved = cloneSpacing(state.visualSavedValue);
          (['desktop', 'tablet', 'mobile'] as const).forEach((viewport) => {
            if (current[viewport] === 'none') {
              current[viewport] = 'group';
              if (saved[viewport] === 'none') {
                saved[viewport] = 'group';
                visualSaved[viewport] = 'group';
              }
            }
          });
          state.currentValue = current;
          state.savedValue = saved;
          state.visualSavedValue = visualSaved;
        }

        rebuildSpacingOptionButtons(state, pageTop, pageBottom);
      });
    };

    const mountSpacingControl = (element: HTMLElement): EditableSpacingState | null => {
      try {
        const path = JSON.parse(element.dataset.devSpacingPath || '[]');
        const writePath = element.dataset.devSpacingWritePath
          ? JSON.parse(element.dataset.devSpacingWritePath)
          : path;
        let raw: ProjectStackSpacingResolved;
        try {
          raw = resolveProjectStackSpacing(
            element.dataset.devSpacingValues
              ? JSON.parse(element.dataset.devSpacingValues)
              : element.dataset.devSpacingValue,
          );
        } catch {
          raw = resolveProjectStackSpacing('group');
        }
        if (!Array.isArray(path) || !Array.isArray(writePath) || !element.dataset.devSpacingDocument) return null;
        if (element.querySelector(':scope > [data-dev-spacing-control]')) return null;

        const pageTop = isPageTopSpacingBlock(element);
        const pageBottom = isPageBottomSpacingBlock(element);
        const initial = cloneSpacing(raw);
        const docKey = element.dataset.devSpacingDocument || '';
        const supportsIntro = docKey === 'home' || docKey === 'home-intro' || docKey === 'play' || docKey === 'about';
        const introMenuItem = supportsIntro
          ? '<button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="bodyText" data-dev-section-intro="true">Intro text</button><button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="sectionTitle" data-dev-section-intro="true">Intro heading</button>'
          : '';
        const isIntro = element.dataset.devIntro === 'true';
        const introHeightControl = isIntro
          ? `<label class="dev-intro-height-control">
              <span class="sr-only">Intro height</span>
              <input type="number" min="1" max="100" step="1" inputmode="numeric" aria-label="Intro height" data-dev-intro-height-input>
              <span aria-hidden="true">%</span>
            </label>`
          : '';

        const control = document.createElement('div');
        control.className = 'dev-gap-toolbar';
        control.setAttribute('data-dev-spacing-control', '');
        control.setAttribute('data-dev-mode-only', '');
        control.dataset.pageTop = pageTop ? 'true' : 'false';
        control.dataset.pageBottom = pageBottom ? 'true' : 'false';
        control.toggleAttribute(
          'data-dev-suppress-gallery-page-top',
          suppressGalleryPageTopSpacing(element, pageTop),
        );
        const devEnabled = isDevContentEditing();
        control.hidden = !devEnabled || followsHiddenTitle(element);
        control.innerHTML = `
          <div class="dev-gap-toolbar__pill dev-surface">
            <button
              type="button"
              class="dev-gap-toolbar__add"
              data-dev-section-add
              title="Add section"
              aria-label="Add section"
              aria-expanded="false"
              aria-haspopup="menu"
            >
              <span aria-hidden="true">${sizeIcon(plusIcon)}</span>
            </button>
            <span class="dev-hairline dev-hairline--vertical" role="presentation"></span>
            <div class="dev-gap-toolbar__spacing">
              ${spacingButtonsHtml(pageTop, pageBottom)}
            </div>
            <span class="dev-hairline dev-hairline--vertical dev-spacing-control__reset-separator" role="presentation"></span>
            <button
              type="button"
              class="dev-btn dev-btn--page dev-spacing-control__reset"
              data-dev-spacing-reset
              title="Reset to parent breakpoint"
              aria-label="Reset to parent breakpoint"
              hidden
            >
              <span class="dev-btn__icon" aria-hidden="true">${sizeIcon(rotateIcon, 16)}</span>
            </button>
            ${isIntro ? '<span class="dev-hairline dev-hairline--vertical dev-intro-height-separator" role="presentation"></span>' : ''}
            ${introHeightControl}
            <div class="dev-gap-toolbar__menu" data-dev-section-menu hidden role="menu" aria-orientation="horizontal">
              <span data-dev-normal-section-menu>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="bodyText">Text section</button>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="sectionTitle">Section header</button>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="projectDetails">Project details &amp; credits</button>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="award">Award</button>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="image">Image</button>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="imageGrid">Grid</button>
                <button type="button" class="dev-btn dev-btn--page" role="menuitem" data-dev-section-type="imageCarousel">Carousel</button>
              </span>
              <span data-dev-intro-section-menu>${introMenuItem}</span>
            </div>
          </div>
        `;

        const addButton = control.querySelector<HTMLButtonElement>('[data-dev-section-add]');
        const menu = control.querySelector<HTMLElement>('[data-dev-section-menu]');
        const spacingGroup = control.querySelector<HTMLElement>('.dev-gap-toolbar__spacing');
        const resetButton = control.querySelector<HTMLButtonElement>('[data-dev-spacing-reset]');
        if (!addButton || !menu || !spacingGroup || !resetButton) return null;

        const computed = getComputedStyle(element);
        if (computed.position === 'static') {
          element.style.position = 'relative';
        }
        element.prepend(control);

        let introHeightState: EditableIntroHeightState | null = null;
        const introHeightInput = control.querySelector<HTMLInputElement>('[data-dev-intro-height-input]');
        if (isIntro && introHeightInput) {
          introHeightInput.dataset.devIntroHeightDocument = element.dataset.devIntroHeightDocument || '';
          const introHeightPath = JSON.parse(element.dataset.devIntroHeightPath || '[]');
          const rawHeight = Number(element.dataset.devIntroHeightValue);
          const initialHeight = Number.isFinite(rawHeight)
            ? Math.min(100, Math.max(1, Math.round(rawHeight)))
            : 75;
          if (Array.isArray(introHeightPath) && element.dataset.devIntroHeightDocument) {
            introHeightState = {
              element,
              input: introHeightInput,
              document: element.dataset.devIntroHeightDocument,
              path: introHeightPath,
              savedValue: initialHeight,
              currentValue: initialHeight,
            };
            bindIntroHeightInput(introHeightState);
            syncIntroHeightControl(introHeightState);
          }
        }

        const state: EditableSpacingState = {
          element,
          control,
          addButton,
          spacingGroup,
          resetButton,
          menu,
          document: element.dataset.devSpacingDocument,
          path,
          writePath,
          savedValue: cloneSpacing(initial),
          visualSavedValue: cloneSpacing(initial),
          currentValue: cloneSpacing(initial),
          introHeight: introHeightState,
          resetVisibilitySynced: false,
        };
        bindSpacingOptionClicks(state);
        bindSpacingReset(state);
        syncSpacingControl(state);

        return state;
      } catch {
        return null;
      }
    };

    const spacingStates = spacingElements.flatMap<EditableSpacingState>((element) => {
      const state = mountSpacingControl(element);
      return state ? [state] : [];
    });
    const syncEmptyZoneState = () => {
      document.querySelectorAll<HTMLElement>('[data-dev-project-drop-zone]').forEach((zone) => {
        const empty = getSectionRoots(zone).length === 0;
        zone.classList.toggle('is-dev-empty-page', empty);
        spacingStates.filter((state) => state.element.parentElement === zone).forEach((state) => {
          const sentinel = state.element.dataset.devSpacingWritePath === '["trailingSpacing"]';
          state.control.classList.toggle('is-dev-empty-add', empty && sentinel);
        });
      });
    };
    let lastSpacingViewport = currentSpacingViewport();
    window.addEventListener('resize', () => {
      cancelGapRevealIntent();
      latestGapPointer = null;
      const viewport = currentSpacingViewport();
      if (viewport === lastSpacingViewport) return;
      lastSpacingViewport = viewport;
      spacingStates.forEach(syncSpacingControl);
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
    }, { signal: editorSignal });
    syncPageTopSpacingControls();
    syncEmptyZoneState();
    const scheduleEmptyZoneState = () => pageScope.frame(() => {
      syncEmptyZoneState();
      syncIntroRunControls();
      spacingStates.forEach(syncSpacingControl);
    });
    window.addEventListener('vcd:dev-section-structure-changed', scheduleEmptyZoneState, { signal: editorSignal });
    window.addEventListener('vcd:dev-section-reordered', scheduleEmptyZoneState, { signal: editorSignal });
    window.addEventListener('vcd:dev-pending-reverted', scheduleEmptyZoneState, { signal: editorSignal });
    window.addEventListener('vcd:dev-mode-change', scheduleEmptyZoneState, { signal: editorSignal });
    window.addEventListener('vcd:page-surface-change', scheduleEmptyZoneState, { signal: editorSignal });

    const bumpSectionPath = (
      path: Array<string | number>,
      fromIndex: number,
      delta: number,
    ) => {
      if (path[0] !== 'sections' || typeof path[1] !== 'number') return false;
      if (delta > 0) {
        if (path[1] < fromIndex) return false;
      } else if (path[1] <= fromIndex) {
        return false;
      }
      path[1] += delta;
      return true;
    };

    const isPathPendingMediaChange = (change: PendingMediaChange) =>
      change.kind === 'crop'
      || change.kind === 'grid'
      || change.kind === 'carousel'
      || change.kind === 'caption';
    const readPendingMediaPath = (change: PendingMediaChange) => {
      const path = change.payload.path;
      return Array.isArray(path) ? path : null;
    };
    const shiftPendingMediaPath = (change: PendingMediaChange, fromIndex: number, delta: number) => {
      if (!isPathPendingMediaChange(change)) return;
      const path = readPendingMediaPath(change);
      if (!path) return;
      const nextPath = [...path];
      if (!bumpSectionPath(nextPath, fromIndex, delta)) return;
      change.payload = { ...change.payload, path: nextPath };
    };

    const remapPathsInStates = (indexMap: Record<number, number>, documentKey: string) => {
      textStates.forEach((state) => {
        if (state.document !== documentKey) return;
        if (state.path[0] === 'sections' && typeof state.path[1] === 'number') {
          const newIdx = indexMap[state.path[1]];
          if (newIdx !== undefined) state.path[1] = newIdx;
        }
      });
      spacingStates.forEach((state) => {
        if (state.document !== documentKey) return;
        if (state.path[0] === 'sections' && typeof state.path[1] === 'number') {
          const newIdx = indexMap[state.path[1]];
          if (newIdx !== undefined) state.path[1] = newIdx;
        }
      });
      spacingStates.forEach((state) => {
        if (state.document !== documentKey || !state.introHeight) return;
        const newIdx = indexMap[state.introHeight.path[1] as number];
        if (newIdx !== undefined) state.introHeight.path[1] = newIdx;
      });
      pendingMedia.forEach((change) => {
        if (
          !isPathPendingMediaChange(change)
          || String(change.payload.document || '') !== documentKey
          || readPendingMediaPath(change)?.[0] !== 'sections'
        ) return;
        const path = readPendingMediaPath(change);
        if (!path || typeof path[1] !== 'number') return;
        const newIdx = indexMap[path[1]];
        if (newIdx === undefined) return;
        change.payload = { ...change.payload, path: ['sections', newIdx, ...path.slice(2)] };
      });
    };

    const reindexDevPaths = (fromIndex: number, delta: number, documentKey: string) => {
      // Order ids are not in DEV_PATH_ATTRS but track the same JSON index, so
      // they have to move with the paths. Every caller mutates the DOM either
      // before the new root is attached or after the old one is detached, so
      // the shifted set never includes the block being added or removed.
      const zone = getDropZone(documentKey);
      if (!zone) return;
      shiftSectionOrderIds(fromIndex, delta, zone);
      zone.querySelectorAll<HTMLElement>(DEV_PATH_ATTRS.map((attr) => `[${attr}]`).join(',')).forEach((el) => {
        DEV_PATH_ATTRS.forEach((attr) => {
          const raw = el.getAttribute(attr);
          if (!raw) return;
          try {
            const path = JSON.parse(raw);
            if (!Array.isArray(path)) return;
            if (bumpSectionPath(path, fromIndex, delta)) {
              el.setAttribute(attr, JSON.stringify(path));
            }
          } catch {
            // Ignore malformed paths.
          }
        });
      });
      textStates.forEach((state) => {
        if (state.document !== documentKey) return;
        bumpSectionPath(state.path, fromIndex, delta);
      });
      spacingStates.forEach((state) => {
        if (state.document !== documentKey) return;
        bumpSectionPath(state.path, fromIndex, delta);
        if (state.introHeight) bumpSectionPath(state.introHeight.path, fromIndex, delta);
      });
      pendingBlockConverts.forEach((entry) => {
        if (entry.documentKey !== documentKey) return;
        // Connected roots already moved with the document query above.
        if (entry.previousRoot !== entry.root && !entry.previousRoot.isConnected) {
          bumpPathAttrsOnElement(entry.previousRoot, fromIndex, delta);
        }
        bumpSectionPath(entry.previousPath, fromIndex, delta);
        if (delta > 0) {
          if (entry.index >= fromIndex) entry.index += delta;
        } else if (entry.index > fromIndex) {
          entry.index += delta;
        }
      });
      pendingMedia.forEach((change) => {
        if (String(change.payload.document || '') !== documentKey) return;
        shiftPendingMediaPath(change, fromIndex, delta);
      });
    };

    const bumpPathAttrsOnElement = (element: HTMLElement, fromIndex: number, delta: number) => {
      const selector = DEV_PATH_ATTRS.map((attr) => `[${attr}]`).join(',');
      const nodes = [element, ...element.querySelectorAll<HTMLElement>(selector)];
      nodes.forEach((el) => {
        DEV_PATH_ATTRS.forEach((attr) => {
          const raw = el.getAttribute(attr);
          if (!raw) return;
          try {
            const path = JSON.parse(raw);
            if (!Array.isArray(path)) return;
            if (bumpSectionPath(path, fromIndex, delta)) {
              el.setAttribute(attr, JSON.stringify(path));
            }
          } catch {
            // Ignore malformed paths.
          }
        });
      });
    };

    /** Text entry proper — not a checkbox, range or select a tuner uses for settings. */
    const isTextEntryField = (element: HTMLElement) => {
      if (element instanceof HTMLTextAreaElement) return true;
      if (!(element instanceof HTMLInputElement)) return false;
      return ['text', 'search', 'url', 'email', 'tel'].includes(element.type);
    };

    const isDevTextCaretActive = () => {
      const active = document.activeElement;
      if (!(active instanceof HTMLElement)) return false;
      // Generic first: any focused editing host — grid card titles
      // (DevProjectGridEditor), inline captions, section nav labels — counts,
      // not just this component's own tracked body-text fields.
      if (active.isContentEditable) return true;
      // Panel text fields count too. Clicking into an existing caption enables
      // inline contenteditable, but "Add caption" focuses the tuner's own
      // <textarea>, which is just as much an active text affordance.
      if (isTextEntryField(active)) return true;
      return textStates.some(
        (state) => state.element === active || state.element.contains(active),
      );
    };

    // Esc hides gap chrome; pointermove must not re-reveal until the cursor
    // leaves every gap hitbox and activation radius.
    let suppressGapProximity = false;
    let gapRevealTimer: ReturnType<typeof window.setTimeout> | null = null;
    let gapRevealTarget: EditableSpacingState | null = null;
    let gapRevealReadyTarget: EditableSpacingState | null = null;
    let latestGapPointer: { clientX: number; clientY: number; time: number } | null = null;

    const cancelGapRevealIntent = () => {
      if (gapRevealTimer !== null) window.clearTimeout(gapRevealTimer);
      gapRevealTimer = null;
      gapRevealTarget = null;
      gapRevealReadyTarget = null;
    };
    editorSignal.addEventListener('abort', () => {
      latestGapPointer = null;
      cancelGapRevealIntent();
    }, { once: true });

    const scheduleGapRevealIntent = (target: EditableSpacingState) => {
      if (gapRevealTarget === target && gapRevealTimer !== null) return;
      if (gapRevealTimer !== null) window.clearTimeout(gapRevealTimer);
      gapRevealTarget = target;
      gapRevealReadyTarget = null;
      gapRevealTimer = pageScope.timeout(() => {
        gapRevealTimer = null;
        const readyTarget = gapRevealTarget;
        if (!readyTarget || !latestGapPointer) return;
        gapRevealReadyTarget = readyTarget;
        syncSpacingProximity(latestGapPointer.clientX, latestGapPointer.clientY);
        if (gapRevealReadyTarget === readyTarget) gapRevealReadyTarget = null;
      }, SPACING_INTENT_DELAY_MS);
    };

    const syncGapToolbarTopPin = (control: HTMLElement, pinned: boolean) => {
      if (pinned) {
        pinGapToolbarTop(control);
        return;
      }
      unpinGapToolbarTop(control);
    };

    const clearGapProximity = (control: HTMLElement) => {
      if (
        control.classList.contains('is-menu-open')
        || control.classList.contains('is-menu-closing')
      ) {
        control.classList.remove('is-near-add', 'is-near-spacing');
        return;
      }
      control.classList.remove('is-near-add', 'is-near-spacing');
      syncGapToolbarTopPin(control, false);
    };

    /**
     * Scroll lock only while the pill is actually up (near / menu) and
     * the pointer is on it. Invisible pills still have a layout box in the gap
     * middle — matching that alone blocked page scroll down the centre column.
     */
    const preventScrollWhileGapToolbarHeld = (event: Event) => {
      let x = 0;
      let y = 0;
      if (event instanceof WheelEvent) {
        x = event.clientX;
        y = event.clientY;
      } else if (event instanceof TouchEvent) {
        const touch = event.touches[0];
        if (!touch) return;
        x = touch.clientX;
        y = touch.clientY;
      } else {
        return;
      }
      const openMenu = spacingStates.find((state) =>
        state.control.classList.contains('is-menu-open'));
      if (openMenu && !isPointerOverToolbarHitbox(openMenu, x, y)) {
        closeSectionMenus(undefined, true);
        clearGapProximityAll();
        suppressGapProximity = true;
        return;
      }
      const held = spacingStates.some((state) => {
        if (state.control.hidden || !isActiveSpacingState(state)) return false;
        const pillUp =
          state.control.classList.contains('is-near-add')
          || state.control.classList.contains('is-near-spacing')
          || state.control.classList.contains('is-menu-open');
        if (!pillUp) return false;
        return isPointerOverToolbarHitbox(state, x, y);
      });
      const target = event.target;
      const menu = target instanceof Element
        ? target.closest<HTMLElement>('.dev-gap-toolbar__menu')
        : null;
      if (menu && menu.scrollWidth > menu.clientWidth) {
        if (event instanceof WheelEvent && event.deltaX === 0 && !event.shiftKey) {
          event.preventDefault();
        }
        return;
      }
      if (held) event.preventDefault();
    };

    const clearGapProximityAll = () => {
      cancelGapRevealIntent();
      spacingStates.forEach(({ control }) => clearGapProximity(control));
      document.documentElement.classList.remove('is-page-top-gap-above-header');
    };

    /** After Add-block menu picks a type, drop gap chrome until the cursor leaves. */
    const dismissGapToolbarAfterAddChoice = () => {
      closeSectionMenus();
      clearGapProximityAll();
      suppressGapProximity = true;
      document.querySelectorAll<HTMLElement>('.is-dev-section-controls-visible').forEach((el) => {
        el.classList.remove('is-dev-section-controls-visible');
      });
    };

    const syncSpacingCaretSuppression = () => {
      const active = document.activeElement;
      const formatting = isFormatBarTarget(active);
      const suppressed = isDevTextCaretActive() || formatting;
      document.documentElement.classList.toggle('is-dev-text-caret', suppressed);
      const mobileTextFocus = phoneEditor.matches && isDevContentEditing()
        && (formatting || (active instanceof HTMLElement && active.isContentEditable));
      document.documentElement.classList.toggle('is-dev-mobile-text-focus', mobileTextFocus);
      if (siteHeader) {
        if (mobileTextFocus) {
          headerInertBeforeTyping ??= siteHeader.inert;
          siteHeader.inert = true;
        } else if (headerInertBeforeTyping !== null) {
          siteHeader.inert = headerInertBeforeTyping;
          headerInertBeforeTyping = null;
        }
      }
      if (!mobileTextFocus) document.documentElement.style.removeProperty('--dev-mobile-format-space');
      if (suppressed) clearGapProximityAll();
    };
    editorSignal.addEventListener('abort', () => {
      document.documentElement.classList.remove('is-dev-mobile-text-focus');
      document.documentElement.style.removeProperty('--dev-mobile-format-space');
      if (siteHeader && headerInertBeforeTyping !== null) siteHeader.inert = headerInertBeforeTyping;
    }, { once: true });
    phoneEditor.addEventListener('change', syncSpacingCaretSuppression, { signal: editorSignal });

    const syncSpacingControlVisibility = () => {
      const devEnabled = isDevContentEditing();
      spacingStates.forEach(({ control, element }) => {
        const suppressed = followsHiddenTitle(element);
        control.hidden = !devEnabled || suppressed;
        if (suppressed) {
          cancelGapRevealIntent();
          clearGapProximity(control);
        }
      });
      if (!devEnabled) document.documentElement.classList.remove('is-page-top-gap-above-header');
    };

    /** Distance to the closest point on a rect (0 if inside) — symmetric halo. */
    const distanceToRect = (rect: DOMRect, clientX: number, clientY: number) => {
      const dx = clientX < rect.left ? rect.left - clientX : clientX > rect.right ? clientX - rect.right : 0;
      const dy = clientY < rect.top ? rect.top - clientY : clientY > rect.bottom ? clientY - rect.bottom : 0;
      return Math.hypot(dx, dy);
    };

    /**
     * Unified pill vicinity. Measuring Add and spacing centres separately biased
     * the halo left (small Add target) and starved the right edge.
     */
    const distanceToToolbarPill = (
      state: EditableSpacingState,
      clientX: number,
      clientY: number,
    ) => {
      const pill = state.control.querySelector<HTMLElement>('.dev-gap-toolbar__pill');
      if (!pill) return Number.POSITIVE_INFINITY;
      return distanceToRect(pill.getBoundingClientRect(), clientX, clientY);
    };

    const isPointerNearDrawingControls = (clientX: number, clientY: number) =>
      [...document.querySelectorAll<HTMLElement>('.site-draw-controls, .site-draw-launcher:not([hidden])')]
        .some((control) => {
          const rect = control.getBoundingClientRect();
          return rect.width > 0 && rect.height > 0
            && distanceToRect(rect, clientX, clientY) <= SPACING_ENTRY_RADIUS_PX;
        });

    const isSectionMenuOpen = (state: EditableSpacingState) =>
      state.control.classList.contains('is-menu-open');

    const isAddControlPinned = (state: EditableSpacingState) =>
      isSectionMenuOpen(state) ||
      state.addButton === document.activeElement ||
      state.menu.contains(document.activeElement);

    const isSpacingControlPinned = (state: EditableSpacingState) =>
      state.spacingGroup.contains(document.activeElement);

    const isPointerOverToolbarHitbox = (
      state: EditableSpacingState,
      clientX: number,
      clientY: number,
    ) => {
      const pill = state.control.querySelector<HTMLElement>('.dev-gap-toolbar__pill');
      const boxes = [pill, state.menu].filter((el): el is HTMLElement => Boolean(el && !el.hidden));
      return boxes.some((el) => {
        const box = el.getBoundingClientRect();
        return (
          clientX >= box.left &&
          clientX <= box.right &&
          clientY >= box.top &&
          clientY <= box.bottom
        );
      });
    };

    const isPageTopGapControl = (control: HTMLElement) => control.dataset.pageTop === 'true';

    /** Escape drop-zone isolation so page-top chips paint/hit above the sticky header. */
    const syncPageTopGapStacking = () => {
      const pageTopActive = spacingStates.some(
        ({ control }) =>
          isPageTopGapControl(control) &&
          !control.hidden &&
          (control.classList.contains('is-near-add') ||
            control.classList.contains('is-near-spacing') ||
            control.classList.contains('is-menu-open') ||
            control.classList.contains('is-menu-closing')),
      );
      const root = document.documentElement;
      const wasActive = root.classList.contains('is-page-top-gap-above-header');
      root.classList.toggle('is-page-top-gap-above-header', pageTopActive);
      if (pageTopActive && !wasActive) {
        document.dispatchEvent(new CustomEvent('header:force-close'));
      }
    };

    const sectionMenuCloseTimers = new WeakMap<HTMLElement, number>();

    const cancelSectionMenuClose = (state: EditableSpacingState) => {
      const timer = sectionMenuCloseTimers.get(state.control);
      if (timer !== undefined) window.clearTimeout(timer);
      sectionMenuCloseTimers.delete(state.control);
      state.control.classList.remove('is-menu-closing');
    };

    const closeSectionMenus = (except?: EditableSpacingState, animate = false) => {
      spacingStates.forEach((state) => {
        if (except && state === except) return;
        cancelSectionMenuClose(state);
        state.addButton.setAttribute('aria-expanded', 'false');
        state.control.classList.remove('is-menu-open');
        state.control.classList.remove('is-near-add', 'is-near-spacing');
        const active = document.activeElement;
        if (active instanceof HTMLElement && state.control.contains(active)) active.blur();
        const shouldAnimate = animate
          && !state.menu.hidden
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!shouldAnimate) {
          state.menu.hidden = true;
          syncGapToolbarTopPin(state.control, false);
          return;
        }
        // Release the interaction freeze before the wheel/touch scroll lands,
        // so the closing pill and menu travel with their document anchor.
        unpinGapToolbarTop(state.control);
        state.control.classList.add('is-menu-closing');
        sectionMenuCloseTimers.set(state.control, pageScope.timeout(() => {
          sectionMenuCloseTimers.delete(state.control);
          state.menu.hidden = true;
          state.control.classList.remove('is-menu-closing');
          syncGapToolbarTopPin(state.control, false);
          syncPageTopGapStacking();
        }, 180));
      });
      syncPageTopGapStacking();
    };

    /**
     * Header chrome sits above mid-page gap toolbars in paint order (drop zone
     * z-index 25 vs header 50). Page-top chips lift the drop zone above the
     * header while active — see syncPageTopGapStacking. Use geometry (not
     * elementFromPoint) so an already-visible chip doesn't keep itself alive.
     */
    const isPointerOverHeaderChrome = (clientX: number, clientY: number) => {
      const header = document.querySelector('.site-header');
      if (!header || header.closest('[hidden], [inert]')) return false;
      return [...header.querySelectorAll<HTMLElement>('.header-trigger')].some((trigger) => {
        if (trigger.closest('[hidden], [inert]')) return false;
        const panel = trigger.querySelector<HTMLElement>('.header-trigger__panel');
        const box =
          trigger.classList.contains('is-menu-open') && panel
            ? panel.getBoundingClientRect()
            : trigger.getBoundingClientRect();
        return (
          clientX >= box.left &&
          clientX <= box.right &&
          clientY >= box.top &&
          clientY <= box.bottom
        );
      });
    };

    /**
     * Centre + and right-edge spacing reveal independently. Within each
     * control type, only the nearest in-range target wins — thin sections
     * otherwise stack two toolbars and the lower one steals clicks.
     */
    const gapsSuppressed = () =>
      isDevTextCaretActive()
      || document.documentElement.classList.contains('is-section-reorder-dragging')
      || document.documentElement.classList.contains('is-dev-asset-manager-open')
      || document.documentElement.classList.contains('is-dev-tuner-open')
      || document.documentElement.hasAttribute('data-dev-image-drop-choice-open');

    const isActiveSpacingState = (state: EditableSpacingState) => {
      const zone = state.element.closest<HTMLElement>('[data-dev-project-drop-zone]');
      return Boolean(zone && !zone.closest('[hidden], [inert]') && getDropZone(state.document) === zone);
    };

    const syncSpacingProximity = (clientX: number, clientY: number) => {
      // Visible drawing controls own their vicinity, even when a gap pill paints above them.
      if (document.documentElement.hasAttribute('data-site-draw-menu-open')
        || isPointerNearDrawingControls(clientX, clientY)) {
        cancelGapRevealIntent();
        closeSectionMenus();
        spacingStates.forEach(({ control }) => clearGapProximity(control));
        syncPageTopGapStacking();
        return;
      }
      if (
        !isDevContentEditing()
        || gapsSuppressed()
      ) {
        cancelGapRevealIntent();
        spacingStates.forEach(({ control }) => {
          if (!control.classList.contains('is-menu-open')) clearGapProximity(control);
        });
        document.documentElement.classList.remove('is-page-top-gap-above-header');
        return;
      }

      if (suppressGapProximity) {
        cancelGapRevealIntent();
        const stillNear = spacingStates.some((state) => {
          if (state.control.hidden || !isActiveSpacingState(state)) return false;
          if (isPointerOverToolbarHitbox(state, clientX, clientY)) return true;
          return distanceToToolbarPill(state, clientX, clientY) <= SPACING_RETENTION_RADIUS_PX;
        });
        if (stillNear) {
          closeSectionMenus();
          spacingStates.forEach(({ control }) => clearGapProximity(control));
          syncPageTopGapStacking();
          return;
        }
        suppressGapProximity = false;
      }

      // Open add-menu owns the page: other gaps must not light (their host
      // would share z-index 65 and paint over the expanded pill).
      const openMenuState = spacingStates.find(({ control }) =>
        control.classList.contains('is-menu-open'),
      );
      if (openMenuState) {
        cancelGapRevealIntent();
        spacingStates.forEach(({ control }) => {
          if (control === openMenuState.control) return;
          clearGapProximity(control);
        });
        openMenuState.control.classList.add('is-near-add');
        pinGapToolbarTop(openMenuState.control);
        syncPageTopGapStacking();
        return;
      }

      const overHeader = isPointerOverHeaderChrome(clientX, clientY);

      let nearest: EditableSpacingState | null = null;
      let nearestDistance = Infinity;

      spacingStates.forEach((state) => {
        if (state.control.hidden || !isActiveSpacingState(state)) return;
        // Mid-page chips stay suppressed under the sticky header; page-top may lift above it.
        if (overHeader && !isPageTopGapControl(state.control)) return;
        if (isAddControlPinned(state) || isSpacingControlPinned(state)) return;

        const distance = distanceToToolbarPill(state, clientX, clientY);
        const alreadyVisible =
          state.control.classList.contains('is-near-add') ||
          state.control.classList.contains('is-near-spacing') ||
          state.control.classList.contains('is-menu-open');
        const radius = alreadyVisible ? SPACING_RETENTION_RADIUS_PX : SPACING_ENTRY_RADIUS_PX;
        if (distance <= radius && distance < nearestDistance) {
          nearest = state;
          nearestDistance = distance;
        }
      });

      if (gapRevealReadyTarget && gapRevealReadyTarget !== nearest) gapRevealReadyTarget = null;
      const nearestIsVisible = nearest && (
        nearest.control.classList.contains('is-near-add')
        || nearest.control.classList.contains('is-near-spacing')
        || nearest.control.classList.contains('is-menu-open')
      );
      if (nearest && !nearestIsVisible && gapRevealReadyTarget !== nearest) {
        scheduleGapRevealIntent(nearest);
      } else if (!nearest || nearestIsVisible) {
        cancelGapRevealIntent();
      }

      spacingStates.forEach((state) => {
        const { control } = state;
        if (control.hidden) {
          clearGapProximity(control);
          return;
        }
        const allowNear = !overHeader || isPageTopGapControl(control);
        const alreadyVisible =
          control.classList.contains('is-near-add') ||
          control.classList.contains('is-near-spacing') ||
          control.classList.contains('is-menu-open');
        const settledReveal = state === nearest && gapRevealReadyTarget === state;
        // Intent reveals a hidden pill; retention keeps a visible pill available.
        const overHitbox = alreadyVisible && isPointerOverToolbarHitbox(state, clientX, clientY);
        const near = isAddControlPinned(state)
          || isSpacingControlPinned(state)
          || overHitbox
          || (allowNear && state === nearest && (alreadyVisible || settledReveal));
        control.classList.toggle('is-near-add', near);
        control.classList.toggle('is-near-spacing', near);
        // Focus must not keep the freeze — chip clicks blur; pin follows the
        // pointer only when the pill is already up (same rule as scroll lock).
        const keepPinned =
          overHitbox
          || control.classList.contains('is-menu-open');
        syncGapToolbarTopPin(control, keepPinned);
      });
      if (gapRevealReadyTarget && gapRevealReadyTarget === nearest) gapRevealReadyTarget = null;
      syncPageTopGapStacking();
    };

    // Caret suppression is about *any* editing surface, not gap controls, so it
    // registers unconditionally. Gallery pages carry no spacing elements, and
    // while these lived inside the `spacingStates.length` guard below they never
    // bound there at all — which is why a caret in a card title faded nothing.
    document.addEventListener('focusin', syncSpacingCaretSuppression, { signal: editorSignal });
    document.addEventListener('focusout', () => {
      // focusout fires before the next focus target is active
      pageScope.frame(() => {
        syncSpacingCaretSuppression();
        scheduleFormatBarUpdate();
        // Drop sticky section chrome when leaving a text field so the drag
        // grip doesn't linger after click-away while controls-visible is set.
        if (!isDevTextCaretActive()) {
          document.querySelectorAll<HTMLElement>('.is-dev-section-controls-visible').forEach((el) => {
            if (!el.matches(':hover')) el.classList.remove('is-dev-section-controls-visible');
          });
        }
      });
    }, { signal: editorSignal });

    if (spacingStates.length) {
      document.addEventListener(
        'pointermove',
        (event) => {
          if (event.buttons !== 0) {
            latestGapPointer = null;
            cancelGapRevealIntent();
            return;
          }
          const previous = latestGapPointer;
          const timestamp = Number.isFinite(event.timeStamp) ? event.timeStamp : performance.now();
          const speed = previous && timestamp > previous.time
            ? Math.hypot(event.clientX - previous.clientX, event.clientY - previous.clientY)
              / (timestamp - previous.time)
            : 0;
          latestGapPointer = {
            clientX: event.clientX,
            clientY: event.clientY,
            time: timestamp,
          };
          if (speed > SPACING_FAST_POINTER_PX_PER_MS) cancelGapRevealIntent();
          syncSpacingProximity(event.clientX, event.clientY);
        }, { passive: true, signal: editorSignal });
      // While the pointer is on the pill/menu the page must not scroll — otherwise
      // the freeze and the gap diverge. Vicinity-only reveal still allows scroll.
      document.addEventListener('wheel', (event) => {
        cancelGapRevealIntent();
        preventScrollWhileGapToolbarHeld(event);
      }, { passive: false, signal: editorSignal });
      document.addEventListener('touchmove', (event) => {
        cancelGapRevealIntent();
        preventScrollWhileGapToolbarHeld(event);
      }, { passive: false, signal: editorSignal });
      window.addEventListener('scroll', () => {
        cancelGapRevealIntent();
        latestGapPointer = null;
      }, { capture: true, signal: editorSignal });
      // Header mouseenter can beat the next pointermove — sync first so page-top
      // chips lift above the nav before openMenu hit-tests.
      document.addEventListener('dev:sync-gap-proximity', ((event: CustomEvent<{ clientX: number; clientY: number }>) => {
        if (!latestGapPointer) return;
        latestGapPointer = {
          ...latestGapPointer,
          clientX: event.detail.clientX,
          clientY: event.detail.clientY,
        };
        syncSpacingProximity(event.detail.clientX, event.detail.clientY);
      }) as EventListener, { signal: editorSignal });
      document.addEventListener('dev:clear-gap-proximity', () => {
        if (document.documentElement.hasAttribute('data-dev-image-drop-choice-open')
          || document.documentElement.hasAttribute('data-site-draw-menu-open')) {
          closeSectionMenus();
        }
        clearGapProximityAll();
      }, { signal: editorSignal });
      document.documentElement.addEventListener('pointerleave', () => {
        latestGapPointer = null;
        cancelGapRevealIntent();
        spacingStates.forEach(({ control }) => {
          if (control.classList.contains('is-menu-open')) {
            control.classList.remove('is-near-spacing');
            syncPageTopGapStacking();
            return;
          }
          clearGapProximity(control);
        });
        document.documentElement.classList.remove('is-page-top-gap-above-header');
      }, { signal: editorSignal });
      // Tuner click doesn't move the pointer — drop near-gap classes immediately.
      window.addEventListener('vcd:dev-edit-open', clearGapProximityAll, { signal: editorSignal });
      document.addEventListener(
        'pointerdown',
        (event) => {
          latestGapPointer = null;
          cancelGapRevealIntent();
          const target = event.target;
          if (!(target instanceof Node)) return;
          const open = spacingStates.find((state) => isSectionMenuOpen(state));
          if (!open) return;
          if (open.control.contains(target)) return;
          closeSectionMenus();
        }, { capture: true, signal: editorSignal });
    }

    const dirtyTextStates = () =>
      textStates.filter((state) => !valuesMatch(readValue(state), state.savedValue));
    const dirtySpacingStates = () =>
      spacingStates.filter((state) => !spacingEqual(state.currentValue, state.savedValue));
    const dirtyIntroHeightStates = () =>
      [...spacingStates.reduce((states, state) => {
        if (!state.introHeight || state.introHeight.currentValue === state.introHeight.savedValue) return states;
        if (!states.has(state.document)) states.set(state.document, state.introHeight);
        return states;
      }, new Map<string, EditableIntroHeightState>()).values()];

    const syncIntroHeightDocument = (documentKey: string, value: number, savedValue = value) => {
      spacingStates.forEach((state) => {
        if (!state.introHeight || state.document !== documentKey) return;
        state.introHeight.currentValue = value;
        state.introHeight.savedValue = savedValue;
        syncIntroHeightControl(state.introHeight);
      });
    };

    const revertAllPending = () => {
      [...pendingMedia.values()].forEach((change) => {
        try {
          change.revert();
        } catch {
          // Keep reverting the rest even if one target was removed from the DOM.
        }
      });
      pendingMedia.clear();
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-reverted'));
    };

    const detachSectionStates = (element: HTMLElement) => {
      const texts = textStates.filter(
        (state) => element.contains(state.element) || state.element === element,
      );
      const spacing = spacingStates.find((state) => state.element === element) ?? null;
      texts.forEach((state) => {
        const index = textStates.indexOf(state);
        if (index >= 0) textStates.splice(index, 1);
      });
      if (spacing) {
        const index = spacingStates.indexOf(spacing);
        if (index >= 0) spacingStates.splice(index, 1);
      }
      return { texts, spacing };
    };

    const restorePendingSectionDelete = (pending: PendingSectionDelete) => {
      reindexDevPaths(pending.deletedIndex, 1, pending.documentKey);
      const anchor = findInsertAnchor(pending.deletedIndex, pending.documentKey);
      if (anchor) {
        anchor.before(pending.root);
      } else if (pending.insertBefore?.parentNode) {
        pending.insertBefore.parentNode.insertBefore(pending.root, pending.insertBefore);
      } else {
        getDropZone(pending.documentKey)?.append(pending.root);
      }

      textStates.push(...pending.textStates);
      if (pending.spacingState) {
        spacingStates.push(pending.spacingState);
      }
      pending.pendingMedia.forEach((change) => {
        const path = readPendingMediaPath(change);
        if (path && path[0] === 'sections' && typeof path[1] === 'number') {
          change.payload = { ...change.payload, path: ['sections', pending.deletedIndex, ...path.slice(2)] };
        }
        pendingMedia.set(change.id, change);
      });
      deletableSections.push(pending.root);
      mountDeleteButton(pending.root);
      syncDevModeOnSection(pending.root, document.documentElement.classList.contains('is-dev-mode'));

      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: pending.outlineRevert,
      }));
      syncPageTopSpacingControls();
    };

    const revertPendingBlockConverts = () => {
      if (!pendingBlockConverts.length) return;
      const pending = [...pendingBlockConverts].reverse();
      pendingBlockConverts.length = 0;
      pending.forEach((entry) => {
        const insert = pendingSectionInserts.find((item) => item.root === entry.root);
        if (entry.replacedRoot && entry.root.isConnected) {
          entry.root.replaceWith(entry.previousRoot);
        } else if (!entry.replacedRoot && entry.textState.element.isConnected) {
          entry.textState.element.replaceWith(entry.previousTextElement);
        }

        const delIdx = deletableSections.indexOf(entry.root);
        if (entry.replacedRoot && delIdx >= 0) {
          deletableSections[delIdx] = entry.previousRoot;
        }

        if (entry.replacedRoot) {
          const spacingIdx = spacingStates.findIndex((state) => state.element === entry.root);
          if (spacingIdx >= 0) spacingStates.splice(spacingIdx, 1);
          if (entry.previousSpacingState) {
            spacingStates.push(entry.previousSpacingState);
            if (insert) insert.spacingState = entry.previousSpacingState;
          } else if (!entry.previousRoot.querySelector(':scope > [data-dev-spacing-control]')) {
            const spacing = mountSpacingControl(entry.previousRoot);
            if (spacing) {
              spacingStates.push(spacing);
              wireSectionAddMenu(spacing);
            }
            if (insert) insert.spacingState = spacing ?? null;
          }
          mountDeleteButton(entry.previousRoot);
        }

        if (insert) {
          insert.root = entry.previousRoot;
          insert.type = entry.from === 'bodyText' ? 'bodyText' : 'sectionTitle';
          insert.textStates = [entry.textState];
        }

        if (!entry.replacedRoot) {
          if (entry.previousRootId) {
            entry.previousRoot.id = entry.previousRootId;
            entry.previousRoot.classList.add('section-block');
          } else if (entry.outlineAction === 'insert') {
            entry.previousRoot.removeAttribute('id');
            entry.previousRoot.classList.remove('section-block');
          }
        }

        if (entry.outlineAction === 'insert') {
          window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
            detail: {
              document: entry.documentKey,
              action: 'delete',
              index: entry.index,
              sectionId: entry.outlineSectionId,
              type: 'sectionTitle',
            },
          }));
        } else if (entry.outlineAction === 'delete' && entry.outlineSectionId) {
          window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
            detail: {
              document: entry.documentKey,
              action: 'insert',
              index: entry.index,
              type: 'sectionTitle',
              sectionId: entry.outlineSectionId,
              section: {
                type: 'sectionTitle',
                id: entry.outlineSectionId,
                sectionId: entry.outlineSectionId,
                title: entry.outlineTitle || 'Section title',
              },
            },
          }));
        }

        window.dispatchEvent(new Event('vcd:site-annotation-targets-changed'));
        entry.textState.element = entry.previousTextElement;
        entry.textState.path = entry.previousPath;
        entry.textState.kind = entry.previousKind;
        if (isDevContentEditing()) {
          entry.previousTextElement.setAttribute(
            'contenteditable',
            entry.previousKind === 'paragraphs' ? 'true' : 'plaintext-only',
          );
          entry.previousTextElement.setAttribute('spellcheck', 'true');
        }
      });
      syncPageTopSpacingControls();
    };

    const revertPendingSectionInserts = () => {
      if (!pendingSectionInserts.length) return;
      const pending = [...pendingSectionInserts].sort((a, b) => b.index - a.index);
      pendingSectionInserts.length = 0;
      pending.forEach((entry) => {
        entry.textStates.forEach((state) => {
          const index = textStates.indexOf(state);
          if (index >= 0) textStates.splice(index, 1);
        });
        if (entry.spacingState) {
          const index = spacingStates.indexOf(entry.spacingState);
          if (index >= 0) spacingStates.splice(index, 1);
        }
        const deletableIdx = deletableSections.indexOf(entry.root);
        if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);
        reindexDevPaths(entry.index, -1, entry.documentKey);
        entry.root.remove();
        window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
          detail: {
            action: 'delete',
            index: entry.index,
            sectionId: entry.sectionId,
            type: entry.type,
          },
        }));
      });
      syncPageTopSpacingControls();
    };

    const revertPendingSectionDeletes = () => {
      if (!pendingSectionDeletes.length) return;
      const pending = [...pendingSectionDeletes].sort((a, b) => a.deletedIndex - b.deletedIndex);
      pendingSectionDeletes.length = 0;
      pending.forEach(restorePendingSectionDelete);
    };

    const revertPersistedMediaInserts = async () => {
      if (!persistedMediaInserts.length) return;
      const pending = [...persistedMediaInserts].sort((a, b) => b.index - a.index);
      for (const entry of pending) {
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            action: 'delete',
            document: entry.documentKey,
            index: entry.index,
            target: sectionEditTarget(entry.root),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not undo the image insert.');
        persistedMediaInserts.splice(persistedMediaInserts.indexOf(entry), 1);

        const deletableIdx = deletableSections.indexOf(entry.root);
        if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);
        entry.root.remove();
        reindexDevPaths(entry.index, -1, entry.documentKey);

        window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
          detail: {
            document: entry.documentKey,
            action: 'delete',
            index: entry.index,
            type: String(entry.section.type ?? 'image'),
          },
        }));
      }
      syncPageTopSpacingControls();
    };

    const flushPendingEditsForDocument = async (documentKey: string) => {
      // Match Save: open tuners must stage their drafts before an append remounts the section.
      if (!window.dispatchEvent(new Event('vcd:dev-before-save', { cancelable: true }))) {
        throw new Error('Could not save pending edits before inserting images. Finish the current image replacement first.');
      }
      // Keep JSON indices aligned with client reindexing before text writes.
      if (pendingSectionInserts.some((entry) => entry.documentKey === documentKey)) {
        await persistPendingSectionInserts();
      }
      if (pendingSectionDeletes.some((entry) => entry.documentKey === documentKey)) {
        await persistPendingSectionDeletes();
      }
      if (pendingBlockConverts.some((entry) => entry.documentKey === documentKey)) {
        await persistPendingBlockConverts();
      }
      await persistPlaceholderFills(documentKey);
      for (const change of [...pendingMedia.values()]) {
        if (change.kind !== 'project-details-rows' || change.payload.document !== documentKey) continue;
        await persistDetailsRows(change);
        pendingMedia.delete(change.id);
      }

      const pendingMediaForDocument = [...pendingMedia.values()].filter((change) =>
        isPathPendingMediaChange(change) && String(change.payload.document || '') === documentKey,
      );
      if (pendingMediaForDocument.length) {
        const response = await fetch('/api/content-batch', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            crops: pendingMediaForDocument
              .filter((change) => change.kind === 'crop')
              .map((change) => change.payload),
            grids: pendingMediaForDocument
              .filter((change) => change.kind === 'grid')
              .map((change) => change.payload),
            carousels: pendingMediaForDocument
              .filter((change) => change.kind === 'carousel')
              .map((change) => change.payload),
            captions: pendingMediaForDocument
              .filter((change) => change.kind === 'caption')
              .map((change) => change.payload),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save pending media before inserting images.');
        const ids = pendingMediaForDocument
          .filter((change) => pendingMedia.get(change.id) === change)
          .map((change) => {
            pendingMedia.delete(change.id);
            return change.id;
          });
        if (ids.length) window.dispatchEvent(new CustomEvent('vcd:dev-pending-committed', { detail: { ids } }));
      }

      const dirtyText = dirtyTextStates().filter((state) => state.document === documentKey);
      const dirtySpacing = dirtySpacingStates().filter((state) => state.document === documentKey);
      const dirtyIntroHeights = dirtyIntroHeightStates().filter((state) => state.document === documentKey);
      if (!dirtyText.length && !dirtySpacing.length && !dirtyIntroHeights.length) {
        updateActions();
        return;
      }

      if (dirtyText.length) {
        const response = await fetch('/api/content-text', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            changes: dirtyText.map((state) => withDevEditTarget({
              document: state.document,
              path: state.path,
              value: readValue(state),
            }, state.element)),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save pending text before inserting images.');
        dirtyText.forEach((state) => {
          state.savedValue = readValue(state);
        });
      }

      const dirtyLayout = [
        ...dirtySpacing.map((state) => withDevEditTarget({
          document: state.document,
          path: state.writePath,
          value: state.currentValue,
        }, state.element)),
        ...dirtyIntroHeights.map((state) => withDevEditTarget({
          document: state.document,
          path: state.path,
          value: state.currentValue,
        }, state.element)),
      ];
      if (dirtyLayout.length) {
        const response = await fetch('/api/content-spacing', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            changes: dirtyLayout,
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save pending layout before inserting images.');
        dirtySpacing.forEach((state) => {
          state.savedValue = cloneSpacing(state.currentValue);
          state.visualSavedValue = cloneSpacing(state.currentValue);
          syncSpacingControl(state);
        });
        dirtyIntroHeights.forEach((state) => syncIntroHeightDocument(
          state.document,
          state.currentValue,
        ));
      }

      updateActions();
    };

    const persistPendingSectionInserts = async () => {
      if (!pendingSectionInserts.length) return [] as Array<{
        clientId: string;
        serverId: string;
        documentKey: string;
      }>;
      const pending = [...pendingSectionInserts].sort((a, b) => a.index - b.index);
      const remapped: Array<{ clientId: string; serverId: string; documentKey: string }> = [];
      for (const entry of pending) {
        const clientId = entry.sectionId;
        const body: Record<string, unknown> = {
          document: entry.documentKey,
          index: entry.index,
          type: entry.type,
          spacing: entry.spacing,
        };
        if (entry.restoreToken) {
          body.action = 'restore';
          body.restoreToken = entry.restoreToken;
        }
        if (entry.type === 'sectionTitle' && entry.level === 3) body.level = 3;
        if (entry.intro) body.intro = true;
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not add the section.');
        pendingSectionInserts.splice(pendingSectionInserts.indexOf(entry), 1);
        if (payload.section?.id) {
          const contentId = String(payload.section.id);
          entry.root.dataset.devContentId = contentId;
          const previousId = entry.root.dataset.siteAnnotationSectionId;
          if (previousId && previousId !== contentId) {
            entry.root.dataset.siteAnnotationSectionId = contentId;
            for (const change of [...pendingMedia.values()]) {
              if (change.kind !== 'annotation' || change.payload.document !== entry.documentKey
                || change.payload.sectionId !== previousId) continue;
              pendingMedia.delete(change.id);
              change.id = `annotation:${entry.documentKey}:${contentId}`;
              change.payload.sectionId = contentId;
              pendingMedia.set(change.id, change);
            }
            window.dispatchEvent(new CustomEvent('vcd:site-annotation-section-remap', {
              detail: { document: entry.documentKey, previousId, sectionId: contentId },
            }));
          }
        }
        const serverSectionId = String(
          payload.section?.sectionId || payload.section?.id || payload.id || clientId,
        );
        if (serverSectionId && serverSectionId !== clientId) {
          entry.root.id = serverSectionId;
          entry.sectionId = serverSectionId;
          remapped.push({
            clientId,
            serverId: serverSectionId,
            documentKey: entry.documentKey,
          });
          let documentIds = serverSectionIds.get(entry.documentKey);
          if (!documentIds) {
            documentIds = new Map();
            serverSectionIds.set(entry.documentKey, documentIds);
          }
          documentIds.set(clientId, serverSectionId);
          remapDevSectionOutlineId(clientId, serverSectionId);
        }
      }
      return remapped;
    };

    const persistPendingSectionDeletes = async () => {
      if (!pendingSectionDeletes.length) return;
      const pending = [...pendingSectionDeletes].sort((a, b) => b.deletedIndex - a.deletedIndex);
      for (const entry of pending) {
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            action: 'delete',
            document: entry.documentKey,
            index: entry.deletedIndex,
            target: sectionEditTarget(entry.root),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not delete the section.');
        entry.restoreToken = payload.restoreToken;
        pendingSectionDeletes.splice(pendingSectionDeletes.indexOf(entry), 1);
      }
    };

    const persistPendingBlockConverts = async () => {
      if (!pendingBlockConverts.length) return;
      const pending = [...pendingBlockConverts]
        .filter((entry) => !entry.skipPersist)
        .sort((a, b) => a.index - b.index);
      if (!pending.length) {
        pendingBlockConverts.length = 0;
        return;
      }
      for (const entry of pending) {
        let index = entry.index;
        try {
          const path = JSON.parse(entry.root.dataset.devSpacingPath || '[]');
          if (Array.isArray(path) && typeof path.at(-2) === 'number') {
            index = path.at(-2) as number;
          }
        } catch {
          // Fall back to the snapshotted index.
        }
        const body: Record<string, unknown> = {
          action: 'convert',
          target: sectionEditTarget(entry.root),
          document: entry.documentKey,
          index,
          type: entry.to,
        };
        if (entry.to === 'sectionTitle') body.level = entry.level ?? 2;
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not convert the section.');
        pendingBlockConverts.splice(pendingBlockConverts.indexOf(entry), 1);
      }
      pendingBlockConverts.length = 0;
    };

    const revertDirtyEdits = () => {
      dirtyTextStates().forEach((state) => {
        renderValue(state, state.savedValue);
      });
      dirtySpacingStates().forEach((state) => {
        state.currentValue = cloneSpacing(state.savedValue);
        state.visualSavedValue = cloneSpacing(state.savedValue);
        applySpacingClass(state.element, state.savedValue);
        syncSpacingControl(state);
      });
      const dirtyHeights = dirtyIntroHeightStates();
      dirtyHeights.forEach((state) => syncIntroHeightDocument(
        state.document,
        state.savedValue,
        state.savedValue,
      ));
    };

    const unsavedChangeCount = () =>
      dirtyTextStates().length
      + dirtySpacingStates().length
      + dirtyIntroHeightStates().length
      + pendingMedia.size
      + pendingSectionDeletes.length
      + pendingSectionInserts.length
      + pendingBlockConverts.length
      + persistedMediaInserts.length;

    /*
      Esc / leaving Edit is View mode, not discard. Pending edits stay in the
      DOM and in pendingMedia until Save, Revert, or a real navigation. The
      leave guard covers navigation, beforeunload, and vcd:before-reload — do not confirm
      or revert on vcd:dev-mode-before-exit.
    */

    window.addEventListener('vcd:before-reload', (event) => {
      // Persisted media inserts survive reload (already written) — don't warn for them.
      const dirtyCount = unsavedChangeCount() - persistedMediaInserts.length;
      const draft = { dirty: false };
      window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: draft }));
      if (!dirtyCount && !draft.dirty && !actionsBusy) return;

      const message = dirtyCount === 1
        ? 'Reload will discard 1 unsaved edit on this page. Continue?'
        : `Reload will discard ${dirtyCount} unsaved edits on this page. Continue?`;
      if (!window.confirm(message)) {
        event.preventDefault();
      }
    }, { signal: editorSignal });

    /** Content files changed on disk but not yet committed to the publish branch. */
    let unpublishedCount = 0;

    /**
     * Colour-token CSS ahead of main (e.g. global.css after a Save). Separate
     * from content publish — Publish styles pushes it to main from any branch.
     */
    let styleEngineDirtyCount = 0;

    /**
     * Once /api/publish has succeeded at least once this session, keep the last
     * known counts on a transient failure instead of emptying the bar as if
     * publish were unavailable (same catch path as "not a git repo").
     */
    let publishKnown = false;
    let publishReadOnly = false;

    /** Save or publish in flight — keeps buttons disabled with a wait cursor. */
    let actionsBusy = false;

    let branchUpdateAvailable = false;
    let branchUpdateBusy = false;
    let branchUpdateMessage = '';

    const syncBranchUpdateBar = () => {
      const editing = document.documentElement.classList.contains('is-dev-mode');
      const draft = { dirty: false };
      window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: draft }));
      branchUpdateButton.textContent = (hasPendingEdits() || draft.dirty) ? 'Save & Update' : 'Update';
      branchUpdateActions.hidden = !branchUpdateBusy
        && ((!branchUpdateAvailable && !branchUpdateMessage) || !editing);
      branchUpdateStatus.textContent = branchUpdateMessage
        || (branchUpdateBusy ? 'Updating…' : 'Update available');
      branchUpdateButton.disabled = branchUpdateBusy || actionsBusy || pageHistory.busy || !branchUpdateAvailable;
      branchUpdateButton.classList.toggle('is-dev-actions-busy', branchUpdateBusy);
    };

    /** Anything in the DOM not yet written to disk. */
    const hasPendingEdits = () => Boolean(
      dirtyTextStates().length
      || dirtySpacingStates().length
      || dirtyIntroHeightStates().length
      || pendingMedia.size
      || pendingSectionDeletes.length
      || pendingSectionInserts.length
      || pendingBlockConverts.length
      || persistedMediaInserts.length,
    );

    /**
     * A message that must survive the next updateActions(). Publish failures used
     * to flash for a frame and vanish — refreshPublishState() runs in the click
     * handler's `finally` and updateActions() overwrote the text with the change
     * count, so the one thing worth reading was the one thing you could not.
     * Cleared by the next edit or button press, not by a repaint — except
     * "Saved.", which yields to the unpublished count once publish state refreshes.
     */
    let stickyStatus = '';
    const setStickyStatus = (message: string) => {
      stickyStatus = message;
      status.textContent = message;
    };

    const textHistoryValues = new WeakMap<EditableTextState, EditableTextValue>();
    const spacingHistoryValues = new WeakMap<EditableSpacingState, SpacingMap>();
    const heightHistoryValues = new WeakMap<EditableIntroHeightState, number>();
    let historyReady = false;
    let historyCaptureQueued = false;
    let suppressHistory = false;
    const captureFieldHistory = () => {
      historyCaptureQueued = false;
      if (editorSignal.aborted) return;
      const changes: Array<{ undo: () => void; redo: () => void; key: string }> = [];
      const textChanges = new Map<string, {
        states: Array<{ state: EditableTextState; before: EditableTextValue; after: EditableTextValue }>;
        focus: EditableTextState | null;
      }>();
      textStates.forEach((state) => {
        const before = textHistoryValues.get(state);
        const after = structuredClone(readValue(state));
        textHistoryValues.set(state, after);
        if (before === undefined || valuesMatch(before, after)) return;
        const key = `text:${state.document}:${state.path.join('.')}`;
        const group = textChanges.get(key) ?? { states: [], focus: null };
        group.states.push({ state, before, after });
        if (state.element.contains(document.activeElement)) group.focus = state;
        textChanges.set(key, group);
      });
      textChanges.forEach((group, key) => {
        const restore = (direction: 'before' | 'after') => {
          group.states.forEach(({ state, before, after }) => {
            if (!state.element.isConnected) throw new Error('Restore this section before restoring its text.');
            const value = direction === 'before' ? before : after;
            renderValue(state, value);
            textHistoryValues.set(state, structuredClone(value));
          });
          const focusState = group.focus ?? group.states[0]?.state;
          if (focusState?.element.isConnected && !focusState.element.hidden) {
            focusState.element.focus({ preventScroll: true });
            const range = document.createRange();
            range.selectNodeContents(focusState.element);
            range.collapse(false);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
        };
        changes.push({ undo: () => restore('before'), redo: () => restore('after'), key });
      });
      spacingStates.forEach((state) => {
        const before = spacingHistoryValues.get(state);
        const after = cloneSpacing(state.currentValue);
        spacingHistoryValues.set(state, after);
        if (before && !spacingEqual(before, after)) {
          const restore = (value: SpacingMap) => {
            state.currentValue = cloneSpacing(value);
            spacingHistoryValues.set(state, cloneSpacing(value));
            applySpacingClass(state.element, value);
            syncSpacingControl(state);
          };
          changes.push({ undo: () => restore(before), redo: () => restore(after), key: `spacing:${state.document}:${state.path.join('.')}` });
        }
        const height = state.introHeight;
        if (!height) return;
        const oldHeight = heightHistoryValues.get(height);
        const newHeight = height.currentValue;
        heightHistoryValues.set(height, newHeight);
        if (oldHeight === undefined || oldHeight === newHeight) return;
        const restore = (value: number) => {
          height.currentValue = value;
          heightHistoryValues.set(height, value);
          syncIntroHeightControl(height);
        };
        changes.push({ undo: () => restore(oldHeight), redo: () => restore(newHeight), key: `height:${height.document}` });
      });
      if (!historyReady || suppressHistory || actionsBusy || pageHistory.replaying || !changes.length) return;
      const restore = (direction: 'undo' | 'redo') => {
        changes.forEach((change) => change[direction]());
        stickyStatus = '';
        window.dispatchEvent(new Event('vcd:intro-layout-sync'));
        updateActions();
      };
      pageHistory.push({
        label: 'Edit text or spacing',
        mergeKey: changes.length === 1 ? changes[0].key : undefined,
        undo: () => restore('undo'),
        redo: () => restore('redo'),
      });
    };

    const updateActions = () => {
      if (!historyCaptureQueued) {
        historyCaptureQueued = true;
        queueMicrotask(captureFieldHistory);
      }
      const dirtyText = dirtyTextStates();
      const dirtySpacing = dirtySpacingStates();
      const dirtyIntroHeights = dirtyIntroHeightStates();
      // Include persistedMediaInserts: already on disk, but still reversible until Save.
      const dirtyCount = dirtyText.length + dirtySpacing.length + dirtyIntroHeights.length + pendingMedia.size
        + pendingSectionDeletes.length + pendingSectionInserts.length
        + pendingBlockConverts.length
        + persistedMediaInserts.length;

      textStates.forEach((state) => {
        if (state.kind === 'paragraphs') {
          refreshParagraphWrapping(state.element, state.element.dataset.devTextLegacyBalance === 'true');
        }
        state.element.classList.toggle(
          'is-dev-text-dirty',
          !valuesMatch(readValue(state), state.savedValue),
        );
      });
      spacingStates.forEach(syncSpacingControl);

      // Two independent reasons to show the bar: edits not yet on disk, and
      // edits on disk not yet published. Content saved on a feature branch and
      // carried to main by a branch switch is only ever the second kind — if
      // the bar needed unsaved DOM state, Publish would be unreachable for it.
      // Style-token Saves also leave CSS ahead of main for Publish styles.
      actions.hidden = (!dirtyCount && !unpublishedCount && !styleEngineDirtyCount)
        || !document.documentElement.classList.contains('is-dev-mode');
      if (stickyStatus) {
        status.textContent = stickyStatus;
      } else if (dirtyCount) {
        status.textContent = `${dirtyCount} unsaved ${dirtyCount === 1 ? 'change' : 'changes'}`;
      } else if (unpublishedCount) {
        status.textContent = `${unpublishedCount} unpublished ${unpublishedCount === 1 ? 'change' : 'changes'}`;
      } else if (styleEngineDirtyCount) {
        status.textContent = `${styleEngineDirtyCount} style ${styleEngineDirtyCount === 1 ? 'file' : 'files'} to publish`;
      } else {
        status.textContent = '';
      }
      // Unsaved DOM/pending OR unpublished disk content (restored via /api/content-revert).
      revertButton.hidden = !(dirtyCount || unpublishedCount);
      // Keep Save in the layout after a successful write — greyed, not removed —
      // so the bar keeps its shape while Publish becomes the next step.
      saveButton.hidden = false;
      commitStylesButton.hidden = publishReadOnly || !styleEngineDirtyCount;
      publishButton.hidden = publishReadOnly || !publishKnown;
      if (!actionsBusy && !branchUpdateBusy) {
        saveButton.disabled = !dirtyCount;
        revertButton.disabled = false;
        commitStylesButton.disabled = false;
      } else {
        saveButton.disabled = true;
        publishButton.disabled = true;
        revertButton.disabled = true;
        commitStylesButton.disabled = true;
      }
      saveButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      publishButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      revertButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      commitStylesButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      syncBranchUpdateBar();
    };

    const SCROLL_RESTORE_KEY = 'vcd-dev-scroll-y';
    const restoreScrollAfterReload = () => {
      const raw = sessionStorage.getItem(SCROLL_RESTORE_KEY);
      if (raw == null) return;
      sessionStorage.removeItem(SCROLL_RESTORE_KEY);
      const y = Number(raw);
      if (!Number.isFinite(y)) return;
      pageScope.frame(() => {
        window.scrollTo(0, y);
      });
    };
    restoreScrollAfterReload();

    const projectStackClassName = (spacing: SpacingValue, precedeRelated: boolean) => {
      const classes = [projectStackClass(spacing)];
      if (precedeRelated) classes.push('project-stack--precede-related');
      return classes.filter(Boolean).join(' ');
    };

    const buildInsertedSection = (
      type: InsertableSectionType,
      documentKey: string,
      index: number,
      spacing: SpacingValue,
      intro?: boolean,
      introHeight = 75,
    ) => {
      const sectionPath = ['sections', index] as Array<string | number>;
      // Inserted titles omit precede-related so the following block keeps its gap.
      const spacingClass = projectStackClassName(spacing, false);
      const introClass = intro ? ' project-block--intro' : '';

      if (type === 'projectDetails') {
        const section = document.createElement('section');
        section.className = spacingClass
          ? `project-block project-block--text project-details ${spacingClass}${introClass}`
          : `project-block project-block--text project-details${introClass}`;
        section.dataset.devSpacingDocument = documentKey;
        section.dataset.devSpacingPath = JSON.stringify([...sectionPath, 'spacing']);
        section.dataset.devSpacingValue = spacing;
        section.dataset.devSpacingValues = JSON.stringify(resolveProjectStackSpacing(spacing));
        section.dataset.devSectionDeletable = 'projectDetails';
        section.dataset.devProjectDetails = '';
        const title = document.createElement('h2');
        title.className = 'project-details__title';
        title.dataset.devTextDocument = documentKey;
        title.dataset.devTextPath = JSON.stringify([...sectionPath, 'title']);
        title.dataset.devTextKind = 'text';
        title.textContent = 'Project details & credits';
        section.append(title);
        const list = document.createElement('dl');
        list.className = 'project-details__list';
        section.append(list);
        const row = createDetailsRow(section);
        row.querySelector('dt')!.textContent = 'Role';
        list.append(row);
        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'project-details__add';
        add.dataset.projectDetailsAdd = '';
        add.dataset.devModeOnly = '';
        add.textContent = 'Add row';
        section.append(add);
        syncProjectDetailsRowPaths(section);
        return { root: section, textElement: title, textKind: 'text' as const, textPath: [...sectionPath, 'title'] };
      }

      if (type === 'award') {
        const template = document.querySelector<HTMLTemplateElement>('[data-award-template]')!;
        const section = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        section.className = `project-block project-award ${spacingClass}`;
        section.dataset.devSpacingDocument = documentKey;
        section.dataset.devSpacingPath = JSON.stringify([...sectionPath, 'spacing']);
        section.dataset.devSpacingValue = spacing;
        section.dataset.devSpacingValues = JSON.stringify(resolveProjectStackSpacing(spacing));
        const proxy = section.querySelector<HTMLElement>('[data-dev-text-path]')!;
        proxy.dataset.devTextDocument = documentKey;
        proxy.dataset.devTextPath = JSON.stringify([...sectionPath, 'href']);
        const input = section.querySelector<HTMLInputElement>('[data-award-input]')!;
        input.id = `award-link-${crypto.randomUUID()}`;
        section.querySelector<HTMLLabelElement>('label')!.htmlFor = input.id;
        return { root: section, textElement: proxy, textKind: 'text' as const, textPath: [...sectionPath, 'href'] };
      }

      if (type === 'sectionTitle') {
        const wrapper = document.createElement('div');
        wrapper.className = spacingClass
          ? `project-block project-block--text ${spacingClass}${introClass}`
          : `project-block project-block--text${introClass}`;
        if (intro) {
          wrapper.dataset.devIntro = 'true';
          wrapper.dataset.devIntroHeightDocument = documentKey;
          wrapper.dataset.devIntroHeightPath = JSON.stringify(['introHeight']);
          wrapper.dataset.devIntroHeightValue = String(introHeight);
          wrapper.style.setProperty('--intro-height', String(introHeight));
        }
        wrapper.dataset.devSpacingDocument = documentKey;
        wrapper.dataset.devSpacingPath = JSON.stringify([...sectionPath, 'spacing']);
        wrapper.dataset.devSpacingValue = spacing;
        wrapper.dataset.devSpacingValues = JSON.stringify(resolveProjectStackSpacing(spacing));
        wrapper.dataset.devSectionDeletable = 'sectionTitle';

        const title = document.createElement('h2');
        title.className = 'project-section-title';
        title.dataset.devTextDocument = documentKey;
        title.dataset.devTextPath = JSON.stringify([...sectionPath, 'title']);
        title.dataset.devTextKind = 'text';
        title.textContent = 'Section title';
        wrapper.append(title);
        return { root: wrapper, textElement: title, textKind: 'text' as const, textPath: [...sectionPath, 'title'] };
      }

      const section = document.createElement('section');
      section.className = spacingClass
        ? `project-block project-block--text ${spacingClass}${introClass}`
        : `project-block project-block--text${introClass}`;
      if (intro) {
        section.dataset.devIntro = 'true';
        section.dataset.devIntroHeightDocument = documentKey;
        section.dataset.devIntroHeightPath = JSON.stringify(['introHeight']);
        section.dataset.devIntroHeightValue = String(introHeight);
        section.style.setProperty('--intro-height', String(introHeight));
      }
      section.dataset.devSpacingDocument = documentKey;
      section.dataset.devSpacingPath = JSON.stringify([...sectionPath, 'spacing']);
      section.dataset.devSpacingValue = spacing;
      section.dataset.devSpacingValues = JSON.stringify(resolveProjectStackSpacing(spacing));
      section.dataset.devSectionDeletable = 'bodyText';

      const body = document.createElement('div');
      body.className = 'project-body-text';
      body.dataset.devTextDocument = documentKey;
      body.dataset.devTextPath = JSON.stringify([...sectionPath, 'paragraphs']);
      body.dataset.devTextKind = 'paragraphs';
      const paragraph = document.createElement('p');
      paragraph.append(createParagraphPlaceholderBreak());
      body.append(paragraph);
      section.append(body);
      return {
        root: section,
        textElement: body,
        textKind: 'paragraphs' as const,
        textPath: [...sectionPath, 'paragraphs'],
      };
    };

    const buildConvertedSection = (
      type: 'bodyText' | 'sectionTitle',
      documentKey: string,
      index: number,
      spacing: SpacingValue,
      text: string,
      level: 2 | 3 = 2,
    ) => {
      if (type === 'sectionTitle') {
        const built = buildInsertedSection('sectionTitle', documentKey, index, spacing);
        const nextTag = level === 3 ? 'h3' : 'h2';
        let title = built.textElement;
        if (title.tagName !== nextTag.toUpperCase()) {
          const heading = document.createElement(nextTag);
          [...title.attributes].forEach((attr) => heading.setAttribute(attr.name, attr.value));
          heading.className = title.className;
          title.replaceWith(heading);
          title = heading;
        }
        title.textContent = text;
        if (!text) title.append(createParagraphPlaceholderBreak());
        return { ...built, textElement: title };
      }

      const built = buildInsertedSection('bodyText', documentKey, index, spacing);
      const paragraph = document.createElement('p');
      const lines = text.split('\n');
      lines.forEach((line, lineIndex) => {
        if (lineIndex) paragraph.append(document.createElement('br'));
        if (line) paragraph.append(document.createTextNode(line));
      });
      if (!fragmentHasContent(paragraph)) paragraph.append(createParagraphPlaceholderBreak());
      built.textElement.replaceChildren(paragraph);
      return built;
    };

    const placeCaretInParagraph = (paragraph: HTMLElement, atStart: boolean) => {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      if (atStart) {
        range.setStart(paragraph, 0);
        range.collapse(true);
      } else {
        range.selectNodeContents(paragraph);
        range.collapse(false);
      }
      selection.removeAllRanges();
      selection.addRange(range);
    };

    const ensureParagraphSelection = (element: HTMLElement): HTMLElement | null => {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return null;
      const range = selection.getRangeAt(0);
      if (!element.contains(range.startContainer) || !element.contains(range.endContainer)) return null;
      let direct = range.startContainer;
      while (direct !== element && direct.parentNode !== element) direct = direct.parentNode!;
      if (direct instanceof HTMLElement && direct.matches('p, div') && direct !== element) return direct;
      if (!range.collapsed) return null;
      if (direct === element) {
        const after = element.childNodes[range.startOffset];
        const before = element.childNodes[range.startOffset - 1];
        if (after instanceof HTMLElement && after.matches('p, div')) {
          placeCaretInParagraph(after, true);
          return after;
        }
        if (before instanceof HTMLElement && before.matches('p, div')) {
          placeCaretInParagraph(before, false);
          return before;
        }
        direct = after ?? before ?? element;
      }
      const paragraph = document.createElement('p');
      if (direct === element) {
        paragraph.append(createParagraphPlaceholderBreak());
        element.append(paragraph);
        placeCaretInParagraph(paragraph, true);
      } else {
        // Only explicit section commands wrap root text; ordinary input never rewrites the DOM.
        const anchor = selection.anchorNode!;
        const anchorOffset = selection.anchorOffset;
        let first = direct;
        while (first.previousSibling && !(first.previousSibling instanceof HTMLElement && first.previousSibling.matches('p, div'))) {
          first = first.previousSibling;
        }
        element.insertBefore(paragraph, first);
        while (first && !(first instanceof HTMLElement && first.matches('p, div'))) {
          const next = first.nextSibling;
          paragraph.append(first);
          if (!next) break;
          first = next;
        }
        if (anchor !== element) selection.setPosition(anchor, anchorOffset);
        else placeCaretInParagraph(paragraph, range.startOffset === 0);
      }
      return paragraph;
    };

    const fragmentHasContent = (node: ParentNode) =>
      Boolean(
        serializeInlineHtml(node as HTMLElement) ||
        node.textContent?.replaceAll('\u00a0', ' ').trim(),
      );

    const stripParagraphPlaceholders = (paragraph: HTMLElement) => {
      paragraph.querySelectorAll(`br[${PARAGRAPH_PLACEHOLDER_ATTRIBUTE}]`).forEach((br) => br.remove());
    };

    const removeParagraphRootWhitespace = (element: HTMLElement) => {
      [...element.childNodes].forEach((node) => {
        if (node.nodeType === Node.TEXT_NODE && !node.textContent?.trim()) node.remove();
      });
    };

    const extractTrailingFromParagraph = (
      paragraph: HTMLElement,
      liveRange: Range,
    ) => {
      const afterRange = document.createRange();
      afterRange.setStart(liveRange.startContainer, liveRange.startOffset);
      afterRange.setEnd(paragraph, paragraph.childNodes.length);
      const trailing = afterRange.extractContents();

      const nextParagraph = document.createElement('p');
      const empty = !fragmentHasContent(trailing);
      if (empty) nextParagraph.append(createParagraphPlaceholderBreak());
      else nextParagraph.append(trailing);

      if (!fragmentHasContent(paragraph)) {
        paragraph.replaceChildren(createParagraphPlaceholderBreak());
      }

      return { nextParagraph, empty };
    };

    let splitBlockAtCaret = (_state: EditableTextState) => {};
    let tryMergeBlockAtCaret = (
      _state: EditableTextState,
      _direction: 'forward' | 'backward',
    ) => false;

    const bindTextState = (state: EditableTextState) => {
      const { element } = state;
      if (state.kind === 'paragraphs') removeParagraphRootWhitespace(element);
      const notifyTextInput = () => {
        const value = readValue(state);
        textStates.forEach((candidate) => {
          if (candidate === state || candidate.document !== state.document
            || JSON.stringify(candidate.path) !== JSON.stringify(state.path)) return;
          renderValue(candidate, value);
        });
        window.dispatchEvent(new Event('vcd:intro-layout-sync'));
        stickyStatus = '';
        updateActions();
      };
      element.addEventListener('input', notifyTextInput, { signal: editorSignal });
      if (state.kind === 'paragraphs') {
        element.addEventListener('focus', () => {
          document.execCommand('defaultParagraphSeparator', false, 'p');
        }, { signal: editorSignal });
        element.addEventListener('paste', (event) => {
          const clipboard = event.clipboardData;
          const selection = window.getSelection();
          if (!clipboard || !selection?.rangeCount) return;
          const range = selection.getRangeAt(0);
          if (!element.contains(range.startContainer) || !element.contains(range.endContainer)) return;
          const text = clipboard.getData('text/plain');
          const html = clipboard.getData('text/html');
          if (!text && !html) return;
          event.preventDefault();
          const content = clipboardParagraphHtml(text, html);
          if (!content) return;
          pageHistory.breakGroup();
          // Insert as one browser edit; the shared page history records its input.
          if (!document.execCommand('insertHTML', false, content)) {
            setStickyStatus('Could not paste. Try Paste and Match Style.');
            return;
          }
          notifyTextInput();
          queueMicrotask(() => pageHistory.breakGroup());
        }, { signal: editorSignal });
      }
      element.addEventListener('beforeinput', () => {
        if (linkPanelOpen) hideFormatBar();
      }, { signal: editorSignal });
      element.addEventListener('keydown', (event) => {
        if (event.isComposing || event.defaultPrevented) return;
        if (element.closest('[data-dev-project-details]')) {
          if (event.key === 'Enter') event.preventDefault();
          return;
        }
        if (state.kind === 'paragraphs' && isDevContentEditing()
          && !event.metaKey && !event.ctrlKey && !event.altKey) {
          const changed = event.key === 'Tab' && event.shiftKey
            ? insertRightIndentTab(element)
            : (event.key === 'Backspace' || event.key === 'Delete') && !event.shiftKey
              ? removeRightIndentTab(element, event.key === 'Backspace' ? 'backward' : 'forward')
              : event.key === 'Enter' ? breakRightIndentTab(element, event.shiftKey) : false;
          if (changed) {
            event.preventDefault();
            if (linkPanelOpen) hideFormatBar();
            pageHistory.breakGroup();
            notifyTextInput();
            queueMicrotask(() => pageHistory.breakGroup());
            return;
          }
        }
        if (state.document === 'header-settings' && state.kind === 'text' && event.key === 'Enter') {
          event.preventDefault();
          element.blur();
          return;
        }
        if (event.key === 'Backspace' || event.key === 'Delete') {
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          if (linkPanelOpen) hideFormatBar();
          if (tryMergeBlockAtCaret(state, event.key === 'Delete' ? 'forward' : 'backward')) {
            event.preventDefault();
          }
          return;
        }
        if (event.key !== 'Enter') return;
        if (linkPanelOpen) hideFormatBar();
        if (event.metaKey || event.ctrlKey) {
          event.preventDefault();
          splitBlockAtCaret(state);
        }
      }, { signal: editorSignal });
    };

    const registerTextStates = (root: HTMLElement) => {
      root.querySelectorAll<HTMLElement>('[data-dev-text-document][data-dev-text-path]').forEach((element) => {
        if (textStates.some((state) => state.element === element)) return;
        try {
          const path = JSON.parse(element.dataset.devTextPath || '[]');
          const documentKey = element.dataset.devTextDocument || '';
          if (!Array.isArray(path) || !documentKey) return;
          const state: EditableTextState = {
            element, document: documentKey, path,
            kind: element.dataset.devTextKind === 'paragraphs' ? 'paragraphs' : 'text', savedValue: '',
          };
          state.savedValue = readValue(state);
          textStates.push(state);
          bindTextState(state);
          if (isDevContentEditing() && canEditText(element)) {
            element.setAttribute('contenteditable', state.kind === 'paragraphs' ? 'true' : 'plaintext-only');
            element.setAttribute('spellcheck', 'true');
          } else {
            element.removeAttribute('contenteditable');
            element.removeAttribute('spellcheck');
          }
        } catch {
          // Ignore malformed dynamic text nodes.
        }
      });
    };

    const TRASH_ICON = sizeIcon(trashIcon);

    const deletableSections: HTMLElement[] = [
      ...document.querySelectorAll<HTMLElement>(
        '[data-dev-section-deletable][data-dev-spacing-document][data-dev-spacing-path]',
      ),
    ];

    let deleteSectionAt: (element: HTMLElement) => Promise<PendingSectionDelete | undefined> = async () => undefined;

    const mountDeleteButton = (element: HTMLElement) => {
      if (element.querySelector(':scope > [data-dev-section-delete]')) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'dev-section-delete';
      button.setAttribute('data-dev-section-delete', '');
      button.setAttribute('data-dev-mode-only', '');
      button.title = 'Delete section';
      button.setAttribute('aria-label', 'Delete section');
      button.innerHTML = TRASH_ICON;
      button.hidden = !isDevContentEditing();

      const computed = getComputedStyle(element);
      if (computed.position === 'static') {
        element.style.position = 'relative';
      }
      element.prepend(button);

      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        void deleteSectionAt(element);
      }, { signal: editorSignal });
    };

    const clearBusyStatus = () => {
      actions.hidden = true;
      status.textContent = '';
      saveButton.disabled = false;
      revertButton.disabled = false;
    };

    const insertSectionAt = (
      anchor: EditableSpacingState | HTMLElement,
      type: InsertableSectionType,
      options?: { placement?: 'before' | 'after'; spacing?: SpacingValue; intro?: boolean },
    ) => {
      const host = anchor instanceof HTMLElement ? anchor : anchor.element;
      const documentKey = anchor instanceof HTMLElement
        ? (anchor.dataset.devSpacingDocument || '')
        : anchor.document;
      let path: Array<string | number>;
      if (anchor instanceof HTMLElement) {
        try {
          path = JSON.parse(anchor.dataset.devSpacingPath || '[]');
        } catch {
          path = [];
        }
      } else {
        path = anchor.path;
      }

      const sectionIndex = path.at(-2);
      if (typeof sectionIndex !== 'number' || !documentKey) {
        status.textContent = 'Could not find where to insert.';
        actions.hidden = false;
        return;
      }

      const placement = options?.placement ?? 'before';
      const insertIndex = placement === 'after' ? sectionIndex + 1 : sectionIndex;
      const newSpacing: SpacingValue =
        options?.spacing ?? (sectionIndex === 0 ? 'none' : 'group');
      const sectionId = `${type === 'sectionTitle' ? 'title' : type === 'projectDetails' ? 'details' : type === 'award' ? 'award' : 'body'}-${Date.now().toString(36)}`;

      closeSectionMenus();
      reindexDevPaths(insertIndex, 1, documentKey);

      const introHeight = options?.intro
        ? (spacingStates.find((candidate) => candidate.document === documentKey && candidate.introHeight)?.introHeight?.currentValue ?? 75)
        : undefined;
      const built = buildInsertedSection(type, documentKey, insertIndex, newSpacing, options?.intro, introHeight);
      built.root.dataset.devContentId = sectionId;
      if (type === 'bodyText' || type === 'sectionTitle') {
        built.root.dataset.siteAnnotationSectionId = sectionId;
        built.root.dataset.siteAnnotationDocument = documentKey;
      }
      if (placement === 'after') host.after(built.root);
      else host.before(built.root);

      const spacingState = mountSpacingControl(built.root);
      if (spacingState) {
        spacingStates.push(spacingState);
        wireSectionAddMenu(spacingState);
      }

      const textState: EditableTextState = {
        element: built.textElement,
        document: documentKey,
        path: built.textPath,
        kind: built.textKind,
        savedValue: built.textKind === 'paragraphs' ? [''] : type === 'award' ? '' : 'Section title',
      };
      if (type === 'projectDetails') {
        registerTextStates(built.root);
      } else {
        textStates.push(textState);
        bindTextState(textState);
      }
      if (isDevContentEditing() && type !== 'award') {
        built.textElement.setAttribute(
          'contenteditable',
          built.textKind === 'paragraphs' ? 'true' : 'plaintext-only',
        );
        built.textElement.setAttribute('spellcheck', 'true');
      }

      mountDeleteButton(built.root);
      deletableSections.push(built.root);

      if (type === 'projectDetails') {
        built.root.id = sectionId;
        built.root.classList.add('section-block');
      } else if (type === 'sectionTitle') {
        built.root.id = sectionId;
        built.root.classList.add('section-block');
        built.root.dataset.devSectionTitle = 'true';
      }

      pendingSectionInserts.push({
        documentKey,
        index: insertIndex,
        type,
        spacing: newSpacing,
        sectionId,
        root: built.root,
        textStates: type === 'projectDetails' ? textStates.filter((state) => built.root.contains(state.element)) : [textState],
        spacingState: spacingState ?? null,
        ...(options?.intro ? { intro: true } : {}),
      });

      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          document: documentKey,
          action: 'insert',
          index: insertIndex,
          type,
          sectionId,
          section: {
            type,
            id: sectionId,
            sectionId,
            title: type === 'projectDetails' ? 'Project details & credits' : type === 'award' ? 'Award' : 'Section title',
          },
          ...(type === 'sectionTitle' ? { outlineEntries: [] } : {}),
        },
      }));

      syncPageTopSpacingControls();
      updateActions();
      pageScope.frame(() => {
        if (type === 'award') {
          built.root.querySelector<HTMLButtonElement>('[data-award-edit]')?.focus({ preventScroll: true });
          return;
        }
        built.textElement.focus();
        if (built.textKind === 'paragraphs') {
          const first = built.textElement.querySelector<HTMLElement>(':scope > p, :scope > div');
          if (first) placeCaretInParagraph(first, true);
          else ensureParagraphSelection(built.textElement);
        } else if (built.textKind === 'text') {
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(built.textElement);
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      });
      return built;
    };

    splitBlockAtCaret = (state: EditableTextState) => {
      const root = state.element.closest<HTMLElement>(
        '[data-dev-section-deletable][data-dev-spacing-document]',
      );
      if (!root) return;

      let spacingPath: Array<string | number> = [];
      try {
        spacingPath = JSON.parse(root.dataset.devSpacingPath || '[]');
      } catch {
        spacingPath = [];
      }
      const sectionIndex = spacingPath.at(-2);
      if (typeof sectionIndex !== 'number') return;

      const selection = window.getSelection();
      if (!selection?.rangeCount) return;

      let payloadParagraphs: HTMLElement[] = [];
      let headingRemainder = '';

      if (state.kind === 'paragraphs') {
        const selected = selection.getRangeAt(0);
        if (!state.element.contains(selected.startContainer) || !state.element.contains(selected.endContainer)) return;
        if (!selected.collapsed) selected.deleteContents();
        const paragraph = ensureParagraphSelection(state.element);
        if (!paragraph) return;

        if (!selection.rangeCount) return;
        const range = selection.getRangeAt(0);
        if (!paragraph.contains(range.startContainer) && range.startContainer !== paragraph) {
          placeCaretInParagraph(paragraph, false);
        }
        const liveRange = selection.getRangeAt(0);
        if (!liveRange.collapsed) liveRange.deleteContents();

        const { nextParagraph, empty } = extractTrailingFromParagraph(
          paragraph,
          liveRange,
        );
        materializeParagraphs(state.element);
        const following: HTMLElement[] = [];
        let sibling = paragraph.nextElementSibling;
        while (sibling) {
          const next = sibling.nextElementSibling;
          if (sibling instanceof HTMLElement && sibling.matches('p, div')) {
            sibling.remove();
            following.push(sibling);
          }
          sibling = next;
        }
        payloadParagraphs = empty ? following : [nextParagraph, ...following];
      } else if (state.kind === 'text') {
        const liveRange = selection.getRangeAt(0);
        if (!state.element.contains(liveRange.startContainer)
          && liveRange.startContainer !== state.element) {
          return;
        }
        if (!liveRange.collapsed) liveRange.deleteContents();
        const caretRange = selection.getRangeAt(0);
        const pre = caretRange.cloneRange();
        pre.selectNodeContents(state.element);
        pre.setEnd(caretRange.startContainer, caretRange.startOffset);
        const offset = pre.toString().length;
        const text = readPlainDomText(state.element);
        headingRemainder = text.slice(offset);
        state.element.textContent = text.slice(0, offset);
      } else {
        return;
      }

      const built = insertSectionAt(root, 'bodyText', {
        placement: 'after',
        spacing: 'related',
        intro: root.dataset.devIntro === 'true',
      });
      if (!built) return;

      if (payloadParagraphs.length) {
        built.textElement.replaceChildren(...payloadParagraphs);
      } else if (headingRemainder) {
        const paragraph = document.createElement('p');
        fillParagraph(paragraph, escapeTextHtml(headingRemainder));
        built.textElement.replaceChildren(paragraph);
      }

      updateActions();
    };

    const sectionRoots = (documentKey?: string) => {
      const zone = getDropZone(documentKey);
      return [...(zone?.querySelectorAll<HTMLElement>('[data-dev-spacing-document]') ?? [])];
    };
    const refreshSectionMenu = (state: EditableSpacingState) => {
      const roots = sectionRoots(state.document);
      const index = roots.indexOf(state.element);
      const previous = roots[index - 1];
      const currentIntro = state.element.dataset.devIntro === 'true';
      const previousIntro = previous?.dataset.devIntro === 'true';
      const hasIntro = roots.some((root) => root.dataset.devIntro === 'true');
      const boundary = currentIntro || previousIntro;
      const leading = currentIntro && !previousIntro;
      const trailing = !currentIntro && previousIntro;
      state.control.classList.toggle('is-intro-outer-gap', leading || trailing);
      state.control.classList.toggle('is-intro-leading-gap', leading);
      state.control.classList.toggle('is-intro-trailing-gap', trailing);
      if (state.control.dataset.gapTopPinned !== 'true') restoreGapToolbarTop(state.control);
      const normal = state.control.querySelector<HTMLElement>('[data-dev-normal-section-menu]');
      const intro = state.control.querySelector<HTMLElement>('[data-dev-intro-section-menu]');
      if (normal) normal.hidden = boundary;
      const supportsIntro = ['home', 'home-intro', 'play', 'about'].includes(state.document);
      if (intro) intro.hidden = !supportsIntro || (hasIntro && !boundary);
    };
    const syncIntroRunControls = () => {
      let previousIntro = false;
      let lead: EditableIntroHeightState | null = null;
      const statesByElement = new Map(spacingStates.map((state) => [state.element, state]));
      const orderedStates = [...new Set(spacingStates.map((state) => state.document))].flatMap((key) => sectionRoots(key))
        .map((root) => statesByElement.get(root))
        .filter((state): state is EditableSpacingState => Boolean(state));
      let previousDocument = '';
      orderedStates.forEach((state) => {
        if (!state.element.isConnected) return;
        if (state.document !== previousDocument) { previousIntro = false; lead = null; }
        previousDocument = state.document;
        refreshSectionMenu(state);
        const isIntro = state.element.dataset.devIntro === 'true';
        if (!isIntro) { previousIntro = false; lead = null; return; }
        if (!previousIntro) lead = state.introHeight;
        if (lead && state.introHeight && state.introHeight !== lead) {
          state.introHeight.currentValue = lead.currentValue;
          state.introHeight.savedValue = lead.savedValue;
        }
        const input = state.control.querySelector<HTMLElement>('.dev-intro-height-control');
        const separator = state.control.querySelector<HTMLElement>('.dev-intro-height-separator');
        if (input) input.hidden = state.introHeight !== lead;
        if (separator) separator.hidden = state.introHeight !== lead;
        previousIntro = true;
      });
    };

    const wireSectionAddMenu = (state: EditableSpacingState) => {
      refreshSectionMenu(state);
      state.addButton.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const opening = !state.control.classList.contains('is-menu-open');
        closeSectionMenus(opening ? state : undefined);
        if (!opening) return;
        cancelSectionMenuClose(state);
        refreshSectionMenu(state);
        state.menu.hidden = false;
        state.addButton.setAttribute('aria-expanded', 'true');
        state.control.classList.add('is-near-add', 'is-menu-open');
        pinGapToolbarTop(state.control);
        syncPageTopGapStacking();
      }, { signal: editorSignal });

      state.menu.querySelectorAll<HTMLButtonElement>('[data-dev-section-type]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const type = button.dataset.devSectionType as InsertableSectionType | undefined;
          if (type === 'image' || type === 'imageGrid' || type === 'imageCarousel') {
            const sectionIndex = state.path.at(-2);
            if (typeof sectionIndex !== 'number') return;
            dismissGapToolbarAfterAddChoice();
            window.dispatchEvent(new CustomEvent('vcd:dev-image-picker-open', {
              detail: {
                documentKey: state.document,
                index: sectionIndex,
                preferredType: type,
              },
            }));
            return;
          }
          if (type !== 'bodyText' && type !== 'sectionTitle' && type !== 'projectDetails' && type !== 'award') return;
          dismissGapToolbarAfterAddChoice();
          const intro = button.dataset.devSectionIntro === 'true';
          insertSectionAt(state, type, intro ? { intro: true, spacing: 'related' } : undefined);
        }, { signal: editorSignal });
      });
    };

    spacingStates.forEach(wireSectionAddMenu);

    type DetailsSnapshot = { rows: HTMLElement[]; fields: EditableTextState[] };
    const detailsBaselines = new Map<HTMLElement, DetailsSnapshot>();
    const detailsPendingIds = new WeakMap<HTMLElement, string>();
    const detailsSnapshot = (root: HTMLElement): DetailsSnapshot => ({
      rows: [...root.querySelectorAll<HTMLElement>('[data-project-details-row]')],
      fields: textStates.filter((state) => root.querySelector('dl')?.contains(state.element)),
    });
    const readProjectDetailsRows = (root: HTMLElement) => detailsSnapshot(root).rows.map((row) => ({
      label: cleanText(row.querySelector('[data-project-details-label]')?.textContent ?? ''),
      value: cleanText(row.querySelector('[data-project-details-value]')?.textContent ?? ''),
    }));
    const syncProjectDetailsRowPaths = (root: HTMLElement) => {
      const sectionPath = JSON.parse(root.dataset.devSpacingPath || '[]').slice(0, -1);
      detailsSnapshot(root).rows.forEach((row, index) => {
        for (const name of ['label', 'value']) {
          const field = row.querySelector<HTMLElement>(`[data-project-details-${name}]`);
          if (!field) continue;
          const path = [...sectionPath, 'rows', index, name];
          field.dataset.devTextPath = JSON.stringify(path);
          const state = textStates.find((candidate) => candidate.element === field);
          if (state) state.path = path;
        }
      });
      root.querySelectorAll<HTMLButtonElement>('[data-project-details-remove]').forEach((button) => {
        button.disabled = detailsSnapshot(root).rows.length <= 1;
      });
      const add = root.querySelector<HTMLButtonElement>('[data-project-details-add]');
      if (add) add.disabled = detailsSnapshot(root).rows.length >= 100;
    };
    const restoreDetailsSnapshot = (root: HTMLElement, snapshot: DetailsSnapshot) => {
      const list = root.querySelector('dl');
      if (!list) return;
      detachSectionStates(list);
      list.replaceChildren(...snapshot.rows);
      textStates.push(...snapshot.fields);
      syncProjectDetailsRowPaths(root);
    };
    const stageProjectDetailsRows = (root: HTMLElement) => {
      const baseline = detailsBaselines.get(root);
      if (!baseline) return;
      let id = detailsPendingIds.get(root);
      if (!id) {
        id = `project-details:${crypto.randomUUID?.() ?? Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, '0')).join('')}`;
        detailsPendingIds.set(root, id);
      }
      const current = detailsSnapshot(root);
      if (current.rows.length === baseline.rows.length && current.rows.every((row, i) => row === baseline.rows[i])) {
        pendingMedia.delete(id);
        updateActions();
        return;
      }
      const prepare = () => ({
        action: 'updateProjectDetailsRows',
        target: sectionEditTarget(root),
        document: root.dataset.devSpacingDocument,
        index: JSON.parse(root.dataset.devSpacingPath || '[]').at(-2),
        rows: readProjectDetailsRows(root),
      });
      pendingMedia.set(id, {
        id, root, kind: 'project-details-rows', payload: prepare(), prepare,
        revert: () => {
          restoreDetailsSnapshot(root, baseline);
          baseline.fields.forEach((field) => renderValue(field, field.savedValue));
        },
      });
      updateActions();
    };
    const persistDetailsRows = async (change: PendingMediaChange) => {
      if (!change.root?.isConnected) return;
      const response = await fetch('/api/content-section', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify(change.prepare?.() ?? change.payload),
      });
      const payload = await readApiJson(response);
      if (!response.ok) throw new Error(String(payload.error || 'Could not save project details rows.'));
      detailsBaselines.set(change.root, detailsSnapshot(change.root));
    };
    const createDetailsRow = (root: HTMLElement) => {
      const row = document.createElement('div');
      row.className = 'project-details__row';
      row.dataset.projectDetailsRow = '';
      for (const [tag, name] of [['dt', 'label'], ['dd', 'value']]) {
        const field = document.createElement(tag);
        field.className = `project-details__${name}`;
        field.setAttribute(`data-project-details-${name}`, '');
        field.dataset.devTextDocument = root.dataset.devSpacingDocument;
        field.dataset.devTextPath = '[]';
        field.dataset.devTextKind = 'text';
        field.textContent = name === 'label' ? 'Detail' : '';
        row.append(field);
      }
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'project-details__remove';
      remove.dataset.projectDetailsRemove = '';
      remove.dataset.devModeOnly = '';
      remove.setAttribute('aria-label', 'Remove detail');
      remove.textContent = 'Remove';
      row.append(remove);
      return row;
    };
    document.addEventListener('click', (event) => {
      if (!isDevContentEditing() || actionsBusy || pageHistory.busy) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      const root = target.closest<HTMLElement>('[data-dev-project-details]');
      if (!root) return;
      const add = target.closest('[data-project-details-add]');
      const remove = target.closest('[data-project-details-remove]');
      if (!add && !remove) return;
      event.preventDefault();
      captureFieldHistory();
      pageHistory.breakGroup();
      const before = detailsSnapshot(root);
      if (!detailsBaselines.has(root)) detailsBaselines.set(root, before);
      if (add) {
        if (before.rows.length >= 100) return;
        const row = createDetailsRow(root);
        root.querySelector('dl')!.append(row);
        syncProjectDetailsRowPaths(root);
        registerTextStates(row);
      } else {
        if (before.rows.length <= 1) return;
        const row = target.closest<HTMLElement>('[data-project-details-row]');
        if (!row) return;
        detachSectionStates(row);
        row.remove();
      }
      syncProjectDetailsRowPaths(root);
      const after = detailsSnapshot(root);
      const restore = (snapshot: DetailsSnapshot) => {
        restoreDetailsSnapshot(root, snapshot);
        stageProjectDetailsRows(root);
      };
      pageHistory.push({ label: add ? 'Add detail' : 'Remove detail', undo: () => restore(before), redo: () => restore(after) });
      stageProjectDetailsRows(root);
      if (add) after.rows.at(-1)?.querySelector<HTMLElement>('dt')?.focus();
    }, { signal: editorSignal });
    syncIntroRunControls();
    window.addEventListener('vcd:dev-section-reordered', ((event: CustomEvent<{
      document?: string;
      moved?: HTMLElement;
      before?: HTMLElement[];
      after?: HTMLElement[];
      destinationSide?: 'before' | 'after';
    }>) => {
      const {
        document: reorderedDocument,
        moved,
        before,
        after,
        destinationSide,
      } = event.detail ?? {};
      if (!reorderedDocument || !moved || !before || !after || before.length !== after.length) return;
      const sourceIndex = before.indexOf(moved);
      const insertIndex = after.indexOf(moved);
      if (sourceIndex < 0 || insertIndex < 0) return;
      if (sourceIndex === insertIndex && destinationSide === undefined) return;

      const statesByElement = new Map(spacingStates.map((state) => [state.element, state]));
      const reorderedStates = before.map((root) => statesByElement.get(root));
      if (reorderedStates.some((state) => !state || state.document !== reorderedDocument)) return;
      const visualSavedValues = reorderedStates.map((state) => cloneSpacing(state!.visualSavedValue));
      const reorderedMaps = (['desktop', 'tablet', 'mobile'] as const).map((viewport) => (
        reorderProjectStackSpacingSeams(
          reorderedStates.map((state) => state!.currentValue[viewport]),
          sourceIndex,
          insertIndex,
          destinationSide,
          reorderedStates.map((state) => state!.currentValue[viewport] !== state!.visualSavedValue[viewport]),
        )
      ));
      reorderedStates.forEach((state, index) => {
        if (!state) return;
        const currentValue = cloneSpacing(state.currentValue);
        const nextVisualSavedValue = cloneSpacing(state.visualSavedValue);
        (['desktop', 'tablet', 'mobile'] as const).forEach((viewport, viewportIndex) => {
          const reorder = reorderedMaps[viewportIndex];
          const origin = reorder.origins[index];
          currentValue[viewport] = reorder.values[index];
          nextVisualSavedValue[viewport] = origin === null
            ? reorder.values[index]
            : visualSavedValues[origin][viewport];
        });
        state.currentValue = currentValue;
        state.visualSavedValue = nextVisualSavedValue;
        applySpacingClass(state.element, currentValue);
        syncSpacingControl(state);
      });
      syncPageTopSpacingControls();
      syncIntroRunControls();
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
      updateActions();
    }) as EventListener, { signal: editorSignal });
    window.addEventListener('vcd:dev-section-structure-changed', () => {
      pageScope.frame(syncIntroRunControls);
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
    }, { signal: editorSignal });
    window.addEventListener('vcd:dev-pending-upsert', (event) => {
      const detail = (event as CustomEvent).detail;
      if (detail?.kind !== 'section-order') return;
      syncIntroRunControls();
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
    }, { signal: editorSignal });
    window.addEventListener('vcd:dev-pending-reverted', () => {
      syncPageTopSpacingControls(false);
      syncIntroRunControls();
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
    }, { signal: editorSignal });

    const undoSectionDelete = (entry: PendingSectionDelete) => {
      const pendingIndex = pendingSectionDeletes.indexOf(entry);
      if (pendingIndex < 0 && !entry.pendingInsert && !entry.restoreToken) {
        throw new Error('This deletion can no longer be restored. Reload to continue editing.');
      }
      if (!getDropZone(entry.documentKey)) throw new Error('The deleted block’s page is no longer available.');
      if (pendingIndex >= 0) pendingSectionDeletes.splice(pendingIndex, 1);
      restorePendingSectionDelete(entry);
      if (detailsBaselines.has(entry.root)) stageProjectDetailsRows(entry.root);
      if (entry.pendingInsert) {
        pendingSectionInserts.push(entry.pendingInsert);
      } else if (entry.restoreToken) {
        pendingSectionInserts.push({
          documentKey: entry.documentKey,
          index: entry.deletedIndex,
          root: entry.root,
          type: entry.root.dataset.devSectionDeletable || 'bodyText',
          sectionId: entry.root.id,
          spacing: entry.root.dataset.devSpacingValue as SpacingValue || 'group',
          textStates: entry.textStates,
          spacingState: entry.spacingState,
          restoreToken: entry.restoreToken,
        });
      }
      if (entry.persistedInsert && !entry.restoreToken) persistedMediaInserts.push(entry.persistedInsert);
      pendingBlockConverts.push(...entry.converts);
      window.dispatchEvent(new CustomEvent('vcd:section-history-reveal', { detail: { block: entry.root } }));
      updateActions();
    };

    deleteSectionAt = async (element: HTMLElement) => {
      if (!element.isConnected || actionsBusy) return;
      captureFieldHistory();
      pageHistory.breakGroup();
      let path: Array<string | number> = [];
      try {
        path = JSON.parse(element.dataset.devSpacingPath || '[]');
      } catch {
        path = [];
      }
      const sectionIndex = path.at(-2);
      const documentKey = element.dataset.devSpacingDocument;
      if (typeof sectionIndex !== 'number' || !documentKey) {
        status.textContent = 'Could not find which section to delete.';
        actions.hidden = false;
        return;
      }

      const sectionId = element.id || undefined;
      const sectionType = element.dataset.devSectionDeletable;
      const titleElement = element.querySelector<HTMLElement>('[data-dev-text-document]');
      const title = titleElement?.textContent?.trim() || 'Section title';
      const insertBefore = element.nextSibling;
      const pendingInsertIdx = pendingSectionInserts.findIndex((entry) => entry.root === element);
      const persistedInsertIdx = persistedMediaInserts.findIndex((entry) => entry.root === element);
      const converts = pendingBlockConverts.filter((entry) => entry.root === element);
      const deletedPendingMedia = [...pendingMedia.values()].filter((change) => {
        if (!isPathPendingMediaChange(change) || String(change.payload.document || '') !== documentKey) return false;
        const mediaPath = readPendingMediaPath(change);
        return mediaPath?.[0] === 'sections' && mediaPath[1] === sectionIndex;
      });
      deletedPendingMedia.forEach((change) => pendingMedia.delete(change.id));
      for (let i = pendingBlockConverts.length - 1; i >= 0; i -= 1) {
        if (pendingBlockConverts[i].root === element) pendingBlockConverts.splice(i, 1);
      }
      const active = document.activeElement;
      const formatNode = savedFormatRange?.commonAncestorContainer;
      if (
        (active instanceof Node && (active === element || element.contains(active)))
        || (formatNode && (formatNode === element || element.contains(formatNode)))
      ) {
        window.getSelection()?.removeAllRanges();
        if (active instanceof HTMLElement) active.blur();
        hideFormatBar();
        syncSpacingCaretSuppression();
      }
      closeSectionMenus();
      const { texts, spacing } = detachSectionStates(element);

      const deletableIdx = deletableSections.indexOf(element);
      if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);

      element.remove();
      reindexDevPaths(sectionIndex, -1, documentKey);

      const entry: PendingSectionDelete = {
        documentKey,
        deletedIndex: sectionIndex,
        root: element,
        insertBefore,
        textStates: texts,
        spacingState: spacing,
        pendingMedia: deletedPendingMedia.map((change) => {
          const path = readPendingMediaPath(change);
          return {
            ...change,
            payload: path ? { ...change.payload, path: [...path] } : { ...change.payload },
          };
        }),
        converts,
        ...(pendingInsertIdx >= 0 ? { pendingInsert: pendingSectionInserts.splice(pendingInsertIdx, 1)[0] } : {}),
        ...(persistedInsertIdx >= 0 ? { persistedInsert: persistedMediaInserts.splice(persistedInsertIdx, 1)[0] } : {}),
        outlineRevert: {
          document: documentKey,
          action: 'insert',
          outlineEntries: structuredClone(getDevSectionOutline().filter((entry) => outlineAnchorId(entry) === sectionId)),
          index: sectionIndex,
          type: sectionType,
          section: { type: sectionType, sectionId, id: sectionId, title },
        },
      };
      if (!entry.pendingInsert) pendingSectionDeletes.push(entry);
      let deletion = entry;
      pageHistory.push({
        label: 'Delete block',
        undo: () => undoSectionDelete(deletion),
        redo: async () => {
          const next = await deleteSectionAt(element);
          if (!next) throw new Error('This block can no longer be deleted.');
          deletion = next;
        },
      });

      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          document: documentKey,
          action: 'delete',
          index: sectionIndex,
          sectionId,
          type: sectionType,
        },
      }));

      syncPageTopSpacingControls();
      updateActions();
      return entry;
    };

    const blockParagraphs = (element: HTMLElement) =>
      [...element.querySelectorAll<HTMLElement>(':scope > p, :scope > div')];

    const paragraphContainingCaret = (
      element: HTMLElement,
      range: Range,
    ): HTMLElement | null => {
      const startElement = range.startContainer instanceof Element
        ? range.startContainer
        : range.startContainer.parentElement;
      const existing = startElement?.closest('p, div');
      if (existing instanceof HTMLElement && existing.parentElement === element) {
        return existing;
      }
      if (range.startContainer === element) {
        const atOffset = element.childNodes[range.startOffset];
        if (atOffset instanceof HTMLElement && atOffset.matches('p, div')) return atOffset;
        const before = element.childNodes[range.startOffset - 1];
        if (before instanceof HTMLElement && before.matches('p, div')) return before;
      }
      return null;
    };

    const caretTextOffset = (element: HTMLElement, range: Range) => {
      const pre = range.cloneRange();
      pre.selectNodeContents(element);
      pre.setEnd(range.startContainer, range.startOffset);
      return pre.toString().length;
    };

    const isAtBlockStart = (state: EditableTextState, range: Range) => {
      if (state.kind === 'text') return caretTextOffset(state.element, range) === 0;
      if (state.kind !== 'paragraphs') return false;
      const paragraphs = blockParagraphs(state.element);
      if (!paragraphs.length) return false;
      const first = paragraphs[0];
      if (range.startContainer === state.element && range.startOffset === 0) return true;
      if (paragraphContainingCaret(state.element, range) !== first) return false;
      const before = document.createRange();
      before.setStart(state.element, 0);
      try {
        before.setEnd(range.startContainer, range.startOffset);
      } catch {
        return false;
      }
      return !fragmentHasContent(before.cloneContents());
    };

    const isAtBlockEnd = (state: EditableTextState, range: Range) => {
      if (state.kind === 'text') {
        return caretTextOffset(state.element, range) === (state.element.textContent ?? '').length;
      }
      if (state.kind !== 'paragraphs') return false;
      const paragraphs = blockParagraphs(state.element);
      if (!paragraphs.length) return false;
      const last = paragraphs[paragraphs.length - 1];
      if (
        range.startContainer === state.element
        && range.startOffset === state.element.childNodes.length
      ) {
        return true;
      }
      if (paragraphContainingCaret(state.element, range) !== last) return false;
      const after = document.createRange();
      try {
        after.setStart(range.startContainer, range.startOffset);
      } catch {
        return false;
      }
      after.setEnd(state.element, state.element.childNodes.length);
      return !fragmentHasContent(after.cloneContents());
    };

    const findMergeableNeighbour = (
      root: HTMLElement,
      direction: 'forward' | 'backward',
    ) => {
      const sibling = direction === 'forward'
        ? root.nextElementSibling
        : root.previousElementSibling;
      if (!(sibling instanceof HTMLElement)) return null;
      const type = sibling.dataset.devSectionDeletable;
      if (type !== 'bodyText' && type !== 'sectionTitle') return null;
      if (sibling.dataset.devSpacingDocument !== root.dataset.devSpacingDocument) return null;
      return sibling;
    };

    const textStateForRoot = (root: HTMLElement) =>
      textStates.find((candidate) => root.contains(candidate.element));

    const placeCaretInHeading = (element: HTMLElement, offset: number) => {
      element.focus();
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      const textNode = element.firstChild;
      if (textNode && textNode.nodeType === Node.TEXT_NODE) {
        const length = textNode.textContent?.length ?? 0;
        range.setStart(textNode, Math.max(0, Math.min(offset, length)));
        range.collapse(true);
      } else {
        range.selectNodeContents(element);
        range.collapse(offset <= 0);
      }
      selection.removeAllRanges();
      selection.addRange(range);
    };

    const placeCaretAtEndOfBlock = (state: EditableTextState) => {
      state.element.focus();
      if (state.kind === 'paragraphs') {
        const last = blockParagraphs(state.element).at(-1);
        if (last) placeCaretInParagraph(last, false);
        return;
      }
      placeCaretInHeading(state.element, (state.element.textContent ?? '').length);
    };

    const placeCaretAtJoin = (node: Node | null, fallback: HTMLElement) => {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      if (node) {
        if (node.nodeType === Node.TEXT_NODE || node instanceof Element) {
          range.setStart(node, 0);
        } else {
          range.setStartBefore(node);
        }
      } else {
        range.setStart(fallback, 0);
      }
      range.collapse(true);
      selection.removeAllRanges();
      selection.addRange(range);
    };

    const materializeParagraphs = (element: HTMLElement) => {
      const paragraphs: HTMLElement[] = [];
      let inline: HTMLElement | null = null;
      for (const node of [...element.childNodes]) {
        if (node instanceof HTMLElement && node.matches('p, div')) {
          paragraphs.push(node);
          inline = null;
        } else {
          if (!inline && node.nodeType === Node.TEXT_NODE && !node.textContent?.trim()) continue;
          if (!inline) {
            inline = document.createElement('p');
            node.before(inline);
            paragraphs.push(inline);
          }
          inline.append(node);
        }
      }
      return paragraphs;
    };

    const takeAbsorbedParagraphs = (element: HTMLElement) => {
      const paragraphs = materializeParagraphs(element);
      while (paragraphs.length > 1 && !fragmentHasContent(paragraphs[0])) paragraphs.shift();
      return paragraphs;
    };

    const inlineJoinParagraph = (
      target: HTMLElement,
      source: HTMLElement,
    ): Node | null => {
      stripParagraphPlaceholders(target);
      stripParagraphPlaceholders(source);
      if (!fragmentHasContent(target)) {
        const incoming = [...source.childNodes];
        if (!incoming.length) {
          target.replaceChildren(createParagraphPlaceholderBreak());
          return null;
        }
        target.replaceChildren(...incoming);
        return target.firstChild;
      }
      const firstIncoming = source.firstChild;
      target.append(...[...source.childNodes]);
      return firstIncoming;
    };

    const lastOrCreateParagraph = (element: HTMLElement) => {
      const last = materializeParagraphs(element).at(-1);
      if (last) return last;
      const created = document.createElement('p');
      created.append(createParagraphPlaceholderBreak());
      element.append(created);
      return created;
    };

    const mergeParagraphsInto = (
      survivor: EditableTextState,
      absorbed: EditableTextState,
    ) => {
      const incoming = takeAbsorbedParagraphs(absorbed.element);
      if (!incoming.some((paragraph) => fragmentHasContent(paragraph))) {
        placeCaretAtEndOfBlock(survivor);
        return;
      }
      const last = lastOrCreateParagraph(survivor.element);
      const [first, ...rest] = incoming;
      const joinNode = inlineJoinParagraph(last, first);
      survivor.element.append(...rest);
      survivor.element.focus();
      placeCaretAtJoin(joinNode, last);
    };

    const mergeParagraphsIntoHeading = (
      survivor: EditableTextState,
      absorbed: EditableTextState,
    ) => {
      const incoming = takeAbsorbedParagraphs(absorbed.element);
      if (!incoming.some((paragraph) => fragmentHasContent(paragraph))) {
        placeCaretAtEndOfBlock(survivor);
        return;
      }
      const survivorText = readPlainDomText(survivor.element);
      const joinOffset = survivorText.length;
      const parts = incoming.map(readPlainDomText);
      const addition = `${parts[0]}${parts.slice(1).map((text) => `\n${text}`).join('')}`;
      survivor.element.textContent = `${survivorText}${addition}`;
      placeCaretInHeading(survivor.element, joinOffset);
    };

    const mergeHeadingIntoParagraphs = (
      survivor: EditableTextState,
      absorbed: EditableTextState,
    ) => {
      const headingText = readPlainDomText(absorbed.element);
      if (!headingText) {
        placeCaretAtEndOfBlock(survivor);
        return;
      }
      const last = lastOrCreateParagraph(survivor.element);
      stripParagraphPlaceholders(last);
      survivor.element.focus();
      if (!fragmentHasContent(last)) {
        const node = document.createTextNode(headingText);
        last.replaceChildren(node);
        placeCaretAtJoin(node, last);
        return;
      }
      const node = document.createTextNode(headingText);
      last.append(node);
      placeCaretAtJoin(node, last);
    };

    const mergeHeadingIntoHeading = (
      survivor: EditableTextState,
      absorbed: EditableTextState,
    ) => {
      const extra = readPlainDomText(absorbed.element);
      if (!extra) {
        placeCaretAtEndOfBlock(survivor);
        return;
      }
      const survivorText = readPlainDomText(survivor.element);
      const joinOffset = survivorText.length;
      survivor.element.textContent = `${survivorText}${extra}`;
      placeCaretInHeading(survivor.element, joinOffset);
    };

    tryMergeBlockAtCaret = (state: EditableTextState, direction: 'forward' | 'backward') => {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return false;
      const range = selection.getRangeAt(0);
      if (!range.collapsed) return false;
      if (!state.element.contains(range.startContainer) && range.startContainer !== state.element) {
        return false;
      }

      const root = state.element.closest<HTMLElement>(
        '[data-dev-section-deletable][data-dev-spacing-document]',
      );
      if (!root) return false;
      const type = root.dataset.devSectionDeletable;
      if (type !== 'bodyText' && type !== 'sectionTitle') return false;

      if (direction === 'backward' && !isAtBlockStart(state, range)) return false;
      if (direction === 'forward' && !isAtBlockEnd(state, range)) return false;

      const neighbour = findMergeableNeighbour(root, direction);
      if (!neighbour) return false;
      const neighbourState = textStateForRoot(neighbour);
      if (!neighbourState) return false;

      const survivor = direction === 'forward' ? state : neighbourState;
      const absorbed = direction === 'forward' ? neighbourState : state;
      const absorbedRoot = direction === 'forward' ? neighbour : root;

      const survivorParagraphs = survivor.kind === 'paragraphs';
      const absorbedParagraphs = absorbed.kind === 'paragraphs';
      if (survivorParagraphs && absorbedParagraphs) {
        mergeParagraphsInto(survivor, absorbed);
      } else if (!survivorParagraphs && absorbedParagraphs) {
        mergeParagraphsIntoHeading(survivor, absorbed);
      } else if (survivorParagraphs && !absorbedParagraphs) {
        mergeHeadingIntoParagraphs(survivor, absorbed);
      } else {
        mergeHeadingIntoHeading(survivor, absorbed);
      }

      void deleteSectionAt(absorbedRoot);
      updateActions();
      return true;
    };

    deletableSections.forEach((element) => {
      mountDeleteButton(element);
    });

    const findInsertAnchor = (index: number, documentKey: string) => {
      const zone = getDropZone(documentKey);
      for (const block of zone?.querySelectorAll<HTMLElement>(
        '[data-dev-spacing-document][data-dev-spacing-path]',
      ) ?? []) {
        if (block.dataset.devSpacingDocument !== documentKey) continue;
        try {
          const path = JSON.parse(block.dataset.devSpacingPath || '[]');
          if (path[0] === 'sections' && path[1] === index + 1) return block;
        } catch {
          // Ignore malformed paths.
        }
      }
      return null;
    };

    const mountMediaSectionInPlace = (
      section: Record<string, unknown>,
      documentKey: string,
      index: number,
    ) => {
      const pageUsesDocument =
        spacingStates.some((state) => state.document === documentKey)
        || textStates.some((state) => state.document === documentKey);
      if (!pageUsesDocument) return;

      reindexDevPaths(index, 1, documentKey);
      const root = mountInsertedSection(section, documentKey, index);
      const anchor = findInsertAnchor(index, documentKey);
      if (anchor) anchor.before(root);
      else getDropZone(documentKey)?.append(root);

      const spacingState = mountSpacingControl(root);
      if (spacingState) {
        spacingStates.push(spacingState);
        wireSectionAddMenu(spacingState);
      }
      registerTextStates(root);
      mountDeleteButton(root);
      deletableSections.push(root);
      initMountedSectionCovers(root);
      syncDevModeOnSection(root, document.documentElement.classList.contains('is-dev-mode'));

      persistedMediaInserts.push({
        documentKey,
        index,
        root,
        section,
      });

      // Media inserts land on disk at drop time, so a pending reorder captured
      // before this point is already stale. Announce the structural change the
      // way the add-block path does — the revert path already does.
      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          document: documentKey,
          action: 'insert',
          index,
          type: String(section.type ?? 'image'),
          section,
        },
      }));

      syncPageTopSpacingControls();
      updateActions();
    };

    const findSectionRootByIndex = (index: number, documentKey: string) => {
      const zone = getDropZone(documentKey);
      for (const block of zone?.querySelectorAll<HTMLElement>(
        '[data-dev-spacing-document][data-dev-spacing-path]',
      ) ?? []) {
        if (block.dataset.devSpacingDocument !== documentKey) continue;
        try {
          const path = JSON.parse(block.dataset.devSpacingPath || '[]');
          if (
            path[0] === 'sections'
            && path[1] === index
            && path.at(-1) === 'spacing'
          ) {
            return block;
          }
        } catch {
          // Ignore malformed paths.
        }
      }
      return null;
    };

    const replaceMediaSectionInPlace = (
      section: Record<string, unknown>,
      documentKey: string,
      index: number,
    ): HTMLElement | null => {
      const pageUsesDocument =
        spacingStates.some((state) => state.document === documentKey)
        || textStates.some((state) => state.document === documentKey);
      if (!pageUsesDocument) return null;

      const existing = findSectionRootByIndex(index, documentKey);
      if (!existing) return null;

      detachSectionStates(existing);
      const deletableIdx = deletableSections.indexOf(existing);
      if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);

      const root = mountInsertedSection(section, documentKey, index);
      existing.replaceWith(root);

      const spacingState = mountSpacingControl(root);
      if (spacingState) {
        spacingStates.push(spacingState);
        wireSectionAddMenu(spacingState);
      }
      registerTextStates(root);
      mountDeleteButton(root);
      deletableSections.push(root);
      initMountedSectionCovers(root);
      syncDevModeOnSection(root, document.documentElement.classList.contains('is-dev-mode'));

      const persisted = persistedMediaInserts.find((entry) => entry.root === existing);
      if (persisted) {
        persisted.root = root;
        persisted.section = section;
      }

      syncPageTopSpacingControls();
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
      updateActions();
      return root;
    };

    const sectionIndexFromRoot = (root: HTMLElement | undefined) => {
      if (!root) return null;
      try {
        const path = JSON.parse(root.dataset.devSpacingPath || '[]');
        if (
          Array.isArray(path)
          && path[0] === 'sections'
          && typeof path[1] === 'number'
        ) {
          return path[1];
        }
      } catch {
        // Ignore malformed paths.
      }
      return null;
    };

    const persistPlaceholderFills = async (documentKey?: string) => {
      const fills = [...pendingMedia.values()].filter((change) => {
        if (change.kind !== 'placeholder-fill') return false;
        if (!documentKey) return true;
        return String(change.payload.document || '') === documentKey;
      });
      for (const change of fills) {
        const index = sectionIndexFromRoot(change.root);
        const filenames = Array.isArray(change.payload.filenames)
          ? change.payload.filenames.map((value) => String(value || '').trim()).filter(Boolean)
          : [];
        if (typeof index !== 'number' || !filenames.length) {
          throw new Error('Could not save a placeholder fill.');
        }
        const variants = (
          change.payload.variants
          && typeof change.payload.variants === 'object'
          && !Array.isArray(change.payload.variants)
        )
          ? change.payload.variants
          : undefined;
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            document: change.payload.document,
            action: 'fillPlaceholder',
            target: sectionEditTarget(change.root),
            index,
            filenames,
            ...(variants ? { variants } : {}),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save the placeholder fill.');
        pendingMedia.delete(change.id);
      }
    };

    window.addEventListener('vcd:dev-flush-pending-edits', ((event: CustomEvent<{
      documentKey?: string;
      resolve?: () => void;
      reject?: (error: Error) => void;
    }>) => {
      const { documentKey, resolve, reject } = event.detail ?? {};
      if (!documentKey) {
        resolve?.();
        return;
      }
      void flushPendingEditsForDocument(documentKey)
        .then(() => resolve?.())
        .catch((error) => {
          reject?.(error instanceof Error ? error : new Error('Could not save pending edits.'));
        });
    }) as EventListener, { signal: editorSignal });

    window.addEventListener('vcd:dev-section-inserted', ((event: CustomEvent<{
      documentKey?: string;
      index?: number;
      section?: Record<string, unknown>;
    }>) => {
      const { documentKey, index, section } = event.detail ?? {};
      if (!documentKey || typeof index !== 'number' || !section) return;
      mountMediaSectionInPlace(section, documentKey, index);
    }) as EventListener, { signal: editorSignal });

    window.addEventListener('vcd:dev-carousel-media-appended', ((event: CustomEvent<{
      documentKey?: string;
      index?: number;
      section?: Record<string, unknown>;
      activeItemId?: string;
    }>) => {
      const { documentKey, index, section, activeItemId } = event.detail ?? {};
      if (!documentKey || typeof index !== 'number' || !section) return;
      const root = replaceMediaSectionInPlace(section, documentKey, index);
      if (root && activeItemId) {
        const carousels = root.matches('[data-project-image-carousel]') ? [root]
          : [...root.querySelectorAll<HTMLElement>('[data-project-image-carousel]')];
        carousels.some((carousel) => restoreCarouselActiveItem(carousel, activeItemId));
      }
    }) as EventListener, { signal: editorSignal });

    window.addEventListener('vcd:dev-grid-media-appended', ((event: CustomEvent<{
      documentKey?: string;
      index?: number;
      section?: Record<string, unknown>;
    }>) => {
      const { documentKey, index, section } = event.detail ?? {};
      if (!documentKey || typeof index !== 'number' || !section) return;
      replaceMediaSectionInPlace(section, documentKey, index);
    }) as EventListener, { signal: editorSignal });

    window.addEventListener('vcd:dev-placeholder-fill-pending', ((event: CustomEvent<{
      documentKey?: string;
      index?: number;
      filenames?: string[];
      previousSection?: Record<string, unknown>;
      section?: Record<string, unknown>;
    }>) => {
      const {
        documentKey,
        index,
        filenames,
        previousSection,
        section,
      } = event.detail ?? {};
      if (
        !documentKey
        || typeof index !== 'number'
        || !section
        || !previousSection
        || !Array.isArray(filenames)
        || !filenames.length
      ) {
        return;
      }

      const id = `placeholder-fill:${documentKey}:${index}`;
      const existing = pendingMedia.get(id);
      const baseline = (
        existing
        && typeof existing.payload.previousSection === 'object'
        && existing.payload.previousSection
        && !Array.isArray(existing.payload.previousSection)
      )
        ? existing.payload.previousSection as Record<string, unknown>
        : previousSection;

      const root = replaceMediaSectionInPlace(section, documentKey, index);
      if (!root) return;

      const pendingId = id;
      const variants = (
        section.variants
        && typeof section.variants === 'object'
        && !Array.isArray(section.variants)
      )
        ? structuredClone(section.variants)
        : undefined;
      pendingMedia.set(pendingId, {
        id: pendingId,
        kind: 'placeholder-fill',
        root,
        payload: {
          document: documentKey,
          filenames: [...filenames],
          previousSection: baseline,
          ...(variants ? { variants } : {}),
        },
        revert: () => {
          const current = pendingMedia.get(pendingId);
          const liveIndex = sectionIndexFromRoot(current?.root) ?? index;
          replaceMediaSectionInPlace(baseline, documentKey, liveIndex);
        },
      });
      updateActions();
    }) as EventListener, { signal: editorSignal });

    const syncDeleteButtons = (enabled: boolean) => {
      deletableSections.forEach((element) => {
        const button = element.querySelector<HTMLButtonElement>(':scope > [data-dev-section-delete]');
        if (button) button.hidden = !enabled;
      });
    };

    window.addEventListener('vcd:dev-pending-upsert', ((event: CustomEvent<PendingMediaChange>) => {
      const detail = event.detail;
      if (
        !detail?.id ||
        (detail.kind !== 'crop'
          && detail.kind !== 'grid'
          && detail.kind !== 'carousel'
          && detail.kind !== 'caption'
          && detail.kind !== 'listing-order'
          && detail.kind !== 'section-order'
          && detail.kind !== 'placeholder-fill'
          && detail.kind !== 'style-token'
          && detail.kind !== 'section-nav'
          && detail.kind !== 'media-remove'
          && detail.kind !== 'project-settings'
          && detail.kind !== 'gallery-membership'
          && detail.kind !== 'project-details-rows'
          && detail.kind !== 'annotation')
      ) {
        return;
      }
      if (typeof detail.revert !== 'function' || !detail.payload || typeof detail.payload !== 'object') {
        return;
      }
      if (isPathPendingMediaChange(detail) || detail.kind === 'media-remove') {
        detail.payload = withDevEditTarget(detail.payload);
      }
      pendingMedia.set(detail.id, detail);
      if (detail.kind === 'section-order') syncPageTopSpacingControls();
      updateActions();
    }) as EventListener, { signal: editorSignal });

    window.addEventListener('vcd:dev-pending-remove', ((event: CustomEvent<{ id?: string }>) => {
      const id = event.detail?.id;
      if (!id || !pendingMedia.has(id)) return;
      pendingMedia.delete(id);
      updateActions();
    }) as EventListener, { signal: editorSignal });

    /* ── Selection formatting popup ───────────────────────── */
    let savedFormatRange: Range | null = null;
    let savedFormatFocusEdge: 'start' | 'end' = 'end';
    /** Fallback paint when collapsed selection empties getClientRects (Edge). */
    let savedFormatRects: DOMRect[] = [];
    let linkPanelOpen = false;
    let formatPlacement: 'above' | 'below' = 'above';
    let formatRaf = 0;
    let formatDismissGeneration = 0;
    let formatDismissTimer = 0;
    let linkInputFocusRaf = 0;
    let formatDismissPointer: {
      id: number;
      generation: number;
      active: boolean;
    } | null = null;

    const canCustomHighlight =
      typeof CSS !== 'undefined'
      && Boolean(CSS.highlights)
      && typeof Highlight !== 'undefined';

    const isFormatBarDismissing = () =>
      formatDismissTimer !== 0
      || formatBar.classList.contains('is-dev-text-format-dismissing');

    const paragraphStates = () => textStates.filter((state) => state.kind === 'paragraphs');

    const findParagraphState = (node: Node | null) => {
      if (!node) return null;
      return (
        paragraphStates().find((state) => state.element.contains(node)) ?? null
      );
    };

    const findBlockState = (node: Node | null): {
      state: EditableTextState;
      section: HTMLElement;
    } | null => {
      if (!node) return null;
      const el = node instanceof Element ? node : node.parentElement;
      if (!el) return null;
      const host = el.closest<HTMLElement>('[data-dev-text-document][data-dev-text-path]');
      if (!host) return null;
      const state = textStates.find((entry) => entry.element === host);
      if (!state) return null;
      const section = state.element.closest<HTMLElement>('[data-dev-section-deletable]');
      if (!section) return null;
      const deletable = section.dataset.devSectionDeletable;
      if (state.kind === 'paragraphs' && deletable === 'bodyText') {
        return { state, section };
      }
      const isHeadingTag = state.element.matches('h2.project-section-title, h3.project-section-title');
      if (
        deletable === 'sectionTitle'
        && (
          isHeadingTag
          || (
            state.kind === 'text'
            && (
              state.element.matches('.project-section-title, [data-dev-section-title]')
              || state.element.dataset.devTextKind === 'text'
            )
          )
        )
      ) {
        return { state, section };
      }
      return null;
    };

    const blockStyleValue = (state: EditableTextState): string => {
      if (state.element.matches('h3.project-section-title')) return 'sectionTitle:3';
      if (state.element.matches('h2.project-section-title')) return 'sectionTitle:2';
      if (state.kind === 'paragraphs') return 'bodyText';
      return state.element.tagName === 'H3' ? 'sectionTitle:3' : 'sectionTitle:2';
    };

    const parseBlockStyle = (value: string): { type: 'bodyText' | 'sectionTitle'; level?: 2 | 3 } => {
      if (value === 'sectionTitle:3') return { type: 'sectionTitle', level: 3 };
      if (value === 'sectionTitle:2' || value === 'sectionTitle') return { type: 'sectionTitle', level: 2 };
      return { type: 'bodyText' };
    };

    const readPlainBlockText = (state: EditableTextState): string => {
      if (state.kind !== 'paragraphs') {
        return readPlainDomText(state.element);
      }
      return readParagraphsValue(state.element).map((html) => {
        const paragraph = document.createElement('p');
        fillParagraph(paragraph, html);
        return readPlainDomText(paragraph);
      }).join('\n');
    };

    const sectionIndexFromBlock = (section: HTMLElement): number | null => {
      try {
        const path = JSON.parse(section.dataset.devSpacingPath || '[]');
        const index = path.at(-2);
        return typeof index === 'number' ? index : null;
      } catch {
        return null;
      }
    };

    let syncingBlockStyle = false;

    const syncBlockStyleSelect = (state: EditableTextState) => {
      const field = blockStyleSelect.closest<HTMLElement>('.dev-text-format__block-style');
      if (field) field.hidden = Boolean(state.element.closest('[data-dev-project-details]'));
      const next = blockStyleValue(state);
      syncingBlockStyle = true;
      if (blockStyleSelect.value !== next) {
        blockStyleSelect.value = next;
      }
      blockStyleSelect.dispatchEvent(new Event('change', { bubbles: true }));
      syncingBlockStyle = false;
    };

    const syncFormatInlineVisibility = (state: EditableTextState) => {
      const hidden = state.kind !== 'paragraphs';
      formatInline.hidden = hidden;
      emphasisStyleField.hidden = hidden;
      if (wrapStyleField) wrapStyleField.hidden = hidden;
    };

    const enableConvertedText = (element: HTMLElement, kind: EditableTextState['kind']) => {
      if (!isDevContentEditing()) return;
      element.setAttribute('contenteditable', kind === 'paragraphs' ? 'true' : 'plaintext-only');
      element.setAttribute('spellcheck', 'true');
    };

    const retargetSpacingState = (oldRoot: HTMLElement, newRoot: HTMLElement) => {
      const previous = spacingStates.find((entry) => entry.element === oldRoot) ?? null;
      const prevIdx = previous ? spacingStates.indexOf(previous) : -1;
      if (prevIdx >= 0) spacingStates.splice(prevIdx, 1);
      const next = mountSpacingControl(newRoot);
      if (next) {
        if (previous) {
          next.savedValue = cloneSpacing(previous.savedValue);
          next.visualSavedValue = cloneSpacing(previous.visualSavedValue);
          next.currentValue = cloneSpacing(previous.currentValue);
          applySpacingClass(newRoot, previous.currentValue);
          syncSpacingControl(next);
          if (next.introHeight && previous.introHeight) {
            next.introHeight.savedValue = previous.introHeight.savedValue;
            next.introHeight.currentValue = previous.introHeight.currentValue;
            syncIntroHeightControl(next.introHeight);
          }
        }
        spacingStates.push(next);
        wireSectionAddMenu(next);
      }
      return next;
    };

    const convertCurrentBlock = (value: string) => {
      const selection = window.getSelection();
      const node = savedFormatRange?.commonAncestorContainer
        ?? (selection?.rangeCount ? selection.getRangeAt(0).commonAncestorContainer : null);
      const block = findBlockState(node);
      if (!block || block.section.matches('[data-dev-project-details]')) return;
      const current = blockStyleValue(block.state);
      if (current === value) return;

      const parsed = parseBlockStyle(value);
      const from: 'bodyText' | 'sectionTitle' = block.state.kind === 'paragraphs' ? 'bodyText' : 'sectionTitle';
      const index = sectionIndexFromBlock(block.section);
      if (index == null) return;

      const previousTextElement = block.state.element;
      const previousPath = [...block.state.path];
      const previousKind = block.state.kind;
      const previousRoot = block.section;
      const text = readPlainBlockText(block.state);
      const spacing = (block.section.dataset.devSpacingValue || 'group') as SpacingValue;
      const precedeRelated = block.section.classList.contains('project-stack--precede-related');

      if (from === 'sectionTitle' && parsed.type === 'sectionTitle') {
        const nextTag = parsed.level === 3 ? 'h3' : 'h2';
        const heading = document.createElement(nextTag);
        [...previousTextElement.attributes].forEach((attr) => heading.setAttribute(attr.name, attr.value));
        heading.className = previousTextElement.className;
        heading.textContent = text;
        previousTextElement.replaceWith(heading);
        block.state.element = heading;
        enableConvertedText(heading, 'text');
        bindTextState(block.state);

        const previousRootId = previousRoot.id;
        const fromWasH1 = current === 'sectionTitle:2';
        const toIsH1 = parsed.level === 2;
        let outlineAction: 'insert' | 'delete' | undefined;
        let outlineSectionId: string | undefined;
        if (toIsH1) {
          const sectionId = previousRoot.id || `title-${Date.now().toString(36)}`;
          previousRoot.id = sectionId;
          previousRoot.classList.add('section-block');
          previousRoot.dataset.devSectionTitle = 'true';
          outlineAction = 'insert';
          outlineSectionId = sectionId;
          window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
            detail: {
              document: block.state.document,
              action: 'insert',
              index,
              type: 'sectionTitle',
              sectionId,
              section: {
                type: 'sectionTitle',
                id: sectionId,
                sectionId,
                title: text,
              },
            },
          }));
        } else if (fromWasH1) {
          outlineSectionId = previousRoot.id || undefined;
          outlineAction = 'delete';
          if (outlineSectionId) {
            window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
              detail: {
                document: block.state.document,
                action: 'delete',
                index,
                sectionId: outlineSectionId,
                type: 'sectionTitle',
              },
            }));
          }
        }

        const insert = pendingSectionInserts.find((entry) => entry.root === previousRoot);
        if (insert) insert.level = parsed.level ?? 2;

        pendingBlockConverts.push({
          documentKey: block.state.document,
          index,
          from,
          to: 'sectionTitle',
          level: parsed.level,
          root: previousRoot,
          previousRoot,
          previousTextElement,
          previousPath,
          previousKind,
          previousSpacingState: null,
          previousRootId,
          outlineAction,
          outlineSectionId,
          outlineTitle: text,
          textState: block.state,
          replacedRoot: false,
          skipPersist: Boolean(insert),
        });
        stickyStatus = '';
        window.dispatchEvent(new Event('vcd:intro-layout-sync'));
        updateActions();
        pageScope.frame(() => {
          heading.focus();
          const range = document.createRange();
          range.selectNodeContents(heading);
          range.collapse(true);
          const live = window.getSelection();
          live?.removeAllRanges();
          live?.addRange(range);
          scheduleFormatBarUpdate();
        });
        return;
      }

      const built = buildConvertedSection(
        parsed.type,
        block.state.document,
        index,
        spacing,
        text,
        parsed.level ?? 2,
      );
      if (precedeRelated) built.root.classList.add('project-stack--precede-related');

      const previousHadIntro =
        previousRoot.classList.contains('project-block--intro') ||
        previousRoot.dataset.devIntro === 'true';
      if (previousHadIntro) {
        built.root.classList.add('project-block--intro');
        built.root.dataset.devIntro = 'true';
        built.root.dataset.devIntroHeightDocument = previousRoot.dataset.devIntroHeightDocument || block.state.document;
        built.root.dataset.devIntroHeightPath = previousRoot.dataset.devIntroHeightPath
          || JSON.stringify(['introHeight']);
        built.root.dataset.devIntroHeightValue = previousRoot.dataset.devIntroHeightValue || '75';
        built.root.style.setProperty(
          '--intro-height',
          previousRoot.style.getPropertyValue('--intro-height') || previousRoot.dataset.devIntroHeightValue || '75',
        );
      }

      const previousRootId = previousRoot.id;
      const fromWasH1 = current === 'sectionTitle:2';
      const toIsH1 = parsed.type === 'sectionTitle' && parsed.level === 2;

      if (previousRoot.dataset.devContentId) built.root.dataset.devContentId = previousRoot.dataset.devContentId;
      if (previousRoot.dataset.siteAnnotationSectionId) {
        built.root.dataset.siteAnnotationSectionId = previousRoot.dataset.siteAnnotationSectionId;
        built.root.dataset.siteAnnotationDocument = block.state.document;
        const layer = previousRoot.querySelector(':scope > [data-site-annotations]');
        if (layer) built.root.append(layer);
      }
      previousRoot.replaceWith(built.root);

      const delIdx = deletableSections.indexOf(previousRoot);
      if (delIdx >= 0) deletableSections[delIdx] = built.root;
      else deletableSections.push(built.root);

      const previousSpacingState = spacingStates.find((entry) => entry.element === previousRoot) ?? null;
      const spacingState = retargetSpacingState(previousRoot, built.root);
      mountDeleteButton(built.root);

      const insert = pendingSectionInserts.find((entry) => entry.root === previousRoot);
      if (insert) {
        insert.root = built.root;
        insert.type = parsed.type;
        insert.level = parsed.type === 'sectionTitle' ? (parsed.level ?? 2) : undefined;
        insert.textStates = [block.state];
        insert.spacingState = spacingState ?? null;
        if (previousHadIntro) insert.intro = true;
      }

      block.state.element = built.textElement;
      block.state.path = built.textPath;
      block.state.kind = built.textKind;
      enableConvertedText(built.textElement, built.textKind);
      bindTextState(block.state);

      if (parsed.type === 'sectionTitle') {
        built.root.dataset.devSectionTitle = 'true';
      }

      let outlineAction: 'insert' | 'delete' | undefined;
      let outlineSectionId: string | undefined;
      if (toIsH1) {
        const sectionId = previousRootId || `title-${Date.now().toString(36)}`;
        built.root.id = sectionId;
        built.root.classList.add('section-block');
        built.root.dataset.devSectionTitle = 'true';
        outlineAction = 'insert';
        outlineSectionId = sectionId;
        window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
          detail: {
            document: block.state.document,
            action: 'insert',
            index,
            type: 'sectionTitle',
            sectionId,
            section: {
              type: 'sectionTitle',
              id: sectionId,
              sectionId,
              title: text,
            },
          },
        }));
      } else if (fromWasH1) {
        const mintedThisSession = pendingBlockConverts.some(
          (entry) => entry.root === previousRoot && entry.outlineAction === 'insert' && !entry.previousRootId,
        );
        outlineSectionId = previousRootId || undefined;
        outlineAction = 'delete';
        if (outlineSectionId) {
          window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
            detail: {
              document: block.state.document,
              action: 'delete',
              index,
              sectionId: outlineSectionId,
              type: 'sectionTitle',
            },
          }));
          if (!mintedThisSession) {
            built.root.id = outlineSectionId;
            built.root.classList.add('section-block');
          }
        }
      } else if (previousRootId) {
        built.root.id = previousRootId;
        built.root.classList.add('section-block');
      }

      pendingBlockConverts.push({
        documentKey: block.state.document,
        index,
        from,
        to: parsed.type,
        level: parsed.level,
        root: built.root,
        previousRoot,
        previousTextElement,
        previousPath,
        previousKind,
        previousSpacingState,
        previousRootId,
        outlineAction,
        outlineSectionId,
        outlineTitle: text,
        textState: block.state,
        replacedRoot: true,
        skipPersist: Boolean(insert),
      });

      syncIntroRunControls();
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
      window.dispatchEvent(new Event('vcd:site-annotation-targets-changed'));

      stickyStatus = '';
      updateActions();
      pageScope.frame(() => {
        built.textElement.focus();
        if (built.textKind === 'paragraphs') {
          ensureParagraphSelection(built.textElement);
        } else {
          const range = document.createRange();
          range.selectNodeContents(built.textElement);
          range.collapse(true);
          const live = window.getSelection();
          live?.removeAllRanges();
          live?.addRange(range);
        }
        scheduleFormatBarUpdate();
      });
    };

    const closestAnchor = (node: Node | null): HTMLAnchorElement | null => {
      const el = node instanceof Element ? node : node?.parentElement;
      return el?.closest('a') ?? null;
    };

    const saveFormatRange = (range: Range, selection = window.getSelection()) => {
      savedFormatRange = range.cloneRange();
      savedFormatFocusEdge = selection?.focusNode === range.startContainer
        && selection.focusOffset === range.startOffset
        ? 'start'
        : 'end';
      return savedFormatRange;
    };

    const restoreFormatRange = () => {
      if (!savedFormatRange) return false;
      const selection = window.getSelection();
      if (!selection) return false;
      if (savedFormatFocusEdge === 'start') {
        selection.setBaseAndExtent(
          savedFormatRange.endContainer,
          savedFormatRange.endOffset,
          savedFormatRange.startContainer,
          savedFormatRange.startOffset,
        );
      } else {
        selection.setBaseAndExtent(
          savedFormatRange.startContainer,
          savedFormatRange.startOffset,
          savedFormatRange.endContainer,
          savedFormatRange.endOffset,
        );
      }
      return true;
    };

    const captureFormatRange = () => {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return null;
      const range = selection.getRangeAt(0);
      if (range.collapsed) return null;
      if (!findParagraphState(range.commonAncestorContainer)) return null;
      return saveFormatRange(range, selection);
    };

    const FORMAT_HIGHLIGHT = 'vcd-format-sel';
    const FORMAT_BAR_GAP = 20;
    const syncLinkTextField = () => {
      linkInput.dispatchEvent(new CustomEvent('vcd:text-field-sync', { bubbles: true }));
    };

    const getFormatRangeRects = (range: Range): DOMRect[] => {
      let rects = [...range.getClientRects()];
      if (!rects.length) {
        const bound = range.getBoundingClientRect();
        if (bound.width || bound.height) rects = [bound];
      }
      return rects;
    };

    const getFormatEndpointLineRect = (
      range: Range,
      focusEdge: 'start' | 'end',
      owner: HTMLElement,
    ): DOMRect => {
      const endpoint = range.cloneRange();
      endpoint.collapse(focusEdge === 'start');
      const endpointRect = endpoint.getBoundingClientRect();
      if (endpointRect.height > 0) return endpointRect;
      const endpointClientRect = [...endpoint.getClientRects()].find((rect) => rect.height > 0);
      if (endpointClientRect) return endpointClientRect;

      const rangeRects = [...range.getClientRects()].filter((rect) => rect.height > 0);
      const rangeEdgeRect = focusEdge === 'start' ? rangeRects[0] : rangeRects.at(-1);
      if (rangeEdgeRect) return rangeEdgeRect;

      if (range.collapsed) {
        const suffix = range.cloneRange();
        suffix.setEnd(owner, owner.childNodes.length);
        const suffixRect = [...suffix.getClientRects()].find((rect) => rect.height > 0);
        if (suffixRect) return suffixRect;

        const prefix = range.cloneRange();
        prefix.setStart(owner, 0);
        const prefixRects = [...prefix.getClientRects()].filter((rect) => rect.height > 0);
        const prefixRect = prefixRects.at(-1);
        if (prefixRect) return prefixRect;
      }

      return owner.getBoundingClientRect();
    };

    const captureFormatRects = (range: Range | null) => {
      savedFormatRects = range ? getFormatRangeRects(range) : [];
    };

    /** Out of flow while closed — measure open height without affecting layout. */
    const measureLinkPanelHeight = (): number => {
      const prev = {
        display: linkPanel.style.display,
        position: linkPanel.style.position,
        visibility: linkPanel.style.visibility,
      };
      linkPanel.style.display = 'flex';
      linkPanel.style.position = 'absolute';
      linkPanel.style.visibility = 'hidden';
      const rect = linkPanel.getBoundingClientRect();
      linkPanel.style.display = prev.display;
      linkPanel.style.position = prev.position;
      linkPanel.style.visibility = prev.visibility;
      return rect.height || 33;
    };

    const hideFormatBar = (pointerId: number | null = null) => {
      cancelAnimationFrame(formatRaf);
      formatRaf = 0;
      cancelAnimationFrame(linkInputFocusRaf);
      linkInputFocusRaf = 0;
      if (formatDismissTimer) window.clearTimeout(formatDismissTimer);
      const generation = ++formatDismissGeneration;
      formatDismissPointer = pointerId == null
        ? null
        : { id: pointerId, generation, active: true };
      linkPanelOpen = false;
      document.documentElement.style.removeProperty('--dev-mobile-format-space');
      savedFormatRange = null;
      savedFormatFocusEdge = 'end';
      savedFormatRects = [];
      formatBar.dataset.placement = 'above';
      if (canCustomHighlight) CSS.highlights.delete(FORMAT_HIGHLIGHT);
      formatSel.replaceChildren();
      formatSel.hidden = true;
      formatBar.getBoundingClientRect();
      formatBar.classList.add('is-dev-text-format-dismissing');
      formatBar.classList.remove('is-dev-text-format-offscreen');
      formatBar.inert = true;
      formatDismissTimer = pageScope.timeout(() => {
        if (generation !== formatDismissGeneration) return;
        formatDismissTimer = 0;
        linkInput.value = '';
        linkInput.setCustomValidity('');
        syncLinkTextField();
        formatBar.dataset.linkOpen = 'false';
        linkPanel.setAttribute('aria-hidden', 'true');
        formatBar.hidden = true;
        formatBar.classList.remove('is-dev-text-format-dismissing');
        formatBar.inert = false;
        maybeScheduleFormatBarAfterDismiss(generation);
      }, 150);
    };

    const setLinkPanelOpen = (open: boolean) => {
      cancelAnimationFrame(linkInputFocusRaf);
      linkInputFocusRaf = 0;
      linkPanelOpen = open;
      formatBar.dataset.linkOpen = open ? 'true' : 'false';
      linkPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open) {
        if (savedFormatRange) captureFormatRects(savedFormatRange);
        const anchors = savedFormatRange ? anchorsInRange(savedFormatRange) : [];
        const anchor = anchors.length === 1 ? anchors[0] : null;
        linkInput.value = anchor?.getAttribute('href') || '';
        syncLinkTextField();
        // Paint stand-in before focus collapses the native selection (Edge).
        syncFormatSelectionOverlay();
        const generation = formatDismissGeneration;
        linkInputFocusRaf = pageScope.frame(() => {
          linkInputFocusRaf = 0;
          if (
            !linkPanelOpen
            || generation !== formatDismissGeneration
            || formatBar.hidden
            || formatBar.inert
          ) return;
          linkInput.focus();
          linkInput.select();
          syncFormatSelectionOverlay();
        });
      } else {
        linkInput.value = '';
        syncLinkTextField();
        syncFormatSelectionOverlay();
      }
    };

    const syncFormatSelectionOverlay = () => {
      const show = Boolean(
        savedFormatRange
        && !formatBar.hidden
        && !formatBar.classList.contains('is-dev-text-format-offscreen')
        && !formatBar.classList.contains('is-dev-text-format-dismissing')
        && linkPanelOpen,
      );
      if (canCustomHighlight) {
        if (show && savedFormatRange) {
          CSS.highlights.set(FORMAT_HIGHLIGHT, new Highlight(savedFormatRange));
        } else {
          CSS.highlights.delete(FORMAT_HIGHLIGHT);
        }
      }

      formatSel.replaceChildren();
      if (!show || !savedFormatRange) {
        formatSel.hidden = true;
        return;
      }
      formatSel.hidden = false;
      let rects = getFormatRangeRects(savedFormatRange);
      if (!rects.length && savedFormatRects.length) rects = savedFormatRects;
      for (const r of rects) {
        if (r.width < 1 && r.height < 1) continue;
        const box = document.createElement('div');
        box.style.cssText = [
          'position:fixed',
          `top:${r.top}px`,
          `left:${r.left}px`,
          `width:${Math.max(r.width, 1)}px`,
          `height:${Math.max(r.height, 1)}px`,
          'background:color-mix(in srgb, CanvasText 18%, transparent)',
          'pointer-events:none',
        ].join(';');
        formatSel.append(box);
      }
    };

    const syncFormatButtons = () => {
      const selectedAnchors = savedFormatRange ? anchorsInRange(savedFormatRange) : [];
      const hasSelectedLink = selectedAnchors.length === 1;
      formatButtons.forEach((button) => {
        const command = button.dataset.devFormat;
        let active = false;
        if (command === 'bold' || command === 'italic') {
          active = Boolean(savedFormatRange && markCoversRange(savedFormatRange, command));
        } else if (command === 'underline') {
          if (hasSelectedLink) {
            active = false;
          } else {
            active = Boolean(savedFormatRange && markCoversRange(savedFormatRange, 'underline'));
          }
        } else if (command === 'link') {
          active = hasSelectedLink || linkPanelOpen;
        }
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      syncEmphasisStyle();
      syncTextWrap();
    };

    const positionFormatBar = (range: Range, revealCaret = false) => {
      const mobile = window.matchMedia('(max-width: 40em)').matches;
      const viewport = window.visualViewport;
      const viewportLeft = viewport?.offsetLeft ?? 0;
      const viewportTop = viewport?.offsetTop ?? 0;
      const viewportWidth = viewport?.width ?? window.innerWidth;
      const viewportBottom = viewportTop + (viewport?.height ?? window.innerHeight);
      const pad = 8;
      const owner = findBlockState(range.commonAncestorContainer)?.state.element ?? null;
      const endpointLineRect = owner
        ? getFormatEndpointLineRect(range, savedFormatFocusEdge, owner)
        : null;
      const endpointLineOffscreen = Boolean(
        endpointLineRect
        && (endpointLineRect.bottom <= viewportTop || endpointLineRect.top >= viewportBottom),
      );

      if (endpointLineOffscreen && !mobile) {
        formatBar.hidden = false;
        if (isFormatBarTarget(document.activeElement)) {
          owner?.focus({ preventScroll: true });
          restoreFormatRange();
        }
        formatBar.classList.add('is-dev-text-format-offscreen');
        formatBar.inert = true;
        syncFormatSelectionOverlay();
        return;
      }

      formatBar.classList.remove('is-dev-text-format-offscreen');
      formatBar.inert = false;

      let rect = range.getBoundingClientRect();
      if (!rect.width && !rect.height) {
        const client = range.getClientRects()[0];
        if (client) rect = client;
      }
      if (!rect.width && !rect.height && !linkPanelOpen) {
        const node = range.startContainer;
        const el = node instanceof Element ? node : node.parentElement;
        if (!el) {
          hideFormatBar();
          return;
        }
        const fallback = el.getBoundingClientRect();
        rect = new DOMRect(
          rect.left || fallback.left,
          rect.top || fallback.top,
          0,
          Math.max(fallback.height, 16),
        );
      }

      formatBar.hidden = false;
      formatBar.dataset.linkOpen = linkPanelOpen ? 'true' : 'false';

      const buttons = formatBar.querySelector<HTMLElement>('.dev-text-format__buttons');
      const surface = formatBar.querySelector<HTMLElement>('.dev-text-format__surface');
      const surfaceStyle = surface ? getComputedStyle(surface) : null;
      const padX = surfaceStyle
        ? Number.parseFloat(surfaceStyle.paddingLeft) + Number.parseFloat(surfaceStyle.paddingRight)
        : 12;
      const padY = surfaceStyle
        ? Number.parseFloat(surfaceStyle.paddingTop) + Number.parseFloat(surfaceStyle.paddingBottom)
        : 12;
      const borderX = surfaceStyle
        ? Number.parseFloat(surfaceStyle.borderLeftWidth) + Number.parseFloat(surfaceStyle.borderRightWidth)
        : 2;
      const borderY = surfaceStyle
        ? Number.parseFloat(surfaceStyle.borderTopWidth) + Number.parseFloat(surfaceStyle.borderBottomWidth)
        : 2;
      const flexGap = surfaceStyle ? Number.parseFloat(surfaceStyle.rowGap || surfaceStyle.gap) || 4 : 4;
      // Measure the wrapped controls independently of the previous surface width.
      formatBar.style.setProperty('--dev-format-content-width', `${Math.max(0, viewportWidth - 2 * pad - padX - borderX)}px`);
      const buttonsRect = buttons?.getBoundingClientRect();
      const buttonsH = buttonsRect?.height ?? 32;
      const buttonsW = buttonsRect?.width ?? 0;
      const slotWidth = buttonsW + padX + borderX;
      if (surface) surface.style.width = `${slotWidth}px`;
      const linkPanelHeight = measureLinkPanelHeight();
      const closedHeight = buttonsH + padY + borderY;
      const openHeight = closedHeight + flexGap + linkPanelHeight;

      const slotHeight = mobile && !linkPanelOpen
        ? closedHeight
        : openHeight;
      const spaceAbove = rect.top - viewportTop;
      const spaceBelow = viewportBottom - rect.bottom;
      const preferAbove = spaceAbove >= slotHeight + FORMAT_BAR_GAP || spaceAbove >= spaceBelow;

      formatPlacement = preferAbove ? 'above' : 'below';
      formatBar.dataset.placement = formatPlacement;

      /*
        Desktop follows the selection and reserves link height. Phones dock to
        the visible viewport so formatting never floats over the writing line.
      */
      let slotTop = mobile ? viewportBottom - slotHeight - pad : preferAbove
        ? rect.top - slotHeight - FORMAT_BAR_GAP
        : rect.bottom + FORMAT_BAR_GAP;

      let slotLeft = mobile ? viewportLeft + pad : rect.left + rect.width / 2 - slotWidth / 2;
      slotLeft = Math.max(viewportLeft + pad, Math.min(slotLeft, viewportLeft + viewportWidth - slotWidth - pad));
      slotTop = Math.max(viewportTop + pad, Math.min(slotTop, viewportBottom - slotHeight - pad));
      formatBar.style.top = `${Math.round(slotTop)}px`;
      formatBar.style.left = `${Math.round(slotLeft)}px`;
      if (mobile) {
        document.documentElement.style.setProperty('--dev-mobile-format-space', `${Math.max(0, window.innerHeight - viewportBottom) + slotHeight + 2 * pad}px`);
        if (revealCaret && owner === document.activeElement && endpointLineRect) {
          const top = viewportTop + pad;
          const bottom = slotTop - pad;
          const delta = endpointLineRect.bottom > bottom ? endpointLineRect.bottom - bottom
            : endpointLineRect.top < top ? endpointLineRect.top - top : 0;
          if (delta && bottom - top >= endpointLineRect.height) window.scrollBy({ top: delta, behavior: 'instant' });
        }
      } else document.documentElement.style.removeProperty('--dev-mobile-format-space');
      syncFormatSelectionOverlay();
    };

    const updateFormatBar = (revealCaret = false) => {
      if (isFormatBarDismissing() || formatDismissPointer?.active) return;
      if (!isDevContentEditing()) {
        hideFormatBar();
        return;
      }

      const active = document.activeElement;
      if (
        (active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement)
        && !isFormatBarTarget(active)
      ) {
        hideFormatBar();
        return;
      }

      // Keep the bar while the link panel is focused / open.
      if (linkPanelOpen && savedFormatRange) {
        positionFormatBar(savedFormatRange, revealCaret);
        syncFormatButtons();
        return;
      }

      // Don't steal focus from the format UI itself.
      if (active instanceof Node && isFormatBarTarget(active) && !formatBar.hidden && savedFormatRange) {
        const block = findBlockState(savedFormatRange.commonAncestorContainer);
        if (block) {
          syncBlockStyleSelect(block.state);
          syncFormatInlineVisibility(block.state);
        }
        positionFormatBar(savedFormatRange, revealCaret);
        syncFormatButtons();
        return;
      }

      const focusBlock = active instanceof Node ? findBlockState(active) : null;
      if (!(active instanceof Node && isFormatBarTarget(active)) && !focusBlock) {
        hideFormatBar();
        return;
      }

      const selection = window.getSelection();
      if (!selection?.rangeCount) {
        hideFormatBar();
        return;
      }

      const range = selection.getRangeAt(0);
      const selectionBlock = findBlockState(range.commonAncestorContainer);
      const block = focusBlock ?? selectionBlock;
      if (!block || block.section.matches('[data-dev-project-details]')) {
        hideFormatBar();
        return;
      }

      saveFormatRange(range, selection);
      if (!linkPanelOpen) setLinkPanelOpen(false);
      syncBlockStyleSelect(block.state);
      syncFormatInlineVisibility(block.state);
      positionFormatBar(savedFormatRange, revealCaret);
      syncFormatButtons();
    };

    let mobileCaretRevealPending = false;
    const scheduleFormatBarUpdate = (revealCaret = false) => {
      mobileCaretRevealPending ||= revealCaret;
      if (isFormatBarDismissing() || formatDismissPointer?.active) return;
      cancelAnimationFrame(formatRaf);
      const generation = formatDismissGeneration;
      formatRaf = pageScope.frame(() => {
        formatRaf = 0;
        if (
          generation !== formatDismissGeneration
          || isFormatBarDismissing()
          || formatDismissPointer?.active
        ) return;
        const reveal = mobileCaretRevealPending;
        mobileCaretRevealPending = false;
        updateFormatBar(reveal);
      });
    };

    const maybeScheduleFormatBarAfterDismiss = (generation: number) => {
      const gesture = formatDismissPointer;
      if (
        !gesture
        || gesture.generation !== generation
        || gesture.active
        || generation !== formatDismissGeneration
        || isFormatBarDismissing()
      ) return;
      formatDismissPointer = null;
      const selection = window.getSelection();
      if (!selection?.rangeCount || selection.isCollapsed) return;
      const range = selection.getRangeAt(0);
      if (!findBlockState(range.commonAncestorContainer)) return;
      scheduleFormatBarUpdate();
    };

    const refreshFormatBarAfterCommand = () => {
      const selection = window.getSelection();
      if (!selection?.rangeCount || selection.isCollapsed) {
        hideFormatBar();
        return;
      }
      const nextRange = selection.getRangeAt(0);
      if (!findParagraphState(nextRange.commonAncestorContainer)) {
        hideFormatBar();
        return;
      }
      saveFormatRange(nextRange, selection);
      setLinkPanelOpen(false);
      positionFormatBar(savedFormatRange);
      syncFormatButtons();
      // queryCommandState can lag one frame behind the DOM mutation.
      pageScope.frame(() => {
        if (!savedFormatRange || formatBar.hidden) return;
        syncFormatButtons();
      });
    };

    const anchorsInRange = (range: Range): HTMLAnchorElement[] => {
      const root = range.commonAncestorContainer;
      const scope = root instanceof Element ? root : root.parentElement;
      if (!scope) return [];
      if (scope instanceof HTMLAnchorElement) return [scope];
      const closest = closestAnchor(range.startContainer);
      const found = [...scope.querySelectorAll('a')].filter((anchor) => range.intersectsNode(anchor));
      if (closest && !found.includes(closest)) found.unshift(closest);
      return found;
    };

    const markSelector = {
      emphasis: '.text-emphasis',
      subtle: '.text-subtle',
      bold: 'strong, b',
      italic: 'em, i',
      underline: 'u',
    } as const;

    const markCoversRange = (range: Range, mark: keyof typeof markSelector) => {
      const startElement = range.startContainer instanceof Element
        ? range.startContainer
        : range.startContainer.parentElement;
      const endElement = range.endContainer instanceof Element
        ? range.endContainer
        : range.endContainer.parentElement;
      const block = startElement?.closest<HTMLElement>('[data-dev-text-document]');
      if (!block || !endElement || !block.contains(endElement)) return false;
      const startMark = startElement.closest(markSelector[mark]);
      const endMark = endElement.closest(markSelector[mark]);
      if (startMark && startMark === endMark && block.contains(startMark)) return true;
      const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
      const selectedTextNodes: Text[] = [];
      let current = walker.nextNode();
      while (current) {
        const text = current as Text;
        if (text.data) {
          const textRange = document.createRange();
          textRange.selectNodeContents(text);
          const overlaps = range.compareBoundaryPoints(Range.START_TO_END, textRange) > 0
            && range.compareBoundaryPoints(Range.END_TO_START, textRange) < 0;
          if (overlaps) selectedTextNodes.push(text);
        }
        current = walker.nextNode();
      }
      return selectedTextNodes.length > 0 && selectedTextNodes.every((text) => {
        const match = text.parentElement?.closest(markSelector[mark]);
        return Boolean(match && block.contains(match));
      });
    };

    const syncEmphasisStyle = () => {
      if (!savedFormatRange) {
        emphasisStyleSelect.value = 'default';
        return;
      }
      emphasisStyleSelect.value = markCoversRange(savedFormatRange, 'subtle')
        ? 'subtle'
        : markCoversRange(savedFormatRange, 'emphasis')
          ? 'emphasis'
          : 'default';
    };

    const paragraphsInRange = (range: Range, state: EditableTextState): HTMLElement[] => {
      const paragraphs = [...state.element.querySelectorAll<HTMLElement>(':scope > p, :scope > div')];
      if (range.collapsed) {
        return paragraphs.filter((paragraph) => paragraph.contains(range.startContainer));
      }
      return paragraphs.filter((paragraph) => {
        const content = document.createRange();
        content.selectNodeContents(paragraph);
        let first: Node = paragraph;
        let last: Node = paragraph;
        while (first.firstChild) first = first.firstChild;
        while (last.lastChild) last = last.lastChild;
        content.setStart(first, 0);
        content.setEnd(last, last.nodeType === Node.TEXT_NODE ? last.textContent!.length : last.childNodes.length);
        return range.compareBoundaryPoints(Range.END_TO_START, content) < 0
          && range.compareBoundaryPoints(Range.START_TO_END, content) > 0;
      });
    };

    let syncingTextWrap = false;
    const syncTextWrap = () => {
      if (!savedFormatRange) return;
      const block = findParagraphState(savedFormatRange.commonAncestorContainer);
      if (!block) return;
      const paragraphs = paragraphsInRange(savedFormatRange, block);
      const values = paragraphs.map((paragraph) => paragraphTextWrap(
        paragraph, block.element.dataset.devTextLegacyBalance === 'true',
      ));
      const value = values.length && values.every((candidate) => candidate === values[0])
        ? values[0] : '';
      syncingTextWrap = true;
      wrapStyleSelect.value = value;
      wrapStyleSelect.dispatchEvent(new Event('change', { bubbles: true }));
      syncingTextWrap = false;
      wrapStyleSelect.dataset.emptyLabel = value ? '' : 'Mixed';
    };

    const applyTextWrap = (value: string) => {
      const normalized = normalizeTextWrap(value);
      if (!normalized || !savedFormatRange || !restoreFormatRange()) return;
      const block = findParagraphState(savedFormatRange.commonAncestorContainer);
      if (!block) return;
      const paragraphs = paragraphsInRange(savedFormatRange, block);
      if (!paragraphs.length) return;
      pageHistory.breakGroup();
      paragraphs.forEach((paragraph) => paragraph.setAttribute('data-text-wrap', normalized));
      updateActions();
      queueMicrotask(() => pageHistory.breakGroup());
      syncTextWrap();
      positionFormatBar(savedFormatRange);
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
    };

    type EmphasisTone = 'emphasis' | 'default' | 'subtle';
    type InlineMarks = {
      emphasis: boolean;
      subtle: boolean;
      bold: boolean;
      italic: boolean;
      underline: boolean;
      link: { href: string; underlineOff: boolean } | null;
    };
    type InlineAtom = {
      kind: 'text' | 'break';
      text: string;
      marks: InlineMarks;
      selected: boolean;
    };

    const applyEmphasisMark = (range: Range, tone: EmphasisTone) => {
      const startElement = range.startContainer instanceof Element
        ? range.startContainer
        : range.startContainer.parentElement;
      const endElement = range.endContainer instanceof Element
        ? range.endContainer
        : range.endContainer.parentElement;
      const paragraph = startElement?.closest<HTMLElement>('p, div');
      if (!paragraph || paragraph !== endElement?.closest('p, div')) return null;
      const paragraphWrap = explicitParagraphTextWrap(paragraph);

      const startBoundary = document.createElement('span');
      const endBoundary = document.createElement('span');
      startBoundary.hidden = true;
      endBoundary.hidden = true;
      const endRange = range.cloneRange();
      endRange.collapse(false);
      endRange.insertNode(endBoundary);
      const startRange = range.cloneRange();
      startRange.collapse(true);
      startRange.insertNode(startBoundary);

      const atoms: InlineAtom[] = [];
      let selected = false;
      const visit = (node: Node, inherited: InlineMarks) => {
        if (node === startBoundary) {
          selected = true;
          return;
        }
        if (node === endBoundary) {
          selected = false;
          return;
        }
        if (node instanceof Text) {
          if (node.data) atoms.push({ kind: 'text', text: node.data, marks: inherited, selected });
          return;
        }
        if (!(node instanceof HTMLElement)) return;
        const marks = { ...inherited };
        if (node.matches(markSelector.emphasis)) marks.emphasis = true;
        if (node.matches(markSelector.subtle)) marks.subtle = true;
        if (node.matches(markSelector.bold)) marks.bold = true;
        if (node.matches(markSelector.italic)) marks.italic = true;
        if (node.matches(markSelector.underline)) marks.underline = true;
        if (node instanceof HTMLAnchorElement) {
          marks.link = {
            href: node.getAttribute('href') || '',
            underlineOff: node.classList.contains('is-underline-off'),
          };
        }
        if (node instanceof HTMLBRElement) {
          atoms.push({ kind: 'break', text: '', marks, selected });
          return;
        }
        [...node.childNodes].forEach((child) => visit(child, marks));
      };
      const emptyMarks: InlineMarks = {
        emphasis: false,
        subtle: false,
        bold: false,
        italic: false,
        underline: false,
        link: null,
      };
      [...paragraph.childNodes].forEach((child) => visit(child, emptyMarks));
      const selectedAtoms = atoms.filter((atom) => atom.selected);
      if (!selectedAtoms.length) return null;
      selectedAtoms.forEach((atom) => {
        atom.marks = {
          ...atom.marks,
          emphasis: tone === 'emphasis',
          subtle: tone === 'subtle',
        };
      });

      const keyFor = (atom: InlineAtom) => JSON.stringify({
        selected: atom.selected,
        marks: atom.marks,
      });
      const groups: InlineAtom[][] = [];
      atoms.forEach((atom) => {
        const previous = groups.at(-1);
        if (previous && keyFor(previous[0]) === keyFor(atom)) previous.push(atom);
        else groups.push([atom]);
      });

      const wrap = (content: Node, tag: keyof HTMLElementTagNameMap, className = '') => {
        const element = document.createElement(tag);
        if (className) element.className = className;
        element.append(content);
        return element;
      };
      const renderGroup = (group: InlineAtom[]) => {
        const content = document.createDocumentFragment();
        group.forEach((atom) => {
          content.append(atom.kind === 'break' ? document.createElement('br') : atom.text);
        });
        const { marks } = group[0];
        let rendered: Node = content;
        if (marks.underline) rendered = wrap(rendered, 'u');
        if (marks.italic) rendered = wrap(rendered, 'em');
        if (marks.bold) rendered = wrap(rendered, 'strong');
        if (marks.emphasis) rendered = wrap(rendered, 'span', 'text-emphasis');
        if (marks.subtle) rendered = wrap(rendered, 'span', 'text-subtle');
        if (marks.link?.href) {
          const anchor = wrap(rendered, 'a', marks.link.underlineOff ? 'is-underline-off' : '');
          anchor.setAttribute('href', marks.link.href);
          rendered = anchor;
        }
        return rendered;
      };

      const fragment = document.createDocumentFragment();
      const restoredStart = document.createElement('span');
      const restoredEnd = document.createElement('span');
      restoredStart.hidden = true;
      restoredEnd.hidden = true;
      const firstSelectedGroup = groups.findIndex((group) => group[0].selected);
      const lastSelectedGroup = groups.findLastIndex((group) => group[0].selected);
      groups.forEach((group, index) => {
        if (index === firstSelectedGroup) fragment.append(restoredStart);
        fragment.append(renderGroup(group));
        if (index === lastSelectedGroup) fragment.append(restoredEnd);
      });
      paragraph.replaceChildren(fragment);
      if (paragraphWrap) paragraph.setAttribute('data-text-wrap', paragraphWrap);
      const restored = document.createRange();
      restored.setStartAfter(restoredStart);
      restored.setEndBefore(restoredEnd);
      restoredStart.remove();
      restoredEnd.remove();
      return restored;
    };

    const applyEmphasisStyle = (value: string) => {
      if (!restoreFormatRange() || !savedFormatRange || savedFormatRange.collapsed) return;
      const block = findParagraphState(savedFormatRange.commonAncestorContainer)?.element;
      if (!block) return;
      if (value !== 'emphasis' && value !== 'default' && value !== 'subtle') return;
      const range = applyEmphasisMark(savedFormatRange, value);
      if (!range) return;
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      captureFormatRange();
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
      refreshFormatBarAfterCommand();
      updateActions();
    };

    const runFormatCommand = (command: 'bold' | 'italic' | 'underline') => {
      if (!restoreFormatRange() || !savedFormatRange) return;
      if (command === 'underline') {
        const anchors = anchorsInRange(savedFormatRange);
        if (anchors.length) {
          const turnOff = anchors.some((anchor) => !anchor.classList.contains('is-underline-off'));
          anchors.forEach((anchor) => anchor.classList.toggle('is-underline-off', turnOff));
          refreshFormatBarAfterCommand();
          updateActions();
          return;
        }
      }
      document.execCommand(command);
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
      refreshFormatBarAfterCommand();
      updateActions();
    };

    const applyLink = (href: string) => {
      const normalized = normalizeHref(href);
      if (!normalized) {
        linkInput.setCustomValidity('Use a URL like google.com, https://…, /path, #hash, or mailto:');
        linkInput.reportValidity();
        return false;
      }
      linkInput.setCustomValidity('');
      if (!restoreFormatRange()) return false;
      document.execCommand('createLink', false, normalized);
      // Ensure serializer-safe href on the created anchor(s).
      const selection = window.getSelection();
      if (selection?.rangeCount) {
        const range = selection.getRangeAt(0);
        const root = range.commonAncestorContainer;
        const scope = root instanceof Element ? root : root.parentElement;
        scope?.querySelectorAll('a').forEach((anchor) => {
          if (range.intersectsNode(anchor)) {
            anchor.setAttribute('href', normalized);
          }
        });
        if (scope instanceof HTMLAnchorElement) {
          scope.setAttribute('href', normalized);
        }
      }
      captureFormatRange();
      setLinkPanelOpen(false);
      updateActions();
      scheduleFormatBarUpdate();
      return true;
    };

    const removeLink = () => {
      if (!restoreFormatRange()) return;
      document.execCommand('unlink');
      captureFormatRange();
      setLinkPanelOpen(false);
      updateActions();
      scheduleFormatBarUpdate();
    };

    formatBar.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-dev-format]')) event.preventDefault();
    }, { signal: editorSignal });
    formatBar.addEventListener('mousedown', (event) => {
      // Keep the contenteditable selection when clicking toolbar chrome.
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
      if (target instanceof Element && target.closest('[data-dev-text-field], .dev-text-format__block-style, .dev-text-format__emphasis-style, .dev-text-format__wrap-style, .dev-select__listbox, [data-editor-select-popup]')) {
        return;
      }
      event.preventDefault();
    }, { signal: editorSignal });

    blockStyleSelect.addEventListener('change', () => {
      if (syncingBlockStyle) return;
      convertCurrentBlock(blockStyleSelect.value);
    }, { signal: editorSignal });

    emphasisStyleSelect.addEventListener('change', () => {
      applyEmphasisStyle(emphasisStyleSelect.value);
    }, { signal: editorSignal });

    wrapStyleSelect.addEventListener('change', () => {
      if (syncingTextWrap) return;
      applyTextWrap(wrapStyleSelect.value);
    }, { signal: editorSignal });

    formatButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const command = button.dataset.devFormat;
        if (!command) return;
        if (!savedFormatRange) captureFormatRange();
        if (!savedFormatRange) return;

        if (command === 'bold' || command === 'italic' || command === 'underline') {
          setLinkPanelOpen(false);
          runFormatCommand(command);
          return;
        }

        if (command === 'link') {
          if (linkPanelOpen) {
            setLinkPanelOpen(false);
            restoreFormatRange();
            if (savedFormatRange) {
              positionFormatBar(savedFormatRange);
              syncFormatButtons();
            }
            return;
          }
          captureFormatRects(savedFormatRange);
          setLinkPanelOpen(true);
          positionFormatBar(savedFormatRange);
          syncFormatButtons();
        }
      }, { signal: editorSignal });
    });

    linkPanel.addEventListener('submit', (event) => {
      event.preventDefault();
      applyLink(linkInput.value);
    }, { signal: editorSignal });

    unlinkButton.addEventListener('click', (event) => {
      event.preventDefault();
      removeLink();
    }, { signal: editorSignal });

    linkInput.addEventListener('input', () => {
      linkInput.setCustomValidity('');
    }, { signal: editorSignal });

    linkInput.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      event.stopPropagation();
      hideFormatBar();
    }, { signal: editorSignal });

    document.addEventListener('selectionchange', () => {
      if (isFormatBarDismissing() || formatDismissPointer?.active) return;
      if (document.activeElement === linkInput) return;
      scheduleFormatBarUpdate(Boolean(window.getSelection()?.isCollapsed));
    }, { signal: editorSignal });
    document.addEventListener('input', () => scheduleFormatBarUpdate(true), { signal: editorSignal });
    document.addEventListener('focusin', () => scheduleFormatBarUpdate(true), { signal: editorSignal });
    window.addEventListener('scroll', (event) => {
      const target = event.target;
      if (target instanceof Node && isFormatBarTarget(target)) return;
      scheduleFormatBarUpdate();
    }, { capture: true, signal: editorSignal });
    let formatViewportWidth = window.visualViewport?.width ?? window.innerWidth;
    let formatKeyboardInset = 0;
    const onFormatViewportResize = () => {
      const viewport = window.visualViewport;
      const width = viewport?.width ?? window.innerWidth;
      const inset = Math.max(0, window.innerHeight - (viewport?.height ?? window.innerHeight) - (viewport?.offsetTop ?? 0));
      const reveal = Math.abs(inset - formatKeyboardInset) > 1 || Math.abs(width - formatViewportWidth) > 1;
      formatKeyboardInset = inset;
      formatViewportWidth = width;
      scheduleFormatBarUpdate(reveal && (!viewport || viewport.scale === 1));
    };
    window.addEventListener('resize', onFormatViewportResize, { signal: editorSignal });
    window.visualViewport?.addEventListener('resize', onFormatViewportResize, { signal: editorSignal });
    window.visualViewport?.addEventListener('scroll', () => scheduleFormatBarUpdate(), { signal: editorSignal });
    // Dismiss even while the link URL field is focused / open.
    document.addEventListener(
      'pointerdown',
      (event) => {
        if (formatBar.hidden || isFormatBarDismissing()) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        const targetEl = target instanceof Element ? target : target.parentElement;
        if (isFormatBarTarget(target) || targetEl?.closest('.dev-select__listbox')) return;
        const targetBlock = findBlockState(target);
        if (targetBlock) {
          if (linkPanelOpen) hideFormatBar(event.pointerId);
          return;
        }
        const active = document.activeElement;
        if (
          active instanceof HTMLElement
          && (findBlockState(active) || (active.isContentEditable && findBlockState(active)))
        ) {
          active.blur();
        }
        hideFormatBar();
      }, { capture: true, signal: editorSignal });
    const releaseFormatDismissPointer = (event: PointerEvent) => {
      const gesture = formatDismissPointer;
      if (!gesture || gesture.id !== event.pointerId) return;
      gesture.active = false;
      maybeScheduleFormatBarAfterDismiss(gesture.generation);
    };
    document.addEventListener('pointerup', releaseFormatDismissPointer, { capture: true, signal: editorSignal });
    document.addEventListener('pointercancel', releaseFormatDismissPointer, { capture: true, signal: editorSignal });

    /**
     * Esc while editing body text — same outcome as click-away:
     * 1) format / link bar dismisses first
     * 2) then the caret leaves the block (chrome unsuppresses)
     * Capture + stop so DevModeController does not exit Dev Mode on the same key.
     */
    const deselectDevTextCaret = () => {
      const active = document.activeElement;
      if (!(active instanceof HTMLElement)) return false;
      // Any editing surface, not just this component's tracked body-text fields:
      // a caret in a gallery card title or an inline caption is a level to
      // escape from too, and matching only textStates left those falling through
      // to DevModeController, which exited Dev Mode outright.
      const isEditingSurface = active.isContentEditable
        || isTextEntryField(active)
        || textStates.some((state) => state.element === active || state.element.contains(active));
      if (!isEditingSurface) return false;
      // Tuner / overlay fields keep their own Esc layering.
      if (active.closest('[data-dev-panel-key], .dev-overlay')) return false;

      window.getSelection()?.removeAllRanges();
      active.blur();
      document.querySelectorAll<HTMLElement>('.is-dev-section-controls-visible').forEach((el) => {
        if (!el.matches(':hover')) el.classList.remove('is-dev-section-controls-visible');
      });
      // focusout syncs on rAF; do it now so gap/drag chrome return without a frame of lag.
      syncSpacingCaretSuppression();
      return true;
    };

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return;
        if (!isDevContentEditing()) return;

        if (!formatBar.hidden) {
          event.preventDefault();
          event.stopPropagation();
          hideFormatBar();
          return;
        }

        if (
          spacingStates.some(({ control }) =>
            control.classList.contains('is-menu-open')
            || control.classList.contains('is-near-add')
            || control.classList.contains('is-near-spacing'),
          )
        ) {
          const openMenuState = spacingStates.find(({ control }) =>
            control.classList.contains('is-menu-open'));
          event.preventDefault();
          event.stopPropagation();
          closeSectionMenus();
          clearGapProximityAll();
          suppressGapProximity = true;
          openMenuState?.addButton.focus({ preventScroll: true });
          return;
        }

        if (!isDevTextCaretActive()) return;
        if (!deselectDevTextCaret()) return;
        event.preventDefault();
        event.stopPropagation();
      }, { capture: true, signal: editorSignal });

    // ⌘B / ⌘I / ⌘U / ⌘K (link)
    document.addEventListener('keydown', (event) => {
      if (!isDevContentEditing()) return;
      if (!(event.metaKey || event.ctrlKey) || event.altKey || event.shiftKey) return;

      const key = event.key.toLowerCase();
      const formatCommand =
        key === 'b' ? 'bold'
          : key === 'i' ? 'italic'
            : key === 'u' ? 'underline'
              : null;
      const isLink = key === 'k';
      if (!formatCommand && !isLink) return;

      const active = document.activeElement;
      if (
        active instanceof HTMLInputElement
        || active instanceof HTMLTextAreaElement
        || active instanceof HTMLSelectElement
      ) {
        return;
      }

      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      if (!findParagraphState(range.commonAncestorContainer)) return;

      if (formatCommand) {
        event.preventDefault();
        if (!savedFormatRange) captureFormatRange();
        runFormatCommand(formatCommand);
        return;
      }

      const anchor = closestAnchor(range.commonAncestorContainer);
      if (range.collapsed && !anchor) return;

      event.preventDefault();
      if (range.collapsed && anchor) {
        const linkRange = document.createRange();
        linkRange.selectNodeContents(anchor);
        selection.removeAllRanges();
        selection.addRange(linkRange);
        saveFormatRange(linkRange, selection);
      } else {
        saveFormatRange(range, selection);
      }

      if (linkPanelOpen) {
        setLinkPanelOpen(false);
        restoreFormatRange();
        if (savedFormatRange) {
          positionFormatBar(savedFormatRange);
          syncFormatButtons();
        }
        return;
      }

      captureFormatRects(savedFormatRange);
      setLinkPanelOpen(true);
      if (savedFormatRange) positionFormatBar(savedFormatRange);
      syncFormatButtons();
    }, { signal: editorSignal });

    const setEditingEnabled = (enabled: boolean) => {
      textStates.forEach(({ element, kind }) => {
        const editable = enabled && !element.hidden && canEditText(element);
        if (!editable && document.activeElement === element) element.blur();
        if (editable) {
          element.setAttribute('contenteditable', kind === 'paragraphs' ? 'true' : 'plaintext-only');
          element.setAttribute('spellcheck', 'true');
        } else {
          element.removeAttribute('contenteditable');
          element.removeAttribute('spellcheck');
        }
      });
      if (!enabled) closeSectionMenus();
      syncDeleteButtons(enabled);
      syncSpacingControlVisibility();
      if (!enabled) {
        cancelGapRevealIntent();
        latestGapPointer = null;
        spacingStates.forEach(({ control }) => clearGapProximity(control));
        document.documentElement.classList.remove('is-dev-text-caret');
        hideFormatBar();
      }
      syncSpacingCaretSuppression();
      updateActions();
    };

    phoneEditor.addEventListener('change', () => setEditingEnabled(isDevContentEditing()), { signal: editorSignal });
    window.addEventListener('resize', syncSpacingControlVisibility, { signal: editorSignal });

    textStates.forEach(bindTextState);
    captureFieldHistory();
    historyReady = true;
    window.addEventListener('vcd:dev-history-error', ((event: CustomEvent<{ message: string }>) => {
      setStickyStatus(event.detail.message);
      actions.hidden = false;
    }) as EventListener, { signal: editorSignal });

    revertButton.addEventListener('click', () => {
      if (branchUpdateBusy) return;
      void (async () => {
        const hadDirty = hasPendingEdits();
        const hadUnpublished = unpublishedCount > 0;

        // Unsaved edits are the nearer, smaller undo, so they take the whole
        // click: reverting them AND resetting the disk version would throw away
        // saved work nobody asked about. Only once nothing is left in memory
        // does Revert mean the on-disk unpublished content (#196).
        if (hadDirty) {
          suppressHistory = true;
          stickyStatus = '';
          revertPendingBlockConverts();
          revertPendingSectionInserts();
          revertPendingSectionDeletes();
          revertDirtyEdits();
          revertAllPending();
          try {
            await revertPersistedMediaInserts();
          } catch (error) {
            setStickyStatus(error instanceof Error ? error.message : 'Could not undo image inserts.');
            actions.hidden = false;
          }
          hideFormatBar();
          captureFieldHistory();
          suppressHistory = false;
          pageHistory.clear();
          updateActions();
          return;
        }

        if (hadUnpublished) {
          const n = unpublishedCount;
          const message = n === 1
            ? 'Discard 1 unpublished content file? This cannot be undone. The page will reload.'
            : `Discard ${n} unpublished content files? This cannot be undone. The page will reload.`;
          if (!window.confirm(message)) return;
        }

        stickyStatus = '';

        if (hadUnpublished) {
          try {
            const response = await fetch('/api/content-revert', { method: 'POST' });
            const payload = await readApiJson(response);
            if (!response.ok) {
              throw new Error(String(payload.error || 'Could not revert unpublished content.'));
            }
            window.location.reload();
            return;
          } catch (error) {
            setStickyStatus(error instanceof Error ? error.message : 'Could not revert unpublished content.');
            actions.hidden = false;
            void refreshPublishState();
            return;
          }
        }

        hideFormatBar();
        updateActions();
      })();
    }, { signal: editorSignal });

    /**
     * What was in this save, described semantically. The JSON diff is mostly
     * noise (a reordered section rewrites hundreds of lines); this is what the
     * publish route hands to the model that writes the commit subject.
     */
    type PublishManifest = {
      documents: string[];
      changes: Record<string, number>;
      textPaths: string[];
    };

    /**
     * Vite only registers `configureServer` middleware on process start. After a
     * branch pull, client HMR can call a new `/api/…` path the running server
     * never mounted — Astro then returns HTML and `response.json()` throws a
     * cryptic JSON.parse error. Surface a restart hint instead.
     */
    const readApiJson = async (response: Response): Promise<Record<string, unknown>> => {
      const text = await response.text();
      try {
        return (text ? JSON.parse(text) : {}) as Record<string, unknown>;
      } catch {
        throw new Error(
          `Dev API returned non-JSON (HTTP ${response.status}). `
          + 'Restart the dev session (`bun run dev:session:stop`, then `bun run dev:session`) and try again.',
        );
      }
    };

    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    const refreshBranchUpdateState = async () => {
      try {
        const response = await fetch('/api/dev-branch-update', { cache: 'no-store' });
        if (!response.ok) throw new Error('unavailable');
        const state = await readApiJson(response);
        branchUpdateAvailable = state.available === true;
      } catch {
        if (!branchUpdateBusy) branchUpdateAvailable = false;
      }
      syncBranchUpdateBar();
    };

    const waitForBranchUpdate = async (requestId: string) => {
      for (let attempt = 0; attempt < 240; attempt += 1) {
        await sleep(500);
        let update: { id?: string; state?: string; message?: string } | undefined;
        try {
          const response = await fetch('/api/dev-branch-update', { cache: 'no-store' });
          if (!response.ok) continue;
          const state = await readApiJson(response);
          update = state.update as typeof update;
        } catch {
          // Astro is expected to disappear while the sync service restarts it.
          continue;
        }
        if (update?.id !== requestId) continue;
        if (update.state === 'succeeded') return;
        if (update.state === 'failed') throw new Error(String(update.message || 'Update failed.'));
      }
      throw new Error('The update has not finished. Check the dev session before retrying.');
    };

    branchUpdateButton.addEventListener('click', () => {
      if (!branchUpdateAvailable || branchUpdateBusy || actionsBusy || pageHistory.busy) return;
      void (async () => {
        branchUpdateBusy = true;
        branchUpdateMessage = '';
        updateActions();
        sessionStorage.setItem(SCROLL_RESTORE_KEY, String(window.scrollY));

        try {
          const hadPending = hasPendingEdits();
          const draft = { dirty: false };
          window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: draft }));
          if (hadPending || draft.dirty) {
            const manifest = await performSave();
            const afterSave = { dirty: false };
            window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: afterSave }));
            if (!manifest || hasPendingEdits() || afterSave.dirty) {
              throw new Error(stickyStatus && stickyStatus !== 'Saved.' ? stickyStatus : 'Save did not complete; update cancelled.');
            }
          }
          actionsBusy = true;
          updateActions();
          window.dispatchEvent(new CustomEvent('vcd:dev-mode-request', { detail: { active: false } }));

          const response = await fetch('/api/dev-branch-update', { method: 'POST' });
          const payload = await readApiJson(response);
          if (!response.ok || payload.ok !== true) {
            throw new Error(String(payload.error || 'Could not request the update.'));
          }

          await waitForBranchUpdate(String(payload.requestId || ''));
          actionsBusy = false;
          window.location.reload();
        } catch (error) {
          branchUpdateBusy = false;
          actionsBusy = false;
          branchUpdateMessage = error instanceof Error ? error.message : 'Could not update.';
          sessionStorage.removeItem(SCROLL_RESTORE_KEY);
          void refreshPublishState();
          void refreshBranchUpdateState();
          window.dispatchEvent(new CustomEvent('vcd:dev-mode-request', { detail: { active: true } }));
          updateActions();
        }
      })();
    }, { signal: editorSignal });

    const performSave = async (): Promise<PublishManifest | null> => {
      if (actionsBusy || pageHistory.busy) return null;
      // Let open tuners finish their draft before collecting pending changes.
      if (!window.dispatchEvent(new Event('vcd:dev-before-save', { cancelable: true }))) return null;
      captureFieldHistory();
      pageHistory.breakGroup();

      const dirtyText = dirtyTextStates();
      const dirtySpacing = dirtySpacingStates();
      const dirtyIntroHeights = dirtyIntroHeightStates();
      const submittedText = new Map(dirtyText.map((state) => [state, structuredClone(readValue(state))]));
      const submittedSpacing = new Map(dirtySpacing.map((state) => [state, cloneSpacing(state.currentValue)]));
      const submittedHeights = new Map(dirtyIntroHeights.map((state) => [state, state.currentValue]));
      const pendingChanges = [...pendingMedia.values()];
      const acknowledge = (changes: PendingMediaChange[]) => {
        const ids: string[] = [];
        for (const change of changes) {
          if (pendingMedia.get(change.id) !== change) continue;
          pendingMedia.delete(change.id);
          ids.push(change.id);
        }
        if (ids.length) window.dispatchEvent(new CustomEvent('vcd:dev-pending-committed', { detail: { ids } }));
      };
      const structuralPending = pendingSectionInserts.length + pendingSectionDeletes.length
        + pendingBlockConverts.length;
      const submittedMediaInserts = [...persistedMediaInserts];
      const mediaInsertPending = submittedMediaInserts.length;
      const listingChanges = pendingChanges.filter((change) => change.kind === 'listing-order');
      const galleryMembershipChanges = pendingChanges.filter((change) => change.kind === 'gallery-membership');
      const projectSettingsChanges = pendingChanges.filter((change) => change.kind === 'project-settings');
      const sectionOrderChanges = pendingChanges.filter((change) => change.kind === 'section-order');
      const placeholderFills = pendingChanges.filter((change) => change.kind === 'placeholder-fill');
      const styleTokenChanges = pendingChanges.filter((change) => change.kind === 'style-token');
      const sectionNavChanges = pendingChanges.filter((change) => change.kind === 'section-nav');
      const mediaRemoveChanges = pendingChanges.filter((change) => change.kind === 'media-remove');
      const detailsChanges = pendingChanges.filter((change) => change.kind === 'project-details-rows');
      const removedImageChanges = pendingChanges.filter((change) =>
        (change.kind === 'crop' || change.kind === 'caption')
        && mediaRemoveChanges.some((removal) => editsRemovedMedia(change.payload, removal.payload)));
      const imageChanges = pendingChanges.filter(
        (change) => (
          !removedImageChanges.includes(change)
          && change.kind !== 'listing-order'
          && change.kind !== 'gallery-membership'
          && change.kind !== 'section-order'
          && change.kind !== 'placeholder-fill'
          && change.kind !== 'style-token'
          && change.kind !== 'section-nav'
          && change.kind !== 'media-remove'
          && change.kind !== 'project-settings'
          && change.kind !== 'project-details-rows'
          && change.kind !== 'annotation'
        ),
      );
      if (
        !dirtyText.length
        && !dirtySpacing.length
        && !dirtyIntroHeights.length
        && !pendingChanges.length
        && !structuralPending
        && !mediaInsertPending
      ) return null;

      const documents = new Set<string>();
      dirtyText.forEach((state) => documents.add(state.document));
      dirtySpacing.forEach((state) => documents.add(state.document));
      dirtyIntroHeights.forEach((state) => documents.add(state.document));
      pendingBlockConverts.forEach((entry) => documents.add(entry.documentKey));
      pendingChanges.forEach((change) => {
        const payload = change.payload as {
          document?: unknown;
          slug?: unknown;
          slugs?: unknown;
        } | undefined;
        const key = payload?.document ?? payload?.slug;
        if (typeof key === 'string' && key) documents.add(key);
        if (Array.isArray(payload?.slugs)) {
          for (const slug of payload.slugs) {
            if (typeof slug === 'string' && slug) documents.add(slug);
          }
        }
      });
      const manifest: PublishManifest = {
        documents: [...documents],
        changes: {
          text: dirtyText.length,
          spacing: dirtySpacing.length,
          layout: dirtyIntroHeights.length,
          crop: imageChanges.filter((change) => change.kind === 'crop').length,
          grid: imageChanges.filter((change) => change.kind === 'grid').length,
          carousel: imageChanges.filter((change) => change.kind === 'carousel').length,
          caption: imageChanges.filter((change) => change.kind === 'caption').length,
          mediaInsert: mediaInsertPending + placeholderFills.length,
          sectionInsert: pendingSectionInserts.length,
          sectionDelete: pendingSectionDeletes.length,
          sectionOrder: sectionOrderChanges.length,
          listingOrder: listingChanges.length,
          galleryMembership: galleryMembershipChanges.length,
          projectSettings: projectSettingsChanges.length,
          styleToken: styleTokenChanges.length,
          sectionNav: sectionNavChanges.length,
          mediaRemove: mediaRemoveChanges.length,
          projectDetailsRows: detailsChanges.length,
          annotation: pendingChanges.filter((change) => change.kind === 'annotation').length,
        },
        textPaths: dirtyText.slice(0, 8).map((state) => state.path.join('.')),
      };

      saveButton.disabled = true;
      publishButton.disabled = true;
      revertButton.disabled = true;
      actionsBusy = true;
      const wasInert = document.body.inert;
      document.body.inert = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-save-state', { detail: { saving: true } }));
      saveButton.classList.add('is-dev-actions-busy');
      publishButton.classList.add('is-dev-actions-busy');
      revertButton.classList.add('is-dev-actions-busy');
      setStickyStatus('Saving…');

      try {
        // Structural mutations first: client paths are already reindexed, so
        // JSON must match before text/layout writes (otherwise Save hits
        // "editable text field no longer exists" after deleting a section).
        const insertedSections = await persistPendingSectionInserts();
        insertedSections.forEach(({ clientId, serverId }) => {
          remapDevSectionOutlineId(clientId, serverId);
        });
        await persistPendingSectionDeletes();
        await persistPendingBlockConverts();
        if (placeholderFills.length) {
          await persistPlaceholderFills();
        }
        // Also structural: dropping an item shortens the media array the grid and
        // carousel payloads below index into, so it has to land before them.
        for (const change of mediaRemoveChanges) {
          if (persistedChanges.has(change)) continue;
          const response = await fetch('/api/content-section', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not remove that image.'));
          persistedChanges.add(change);
          acknowledge([change, ...removedImageChanges.filter((edit) => editsRemovedMedia(edit.payload, change.payload))]);
        }
        // Membership before order — listing-order skips slugs that lack listings[grid].
        for (const change of galleryMembershipChanges) {
          const response = await fetch('/api/gallery-membership', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save gallery pages.');
          acknowledge([change]);
        }

        for (const change of listingChanges) {
          const response = await fetch('/api/listing-order', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save grid order.');
          acknowledge([change]);
        }

        for (const change of projectSettingsChanges) {
          const settingsPayload = { ...(change.payload as Record<string, unknown>) };
          const currentSlug = String(settingsPayload.slug || '').trim();
          const nextSlug = String(settingsPayload.newSlug || '').trim();
          if (nextSlug && nextSlug !== currentSlug) {
            const renameResponse = await fetch('/api/project-rename', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ slug: currentSlug, newSlug: nextSlug }),
            });
            const renamePayload = await readApiJson(renameResponse);
            if (!renameResponse.ok) {
              throw new Error(String(renamePayload.error || 'Could not rename the project.'));
            }
            settingsPayload.slug = nextSlug;
            delete settingsPayload.newSlug;
            change.payload.slug = nextSlug;
            delete change.payload.newSlug;
          }
          const response = await fetch('/api/project-settings', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(settingsPayload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) {
            throw new Error(String(payload.error || 'Could not save project settings.'));
          }
          acknowledge([change]);
        }

        for (const change of sectionNavChanges) {
          const payload = change.prepare?.() ?? change.payload;
          payload.outline = structuredClone(getDevSectionOutline());
          const documentIds = serverSectionIds.get(String(payload.document || ''));
          if (documentIds && payload.sectionIds && typeof payload.sectionIds === 'object') {
            for (const [index, rawId] of Object.entries(payload.sectionIds as Record<string, unknown>)) {
              if (typeof rawId !== 'string') continue;
              const serverId = documentIds.get(rawId);
              if (serverId) (payload.sectionIds as Record<string, unknown>)[index] = serverId;
            }
          }
          const response = await fetch('/api/content-nav', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const responsePayload = await readApiJson(response);
          if (!response.ok) throw new Error(String(responsePayload.error || 'Could not save the section outline.'));
          if (!Array.isArray(responsePayload.outline)) throw new Error('The saved outline could not be confirmed. Refresh before editing again.');
          setDevSectionOutline(normalizeOutline(responsePayload.outline));
          syncDevSectionOutlineSidebar();
          acknowledge([change]);
        }

        for (const change of styleTokenChanges) {
          const response = await fetch('/api/style-token', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not save the colour token.'));
        }

        if (styleTokenChanges.length) {
          const response = await fetch('/api/style-token-commit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              tokens: styleTokenChanges
                .map((change) => (change.payload as { token?: unknown } | undefined)?.token)
                .filter((token): token is string => typeof token === 'string' && token.length > 0),
            }),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not commit style changes.'));
          acknowledge(styleTokenChanges);
        }

        for (const change of detailsChanges) {
          await persistDetailsRows(change);
          acknowledge([change]);
        }

        for (const change of pendingChanges.filter((item) => item.kind === 'annotation')) {
          const targetExists = [...document.querySelectorAll<HTMLElement>('[data-site-annotation-section-id]')]
            .some((section) => section.dataset.siteAnnotationSectionId === change.payload.sectionId
              && section.dataset.siteAnnotationDocument === change.payload.document);
          if (!targetExists) {
            acknowledge([change]);
            continue;
          }
          const response = await fetch('/api/content-annotations', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.prepare?.() ?? change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not save the drawings.'));
          window.dispatchEvent(new CustomEvent('vcd:site-annotations-saved', {
            detail: { document: change.payload.document, sectionId: change.payload.sectionId },
          }));
          acknowledge([change]);
        }

        if (imageChanges.length > 0) {
          const response = await fetch('/api/content-batch', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              crops: imageChanges
                .filter((change) => change.kind === 'crop')
                .map((change) => change.payload),
              grids: imageChanges
                .filter((change) => change.kind === 'grid')
                .map((change) => change.payload),
              carousels: imageChanges
                .filter((change) => change.kind === 'carousel')
                .map((change) => change.payload),
              captions: imageChanges
                .filter((change) => change.kind === 'caption')
                .map((change) => change.payload),
              text: dirtyText.map((state) => withDevEditTarget({
                document: state.document,
                path: state.path,
                value: submittedText.get(state),
              }, state.element)),
              spacing: dirtySpacing.map((state) => withDevEditTarget({
                document: state.document,
                path: state.writePath,
                value: submittedSpacing.get(state),
              }, state.element)).concat(dirtyIntroHeights.map((state) => withDevEditTarget({
                document: state.document,
                path: state.path,
                value: submittedHeights.get(state),
              }, state.element))),
            }),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save changes.');
          acknowledge(imageChanges);
        } else {
          if (dirtyText.length) {
            const response = await fetch('/api/content-text', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                changes: dirtyText.map((state) => withDevEditTarget({
                  document: state.document,
                  path: state.path,
                  value: submittedText.get(state),
                }, state.element)),
              }),
            });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error || 'Could not save the text.');
            dirtyText.forEach((state) => { state.savedValue = structuredClone(submittedText.get(state)!); });
          }

          const dirtyLayout = [
            ...dirtySpacing.map((state) => withDevEditTarget({
              document: state.document,
              path: state.writePath,
              value: submittedSpacing.get(state),
            }, state.element)),
            ...dirtyIntroHeights.map((state) => withDevEditTarget({
              document: state.document,
              path: state.path,
              value: submittedHeights.get(state),
            }, state.element)),
          ];
          if (dirtyLayout.length) {
            const response = await fetch('/api/content-spacing', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                changes: dirtyLayout,
              }),
            });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error || 'Could not save the layout.');
          }
        }

        dirtyText.forEach((state) => {
          state.savedValue = structuredClone(submittedText.get(state)!);
        });
        dirtySpacing.forEach((state) => {
          state.savedValue = cloneSpacing(submittedSpacing.get(state) ?? state.currentValue);
          state.visualSavedValue = cloneSpacing(state.savedValue);
          syncSpacingControl(state);
        });
        dirtyIntroHeights.forEach((state) => syncIntroHeightDocument(
          state.document,
          state.currentValue,
          submittedHeights.get(state),
        ));
        for (const change of sectionOrderChanges) {
          const reorderedDocument = String(change.payload.document || '');
          if (reorderedDocument !== 'home-intro') {
            change.payload.outline = structuredClone(getDevSectionOutline());
          }
          let order = Array.isArray(change.payload.order)
            ? change.payload.order.map((value) => Number(value))
            : [];
          const identifiedRoots = getSectionRootsInDomOrder(getDropZone(reorderedDocument))
            .filter((root) => root.dataset.devContentId);
          if (identifiedRoots.length) {
            if (identifiedRoots.length !== order.length) throw new Error('A section identity is missing from the new order.');
            change.payload.orderIds = identifiedRoots.map((root) => root.dataset.devContentId);
            order = identifiedRoots.map((root) => sectionIndexFromRoot(root)!);
            change.payload.order = order;
          }
          const response = await fetch('/api/content-section-order', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save section order.');
          const indexMap = buildIndexMapFromOrder(order);
          remapSectionPaths(indexMap, reorderedDocument);
          remapPathsInStates(indexMap, reorderedDocument);
          resetSectionOrderIds(getDropZone(reorderedDocument));
          spacingStates.forEach((state) => {
            if (state.document !== reorderedDocument) return;
            state.savedValue = cloneSpacing(submittedSpacing.get(state) ?? state.currentValue);
            state.visualSavedValue = cloneSpacing(state.savedValue);
            syncSpacingControl(state);
          });
          acknowledge([change]);
        }
        syncPageTopSpacingControls();

        acknowledge(pendingChanges);
        for (const entry of submittedMediaInserts) {
          const index = persistedMediaInserts.indexOf(entry);
          if (index >= 0) persistedMediaInserts.splice(index, 1);
        }
        // Optimistic: keep the bar up until refreshPublishState confirms counts.
        // Without this, dirtyCount is 0 and unpublishedCount is still stale, so
        // the bar flickers hidden between Save and the /api/publish GET.
        if (manifest.documents.length) {
          unpublishedCount = Math.max(unpublishedCount, manifest.documents.length);
        }
        if (styleTokenChanges.length) {
          styleEngineDirtyCount = Math.max(styleEngineDirtyCount, 1);
        }
        setStickyStatus('Saved.');
        return manifest;
      } catch (error) {
        setStickyStatus(error instanceof Error ? error.message : 'Could not save changes.');
        return null;
      } finally {
        actionsBusy = false;
        document.body.inert = wasInert;
        window.dispatchEvent(new CustomEvent('vcd:dev-save-state', { detail: { saving: false } }));
        publishButton.disabled = false;
        updateActions();
      }
    };

    saveButton.addEventListener('click', () => {
      if (branchUpdateBusy) return;
      void (async () => {
        // A successful Save turns unsaved edits into unpublished ones, so the
        // bar has to stay up — refresh the count rather than letting it hide.
        if (await performSave()) {
          void refreshPublishState();
          void refreshStyleEngineState();
        }
      })();
    }, { signal: editorSignal });

    // ⌥S Save / ⌥⇧S Save & Publish — work while editing (unlike other Alt chords).
    document.addEventListener('keydown', (event) => {
      if (!document.documentElement.classList.contains('is-dev-mode')) return;
      if (!(event.altKey && !event.ctrlKey && !event.metaKey && event.code === 'KeyS')) return;
      event.preventDefault();
      if (event.shiftKey) {
        if (publishButton.hidden || publishButton.disabled || actionsBusy) return;
        publishButton.click();
        return;
      }
      if (saveButton.disabled || actionsBusy) return;
      saveButton.click();
    }, { signal: editorSignal });

    const refreshStyleEngineState = async () => {
      try {
        // Prefer /api/commit-engine — mounted since the first #109 server start.
        // /api/publish-styles is an alias added later; calling it after client HMR
        // without a restart 404s as HTML.
        const response = await fetch('/api/commit-engine');
        if (!response.ok) throw new Error('unavailable');
        const state = await readApiJson(response) as { files?: string[]; dirty?: boolean; readOnly?: boolean };
        publishReadOnly = Boolean(state.readOnly);
        styleEngineDirtyCount = state.readOnly
          ? 0
          : (Array.isArray(state.files) ? state.files.length : (state.dirty ? 1 : 0));
      } catch {
        // Leave the last known count — a blip shouldn't hide Publish styles.
      }
      // Hand "Saved." back to the count once we know style/engine state.
      if (stickyStatus === 'Saved.') stickyStatus = '';
      updateActions();
    };

    commitStylesButton.addEventListener('click', () => {
      if (branchUpdateBusy || publishReadOnly) return;
      void (async () => {
        actionsBusy = true;
        commitStylesButton.disabled = true;
        saveButton.disabled = true;
        publishButton.disabled = true;
        revertButton.disabled = true;
        commitStylesButton.classList.add('is-dev-actions-busy');
        setStickyStatus('Publishing styles…');
        try {
          const response = await fetch('/api/commit-engine', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              message: 'styles: update colour tokens',
            }),
          });
          const payload = await readApiJson(response);
          if (!response.ok || !payload.ok) {
            throw new Error(String(payload.error || 'Could not publish styles.'));
          }
          // Old middleware (pre-restart) only committed on the branch and had no
          // `pushed` field — don't claim the colours are on main.
          if (payload.pushed === undefined) {
            styleEngineDirtyCount = 0;
            setStickyStatus(
              'Styles committed on this branch only. Restart the dev session to publish colour tokens to main.',
            );
            return;
          }
          styleEngineDirtyCount = 0;
          setStickyStatus(payload.pushed
            ? (payload.message ? `Published styles — ${payload.message}` : 'Styles published.')
            : `Committed locally, push failed: ${payload.error}`);
        } catch (error) {
          setStickyStatus(error instanceof Error ? error.message : 'Could not publish styles.');
        } finally {
          actionsBusy = false;
          void refreshStyleEngineState();
        }
      })();
    }, { signal: editorSignal });

    /** Rendering files on this branch, for the override confirm. Empty when safe. */
    let renderingFiles: string[] = [];

    /**
     * Save to disk, then commit the content surface to main and push. Content
     * always lands on main, but you no longer have to be standing there — from a
     * feature branch the commit is built against main and pushed, leaving this
     * checkout untouched.
     *
     * What gates Publish now is whether this branch changes content-*rendering*
     * code. If it does, the edit may depend on a feature main cannot render yet,
     * so the bar warns and Publish asks for confirmation first.
     */
    const refreshPublishState = async () => {
      try {
        const response = await fetch('/api/publish');
        if (!response.ok) throw new Error('unavailable');
        const state = await response.json() as {
          branch?: string;
          canPublish?: boolean;
          onPublishBranch?: boolean;
          rendersContent?: boolean;
          renderingFiles?: string[];
          publishBranch?: string;
          files?: string[];
          behind?: string[];
          readOnly?: boolean;
        };
        publishKnown = true;
        publishReadOnly = Boolean(state.readOnly);
        unpublishedCount = Array.isArray(state.files) ? state.files.length : 0;
        const behind = Array.isArray(state.behind) ? state.behind : [];
        renderingFiles = Array.isArray(state.renderingFiles) ? state.renderingFiles : [];
        const branch = state.branch || 'detached HEAD';
        const target = state.publishBranch ?? 'main';
        const onTarget = state.onPublishBranch !== false;
        publishButton.hidden = publishReadOnly;
        if (!actionsBusy && !branchUpdateBusy) publishButton.disabled = false;
        branchLabel.hidden = false;
        branchLabel.textContent = branch;
        // Away from main the name steps up to full text colour — publishing still
        // works from here, but where "here" is stops being ambient information.
        branchLabel.classList.toggle('is-dev-branch-off-target', !onTarget);
        // Being behind is not something to publish — it is content someone moved
        // on main that this branch has not picked up. Say so, rather than leaving
        // the difference to be misread as an edit waiting to go out.
        const behindNote = behind.length
          ? `\n${behind.length} file${behind.length === 1 ? '' : 's'} newer on ${target} `
            + `(${behind.slice(0, 3).join(', ')}) — merge or rebase to pick ${behind.length === 1 ? 'it' : 'them'} up.`
          : '';
        branchLabel.title = publishReadOnly
          ? branch
          : ((onTarget
            ? `On ${branch} — content publishes from here`
            : `On ${branch} — content publishes to ${target} without switching`) + behindNote);

        warnLabel.hidden = publishReadOnly || !state.rendersContent;
        publishButton.classList.toggle('is-dev-publish-warn', Boolean(state.rendersContent));
        if (state.rendersContent) {
          const summary = renderingFiles.slice(0, 3).join(', ')
            + (renderingFiles.length > 3 ? `, +${renderingFiles.length - 3} more` : '');
          const warning = `This branch changes how content renders (${summary}). `
            + `If this edit uses those changes, ${target} cannot render it yet.`;
          warnLabel.title = warning;
          publishButton.title = `${warning} Publish will ask you to confirm.`;
        } else {
          publishButton.title = onTarget
            ? `Save, commit, and push to ${target}`
            : `Save, commit, and push to ${target} — ${branch} stays as it is`;
        }
      } catch {
        // First failure (or never-a-git-repo): hide publish chrome. Once we've
        // successfully loaded publish state, keep the last counts so a blip
        // doesn't empty the bar the same way.
        if (!publishKnown) {
          unpublishedCount = 0;
          renderingFiles = [];
          publishButton.hidden = true;
          branchLabel.hidden = true;
          warnLabel.hidden = true;
        }
      }
      // "Saved." was only a beat confirmation — once we know the unpublished
      // count, hand the status back to the count. Leave Publish confirmations alone.
      if (stickyStatus === 'Saved.') stickyStatus = '';
      updateActions();
    };

    publishButton.addEventListener('click', () => {
      if (publishReadOnly) return;
      if (branchUpdateBusy) return;
      void (async () => {
        const hadUnsavedEdits = hasPendingEdits();
        const manifest = await performSave();
        // A null manifest means either nothing was dirty — the normal case for
        // content already on disk — or the save failed. Only the second should
        // stop us; performSave has already put its error in the status.
        if (hadUnsavedEdits && !manifest) return;
        if (!manifest && !unpublishedCount) return;

        saveButton.disabled = true;
        publishButton.disabled = true;
        revertButton.disabled = true;
        actionsBusy = true;
        saveButton.classList.add('is-dev-actions-busy');
        publishButton.classList.add('is-dev-actions-busy');
        revertButton.classList.add('is-dev-actions-busy');
        setStickyStatus('Publishing…');
        actions.hidden = false;

        const post = async (force: boolean) => {
          const response = await fetch('/api/publish', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ manifest, force }),
          });
          return await response.json();
        };

        try {
          let payload = await post(false);

          // The rendering-code check is branch-level on purpose, so it is coarse:
          // it knows the branch touches rendering, not whether this edit uses it.
          // Anto does, so ask him rather than making the call for him.
          if (payload.needsOverride) {
            const files: string[] = Array.isArray(payload.renderingFiles) ? payload.renderingFiles : renderingFiles;
            const confirmed = window.confirm(
              `This branch changes how content renders:\n\n${files.join('\n')}\n\n`
              + 'If this edit does not use those changes, it is safe to publish. Publish anyway?',
            );
            if (!confirmed) {
              setStickyStatus('Publish cancelled.');
              return;
            }
            payload = await post(true);
          }

          if (!payload.ok) {
            throw new Error(payload.error || 'Could not publish.');
          }
          setStickyStatus(payload.pushed
            ? `Published — ${payload.message}`
            : `Committed locally, push failed: ${payload.error}`);
          actions.hidden = false;
        } catch (error) {
          setStickyStatus(error instanceof Error ? error.message : 'Could not publish.');
          actions.hidden = false;
        } finally {
          actionsBusy = false;
          void refreshPublishState();
        }
      })();
    }, { signal: editorSignal });

    void refreshPublishState();
    window.addEventListener('vcd:dev-tab-stale', ((event: CustomEvent) => {
      event.detail.recover = async () => {
        if (actionsBusy || pageHistory.busy || branchUpdateBusy) return;
        const draft = { dirty: false };
        window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: draft }));
        // Keep drafts, Save state, and undo history intact until the user saves or discards.
        if (hasPendingEdits() || draft.dirty) return;
        sessionStorage.setItem(SCROLL_RESTORE_KEY, String(window.scrollY));
        window.location.reload();
      };
    }) as EventListener, { signal: editorSignal });

    void refreshStyleEngineState();
    void refreshBranchUpdateState();
    branchUpdatePollTimer = setInterval(() => {
      void refreshBranchUpdateState();
    }, 15_000);

    /**
     * For writers that legitimately go straight to disk — an asset deleted
     * forever, a cover image uploaded — there is nothing to stage and nothing to
     * revert, but the content surface has still moved. Without this the count
     * only refreshes on load and on dev-mode entry, so the bar can sit hidden
     * while unpublished content waits on disk.
     */
    window.addEventListener('vcd:dev-content-written', () => {
      void refreshPublishState();
    }, { signal: editorSignal });

    window.addEventListener('vcd:dev-mode-change', (event) => {
      const active = Boolean((event as CustomEvent<{ active: boolean }>).detail?.active);
      setEditingEnabled(active && isDevContentEditing());
      if (active) {
        void refreshPublishState();
        void refreshStyleEngineState();
        void refreshBranchUpdateState();
      }
    }, { signal: editorSignal });
    window.addEventListener('vcd:section-nav-editor-change', () => {
      setEditingEnabled(isDevContentEditing());
    }, { signal: editorSignal });
    pageScope.listen(document, 'astro:before-preparation', (event) => {
      const draft = { dirty: false };
      window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: draft }));
      const hasContentEdits = actionsBusy || pageHistory.busy || draft.dirty
        || unsavedChangeCount() > persistedMediaInserts.length;
      // Astro falls back to a document navigation when preparation is prevented,
      // so the existing beforeunload guard provides the browser's Leave / Stay prompt.
      if (hasContentEdits) event.preventDefault();
    });

    window.addEventListener('beforeunload', (event) => {
      const draft = { dirty: false };
      window.dispatchEvent(new CustomEvent('vcd:dev-has-draft', { detail: draft }));
      const hasContentEdits = actionsBusy || pageHistory.busy || draft.dirty
        || unsavedChangeCount() > persistedMediaInserts.length;
      if (!hasContentEdits) return;
      event.preventDefault();
      event.returnValue = '';
    }, { signal: editorSignal });

    setEditingEnabled(isDevContentEditing());
  };

  initDevTextEditor();
  return () => {
    pageScope.destroy();
    editorAbortController?.abort();
    editorAbortController = null;
    if (branchUpdatePollTimer) clearInterval(branchUpdatePollTimer);
    branchUpdatePollTimer = null;
    disposeDevSectionOutlineSync();
    pageHistory.clear();
    delete document.documentElement.dataset.devTextEditorInit;
  };
  });
  import.meta.hot?.dispose(disposePage);
</script>

<style is:global>
  /*
