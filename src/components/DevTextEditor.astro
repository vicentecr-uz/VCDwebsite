---
import triangleAlertIcon from 'lucide-static/icons/triangle-alert.svg?raw';
import boldIcon from 'lucide-static/icons/bold.svg?raw';
import italicIcon from 'lucide-static/icons/italic.svg?raw';
import underlineIcon from 'lucide-static/icons/underline.svg?raw';
import linkIcon from 'lucide-static/icons/link.svg?raw';
import { sizeIcon } from '../lib/icons';

const publishWarnSvg = sizeIcon(triangleAlertIcon, 16);
const formatBoldSvg = sizeIcon(boldIcon, 16);
const formatItalicSvg = sizeIcon(italicIcon, 16);
const formatUnderlineSvg = sizeIcon(underlineIcon, 16);
const formatLinkSvg = sizeIcon(linkIcon, 16);
---

<div class="dev-text-actions" data-dev-text-actions hidden>
  <div class="dev-text-actions__surface">
    <span class="dev-text-actions__warn" data-dev-text-warn hidden set:html={publishWarnSvg} />
    <span class="dev-text-actions__status" data-dev-text-status aria-live="polite"></span>
    <span class="dev-text-actions__branch" data-dev-text-branch hidden></span>
    <button type="button" data-dev-text-revert>Revert changes</button>
    <button type="button" data-dev-text-save>Save</button>
    <button type="button" data-dev-text-commit-styles hidden>Publish styles</button>
    <button type="button" class="dev-text-actions__save" data-dev-text-publish>Save &amp; Publish</button>
  </div>
</div>

<div class="dev-text-format" data-dev-text-format hidden>
  <div class="dev-text-format__surface">
    <div class="dev-text-format__buttons">
      <button type="button" data-dev-format="bold" title="Bold (⌘B)" aria-label="Bold" aria-pressed="false">
        <span class="dev-text-format__icon" aria-hidden="true" set:html={formatBoldSvg} />
      </button>
      <button type="button" data-dev-format="italic" title="Italic (⌘I)" aria-label="Italic" aria-pressed="false">
        <span class="dev-text-format__icon" aria-hidden="true" set:html={formatItalicSvg} />
      </button>
      <button type="button" data-dev-format="underline" title="Underline (⌘U)" aria-label="Underline" aria-pressed="false">
        <span class="dev-text-format__icon" aria-hidden="true" set:html={formatUnderlineSvg} />
      </button>
      <button type="button" data-dev-format="link" title="Link (⌘K)" aria-label="Link" aria-pressed="false">
        <span class="dev-text-format__icon" aria-hidden="true" set:html={formatLinkSvg} />
      </button>
    </div>
    <form class="dev-text-format__link" data-dev-text-link-panel hidden>
      <button type="button" data-dev-text-unlink>Unlink</button>
      <input
        type="url"
        data-dev-text-link-input
        placeholder="https://…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Link URL"
      />
      <button type="submit">Apply</button>
    </form>
  </div>
</div>

<script>
  import {
    initMountedSectionCovers,
    mountInsertedSection,
    syncDevModeOnSection,
  } from '../scripts/devSectionMount';
  import {
    initDevSectionOutlineSync,
    remapDevSectionOutlineId,
  } from '../scripts/devSectionOutlineSync';
  import {
    buildIndexMapFromOrder,
    remapSectionPaths,
    resetSectionOrderIds,
    shiftSectionOrderIds,
  } from '../scripts/devSectionPaths';
  import trashIcon from 'lucide-static/icons/trash-2.svg?raw';
  import plusIcon from 'lucide-static/icons/plus.svg?raw';
  import { sizeIcon } from '../lib/icons';
  type EditableTextValue = string | string[];
  type SpacingValue = 'related' | 'group' | 'section' | 'major' | 'none';

  interface EditableTextState {
    element: HTMLElement;
    document: string;
    path: Array<string | number>;
    kind: 'text' | 'paragraphs';
    savedValue: EditableTextValue;
  }

  interface EditableSpacingState {
    element: HTMLElement;
    control: HTMLElement;
    addButton: HTMLButtonElement;
    spacingGroup: HTMLElement;
    menu: HTMLElement;
    document: string;
    path: Array<string | number>;
    savedValue: SpacingValue;
    currentValue: SpacingValue;
  }

  type InsertableSectionType = 'bodyText' | 'sectionTitle' | 'image' | 'imageCarousel';

  type SpacingOption = { value: SpacingValue; label: string; title: string };

  const SPACING_OPTIONS: SpacingOption[] = [
    { value: 'related', label: 'unit', title: 'Related · --space-unit' },
    { value: 'group', label: '4em', title: 'Group · 4em' },
    { value: 'section', label: '8em', title: 'Section · 8em' },
    { value: 'major', label: '12em', title: 'Major · 12em' },
  ];

  /** Only the page-top gap control offers 0. */
  const PAGE_TOP_NONE_OPTION: SpacingOption = {
    value: 'none',
    label: '0',
    title: 'None · 0',
  };

  const STACK_CLASS: Record<SpacingValue, string | null> = {
    related: 'project-stack--related',
    group: 'project-stack--group',
    section: 'project-stack--section',
    major: 'project-stack--major',
    none: 'project-stack--none',
  };

  const spacingOptionsFor = (pageTop: boolean): SpacingOption[] =>
    pageTop ? [PAGE_TOP_NONE_OPTION, ...SPACING_OPTIONS] : SPACING_OPTIONS;

  const spacingButtonsHtml = (pageTop: boolean) =>
    spacingOptionsFor(pageTop)
      .map(
        (option) => `
          <button
            type="button"
            class="dev-spacing-control__btn"
            data-dev-spacing-option="${option.value}"
            title="${option.title}"
            aria-label="${option.title}"
          >
            <span class="dev-spacing-control__mark dev-spacing-control__mark--${option.value}" aria-hidden="true"></span>
            <span class="dev-spacing-control__label">${option.label}</span>
          </button>
        `,
      )
      .join('');

  const isSpacingStackParent = (el: HTMLElement | null): el is HTMLElement =>
    Boolean(
      el && (
        el.hasAttribute('data-dev-project-drop-zone') ||
        el.classList.contains('project-page__main')
      ),
    );

  const isPageTopSpacingBlock = (element: HTMLElement) => {
    const parent = element.parentElement;
    if (!isSpacingStackParent(parent)) return false;
    const siblings = [...parent.children].filter(
      (child): child is HTMLElement =>
        child instanceof HTMLElement && child.hasAttribute('data-dev-spacing-document'),
    );
    return siblings[0] === element;
  };

  /** Cursor must be within this distance of the control centre to reveal it. */
  const SPACING_ACTIVATION_RADIUS_PX = 96;

  /**
   * Match project.css / SectionSidebarNav: in-page section titles with
   * `.project-section-title--hide-when-sidebar` drop their heading when the
   * gutter nav is shown. The empty title wrapper still owns the section gap,
   * so the next block's gap control is a duplicate that loses to margin-collapse
   * (only 12em appears to work). Suppress that following control while hidden.
   */
  const SIDEBAR_TITLE_HIDDEN_MQ = '(min-width: 88.5em)';

  const SAFE_HREF = /^(https?:\/\/|\/|#|mailto:)/i;

  const applySpacingClass = (element: HTMLElement, spacing: SpacingValue) => {
    Object.values(STACK_CLASS).forEach((className) => {
      if (className) element.classList.remove(className);
    });
    const next = STACK_CLASS[spacing];
    if (next) element.classList.add(next);
    element.dataset.devSpacingValue = spacing;
  };

  const followsHiddenSidebarTitle = (element: HTMLElement) => {
    if (!window.matchMedia(SIDEBAR_TITLE_HIDDEN_MQ).matches) return false;
    const prev = element.previousElementSibling;
    return (
      prev instanceof HTMLElement &&
      (
        prev.classList.contains('project-section-title--hide-when-sidebar') ||
        prev.classList.contains('project-section-title--hide-desktop')
      )
    );
  };

  const initDevTextEditor = () => {
    if (document.documentElement.dataset.devTextEditorInit === '1') return;

    const actions = document.querySelector<HTMLElement>('[data-dev-text-actions]');
    const saveButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-save]');
    const publishButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-publish]');
    const commitStylesButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-commit-styles]');
    const revertButton = actions?.querySelector<HTMLButtonElement>('[data-dev-text-revert]');
    const status = actions?.querySelector<HTMLElement>('[data-dev-text-status]');
    const branchLabel = actions?.querySelector<HTMLElement>('[data-dev-text-branch]');
    const warnLabel = actions?.querySelector<HTMLElement>('[data-dev-text-warn]');
    const formatBar = document.querySelector<HTMLElement>('[data-dev-text-format]');
    const linkPanel = formatBar?.querySelector<HTMLFormElement>('[data-dev-text-link-panel]');
    const linkInput = formatBar?.querySelector<HTMLInputElement>('[data-dev-text-link-input]');
    const unlinkButton = formatBar?.querySelector<HTMLButtonElement>('[data-dev-text-unlink]');
    const formatButtons = formatBar
      ? [...formatBar.querySelectorAll<HTMLButtonElement>('[data-dev-format]')]
      : [];
    const textElements = [
      ...document.querySelectorAll<HTMLElement>('[data-dev-text-document][data-dev-text-path]'),
    ];
    const spacingElements = [
      ...document.querySelectorAll<HTMLElement>('[data-dev-spacing-document][data-dev-spacing-path]'),
    ];
    if (!actions || !saveButton || !publishButton || !commitStylesButton || !revertButton || !status || !branchLabel || !warnLabel) return;
    if (!formatBar || !linkPanel || !linkInput || !unlinkButton) return;

    document.documentElement.dataset.devTextEditorInit = '1';
    initDevSectionOutlineSync();

    type PendingMediaChange = {
      id: string;
      kind: 'crop' | 'grid' | 'carousel' | 'caption' | 'listing-order' | 'section-order' | 'placeholder-fill' | 'style-token' | 'section-nav' | 'media-remove' | 'project-settings' | 'gallery-membership';
      payload: Record<string, unknown>;
      revert: () => void;
      /** Live section root for placeholder fills — index is read from it at Save. */
      root?: HTMLElement;
    };

    type PendingSectionDelete = {
      documentKey: string;
      deletedIndex: number;
      root: HTMLElement;
      insertBefore: ChildNode | null;
      textStates: EditableTextState[];
      spacingState: EditableSpacingState | null;
      outlineRevert: {
        action: 'insert';
        index: number;
        type?: string;
        section: Record<string, unknown>;
      };
    };

    type PendingSectionInsert = {
      documentKey: string;
      index: number;
      type: InsertableSectionType;
      spacing: SpacingValue;
      sectionId: string;
      root: HTMLElement;
      textStates: EditableTextState[];
      spacingState: EditableSpacingState | null;
    };

    type PersistedMediaInsert = {
      documentKey: string;
      index: number;
      root: HTMLElement;
      section: Record<string, unknown>;
    };

    const pendingMedia = new Map<string, PendingMediaChange>();
    const pendingSectionDeletes: PendingSectionDelete[] = [];
    const pendingSectionInserts: PendingSectionInsert[] = [];
    const persistedMediaInserts: PersistedMediaInsert[] = [];
    let devServerReloading = false;

    if (import.meta.hot) {
      import.meta.hot.on('vite:beforeFullReload', () => {
        devServerReloading = true;
      });
    }

    const cleanText = (value: string) => value.replaceAll('\u00a0', ' ');
    /** Keep authored inline markup through Save; unwrap anything else. */
    const serializeInlineHtml = (root: ParentNode): string => {
      const walk = (node: Node): string => {
        if (node.nodeType === Node.TEXT_NODE) {
          return cleanText(node.textContent ?? '');
        }
        if (!(node instanceof HTMLElement)) return '';

        const inner = [...node.childNodes].map(walk).join('');
        const tag = node.tagName;
        if (tag === 'BR') return '';
        if (tag === 'STRONG' || tag === 'B') return inner ? `<strong>${inner}</strong>` : '';
        if (tag === 'EM' || tag === 'I') return inner ? `<em>${inner}</em>` : '';
        if (tag === 'U') return inner ? `<u>${inner}</u>` : '';
        if (tag === 'A') {
          const href = (node.getAttribute('href') || '').trim();
          const safeHref = SAFE_HREF.test(href) ? href.replaceAll('"', '%22') : '';
          if (!safeHref || !inner) return inner;
          return `<a href="${safeHref}">${inner}</a>`;
        }
        return inner;
      };

      const children = [...root.childNodes];
      if (
        children.length === 1 &&
        children[0] instanceof HTMLBRElement
      ) {
        return '';
      }
      return children.map(walk).join('');
    };
    const fillParagraph = (paragraph: HTMLElement, html: string) => {
      if (html) paragraph.innerHTML = html;
      else paragraph.replaceChildren(document.createElement('br'));
    };
    const readParagraphsValue = (element: HTMLElement): string[] => {
      const paragraphs = [...element.querySelectorAll<HTMLElement>(':scope > p')];
      if (paragraphs.length) {
        return paragraphs.map((paragraph) => serializeInlineHtml(paragraph));
      }
      const blocks = [...element.children].filter(
        (child): child is HTMLElement => child instanceof HTMLElement,
      );
      if (blocks.length) {
        return blocks.map((block) => serializeInlineHtml(block));
      }
      const inline = serializeInlineHtml(element);
      return inline ? [inline] : [];
    };
    const readValue = (state: Pick<EditableTextState, 'element' | 'kind'>): EditableTextValue =>
      state.kind === 'paragraphs'
        ? readParagraphsValue(state.element)
        : cleanText(state.element.textContent ?? '');
    const valuesMatch = (left: EditableTextValue, right: EditableTextValue) =>
      JSON.stringify(left) === JSON.stringify(right);
    const renderValue = (state: EditableTextState, value: EditableTextValue) => {
      if (state.kind === 'paragraphs' && Array.isArray(value)) {
        const texts = value.length ? value : [''];
        const paragraphs = texts.map((text) => {
          const paragraph = document.createElement('p');
          fillParagraph(paragraph, text);
          return paragraph;
        });
        state.element.replaceChildren(...paragraphs);
        return;
      }
      state.element.textContent = typeof value === 'string' ? value : value.join('\n');
    };

    const textStates = textElements.flatMap<EditableTextState>((element) => {
      try {
        const path = JSON.parse(element.dataset.devTextPath || '[]');
        if (!Array.isArray(path) || !element.dataset.devTextDocument) return [];
        const state: EditableTextState = {
          element,
          document: element.dataset.devTextDocument,
          path,
          kind: element.dataset.devTextKind === 'paragraphs' ? 'paragraphs' : 'text',
          savedValue: '',
        };
        state.savedValue = readValue(state);
        return [state];
      } catch {
        return [];
      }
    });

    const syncSpacingControl = (state: EditableSpacingState) => {
      state.control.querySelectorAll<HTMLButtonElement>('[data-dev-spacing-option]').forEach((button) => {
        button.classList.toggle('is-active', button.dataset.devSpacingOption === state.currentValue);
      });
      state.element.classList.toggle(
        'is-dev-spacing-dirty',
        state.currentValue !== state.savedValue,
      );
    };

    const bindSpacingOptionClicks = (state: EditableSpacingState) => {
      state.control.querySelectorAll<HTMLButtonElement>('[data-dev-spacing-option]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const next = button.dataset.devSpacingOption as SpacingValue;
          if (!next || next === state.currentValue) return;
          state.currentValue = next;
          applySpacingClass(state.element, next);
          syncSpacingControl(state);
          updateActions();
        });
      });
    };

    const rebuildSpacingOptionButtons = (state: EditableSpacingState, pageTop: boolean) => {
      state.spacingGroup.innerHTML = spacingButtonsHtml(pageTop);
      bindSpacingOptionClicks(state);
      syncSpacingControl(state);
      state.control.dataset.pageTop = pageTop ? 'true' : 'false';
    };

    /**
     * Page-top is the only control with a 0 option. When structure changes,
     * rebuild option sets and coerce legacy/invalid values.
     */
    const syncPageTopSpacingControls = () => {
      spacingStates.forEach((state) => {
        const pageTop = isPageTopSpacingBlock(state.element);
        const wasPageTop = state.control.dataset.pageTop === 'true';

        if (pageTop && !wasPageTop
          && state.currentValue === 'section'
          && state.savedValue === 'section') {
          // Became page-top with between-sibling default — page top should be flush.
          applySpacingClass(state.element, 'none');
          state.currentValue = 'none';
          state.savedValue = 'none';
        }

        if (!pageTop && state.currentValue === 'none') {
          applySpacingClass(state.element, 'section');
          state.currentValue = 'section';
          if (state.savedValue === 'none') state.savedValue = 'section';
        }

        rebuildSpacingOptionButtons(state, pageTop);
      });
    };

    const mountSpacingControl = (element: HTMLElement): EditableSpacingState | null => {
      try {
        const path = JSON.parse(element.dataset.devSpacingPath || '[]');
        const raw = (element.dataset.devSpacingValue || 'section') as SpacingValue;
        if (!Array.isArray(path) || !element.dataset.devSpacingDocument) return null;
        if (element.querySelector(':scope > [data-dev-spacing-control]')) return null;

        const pageTop = isPageTopSpacingBlock(element);
        const initial = raw;

        const control = document.createElement('div');
        control.className = 'dev-gap-toolbar';
        control.setAttribute('data-dev-spacing-control', '');
        control.setAttribute('data-dev-mode-only', '');
        control.dataset.pageTop = pageTop ? 'true' : 'false';
        const devEnabled = document.documentElement.classList.contains('is-dev-mode');
        control.hidden = !devEnabled || followsHiddenSidebarTitle(element);
        control.innerHTML = `
          <button
            type="button"
            class="dev-gap-toolbar__add"
            data-dev-section-add
            title="Add section"
            aria-label="Add section"
            aria-expanded="false"
            aria-haspopup="menu"
          >
            <span aria-hidden="true">${sizeIcon(plusIcon)}</span>
          </button>
          <div class="dev-gap-toolbar__menu" data-dev-section-menu hidden role="menu">
            <button type="button" role="menuitem" data-dev-section-type="bodyText">Text section</button>
            <button type="button" role="menuitem" data-dev-section-type="sectionTitle">Section header</button>
            <button type="button" role="menuitem" data-dev-section-type="image">Image</button>
            <button type="button" role="menuitem" data-dev-section-type="imageCarousel">Carousel</button>
          </div>
          <div class="dev-gap-toolbar__spacing">
            ${spacingButtonsHtml(pageTop)}
          </div>
        `;

        const addButton = control.querySelector<HTMLButtonElement>('[data-dev-section-add]');
        const menu = control.querySelector<HTMLElement>('[data-dev-section-menu]');
        const spacingGroup = control.querySelector<HTMLElement>('.dev-gap-toolbar__spacing');
        if (!addButton || !menu || !spacingGroup) return null;

        const computed = getComputedStyle(element);
        if (computed.position === 'static') {
          element.style.position = 'relative';
        }
        element.prepend(control);

        const state: EditableSpacingState = {
          element,
          control,
          addButton,
          spacingGroup,
          menu,
          document: element.dataset.devSpacingDocument,
          path,
          savedValue: initial,
          currentValue: initial,
        };
        bindSpacingOptionClicks(state);
        syncSpacingControl(state);

        return state;
      } catch {
        return null;
      }
    };

    const spacingStates = spacingElements.flatMap<EditableSpacingState>((element) => {
      const state = mountSpacingControl(element);
      return state ? [state] : [];
    });
    syncPageTopSpacingControls();

    /** Paths on media/text/spacing editors — bumped when sections are inserted/deleted in-place. */
    const DEV_PATH_ATTRS = [
      'data-dev-spacing-path',
      'data-dev-text-path',
      'data-dev-image-path',
      'data-dev-grid-path',
    ] as const;

    const bumpSectionPath = (
      path: Array<string | number>,
      fromIndex: number,
      delta: number,
    ) => {
      if (path[0] !== 'sections' || typeof path[1] !== 'number') return false;
      if (delta > 0) {
        if (path[1] < fromIndex) return false;
      } else if (path[1] <= fromIndex) {
        return false;
      }
      path[1] += delta;
      return true;
    };

    const remapPathsInStates = (indexMap: Record<number, number>) => {
      textStates.forEach((state) => {
        if (state.path[0] === 'sections' && typeof state.path[1] === 'number') {
          const newIdx = indexMap[state.path[1]];
          if (newIdx !== undefined) state.path[1] = newIdx;
        }
      });
      spacingStates.forEach((state) => {
        if (state.path[0] === 'sections' && typeof state.path[1] === 'number') {
          const newIdx = indexMap[state.path[1]];
          if (newIdx !== undefined) state.path[1] = newIdx;
        }
      });
    };

    const reindexDevPaths = (fromIndex: number, delta: number) => {
      // Order ids are not in DEV_PATH_ATTRS but track the same JSON index, so
      // they have to move with the paths. Every caller mutates the DOM either
      // before the new root is attached or after the old one is detached, so
      // the shifted set never includes the block being added or removed.
      shiftSectionOrderIds(fromIndex, delta);
      document.querySelectorAll<HTMLElement>(DEV_PATH_ATTRS.map((attr) => `[${attr}]`).join(',')).forEach((el) => {
        DEV_PATH_ATTRS.forEach((attr) => {
          const raw = el.getAttribute(attr);
          if (!raw) return;
          try {
            const path = JSON.parse(raw);
            if (!Array.isArray(path)) return;
            if (bumpSectionPath(path, fromIndex, delta)) {
              el.setAttribute(attr, JSON.stringify(path));
            }
          } catch {
            // Ignore malformed paths.
          }
        });
      });
      textStates.forEach((state) => {
        bumpSectionPath(state.path, fromIndex, delta);
      });
      spacingStates.forEach((state) => {
        bumpSectionPath(state.path, fromIndex, delta);
      });
    };

    /** Text entry proper — not a checkbox, range or select a tuner uses for settings. */
    const isTextEntryField = (element: HTMLElement) => {
      if (element instanceof HTMLTextAreaElement) return true;
      if (!(element instanceof HTMLInputElement)) return false;
      return ['text', 'search', 'url', 'email', 'tel'].includes(element.type);
    };

    const isDevTextCaretActive = () => {
      const active = document.activeElement;
      if (!(active instanceof HTMLElement)) return false;
      // Generic first: any focused editing host — grid card titles
      // (DevProjectGridEditor), inline captions, section nav labels — counts,
      // not just this component's own tracked body-text fields.
      if (active.isContentEditable) return true;
      // Panel text fields count too. Clicking into an existing caption enables
      // inline contenteditable, but "Add caption" focuses the tuner's own
      // <textarea>, which is just as much an active text affordance.
      if (isTextEntryField(active)) return true;
      return textStates.some(
        (state) => state.element === active || state.element.contains(active),
      );
    };

    const clearGapProximity = (control: HTMLElement) => {
      control.classList.remove('is-near-add', 'is-near-spacing');
    };

    const clearGapProximityAll = () => {
      spacingStates.forEach(({ control }) => clearGapProximity(control));
      document.documentElement.classList.remove('is-page-top-gap-above-header');
    };

    const syncSpacingCaretSuppression = () => {
      const suppressed = isDevTextCaretActive();
      document.documentElement.classList.toggle('is-dev-text-caret', suppressed);
      if (suppressed) clearGapProximityAll();
    };

    const syncSpacingControlVisibility = () => {
      const devEnabled = document.documentElement.classList.contains('is-dev-mode');
      spacingStates.forEach(({ control, element }) => {
        const suppressed = followsHiddenSidebarTitle(element);
        control.hidden = !devEnabled || suppressed;
        if (suppressed) clearGapProximity(control);
      });
      if (!devEnabled) document.documentElement.classList.remove('is-page-top-gap-above-header');
    };

    const distanceToToolbarTarget = (
      target: HTMLElement,
      clientX: number,
      clientY: number,
    ) => {
      const rect = target.getBoundingClientRect();
      const dx = clientX - (rect.left + rect.width / 2);
      const dy = clientY - (rect.top + rect.height / 2);
      return Math.hypot(dx, dy);
    };

    const isSectionMenuOpen = (state: EditableSpacingState) => !state.menu.hidden;

    const isAddControlPinned = (state: EditableSpacingState) =>
      isSectionMenuOpen(state) ||
      state.addButton === document.activeElement ||
      state.menu.contains(document.activeElement);

    const isSpacingControlPinned = (state: EditableSpacingState) =>
      state.element.classList.contains('is-dev-spacing-dirty') ||
      state.spacingGroup.contains(document.activeElement);

    const isPageTopGapControl = (control: HTMLElement) => control.dataset.pageTop === 'true';

    /** Escape drop-zone isolation so page-top chips paint/hit above the sticky header. */
    const syncPageTopGapStacking = () => {
      const pageTopActive = spacingStates.some(
        ({ control }) =>
          isPageTopGapControl(control) &&
          !control.hidden &&
          (control.classList.contains('is-near-add') ||
            control.classList.contains('is-near-spacing') ||
            control.classList.contains('is-menu-open')),
      );
      const root = document.documentElement;
      const wasActive = root.classList.contains('is-page-top-gap-above-header');
      root.classList.toggle('is-page-top-gap-above-header', pageTopActive);
      if (pageTopActive && !wasActive) {
        document.dispatchEvent(new CustomEvent('header:force-close'));
      }
    };

    const closeSectionMenus = (except?: EditableSpacingState) => {
      spacingStates.forEach((state) => {
        if (except && state === except) return;
        state.menu.hidden = true;
        state.addButton.setAttribute('aria-expanded', 'false');
        state.control.classList.remove('is-menu-open');
      });
      syncPageTopGapStacking();
    };

    /**
     * Header chrome sits above mid-page gap toolbars in paint order (drop zone
     * z-index 25 vs header 50). Page-top chips lift the drop zone above the
     * header while active — see syncPageTopGapStacking. Use geometry (not
     * elementFromPoint) so an already-visible chip doesn't keep itself alive.
     */
    const isPointerOverHeaderChrome = (clientX: number, clientY: number) => {
      const header = document.querySelector('.site-header');
      if (!header) return false;
      return [...header.querySelectorAll<HTMLElement>('.header-trigger')].some((trigger) => {
        const panel = trigger.querySelector<HTMLElement>('.header-trigger__panel');
        const box =
          trigger.classList.contains('is-menu-open') && panel
            ? panel.getBoundingClientRect()
            : trigger.getBoundingClientRect();
        return (
          clientX >= box.left &&
          clientX <= box.right &&
          clientY >= box.top &&
          clientY <= box.bottom
        );
      });
    };

    /**
     * Centre + and right-edge spacing reveal independently. Within each
     * control type, only the nearest in-range target wins — thin sections
     * otherwise stack two toolbars and the lower one steals clicks.
     */
    const gapsSuppressed = () =>
      isDevTextCaretActive()
      || document.documentElement.classList.contains('is-dev-asset-manager-open')
      || document.documentElement.classList.contains('is-dev-tuner-open');

    const syncSpacingProximity = (clientX: number, clientY: number) => {
      if (
        !document.documentElement.classList.contains('is-dev-mode')
        || gapsSuppressed()
      ) {
        spacingStates.forEach(({ control }) => {
          if (!control.classList.contains('is-menu-open')) clearGapProximity(control);
        });
        document.documentElement.classList.remove('is-page-top-gap-above-header');
        return;
      }

      const overHeader = isPointerOverHeaderChrome(clientX, clientY);

      let nearestAdd: EditableSpacingState | null = null;
      let nearestAddDistance = Infinity;
      let nearestSpacing: EditableSpacingState | null = null;
      let nearestSpacingDistance = Infinity;

      spacingStates.forEach((state) => {
        if (state.control.hidden) return;
        // Mid-page chips stay suppressed under the sticky header; page-top may lift above it.
        if (overHeader && !isPageTopGapControl(state.control)) return;

        if (!isAddControlPinned(state)) {
          const distance = distanceToToolbarTarget(state.addButton, clientX, clientY);
          if (distance <= SPACING_ACTIVATION_RADIUS_PX && distance < nearestAddDistance) {
            nearestAdd = state;
            nearestAddDistance = distance;
          }
        }

        if (!isSpacingControlPinned(state)) {
          const distance = distanceToToolbarTarget(state.spacingGroup, clientX, clientY);
          if (distance <= SPACING_ACTIVATION_RADIUS_PX && distance < nearestSpacingDistance) {
            nearestSpacing = state;
            nearestSpacingDistance = distance;
          }
        }
      });

      spacingStates.forEach((state) => {
        const { control } = state;
        if (control.hidden) {
          clearGapProximity(control);
          return;
        }
        const allowNear = !overHeader || isPageTopGapControl(control);
        control.classList.toggle(
          'is-near-add',
          isAddControlPinned(state) || (allowNear && state === nearestAdd),
        );
        control.classList.toggle(
          'is-near-spacing',
          isSpacingControlPinned(state) || (allowNear && state === nearestSpacing),
        );
      });
      syncPageTopGapStacking();
    };

    // Caret suppression is about *any* editing surface, not gap controls, so it
    // registers unconditionally. Gallery pages carry no spacing elements, and
    // while these lived inside the `spacingStates.length` guard below they never
    // bound there at all — which is why a caret in a card title faded nothing.
    document.addEventListener('focusin', syncSpacingCaretSuppression);
    document.addEventListener('focusout', () => {
      // focusout fires before the next focus target is active
      requestAnimationFrame(() => {
        syncSpacingCaretSuppression();
        // Drop sticky section chrome when leaving a text field so the drag
        // grip doesn't linger after click-away while controls-visible is set.
        if (!isDevTextCaretActive()) {
          document.querySelectorAll<HTMLElement>('.is-dev-section-controls-visible').forEach((el) => {
            if (!el.matches(':hover')) el.classList.remove('is-dev-section-controls-visible');
          });
        }
      });
    });

    if (spacingStates.length) {
      document.addEventListener(
        'pointermove',
        (event) => {
          syncSpacingProximity(event.clientX, event.clientY);
        },
        { passive: true },
      );
      // Header mouseenter can beat the next pointermove — sync first so page-top
      // chips lift above the nav before openMenu hit-tests.
      document.addEventListener('dev:sync-gap-proximity', ((event: CustomEvent<{ clientX: number; clientY: number }>) => {
        syncSpacingProximity(event.detail.clientX, event.detail.clientY);
      }) as EventListener);
      document.addEventListener('dev:clear-gap-proximity', () => {
        spacingStates.forEach(({ control }) => {
          if (!control.classList.contains('is-menu-open')) clearGapProximity(control);
        });
        document.documentElement.classList.remove('is-page-top-gap-above-header');
      });
      document.documentElement.addEventListener('pointerleave', () => {
        spacingStates.forEach(({ control, element }) => {
          if (element.classList.contains('is-dev-spacing-dirty')) {
            control.classList.remove('is-near-add');
            syncPageTopGapStacking();
            return;
          }
          if (control.classList.contains('is-menu-open')) {
            control.classList.remove('is-near-spacing');
            syncPageTopGapStacking();
            return;
          }
          clearGapProximity(control);
        });
        document.documentElement.classList.remove('is-page-top-gap-above-header');
      });
      // Tuner click doesn't move the pointer — drop near-gap classes immediately.
      window.addEventListener('vcd:dev-edit-open', clearGapProximityAll);
      document.addEventListener(
        'pointerdown',
        (event) => {
          const target = event.target;
          if (!(target instanceof Node)) return;
          const open = spacingStates.find((state) => isSectionMenuOpen(state));
          if (!open) return;
          if (open.control.contains(target)) return;
          closeSectionMenus();
        },
        true,
      );
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (!spacingStates.some(isSectionMenuOpen)) return;
        closeSectionMenus();
      });
    }

    const dirtyTextStates = () =>
      textStates.filter((state) => !valuesMatch(readValue(state), state.savedValue));
    const dirtySpacingStates = () =>
      spacingStates.filter((state) => state.currentValue !== state.savedValue);

    const revertAllPending = () => {
      [...pendingMedia.values()].forEach((change) => {
        try {
          change.revert();
        } catch {
          // Keep reverting the rest even if one target was removed from the DOM.
        }
      });
      pendingMedia.clear();
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-reverted'));
    };

    const detachSectionStates = (element: HTMLElement) => {
      const texts = textStates.filter(
        (state) => element.contains(state.element) || state.element === element,
      );
      const spacing = spacingStates.find((state) => state.element === element) ?? null;
      texts.forEach((state) => {
        const index = textStates.indexOf(state);
        if (index >= 0) textStates.splice(index, 1);
      });
      if (spacing) {
        const index = spacingStates.indexOf(spacing);
        if (index >= 0) spacingStates.splice(index, 1);
      }
      return { texts, spacing };
    };

    const restorePendingSectionDelete = (pending: PendingSectionDelete) => {
      reindexDevPaths(pending.deletedIndex, 1);
      const anchor = findInsertAnchor(pending.deletedIndex);
      if (anchor) {
        anchor.before(pending.root);
      } else if (pending.insertBefore?.parentNode) {
        pending.insertBefore.parentNode.insertBefore(pending.root, pending.insertBefore);
      } else {
        document.querySelector('.project-page__main')?.append(pending.root);
      }

      textStates.push(...pending.textStates);
      if (pending.spacingState) {
        spacingStates.push(pending.spacingState);
        wireSectionAddMenu(pending.spacingState);
      }
      deletableSections.push(pending.root);
      mountDeleteButton(pending.root);
      syncDevModeOnSection(pending.root, document.documentElement.classList.contains('is-dev-mode'));

      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: pending.outlineRevert,
      }));
      syncPageTopSpacingControls();
    };

    const revertPendingSectionInserts = () => {
      if (!pendingSectionInserts.length) return;
      const pending = [...pendingSectionInserts].sort((a, b) => b.index - a.index);
      pendingSectionInserts.length = 0;
      pending.forEach((entry) => {
        entry.textStates.forEach((state) => {
          const index = textStates.indexOf(state);
          if (index >= 0) textStates.splice(index, 1);
        });
        if (entry.spacingState) {
          const index = spacingStates.indexOf(entry.spacingState);
          if (index >= 0) spacingStates.splice(index, 1);
        }
        const deletableIdx = deletableSections.indexOf(entry.root);
        if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);
        reindexDevPaths(entry.index, -1);
        entry.root.remove();
        window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
          detail: {
            action: 'delete',
            index: entry.index,
            sectionId: entry.sectionId,
            type: entry.type,
          },
        }));
      });
      syncPageTopSpacingControls();
    };

    const revertPendingSectionDeletes = () => {
      if (!pendingSectionDeletes.length) return;
      const pending = [...pendingSectionDeletes].sort((a, b) => a.deletedIndex - b.deletedIndex);
      pendingSectionDeletes.length = 0;
      pending.forEach(restorePendingSectionDelete);
    };

    const revertPersistedMediaInserts = async () => {
      if (!persistedMediaInserts.length) return;
      const pending = [...persistedMediaInserts].sort((a, b) => b.index - a.index);
      persistedMediaInserts.length = 0;
      for (const entry of pending) {
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            action: 'delete',
            document: entry.documentKey,
            index: entry.index,
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not undo the image insert.');

        const deletableIdx = deletableSections.indexOf(entry.root);
        if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);
        entry.root.remove();
        reindexDevPaths(entry.index, -1);

        window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
          detail: {
            document: entry.documentKey,
            action: 'delete',
            index: entry.index,
            type: String(entry.section.type ?? 'image'),
          },
        }));
      }
      syncPageTopSpacingControls();
    };

    const flushPendingEditsForDocument = async (documentKey: string) => {
      // Keep JSON indices aligned with client reindexing before text writes.
      if (pendingSectionInserts.some((entry) => entry.documentKey === documentKey)) {
        await persistPendingSectionInserts();
      }
      if (pendingSectionDeletes.some((entry) => entry.documentKey === documentKey)) {
        await persistPendingSectionDeletes();
      }
      await persistPlaceholderFills(documentKey);

      const dirtyText = dirtyTextStates().filter((state) => state.document === documentKey);
      const dirtySpacing = dirtySpacingStates().filter((state) => state.document === documentKey);
      if (!dirtyText.length && !dirtySpacing.length) return;

      if (dirtyText.length) {
        const response = await fetch('/api/content-text', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            changes: dirtyText.map((state) => ({
              document: state.document,
              path: state.path,
              value: readValue(state),
            })),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save pending text before inserting images.');
        dirtyText.forEach((state) => {
          state.savedValue = readValue(state);
        });
        syncSavedSectionTitleLabels(dirtyText);
      }

      if (dirtySpacing.length) {
        const response = await fetch('/api/content-spacing', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            changes: dirtySpacing.map((state) => ({
              document: state.document,
              path: state.path,
              value: state.currentValue,
            })),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save pending spacing before inserting images.');
        dirtySpacing.forEach((state) => {
          state.savedValue = state.currentValue;
          syncSpacingControl(state);
        });
      }

      updateActions();
    };

    const persistPendingSectionInserts = async () => {
      if (!pendingSectionInserts.length) return [] as Array<{
        clientId: string;
        serverId: string;
        documentKey: string;
      }>;
      const pending = [...pendingSectionInserts].sort((a, b) => a.index - b.index);
      const remapped: Array<{ clientId: string; serverId: string; documentKey: string }> = [];
      for (const entry of pending) {
        const clientId = entry.sectionId;
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            document: entry.documentKey,
            index: entry.index,
            type: entry.type,
            spacing: entry.spacing,
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not add the section.');
        const serverSectionId = String(
          payload.section?.sectionId || payload.section?.id || payload.id || clientId,
        );
        if (serverSectionId && serverSectionId !== clientId) {
          entry.root.id = serverSectionId;
          entry.sectionId = serverSectionId;
          remapped.push({
            clientId,
            serverId: serverSectionId,
            documentKey: entry.documentKey,
          });
        }
      }
      pendingSectionInserts.length = 0;
      return remapped;
    };

    const persistPendingSectionDeletes = async () => {
      if (!pendingSectionDeletes.length) return;
      const pending = [...pendingSectionDeletes].sort((a, b) => b.deletedIndex - a.deletedIndex);
      for (const entry of pending) {
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            action: 'delete',
            document: entry.documentKey,
            index: entry.deletedIndex,
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not delete the section.');
      }
      pendingSectionDeletes.length = 0;
    };

    const syncSavedSectionTitleLabels = (states: EditableTextState[]) => {
      states.forEach((state) => {
        if (state.kind !== 'text') return;
        const block = state.element.closest<HTMLElement>('.section-block[id], [data-dev-section-title]');
        const sectionId = block?.id;
        if (!sectionId) return;
        const label = readValue(state);
        if (typeof label !== 'string' || !label.trim()) return;
        window.dispatchEvent(new CustomEvent('vcd:dev-section-outline-label', {
          detail: {
            document: state.document,
            sectionId,
            label: label.trim(),
          },
        }));
      });
    };

    const revertDirtyEdits = () => {
      dirtyTextStates().forEach((state) => {
        renderValue(state, state.savedValue);
      });
      dirtySpacingStates().forEach((state) => {
        state.currentValue = state.savedValue;
        applySpacingClass(state.element, state.savedValue);
        syncSpacingControl(state);
      });
    };

    const unsavedChangeCount = () =>
      dirtyTextStates().length
      + dirtySpacingStates().length
      + pendingMedia.size
      + pendingSectionDeletes.length
      + pendingSectionInserts.length
      + persistedMediaInserts.length;

    /*
      Esc / leaving Edit is View mode, not discard. Pending edits stay in the
      DOM and in pendingMedia until Save, Revert, or a real navigation. The
      leave guard is beforeunload (+ vcd:before-reload) only — do not confirm
      or revert on vcd:dev-mode-before-exit.
    */

    window.addEventListener('vcd:before-reload', (event) => {
      // Persisted media inserts survive reload (already written) — don't warn for them.
      const dirtyCount = unsavedChangeCount() - persistedMediaInserts.length;
      if (!dirtyCount) return;

      const message = dirtyCount === 1
        ? 'Reload will discard 1 unsaved edit on this page. Continue?'
        : `Reload will discard ${dirtyCount} unsaved edits on this page. Continue?`;
      if (!window.confirm(message)) {
        event.preventDefault();
      }
    });

    /** Content files changed on disk but not yet committed to the publish branch. */
    let unpublishedCount = 0;

    /**
     * Colour-token CSS ahead of main (e.g. global.css after a Save). Separate
     * from content publish — Publish styles pushes it to main from any branch.
     */
    let styleEngineDirtyCount = 0;

    /**
     * Once /api/publish has succeeded at least once this session, keep the last
     * known counts on a transient failure instead of emptying the bar as if
     * publish were unavailable (same catch path as "not a git repo").
     */
    let publishKnown = false;

    /** Save or publish in flight — keeps buttons disabled with a wait cursor. */
    let actionsBusy = false;

    /** Anything in the DOM not yet written to disk. */
    const hasPendingEdits = () => Boolean(
      dirtyTextStates().length
      || dirtySpacingStates().length
      || pendingMedia.size
      || pendingSectionDeletes.length
      || pendingSectionInserts.length
      || persistedMediaInserts.length,
    );

    /**
     * A message that must survive the next updateActions(). Publish failures used
     * to flash for a frame and vanish — refreshPublishState() runs in the click
     * handler's `finally` and updateActions() overwrote the text with the change
     * count, so the one thing worth reading was the one thing you could not.
     * Cleared by the next edit or button press, not by a repaint — except
     * "Saved.", which yields to the unpublished count once publish state refreshes.
     */
    let stickyStatus = '';
    const setStickyStatus = (message: string) => {
      stickyStatus = message;
      status.textContent = message;
    };

    const updateActions = () => {
      const dirtyText = dirtyTextStates();
      const dirtySpacing = dirtySpacingStates();
      // Include persistedMediaInserts: already on disk, but still reversible until Save.
      const dirtyCount = dirtyText.length + dirtySpacing.length + pendingMedia.size
        + pendingSectionDeletes.length + pendingSectionInserts.length
        + persistedMediaInserts.length;

      textStates.forEach((state) => {
        state.element.classList.toggle(
          'is-dev-text-dirty',
          !valuesMatch(readValue(state), state.savedValue),
        );
      });
      spacingStates.forEach(syncSpacingControl);

      // Two independent reasons to show the bar: edits not yet on disk, and
      // edits on disk not yet published. Content saved on a feature branch and
      // carried to main by a branch switch is only ever the second kind — if
      // the bar needed unsaved DOM state, Publish would be unreachable for it.
      // Style-token Saves also leave CSS ahead of main for Publish styles.
      actions.hidden = (!dirtyCount && !unpublishedCount && !styleEngineDirtyCount)
        || !document.documentElement.classList.contains('is-dev-mode');
      if (stickyStatus) {
        status.textContent = stickyStatus;
      } else if (dirtyCount) {
        status.textContent = `${dirtyCount} unsaved ${dirtyCount === 1 ? 'change' : 'changes'}`;
      } else if (unpublishedCount) {
        status.textContent = `${unpublishedCount} unpublished ${unpublishedCount === 1 ? 'change' : 'changes'}`;
      } else if (styleEngineDirtyCount) {
        status.textContent = `${styleEngineDirtyCount} style ${styleEngineDirtyCount === 1 ? 'file' : 'files'} to publish`;
      } else {
        status.textContent = '';
      }
      // Unsaved DOM/pending OR unpublished disk content (restored via /api/content-revert).
      revertButton.hidden = !(dirtyCount || unpublishedCount);
      // Keep Save in the layout after a successful write — greyed, not removed —
      // so the bar keeps its shape while Publish becomes the next step.
      saveButton.hidden = false;
      commitStylesButton.hidden = !styleEngineDirtyCount;
      if (!actionsBusy) {
        saveButton.disabled = !dirtyCount;
        revertButton.disabled = false;
        commitStylesButton.disabled = false;
      }
      saveButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      publishButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      revertButton.classList.toggle('is-dev-actions-busy', actionsBusy);
      commitStylesButton.classList.toggle('is-dev-actions-busy', actionsBusy);
    };

    const SCROLL_RESTORE_KEY = 'vcd-dev-scroll-y';
    const restoreScrollAfterReload = () => {
      const raw = sessionStorage.getItem(SCROLL_RESTORE_KEY);
      if (raw == null) return;
      sessionStorage.removeItem(SCROLL_RESTORE_KEY);
      const y = Number(raw);
      if (!Number.isFinite(y)) return;
      requestAnimationFrame(() => {
        window.scrollTo(0, y);
      });
    };
    restoreScrollAfterReload();

    const projectStackClassName = (spacing: SpacingValue, precedeRelated: boolean) => {
      const classes: string[] = [];
      const stack = STACK_CLASS[spacing];
      if (stack) classes.push(stack);
      if (precedeRelated) classes.push('project-stack--precede-related');
      return classes.join(' ');
    };

    const buildInsertedSection = (
      type: InsertableSectionType,
      documentKey: string,
      index: number,
      spacing: SpacingValue,
    ) => {
      const sectionPath = ['sections', index] as Array<string | number>;
      // Inserted titles omit precede-related so the following block keeps its gap.
      const spacingClass = projectStackClassName(spacing, false);

      if (type === 'sectionTitle') {
        const wrapper = document.createElement('div');
        wrapper.className = spacingClass
          ? `project-block ${spacingClass}`
          : 'project-block';
        wrapper.dataset.devSpacingDocument = documentKey;
        wrapper.dataset.devSpacingPath = JSON.stringify([...sectionPath, 'spacing']);
        wrapper.dataset.devSpacingValue = spacing;
        wrapper.dataset.devSectionDeletable = 'sectionTitle';

        const title = document.createElement('h2');
        title.className = 'project-section-title';
        title.dataset.devTextDocument = documentKey;
        title.dataset.devTextPath = JSON.stringify([...sectionPath, 'title']);
        title.dataset.devTextKind = 'text';
        title.textContent = 'Section title';
        wrapper.append(title);
        return { root: wrapper, textElement: title, textKind: 'text' as const, textPath: [...sectionPath, 'title'] };
      }

      const section = document.createElement('section');
      section.className = spacingClass
        ? `project-block ${spacingClass}`
        : 'project-block';
      section.dataset.devSpacingDocument = documentKey;
      section.dataset.devSpacingPath = JSON.stringify([...sectionPath, 'spacing']);
      section.dataset.devSpacingValue = spacing;
      section.dataset.devSectionDeletable = 'bodyText';

      const body = document.createElement('div');
      body.className = 'project-body-text';
      body.dataset.devTextDocument = documentKey;
      body.dataset.devTextPath = JSON.stringify([...sectionPath, 'paragraphs']);
      body.dataset.devTextKind = 'paragraphs';
      const paragraph = document.createElement('p');
      paragraph.append(document.createElement('br'));
      body.append(paragraph);
      section.append(body);
      return {
        root: section,
        textElement: body,
        textKind: 'paragraphs' as const,
        textPath: [...sectionPath, 'paragraphs'],
      };
    };

    /**
     * Enter / focus often leave the caret on the contenteditable root (the
     * div) instead of inside a <p>. Our Enter handler requires a direct-child
     * paragraph — without this, preventDefault runs and Return does nothing
     * until a click places the caret in a <p> (or after save+reload).
     */
    const placeCaretInParagraph = (paragraph: HTMLElement, atStart: boolean) => {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      if (atStart) {
        range.setStart(paragraph, 0);
        range.collapse(true);
      } else {
        range.selectNodeContents(paragraph);
        range.collapse(false);
      }
      selection.removeAllRanges();
      selection.addRange(range);
    };

    const ensureParagraphSelection = (element: HTMLElement): HTMLParagraphElement | null => {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return null;
      const range = selection.getRangeAt(0);
      if (!element.contains(range.startContainer)) return null;

      const startElement = range.startContainer instanceof Element
        ? range.startContainer
        : range.startContainer.parentElement;
      const existing = startElement?.closest('p');
      if (existing instanceof HTMLParagraphElement && existing.parentElement === element) {
        return existing;
      }

      // Caret is on the root (or outside any <p>) — snap into a neighbour.
      if (range.startContainer === element) {
        const atOffset = element.childNodes[range.startOffset];
        if (atOffset instanceof HTMLParagraphElement) {
          placeCaretInParagraph(atOffset, true);
          return atOffset;
        }
        const before = element.childNodes[range.startOffset - 1];
        if (before instanceof HTMLParagraphElement) {
          placeCaretInParagraph(before, false);
          return before;
        }
      }

      const paragraphs = [...element.querySelectorAll<HTMLParagraphElement>(':scope > p')];
      if (paragraphs.length) {
        const fallback = paragraphs[0];
        placeCaretInParagraph(fallback, true);
        return fallback;
      }

      const created = document.createElement('p');
      created.append(document.createElement('br'));
      element.append(created);
      placeCaretInParagraph(created, true);
      return created;
    };

    const bindTextState = (state: EditableTextState) => {
      const { element } = state;
      // Typing is the signal that the last Save/Publish message has been read.
      element.addEventListener('input', () => {
        stickyStatus = '';
        updateActions();
      });
      if (state.kind === 'paragraphs') {
        element.addEventListener('focus', () => {
          // Defer so the browser finishes its own caret placement first.
          requestAnimationFrame(() => ensureParagraphSelection(element));
        });
      }
      element.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' || state.kind !== 'paragraphs') return;
        event.preventDefault();

        const paragraph = ensureParagraphSelection(element);
        if (!paragraph) return;

        const selection = window.getSelection();
        if (!selection?.rangeCount) return;
        // Re-read after ensureParagraphSelection may have moved the caret.
        const range = selection.getRangeAt(0);
        if (!paragraph.contains(range.startContainer) && range.startContainer !== paragraph) {
          placeCaretInParagraph(paragraph, false);
        }
        const liveRange = selection.getRangeAt(0);

        if (!liveRange.collapsed) liveRange.deleteContents();

        const afterRange = document.createRange();
        afterRange.setStart(liveRange.startContainer, liveRange.startOffset);
        afterRange.setEnd(paragraph, paragraph.childNodes.length);
        const trailing = afterRange.extractContents();

        const nextParagraph = document.createElement('p');
        if (serializeInlineHtml(trailing) || trailing.textContent?.replaceAll('\u00a0', ' ').trim()) {
          nextParagraph.append(trailing);
        } else {
          nextParagraph.append(document.createElement('br'));
        }

        if (!serializeInlineHtml(paragraph) && !paragraph.textContent?.replaceAll('\u00a0', ' ').trim()) {
          paragraph.replaceChildren(document.createElement('br'));
        }

        paragraph.after(nextParagraph);

        const nextRange = document.createRange();
        nextRange.setStart(nextParagraph, 0);
        nextRange.collapse(true);
        selection.removeAllRanges();
        selection.addRange(nextRange);
        updateActions();
      });
    };

    const TRASH_ICON = sizeIcon(trashIcon);

    const deletableSections: HTMLElement[] = [
      ...document.querySelectorAll<HTMLElement>(
        '[data-dev-section-deletable][data-dev-spacing-document][data-dev-spacing-path]',
      ),
    ];

    let deleteSectionAt: (element: HTMLElement) => Promise<void> = async () => {};

    const mountDeleteButton = (element: HTMLElement) => {
      if (element.querySelector(':scope > [data-dev-section-delete]')) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'dev-section-delete';
      button.setAttribute('data-dev-section-delete', '');
      button.setAttribute('data-dev-mode-only', '');
      button.title = 'Delete section';
      button.setAttribute('aria-label', 'Delete section');
      button.innerHTML = TRASH_ICON;
      button.hidden = !document.documentElement.classList.contains('is-dev-mode');

      const computed = getComputedStyle(element);
      if (computed.position === 'static') {
        element.style.position = 'relative';
      }
      element.prepend(button);

      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        void deleteSectionAt(element);
      });
    };

    const clearBusyStatus = () => {
      actions.hidden = true;
      status.textContent = '';
      saveButton.disabled = false;
      revertButton.disabled = false;
    };

    const insertSectionAt = (state: EditableSpacingState, type: InsertableSectionType) => {
      const sectionIndex = state.path.at(-2);
      if (typeof sectionIndex !== 'number') {
        status.textContent = 'Could not find where to insert.';
        actions.hidden = false;
        return;
      }

      const newSpacing: SpacingValue = sectionIndex === 0 ? 'none' : 'section';
      const sectionId = `${type === 'sectionTitle' ? 'title' : 'body'}-${Date.now().toString(36)}`;

      closeSectionMenus();
      reindexDevPaths(sectionIndex, 1);

      const built = buildInsertedSection(type, state.document, sectionIndex, newSpacing);
      state.element.before(built.root);

      const spacingState = mountSpacingControl(built.root);
      if (spacingState) {
        spacingStates.push(spacingState);
        wireSectionAddMenu(spacingState);
      }

      const textState: EditableTextState = {
        element: built.textElement,
        document: state.document,
        path: built.textPath,
        kind: built.textKind,
        savedValue: built.textKind === 'paragraphs' ? [''] : 'Section title',
      };
      textStates.push(textState);
      bindTextState(textState);
      if (document.documentElement.classList.contains('is-dev-mode')) {
        built.textElement.setAttribute(
          'contenteditable',
          built.textKind === 'paragraphs' ? 'true' : 'plaintext-only',
        );
        built.textElement.setAttribute('spellcheck', 'true');
      }

      mountDeleteButton(built.root);
      deletableSections.push(built.root);

      if (type === 'sectionTitle') {
        built.root.id = sectionId;
        built.root.classList.add('section-block');
        built.root.dataset.devSectionTitle = 'true';
      }

      pendingSectionInserts.push({
        documentKey: state.document,
        index: sectionIndex,
        type,
        spacing: newSpacing,
        sectionId,
        root: built.root,
        textStates: [textState],
        spacingState: spacingState ?? null,
      });

      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          document: state.document,
          action: 'insert',
          index: sectionIndex,
          type,
          sectionId,
          section: {
            type,
            id: sectionId,
            sectionId,
            title: 'Section title',
          },
        },
      }));

      syncPageTopSpacingControls();
      updateActions();
      requestAnimationFrame(() => {
        built.textElement.focus();
        if (built.textKind === 'paragraphs') {
          ensureParagraphSelection(built.textElement);
        } else if (built.textKind === 'text') {
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(built.textElement);
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      });
    };

    const wireSectionAddMenu = (state: EditableSpacingState) => {
      state.addButton.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const opening = state.menu.hidden;
        closeSectionMenus(opening ? state : undefined);
        if (!opening) return;
        state.menu.hidden = false;
        state.addButton.setAttribute('aria-expanded', 'true');
        state.control.classList.add('is-near-add', 'is-menu-open');
        syncPageTopGapStacking();
      });

      state.menu.querySelectorAll<HTMLButtonElement>('[data-dev-section-type]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const type = button.dataset.devSectionType as InsertableSectionType | undefined;
          if (type === 'image' || type === 'imageCarousel') {
            const sectionIndex = state.path.at(-2);
            if (typeof sectionIndex !== 'number') return;
            closeSectionMenus();
            window.dispatchEvent(new CustomEvent('vcd:dev-image-picker-open', {
              detail: {
                documentKey: state.document,
                index: sectionIndex,
                ...(type === 'imageCarousel' ? { preferredType: 'imageCarousel' } : {}),
              },
            }));
            return;
          }
          if (type !== 'bodyText' && type !== 'sectionTitle') return;
          insertSectionAt(state, type);
        });
      });
    };

    spacingStates.forEach(wireSectionAddMenu);

    deleteSectionAt = async (element: HTMLElement) => {
      let path: Array<string | number> = [];
      try {
        path = JSON.parse(element.dataset.devSpacingPath || '[]');
      } catch {
        path = [];
      }
      const sectionIndex = path.at(-2);
      const documentKey = element.dataset.devSpacingDocument;
      if (typeof sectionIndex !== 'number' || !documentKey) {
        status.textContent = 'Could not find which section to delete.';
        actions.hidden = false;
        return;
      }

      const sectionId = element.id || undefined;
      const sectionType = element.dataset.devSectionDeletable;
      const titleElement = element.querySelector<HTMLElement>('[data-dev-text-document]');
      const title = titleElement?.textContent?.trim() || 'Section title';
      const insertBefore = element.nextSibling;
      const pendingInsertIdx = pendingSectionInserts.findIndex((entry) => entry.root === element);
      const persistedInsertIdx = persistedMediaInserts.findIndex((entry) => entry.root === element);
      const { texts, spacing } = detachSectionStates(element);

      const deletableIdx = deletableSections.indexOf(element);
      if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);

      element.remove();
      reindexDevPaths(sectionIndex, -1);

      if (pendingInsertIdx >= 0) {
        pendingSectionInserts.splice(pendingInsertIdx, 1);
        window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
          detail: {
            document: documentKey,
            action: 'delete',
            index: sectionIndex,
            sectionId,
            type: sectionType,
          },
        }));
        syncPageTopSpacingControls();
        updateActions();
        return;
      }

      if (persistedInsertIdx >= 0) {
        persistedMediaInserts.splice(persistedInsertIdx, 1);
      }

      pendingSectionDeletes.push({
        documentKey,
        deletedIndex: sectionIndex,
        root: element,
        insertBefore,
        textStates: texts,
        spacingState: spacing,
        outlineRevert: {
          action: 'insert',
          index: sectionIndex,
          type: sectionType,
          section: {
            type: sectionType,
            sectionId,
            id: sectionId,
            title,
          },
        },
      });

      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          document: documentKey,
          action: 'delete',
          index: sectionIndex,
          sectionId,
          type: sectionType,
        },
      }));

      syncPageTopSpacingControls();
      updateActions();
    };

    deletableSections.forEach((element) => {
      mountDeleteButton(element);
    });

    const findInsertAnchor = (index: number) => {
      for (const block of document.querySelectorAll<HTMLElement>(
        '[data-dev-spacing-document][data-dev-spacing-path]',
      )) {
        try {
          const path = JSON.parse(block.dataset.devSpacingPath || '[]');
          if (path[0] === 'sections' && path[1] === index + 1) return block;
        } catch {
          // Ignore malformed paths.
        }
      }
      return null;
    };

    const mountMediaSectionInPlace = (
      section: Record<string, unknown>,
      documentKey: string,
      index: number,
    ) => {
      const pageUsesDocument =
        spacingStates.some((state) => state.document === documentKey)
        || textStates.some((state) => state.document === documentKey);
      if (!pageUsesDocument) return;

      reindexDevPaths(index, 1);
      const root = mountInsertedSection(section, documentKey, index);
      const anchor = findInsertAnchor(index);
      if (anchor) anchor.before(root);
      else document.querySelector('.project-page__main')?.append(root);

      const spacingState = mountSpacingControl(root);
      if (spacingState) {
        spacingStates.push(spacingState);
        wireSectionAddMenu(spacingState);
      }
      mountDeleteButton(root);
      deletableSections.push(root);
      initMountedSectionCovers(root);
      syncDevModeOnSection(root, document.documentElement.classList.contains('is-dev-mode'));

      persistedMediaInserts.push({
        documentKey,
        index,
        root,
        section,
      });

      // Media inserts land on disk at drop time, so a pending reorder captured
      // before this point is already stale. Announce the structural change the
      // way the add-block path does — the revert path already does.
      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          document: documentKey,
          action: 'insert',
          index,
          type: String(section.type ?? 'image'),
          section,
        },
      }));

      syncPageTopSpacingControls();
      updateActions();
    };

    const findSectionRootByIndex = (index: number) => {
      for (const block of document.querySelectorAll<HTMLElement>(
        '[data-dev-spacing-document][data-dev-spacing-path]',
      )) {
        try {
          const path = JSON.parse(block.dataset.devSpacingPath || '[]');
          if (
            path[0] === 'sections'
            && path[1] === index
            && path.at(-1) === 'spacing'
          ) {
            return block;
          }
        } catch {
          // Ignore malformed paths.
        }
      }
      return null;
    };

    const replaceMediaSectionInPlace = (
      section: Record<string, unknown>,
      documentKey: string,
      index: number,
    ): HTMLElement | null => {
      const pageUsesDocument =
        spacingStates.some((state) => state.document === documentKey)
        || textStates.some((state) => state.document === documentKey);
      if (!pageUsesDocument) return null;

      const existing = findSectionRootByIndex(index);
      if (!existing) return null;

      detachSectionStates(existing);
      const deletableIdx = deletableSections.indexOf(existing);
      if (deletableIdx >= 0) deletableSections.splice(deletableIdx, 1);

      const root = mountInsertedSection(section, documentKey, index);
      existing.replaceWith(root);

      const spacingState = mountSpacingControl(root);
      if (spacingState) {
        spacingStates.push(spacingState);
        wireSectionAddMenu(spacingState);
      }
      mountDeleteButton(root);
      deletableSections.push(root);
      initMountedSectionCovers(root);
      syncDevModeOnSection(root, document.documentElement.classList.contains('is-dev-mode'));

      const persisted = persistedMediaInserts.find((entry) => entry.root === existing);
      if (persisted) {
        persisted.root = root;
        persisted.section = section;
      }

      syncPageTopSpacingControls();
      updateActions();
      return root;
    };

    const sectionIndexFromRoot = (root: HTMLElement | undefined) => {
      if (!root) return null;
      try {
        const path = JSON.parse(root.dataset.devSpacingPath || '[]');
        if (
          Array.isArray(path)
          && path[0] === 'sections'
          && typeof path[1] === 'number'
        ) {
          return path[1];
        }
      } catch {
        // Ignore malformed paths.
      }
      return null;
    };

    const persistPlaceholderFills = async (documentKey?: string) => {
      const fills = [...pendingMedia.values()].filter((change) => {
        if (change.kind !== 'placeholder-fill') return false;
        if (!documentKey) return true;
        return String(change.payload.document || '') === documentKey;
      });
      for (const change of fills) {
        const index = sectionIndexFromRoot(change.root);
        const filenames = Array.isArray(change.payload.filenames)
          ? change.payload.filenames.map((value) => String(value || '').trim()).filter(Boolean)
          : [];
        if (typeof index !== 'number' || !filenames.length) {
          throw new Error('Could not save a placeholder fill.');
        }
        const variants = (
          change.payload.variants
          && typeof change.payload.variants === 'object'
          && !Array.isArray(change.payload.variants)
        )
          ? change.payload.variants
          : undefined;
        const response = await fetch('/api/content-section', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            document: change.payload.document,
            action: 'fillPlaceholder',
            index,
            filenames,
            ...(variants ? { variants } : {}),
          }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || 'Could not save the placeholder fill.');
        pendingMedia.delete(change.id);
      }
    };

    window.addEventListener('vcd:dev-flush-pending-edits', ((event: CustomEvent<{
      documentKey?: string;
      resolve?: () => void;
      reject?: (error: Error) => void;
    }>) => {
      const { documentKey, resolve, reject } = event.detail ?? {};
      if (!documentKey) {
        resolve?.();
        return;
      }
      void flushPendingEditsForDocument(documentKey)
        .then(() => resolve?.())
        .catch((error) => {
          reject?.(error instanceof Error ? error : new Error('Could not save pending edits.'));
        });
    }) as EventListener);

    window.addEventListener('vcd:dev-section-inserted', ((event: CustomEvent<{
      documentKey?: string;
      index?: number;
      section?: Record<string, unknown>;
    }>) => {
      const { documentKey, index, section } = event.detail ?? {};
      if (!documentKey || typeof index !== 'number' || !section) return;
      mountMediaSectionInPlace(section, documentKey, index);
    }) as EventListener);

    window.addEventListener('vcd:dev-placeholder-fill-pending', ((event: CustomEvent<{
      documentKey?: string;
      index?: number;
      filenames?: string[];
      previousSection?: Record<string, unknown>;
      section?: Record<string, unknown>;
    }>) => {
      const {
        documentKey,
        index,
        filenames,
        previousSection,
        section,
      } = event.detail ?? {};
      if (
        !documentKey
        || typeof index !== 'number'
        || !section
        || !previousSection
        || !Array.isArray(filenames)
        || !filenames.length
      ) {
        return;
      }

      const id = `placeholder-fill:${documentKey}:${index}`;
      const existing = pendingMedia.get(id);
      const baseline = (
        existing
        && typeof existing.payload.previousSection === 'object'
        && existing.payload.previousSection
        && !Array.isArray(existing.payload.previousSection)
      )
        ? existing.payload.previousSection as Record<string, unknown>
        : previousSection;

      const root = replaceMediaSectionInPlace(section, documentKey, index);
      if (!root) return;

      const pendingId = id;
      const variants = (
        section.variants
        && typeof section.variants === 'object'
        && !Array.isArray(section.variants)
      )
        ? structuredClone(section.variants)
        : undefined;
      pendingMedia.set(pendingId, {
        id: pendingId,
        kind: 'placeholder-fill',
        root,
        payload: {
          document: documentKey,
          filenames: [...filenames],
          previousSection: baseline,
          ...(variants ? { variants } : {}),
        },
        revert: () => {
          const current = pendingMedia.get(pendingId);
          const liveIndex = sectionIndexFromRoot(current?.root) ?? index;
          replaceMediaSectionInPlace(baseline, documentKey, liveIndex);
        },
      });
      updateActions();
    }) as EventListener);

    const syncDeleteButtons = (enabled: boolean) => {
      deletableSections.forEach((element) => {
        const button = element.querySelector<HTMLButtonElement>(':scope > [data-dev-section-delete]');
        if (button) button.hidden = !enabled;
      });
    };

    window.addEventListener('vcd:dev-pending-upsert', ((event: CustomEvent<PendingMediaChange>) => {
      const detail = event.detail;
      if (
        !detail?.id ||
        (detail.kind !== 'crop'
          && detail.kind !== 'grid'
          && detail.kind !== 'carousel'
          && detail.kind !== 'caption'
          && detail.kind !== 'listing-order'
          && detail.kind !== 'section-order'
          && detail.kind !== 'placeholder-fill'
          && detail.kind !== 'style-token'
          && detail.kind !== 'section-nav'
          && detail.kind !== 'media-remove'
          && detail.kind !== 'project-settings'
          && detail.kind !== 'gallery-membership')
      ) {
        return;
      }
      if (typeof detail.revert !== 'function' || !detail.payload || typeof detail.payload !== 'object') {
        return;
      }
      pendingMedia.set(detail.id, detail);
      if (detail.kind === 'section-order') syncPageTopSpacingControls();
      updateActions();
    }) as EventListener);

    window.addEventListener('vcd:dev-pending-remove', ((event: CustomEvent<{ id?: string }>) => {
      const id = event.detail?.id;
      if (!id || !pendingMedia.has(id)) return;
      pendingMedia.delete(id);
      updateActions();
    }) as EventListener);

    /* ── Selection formatting popup ───────────────────────── */
    let savedFormatRange: Range | null = null;
    let linkPanelOpen = false;
    let formatPlacement: 'above' | 'below' = 'above';
    let formatRaf = 0;

    const paragraphStates = () => textStates.filter((state) => state.kind === 'paragraphs');

    const findParagraphState = (node: Node | null) => {
      if (!node) return null;
      return (
        paragraphStates().find((state) => state.element.contains(node)) ?? null
      );
    };

    const closestAnchor = (node: Node | null): HTMLAnchorElement | null => {
      const el = node instanceof Element ? node : node?.parentElement;
      return el?.closest('a') ?? null;
    };

    const restoreFormatRange = () => {
      if (!savedFormatRange) return false;
      const selection = window.getSelection();
      if (!selection) return false;
      selection.removeAllRanges();
      selection.addRange(savedFormatRange);
      return true;
    };

    const captureFormatRange = () => {
      const selection = window.getSelection();
      if (!selection?.rangeCount) return null;
      const range = selection.getRangeAt(0);
      if (range.collapsed) return null;
      if (!findParagraphState(range.commonAncestorContainer)) return null;
      savedFormatRange = range.cloneRange();
      return savedFormatRange;
    };

    const hideFormatBar = () => {
      formatBar.hidden = true;
      linkPanel.hidden = true;
      linkPanelOpen = false;
      linkInput.value = '';
      savedFormatRange = null;
      formatBar.dataset.placement = 'above';
    };

    const setLinkPanelOpen = (open: boolean) => {
      linkPanelOpen = open;
      linkPanel.hidden = !open;
      formatBar.dataset.linkOpen = open ? 'true' : 'false';
      if (open) {
        const anchor = closestAnchor(savedFormatRange?.commonAncestorContainer ?? null);
        linkInput.value = anchor?.getAttribute('href') || '';
        requestAnimationFrame(() => {
          linkInput.focus();
          linkInput.select();
        });
      } else {
        linkInput.value = '';
      }
    };

    const syncFormatButtons = () => {
      formatButtons.forEach((button) => {
        const command = button.dataset.devFormat;
        let active = false;
        if (command === 'bold' || command === 'italic' || command === 'underline') {
          try {
            active = document.queryCommandState(command);
          } catch {
            active = false;
          }
        } else if (command === 'link') {
          active = Boolean(closestAnchor(savedFormatRange?.commonAncestorContainer ?? null))
            || linkPanelOpen;
        }
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    const positionFormatBar = (range: Range) => {
      const rect = range.getBoundingClientRect();
      if (!rect.width && !rect.height) {
        hideFormatBar();
        return;
      }

      formatBar.hidden = false;
      // Measure with current link-panel state so placement accounts for height.
      const barRect = formatBar.getBoundingClientRect();
      const gap = 8;
      const spaceAbove = rect.top;
      const spaceBelow = window.innerHeight - rect.bottom;
      const preferAbove = spaceAbove >= barRect.height + gap || spaceAbove >= spaceBelow;

      formatPlacement = preferAbove ? 'above' : 'below';
      formatBar.dataset.placement = formatPlacement;

      // Re-measure after placement attribute flips link panel order.
      const measured = formatBar.getBoundingClientRect();
      let top = preferAbove
        ? rect.top - measured.height - gap
        : rect.bottom + gap;
      let left = rect.left + rect.width / 2 - measured.width / 2;

      const pad = 8;
      left = Math.min(
        Math.max(pad, left),
        window.innerWidth - measured.width - pad,
      );
      top = Math.min(
        Math.max(pad, top),
        window.innerHeight - measured.height - pad,
      );

      formatBar.style.top = `${Math.round(top)}px`;
      formatBar.style.left = `${Math.round(left)}px`;
    };

    const updateFormatBar = () => {
      if (!document.documentElement.classList.contains('is-dev-mode')) {
        hideFormatBar();
        return;
      }

      // Keep the bar while the link panel is focused / open.
      if (linkPanelOpen && savedFormatRange) {
        positionFormatBar(savedFormatRange);
        syncFormatButtons();
        return;
      }

      const selection = window.getSelection();
      if (!selection?.rangeCount || selection.isCollapsed) {
        hideFormatBar();
        return;
      }

      const range = selection.getRangeAt(0);
      if (!findParagraphState(range.commonAncestorContainer)) {
        hideFormatBar();
        return;
      }

      // Don't steal focus from the format UI itself.
      if (formatBar.contains(document.activeElement)) return;

      savedFormatRange = range.cloneRange();
      setLinkPanelOpen(false);
      positionFormatBar(savedFormatRange);
      syncFormatButtons();
    };

    const scheduleFormatBarUpdate = () => {
      cancelAnimationFrame(formatRaf);
      formatRaf = requestAnimationFrame(updateFormatBar);
    };

    const refreshFormatBarAfterCommand = () => {
      const selection = window.getSelection();
      if (!selection?.rangeCount || selection.isCollapsed) {
        hideFormatBar();
        return;
      }
      const nextRange = selection.getRangeAt(0);
      if (!findParagraphState(nextRange.commonAncestorContainer)) {
        hideFormatBar();
        return;
      }
      savedFormatRange = nextRange.cloneRange();
      setLinkPanelOpen(false);
      positionFormatBar(savedFormatRange);
      syncFormatButtons();
      // queryCommandState can lag one frame behind the DOM mutation.
      requestAnimationFrame(() => {
        if (!savedFormatRange || formatBar.hidden) return;
        syncFormatButtons();
      });
    };

    const runFormatCommand = (command: 'bold' | 'italic' | 'underline') => {
      if (!restoreFormatRange()) return;
      document.execCommand(command);
      refreshFormatBarAfterCommand();
      updateActions();
    };

    const applyLink = (href: string) => {
      const trimmed = href.trim();
      if (!SAFE_HREF.test(trimmed)) {
        linkInput.setCustomValidity('Use http(s)://, /, #, or mailto:');
        linkInput.reportValidity();
        return false;
      }
      linkInput.setCustomValidity('');
      if (!restoreFormatRange()) return false;
      document.execCommand('createLink', false, trimmed);
      // Ensure serializer-safe href on the created anchor(s).
      const selection = window.getSelection();
      if (selection?.rangeCount) {
        const range = selection.getRangeAt(0);
        const root = range.commonAncestorContainer;
        const scope = root instanceof Element ? root : root.parentElement;
        scope?.querySelectorAll('a').forEach((anchor) => {
          if (range.intersectsNode(anchor)) {
            anchor.setAttribute('href', trimmed);
          }
        });
        if (scope instanceof HTMLAnchorElement) {
          scope.setAttribute('href', trimmed);
        }
      }
      captureFormatRange();
      setLinkPanelOpen(false);
      updateActions();
      scheduleFormatBarUpdate();
      return true;
    };

    const removeLink = () => {
      if (!restoreFormatRange()) return;
      document.execCommand('unlink');
      captureFormatRange();
      setLinkPanelOpen(false);
      updateActions();
      scheduleFormatBarUpdate();
    };

    formatBar.addEventListener('mousedown', (event) => {
      // Keep the contenteditable selection when clicking toolbar chrome.
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;
      event.preventDefault();
    });

    formatButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const command = button.dataset.devFormat;
        if (!command) return;
        if (!savedFormatRange) captureFormatRange();
        if (!savedFormatRange) return;

        if (command === 'bold' || command === 'italic' || command === 'underline') {
          setLinkPanelOpen(false);
          runFormatCommand(command);
          return;
        }

        if (command === 'link') {
          if (linkPanelOpen) {
            setLinkPanelOpen(false);
            scheduleFormatBarUpdate();
            return;
          }
          setLinkPanelOpen(true);
          positionFormatBar(savedFormatRange);
          syncFormatButtons();
        }
      });
    });

    linkPanel.addEventListener('submit', (event) => {
      event.preventDefault();
      applyLink(linkInput.value);
    });

    unlinkButton.addEventListener('click', (event) => {
      event.preventDefault();
      removeLink();
    });

    linkInput.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      event.stopPropagation();
      hideFormatBar();
    });

    document.addEventListener('selectionchange', scheduleFormatBarUpdate);
    window.addEventListener('scroll', scheduleFormatBarUpdate, true);
    window.addEventListener('resize', scheduleFormatBarUpdate);
    // Dismiss even while the link URL field is focused / open.
    document.addEventListener(
      'pointerdown',
      (event) => {
        if (formatBar.hidden) return;
        const target = event.target;
        if (!(target instanceof Node) || formatBar.contains(target)) return;
        hideFormatBar();
      },
      true,
    );

    /**
     * Esc while editing body text — same outcome as click-away:
     * 1) format / link bar dismisses first
     * 2) then the caret leaves the block (chrome unsuppresses)
     * Capture + stop so DevModeController does not exit Dev Mode on the same key.
     */
    const deselectDevTextCaret = () => {
      const active = document.activeElement;
      if (!(active instanceof HTMLElement)) return false;
      // Any editing surface, not just this component's tracked body-text fields:
      // a caret in a gallery card title or an inline caption is a level to
      // escape from too, and matching only textStates left those falling through
      // to DevModeController, which exited Dev Mode outright.
      const isEditingSurface = active.isContentEditable
        || isTextEntryField(active)
        || textStates.some((state) => state.element === active || state.element.contains(active));
      if (!isEditingSurface) return false;
      // Tuner / overlay fields keep their own Esc layering.
      if (active.closest('[data-dev-panel-key], .dev-overlay')) return false;

      window.getSelection()?.removeAllRanges();
      active.blur();
      document.querySelectorAll<HTMLElement>('.is-dev-section-controls-visible').forEach((el) => {
        if (!el.matches(':hover')) el.classList.remove('is-dev-section-controls-visible');
      });
      // focusout syncs on rAF; do it now so gap/drag chrome return without a frame of lag.
      syncSpacingCaretSuppression();
      return true;
    };

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return;
        if (!document.documentElement.classList.contains('is-dev-mode')) return;

        if (!formatBar.hidden) {
          event.preventDefault();
          event.stopPropagation();
          hideFormatBar();
          return;
        }

        if (!isDevTextCaretActive()) return;
        if (!deselectDevTextCaret()) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    // ⌘B / ⌘I / ⌘U / ⌘K (link)
    document.addEventListener('keydown', (event) => {
      if (!document.documentElement.classList.contains('is-dev-mode')) return;
      if (!(event.metaKey || event.ctrlKey) || event.altKey || event.shiftKey) return;

      const key = event.key.toLowerCase();
      const formatCommand =
        key === 'b' ? 'bold'
          : key === 'i' ? 'italic'
            : key === 'u' ? 'underline'
              : null;
      const isLink = key === 'k';
      if (!formatCommand && !isLink) return;

      const active = document.activeElement;
      if (
        active instanceof HTMLInputElement
        || active instanceof HTMLTextAreaElement
        || active instanceof HTMLSelectElement
      ) {
        return;
      }

      const selection = window.getSelection();
      if (!selection?.rangeCount) return;
      const range = selection.getRangeAt(0);
      if (!findParagraphState(range.commonAncestorContainer)) return;

      if (formatCommand) {
        event.preventDefault();
        document.execCommand(formatCommand);
        // Re-read selection after execCommand — the pre-command Range can be
        // detached, which left the format bar stuck on the previous state.
        refreshFormatBarAfterCommand();
        updateActions();
        return;
      }

      const anchor = closestAnchor(range.commonAncestorContainer);
      if (range.collapsed && !anchor) return;

      event.preventDefault();
      if (range.collapsed && anchor) {
        const linkRange = document.createRange();
        linkRange.selectNodeContents(anchor);
        selection.removeAllRanges();
        selection.addRange(linkRange);
        savedFormatRange = linkRange.cloneRange();
      } else {
        savedFormatRange = range.cloneRange();
      }

      if (linkPanelOpen) {
        setLinkPanelOpen(false);
        scheduleFormatBarUpdate();
        return;
      }

      setLinkPanelOpen(true);
      if (savedFormatRange) positionFormatBar(savedFormatRange);
      syncFormatButtons();
    });

    const setEditingEnabled = (enabled: boolean) => {
      textStates.forEach(({ element, kind }) => {
        if (!enabled && document.activeElement === element) element.blur();
        if (enabled) {
          element.setAttribute('contenteditable', kind === 'paragraphs' ? 'true' : 'plaintext-only');
          element.setAttribute('spellcheck', 'true');
        } else {
          element.removeAttribute('contenteditable');
          element.removeAttribute('spellcheck');
        }
      });
      if (!enabled) closeSectionMenus();
      syncDeleteButtons(enabled);
      syncSpacingControlVisibility();
      if (!enabled) {
        spacingStates.forEach(({ control }) => clearGapProximity(control));
        document.documentElement.classList.remove('is-dev-text-caret');
        hideFormatBar();
      }
      updateActions();
    };

    window.matchMedia(SIDEBAR_TITLE_HIDDEN_MQ).addEventListener('change', syncSpacingControlVisibility);

    textStates.forEach(bindTextState);

    revertButton.addEventListener('click', () => {
      void (async () => {
        const hadDirty = hasPendingEdits();
        const hadUnpublished = unpublishedCount > 0;

        // Unsaved edits are the nearer, smaller undo, so they take the whole
        // click: reverting them AND resetting the disk to main would throw away
        // saved work nobody asked about. Only once nothing is left in memory
        // does Revert mean the on-disk unpublished content (#196).
        if (hadDirty) {
          stickyStatus = '';
          revertPendingSectionInserts();
          revertPendingSectionDeletes();
          revertDirtyEdits();
          revertAllPending();
          try {
            await revertPersistedMediaInserts();
          } catch (error) {
            setStickyStatus(error instanceof Error ? error.message : 'Could not undo image inserts.');
            actions.hidden = false;
          }
          hideFormatBar();
          updateActions();
          return;
        }

        if (hadUnpublished) {
          const n = unpublishedCount;
          const message = n === 1
            ? 'Restore 1 unpublished content file to match main? This cannot be undone. The page will reload.'
            : `Restore ${n} unpublished content files to match main? This cannot be undone. The page will reload.`;
          if (!window.confirm(message)) return;
        }

        stickyStatus = '';

        if (hadUnpublished) {
          try {
            const response = await fetch('/api/content-revert', { method: 'POST' });
            const payload = await readApiJson(response);
            if (!response.ok) {
              throw new Error(String(payload.error || 'Could not revert unpublished content.'));
            }
            window.location.reload();
            return;
          } catch (error) {
            setStickyStatus(error instanceof Error ? error.message : 'Could not revert unpublished content.');
            actions.hidden = false;
            void refreshPublishState();
            return;
          }
        }

        hideFormatBar();
        updateActions();
      })();
    });

    /**
     * What was in this save, described semantically. The JSON diff is mostly
     * noise (a reordered section rewrites hundreds of lines); this is what the
     * publish route hands to the model that writes the commit subject.
     */
    type PublishManifest = {
      documents: string[];
      changes: Record<string, number>;
      textPaths: string[];
    };

    /**
     * Vite only registers `configureServer` middleware on process start. After a
     * branch pull, client HMR can call a new `/api/…` path the running server
     * never mounted — Astro then returns HTML and `response.json()` throws a
     * cryptic JSON.parse error. Surface a restart hint instead.
     */
    const readApiJson = async (response: Response): Promise<Record<string, unknown>> => {
      const text = await response.text();
      try {
        return (text ? JSON.parse(text) : {}) as Record<string, unknown>;
      } catch {
        throw new Error(
          `Dev API returned non-JSON (HTTP ${response.status}). `
          + 'Restart the dev session (`bun run dev:session:stop`, then `bun run dev:session`) and try again.',
        );
      }
    };

    const performSave = async (): Promise<PublishManifest | null> => {
      // Editors with an explicit Apply step stage nothing until it is pressed —
      // the section nav marker popover is one. Give them the chance to land an
      // open draft before we read the pending map, or Save drops what is on screen.
      window.dispatchEvent(new Event('vcd:dev-before-save'));

      const dirtyText = dirtyTextStates();
      const dirtySpacing = dirtySpacingStates();
      const pendingChanges = [...pendingMedia.values()];
      const structuralPending = pendingSectionInserts.length + pendingSectionDeletes.length;
      const mediaInsertPending = persistedMediaInserts.length;
      const listingChanges = pendingChanges.filter((change) => change.kind === 'listing-order');
      const galleryMembershipChanges = pendingChanges.filter((change) => change.kind === 'gallery-membership');
      const projectSettingsChanges = pendingChanges.filter((change) => change.kind === 'project-settings');
      const sectionOrderChanges = pendingChanges.filter((change) => change.kind === 'section-order');
      const placeholderFills = pendingChanges.filter((change) => change.kind === 'placeholder-fill');
      const styleTokenChanges = pendingChanges.filter((change) => change.kind === 'style-token');
      const sectionNavChanges = pendingChanges.filter((change) => change.kind === 'section-nav');
      const mediaRemoveChanges = pendingChanges.filter((change) => change.kind === 'media-remove');
      const imageChanges = pendingChanges.filter(
        (change) => (
          change.kind !== 'listing-order'
          && change.kind !== 'gallery-membership'
          && change.kind !== 'section-order'
          && change.kind !== 'placeholder-fill'
          && change.kind !== 'style-token'
          && change.kind !== 'section-nav'
          && change.kind !== 'media-remove'
          && change.kind !== 'project-settings'
        ),
      );
      if (
        !dirtyText.length
        && !dirtySpacing.length
        && !pendingChanges.length
        && !structuralPending
        && !mediaInsertPending
      ) return null;

      const documents = new Set<string>();
      dirtyText.forEach((state) => documents.add(state.document));
      dirtySpacing.forEach((state) => documents.add(state.document));
      pendingChanges.forEach((change) => {
        const payload = change.payload as {
          document?: unknown;
          slug?: unknown;
          slugs?: unknown;
        } | undefined;
        const key = payload?.document ?? payload?.slug;
        if (typeof key === 'string' && key) documents.add(key);
        if (Array.isArray(payload?.slugs)) {
          for (const slug of payload.slugs) {
            if (typeof slug === 'string' && slug) documents.add(slug);
          }
        }
      });
      const manifest: PublishManifest = {
        documents: [...documents],
        changes: {
          text: dirtyText.length,
          spacing: dirtySpacing.length,
          crop: imageChanges.filter((change) => change.kind === 'crop').length,
          grid: imageChanges.filter((change) => change.kind === 'grid').length,
          carousel: imageChanges.filter((change) => change.kind === 'carousel').length,
          caption: imageChanges.filter((change) => change.kind === 'caption').length,
          mediaInsert: mediaInsertPending + placeholderFills.length,
          sectionInsert: pendingSectionInserts.length,
          sectionDelete: pendingSectionDeletes.length,
          sectionOrder: sectionOrderChanges.length,
          listingOrder: listingChanges.length,
          galleryMembership: galleryMembershipChanges.length,
          projectSettings: projectSettingsChanges.length,
          styleToken: styleTokenChanges.length,
          sectionNav: sectionNavChanges.length,
          mediaRemove: mediaRemoveChanges.length,
        },
        textPaths: dirtyText.slice(0, 8).map((state) => state.path.join('.')),
      };

      saveButton.disabled = true;
      publishButton.disabled = true;
      revertButton.disabled = true;
      actionsBusy = true;
      saveButton.classList.add('is-dev-actions-busy');
      publishButton.classList.add('is-dev-actions-busy');
      revertButton.classList.add('is-dev-actions-busy');
      setStickyStatus('Saving…');

      try {
        // Structural mutations first: client paths are already reindexed, so
        // JSON must match before text/spacing writes (otherwise Save hits
        // "editable text field no longer exists" after deleting a section).
        const insertedSections = await persistPendingSectionInserts();
        await persistPendingSectionDeletes();
        if (placeholderFills.length) {
          await persistPlaceholderFills();
        }
        // Also structural: dropping an item shortens the media array the grid and
        // carousel payloads below index into, so it has to land before them.
        for (const change of mediaRemoveChanges) {
          const response = await fetch('/api/content-section', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not remove that image.'));
        }
        // Membership before order — listing-order skips slugs that lack listings[grid].
        for (const change of galleryMembershipChanges) {
          const response = await fetch('/api/gallery-membership', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save gallery pages.');
        }

        for (const change of listingChanges) {
          const response = await fetch('/api/listing-order', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save grid order.');
        }

        for (const change of projectSettingsChanges) {
          const response = await fetch('/api/project-settings', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) {
            throw new Error(String(payload.error || 'Could not save project settings.'));
          }
        }

        for (const change of sectionNavChanges) {
          const response = await fetch('/api/content-nav', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not save the section outline.'));
        }

        for (const change of styleTokenChanges) {
          const response = await fetch('/api/style-token', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not save the colour token.'));
        }

        if (styleTokenChanges.length) {
          const response = await fetch('/api/style-token-commit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              tokens: styleTokenChanges
                .map((change) => (change.payload as { token?: unknown } | undefined)?.token)
                .filter((token): token is string => typeof token === 'string' && token.length > 0),
            }),
          });
          const payload = await readApiJson(response);
          if (!response.ok) throw new Error(String(payload.error || 'Could not commit style changes.'));
        }

        if (imageChanges.length > 0) {
          const response = await fetch('/api/content-batch', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              crops: imageChanges
                .filter((change) => change.kind === 'crop')
                .map((change) => change.payload),
              grids: imageChanges
                .filter((change) => change.kind === 'grid')
                .map((change) => change.payload),
              carousels: imageChanges
                .filter((change) => change.kind === 'carousel')
                .map((change) => change.payload),
              captions: imageChanges
                .filter((change) => change.kind === 'caption')
                .map((change) => change.payload),
              text: dirtyText.map((state) => ({
                document: state.document,
                path: state.path,
                value: readValue(state),
              })),
              spacing: dirtySpacing.map((state) => ({
                document: state.document,
                path: state.path,
                value: state.currentValue,
              })),
            }),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save changes.');
        } else {
          if (dirtyText.length) {
            const response = await fetch('/api/content-text', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                changes: dirtyText.map((state) => ({
                  document: state.document,
                  path: state.path,
                  value: readValue(state),
                })),
              }),
            });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error || 'Could not save the text.');
          }

          if (dirtySpacing.length) {
            const response = await fetch('/api/content-spacing', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                changes: dirtySpacing.map((state) => ({
                  document: state.document,
                  path: state.path,
                  value: state.currentValue,
                })),
              }),
            });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error || 'Could not save the spacing.');
          }
        }

        dirtyText.forEach((state) => {
          state.savedValue = readValue(state);
        });
        dirtySpacing.forEach((state) => {
          state.savedValue = state.currentValue;
          syncSpacingControl(state);
        });
        for (const change of sectionOrderChanges) {
          const response = await fetch('/api/content-section-order', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(change.payload),
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || 'Could not save section order.');
          const order = Array.isArray(change.payload.order)
            ? change.payload.order.map((value) => Number(value))
            : [];
          const indexMap = buildIndexMapFromOrder(order);
          remapSectionPaths(indexMap);
          remapPathsInStates(indexMap);
          resetSectionOrderIds();
        }
        syncPageTopSpacingControls();
        insertedSections.forEach(({ clientId, serverId }) => {
          remapDevSectionOutlineId(clientId, serverId);
        });
        syncSavedSectionTitleLabels(dirtyText);

        pendingMedia.clear();
        persistedMediaInserts.length = 0;
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-committed'));
        // Optimistic: keep the bar up until refreshPublishState confirms counts.
        // Without this, dirtyCount is 0 and unpublishedCount is still stale, so
        // the bar flickers hidden between Save and the /api/publish GET.
        if (manifest.documents.length) {
          unpublishedCount = Math.max(unpublishedCount, manifest.documents.length);
        }
        if (styleTokenChanges.length) {
          styleEngineDirtyCount = Math.max(styleEngineDirtyCount, 1);
        }
        setStickyStatus('Saved.');
        return manifest;
      } catch (error) {
        setStickyStatus(error instanceof Error ? error.message : 'Could not save changes.');
        return null;
      } finally {
        actionsBusy = false;
        publishButton.disabled = false;
        updateActions();
      }
    };

    saveButton.addEventListener('click', () => {
      void (async () => {
        // A successful Save turns unsaved edits into unpublished ones, so the
        // bar has to stay up — refresh the count rather than letting it hide.
        if (await performSave()) {
          void refreshPublishState();
          void refreshStyleEngineState();
        }
      })();
    });

    const refreshStyleEngineState = async () => {
      try {
        // Prefer /api/commit-engine — mounted since the first #109 server start.
        // /api/publish-styles is an alias added later; calling it after client HMR
        // without a restart 404s as HTML.
        const response = await fetch('/api/commit-engine');
        if (!response.ok) throw new Error('unavailable');
        const state = await readApiJson(response) as { files?: string[]; dirty?: boolean };
        styleEngineDirtyCount = Array.isArray(state.files) ? state.files.length : (state.dirty ? 1 : 0);
      } catch {
        // Leave the last known count — a blip shouldn't hide Publish styles.
      }
      // Hand "Saved." back to the count once we know style/engine state.
      if (stickyStatus === 'Saved.') stickyStatus = '';
      updateActions();
    };

    commitStylesButton.addEventListener('click', () => {
      void (async () => {
        actionsBusy = true;
        commitStylesButton.disabled = true;
        saveButton.disabled = true;
        publishButton.disabled = true;
        revertButton.disabled = true;
        commitStylesButton.classList.add('is-dev-actions-busy');
        setStickyStatus('Publishing styles…');
        try {
          const response = await fetch('/api/commit-engine', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              message: 'styles: update colour tokens',
            }),
          });
          const payload = await readApiJson(response);
          if (!response.ok || !payload.ok) {
            throw new Error(String(payload.error || 'Could not publish styles.'));
          }
          // Old middleware (pre-restart) only committed on the branch and had no
          // `pushed` field — don't claim the colours are on main.
          if (payload.pushed === undefined) {
            styleEngineDirtyCount = 0;
            setStickyStatus(
              'Styles committed on this branch only. Restart the dev session to publish colour tokens to main.',
            );
            return;
          }
          styleEngineDirtyCount = 0;
          setStickyStatus(payload.pushed
            ? (payload.message ? `Published styles — ${payload.message}` : 'Styles published.')
            : `Committed locally, push failed: ${payload.error}`);
        } catch (error) {
          setStickyStatus(error instanceof Error ? error.message : 'Could not publish styles.');
        } finally {
          actionsBusy = false;
          void refreshStyleEngineState();
        }
      })();
    });

    /** Rendering files on this branch, for the override confirm. Empty when safe. */
    let renderingFiles: string[] = [];

    /**
     * Save to disk, then commit the content surface to main and push. Content
     * always lands on main, but you no longer have to be standing there — from a
     * feature branch the commit is built against main and pushed, leaving this
     * checkout untouched.
     *
     * What gates Publish now is whether this branch changes content-*rendering*
     * code. If it does, the edit may depend on a feature main cannot render yet,
     * so the bar warns and Publish asks for confirmation first.
     */
    const refreshPublishState = async () => {
      try {
        const response = await fetch('/api/publish');
        if (!response.ok) throw new Error('unavailable');
        const state = await response.json() as {
          branch?: string;
          canPublish?: boolean;
          onPublishBranch?: boolean;
          rendersContent?: boolean;
          renderingFiles?: string[];
          publishBranch?: string;
          files?: string[];
          behind?: string[];
        };
        publishKnown = true;
        unpublishedCount = Array.isArray(state.files) ? state.files.length : 0;
        const behind = Array.isArray(state.behind) ? state.behind : [];
        renderingFiles = Array.isArray(state.renderingFiles) ? state.renderingFiles : [];
        const branch = state.branch || 'detached HEAD';
        const target = state.publishBranch ?? 'main';
        const onTarget = state.onPublishBranch !== false;
        publishButton.hidden = false;
        if (!actionsBusy) publishButton.disabled = false;
        branchLabel.hidden = false;
        branchLabel.textContent = branch;
        // Away from main the name steps up to full text colour — publishing still
        // works from here, but where "here" is stops being ambient information.
        branchLabel.classList.toggle('is-dev-branch-off-target', !onTarget);
        // Being behind is not something to publish — it is content someone moved
        // on main that this branch has not picked up. Say so, rather than leaving
        // the difference to be misread as an edit waiting to go out.
        const behindNote = behind.length
          ? `\n${behind.length} file${behind.length === 1 ? '' : 's'} newer on ${target} `
            + `(${behind.slice(0, 3).join(', ')}) — merge or rebase to pick ${behind.length === 1 ? 'it' : 'them'} up.`
          : '';
        branchLabel.title = (onTarget
          ? `On ${branch} — content publishes from here`
          : `On ${branch} — content publishes to ${target} without switching`) + behindNote;

        warnLabel.hidden = !state.rendersContent;
        publishButton.classList.toggle('is-dev-publish-warn', Boolean(state.rendersContent));
        if (state.rendersContent) {
          const summary = renderingFiles.slice(0, 3).join(', ')
            + (renderingFiles.length > 3 ? `, +${renderingFiles.length - 3} more` : '');
          const warning = `This branch changes how content renders (${summary}). `
            + `If this edit uses those changes, ${target} cannot render it yet.`;
          warnLabel.title = warning;
          publishButton.title = `${warning} Publish will ask you to confirm.`;
        } else {
          publishButton.title = onTarget
            ? `Save, commit, and push to ${target}`
            : `Save, commit, and push to ${target} — ${branch} stays as it is`;
        }
      } catch {
        // First failure (or never-a-git-repo): hide publish chrome. Once we've
        // successfully loaded publish state, keep the last counts so a blip
        // doesn't empty the bar the same way.
        if (!publishKnown) {
          unpublishedCount = 0;
          renderingFiles = [];
          publishButton.hidden = true;
          branchLabel.hidden = true;
          warnLabel.hidden = true;
        }
      }
      // "Saved." was only a beat confirmation — once we know the unpublished
      // count, hand the status back to the count. Leave Publish confirmations alone.
      if (stickyStatus === 'Saved.') stickyStatus = '';
      updateActions();
    };

    publishButton.addEventListener('click', () => {
      void (async () => {
        const hadUnsavedEdits = hasPendingEdits();
        const manifest = await performSave();
        // A null manifest means either nothing was dirty — the normal case for
        // content already on disk — or the save failed. Only the second should
        // stop us; performSave has already put its error in the status.
        if (hadUnsavedEdits && !manifest) return;
        if (!manifest && !unpublishedCount) return;

        saveButton.disabled = true;
        publishButton.disabled = true;
        revertButton.disabled = true;
        actionsBusy = true;
        saveButton.classList.add('is-dev-actions-busy');
        publishButton.classList.add('is-dev-actions-busy');
        revertButton.classList.add('is-dev-actions-busy');
        setStickyStatus('Publishing…');
        actions.hidden = false;

        const post = async (force: boolean) => {
          const response = await fetch('/api/publish', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ manifest, force }),
          });
          return await response.json();
        };

        try {
          let payload = await post(false);

          // The rendering-code check is branch-level on purpose, so it is coarse:
          // it knows the branch touches rendering, not whether this edit uses it.
          // Anto does, so ask him rather than making the call for him.
          if (payload.needsOverride) {
            const files: string[] = Array.isArray(payload.renderingFiles) ? payload.renderingFiles : renderingFiles;
            const confirmed = window.confirm(
              `This branch changes how content renders:\n\n${files.join('\n')}\n\n`
              + 'If this edit does not use those changes, it is safe to publish. Publish anyway?',
            );
            if (!confirmed) {
              setStickyStatus('Publish cancelled.');
              return;
            }
            payload = await post(true);
          }

          if (!payload.ok) {
            throw new Error(payload.error || 'Could not publish.');
          }
          setStickyStatus(payload.pushed
            ? `Published — ${payload.message}`
            : `Committed locally, push failed: ${payload.error}`);
          actions.hidden = false;
        } catch (error) {
          setStickyStatus(error instanceof Error ? error.message : 'Could not publish.');
          actions.hidden = false;
        } finally {
          actionsBusy = false;
          void refreshPublishState();
        }
      })();
    });

    void refreshPublishState();
    void refreshStyleEngineState();

    /**
     * For writers that legitimately go straight to disk — an asset deleted
     * forever, a cover image uploaded — there is nothing to stage and nothing to
     * revert, but the content surface has still moved. Without this the count
     * only refreshes on load and on dev-mode entry, so the bar can sit hidden
     * while unpublished content waits on disk.
     */
    window.addEventListener('vcd:dev-content-written', () => {
      void refreshPublishState();
    });

    window.addEventListener('vcd:dev-mode-change', (event) => {
      const active = Boolean((event as CustomEvent<{ active: boolean }>).detail?.active);
      setEditingEnabled(active);
      if (active) {
        void refreshPublishState();
        void refreshStyleEngineState();
      }
    });
    window.addEventListener('beforeunload', (event) => {
      if (document.documentElement.classList.contains('is-dev-crop-open')) return;
      if (devServerReloading) return;
      // Structural insert/delete is already reflected in the DOM — only warn when
      // text, spacing, or media edits would be lost (or during a dev-server reload).
      const hasContentEdits =
        dirtyTextStates().length > 0
        || dirtySpacingStates().length > 0
        || pendingMedia.size > 0;
      if (!hasContentEdits) return;
      event.preventDefault();
      event.returnValue = '';
    });

    setEditingEnabled(document.documentElement.classList.contains('is-dev-mode'));
  };

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      delete document.documentElement.dataset.devTextEditorInit;
    });
  }

  initDevTextEditor();
</script>

<style is:global>
  /*
    Hover/focus ring is a ::before layer at opacity 0 — never mount outline on the
    field itself (browsers flash real outlines for a frame). Opacity eases in on
    hover; entering/exiting gates block the ring during dev-mode transitions.
  */
  .is-dev-mode [data-dev-text-document] {
    position: relative;
    isolation: isolate;
    border-radius: 0.15em;
    cursor: text;
    outline: none;
  }

  .is-dev-mode [data-dev-text-document]::before {
    content: '';
    position: absolute;
    inset: -0.5em;
    border: 1px dashed color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 0.5em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .is-dev-mode [data-dev-text-document]::after {
    content: '';
    position: absolute;
    inset: -0.3em;
    z-index: -1;
    border-radius: 0.3em;
    background: color-mix(in srgb, currentColor 10%, var(--sys-color-srf-container-low));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  html.is-dev-mode:not(.is-dev-mode-entering):not(.is-dev-mode-exiting):not(.is-dev-mode-settling)
    [data-dev-text-document]:is(:hover, :focus)::before {
    opacity: 1;
  }

  html.is-dev-mode:not(.is-dev-mode-entering):not(.is-dev-mode-exiting):not(.is-dev-mode-settling)
    [data-dev-text-document]:is(:focus, .is-dev-text-dirty:hover)::before {
    border-color: color-mix(in srgb, currentColor 45%, transparent);
  }

  /*
    Adaptive edit wash: tint toward the field’s own text color so focus/dirty
    stays readable on light page copy and dark embeds (e.g. Reddit comments).
    Dirty + unfocused: wash only — a persistent dashed ring reads as a
    tiny “grid” chrome icon at the top-left corner after click-away.
  */
  html.is-dev-mode:not(.is-dev-mode-entering):not(.is-dev-mode-exiting):not(.is-dev-mode-settling)
    [data-dev-text-document]:is(:focus, .is-dev-text-dirty)::after {
    opacity: 1;
  }

  /*
    Outer keeps the box-shadow; the split exists only so the shadow isn't
    clipped by the bar's own overflow: hidden. The signed bar is a flat solid
    surface, not a blurred one — no backdrop-filter, no squircle.
  */
  .dev-text-actions {
    position: fixed;
    right: max(1em, env(safe-area-inset-right));
    bottom: max(1em, env(safe-area-inset-bottom));
    z-index: 90;
    border-radius: 12px;
    background: transparent;
    padding: 0;
    box-shadow: 0 7px 19px rgb(0 0 0 / 0.08);
  }

  .dev-text-actions__surface {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    overflow: hidden;
    border-radius: 12px; /* literal in Figma; no radius token covers 12px */
    border: 1px solid var(--sys-color-srf-container-low); /* Figma button/toolbars/save-bar-outline #f5f5f7 — no source token */
    background: var(--sys-color-srf);
  }

  .dev-text-actions[hidden] {
    display: none;
  }

  .dev-text-actions__status {
    padding-inline: 7px;
    color: var(--sys-color-on-srf-variant);
    font: 400 12px/normal var(--font-sans);
    white-space: nowrap;
  }

  .dev-text-actions__branch {
    max-width: 12em;
    overflow: hidden;
    border-left: 1px solid var(--sys-color-outline-variant);
    padding-inline: 10px 7px;
    color: var(--sys-color-on-srf-variant);
    font: 400 12px/normal var(--font-sans);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Idle: no Status text to separate from, so the rule clears. */
  .dev-text-actions__surface:has(.dev-text-actions__status:empty) .dev-text-actions__branch {
    border-left: 0;
  }

  .dev-text-actions__branch[hidden] {
    display: none;
  }

  .dev-text-actions__branch.is-dev-branch-off-target {
    color: var(--sys-color-on-srf);
  }

  /* The one colour in dev chrome. Everything else here is monochrome, so amber
     on a single icon is enough to read as a warning without a palette token. */
  .dev-text-actions__warn {
    display: inline-flex;
    align-items: center;
    padding-left: 8px;
    color: #b26a00;
    line-height: 1;
    cursor: help;
  }

  .dev-text-actions__warn svg {
    display: block;
  }

  .dev-text-actions__warn[hidden] {
    display: none;
  }

  .dev-text-actions button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: var(--dev-control-min-width);
    min-height: var(--dev-control-height);
    border: 0;
    border-radius: var(--dev-radius-control);
    background: var(--comp-button-ghost-container);
    padding: 8px;
    color: var(--comp-button-label);
    font: var(--dev-text-label);
    cursor: pointer;
  }

  .dev-text-actions button:hover {
    background: var(--comp-button-ghost-container-hover);
  }

  .dev-text-actions button:active {
    background: var(--comp-button-ghost-container-pressed);
  }

  .dev-text-actions button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .dev-text-actions button.is-dev-actions-busy:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .dev-text-actions [data-dev-text-commit-styles] {
    background: var(--comp-button-soft-container);
  }

  .dev-text-actions [data-dev-text-commit-styles]:hover {
    background: var(--comp-button-soft-container-hover);
  }

  .dev-text-actions [data-dev-text-commit-styles]:active {
    background: var(--comp-button-soft-container-pressed);
  }

  .dev-text-actions .dev-text-actions__save {
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
  }

  .dev-text-actions .dev-text-actions__save:hover:not(:disabled),
  .dev-text-actions .dev-text-actions__save:active:not(:disabled) {
    background: var(--comp-button-filled-container-hover);
  }

  /* Publish only disables while a publish is in flight. */
  .dev-text-actions .dev-text-actions__save:disabled {
    cursor: default;
  }

  .dev-text-actions .dev-text-actions__save.is-dev-actions-busy:disabled {
    cursor: wait;
  }

  /* Rendering code changed on this branch: Publish steps down to Soft, not
     filled and not ringed — a plain surface, still clickable, still asks for
     confirmation. */
  .dev-text-actions .dev-text-actions__save.is-dev-publish-warn {
    background: var(--comp-button-soft-container);
    color: var(--comp-button-label);
  }

  .dev-text-actions .dev-text-actions__save.is-dev-publish-warn:hover:not(:disabled),
  .dev-text-actions .dev-text-actions__save.is-dev-publish-warn:active:not(:disabled) {
    background: var(--comp-button-soft-container-hover);
  }

  /* ── Selection formatting popup ───────────────────────── */
  .dev-text-format {
    position: fixed;
    z-index: 95;
    border-radius: 12px;
    background: transparent;
    padding: 0;
    box-shadow: 0 7px 9.5px rgb(0 0 0 / 0.08);
  }

  .dev-text-format[hidden] {
    display: none;
  }

  .dev-text-format__surface {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
    border-radius: 12px;
    border: 1px solid var(--sys-color-srf-container-low);
    background: var(--sys-color-srf);
  }

  /* Keep the URL field on the side away from the selection. */
  .dev-text-format[data-placement='above'] .dev-text-format__surface {
    flex-direction: column-reverse;
  }

  .dev-text-format[data-placement='below'] .dev-text-format__surface {
    flex-direction: column;
  }

  .dev-text-format__buttons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .dev-text-format__buttons button {
    padding: 8px;
    gap: 8px;
    border-radius: var(--dev-radius-control);
    border: 0;
    min-width: 0;
    background: var(--comp-button-ghost-container);
    color: var(--comp-button-label);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .dev-text-format__buttons button:hover {
    background: var(--comp-button-ghost-container-hover);
  }

  .dev-text-format__buttons button:active {
    background: var(--comp-button-ghost-container-pressed);
  }

  /* Divergence: Figma's Ghost/Selected variant binds button/ghost/container
     (transparent) with a ~16% paint opacity that has no exported token, and
     at 32px on a white bar would not read as "on" — so active borrows the
     Filled tokens instead of the signed Ghost/Selected treatment. */
  .dev-text-format__buttons button.is-active {
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
  }

  .dev-text-format__icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
  }

  .dev-text-format__icon :global(svg) {
