  .dev-text-format__link input {
    width: 180px;
    max-width: min(180px, 55vw);
    padding: 8px;
    border: 0;
    border-radius: var(--dev-radius-control);
    background: var(--comp-field-container);
    color: var(--sys-color-on-srf);
    font: var(--dev-text-label);
  }

  .dev-text-format__link input:focus {
    outline: 1px solid color-mix(in srgb, var(--sys-color-on-srf-variant) 70%, transparent);
    outline-offset: 0;
  }

  .dev-text-format__link button {
    padding: 8px;
    border: 0;
    border-radius: var(--dev-radius-control);
