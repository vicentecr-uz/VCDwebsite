---
import DevOverlay from './DevOverlay.astro';
---

<DevOverlay
  title="Edit colour token"
  storageKey="style-color-token"
  panelKey="style-color-token"
  defaultHidden
>
  <div class="color-token-editor" data-color-token-editor>
    <p class="color-token-editor__name" data-token-name>Choose a colour token</p>

    <label class="color-token-editor__field">
      <span>Hex</span>
      <div class="color-token-editor__hex-row">
        <input
          type="text"
          class="color-token-editor__input"
          inputmode="text"
          maxlength="7"
          autocomplete="off"
          spellcheck="false"
          data-token-hex
        />
        <button
          type="button"
          class="color-token-editor__swatch"
          aria-label="Open colour picker"
          data-token-swatch
        ></button>
      </div>
    </label>

    <div class="color-token-editor__actions">
      <button type="button" data-token-done>Done</button>
      <button type="button" data-token-revert>Revert changes</button>
    </div>

    <p class="color-token-editor__status" data-token-status aria-live="polite">
      Changes preview live — use Save in the page bar to write.
    </p>

    <color-picker
      data-token-picker
      label-title="Colour"
      label-hue="Hue"
      label-saturation="Saturation"
      label-lightness="Lightness"
      label-opacity="Opacity"
      label-ok="Done"
    ></color-picker>
  </div>
</DevOverlay>

<script>
  import 'color-dialog-box';

  type ColorPickerElement = HTMLElement & {
    getAttribute(name: string): string | null;
    setAttribute(name: string, value: string): void;
    removeAttribute(name: string): void;
  };

  const initColorTokenEditor = (editor: HTMLElement) => {
    if (editor.dataset.initialized === 'true') return;
    editor.dataset.initialized = 'true';

    const name = editor.querySelector<HTMLElement>('[data-token-name]');
    const hexInput = editor.querySelector<HTMLInputElement>('[data-token-hex]');
    const swatch = editor.querySelector<HTMLButtonElement>('[data-token-swatch]');
    const picker = editor.querySelector<ColorPickerElement>('[data-token-picker]');
    const doneButton = editor.querySelector<HTMLButtonElement>('[data-token-done]');
    const revertButton = editor.querySelector<HTMLButtonElement>('[data-token-revert]');
    const status = editor.querySelector<HTMLElement>('[data-token-status]');
    const panel = editor.closest<HTMLElement>('[data-dev-overlay]');
    if (!name || !hexInput || !swatch || !picker || !doneButton || !revertButton || !status) {
      return;
    }

    const root = document.documentElement;
    let activeTrigger: HTMLButtonElement | null = null;
    let activeToken = '';
    let savedValue = '';
    let syncingField = false;

    const pendingIdFor = (token: string) => `style-token:${token}`;

    const normalizeHex = (raw: string) => {
      const value = raw.trim().startsWith('#') ? raw.trim() : `#${raw.trim()}`;
      const short = /^#([0-9a-f]{3})$/i.exec(value);
      if (short) {
        return `#${[...short[1]].map((digit) => digit.repeat(2)).join('')}`.toLowerCase();
      }
      const long = /^#([0-9a-f]{6})([0-9a-f]{2})?$/i.exec(value);
      return long ? `#${long[1].toLowerCase()}` : null;
    };

    const toPickerHex = (hex: string) => `${hex}ff`;

    const syncHexField = (value: string) => {
      syncingField = true;
      hexInput.value = value;
      swatch.style.background = value;
      syncingField = false;
    };

    const applyPreview = (token: string, value: string) => {
      root.style.setProperty(token, value);
      if (activeTrigger?.dataset.colorTokenName === token) {
        activeTrigger.dataset.colorTokenValue = value;
        activeTrigger.style.background = value;
        activeTrigger
          .closest<HTMLElement>('.token-card')
          ?.querySelector<HTMLElement>('[data-token-value]')
          ?.replaceChildren(value);
      }
    };

    const syncPending = (token: string, value: string, baseline: string) => {
      const id = pendingIdFor(token);
      if (value === baseline) {
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id } }));
        return;
      }
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id,
          kind: 'style-token',
          payload: { token, value },
          revert: () => {
            applyPreview(token, baseline);
            if (activeToken === token) {
              savedValue = baseline;
              syncHexField(baseline);
              picker.setAttribute('hex', toPickerHex(baseline));
              status.textContent = 'Reverted to the last saved colour.';
            }
          },
        },
      }));
    };

    /** Live-preview a colour. Pass rewriteField=false while the user is typing hex. */
    const preview = (value: string, rewriteField = true) => {
      if (!activeToken) return;
      applyPreview(activeToken, value);
      swatch.style.background = value;
      if (rewriteField) syncHexField(value);
      syncPending(activeToken, value, savedValue);
      status.textContent = value === savedValue
        ? 'Changes preview live — use Save in the page bar to write.'
        : 'Unsaved — use Save in the page bar to write.';
    };

    const openPicker = (hex: string) => {
      picker.setAttribute('hex', toPickerHex(hex));
      if (picker.getAttribute('open') === 'true') {
        picker.removeAttribute('open');
      }
      picker.setAttribute('open', 'true');
    };

    window.addEventListener('vcd:dev-edit-open', ((event: CustomEvent) => {
      const openPanel = event.detail?.panel as HTMLElement | undefined;
      const trigger = event.detail?.trigger as HTMLButtonElement | undefined;
      if (openPanel?.dataset.devPanelKey !== 'style-color-token' || !trigger) return;

      const token = trigger.dataset.colorTokenName;
      const fallback = normalizeHex(trigger.dataset.colorTokenSavedValue || '');
      const current = normalizeHex(getComputedStyle(root).getPropertyValue(token || ''));
      if (!token || !fallback || !current) return;

      activeTrigger = trigger;
      activeToken = token;
      savedValue = fallback;
      name.textContent = token;
      syncHexField(current);
      picker.setAttribute('hex', toPickerHex(current));
      status.textContent = current === savedValue
        ? 'Changes preview live — use Save in the page bar to write.'
        : 'Unsaved — use Save in the page bar to write.';
      if (current !== savedValue) syncPending(token, current, savedValue);
    }) as EventListener);

    window.addEventListener('vcd:dev-pending-committed', () => {
      if (!activeToken || !activeTrigger) return;
      const live = normalizeHex(getComputedStyle(root).getPropertyValue(activeToken));
      if (!live) return;
      savedValue = live;
      activeTrigger.dataset.colorTokenSavedValue = live;
      activeTrigger.dataset.colorTokenValue = live;
      status.textContent = 'Saved — commit styles from the page bar when ready.';
    });

    hexInput.addEventListener('input', () => {
      if (syncingField) return;
      const value = normalizeHex(hexInput.value);
      if (!value) {
        status.textContent = 'Enter a 3- or 6-digit hex colour.';
        return;
      }
      // Don't rewrite the input while typing — that resets the caret.
      preview(value, false);
      picker.setAttribute('hex', toPickerHex(value));
    });

    hexInput.addEventListener('blur', () => {
      const value = normalizeHex(hexInput.value);
      if (!value) return;
      syncHexField(value);
      picker.setAttribute('hex', toPickerHex(value));
    });

    swatch.addEventListener('click', () => {
      const value = normalizeHex(hexInput.value) || savedValue;
      if (!value) {
        status.textContent = 'Enter a valid hex colour first.';
        return;
      }
      openPicker(value);
    });

    picker.addEventListener('update-color', ((event: CustomEvent<{ hex?: string }>) => {
      const value = normalizeHex(event.detail?.hex || '');
      if (!value) return;
      preview(value);
    }) as EventListener);

    revertButton.addEventListener('click', () => {
      if (!activeToken || !savedValue) return;
      preview(savedValue);
      picker.setAttribute('hex', toPickerHex(savedValue));
      status.textContent = 'Reverted to the last saved colour.';
    });

    doneButton.addEventListener('click', () => {
      if (panel) panel.hidden = true;
    });
  };

  document.querySelectorAll<HTMLElement>('[data-color-token-editor]').forEach(initColorTokenEditor);
</script>

<style>
  .color-token-editor {
    display: flex;
    flex-direction: column;
    gap: 0.65em;
  }

  .color-token-editor__name {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
  }

  .color-token-editor__field {
    display: grid;
    grid-template-columns: 4em 1fr;
    align-items: center;
    gap: 0.65em;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .color-token-editor__hex-row {
    display: grid;
    grid-template-columns: 1fr 2.4em;
    gap: 0.4em;
    align-items: center;
  }

  .color-token-editor__field input {
    width: 100%;
    min-height: 2.4em;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-surface-strong);
    color: var(--color-text);
    font: inherit;
  }

  .color-token-editor__input {
    padding: 0.5em 0.65em;
    font-family: ui-monospace, monospace;
  }

  .color-token-editor__swatch {
    width: 2.4em;
    height: 2.4em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface-strong);
    padding: 0;
    cursor: pointer;
  }

  .color-token-editor__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4em;
  }

  .color-token-editor__actions button {
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-surface-strong);
    padding: 0.55em;
    color: var(--color-text);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .color-token-editor__actions button:first-child {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .color-token-editor__actions button:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .color-token-editor__status {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  color-picker {
    --font: var(--font-sans);
    --bg-primary: var(--color-bg);
    --bg-secondary: var(--color-surface-soft);
    --bg-header: var(--color-surface-strong);
    --border-color-primary: var(--color-border);
    --border-color-secondary: var(--color-text);
    --txt-color-primary: var(--color-text);
  }
</style>
