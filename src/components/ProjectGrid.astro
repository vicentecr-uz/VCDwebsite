---
import type { ProjectStatus } from '../lib/projects';
import type { ImageVariants } from '../lib/responsiveImage';
import { EMPTY_COVER_FILL } from '../lib/placeholderCover.mjs';
import { PLACEHOLDER_IMAGE_VARIANTS } from '../lib/projectImageDefaults';
import ProjectGridItem from './ProjectGridItem.astro';
import '../styles/project.css';

export type ProjectGridItem = {
  title: string;
  image: string;
  hoverImage?: string;
  /** Title-region light/dark for `hoverImage`. Absent falls back to `dark`. */
  hoverDark?: boolean;
  bg: string;
  dark: boolean;
  /** Year on home/work; optional meta line on play. */
  subtitle?: string;
  href?: string;
  /** Span both columns on home/work. */
  full?: boolean;
  slug?: string;
  status?: ProjectStatus;
  teaser?: boolean;
  teaserLabel?: string;
  variants?: ImageVariants;
  hoverVariants?: ImageVariants;
  srcWidth?: number;
  srcHeight?: number;
  mobileInset?: boolean;
};

interface Props {
  items: ProjectGridItem[];
  /** Layout + motion preset — home, work, and play differ at tablet breakpoints. */
  variant?: 'home' | 'work' | 'play';
}

const { items, variant = 'work' } = Astro.props;
const isDev = import.meta.env.DEV;

/** Dev-only seed for Gallery Manager `buildGridCard` template clone. */
const gridCardTemplateSeed: ProjectGridItem = {
  title: '',
  image: '',
  bg: EMPTY_COVER_FILL,
  dark: true,
  slug: '__template__',
  status: 'draft',
  subtitle: '',
  variants: PLACEHOLDER_IMAGE_VARIANTS,
  href: '/__template__',
};
---

<ul class:list={['project-grid', `project-grid--${variant}`]} data-dev-project-grid={variant}>
  {items.map((item) => (
    <ProjectGridItem item={item} variant={variant} />
  ))}
  {isDev && (
    <template data-dev-grid-card-template>
      <ProjectGridItem item={gridCardTemplateSeed} variant={variant} />
    </template>
  )}
  {isDev && (
    <li class="project-grid__item project-grid__item--new">
      <button type="button" class="project-grid__new-page" data-dev-project-new>
        + New page
      </button>
    </li>
  )}
</ul>
{/*
  Card markup lives in ProjectGridItem.astro (loop + Gallery Manager template).
  Astro scoped CSS would pin selectors to this file's data-astro-cid, which the
  child never carries — covers lose aspect-ratio, meta loses padding, items lose
  position:relative (chips mis-anchor). Keep this block global; BEM is namespaced.
*/}
<style is:global>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-unit);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-grid__item {
    position: relative;
  }

  .project-grid__item--full {
    grid-column: span 2;
  }

  @media (max-width: 40em) {
    .project-grid {
      width: calc(100% + 2 * var(--page-gutter));
      margin-inline: calc(-1 * var(--page-gutter));
    }

    .project-grid--home .project-grid__item[data-mobile-inset='true'][data-mobile-bleed-eligible='true'] .project-grid__cover {
      width: calc(100% - 2 * var(--page-gutter));
      margin-inline: auto;
    }

    .project-grid--home .project-grid__item[data-mobile-bleed-eligible='true']:not([data-mobile-inset='true']) .project-grid__meta {
      padding: var(--page-gutter);
    }
  }

  @media (max-width: 480px) {
    .project-grid--work .project-grid__item[data-mobile-inset='true'][data-mobile-bleed-eligible='true'] .project-grid__cover,
    .project-grid--play .project-grid__item[data-mobile-inset='true'][data-mobile-bleed-eligible='true'] .project-grid__cover {
      width: calc(100% - 2 * var(--page-gutter));
      margin-inline: auto;
    }

    .project-grid--work .project-grid__item[data-mobile-bleed-eligible='true']:not([data-mobile-inset='true']) .project-grid__meta,
    .project-grid--play .project-grid__item[data-mobile-bleed-eligible='true']:not([data-mobile-inset='true']) .project-grid__meta {
      padding: var(--page-gutter);
    }
  }

  .project-grid--home .project-grid__item--full .project-grid__cover:not(.project-cropped) {
    aspect-ratio: 16 / 12;
  }

  .project-grid--work .project-grid__item--full .project-grid__cover:not(.project-cropped) {
    aspect-ratio: 16 / 9;
  }

  .project-grid__item--full .project-grid__cover:not(.project-cropped) .project-grid__img {
    object-position: center center;
  }

  .project-grid__cover {
    aspect-ratio: 4 / 3;
    transform: translateZ(0);
    /* Cropped covers omit Tailwind overflow-hidden (clip lives on
       .project-crop-clip). Safari still paints a 1px idle hover-bitmap
       sliver at the frame edge unless this layer clips too. Crop-stage
       host already overrides to visible. */
    overflow: hidden;
  }

  .project-grid__cover.project-cropped {
    aspect-ratio: var(--project-image-ratio);
  }

  .project-grid__stack {
    position: absolute;
    inset: 0;
  }

  .project-grid__stack .project-grid__img {
    position: absolute;
    /* 1px bleed past the frame: WebKit (iOS) rasterizes the bitmap layer a
       hair short of fractional-sized frames, exposing the cover's bg as a
       seam under the image (T4). overflow:hidden on the cover clips the extra.
       Cropped covers override all four offsets via higher-specificity rules.
       max-width:none defeats Tailwind preflight's img{max-width:100%}, which
       would clamp the horizontal bleed and re-open the seam on the right. */
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    max-width: none;
    object-fit: cover;
  }

  /* Composite the bitmap and its opaque backing before fading, so the cover
     is replaced once rather than obscured by two independently fading layers. */
  .project-grid__hover-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--project-grid-background);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }

  html.is-dev-mode .project-grid__cover:not(.project-grid__cover--has-hover) .project-grid__img--base {
    transition: opacity 0.2s ease;
  }

  html.is-dev-mode .project-grid__cover.is-dev-hover-forced.project-grid__cover--has-hover
    .project-grid__hover-layer {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.2s ease, visibility 0s;
  }

  /*
    Live-site pointer / keyboard hover. Coarse pointers omit :hover so a tap
    does not stick (#132). Edit uses the chip above, not :hover — crossing
    the gap to the crop tuner must not swap the bitmap.
  */
  @media (hover: hover) and (pointer: fine) {
    html:not(.is-dev-mode) .project-grid__card:hover .project-grid__cover--has-hover
      .project-grid__hover-layer {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.2s ease, visibility 0s;
    }
  }

  html:not(.is-dev-mode) .project-grid__card:focus-visible .project-grid__cover--has-hover
    .project-grid__hover-layer {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.2s ease, visibility 0s;
  }

  @media (hover: none) and (pointer: coarse) {
    /* Keep the transparent layer composited before touch so its first fade
       does not also have to make a hidden bitmap renderable. */
    .project-grid__hover-layer {
      visibility: visible;
      will-change: opacity;
      transition: opacity 0.2s ease;
    }

    html:not(.is-dev-mode) .project-grid__cover.is-mobile-preview.project-grid__cover--has-hover
      .project-grid__hover-layer {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.2s ease, visibility 0s;
    }

    html:not(.is-dev-mode) .project-grid__cover.is-mobile-preview .project-grid__title {
      color: var(--title-ink-hover);
    }

    html:not(.is-dev-mode) .project-grid__cover.is-mobile-preview .project-grid__subtitle,
    html:not(.is-dev-mode) .project-grid__cover.is-mobile-preview .project-grid__teaser-label {
      color: var(--subtitle-ink-hover);
    }
  }

  /* No hover image: forced preview still reveals the page ground. With a
     hover image the cover stays put underneath the overlay above. */
  .project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__img--base {
    opacity: 0;
  }

  .project-grid__title,
  .project-grid__subtitle,
  .project-grid__teaser-label {
    font-size: var(--text-grid-title-size);
    letter-spacing: var(--text-grid-title-tracking);
    line-height: var(--text-grid-title-leading);
    /* Keep the one-unit bottom inset measured from the shared alphabetic baseline. */
    text-box-trim: trim-end;
    text-box-edge: cap alphabetic;
    text-box: trim-end cap alphabetic;
    /* Colour crossfades ride the registered custom properties, in sync with
       the hover bitmap's 0.2s opacity fade. Never `transition: color` here —
       Chrome sticks the computed colour when only the var() input changes
       (#325). */
    transition:
      --title-ink 0.2s ease,
      --subtitle-ink 0.2s ease,
      --title-ink-hover 0.2s ease,
      --subtitle-ink-hover 0.2s ease;
  }

  /*
    Unscoped (this block is is:global). JS-created subtitle hosts from
    ensureSubtitleHost must still receive colour — do not re-scope these.
  */
  .project-grid__title {
    color: var(--title-ink);
  }

  .project-grid__subtitle {
    font-weight: var(--text-grid-title-weight);
  }

  .project-grid__subtitle,
  .project-grid__teaser-label {
    color: var(--subtitle-ink);
  }

  /* Ink follows the same gate as the overlay: chip in Edit, pointer/keyboard live. */
  .project-grid__cover.is-dev-hover-forced .project-grid__title {
    color: var(--title-ink-hover);
  }

  html:not(.is-dev-mode) .project-grid__card:focus-visible .project-grid__cover--has-hover .project-grid__title {
    color: var(--title-ink-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    html:not(.is-dev-mode) .project-grid__card:hover .project-grid__cover--has-hover .project-grid__title {
      color: var(--title-ink-hover);
    }
  }

  /*
    Hover forced on a card with *no* hover image: the base fades out and the
    page background is the ground, so both the ink and the chips below switch
    to their on-light values. Without this a dark-cover card goes white-on-
    white the moment you press the preview chip.
  */
  .project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__title {
    color: var(--title-ink-on-page);
  }

  .project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__subtitle,
  .project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__teaser-label {
    color: var(--subtitle-ink-on-page);
  }

  .project-grid__cover.is-dev-hover-forced .project-grid__subtitle,
  .project-grid__cover.is-dev-hover-forced .project-grid__teaser-label {
    color: var(--subtitle-ink-hover);
  }

  html:not(.is-dev-mode) .project-grid__card:focus-visible .project-grid__cover--has-hover .project-grid__subtitle,
  html:not(.is-dev-mode) .project-grid__card:focus-visible .project-grid__cover--has-hover .project-grid__teaser-label {
    color: var(--subtitle-ink-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    html:not(.is-dev-mode) .project-grid__card:hover .project-grid__cover--has-hover .project-grid__subtitle,
    html:not(.is-dev-mode) .project-grid__card:hover .project-grid__cover--has-hover .project-grid__teaser-label {
      color: var(--subtitle-ink-hover);
    }
  }

  .project-grid__meta {
    /* Above cover-drop wash / crossfade overlay so the title doesn’t pop in at the end. */
    z-index: 5;
    opacity: 0;
    padding: var(--space-unit);
    transition: opacity 0.3s ease;
  }

  .project-grid__card:hover .project-grid__meta,
  .project-grid__card:focus-visible .project-grid__meta {
    opacity: 1;
  }

  .project-grid__card--placeholder,
  .project-grid__card--teaser {
    cursor: not-allowed;
  }

  .project-grid__card--placeholder .project-grid__img {
    filter: grayscale(1);
  }

  .project-grid__card--teaser .project-grid__meta,
  .project-grid__card--placeholder .project-grid__meta {
    opacity: 1;
  }

  .project-grid__status-wrap {
    position: relative;
  }

  /* Cover quick actions share the adaptive surface palette; hover adds emphasis. */
  .project-grid__chip {
    display: grid;
    place-items: center;
    width: auto;
    height: auto;
    min-width: 0;
    padding: 0.45em 0.55em;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--chip-contrast-fill, rgb(255 255 255 / 0.08));
    color: var(--chip-ink);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: none;
    backdrop-filter: blur(8px) brightness(var(--chip-rest-brightness, 1.06));
    text-decoration: none;
    /* opacity here matters even though the resting state is always opacity: 1 —
       the transition shorthand replaces the whole list, not merges it. The
       suppress rules below declare their own `transition: opacity …` while
       active, which covers the fade OUT; the instant this chip falls back to
       this base rule, THIS list is what governs the fade back IN, and without
       an opacity entry here that transition is dropped and it snaps to 1. */
    transition:
      background-color 0.15s ease,
      backdrop-filter 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease,
      --chip-ink 0.15s ease,
      opacity var(--dev-suppress-duration) ease;
  }

  .project-grid__chip[data-dev-project-settings] {
    padding: 0.45em 0.65em;
  }

  .project-grid__chip-icon {
    display: grid;
    place-items: center;
    line-height: 0;
    pointer-events: none;
  }

  .project-grid__chip:hover,
  .project-grid__chip:focus-visible,
  .project-grid__chip[aria-pressed='true'],
  .project-grid__chip[aria-expanded='true'] {
    background: var(--chip-hover-contrast-fill, rgb(255 255 255 / 0.08));
    box-shadow: inset 0 0 0 1px var(--chip-hover-ring, rgb(255 255 255 / 0.12));
    backdrop-filter: blur(8px) brightness(var(--chip-hover-brightness, 1.12));
    transform: scale(1.08);
    color: var(--chip-ink);
  }

  /*
    Pressed and latched promote to --chip-press (darker than the ring on dark;
    on light the press fill darkens while the ring stays). These selectors must
    stay *after* the hover group — a latched chip is also hovered, and the last
    equal-specificity rule wins.
  */
  .project-grid__chip:active,
  .project-grid__chip[aria-pressed='true'],
  .project-grid__chip[aria-expanded='true'] {
    background: var(--chip-press);
    box-shadow: inset 0 0 0 1px var(--chip-ring);
    backdrop-filter: blur(8px);
    color: var(--chip-ink);
  }

  .project-grid__status-menu {
    --status-menu-pad: 0.35em;
    position: absolute;
    top: 0;
    left: calc(100% + 0.35em);
    display: grid;
    gap: 0.15em;
    min-width: 7.5em;
    padding: var(--status-menu-pad);
    border-radius: var(--radius-control);
    /* Same page surface as crop/grid tuner overlays — tracks --sys-color-srf. */
    background: var(--sys-color-srf);
    box-shadow: 0 0.25em 0.8em rgb(0 0 0 / 0.12);
  }

  .project-grid__status-menu button {
    padding: 0.35em 0.55em;
    border: 0;
    /* Concentric with the menu card: outer radius − padding. */
    border-radius: calc(var(--radius-control) - var(--status-menu-pad));
    background: transparent;
    color: var(--sys-color-on-srf);
    font: inherit;
    font-size: 0.75rem;
    text-align: left;
    cursor: pointer;
  }

  .project-grid__status-menu button:hover,
  .project-grid__status-menu button[aria-selected='true'] {
    background: var(--sys-color-srf-container);
  }

  .project-grid__new-page {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    padding: 1em;
    border: 1px dashed var(--ref-palette-grey-600);
    border-radius: 0;
    background: transparent;
    color: var(--ref-palette-grey-500);
    font: inherit;
    font-size: 1rem;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .project-grid__new-page:hover {
    border-color: var(--ref-palette-grey-400);
    color: var(--ref-palette-grey-300);
  }

  .project-grid--home .project-grid__item--new .project-grid__new-page {
    aspect-ratio: 4 / 3;
  }

  .project-grid--work .project-grid__item--new .project-grid__new-page,
  .project-grid--play .project-grid__item--new .project-grid__new-page {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 667px) {
    .project-grid--work .project-grid__item--new .project-grid__new-page,
    .project-grid--play .project-grid__item--new .project-grid__new-page {
      aspect-ratio: 1 / 1;
    }
  }

  @media (max-width: 768px) {
    /* Titles always on below tablet. Hover image swap is pointer-gated
       (`hover` + `pointer: fine`), not width-gated — a narrow desktop
       window still fades; phones do not sticky-hover after tap (#132). */
    .project-grid__meta {
      opacity: 1 !important;
      transition: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-grid__meta,
    .project-grid__title,
    .project-grid__subtitle,
    .project-grid__teaser-label {
      transition: none;
    }
  }

  @media (max-width: 667px) {
    .project-grid--home {
      grid-template-columns: 1fr;
    }

    .project-grid--home .project-grid__item--full {
      grid-column: span 1;
    }

    .project-grid--work .project-grid__item--full,
    .project-grid--play .project-grid__cover:not(.project-cropped),
    .project-grid--work .project-grid__cover:not(.project-cropped),
    .project-grid--work .project-grid__item--full .project-grid__cover:not(.project-cropped) {
      aspect-ratio: 1 / 1;
    }

    .project-grid--work .project-grid__item--full {
      grid-column: span 1;
    }

    .project-grid--play .project-grid__item--full {
      grid-column: span 1;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-grid--home .project-grid__cover:not(.project-cropped),
    .project-grid--home .project-grid__item--full .project-grid__cover:not(.project-cropped) {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<style is:global>
  /*
    Chip rails must be global — listing pages never import project.css, and
    Astro-scoped BEM modifiers were not pinning --start left (both rails
    stacked on the static position / right).
  */

  /*
    Drafts and the + New page cell are DEV-DOM only, but View must not show
    them. Match the Edit chrome fade (0.28s); drop out of the grid after exit.
    (New page used to toggle [hidden] immediately via data-dev-mode-only.)
  */
  .project-grid__item[data-dev-status='draft'],
  .project-grid__item--new {
    display: none;
  }

  html.is-dev-mode .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode .project-grid__item--new,
  html.is-dev-mode-exiting .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode-exiting .project-grid__item--new {
    display: revert;
    opacity: 1;
    transition: opacity 0.28s ease;
  }

  html.is-dev-mode-entering .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode-entering .project-grid__item--new,
  html.is-dev-mode-exiting .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode-exiting .project-grid__item--new {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-dev-mode .project-grid__item[data-dev-status='draft'],
    html.is-dev-mode .project-grid__item--new,
    html.is-dev-mode-exiting .project-grid__item[data-dev-status='draft'],
    html.is-dev-mode-exiting .project-grid__item--new {
      transition: none;
    }
  }

  .project-grid__chips {
    position: absolute;
    top: 0.75em;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .project-grid__chips--start {
    left: 0.75em;
    right: auto;
    align-items: flex-start;
  }

  .project-grid__chips--end {
    right: 0.75em;
    left: auto;
    align-items: flex-end;
  }

  /*
    Bottom-right. The title/year sit bottom-*left* with a --space-unit pad, so
    this corner is the only free one; the centre belongs to the drag handle.
  */
  .project-grid__chips--end-bottom {
    top: auto;
    bottom: 0.75em;
    right: 0.75em;
    left: auto;
    align-items: flex-end;
  }

  /*
    Hover-only rail (#174) — chips stay hidden until something on the card
    asks for them. Removed the always-on selector that used to be here; keep
    reading each of the four cases below as its own reason, not a redundant
    restatement of :hover.
  */
  html.is-dev-mode .project-grid__chips:focus-within,
  html.is-dev-mode .project-grid__item:hover .project-grid__chips,
  html.is-dev-mode .project-grid__item:focus-within .project-grid__chips,
  /* a. Status menu open — a <button> click doesn't reliably focus it on
        macOS, so :focus-within can't be trusted while the pointer travels
        off the card to the menu. The menu's own hidden attribute is the
        honest signal that the interaction is still live. */
  html.is-dev-mode .project-grid__item:has([data-dev-status-menu]:not([hidden])) .project-grid__chips,
  /* b. Crop tuner open — DevProjectGridEditor adds is-dev-crop-open to
        <html> and marks the card's cover .dev-crop-stage-host; hold the
        rail on that card while the tuner owns it. */
  html.is-dev-crop-open .project-grid__item:has(.dev-crop-stage-host) .project-grid__chips,
  /* c. Span mode — enterSpanMode adds is-span-mode to the <li> and latches
        the chip; keep the rail up for the duration, not just on :hover. */
  html.is-dev-mode .project-grid__item.is-span-mode .project-grid__chips {
    opacity: 1;
    pointer-events: auto;
  }

  /*
    Chip contrast — two palettes, chosen by what is *currently under the chip*.

    Both grounds carry a 1px inset ring a step *away* from their own fill —
    lighter on dark, darker on light — so the chip reads as a shape rather
    than a floating glyph either way.

    Naming: variants are named for the GROUND they sit on, not the ink —
    `on-dark` is the white-icon set, because it sits on a dark ground. Same
    convention as Material's `onSurface`. `dark` / `hoverDark` in the content
    JSON also describe the ground, not the text.

    Light — ring a step *darker* than its fill: fill #e7e7e9, ring #d4d4d7 (the
    click fill nudged 7% toward --sys-color-on-srf; used raw it is 1.05:1 and
    vanishes). Dark — ring a step *lighter* than its fill: hover fill is the
    translucent black overlay (reads as ring-only on dark covers); ring
    #4c4c4c (22% toward --sys-color-srf). Press fill is a step darker (#353535,
    12% toward --sys-color-srf) with the same lighter ring.

    Both steps are deliberately slight; the ring defines the shape rather than
    outlining it.
  */
  @property --title-ink {
    syntax: '<color>';
    inherits: true;
