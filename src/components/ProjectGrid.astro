---
import cropIcon from 'lucide-static/icons/crop.svg?raw';
import columns2Icon from 'lucide-static/icons/columns-2.svg?raw';
import ellipsisVerticalIcon from 'lucide-static/icons/ellipsis-vertical.svg?raw';
import eyeOffIcon from 'lucide-static/icons/eye-off.svg?raw';
import filePenIcon from 'lucide-static/icons/file-pen.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import imagesIcon from 'lucide-static/icons/images.svg?raw';
import type { ProjectStatus } from '../lib/projects';
import { projectImage } from '../lib/images';
import { isPlaceholderCoverSrc } from '../lib/placeholderCover.mjs';
import { sizeIcon } from '../lib/icons';
import {
  normalizeImageVariants,
  responsiveImageStyle,
  type ImageVariants,
} from '../lib/responsiveImage';
import {
  hasCropVariants,
  imageDevEditAttrs,
  imageSourceDims,
} from '../lib/projectImageFrame';
import '../styles/project.css';

export type ProjectGridItem = {
  title: string;
  image: string;
  hoverImage?: string;
  /** Title-region light/dark for `hoverImage`. Absent falls back to `dark`. */
  hoverDark?: boolean;
  bg: string;
  dark: boolean;
  /** Year on home/work; optional meta line on play. */
  subtitle?: string;
  href?: string;
  /** Span both columns on home/work. */
  full?: boolean;
  slug?: string;
  playLinkId?: string;
  status?: ProjectStatus;
  teaser?: boolean;
  teaserLabel?: string;
  variants?: ImageVariants;
  srcWidth?: number;
  srcHeight?: number;
};

interface Props {
  items: ProjectGridItem[];
  /** Layout + motion preset — home, work, and play differ at tablet breakpoints. */
  variant?: 'home' | 'work' | 'play';
}

const { items, variant = 'work' } = Astro.props;
const isDev = import.meta.env.DEV;

const cropIconSvg = sizeIcon(cropIcon, 14);
const spanIconSvg = sizeIcon(columns2Icon, 14);
const hoverIconSvg = sizeIcon(imagesIcon, 14);
const settingsIconSvg = sizeIcon(ellipsisVerticalIcon, 14);
const statusIcons = {
  published: sizeIcon(globeIcon, 14),
  draft: sizeIcon(filePenIcon, 14),
  teaser: sizeIcon(eyeOffIcon, 14),
} as const;

const titleColor = (dark: boolean) => (dark ? '#f7f7f7' : '#6d6d6d');
const subtitleColor = (dark: boolean) => (dark ? 'rgba(247,247,247,0.5)' : 'rgba(109,109,109,0.5)');

/** Match the CSS frame the card uses at the desktop breakpoint. */
const coverDefaultAspect = (item: ProjectGridItem) => {
  if (item.full && variant === 'work') return '16:9';
  return '4:3';
};
---

<ul class:list={['project-grid', `project-grid--${variant}`]} data-dev-project-grid={variant}>
  {items.map((item) => {
    const isPlayPlaceholder = variant === 'play' && !item.href && !item.teaser;
    const isTeaser = Boolean(item.teaser);
    const isStatic = isPlayPlaceholder || (isTeaser && !isDev);
    const status = (item.status ?? 'published') as keyof typeof statusIcons;
    const statusIconSvg = statusIcons[status] ?? statusIcons.published;
    const defaultAspect = coverDefaultAspect(item);
    const srcDims = imageSourceDims(item);
    const hasCrop = hasCropVariants(item.variants);
    const normalized = hasCrop
      ? normalizeImageVariants(item.variants, defaultAspect, srcDims)
      : undefined;
    const seedVariants = normalizeImageVariants(item.variants, defaultAspect, srcDims);
    const projectEditable = isDev && Boolean(item.slug);
    const linkEditable = isDev && Boolean(item.playLinkId);
    const isPlaceholderCover = projectEditable && isPlaceholderCoverSrc(item.image);
    const projectEditAttrs = projectEditable
      ? imageDevEditAttrs(true, {
          documentKey: item.slug!,
          path: ['listings', variant],
          cropId: `listing-${variant}`,
          variants: seedVariants,
          gridDefaultAspect: defaultAspect,
        })
      : undefined;
    const linkEditAttrs = linkEditable
      ? imageDevEditAttrs(true, {
          documentKey: `play:${item.playLinkId}`,
          path: [],
          cropId: 'play-link',
          variants: seedVariants,
          gridDefaultAspect: defaultAspect,
        })
      : undefined;
    const editAttrs = projectEditAttrs ?? linkEditAttrs;

    // Hover ink falls back to the base `dark` value — a card whose hover
    // image was never measured (or has none) reads exactly as before.
    const hoverDark = item.hoverDark ?? item.dark;
    const metaStyle = [
      `--title-ink: ${titleColor(item.dark)}`,
      `--subtitle-ink: ${subtitleColor(item.dark)}`,
      `--title-ink-hover: ${titleColor(hoverDark)}`,
      `--subtitle-ink-hover: ${subtitleColor(hoverDark)}`,
      // Forced-hover on a card with no hover image shows the page background,
      // not an image — so the ink is whatever reads on --color-bg. Hard-coded
      // to the light-ground pair until dark mode gives the page two states.
      `--title-ink-on-page: ${titleColor(false)}`,
      `--subtitle-ink-on-page: ${subtitleColor(false)}`,
    ].join('; ');

    const cover = (
      <div
        class:list={[
          'project-grid__cover',
          'relative',
          !hasCrop && 'overflow-hidden',
          item.hoverImage && 'project-grid__cover--has-hover',
          hasCrop && 'project-cropped project-responsive-image',
          (projectEditable || linkEditable) && 'dev-image-edit-target',
        ]}
        style={normalized ? responsiveImageStyle(normalized, srcDims) : undefined}
        data-dev-cover-drop={projectEditable ? item.slug : undefined}
        data-dev-listing-cover={projectEditable ? variant : undefined}
        data-dev-cover-empty={isPlaceholderCover ? 'true' : undefined}
        {...(editAttrs ?? {})}
      >
        <div class="project-grid__stack">
          {hasCrop ? (
            <div class="project-crop-clip">
              <img
                src={projectImage(item.image)}
                alt={item.title}
                class="project-grid__img project-grid__img--base"
                loading="lazy"
              />
            </div>
          ) : (
            <img
              src={projectImage(item.image)}
              alt={item.title}
              class="project-grid__img project-grid__img--base w-full h-full object-cover"
              loading="lazy"
            />
          )}
          {(item.hoverImage || projectEditable) && (
            <img
              src={item.hoverImage ? projectImage(item.hoverImage) : undefined}
              alt=""
              class="project-grid__img project-grid__img--hover w-full h-full object-cover"
              loading="lazy"
              hidden={!item.hoverImage}
              aria-hidden="true"
            />
          )}
        </div>
        {isDev && item.slug && (
          <div class="project-grid__drop-veil" data-dev-drop-veil="active" aria-hidden="true">
            {/* Text is rewritten per drag in DevProjectGridEditor — which slot
                you are dropping into, and whether it already has an image. */}
            <span class="project-grid__drop-label" data-dev-drop-label>Replace cover image</span>
          </div>
        )}
        {projectEditable && (
          <div class="project-grid__drop-veil project-grid__drop-veil--hover-empty" aria-hidden="true">
            <span class="project-grid__drop-label">Drop hover image</span>
          </div>
        )}
        {isPlaceholderCover && (
          <div class="project-grid__drop-veil project-grid__drop-veil--cover-empty" aria-hidden="true">
            <span class="project-grid__drop-label">Drop cover image</span>
          </div>
        )}
        <div class="project-grid__meta absolute bottom-0 left-0 right-0" style={metaStyle}>
          <div class="flex items-baseline gap-2">
            <h2
              class="project-grid__title font-bold"
              data-dev-project-title
              data-placeholder="Title"
            >
              {item.title}
            </h2>
            {(item.subtitle || isDev) && (
              <span
                class="project-grid__subtitle font-bold"
                data-dev-project-subtitle
                data-placeholder={variant === 'play' ? 'Meta' : 'Year'}
              >{item.subtitle ?? ''}</span>
            )}
            {/* Play uses Meta for the secondary line (including “Coming soon”).
                Home/Work keep a separate teaser label beside Year. */}
            {isTeaser && variant !== 'play' && (
              <span
                class="project-grid__teaser-label font-bold"
                data-dev-project-teaser-label
                data-placeholder="Teaser label"
              >{item.teaserLabel ?? 'Coming soon'}</span>
            )}
          </div>
        </div>
      </div>
    );

    return (
      <li
        class:list={['project-grid__item', item.full && 'project-grid__item--full']}
        data-dev-project-slug={item.slug}
        data-dev-play-link={item.playLinkId}
        data-dev-status={status}
        data-dev-bg={item.bg}
        data-dev-dark={item.dark ? 'true' : 'false'}
        data-dev-hover-dark={projectEditable && item.hoverImage ? (hoverDark ? 'true' : 'false') : undefined}
        data-dev-hover-image={item.hoverImage || undefined}
      >
        {isStatic ? (
          <div
            class:list={[
              'project-grid__card',
              'block',
              isPlayPlaceholder && 'project-grid__card--placeholder',
              isTeaser && 'project-grid__card--teaser',
            ]}
            aria-disabled="true"
            data-dev-teaser-slug={isTeaser ? item.slug : undefined}
            data-dev-teaser-href={isTeaser ? item.href ?? `/${item.slug}` : undefined}
          >
            {cover}
          </div>
        ) : (
          <a href={item.href} class="project-grid__card block">
            {cover}
          </a>
        )}
        {projectEditable && (
          <div class="project-grid__chips project-grid__chips--start" data-dev-mode-only>
            <div class="project-grid__status-wrap">
              <button
                type="button"
                class="project-grid__chip"
                data-dev-project-status={item.slug}
                aria-label={`Visibility: ${status}`}
                aria-haspopup="listbox"
                aria-expanded="false"
                title={`Visibility: ${status}`}
              >
                <span class="project-grid__chip-icon" aria-hidden="true" set:html={statusIconSvg} />
              </button>
              <div class="project-grid__status-menu" data-dev-status-menu hidden role="listbox">
                <button type="button" role="option" data-dev-status-option="published" aria-selected={status === 'published'}>
                  Published
                </button>
                <button type="button" role="option" data-dev-status-option="draft" aria-selected={status === 'draft'}>
                  Draft
                </button>
                <button type="button" role="option" data-dev-status-option="teaser" aria-selected={status === 'teaser'}>
                  Teaser
                </button>
              </div>
            </div>
          </div>
        )}
        {projectEditable && (
          <div class="project-grid__chips project-grid__chips--end" data-dev-mode-only>
            {!isTeaser && (
              <button
                type="button"
                class="project-grid__chip"
                data-dev-project-hover={item.slug}
                data-dev-hover-chip-for={item.title}
                aria-label={`${item.title}: showing cover image — switch to hover image`}
                aria-pressed="false"
                title="Showing cover image — switch to hover image"
              >
                <span class="project-grid__chip-icon" aria-hidden="true" set:html={hoverIconSvg} />
              </button>
            )}
            <button
              type="button"
              class="project-grid__chip"
              data-dev-project-span={item.slug}
              aria-label={`Span columns for ${item.title}`}
              aria-pressed="false"
              title="Span columns"
            >
              <span class="project-grid__chip-icon" aria-hidden="true" set:html={spanIconSvg} />
            </button>
            <button
              type="button"
              class="project-grid__chip"
              data-dev-edit-trigger="image"
              aria-label={`Crop cover for ${item.title}`}
              title="Crop cover"
            >
              <span class="project-grid__chip-icon" aria-hidden="true" set:html={cropIconSvg} />
            </button>
          </div>
        )}
        {linkEditable && (
          <div class="project-grid__chips project-grid__chips--end" data-dev-mode-only>
            <button
              type="button"
              class="project-grid__chip"
              data-dev-edit-trigger="image"
              aria-label={`Crop cover for ${item.title}`}
              title="Crop cover"
            >
              <span class="project-grid__chip-icon" aria-hidden="true" set:html={cropIconSvg} />
            </button>
          </div>
        )}
        {projectEditable && (
          <div class="project-grid__chips project-grid__chips--end-bottom" data-dev-mode-only>
            <button
              type="button"
              class="project-grid__chip"
              data-dev-project-settings={item.slug}
              aria-label={`Card settings for ${item.title}`}
              aria-haspopup="dialog"
              title="Card settings"
            >
              <span class="project-grid__chip-icon" aria-hidden="true" set:html={settingsIconSvg} />
            </button>
          </div>
        )}
      </li>
    );
  })}
  {isDev && (
    <li class="project-grid__item project-grid__item--new">
      <button type="button" class="project-grid__new-page" data-dev-project-new>
        + New page
      </button>
    </li>
  )}
</ul>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-unit);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-grid__item {
    position: relative;
  }

  .project-grid__item--full {
    grid-column: span 2;
  }

  .project-grid--home .project-grid__item--full .project-grid__cover:not(.project-cropped) {
    aspect-ratio: 16 / 12;
  }

  .project-grid--work .project-grid__item--full .project-grid__cover:not(.project-cropped) {
    aspect-ratio: 16 / 9;
  }

  .project-grid__item--full .project-grid__cover:not(.project-cropped) .project-grid__img {
    object-position: center center;
  }

  .project-grid__cover {
    aspect-ratio: 4 / 3;
    transform: translateZ(0);
  }

  .project-grid__cover.project-cropped {
    aspect-ratio: var(--project-image-ratio);
  }

  .project-grid__stack {
    position: absolute;
    inset: 0;
  }

  .project-grid__stack .project-grid__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Base <-> hover swap. Distinct from the drop-replace crossfade further
     down (0.55s) — that one is a destructive edit and wants weight; this is
     a browsing gesture and reads sluggish at the same speed. */
  .project-grid__cover--has-hover .project-grid__img {
    transition: opacity 0.2s ease;
  }

  /*
    The chip swap must fade too, and it has to be declared outside
    .is-dev-hover-forced: a transition only on the forced state animates the
    way in and snaps back on the way out. Same 0.2s as the hover swap above —
    it is the same visual event, just driven by a chip instead of a pointer.
  */
  :global(html.is-dev-mode) .project-grid__cover .project-grid__img {
    transition: opacity 0.2s ease;
  }

  .project-grid__img--hover {
    opacity: 0;
  }

  /*
    In dev mode the whole card holds the hover, not just the <a>. The chip
    rails are children of the <li>, *outside* the card link, so travelling
    from the cover to a chip drops :hover and snaps the image back — a lot of
    motion for a pointer that never left the card. The live site keeps the
    plain :hover semantics below.
  */
  .project-grid__card:hover .project-grid__cover--has-hover .project-grid__img--hover,
  :global(html.is-dev-mode) .project-grid__item:hover .project-grid__cover--has-hover .project-grid__img--hover,
  .project-grid__cover.is-dev-hover-forced .project-grid__img--hover {
    opacity: 1;
  }

  .project-grid__card:hover .project-grid__cover--has-hover .project-grid__img--base,
  :global(html.is-dev-mode) .project-grid__item:hover .project-grid__cover--has-hover .project-grid__img--base,
  .project-grid__cover.is-dev-hover-forced .project-grid__img--base {
    opacity: 0;
  }

  :global(.project-grid__title),
  :global(.project-grid__subtitle),
  :global(.project-grid__teaser-label) {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
    /* Same 0.2s as the base <-> hover image crossfade above — a title that
       snaps while the image fades is worse than not swapping at all. */
    transition: color 0.2s ease;
  }

  /*
    :global on purpose. Astro scopes these to `[data-astro-cid-…]`, which a
    JS-created node never carries — `ensureSubtitleHost` in
    DevProjectGridEditor builds the year span for a project that has none, and
    a scoped rule leaves it uncoloured. Same reason the chip rails and drop
    chrome are global (see the block below).
  */
  :global(.project-grid__title) {
    color: var(--title-ink);
  }

  :global(.project-grid__subtitle),
  :global(.project-grid__teaser-label) {
    color: var(--subtitle-ink);
  }

  /* Only cards that actually have a hover image swap ink — reuses the same
     gate as the image crossfade so a card with no hover image never changes
     colour. `.is-dev-hover-forced` mirrors it for the dev preview toggle. */
  :global(.project-grid__card:hover .project-grid__cover--has-hover .project-grid__title),
  :global(html.is-dev-mode .project-grid__item:hover .project-grid__cover--has-hover .project-grid__title),
  :global(.project-grid__cover.is-dev-hover-forced .project-grid__title) {
    color: var(--title-ink-hover);
  }

  /*
    Hover forced on a card with *no* hover image: the base fades out and the
    page background is the ground, so both the ink and the chips below switch
    to their on-light values. Without this a dark-cover card goes white-on-
    white the moment you press the preview chip.
  */
  :global(.project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__title) {
    color: var(--title-ink-on-page);
  }

  :global(.project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__subtitle),
  :global(.project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover) .project-grid__teaser-label) {
    color: var(--subtitle-ink-on-page);
  }

  :global(.project-grid__card:hover .project-grid__cover--has-hover .project-grid__subtitle),
  :global(.project-grid__card:hover .project-grid__cover--has-hover .project-grid__teaser-label),
  :global(html.is-dev-mode .project-grid__item:hover .project-grid__cover--has-hover .project-grid__subtitle),
  :global(html.is-dev-mode .project-grid__item:hover .project-grid__cover--has-hover .project-grid__teaser-label),
  :global(.project-grid__cover.is-dev-hover-forced .project-grid__subtitle),
  :global(.project-grid__cover.is-dev-hover-forced .project-grid__teaser-label) {
    color: var(--subtitle-ink-hover);
  }

  .project-grid__meta {
    /* Above cover-drop wash / crossfade overlay so the title doesn’t pop in at the end. */
    z-index: 5;
    opacity: 0;
    padding: var(--space-unit);
    transition: opacity 0.3s ease;
  }

  .project-grid__card:hover .project-grid__meta {
    opacity: 1;
  }

  .project-grid__card--placeholder,
  .project-grid__card--teaser {
    cursor: not-allowed;
  }

  .project-grid__card--placeholder .project-grid__img {
    filter: grayscale(1);
  }

  .project-grid__card--teaser .project-grid__img {
    filter: blur(12px);
  }

  .project-grid__card--teaser:hover .project-grid__img {
    filter: blur(10px);
  }

  .project-grid__card--teaser .project-grid__meta,
  .project-grid__card--placeholder .project-grid__meta {
    opacity: 1;
  }

  .project-grid__status-wrap {
    position: relative;
  }

  /*
    Match section drag-handle / delete: icon-only at rest; fill + scale on hover.
    Light covers: press darkens the fill slightly (--color-surface-press).
    Dark covers override outline / press fill in the global block (#154).
  */
  .project-grid__chip {
    display: grid;
    place-items: center;
    width: auto;
    height: auto;
    min-width: 0;
    padding: 0.45em 0.55em;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--chip-ink);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: none;
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease,
      color 0.15s ease;
  }

  .project-grid__chip-icon {
    display: grid;
    place-items: center;
    line-height: 0;
    pointer-events: none;
  }

  .project-grid__chip:hover,
  .project-grid__chip:focus-visible,
  .project-grid__chip[aria-pressed='true'],
  .project-grid__chip[aria-expanded='true'] {
    background: var(--chip-fill);
    box-shadow: inset 0 0 0 1px var(--chip-ring);
    backdrop-filter: blur(8px);
    transform: scale(1.08);
    color: var(--chip-ink);
  }

  /*
    Pressed and latched promote to --chip-press (darker than the ring on dark;
    on light the press fill darkens while the ring stays). These selectors must
    stay *after* the hover group — a latched chip is also hovered, and the last
    equal-specificity rule wins.
  */
  .project-grid__chip:active,
  .project-grid__chip[aria-pressed='true'],
  .project-grid__chip[aria-expanded='true'] {
    background: var(--chip-press);
    box-shadow: inset 0 0 0 1px var(--chip-ring);
    backdrop-filter: blur(8px);
    color: var(--chip-ink);
  }

  .project-grid__status-menu {
    --status-menu-pad: 0.35em;
    position: absolute;
    top: 0;
    left: calc(100% + 0.35em);
    display: grid;
    gap: 0.15em;
    min-width: 7.5em;
    padding: var(--status-menu-pad);
    border-radius: var(--radius-control);
    /* Same page surface as crop/grid tuner overlays — tracks --color-bg. */
    background: var(--color-bg);
    box-shadow: 0 0.25em 0.8em rgb(0 0 0 / 0.12);
  }

  .project-grid__status-menu button {
    padding: 0.35em 0.55em;
    border: 0;
    /* Concentric with the menu card: outer radius − padding. */
    border-radius: calc(var(--radius-control) - var(--status-menu-pad));
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.75rem;
    text-align: left;
    cursor: pointer;
  }

  .project-grid__status-menu button:hover,
  .project-grid__status-menu button[aria-selected='true'] {
    background: var(--color-surface-chip);
  }

  .project-grid__new-page {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    padding: 1em;
    border: 1px dashed #b8b4ab;
    border-radius: 0;
    background: transparent;
    color: #8a857c;
    font: inherit;
    font-size: 1rem;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .project-grid__new-page:hover {
    border-color: #6f6b62;
    color: #4f4b43;
  }

  .project-grid--home .project-grid__item--new .project-grid__new-page {
    aspect-ratio: 4 / 3;
  }

  .project-grid--work .project-grid__item--new .project-grid__new-page,
  .project-grid--play .project-grid__item--new .project-grid__new-page {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 667px) {
    .project-grid--work .project-grid__item--new .project-grid__new-page,
    .project-grid--play .project-grid__item--new .project-grid__new-page {
      aspect-ratio: 1 / 1;
    }
  }

  @media (max-width: 768px) {
    /* Touch: titles always on; no hover image swap yet (#132). */
    .project-grid__meta {
      opacity: 1 !important;
      transition: none !important;
    }

    .project-grid__cover--has-hover .project-grid__img,
    :global(html.is-dev-mode) .project-grid__cover .project-grid__img {
      transition: none;
    }

    .project-grid__card:hover .project-grid__cover--has-hover .project-grid__img--hover,
    :global(html.is-dev-mode) .project-grid__item:hover .project-grid__cover--has-hover .project-grid__img--hover {
      opacity: 0;
    }

    .project-grid__card:hover .project-grid__cover--has-hover .project-grid__img--base,
    :global(html.is-dev-mode) .project-grid__item:hover .project-grid__cover--has-hover .project-grid__img--base {
      opacity: 1;
    }

    /* Touch: no hover image swap on a real `:hover` (above), so the ink swap
       must not fire on it either — a title changing colour for an image that
       never appears. `.is-dev-hover-forced` (the dev preview chip) is left
       alone here, same as the image opacity rules above: it is meant to work
       at any viewport width so authoring isn't width-gated. */
    :global(.project-grid__card:hover .project-grid__cover--has-hover .project-grid__title),
    :global(html.is-dev-mode .project-grid__item:hover .project-grid__cover--has-hover .project-grid__title) {
      color: var(--title-ink);
    }

    :global(.project-grid__card:hover .project-grid__cover--has-hover .project-grid__subtitle),
    :global(.project-grid__card:hover .project-grid__cover--has-hover .project-grid__teaser-label),
    :global(html.is-dev-mode .project-grid__item:hover .project-grid__cover--has-hover .project-grid__subtitle),
    :global(html.is-dev-mode .project-grid__item:hover .project-grid__cover--has-hover .project-grid__teaser-label) {
      color: var(--subtitle-ink);
    }

    .project-grid__card--teaser .project-grid__img {
      filter: blur(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-grid__cover--has-hover .project-grid__img,
    :global(html.is-dev-mode) .project-grid__cover .project-grid__img,
    .project-grid__meta,
    .project-grid__title,
    .project-grid__subtitle,
    .project-grid__teaser-label {
      transition: none;
    }
  }

  @media (max-width: 667px) {
    .project-grid--home {
      grid-template-columns: 1fr;
    }

    .project-grid--home .project-grid__item--full {
      grid-column: span 1;
    }

    .project-grid--work .project-grid__item--full,
    .project-grid--play .project-grid__cover:not(.project-cropped),
    .project-grid--work .project-grid__cover:not(.project-cropped),
    .project-grid--work .project-grid__item--full .project-grid__cover:not(.project-cropped) {
      aspect-ratio: 1 / 1;
    }

    .project-grid--work .project-grid__item--full {
      grid-column: span 1;
    }

    .project-grid--play .project-grid__item--full {
      grid-column: span 1;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-grid__cover:not(.project-cropped),
    .project-grid--home .project-grid__item--full .project-grid__cover:not(.project-cropped),
    .project-grid--work .project-grid__item--full .project-grid__cover:not(.project-cropped) {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<style is:global>
  /*
    Chip rails must be global — listing pages never import project.css, and
    Astro-scoped BEM modifiers were not pinning --start left (both rails
    stacked on the static position / right).
  */

  /*
    Drafts and the + New page cell are DEV-DOM only, but View must not show
    them. Match the Edit chrome fade (0.28s); drop out of the grid after exit.
    (New page used to toggle [hidden] immediately via data-dev-mode-only.)
  */
  .project-grid__item[data-dev-status='draft'],
  .project-grid__item--new {
    display: none;
  }

  html.is-dev-mode .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode .project-grid__item--new,
  html.is-dev-mode-exiting .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode-exiting .project-grid__item--new {
    display: revert;
    opacity: 1;
    transition: opacity 0.28s ease;
  }

  html.is-dev-mode-entering .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode-entering .project-grid__item--new,
  html.is-dev-mode-exiting .project-grid__item[data-dev-status='draft'],
  html.is-dev-mode-exiting .project-grid__item--new {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-dev-mode .project-grid__item[data-dev-status='draft'],
    html.is-dev-mode .project-grid__item--new,
    html.is-dev-mode-exiting .project-grid__item[data-dev-status='draft'],
    html.is-dev-mode-exiting .project-grid__item--new {
      transition: none;
    }
  }

  .project-grid__chips {
    position: absolute;
    top: 0.75em;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .project-grid__chips--start {
    left: 0.75em;
    right: auto;
    align-items: flex-start;
  }

  .project-grid__chips--end {
    right: 0.75em;
    left: auto;
    align-items: flex-end;
  }

  /*
    Bottom-right. The title/year sit bottom-*left* with a --space-unit pad, so
    this corner is the only free one; the centre belongs to the drag handle.
  */
  .project-grid__chips--end-bottom {
    top: auto;
    bottom: 0.75em;
    right: 0.75em;
    left: auto;
    align-items: flex-end;
  }

  /*
    Hover-only rail (#174) — chips stay hidden until something on the card
    asks for them. Removed the always-on selector that used to be here; keep
    reading each of the four cases below as its own reason, not a redundant
    restatement of :hover.
  */
  html.is-dev-mode .project-grid__chips:focus-within,
  html.is-dev-mode .project-grid__item:hover .project-grid__chips,
  html.is-dev-mode .project-grid__item:focus-within .project-grid__chips,
  /* a. Status menu open — a <button> click doesn't reliably focus it on
        macOS, so :focus-within can't be trusted while the pointer travels
        off the card to the menu. The menu's own hidden attribute is the
        honest signal that the interaction is still live. */
  html.is-dev-mode .project-grid__item:has([data-dev-status-menu]:not([hidden])) .project-grid__chips,
  /* b. Crop tuner open — DevProjectGridEditor adds is-dev-crop-open to
        <html> and marks the card's cover .dev-crop-stage-host; hold the
        rail on that card while the tuner owns it. */
  html.is-dev-crop-open .project-grid__item:has(.dev-crop-stage-host) .project-grid__chips,
  /* c. Span mode — enterSpanMode adds is-span-mode to the <li> and latches
        the chip; keep the rail up for the duration, not just on :hover. */
  html.is-dev-mode .project-grid__item.is-span-mode .project-grid__chips {
    opacity: 1;
    pointer-events: auto;
  }

  /*
    Chip contrast — two palettes, chosen by what is *currently under the chip*.

    Both grounds carry a 1px inset ring a step *away* from their own fill —
    lighter on dark, darker on light — so the chip reads as a shape rather
    than a floating glyph either way.

    Naming: variants are named for the GROUND they sit on, not the ink —
    `on-dark` is the white-icon set, because it sits on a dark ground. Same
    convention as Material's `onSurface`. `dark` / `hoverDark` in the content
    JSON also describe the ground, not the text.

    Light — ring a step *darker* than its fill: fill #e7e7e9, ring #d4d4d7 (the
    click fill nudged 7% toward --color-text; used raw it is 1.05:1 and
    vanishes). Dark — ring a step *lighter* than its fill: hover fill is the
    translucent black overlay (reads as ring-only on dark covers); ring
    #4c4c4c (22% toward --color-bg). Press fill is a step darker (#353535,
    12% toward --color-bg) with the same lighter ring.

    Both steps are deliberately slight; the ring defines the shape rather than
    outlining it.
  */
  .project-grid {
    --chip-ink-on-light: var(--color-text);
    --chip-fill-on-light: color-mix(in srgb, var(--color-surface-control) 92%, transparent);
    --chip-ring-on-light: color-mix(in srgb, var(--color-text) 7%, var(--color-surface-press));
    --chip-press-on-light: color-mix(in srgb, var(--color-surface-press) 92%, transparent);

    --chip-ink-on-dark: var(--color-bg);
    --chip-fill-on-dark: rgb(0 0 0 / 0.58);
    --chip-ring-on-dark: color-mix(in srgb, var(--color-bg) 22%, #1a1a1a);
    --chip-press-on-dark: color-mix(in srgb, var(--color-bg) 12%, #1a1a1a);
  }

  .project-grid__item {
    --chip-ink: var(--chip-ink-on-light);
    --chip-fill: var(--chip-fill-on-light);
    --chip-ring: var(--chip-ring-on-light);
    --chip-press: var(--chip-press-on-light);
  }

  .project-grid__item[data-dev-dark='true'] {
    --chip-ink: var(--chip-ink-on-dark);
    --chip-fill: var(--chip-fill-on-dark);
    --chip-ring: var(--chip-ring-on-dark);
    --chip-press: var(--chip-press-on-dark);
  }

  /*
    While the hover image is the one showing, the chips are sitting on *it*,
    not on the base cover — so they take its measured value (#182's hoverDark)
    instead of `dark`. This matters more than it looks: chips only reveal on
    hover, so the hover image is the ground they are on almost every time you
    see them. Same gate as the title ink and the image crossfade.

    Interim until #172 measures per control position rather than per image.
  */
  .project-grid__item[data-dev-hover-dark='true']:hover:has(.project-grid__cover--has-hover),
  .project-grid__item[data-dev-hover-dark='true']:has(.project-grid__cover--has-hover.is-dev-hover-forced) {
    --chip-ink: var(--chip-ink-on-dark);
    --chip-fill: var(--chip-fill-on-dark);
    --chip-ring: var(--chip-ring-on-dark);
    --chip-press: var(--chip-press-on-dark);
  }

  .project-grid__item[data-dev-hover-dark='false']:hover:has(.project-grid__cover--has-hover),
  .project-grid__item[data-dev-hover-dark='false']:has(.project-grid__cover--has-hover.is-dev-hover-forced),
  /* No hover image at all — forced preview shows the page background. */
  .project-grid__item:has(.project-grid__cover.is-dev-hover-forced:not(.project-grid__cover--has-hover)) {
    --chip-ink: var(--chip-ink-on-light);
    --chip-fill: var(--chip-fill-on-light);
    --chip-ring: var(--chip-ring-on-light);
    --chip-press: var(--chip-press-on-light);
  }

  /*
    Cover-drop chrome must be global — the crossfade overlay is created in JS
    (no Astro scope attr), and scoped drop-active selectors were a no-op
    in the same way chip placement was.
  */
  .project-grid__drop-veil {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .project-grid__drop-label {
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-align: center;
    filter:
      drop-shadow(0 0 0.15em rgb(255 255 255 / 0.95))
      drop-shadow(0 0.05em 0.2em rgb(0 0 0 / 0.45));
  }

  /* Base (replace) veil only — the two modifier veils below have their own triggers. */
  .project-grid__cover[data-dev-drop-active='true']
    .project-grid__drop-veil:not(.project-grid__drop-veil--hover-empty):not(.project-grid__drop-veil--cover-empty) {
    opacity: 1;
  }

  /*
    #175 — empty hover slot reads as droppable, not broken. Only ever set by
    DevProjectGridEditor toggling .is-dev-hover-forced, so no live-site path
    needs an html.is-dev-mode prefix here. Yields to the transient replace /
    crossfade veil via :not() rather than fighting it on specificity.
  */
  .project-grid__cover.is-dev-hover-forced:not([data-dev-drop-active='true']):not([data-dev-crossfade-active='true']):has(> .project-grid__stack > .project-grid__img--hover[hidden])
    .project-grid__drop-veil--hover-empty {
    opacity: 1;
  }

  /*
    #176 — placeholder cover reads as an empty slot, not a broken image.
    data-dev-cover-empty is only emitted for editable items (isDev), but the
    guard is kept anyway so a draft project can never show a drop affordance
    to a visitor. Same :not() yield as the hover-empty rule above.
  */
  html.is-dev-mode .project-grid__cover[data-dev-cover-empty='true']:not([data-dev-drop-active='true']):not([data-dev-crossfade-active='true'])
    .project-grid__drop-veil--cover-empty {
    opacity: 1;
  }

  /*
    Wash toward page white — do NOT lower stack opacity (that reveals the
    listing card `bg` fill behind the images). Shared by the transient
    replace state and the two persistent empty states above.
  */
  .project-grid__cover[data-dev-drop-active='true']::after,
  .project-grid__cover.is-dev-hover-forced:has(> .project-grid__stack > .project-grid__img--hover[hidden])::after,
  html.is-dev-mode .project-grid__cover[data-dev-cover-empty='true']::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--color-bg);
    /* Strong enough that whatever the cover is — black, white, or a black
       edge around a white centre — the drop state resolves to a predictable
       near-page ground. That is what lets the dash below be a single colour
       instead of a per-card variant or a glow, and it doubles as the signal
       that this image is on its way out. See #172. */
    opacity: 0.72;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .project-grid__item:has(.project-grid__cover[data-dev-drop-active='true']) .project-grid__chips,
  .project-grid__item:has(.project-grid__cover[data-dev-crossfade-active='true']) .project-grid__chips {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /*
    The title/year dash is the same affordance layer as the chips, so it
    leaves with them — during a drop the cover is the only thing being
    offered, and edit chrome for something else is noise. The text itself
    stays (meta is z-index 5, above the wash); only the rule fades.
    outline-color, not opacity: an outline has no box of its own to fade.
  */
  .project-grid__item:has(.project-grid__cover[data-dev-drop-active='true'])
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable],
  .project-grid__item:has(.project-grid__cover[data-dev-crossfade-active='true'])
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable] {
    outline-color: transparent;
  }

  /* During replace: hold page white under the fades so listing `bg` never peeks. */
  .project-grid__cover[data-dev-crossfade-active='true'] {
    background-color: var(--color-bg) !important;
  }

  .project-grid__cover[data-dev-crossfade-active='true'] .project-grid__stack {
    transition: opacity 0.55s ease;
  }

  .project-grid__cover[data-dev-fade-out='true'] .project-grid__stack {
    opacity: 0;
  }

  .project-grid__crossfade {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease;
  }

  .project-grid__crossfade.is-in {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-grid__drop-veil,
    .project-grid__cover[data-dev-drop-active='true']::after,
    .project-grid__cover[data-dev-crossfade-active='true'] .project-grid__stack,
    .project-grid__crossfade {
      transition: none;
    }
  }

  /* Layer 1: titles stay readable for inline edit without hovering the card. */
  html.is-dev-mode .project-grid__meta {
    opacity: 1;
  }

  /*
    Drop target frame — the dashed hairline that means "editable" (see
    --dev-edit-dash), drawn while an image is being dragged over the cover.
    Held inside the cover edge rather than on it, and rounded, so it reads as
    a slot the image will drop into rather than as the cover's own border.

    2px rather than the text field's 1px — this frame spans a whole card, and
    a hairline at that size reads as an artefact rather than a boundary.

    Single colour on purpose. It only works because the drop wash above is
    strong enough to flatten any cover to a near-page ground first; the dash
    is drawn on that, not on the image. Do not reintroduce a per-card dark
    variant here — listings.*.dark is one boolean for the whole cover and is
    wrong for anything not at the corners (#172).
  */
  html.is-dev-mode .project-grid__cover::before {
    content: '';
    position: absolute;
    inset: 0.75em;
    /* Above the page-white wash (2) so the dash isn't muted by it; the label
       is a real child at 3, so it still paints over this. */
    z-index: 3;
    border: 2px dashed var(--dev-edit-dash-color);
    border-radius: var(--radius-control);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  /* Same 0.2s as the veil and wash — the three are one state, not a sequence. */
  html.is-dev-mode .project-grid__cover[data-dev-drop-active='true']::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-dev-mode .project-grid__cover::before,
    html.is-dev-mode
      :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable] {
      transition: none;
    }
  }

  html.is-dev-mode
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable] {
    outline: var(--dev-edit-dash);
    outline-offset: 0.12em;
    border-radius: 0.15em;
    cursor: text;
    /* Matches the chips' fade out during a drop — see the drop-active rule above. */
    transition: outline-color 0.2s ease;
    /* Shrink-wrap when filled; min-width only on :empty below (years looked padded). */
    display: inline-block;
    min-height: 1.15em;
    vertical-align: baseline;
  }

  /* Empty fields: ::before placeholder sizes the hit target. A fixed min-width
     (was 2.75em for Year) left a gap after shorter labels like Meta. */
  html.is-dev-mode
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable]:empty,
  html.is-dev-mode
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable]:has(> br:only-child) {
    width: max-content;
  }

  html.is-dev-mode
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable]:empty::before,
  html.is-dev-mode
    :is([data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label])[contenteditable]:has(> br:only-child)::before {
    content: attr(data-placeholder);
    color: color-mix(in srgb, currentColor 45%, transparent);
    pointer-events: none;
  }

  /* Cropped gallery covers: stack nests the clip; project.css expects a direct child.
     Do not use `inset: auto` here — that shorthand resets top/left and pins the
     bitmap to the top-left (ghost omits inset and stays centred). */
  .project-grid__cover.project-cropped > .project-grid__stack > .project-crop-clip > img,
  .project-grid__cover.project-cropped > .project-grid__stack > img.project-grid__img--base {
    position: absolute;
    top: 50%;
    left: 50%;
    right: auto;
    bottom: auto;
    width: calc(100% / var(--project-content-w, 1));
    height: auto;
    max-width: none;
    min-height: 0;
    object-fit: fill;
    transform: translate(
      calc(var(--project-content-cx, 0.5) * -100%),
      calc(var(--project-content-cy, 0.5) * -100%)
    );
  }

  .is-dev-mode .dev-crop-stage-host.project-grid__cover {
    overflow: visible;
  }

  /* Span mode — on-card frame + edge handle (1↔2 columns). */
  .project-grid__item.is-span-mode .project-grid__span-frame {
    position: absolute;
    inset: 0;
    z-index: 4;
    border: 1.5px solid color-mix(in srgb, var(--color-text) 55%, transparent);
    border-radius: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-bg) 40%, transparent);
  }

  .project-grid__item.is-span-mode .project-grid__span-handle {
    position: absolute;
    bottom: 0.55em;
    z-index: 6;
    width: 1.1em;
    height: 1.1em;
    padding: 0;
    border: 1.5px solid color-mix(in srgb, var(--color-text) 70%, transparent);
    border-radius: 0.15em;
    background: color-mix(in srgb, var(--color-surface-control) 94%, transparent);
    backdrop-filter: blur(8px);
    cursor: ew-resize;
    pointer-events: auto;
    touch-action: none;
  }

  .project-grid__item.is-span-mode .project-grid__span-handle[data-side='end'] {
    right: 0.55em;
    left: auto;
  }

  .project-grid__item.is-span-mode .project-grid__span-handle[data-side='start'] {
    left: 0.55em;
    right: auto;
  }

  .project-grid__item.is-span-mode .project-grid__span-handle:active {
    box-shadow: 0 0.35em 1.1em rgb(0 0 0 / 0.16);
  }

  /* Crop panel open: don't enter / keep span handles dead. */
  html.is-dev-crop-open .project-grid__item.is-span-mode .project-grid__span-handle,
  .project-grid__item.is-span-mode.is-span-disabled .project-grid__span-handle {
    pointer-events: none;
    opacity: 0.35;
  }
</style>
