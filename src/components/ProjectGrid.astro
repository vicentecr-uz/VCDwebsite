---
import type { ProjectStatus } from '../lib/projects';

export type ProjectGridItem = {
  title: string;
  image: string;
  bg: string;
  dark: boolean;
  /** Year on home/work; optional meta line on play. */
  subtitle?: string;
  href?: string;
  /** Span both columns on home/work. */
  full?: boolean;
  slug?: string;
  playLinkId?: string;
  status?: ProjectStatus;
  teaser?: boolean;
  teaserLabel?: string;
};

interface Props {
  items: ProjectGridItem[];
  /** Layout + motion preset — home, work, and play differ at tablet breakpoints. */
  variant?: 'home' | 'work' | 'play';
}

const { items, variant = 'work' } = Astro.props;
const isDev = import.meta.env.DEV;

const titleColor = (dark: boolean) => (dark ? '#f7f7f7' : '#6d6d6d');
const subtitleColor = (dark: boolean) => (dark ? 'rgba(247,247,247,0.5)' : 'rgba(109,109,109,0.5)');
---

<ul class:list={['project-grid', `project-grid--${variant}`]} data-dev-project-grid={variant}>
  {items.map((item) => {
    const isPlayPlaceholder = variant === 'play' && !item.href && !item.teaser;
    const isTeaser = Boolean(item.teaser);
    const isStatic = isPlayPlaceholder || (isTeaser && !isDev);
    const statusLabel = item.status && item.status !== 'published' ? item.status : '';

    const cover = (
      <div class="project-grid__cover relative overflow-hidden" style={`background-color: ${item.bg}`}>
        <img
          src={item.image}
          alt={item.title}
          class="project-grid__img w-full h-full object-cover"
          loading="lazy"
        />
        <div class="project-grid__meta absolute bottom-0 left-0 right-0">
          <div class="flex items-baseline gap-2">
            <h2 class="project-grid__title font-bold" style={`color: ${titleColor(item.dark)}`}>
              {item.title}
            </h2>
            {item.subtitle && (
              <span class="project-grid__subtitle font-bold" style={`color: ${subtitleColor(item.dark)}`}>
                {item.subtitle}
              </span>
            )}
            {isTeaser && (
              <span class="project-grid__teaser-label font-bold" style={`color: ${subtitleColor(item.dark)}`}>
                {item.teaserLabel ?? 'Coming soon'}
              </span>
            )}
          </div>
        </div>
        {statusLabel && (
          <span class="project-grid__status-badge" data-dev-mode-only>
            {statusLabel}
          </span>
        )}
      </div>
    );

    return (
      <li
        class:list={['project-grid__item', item.full && 'project-grid__item--full']}
        data-dev-project-slug={item.slug}
        data-dev-play-link={item.playLinkId}
      >
        {isStatic ? (
          <div
            class:list={[
              'project-grid__card',
              'block',
              isPlayPlaceholder && 'project-grid__card--placeholder',
              isTeaser && 'project-grid__card--teaser',
            ]}
            aria-disabled="true"
            data-dev-teaser-slug={isTeaser ? item.slug : undefined}
            data-dev-teaser-href={isTeaser ? item.href ?? `/${item.slug}` : undefined}
          >
            {cover}
          </div>
        ) : (
          <a href={item.href} class="project-grid__card block">
            {cover}
          </a>
        )}
        {isDev && item.slug && (
          <button
            type="button"
            class="project-grid__settings"
            data-dev-project-settings={item.slug}
            data-dev-mode-only
            aria-label={`Settings for ${item.title}`}
          >
            ⋯
          </button>
        )}
      </li>
    );
  })}
  {isDev && (
    <li class="project-grid__item project-grid__item--new" data-dev-mode-only hidden>
      <button type="button" class="project-grid__new-page" data-dev-project-new>
        + New page
      </button>
    </li>
  )}
</ul>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-grid__item {
    position: relative;
  }

  .project-grid__item--full {
    grid-column: span 2;
  }

  .project-grid--home .project-grid__item--full .project-grid__cover {
    aspect-ratio: 16 / 12;
  }

  .project-grid--work .project-grid__item--full .project-grid__cover {
    aspect-ratio: 16 / 9;
  }

  .project-grid__item--full .project-grid__img {
    object-position: center center;
  }

  .project-grid__cover {
    aspect-ratio: 4 / 3;
    transform: translateZ(0);
  }

  .project-grid__title,
  .project-grid__subtitle,
  .project-grid__teaser-label {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .project-grid--home .project-grid__img {
    filter: none;
    transform: scale(1.18);
    transition: transform 0.5s ease;
  }

  .project-grid--home .project-grid__card:hover .project-grid__img {
    transform: scale(1.22);
  }

  .project-grid--work .project-grid__img,
  .project-grid--play .project-grid__img {
    transform: scale(1.04);
    transition: transform 0.5s ease;
  }

  .project-grid--work .project-grid__card:hover .project-grid__img,
  .project-grid--play .project-grid__card:hover .project-grid__img {
    transform: scale(1.07);
  }

  .project-grid__meta {
    opacity: 0;
    padding: 1em;
    transition: opacity 0.3s ease;
  }

  .project-grid__card:hover .project-grid__meta {
    opacity: 1;
  }

  .project-grid__card--placeholder,
  .project-grid__card--teaser {
    cursor: not-allowed;
  }

  .project-grid__card--placeholder .project-grid__img {
    filter: grayscale(1);
    transform: scale(1.04);
  }

  .project-grid__card--teaser .project-grid__img {
    filter: blur(12px);
    transform: scale(1.08);
  }

  .project-grid__card--teaser:hover .project-grid__img {
    filter: blur(10px);
  }

  .project-grid__card--teaser .project-grid__meta,
  .project-grid__card--placeholder .project-grid__meta {
    opacity: 1;
  }

  .project-grid__status-badge {
    position: absolute;
    top: 0.75em;
    left: 0.75em;
    padding: 0.2em 0.55em;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-grid__settings {
    position: absolute;
    top: 0.75em;
    right: 0.75em;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2em;
    height: 2em;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-surface-soft) 92%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-text);
    font: inherit;
    font-size: 1.1rem;
    line-height: 1;
    box-shadow: 0 0.25em 0.8em rgb(0 0 0 / 0.08);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  :global(.is-dev-mode:not(.show-listing-grid-editor)) .project-grid__settings,
  :global(.is-dev-mode) .project-grid__settings:focus-visible,
  .project-grid__item:hover .project-grid__settings,
  .project-grid__item:focus-within .project-grid__settings {
    opacity: 1;
    pointer-events: auto;
  }

  .project-grid__new-page {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    padding: 1em;
    border: 1px dashed #b8b4ab;
    border-radius: 0;
    background: transparent;
    color: #8a857c;
    font: inherit;
    font-size: 1rem;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .project-grid__new-page:hover {
    border-color: #6f6b62;
    color: #4f4b43;
  }

  .project-grid--home .project-grid__item--new .project-grid__new-page {
    aspect-ratio: 4 / 3;
  }

  .project-grid--work .project-grid__item--new .project-grid__new-page,
  .project-grid--play .project-grid__item--new .project-grid__new-page {
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 667px) {
    .project-grid--work .project-grid__item--new .project-grid__new-page,
    .project-grid--play .project-grid__item--new .project-grid__new-page {
      aspect-ratio: 1 / 1;
    }
  }

  @media (max-width: 768px) {
    .project-grid__img {
      transform: scale(1.01) !important;
      transition: transform 0.4s ease !important;
    }

    .project-grid__card:hover .project-grid__img {
      transform: scale(1.03) !important;
    }

    .project-grid__meta {
      opacity: 1 !important;
      transition: none !important;
    }

    .project-grid__card--teaser .project-grid__img {
      filter: blur(10px);
    }
  }

  @media (max-width: 667px) {
    .project-grid--home {
      grid-template-columns: 1fr;
    }

    .project-grid--home .project-grid__item--full {
      grid-column: span 1;
    }

    .project-grid--work .project-grid__item--full,
    .project-grid--play .project-grid__cover,
    .project-grid--work .project-grid__cover,
    .project-grid--work .project-grid__item--full .project-grid__cover {
      aspect-ratio: 1 / 1;
    }

    .project-grid--work .project-grid__item--full {
      grid-column: span 1;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-grid__cover,
    .project-grid--home .project-grid__item--full .project-grid__cover,
    .project-grid--work .project-grid__item--full .project-grid__cover {
      aspect-ratio: 4 / 3;
    }
  }
</style>
