---
import DevOverlay from './DevOverlay.astro';
import AssetManagerContent from './ui/AssetManagerContent.astro';

interface Props {
  documentKey?: string;
}

const { documentKey = '' } = Astro.props;
---

<DevOverlay
  storageKey="asset-manager"
  panelKey="asset-manager"
  layout="landscape"
  data-dev-asset-manager
  data-document-key={documentKey}
  defaultHidden
>
  <AssetManagerContent />
</DevOverlay>

<script>
  import { onPageLoad, createPageScope } from '../lib/pageLifecycle';
  import trashIcon from 'lucide-static/icons/trash-2.svg?raw';
  import { sizeIcon } from '../lib/icons';
  import { getLastPointerPosition } from '../lib/lastPointer';

  const dispose = onPageLoad(() => {
    const scope = createPageScope();
    const ownObserver = <T extends { disconnect(): void }>(observer: T): T => {
      scope.add(() => observer.disconnect());
      return observer;
    };
    const pageFetch: typeof fetch = (input, options) => fetch(input, { ...options, signal: scope.signal });


  const UNASSIGNED = '__unassigned__';
  const ASSET_DRAG_TYPE = 'application/x-vcd-asset-src';

  /** @typedef {{
   *   id: string,
   *   src: string,
   *   url: string,
   *   filename: string,
   *   usedBy: string[],
   * }} Asset */

  const overlay = document.querySelector('[data-dev-asset-manager]');
  const propDocumentKey = overlay instanceof HTMLElement ? (overlay.dataset.documentKey || '') : '';
  const NON_PROJECT_SEGMENTS = new Set(['', 'play', 'about', 'styles']);
  const currentPageSlugFromPath = () => {
    const segment = location.pathname.replace(/^\/+|\/+$/g, '').split('/')[0] || '';
    return NON_PROJECT_SEGMENTS.has(segment) ? '' : segment;
  };
  const currentPageSlug = () => propDocumentKey || currentPageSlugFromPath();
  const projectsEl = document.querySelector('[data-asset-projects]');
  const gridEl = document.querySelector('[data-asset-grid]');
  const statusEl = document.querySelector('[data-asset-status]');
  const countEl = document.querySelector('[data-asset-count]');
  const filterButtons = document.querySelectorAll('[data-asset-filter]');
  const footerEl = document.querySelector('[data-asset-footer]');
  const cancelButton = document.querySelector('[data-asset-cancel]');
  const selectButton = document.querySelector('[data-asset-select]');

  /** @type {Asset[]} */
  let assets = [];
  /** @type {Array<{ slug: string, title: string }>} */
  let projects = [];
  let selectedProject = currentPageSlug() || '';
  /** @type {'all' | 'onPage' | 'library'} */
  let filter = 'all';
  /** @type {Set<string>} */
  const selected = new Set();
  /** @type {((value: { srcs: string[], type: string }) => void) | null} */
  let resolvePick = null;
  /** @type {((reason?: Error) => void) | null} */
  let rejectPick = null;
  let pickMode = false;
  /** @type {HTMLElement | null} */
  let pickOpener = null;
  /** @type {'image' | 'imageGrid' | 'imageCarousel'} */
  let pickType = 'image';
  /** @type {number | null} */
  let pickMax = null;

  const setStatus = (message) => {
    if (statusEl instanceof HTMLElement) statusEl.textContent = message;
  };

  const syncPickButtons = () => {
    const count = selected.size;
    if (selectButton instanceof HTMLButtonElement) {
      selectButton.disabled = count < 1;
    }
    if (footerEl instanceof HTMLElement) footerEl.hidden = !pickMode;
    if (countEl instanceof HTMLElement) {
      countEl.textContent = count
        ? `${count} selected`
        : pickMode
          ? (pickMax === 1 ? 'Select one image' : 'Select one or more images')
          : '';
    }
  };

  const onPageFor = (asset) => (selectedProject
    ? asset.usedBy.includes(selectedProject)
    : asset.usedBy.length > 0);

  const visibleAssets = () => {
    return assets.filter((asset) => {
      if (selectedProject) {
        const inProject = selectedProject === UNASSIGNED
          ? asset.usedBy.length === 0
          : asset.usedBy.includes(selectedProject);
        if (!inProject) return false;
      }
      const onPage = onPageFor(asset);
      if (filter === 'onPage' && !onPage) return false;
      if (filter === 'library' && onPage) return false;
      return true;
    });
  };

  const THUMB_WIDTH = 320;
  const THUMB_ROOT_MARGIN = '250px';

  /** @type {IntersectionObserver | null} */
  let thumbObserver = null;

  const thumbUrlFor = (asset) => {
    const lower = asset.filename.toLowerCase();
    if (lower.endsWith('.svg') || lower.endsWith('.gif')) return asset.url;
    return `${asset.url}?w=${THUMB_WIDTH}`;
  };

  const disconnectThumbObserver = () => {
    thumbObserver?.disconnect();
    thumbObserver = null;
  };

  const setupThumbObserver = () => {
    disconnectThumbObserver();
    if (!(gridEl instanceof HTMLElement)) return;

    thumbObserver = ownObserver(new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const img = entry.target;
        if (!(img instanceof HTMLImageElement)) continue;
        const src = img.dataset.thumbSrc;
        if (src && !img.hasAttribute('src')) {
          img.src = src;
        }
        thumbObserver?.unobserve(img);
      }
    }, { root: gridEl, rootMargin: THUMB_ROOT_MARGIN }));

    gridEl.querySelectorAll('.dev-asset-manager__thumb img[data-thumb-src]').forEach((img) => {
      thumbObserver?.observe(img);
    });
  };

  const syncSelectionUI = () => {
    if (!(gridEl instanceof HTMLElement)) return;
    gridEl.querySelectorAll('[data-asset-id]').forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      const id = card.dataset.assetId || '';
      const isSelected = selected.has(id);
      card.classList.toggle('is-selected', isSelected);
      const thumb = card.querySelector('.dev-asset-manager__thumb');
      if (thumb instanceof HTMLButtonElement) {
        thumb.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      }
    });
  };

  const setAssetManagerOpen = (open) => {
    document.documentElement.classList.toggle('is-dev-asset-manager-open', open);
    if (open) {
      document.dispatchEvent(new CustomEvent('dev:clear-gap-proximity'));
    }
  };

  const renderProjects = () => {
    if (!(projectsEl instanceof HTMLElement)) return;
    projectsEl.replaceChildren();
    const pageSlug = currentPageSlug();
    for (const project of projects) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'dev-asset-manager__project';
      button.dataset.assetProject = project.slug;
      button.classList.toggle('is-active', project.slug === selectedProject);
      button.classList.toggle('is-current-page', project.slug === pageSlug);
      if (project.slug === pageSlug) {
        button.title = `${project.title} (this page)`;
      }

      const label = document.createElement('span');
      label.className = 'dev-asset-manager__project-label';
      label.textContent = project.title;
      button.append(label);

      scope.listen(button, 'click', () => {
        selectedProject = project.slug;
        selected.clear();
        renderProjects();
        renderGrid();
        syncPickButtons();
      });
      projectsEl.append(button);
    }
  };

  const renderGrid = () => {
    if (!(gridEl instanceof HTMLElement)) return;
    const list = visibleAssets();
    disconnectThumbObserver();
    gridEl.replaceChildren();

    if (!list.length) {
      setStatus(filter === 'library'
        ? 'No library-only images for this project.'
        : filter === 'onPage'
          ? 'No on-page images for this project.'
          : 'No images for this project yet.');
      return;
    }

    setStatus(`${list.length} image${list.length === 1 ? '' : 's'}`);

    for (const asset of list) {
      const onPage = onPageFor(asset);
      const card = document.createElement('div');
      card.className = 'dev-asset-manager__card';
      card.dataset.assetId = asset.id;
      card.classList.toggle('is-selected', selected.has(asset.id));
      card.classList.toggle('is-library', !onPage);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'dev-asset-manager__thumb';
      button.title = asset.filename;
      button.setAttribute('aria-label', `${asset.filename}${onPage ? '' : ' (library only)'}`);
      button.setAttribute('aria-pressed', selected.has(asset.id) ? 'true' : 'false');
      button.draggable = true;

      const img = document.createElement('img');
      img.alt = '';
      img.decoding = 'async';
      img.dataset.thumbSrc = thumbUrlFor(asset);
      button.append(img);

      const badge = document.createElement('span');
      badge.className = 'dev-asset-manager__badge';
      badge.textContent = onPage ? 'On page' : 'Library';
      card.append(badge);

      const trash = document.createElement('button');
      trash.type = 'button';
      trash.className = 'dev-asset-manager__trash';
      trash.title = 'Delete from cloud';
      trash.setAttribute('aria-label', `Delete ${asset.filename} from cloud`);
      trash.innerHTML = sizeIcon(trashIcon);

      scope.listen(button, 'click', () => {
        if (!pickMode) {
          if (selected.has(asset.id)) selected.delete(asset.id);
          else {
            selected.clear();
            selected.add(asset.id);
          }
        } else if (selected.has(asset.id)) {
          selected.delete(asset.id);
        } else if (pickMax === 1) {
          selected.clear();
          selected.add(asset.id);
        } else {
          selected.add(asset.id);
        }
        syncSelectionUI();
        syncPickButtons();
      });

      scope.listen(button, 'dragstart', (event) => {
        if (!event.dataTransfer) return;
        event.dataTransfer.setData(ASSET_DRAG_TYPE, asset.src);
        event.dataTransfer.effectAllowed = 'copy';
      });

      scope.listen(trash, 'click', (event) => {
        event.stopPropagation();
        void deleteAsset(asset);
      });

      card.append(button, trash);
      gridEl.append(card);
    }

    setupThumbObserver();
  };

  const loadAssets = async () => {
    setStatus('Loading…');
    const response = await pageFetch('/api/assets');
    const payload = await response.json();
      scope.signal.throwIfAborted();
    if (!response.ok) throw new Error(payload.error || 'Could not load assets.');
    projects = Array.isArray(payload.projects) ? payload.projects : [];
    assets = Array.isArray(payload.assets) ? payload.assets : [];

    if (!selectedProject || !projects.some((project) => project.slug === selectedProject)) {
      const slug = currentPageSlug();
      selectedProject = slug && projects.some((project) => project.slug === slug)
        ? slug
        : (projects.find((project) => project.slug !== UNASSIGNED)?.slug || projects[0]?.slug || '');
    }

    renderProjects();
    renderGrid();
    syncPickButtons();
  };

  const deleteAsset = async (asset) => {
    const ok = window.confirm(`Delete “${asset.filename}” forever?\n\nThis removes the file from disk and any places it appears on the site.`);
    if (!ok) return;
    try {
      const response = await pageFetch('/api/assets', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ src: asset.src }),
      });
      const payload = await response.json();
      scope.signal.throwIfAborted();
      if (!response.ok) throw new Error(payload.error || 'Could not delete that asset.');
      selected.delete(asset.id);
      // Gone from disk for good — there is nothing to stage or revert, but the
      // content surface moved, so the save bar's unpublished count has to catch up.
      window.dispatchEvent(new CustomEvent('vcd:dev-content-written'));
      await loadAssets();
      setStatus(`Deleted ${asset.filename}.`);
    } catch (error) {
      if (scope.signal.aborted) return;
      window.alert(error instanceof Error ? error.message : 'Could not delete that asset.');
    }
  };

  const clearPickSession = () => {
    pickOpener = null;
    resolvePick = null;
    rejectPick = null;
    pickMax = null;
  };

  const findPickOpener = (detail) => {
    if (detail.opener instanceof HTMLElement) return detail.opener;
    /** @type {HTMLElement | null} */
    let best = null;
    let bestZ = -Infinity;
    document.querySelectorAll('[data-dev-overlay]').forEach((panel) => {
      if (!(panel instanceof HTMLElement) || panel === overlay) return;
      if (panel.hasAttribute('data-embedded')) return;
      if (panel.hidden) return;
      const z = Number.parseFloat(getComputedStyle(panel).zIndex);
      const zValue = Number.isFinite(z) ? z : 0;
      if (zValue >= bestZ) {
        bestZ = zValue;
        best = panel;
      }
    });
    return best;
  };

  const closePanel = (cancelled = true) => {
    if (overlay instanceof HTMLElement) overlay.hidden = true;
    setAssetManagerOpen(false);
    const reject = cancelled ? rejectPick : null;
    clearPickSession();
    if (reject) reject(new Error('cancelled'));
  };

  const confirmPick = () => {
    // Iterate the Set so order matches click selection, not grid order.
    const byId = new Map(assets.map((asset) => [asset.id, asset]));
    const srcs = [...selected]
      .map((id) => byId.get(id)?.src)
      .filter(Boolean);
    if (!srcs.length) return;
    const resolve = resolvePick;
    clearPickSession();
    if (overlay instanceof HTMLElement) overlay.hidden = true;
    setAssetManagerOpen(false);
    resolve?.({ srcs, type: pickType });
  };

  filterButtons.forEach((button) => {
    scope.listen(button, 'click', () => {
      const next = button.getAttribute('data-asset-filter');
      if (next !== 'all' && next !== 'onPage' && next !== 'library') return;
      filter = next;
      filterButtons.forEach((entry) => {
        entry.classList.toggle('is-active', entry.getAttribute('data-asset-filter') === filter);
      });
      selected.clear();
      renderGrid();
      syncPickButtons();
    });
  });

  scope.listen(selectButton, 'click', () => confirmPick());

  scope.listen(cancelButton, 'click', () => closePanel(true));

  // DevOverlay's own traffic-light Hide bypasses closePanel() entirely — it
  // sets `overlay.hidden = true` internally and announces itself here, which
  // is the one place a pending pick still needs to be rejected.
  scope.listen(window, 'vcd:dev-edit-close', ((event) => {
    const detail = event.detail ?? {};
    if (detail.panel !== overlay) return;
    setAssetManagerOpen(false);
    if (rejectPick) {
      const reject = rejectPick;
      clearPickSession();
      reject(new Error('cancelled'));
    } else {
      pickOpener = null;
    }
  }));

  scope.listen(document, 'pointerdown', (event) => {
    if (!pickMode || !pickOpener) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (!pickOpener.contains(target)) return;
    if (overlay instanceof Node && overlay.contains(target)) return;
    closePanel(true);
  }, true);

  scope.listen(window, 'vcd:dev-asset-manager-open', ((event) => {
    const detail = event.detail ?? {};

    if (rejectPick) {
      rejectPick(new Error('cancelled'));
      clearPickSession();
    }

    pickMode = detail.mode !== 'browse';
    if (typeof detail.max === 'number' && detail.max >= 1) {
      pickMax = detail.max;
    } else {
      pickMax = null;
    }
    // Always reset — a prior carousel pick must not stick when type is omitted.
    pickType = (
      detail.type === 'image'
      || detail.type === 'imageGrid'
      || detail.type === 'imageCarousel'
    )
      ? detail.type
      : 'image';
    resolvePick = typeof detail.resolve === 'function' ? detail.resolve : null;
    rejectPick = typeof detail.reject === 'function' ? detail.reject : null;
    pickOpener = pickMode ? findPickOpener(detail) : null;
    selected.clear();
    selectedProject = detail.project || detail.documentKey || selectedProject;
    filter = 'all';
    filterButtons.forEach((entry) => {
      entry.classList.toggle('is-active', entry.getAttribute('data-asset-filter') === 'all');
    });
    syncPickButtons();

    if (overlay instanceof HTMLElement) {
      overlay.hidden = false;
      setAssetManagerOpen(true);
    }
    void loadAssets().catch((error) => {
      if (scope.signal.aborted) return;
      setStatus(error instanceof Error ? error.message : 'Could not load assets.');
    });
  }));

  const isTypingTarget = (target) => {
    const el = target instanceof HTMLElement ? target : null;
    return Boolean(el && (el.isContentEditable || el.closest('input, textarea, select')));
  };

  scope.listen(document, 'keydown', (event) => {
    if (!(event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyA')) return;
    if (isTypingTarget(event.target)) return;

    if (overlay instanceof HTMLElement && !overlay.hidden) {
      event.preventDefault();
      return;
    }

    event.preventDefault();
    window.dispatchEvent(new CustomEvent('vcd:dev-mode-request', { detail: { active: true } }));
    const slug = currentPageSlug();
    window.dispatchEvent(new CustomEvent('vcd:dev-asset-manager-open', {
      detail: { mode: 'browse', documentKey: slug, project: slug },
    }));
    if (overlay instanceof HTMLElement) {
      const { x, y } = getLastPointerPosition();
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-open-at', {
        detail: { panel: overlay, clientX: x, clientY: y },
      }));
    }
  });
    scope.add(() => closePanel(true));
    return () => scope.destroy();
  });
  import.meta.hot?.dispose(dispose);
</script>
