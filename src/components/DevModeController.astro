<script>
  const initDevModeController = () => {
    const SECTION_EDITOR_CLASS = 'show-section-nav-editor';
    const CHROME_FADE_MS = 280;
    const CHROME_CUE_HOLD_MS = 320;

    const html = document.documentElement;
    let devMode = false;
    let enterEndTimer: ReturnType<typeof setTimeout> | null = null;
    let cueEndTimer: ReturnType<typeof setTimeout> | null = null;
    let settlingEndTimer: ReturnType<typeof setTimeout> | null = null;
    let exitTimer: ReturnType<typeof setTimeout> | null = null;

    const editTriggers = () =>
      [...document.querySelectorAll<HTMLButtonElement>('[data-dev-edit-trigger]')];
    const modeOnlyControls = () =>
      [...document.querySelectorAll<HTMLElement>('[data-dev-mode-only]')];
    const devPanels = () =>
      [...document.querySelectorAll<HTMLElement>('[data-dev-panel-key]')]
        .filter((panel) => !panel.hasAttribute('data-embedded'));
    const imageTargets = () =>
      [...document.querySelectorAll<HTMLElement>('[data-dev-image-target]')];

    const isSectionEditor = () =>
      html.classList.contains(SECTION_EDITOR_CLASS);

    const hasSectionNav = () =>
      Boolean(document.querySelector('[data-section-nav-root]'));

    /*
      Alt+M launcher. Every enumerated panel opens on click — including the
      context-bound ones (image, grid, caption, carousel, colour token, outline
      marker, project settings). Those open as a bare shell: their
      vcd:dev-edit-open handlers no-op without detail.trigger (audited
      2026-08-25 — all guard with `!trigger` / `if (target)` early returns),
      so a targetless dispatch is safe and binds nothing.
    */
    let launcher: HTMLElement | null = null;

    const removeLauncher = () => {
      launcher?.remove();
      launcher = null;
    };

    const openLauncherPanel = (panel: HTMLElement) => {
      removeLauncher();
      if (panel.dataset.devPanelKey === 'asset-manager') {
        window.dispatchEvent(new CustomEvent('vcd:dev-asset-manager-open', {
          detail: { mode: 'browse', documentKey: panel.dataset.documentKey || '' },
        }));
        return;
      }
      panel.hidden = false;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', {
        detail: { panel },
      }));
    };

    const toggleLauncher = () => {
      if (launcher) {
        removeLauncher();
        return;
      }
      const panels = devPanels();
      if (!panels.length) return;

      const menu = document.createElement('div');
      menu.className = 'dev-launcher';
      menu.setAttribute('role', 'menu');

      panels.forEach((panel, index) => {
        const key = panel.dataset.devPanelKey || '';
        const title = panel.querySelector('.dev-overlay__title')?.textContent?.trim() || key;
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'dev-btn dev-btn--page dev-btn--align-start dev-btn--fill';
        item.setAttribute('role', 'menuitem');
        item.textContent = title;
        item.addEventListener('click', () => openLauncherPanel(panel));
        if (index === 0) item.tabIndex = 0;
        menu.appendChild(item);
      });

      const enabled = [...menu.querySelectorAll<HTMLButtonElement>('button')];
      menu.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        if (!enabled.length) return;
        const current = enabled.indexOf(document.activeElement as HTMLButtonElement);
        const next = event.key === 'ArrowDown'
          ? (current + 1) % enabled.length
          : (current - 1 + enabled.length) % enabled.length;
        enabled[next].focus();
      });

      document.body.appendChild(menu);
      launcher = menu;
      (enabled[0] ?? menu.querySelector('button'))?.focus();
    };

    /*
      Not reduced-motion-gated. Entering and exiting dev mode is entirely
      opacity — the chrome fades, and the layout cue is an ::after ring fading
      in; nothing travels or resizes. Returning 0 here made enterDevMode skip
      the transition classes outright and exitDevMode snap, which removed the
      one kind of motion that is safe to keep. Suppress movement, not fades.
    */
    const chromeFadeMs = () => CHROME_FADE_MS;

    const clearChromeTransitionClasses = () => {
      html.classList.remove(
        'is-dev-mode-entering',
        'is-dev-mode-settling',
        'is-dev-mode-exiting',
        'is-dev-mode-cue',
      );
    };

    const clearChromeTimers = () => {
      if (enterEndTimer) clearTimeout(enterEndTimer);
      enterEndTimer = null;
      if (cueEndTimer) clearTimeout(cueEndTimer);
      cueEndTimer = null;
      if (settlingEndTimer) clearTimeout(settlingEndTimer);
      settlingEndTimer = null;
      if (exitTimer) clearTimeout(exitTimer);
      exitTimer = null;
    };

    const abortChromeTransition = () => {
      clearChromeTimers();
      clearChromeTransitionClasses();
    };

    const setSectionEditor = (active: boolean) => {
      const next = Boolean(active) && devMode;
      const was = isSectionEditor();
      html.classList.toggle(SECTION_EDITOR_CLASS, next);
      if (was === next) return;
      window.dispatchEvent(new CustomEvent('vcd:section-nav-editor-change', {
        detail: { active: next },
      }));
    };

    const requestDevModeExit = () => {
      const beforeExit = new CustomEvent('vcd:dev-mode-before-exit', { cancelable: true });
      window.dispatchEvent(beforeExit);
      return !beforeExit.defaultPrevented;
    };

    /** Mirror open tuners onto <html> so page chrome (gap chips) can step aside. */
    const syncTunerOpenClass = () => {
      const open = devPanels().some((panel) => !panel.hidden);
      html.classList.toggle('is-dev-tuner-open', open);
    };

    const syncDevModeControls = (active: boolean) => {
      editTriggers().forEach((trigger) => {
        trigger.disabled = !active;
      });
      modeOnlyControls().forEach((control) => {
        control.hidden = !active;
      });

      if (!active) {
        setSectionEditor(false);
        devPanels().forEach((panel) => {
          panel.hidden = true;
        });
        imageTargets().forEach((target) => {
          target.classList.remove('is-dev-image-selected');
        });
      }
      syncTunerOpenClass();
    };

    const emitDevModeChange = (active: boolean) => {
      window.dispatchEvent(new CustomEvent('vcd:dev-mode-change', {
        detail: { active },
      }));
    };

    const setDevModeImmediate = (active: boolean) => {
      abortChromeTransition();
      devMode = active;
      html.classList.toggle('is-dev-mode', active);
      syncDevModeControls(active);
      emitDevModeChange(active);
    };

    const scheduleEnterAnimations = () => {
      const fadeMs = chromeFadeMs();
      if (!fadeMs) {
        html.classList.remove('is-dev-mode-entering', 'is-dev-mode-settling', 'is-dev-mode-cue');
        return;
      }

      enterEndTimer = setTimeout(() => {
        html.classList.remove('is-dev-mode-entering');
        enterEndTimer = null;
      }, fadeMs);

      cueEndTimer = setTimeout(() => {
        html.classList.remove('is-dev-mode-cue');
        cueEndTimer = null;
        // Let the ::after ring fade out before mounting real text/drop-zone outlines.
        settlingEndTimer = setTimeout(() => {
          html.classList.remove('is-dev-mode-settling');
          settlingEndTimer = null;
        }, fadeMs);
      }, fadeMs + CHROME_CUE_HOLD_MS);
    };

    const enterDevMode = () => {
      abortChromeTransition();
      const fadeMs = chromeFadeMs();

      devMode = true;
      html.classList.add('is-dev-mode');
      if (fadeMs > 0) {
        // Settling holds outline/text chrome steady until the layout cue finishes.
        html.classList.add('is-dev-mode-entering', 'is-dev-mode-settling');
      }
      syncDevModeControls(true);
      emitDevModeChange(true);

      if (fadeMs === 0) return;

      // Two frames: paint dev-mode shell, then fade the layout cue in via ::after opacity.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          html.classList.add('is-dev-mode-cue');
        });
      });
      scheduleEnterAnimations();
    };

    const exitDevMode = () => {
      abortChromeTransition();
      const fadeMs = chromeFadeMs();

      if (fadeMs === 0) {
        setDevModeImmediate(false);
        return;
      }

      html.classList.add('is-dev-mode-exiting');
      html.classList.remove('is-dev-mode-cue', 'is-dev-mode-entering', 'is-dev-mode-settling');

      exitTimer = setTimeout(() => {
        devMode = false;
        html.classList.remove('is-dev-mode', 'is-dev-mode-exiting');
        syncDevModeControls(false);
        emitDevModeChange(false);
        exitTimer = null;
      }, fadeMs);
    };

    const setDevMode = (active: boolean) => {
      if (active) {
        if (devMode && !html.classList.contains('is-dev-mode-exiting')) return;
        if (html.classList.contains('is-dev-mode-exiting')) {
          abortChromeTransition();
          devMode = true;
          html.classList.add('is-dev-mode');
          syncDevModeControls(true);
          emitDevModeChange(true);
          return;
        }
        if (!devMode) enterDevMode();
        return;
      }

      if (!devMode && !html.classList.contains('is-dev-mode')) return;
      if (!requestDevModeExit()) return;
      if (html.classList.contains('is-dev-mode-exiting')) return;
      exitDevMode();
    };

    html.classList.remove(SECTION_EDITOR_CLASS);
    setDevModeImmediate(devMode);

    window.addEventListener('vcd:dev-mode-request', ((event: CustomEvent<{ active?: boolean }>) => {
      if (typeof event.detail?.active === 'boolean') setDevMode(event.detail.active);
    }) as EventListener);

    window.addEventListener('vcd:section-nav-editor-request', ((event: CustomEvent<{ active?: boolean }>) => {
      if (typeof event.detail?.active !== 'boolean') return;
      if (event.detail.active && !devMode) setDevMode(true);
      setSectionEditor(event.detail.active);
    }) as EventListener);

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const modeTrigger = target.closest<HTMLElement>('[data-dev-mode-trigger]');
      if (modeTrigger && event.altKey && event.shiftKey) {
        event.preventDefault();
        event.stopImmediatePropagation();
        setDevMode(!devMode);
        return;
      }

      const editTrigger = target.closest<HTMLButtonElement>('[data-dev-edit-trigger]');
      if (editTrigger && devMode) {
        event.preventDefault();
        event.stopImmediatePropagation();
        const panelKey = editTrigger.dataset.devEditTrigger;
        const panel = devPanels().find((candidate) => candidate.dataset.devPanelKey === panelKey);
        if (!panel) return;
        removeLauncher();
        panel.hidden = !panel.hidden;
        if (!panel.hidden) {
          window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', {
            detail: { trigger: editTrigger, panel },
          }));
          window.dispatchEvent(new Event('resize'));
        } else {
          window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
            detail: { trigger: editTrigger, panel },
          }));
        }
        return;
      }

      if (!devMode || !window.matchMedia('(hover: none)').matches) return;

      const imageTarget = target.closest<HTMLElement>('[data-dev-image-target]');
      if (imageTarget && !imageTarget.classList.contains('is-dev-image-selected')) {
        event.preventDefault();
        event.stopImmediatePropagation();
        imageTargets().forEach((candidate) => {
          candidate.classList.toggle('is-dev-image-selected', candidate === imageTarget);
        });
        return;
      }

      if (!imageTarget) {
        imageTargets().forEach((candidate) => {
          candidate.classList.remove('is-dev-image-selected');
        });
      }
    }, true);

    // isContentEditable, not [contenteditable="true"]: editable hosts are set to
    // 'plaintext-only' where the browser supports it (card titles, captions), and
    // the attribute selector misses those — which let Esc in a card title fall
    // through to "leave Dev Mode" instead of leaving the field.
    const frontmostOpenPanel = () => {
      const openPanels = devPanels().filter((panel) => !panel.hidden);
      if (!openPanels.length) return null;
      return openPanels.reduce((front, panel) => {
        const panelZ = Number.parseInt(getComputedStyle(panel).zIndex, 10) || 0;
        const frontZ = Number.parseInt(getComputedStyle(front).zIndex, 10) || 0;
        return panelZ >= frontZ ? panel : front;
      });
    };

    const isTypingTarget = (target: HTMLElement | null) =>
      Boolean(target && (target.isContentEditable || target.closest('input, textarea, select')));

    // Capture so Log issue's Esc-cancel does not fire first. Focused Drop Area
    // blurs back to Rest unless a newer panel is in front (e.g. Asset manager
    // just opened from a Ghost inside the well — first Esc must close that).
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const target = event.target as HTMLElement | null;
      const drop = target?.closest?.('.dev-drop');
      if (!(drop instanceof HTMLElement)) return;
      const active = document.activeElement;
      if (!(active instanceof HTMLElement) || !drop.contains(active)) return;
      const host = drop.closest<HTMLElement>('[data-dev-overlay]');
      const front = frontmostOpenPanel();
      if (front && host && front !== host) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      active.blur();
    }, true);

    document.addEventListener('keydown', (event) => {
      if (event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyM') {
        // Alt+M types 'µ' in an editable — never intercept it there.
        if (!devMode || isTypingTarget(event.target as HTMLElement | null)) return;
        event.preventDefault();
        toggleLauncher();
        return;
      }

      if (launcher) {
        if (event.key === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          removeLauncher();
        }
        return;
      }

      if (event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyD') {
        event.preventDefault();

        // Alt+D only ever turns dev mode *on*. Escape is the way out — the
        // same shortcut toggling both ways made it too easy to drop the whole
        // layer with a stray press, and the section-nav branch below has
        // always behaved this way.
        if (!hasSectionNav()) {
          setSectionEditor(false);
          if (!devMode) setDevMode(true);
          return;
        }

        if (isTypingTarget(event.target as HTMLElement | null)) return;
        if (!devMode) {
          setDevMode(true);
        } else if (!isSectionEditor()) {
          setSectionEditor(true);
        }
        return;
      }

      if (event.key !== 'Escape') return;
      // Page body-text caret: DevTextEditor handles Esc (deselect like click-away)
      // in capture. Other typing targets (tuner fields, etc.) must not fall through
      // to panel-close / leave-Dev-Mode.
      if (isTypingTarget(event.target as HTMLElement | null)) return;

      if (isSectionEditor()) {
        event.preventDefault();
        setSectionEditor(false);
        return;
      }

      if (!devMode) return;
      if (html.classList.contains('is-dev-mode-exiting')) return;

      // Layer Esc: dismiss the frontmost open tuner (highest computed z-index;
      // last in document order on a tie). This is "frontmost panel", not a
      // general interaction-undo stack. Only when none are open does Esc leave
      // the whole Dev Mode layer.
      const frontmost = frontmostOpenPanel();
      if (frontmost) {
        event.preventDefault();
        frontmost.hidden = true;
        window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
          detail: { panel: frontmost },
        }));
        return;
      }

      event.preventDefault();
      setDevMode(false);
    });

    document.addEventListener('pointerdown', (event) => {
      if (!launcher) return;
      const target = event.target as Node | null;
      if (target && launcher.contains(target)) return;
      removeLauncher();
    }, true);

    window.addEventListener('vcd:dev-mode-change', ((event: CustomEvent<{ active?: boolean }>) => {
      if (event.detail?.active === false) removeLauncher();
    }) as EventListener);

    window.addEventListener('vcd:dev-edit-open', syncTunerOpenClass);
    window.addEventListener('vcd:dev-edit-close', syncTunerOpenClass);
    syncTunerOpenClass();
  };

  initDevModeController();
</script>

<style is:global>
  /*
    Layout enter/exit cue: ::after ring on the drop zone only.
  */
  html.is-dev-mode:is(.is-dev-mode-cue, .is-dev-mode-settling, .is-dev-mode-exiting)
    [data-dev-project-drop-zone]:not(.is-section-order-dirty)::after {
    content: '';
    position: absolute;
    inset: -0.75em;
    border: 2px dashed color-mix(in srgb, var(--sys-color-on-srf-variant) 55%, transparent);
    border-radius: 0.15em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
    z-index: 0;
  }

  html.is-dev-mode.is-dev-mode-cue [data-dev-project-drop-zone]:not(.is-section-order-dirty)::after {
    opacity: 1;
  }

  html.is-dev-mode-entering .dev-section-drag-handle,
  html.is-dev-mode-entering .dev-section-delete,
  html.is-dev-mode-entering .dev-image-edit-trigger,
  html.is-dev-mode-entering .dev-caption-add-trigger,
  html.is-dev-mode-entering .dev-grid-edit-trigger,
  html.is-dev-mode-entering .project-grid__chips,
  html.is-dev-mode-entering .dev-gap-toolbar__pill,
  html.is-dev-mode-entering .dev-text-actions,
  html.is-dev-mode-exiting .dev-section-drag-handle,
  html.is-dev-mode-exiting .dev-section-delete,
  html.is-dev-mode-exiting .dev-image-edit-trigger,
  html.is-dev-mode-exiting .dev-caption-add-trigger,
  html.is-dev-mode-exiting .dev-grid-edit-trigger,
  html.is-dev-mode-exiting .project-grid__chips,
  html.is-dev-mode-exiting .dev-gap-toolbar__pill,
  html.is-dev-mode-exiting .dev-text-actions {
    opacity: 0 !important;
    pointer-events: none !important;
    transition:
      opacity 0.28s ease 0s,
      background-color 0.15s ease 0s,
      box-shadow 0.15s ease 0s !important;
  }

  /* No reduced-motion override for the dev chrome above: entering and exiting
     dev mode only changes opacity, and a fade is the reduced-motion-appropriate
     way to swap state — the same pattern iOS uses when it crossfades an app
     switch instead of sliding it. Suppress movement, not fades. */
</style>
