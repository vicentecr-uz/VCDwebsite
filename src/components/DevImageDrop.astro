---
import DevOverlay from './DevOverlay.astro';
import Button from './ui/Button.astro';
import PanelActions from './ui/PanelActions.astro';
import monitorIcon from 'lucide-static/icons/monitor.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import { sizeIcon } from '../lib/icons';

interface Props {
  documentKey: string;
}

const { documentKey } = Astro.props;
const monitorSvg = sizeIcon(monitorIcon, 16);
const globeSvg = sizeIcon(globeIcon, 16);
---

<div class="dev-image-drop" data-dev-image-drop hidden>
  <p data-dev-image-drop-label>Drop images to add</p>
</div>

<div class="dev-image-drop-choice" data-dev-image-drop-choice hidden role="menu">
  <Button
    class="dev-surface"
    type="button"
    emphasis="page"
    align="start"
    width="fill"
    label="Image grid"
    role="menuitem"
    data-dev-image-drop-choice-type="imageGrid"
  />
  <Button
    class="dev-surface"
    type="button"
    emphasis="page"
    align="start"
    width="fill"
    label="Carousel"
    role="menuitem"
    data-dev-image-drop-choice-type="imageCarousel"
  />
</div>

<DevOverlay
  storageKey="add-image"
  panelKey="add-image"
  data-dev-image-picker
  data-document-key={documentKey}
  defaultHidden
>
  <div class="dev-add-image" data-dev-add-image>
    <div class="dev-drop" data-dev-image-dropzone tabindex="0">
      <div class="dev-drop__well">
        <p class="dev-drop__label">Drop/paste here</p>
        <button type="button" class="dev-btn dev-btn--ghost" data-dev-image-choose>
          <span class="dev-btn__icon" aria-hidden="true" set:html={monitorSvg} />
          File system
        </button>
        <button type="button" class="dev-btn dev-btn--ghost" data-dev-image-choose-assets>
          <span class="dev-btn__icon" aria-hidden="true" set:html={globeSvg} />
          Asset manager
        </button>
        <input type="file" accept="image/*,.heic,.heif" multiple hidden data-dev-image-file-input />
      </div>
    </div>

    <p class="dev-add-image__count" data-dev-image-picker-count hidden></p>

    <!-- Shown only when type was not chosen upstream (e.g. page drop of one file). -->
    <div class="dev-add-image__types" data-dev-image-type-actions hidden>
      <Button type="button" emphasis="soft" label="Single image" data-dev-image-pick="image" disabled />
      <Button type="button" emphasis="soft" label="Image grid" data-dev-image-pick="imageGrid" disabled />
      <Button type="button" emphasis="soft" label="Carousel" data-dev-image-pick="imageCarousel" disabled />
    </div>

    <PanelActions>
      <Button type="button" emphasis="ghost" label="Add image placeholder" data-dev-image-placeholder />
      <Button type="button" emphasis="ghost" label="Cancel" data-dev-image-cancel />
    </PanelActions>
  </div>
</DevOverlay>

<script>
  import { devEditPendingId, withDevEditTarget } from '../scripts/devEditTarget';
  import { getLastPointerPosition } from '../lib/lastPointer';
  import { getDropZone } from '../scripts/devSectionPaths';
  import { isAcceptedImageFile } from '../lib/imageUpload.mjs';

  const ASSET_DRAG_TYPE = 'application/x-vcd-asset-src';

  const pageDropVeil = document.querySelector('[data-dev-image-drop]');
  const multiDropChoice = document.querySelector('[data-dev-image-drop-choice]');
  const multiDropChoiceButtons = multiDropChoice?.querySelectorAll('[data-dev-image-drop-choice-type]') ?? [];
  const multiDropChoiceHome = multiDropChoice?.parentNode ?? null;
  const multiDropChoiceNextSibling = multiDropChoice?.nextSibling ?? null;
  const panel = document.querySelector('[data-dev-image-picker]');
  const fallbackDocumentKey = panel instanceof HTMLElement ? (panel.dataset.documentKey || '') : '';
  const pickerCount = document.querySelector('[data-dev-image-picker-count]');
  const dropzone = document.querySelector('[data-dev-image-dropzone]');
  const typeActions = document.querySelector('[data-dev-image-type-actions]');
  const fileInput = document.querySelector('[data-dev-image-file-input]');
  const chooseButton = document.querySelector('[data-dev-image-choose]');
  const chooseAssetsButton = document.querySelector('[data-dev-image-choose-assets]');
  const pickButtons = panel?.querySelectorAll('[data-dev-image-pick]') ?? [];
  const placeholderButton = document.querySelector('[data-dev-image-placeholder]');
  const cancelButton = document.querySelector('[data-dev-image-cancel]');
  const titleEl = panel instanceof HTMLElement
    ? panel.querySelector('.dev-overlay__title')
    : null;

  let pendingFiles = [];
  /** @type {string[]} */
  let pendingSrcs = [];
  let pendingInsertIndex = 0;
  /** @type {string | null} */
  let preferredType = null;
  let dragDepth = 0;
  /** @type {HTMLElement | null} */
  let activePlaceholder = null;
  /** Skip reset when we hide this panel to open Asset manager mid-pick. */
  let suppressCloseReset = false;
  /** @type {{ documentKey: string, path: Array<string | number>, target: HTMLElement } | null} */
  let targetedCarousel = null;
  /** @type {{ documentKey: string, path: Array<string | number>, target: HTMLElement } | null} */
  let targetedGrid = null;
  /** @type {HTMLElement | null} */
  let activeCarouselDrop = null;
  /** @type {HTMLElement | null} */
  let multiDropChoiceHost = null;
  /** @type {{ documentKey: string, dropZone: HTMLElement | null } | null} */
  let activeTransaction = null;

  const isUsableZone = (zone) => (
    zone instanceof HTMLElement
    && !zone.hidden
    && !zone.closest('[hidden], [inert]')
  );

  const documentKeyForZone = (zone) => {
    if (!(zone instanceof HTMLElement)) return fallbackDocumentKey;
    if (zone.dataset.pageDocument) return zone.dataset.pageDocument;
    const source = zone.querySelector('[data-dev-spacing-document], [data-dev-text-document]');
    return source instanceof HTMLElement
      ? (source.dataset.devSpacingDocument || source.dataset.devTextDocument || fallbackDocumentKey)
      : fallbackDocumentKey;
  };

  const zoneForElement = (element) => {
    if (!(element instanceof Element)) return null;
    const zone = element.closest('[data-dev-project-drop-zone]');
    return isUsableZone(zone) ? zone : null;
  };

  const beginTransaction = (requestedDocumentKey, element) => {
    const requestedZone = requestedDocumentKey ? getDropZone(requestedDocumentKey) : zoneForElement(element);
    if (requestedDocumentKey && !isUsableZone(requestedZone)) return null;
    const zone = isUsableZone(requestedZone) ? requestedZone : getDropZone();
    if (!isUsableZone(zone)) return null;
    const documentKey = requestedDocumentKey || documentKeyForZone(zone);
    activeTransaction = { documentKey, dropZone: zone };
    return activeTransaction;
  };

  const currentTransaction = () => activeTransaction || beginTransaction();

  const dropLabel = pageDropVeil instanceof HTMLElement
    ? pageDropVeil.querySelector('[data-dev-image-drop-label]')
    : null;

  const clearPlaceholderTarget = () => {
    if (activePlaceholder) delete activePlaceholder.dataset.devDropTarget;
    activePlaceholder = null;
    document.documentElement.removeAttribute('data-dev-placeholder-drop');
    if (dropLabel instanceof HTMLElement) dropLabel.textContent = 'Drop images to add';
  };

  const clearCarouselDropTarget = () => {
    const target = activeCarouselDrop;
    activeCarouselDrop = null;
    if (!target) return;
    delete target.dataset.devCarouselDropActive;
    const veil = target.querySelector('.dev-carousel-drop-veil');
    if (!(veil instanceof HTMLElement)) return;
    veil.classList.remove('is-active');
    const remove = () => veil.remove();
    veil.addEventListener('transitionend', remove, { once: true });
    window.setTimeout(remove, 200);
  };

  const setCarouselDropTarget = (target) => {
    if (activeCarouselDrop === target) return;
    clearCarouselDropTarget();
    activeCarouselDrop = target;
    if (!target) return;
    target.dataset.devCarouselDropActive = 'true';
    const activeIndex = Number(target.dataset.activeIndex);
    const activeSlide = Number.isInteger(activeIndex)
      ? target.querySelector(
        `[data-carousel-slide][data-carousel-index="${activeIndex}"]:not([data-carousel-parked])`,
      )
      : null;
    const visibleSlide = activeSlide instanceof HTMLElement
      ? activeSlide
      : target.querySelector('[data-carousel-slide]:not([data-carousel-parked])');
    const frame = visibleSlide instanceof HTMLElement
      ? visibleSlide.querySelector('[data-carousel-frame]')
      : null;
    if (!(frame instanceof HTMLElement)) return;
    const veil = document.createElement('div');
    veil.className = 'dev-carousel-drop-veil';
    const slot = document.createElement('div');
    slot.className = 'dev-carousel-drop-veil__slot';
    const label = document.createElement('span');
    label.className = 'dev-carousel-drop-veil__label';
    label.textContent = 'Append to carousel';
    slot.append(label);
    veil.append(slot);
    frame.append(veil);
    void veil.offsetWidth;
    veil.classList.add('is-active');
  };

  const clearDragState = () => {
    document.documentElement.removeAttribute('data-dev-image-drag');
    if (pageDropVeil instanceof HTMLElement) delete pageDropVeil.dataset.active;
    clearCarouselDropTarget();
    clearPlaceholderTarget();
  };

  const closeMultiDropChoice = () => {
    if (multiDropChoice instanceof HTMLElement) {
      multiDropChoice.hidden = true;
      multiDropChoice.classList.remove('is-gap-mounted');
      multiDropChoice.style.removeProperty('left');
      multiDropChoice.style.removeProperty('top');
      if (multiDropChoiceHome) {
        if (
          multiDropChoiceNextSibling
          && multiDropChoiceNextSibling.parentNode === multiDropChoiceHome
        ) {
          multiDropChoiceHome.insertBefore(multiDropChoice, multiDropChoiceNextSibling);
        } else {
          multiDropChoiceHome.append(multiDropChoice);
        }
      }
    }
    multiDropChoiceHost?.classList.remove('is-media-choice-open');
    multiDropChoiceHost = null;
    document.documentElement.removeAttribute('data-dev-image-drop-choice-open');
    pendingFiles = [];
  };

  const showMultiDropChoice = (clientX, clientY) => {
    if (!(multiDropChoice instanceof HTMLElement)) return;
    document.documentElement.dataset.devImageDropChoiceOpen = 'true';
    document.dispatchEvent(new CustomEvent('dev:clear-gap-proximity'));
    const gapToolbar = gapToolbarForInsertIndex(pendingInsertIndex);
    if (gapToolbar) {
      multiDropChoiceHost = gapToolbar;
      gapToolbar.classList.add('is-media-choice-open');
      multiDropChoice.classList.add('is-gap-mounted');
      gapToolbar.append(multiDropChoice);
      multiDropChoice.hidden = false;
      const first = multiDropChoiceButtons[0];
      if (first instanceof HTMLButtonElement) first.focus();
      return;
    }
    multiDropChoice.hidden = false;
    const rect = multiDropChoice.getBoundingClientRect();
    const gapAnchor = gapAnchorForInsertIndex(pendingInsertIndex);
    const anchorX = gapAnchor?.x ?? clientX;
    const anchorY = gapAnchor?.y ?? clientY;
    const left = Math.min(
      Math.max(8, anchorX - rect.width / 2),
      Math.max(8, window.innerWidth - rect.width - 8),
    );
    const top = Math.min(
      Math.max(8, anchorY - rect.height / 2),
      Math.max(8, window.innerHeight - rect.height - 8),
    );
    multiDropChoice.style.left = `${left}px`;
    multiDropChoice.style.top = `${top}px`;
    const first = multiDropChoiceButtons[0];
    if (first instanceof HTMLButtonElement) first.focus();
  };

  const carouselAtPoint = (clientX, clientY) => {
    const hit = document.elementFromPoint(clientX, clientY);
    if (!(hit instanceof Element)) return null;
    if (!zoneForElement(hit)) return null;
    return hit.closest('[data-dev-carousel-target]');
  };

  const carouselTargetFromElement = (target) => {
    if (!(target instanceof HTMLElement)) return null;
    const targetDocumentKey = target.dataset.devDocument || '';
    try {
      const path = JSON.parse(target.dataset.devCarouselPath || '[]');
      if (!targetDocumentKey || !Array.isArray(path) || !path.length) return null;
      return { documentKey: targetDocumentKey, path, target };
    } catch {
      return null;
    }
  };

  const placeholderAtPoint = (clientX, clientY) => {
    const hit = document.elementFromPoint(clientX, clientY);
    if (!(hit instanceof Element)) return null;
    if (!zoneForElement(hit)) return null;
    const figure = hit.closest('.project-media--placeholder');
    if (!(figure instanceof HTMLElement)) return null;
    return figure;
  };

  const setPlaceholderTarget = (figure) => {
    if (activePlaceholder === figure) return;
    if (activePlaceholder) delete activePlaceholder.dataset.devDropTarget;
    activePlaceholder = figure;
    if (figure) {
      figure.dataset.devDropTarget = 'true';
      document.documentElement.dataset.devPlaceholderDrop = 'true';
      if (dropLabel instanceof HTMLElement) dropLabel.textContent = 'Drop to fill placeholder';
    } else {
      document.documentElement.removeAttribute('data-dev-placeholder-drop');
      if (dropLabel instanceof HTMLElement) dropLabel.textContent = 'Drop images to add';
    }
  };

  const syncVisibility = () => {
    const devMode = document.documentElement.classList.contains('is-dev-mode');
    if (pageDropVeil instanceof HTMLElement) pageDropVeil.hidden = !devMode;
    if (!devMode) {
      dragDepth = 0;
      clearDragState();
      closeMultiDropChoice();
      if (panel instanceof HTMLElement) panel.hidden = true;
    }
  };

  const spacingBlocks = (zone = currentTransaction().dropZone) => Array.from(
    (zone || document).querySelectorAll('[data-dev-spacing-document]'),
  );

  const spacingBlockForInsertIndex = (insertIndex, zone) => spacingBlocks(zone).find((block) => {
    try {
      const path = JSON.parse(block.dataset.devSpacingPath || '[]');
      return path.at(-2) === insertIndex;
    } catch {
      return false;
    }
  });

  const gapToolbarForInsertIndex = (insertIndex, zone) => {
    const block = spacingBlockForInsertIndex(insertIndex, zone);
    if (!(block instanceof HTMLElement)) return null;
    const toolbar = block.querySelector(':scope > .dev-gap-toolbar');
    return toolbar instanceof HTMLElement ? toolbar : null;
  };

  const gapAnchorForInsertIndex = (insertIndex, zone = currentTransaction().dropZone) => {
    const indexed = spacingBlocks(zone).map((block) => {
      try {
        const path = JSON.parse(block.dataset.devSpacingPath || '[]');
        const sectionIndex = path.at(-2);
        return { block, sectionIndex: typeof sectionIndex === 'number' ? sectionIndex : null };
      } catch {
        return { block, sectionIndex: null };
      }
    }).filter((entry) => entry.block instanceof HTMLElement && typeof entry.sectionIndex === 'number')
      .sort((a, b) => a.sectionIndex - b.sectionIndex);
    const matchingIndex = indexed.findIndex((entry) => entry.sectionIndex === insertIndex);
    const matching = matchingIndex >= 0 ? indexed[matchingIndex] : null;
    const last = indexed.at(-1);
    let anchorY = null;
    if (matching) {
      const nextTop = matching.block.getBoundingClientRect().top;
      const previous = indexed[matchingIndex - 1];
      if (previous) {
        anchorY = (previous.block.getBoundingClientRect().bottom + nextTop) / 2;
      } else {
        const anchorRoot = zone instanceof HTMLElement
          ? zone
          : document.querySelector('main');
        const rootTop = anchorRoot instanceof HTMLElement
          ? anchorRoot.getBoundingClientRect().top
          : nextTop;
        anchorY = rootTop === nextTop ? nextTop : (rootTop + nextTop) / 2;
      }
    } else if (last && insertIndex === last.sectionIndex + 1) {
      anchorY = last.block.getBoundingClientRect().bottom;
    }
    if (anchorY == null) return null;
    const zoneRect = zone instanceof HTMLElement ? zone.getBoundingClientRect() : null;
    return {
      x: zoneRect ? zoneRect.left + zoneRect.width / 2 : window.innerWidth / 2,
      y: anchorY,
    };
  };

  const insertIndexForY = (clientY, zone = currentTransaction().dropZone) => {
    const blocks = spacingBlocks(zone).filter((block) => !block.dataset.devSpacingWritePath);
    if (!blocks.length) return 0;
    for (let index = 0; index < blocks.length; index += 1) {
      const rect = blocks[index].getBoundingClientRect();
      if (clientY < rect.top + rect.height / 2) {
        const path = JSON.parse(blocks[index].dataset.devSpacingPath || '[]');
        const sectionIndex = path.at(-2);
        return typeof sectionIndex === 'number' ? sectionIndex : index;
      }
    }
    const last = blocks[blocks.length - 1];
    const path = JSON.parse(last.dataset.devSpacingPath || '[]');
    const sectionIndex = path.at(-2);
    return typeof sectionIndex === 'number' ? sectionIndex + 1 : blocks.length;
  };

  const hasPreferredType = () => (
    preferredType === 'image'
    || preferredType === 'imageGrid'
    || preferredType === 'imageCarousel'
  );

  const hasCarouselTarget = () => Boolean(targetedCarousel);
  const hasGridTarget = () => Boolean(targetedGrid);

  const syncTitle = () => {
    if (!(titleEl instanceof HTMLElement)) return;
    titleEl.textContent = hasCarouselTarget()
      ? 'Add image'
      : preferredType === 'imageGrid' ? 'Add grid'
        : preferredType === 'imageCarousel' ? 'Add carousel' : 'Add image';
  };

  const syncPickerState = () => {
    const fileCount = pendingFiles.length;
    const srcCount = pendingSrcs.length;
    const count = fileCount || srcCount;
    const typedUpstream = hasPreferredType() || hasCarouselTarget() || hasGridTarget();

    syncTitle();

    if (typeActions instanceof HTMLElement) {
      typeActions.hidden = typedUpstream;
    }
    if (placeholderButton instanceof HTMLButtonElement) {
      placeholderButton.disabled = count > 0;
      placeholderButton.textContent = preferredType === 'imageGrid'
        ? 'Add grid placeholder'
        : preferredType === 'imageCarousel' ? 'Add carousel placeholder' : 'Add image placeholder';
    }

    if (pickerCount instanceof HTMLElement) {
      pickerCount.hidden = count === 0 || typedUpstream;
      pickerCount.textContent = srcCount
        ? `${srcCount} asset${srcCount === 1 ? '' : 's'} selected`
        : `${fileCount} file${fileCount === 1 ? '' : 's'} selected`;
    }
    pickButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (srcCount > 0) {
        button.disabled = srcCount < 1;
        return;
      }
      button.disabled = fileCount === 0;
    });
  };

  const resetPickerState = () => {
    pendingFiles = [];
    pendingSrcs = [];
    preferredType = null;
    targetedCarousel = null;
    targetedGrid = null;
    syncPickerState();
  };

  const hidePanel = () => {
    if (panel instanceof HTMLElement) panel.hidden = true;
  };

  const showPanel = (clientY) => {
    if (!(panel instanceof HTMLElement)) return;
    syncPickerState();
    panel.hidden = false;
    // edit-open sets is-dev-tuner-open + clears gap chrome; open-at places the panel.
    window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', {
      detail: { panel },
    }));
    const pointer = getLastPointerPosition();
    const x = pointer.x;
    const y = typeof clientY === 'number' ? clientY : pointer.y;
    window.dispatchEvent(new CustomEvent('vcd:dev-edit-open-at', {
      detail: { panel, clientX: x, clientY: y },
    }));
  };

  const closePicker = () => {
    // Hide type row before preferredType clears — otherwise it flashes mid-fade.
    if (typeActions instanceof HTMLElement) typeActions.hidden = true;
    resetPickerState();
    activeTransaction = null;
    if (panel instanceof HTMLElement) {
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
        detail: { panel },
      }));
    }
  };

  const readFileAsBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const result = String(reader.result || '');
      const base64 = result.includes(',') ? result.split(',')[1] : result;
      resolve(base64);
    };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });

  const flushPendingEdits = (targetDocumentKey) => new Promise((resolve, reject) => {
    window.dispatchEvent(new CustomEvent('vcd:dev-flush-pending-edits', {
      detail: { documentKey: targetDocumentKey, resolve, reject },
    }));
  });

  const uploadFiles = async (files, target = currentTransaction()) => {
    const payload = await Promise.all(files.map(async (file) => ({
      filename: file.name,
      data: await readFileAsBase64(file),
      mimeType: file.type,
    })));
    const response = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ document: target.documentKey, files: payload }),
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Upload failed.');
    return result.filenames;
  };

  const insertSection = async (type, filenames = [], srcs = [], target = currentTransaction()) => {
    if (!target) throw new Error('Could not find the active page.');
    const initialIndex = target.insertIndex ?? pendingInsertIndex;
    await flushPendingEdits(target.documentKey);

    const payloads = type === 'image' && (srcs.length > 1 || filenames.length > 1)
      ? (srcs.length
          ? srcs.map((src) => ({ type: 'image', srcs: [src] }))
          : filenames.map((filename) => ({ type: 'image', filenames: [filename] })))
      : [{
          type,
          ...(srcs.length ? { srcs } : filenames.length ? { filenames } : {}),
        }];

    let index = initialIndex;
    for (const payload of payloads) {
      const response = await fetch('/api/content-section', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          document: target.documentKey,
          index,
          ...payload,
        }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Could not insert images.');
      window.dispatchEvent(new CustomEvent('vcd:dev-section-inserted', {
        detail: {
          documentKey: target.documentKey,
          index,
          section: result.section,
        },
      }));
      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          action: 'insert',
          index,
          type: payload.type,
          section: result.section ?? { type: payload.type },
        },
      }));
      index += 1;
    }

    closePicker();
  };

  const appendToCarousel = async (filenames = [], srcs = [], target = targetedCarousel, placeholder = false) => {
    if (!target) throw new Error('Could not find that carousel.');
    const activeIndex = Number(target.target.dataset.activeIndex);
    const activeSlide = Number.isInteger(activeIndex)
      ? target.target.querySelector(
        `[data-carousel-slide][data-carousel-index="${activeIndex}"]:not([data-carousel-parked])`,
      )
      : null;
    const activeItemId = activeSlide instanceof HTMLElement
      ? activeSlide.dataset.gridItemId || undefined
      : undefined;
    await flushPendingEdits(target.documentKey);
    /** @type {Record<string, any>} */
    let source = {};
    /** @type {string[]} */
    let itemIds = [];
    try {
      const parsedSource = JSON.parse(
        target.target.dataset.devCarouselSettings
        || target.target.dataset.carouselSettings
        || '{}',
      );
      source = parsedSource && typeof parsedSource === 'object' && !Array.isArray(parsedSource)
        ? parsedSource
        : {};
      const items = JSON.parse(target.target.dataset.devCarouselItems || '[]');
      if (Array.isArray(items)) {
        itemIds = items.map((item) => String(item?.id || '')).filter(Boolean);
      }
    } catch {
      throw new Error('Could not read the current carousel settings.');
    }
    const settingsResponse = await fetch('/api/content-batch', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        carousels: [withDevEditTarget({
          document: target.documentKey,
          path: target.path,
          orientation: source.orientation === 'vertical' ? 'vertical' : 'horizontal',
          heightMode: source.heightMode === 'tallest' ? 'tallest' : 'dynamic',
          maxHeightVh: Number(source.maxHeightVh) || 0,
          scrollPinned: source.scrollPinned === true,
          dotsPlacement: ['over', 'hidden'].includes(source.dotsPlacement)
            ? source.dotsPlacement
            : 'outside',
          visible: Array.isArray(source.visible) ? source.visible : itemIds,
          breakpoints: source.breakpoints ?? null,
        }, target.target)],
      }),
    });
    const settingsResult = await settingsResponse.json();
    if (!settingsResponse.ok) {
      throw new Error(settingsResult.error || 'Could not save the current carousel settings.');
    }
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', {
      detail: {
        id: devEditPendingId('carousel', target.target),
      },
    }));
    window.dispatchEvent(new CustomEvent('vcd:dev-carousel-prepare-append', {
      detail: { target: target.target },
    }));
    const response = await fetch('/api/content-section', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        document: target.documentKey,
        action: 'appendMediaItems',
        ...withDevEditTarget({ document: target.documentKey, path: target.path }, target.target),
        ...(placeholder ? { placeholder: true } : srcs.length ? { srcs } : { filenames }),
      }),
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Could not add images to that carousel.');
    window.dispatchEvent(new CustomEvent('vcd:dev-carousel-media-appended', {
      detail: {
        documentKey: target.documentKey,
        index: result.index,
        section: result.section,
        activeItemId,
      },
    }));
  };

  const appendToGrid = async (filenames = [], srcs = [], target = targetedGrid, placeholder = false) => {
    if (!target) throw new Error('Could not find that grid.');
    await flushPendingEdits(target.documentKey);
    let columns;
    let constrained;
    let layouts;
    try {
      columns = JSON.parse(target.target.dataset.devGridColumns || '{}');
      constrained = JSON.parse(target.target.dataset.devGridConstrained || '{}');
      layouts = JSON.parse(target.target.dataset.devGridLayouts || '{}');
    } catch {
      throw new Error('Could not read the current grid settings.');
    }
    if (!columns || typeof columns !== 'object' || Array.isArray(columns)
      || !constrained || typeof constrained !== 'object' || Array.isArray(constrained)
      || !layouts || typeof layouts !== 'object' || Array.isArray(layouts)) {
      throw new Error('Could not read the current grid settings.');
    }
    const settingsResponse = await fetch('/api/content-batch', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ grids: [withDevEditTarget({
        document: target.documentKey,
        path: target.path,
        columns,
        constrained,
        defaultAspectRatio: target.target.dataset.devGridDefaultAspect || '4:3',
        matchHeight: target.target.dataset.devGridMatchHeight === 'true',
        layouts,
      }, target.target)] }),
    });
    const settingsResult = await settingsResponse.json();
    if (!settingsResponse.ok) throw new Error(settingsResult.error || 'Could not save the current grid settings.');
    const pendingId = devEditPendingId('grid', target.target);
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-committed', { detail: { ids: [pendingId] } }));
    const response = await fetch('/api/content-section', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ document: target.documentKey, action: 'appendMediaItems', ...withDevEditTarget({ document: target.documentKey, path: target.path }, target.target), ...(placeholder ? { placeholder: true } : srcs.length ? { srcs } : { filenames }) }),
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Could not add images to that grid.');
    window.dispatchEvent(new CustomEvent('vcd:dev-grid-media-appended', {
      detail: { documentKey: target.documentKey, index: result.index, section: result.section },
    }));
  };

  const pickFromAssetManager = () => new Promise((resolve, reject) => {
    const target = currentTransaction();
    window.dispatchEvent(new CustomEvent('vcd:dev-asset-manager-open', {
      detail: {
        documentKey: target.documentKey,
        project: target.documentKey,
        mode: 'pick',
        opener: panel instanceof HTMLElement ? panel : undefined,
        // Carry Add-block menu choice (Image / Carousel) into the pick session.
        ...(hasCarouselTarget()
          ? { type: 'imageCarousel' }
          : hasGridTarget() ? { type: 'imageGrid' }
          : hasPreferredType() ? { type: preferredType } : {}),
        resolve,
        reject,
      },
    }));
  });

  const openPicker = (clientY, target = currentTransaction()) => {
    if (!target) return;
    if (typeof clientY === 'number') {
      pendingInsertIndex = insertIndexForY(clientY, target.dropZone);
      target.insertIndex = pendingInsertIndex;
    }
    showPanel(clientY);
  };

  const insertWithPreferredType = async (
    filenames = [],
    srcs = [],
    target = currentTransaction(),
    type = preferredType,
    carousel = targetedCarousel,
  ) => {
    if (carousel) {
      await appendToCarousel(filenames, srcs, carousel);
      closePicker();
      return true;
    }
    if (type !== 'image' && type !== 'imageGrid' && type !== 'imageCarousel') return false;
    await insertSection(type, filenames, srcs, target);
    return true;
  };

  const setPendingFiles = (files) => {
    pendingFiles = Array.from(files).filter(isAcceptedImageFile);
    pendingSrcs = [];
    syncPickerState();
  };

  const handleFiles = (files, clientY, clientX, target = currentTransaction()) => {
    if (!target) return;
    const images = Array.from(files).filter(isAcceptedImageFile);
    if (!images.length) return;

    pendingInsertIndex = insertIndexForY(clientY, target.dropZone);
    target.insertIndex = pendingInsertIndex;
    if (images.length === 1) {
      void (async () => {
        try {
          const filenames = await uploadFiles(images, target);
          await insertSection('image', filenames, [], target);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add image.');
        }
      })();
      return;
    }
    pendingFiles = images;
    pendingSrcs = [];
    preferredType = null;
    targetedCarousel = null;
    showMultiDropChoice(clientX, clientY);
  };

  const prevent = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
  };

  const isValidImageDrag = (event) => {
    // Gallery cover drops belong to DevProjectGridEditor.
    if (event.target instanceof Element && event.target.closest('[data-dev-cover-drop]')) return false;
    if (event.target instanceof Element && !zoneForElement(event.target) && getDropZone() == null) return false;
    const transfer = event.dataTransfer;
    if (!transfer) return false;
    if (Array.from(transfer.types || []).includes(ASSET_DRAG_TYPE)) return true;
    if (!Array.from(transfer.types || []).includes('Files')) return false;
    const items = Array.from(transfer.items || []);
    // Dragover does not expose filenames; an empty-MIME file item may be HEIC.
    return !items.length || items.some((item) => item.kind === 'file' && (!item.type || item.type.startsWith('image/')));
  };

  const onDragEnter = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    if (!isValidImageDrag(event)) return;
    if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) {
      prevent(event);
      return;
    }
    dragDepth += 1;
    document.documentElement.dataset.devImageDrag = 'true';
    prevent(event);
  };

  const onDragOver = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    if (!isValidImageDrag(event)) {
      dragDepth = 0;
      clearDragState();
      return;
    }
    prevent(event);
    const placeholder = placeholderAtPoint(event.clientX, event.clientY);
    const carousel = placeholder ? null : carouselAtPoint(event.clientX, event.clientY);
    setCarouselDropTarget(carousel);
    setPlaceholderTarget(placeholder);
    if (pageDropVeil instanceof HTMLElement) {
      if (carousel || placeholder) delete pageDropVeil.dataset.active;
      else pageDropVeil.dataset.active = 'true';
    }
  };

  const onDragLeave = (event) => {
    if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
    dragDepth = 0;
    clearDragState();
  };

  const onDrop = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    const { clientX, clientY } = event;
    const transfer = event.dataTransfer;
    closeMultiDropChoice();
    dragDepth = 0;
    clearDragState();
    if (!isValidImageDrag(event)) return;
    event.preventDefault();
    const assetSrc = transfer?.getData(ASSET_DRAG_TYPE) || '';
    const placeholder = placeholderAtPoint(clientX, clientY);
    if (placeholder) {
      const file = Array.from(transfer?.files || []).find(isAcceptedImageFile);
      if (!file && !assetSrc) return;
      const replacementEvent = new CustomEvent('vcd:dev-image-replace', {
        cancelable: true,
        detail: {
          target: placeholder,
          ...(file ? { file } : assetSrc ? { src: assetSrc } : {}),
        },
      });
      window.dispatchEvent(replacementEvent);
      if (replacementEvent.defaultPrevented) return;
      window.alert('Could not replace that image. Reload the editor and try again.');
      return;
    }
    const carousel = carouselAtPoint(clientX, clientY);
    const carouselTarget = carouselTargetFromElement(carousel);
    if (carouselTarget && (assetSrc || transfer?.files?.length)) {
      void (async () => {
        try {
          if (assetSrc) {
            await appendToCarousel([], [assetSrc], carouselTarget);
            return;
          }
          const images = Array.from(transfer.files).filter(isAcceptedImageFile);
          if (!images.length) return;
          const target = beginTransaction('', carouselTarget.target);
          if (!target) return;
          const filenames = await uploadFiles(images, target);
          await appendToCarousel(filenames, [], carouselTarget);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images to that carousel.');
        }
      })();
      return;
    }
    if (assetSrc) {
      const target = beginTransaction('', event.target);
      if (!target) return;
      pendingInsertIndex = insertIndexForY(clientY, target.dropZone);
      target.insertIndex = pendingInsertIndex;
      void insertSection('image', [], [assetSrc], target).catch((error) => {
        window.alert(error instanceof Error ? error.message : 'Could not add image.');
      });
      return;
    }
    if (!transfer?.files?.length) return;
    handleFiles(transfer.files, clientY, clientX, beginTransaction('', event.target));
  };

  pickButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = currentTransaction();
      const type = button.getAttribute('data-dev-image-pick');
      if (!type) return;
      void (async () => {
        try {
          if (pendingSrcs.length) {
            await insertSection(type, [], pendingSrcs, target);
            return;
          }
          if (!pendingFiles.length) return;
          const filenames = await uploadFiles(pendingFiles, target);
          await insertSection(type, filenames, [], target);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    });
  });

  multiDropChoiceButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const type = button.getAttribute('data-dev-image-drop-choice-type');
      if (type !== 'imageGrid' && type !== 'imageCarousel') return;
      const files = [...pendingFiles];
      const target = currentTransaction();
      closeMultiDropChoice();
      void (async () => {
        try {
          const filenames = await uploadFiles(files, target);
          await insertSection(type, filenames, [], target);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    });
  });

  document.addEventListener('pointerdown', (event) => {
    if (!(multiDropChoice instanceof HTMLElement) || multiDropChoice.hidden) return;
    if (event.target instanceof Node && multiDropChoice.contains(event.target)) return;
    closeMultiDropChoice();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(multiDropChoice instanceof HTMLElement) || multiDropChoice.hidden) return;
    event.preventDefault();
    closeMultiDropChoice();
  });

  placeholderButton?.addEventListener('click', () => {
    const target = currentTransaction();
    void (async () => {
      try {
        if (targetedGrid) {
          await appendToGrid([], [], targetedGrid, true);
          closePicker();
          return;
        }
        if (targetedCarousel) {
          await appendToCarousel([], [], targetedCarousel, true);
          closePicker();
          return;
        }
        const placeholderType = preferredType === 'imageGrid'
          ? 'placeholderImageGrid'
          : preferredType === 'imageCarousel' ? 'placeholderImageCarousel' : 'placeholder';
        await insertSection(placeholderType, [], [], target);
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Could not add placeholder.');
      }
    })();
  });

  cancelButton?.addEventListener('click', () => {
    closePicker();
  });

  chooseButton?.addEventListener('click', () => {
    if (fileInput instanceof HTMLInputElement) fileInput.click();
  });

  chooseAssetsButton?.addEventListener('click', () => {
    const target = currentTransaction();
    if (!target) return;
    const type = preferredType;
    const carousel = targetedCarousel;
    const grid = targetedGrid;
    void (async () => {
      try {
        suppressCloseReset = true;
        hidePanel();
        const result = await pickFromAssetManager();
        const srcs = Array.isArray(result?.srcs) ? result.srcs.filter(Boolean) : [];
        if (!srcs.length) {
          showPanel();
          return;
        }
        if (carousel) {
          await appendToCarousel([], srcs, carousel);
          closePicker();
          return;
        }
        if (grid) {
          await appendToGrid([], srcs, grid);
          closePicker();
          return;
        }
        if (type === 'image' || type === 'imageGrid' || type === 'imageCarousel') {
          await insertSection(type, [], srcs, target);
          return;
        }
        // Type not chosen yet — stage assets and show Single / Grid / Carousel.
        pendingFiles = [];
        pendingSrcs = srcs;
        showPanel();
      } catch (error) {
        if (error instanceof Error && error.message === 'cancelled') {
          showPanel();
          return;
        }
        window.alert(error instanceof Error ? error.message : 'Could not add images.');
        showPanel();
      } finally {
        suppressCloseReset = false;
      }
    })();
  });

  fileInput?.addEventListener('change', () => {
    if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) return;
    setPendingFiles(fileInput.files);
    const target = currentTransaction();
    const type = preferredType;
    const carousel = targetedCarousel;
    const grid = targetedGrid;
    fileInput.value = '';
    if ((type || carousel || grid) && pendingFiles.length) {
      void (async () => {
        try {
          const filenames = await uploadFiles(pendingFiles, target);
          if (grid) await appendToGrid(filenames, [], grid);
          else await insertWithPreferredType(filenames, [], target, type, carousel);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    }
  });

  dropzone?.addEventListener('dragover', (event) => {
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
    if (dropzone instanceof HTMLElement) dropzone.classList.add('is-dragover');
  });

  dropzone?.addEventListener('dragleave', () => {
    if (dropzone instanceof HTMLElement) dropzone.classList.remove('is-dragover');
  });

  dropzone?.addEventListener('drop', (event) => {
    event.preventDefault();
    if (dropzone instanceof HTMLElement) dropzone.classList.remove('is-dragover');
    if (!event.dataTransfer?.files?.length) return;
    setPendingFiles(event.dataTransfer.files);
    const target = currentTransaction();
    const type = preferredType;
    const carousel = targetedCarousel;
    const grid = targetedGrid;
    if ((type || carousel || grid) && pendingFiles.length) {
      void (async () => {
        try {
          const filenames = await uploadFiles(pendingFiles, target);
          if (grid) await appendToGrid(filenames, [], grid);
          else await insertWithPreferredType(filenames, [], target, type, carousel);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    }
  });

  window.addEventListener('vcd:dev-edit-close', ((event) => {
    const detail = event.detail ?? {};
    if (detail.panel !== panel) return;
    if (suppressCloseReset) return;
    resetPickerState();
  }));

  const root = document;
  root.addEventListener('dragenter', onDragEnter);
  root.addEventListener('dragover', onDragOver);
  root.addEventListener('dragleave', onDragLeave);
  root.addEventListener('drop', onDrop);
  document.addEventListener('dragend', () => {
    dragDepth = 0;
    clearDragState();
  });

  window.addEventListener('vcd:dev-mode-change', syncVisibility);

  window.addEventListener('vcd:page-surface-change', ((event) => {
    const nextDocumentKey = event.detail?.documentKey || event.detail?.document;
    if (!(panel instanceof HTMLElement) || panel.hidden || !activeTransaction) return;
    if (typeof nextDocumentKey === 'string' && nextDocumentKey !== activeTransaction.documentKey) {
      closePicker();
    }
  }));

  window.addEventListener('vcd:dev-image-picker-open', ((event) => {
    const detail = event.detail ?? {};
    if (typeof detail.documentKey !== 'string' || typeof detail.index !== 'number') return;
    const target = beginTransaction(detail.documentKey);
    if (!target) return;
    target.insertIndex = detail.index;
    pendingInsertIndex = detail.index;
    targetedCarousel = null;
    targetedGrid = null;
    preferredType = typeof detail.preferredType === 'string' ? detail.preferredType : null;
    pendingFiles = [];
    pendingSrcs = [];
    openPicker(undefined, target);
  }));

  window.addEventListener('vcd:dev-carousel-image-picker-open', ((event) => {
    const detail = event.detail ?? {};
    if (
      typeof detail.documentKey !== 'string'
      || !Array.isArray(detail.path)
      || !detail.path.length
      || !(detail.target instanceof HTMLElement)
    ) return;
    const transaction = beginTransaction(detail.documentKey, detail.target);
    if (!transaction) return;
    targetedCarousel = {
      documentKey: detail.documentKey,
      path: detail.path,
      target: detail.target,
    };
    targetedGrid = null;
    preferredType = null;
    pendingFiles = [];
    pendingSrcs = [];
    showPanel();
  }));

  window.addEventListener('vcd:dev-grid-image-picker-open', ((event) => {
    const detail = event.detail ?? {};
    if (
      typeof detail.documentKey !== 'string'
      || !Array.isArray(detail.path)
      || !detail.path.length
      || !(detail.target instanceof HTMLElement)
    ) return;
    const transaction = beginTransaction(detail.documentKey, detail.target);
    if (!transaction) return;
    targetedGrid = { documentKey: detail.documentKey, path: detail.path, target: detail.target };
    targetedCarousel = null;
    preferredType = null;
    pendingFiles = [];
    pendingSrcs = [];
    showPanel();
  }));

  syncVisibility();
  syncPickerState();
</script>

<style is:global>
  html.is-dev-mode[data-dev-image-drag='true'],
  html.is-dev-mode[data-dev-image-drag='true'] * {
    cursor: copy !important;
  }

  .dev-image-drop-choice {
    position: fixed;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 10em;
  }

  .dev-image-drop-choice[hidden] {
    display: none;
  }

  .dev-image-drop-choice.is-gap-mounted {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }

  .dev-image-drop-choice .dev-btn {
    --dev-btn-hit-inset: 0;
  }

  .dev-image-drop {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.55);
    color: #222;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .dev-image-drop[data-active='true'] {
    opacity: 1;
  }

  html.is-dev-mode[data-dev-placeholder-drop='true'] .dev-image-drop {
    opacity: 0;
  }

  html.is-dev-mode .project-media--placeholder[data-dev-drop-target='true'] {
    outline-color: var(--ref-palette-grey-400);
    background: var(--ref-palette-grey-900);
  }

  html.is-dev-mode .project-media--placeholder[data-dev-drop-target='true']::after {
    border-color: var(--ref-palette-grey-400);
  }

  .dev-carousel-drop-veil {
    position: absolute;
    inset: 0;
    z-index: 30;
    border-radius: inherit;
    background: color-mix(in srgb, var(--sys-color-srf) 55%, transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .dev-carousel-drop-veil.is-active {
    opacity: 1;
  }

  .dev-carousel-drop-veil__slot {
    position: absolute;
    inset: 12px;
    display: grid;
    place-items: center;
    border: var(--dev-edit-dash);
    border-radius: 8px;
  }

  .dev-carousel-drop-veil__label {
    color: var(--sys-color-on-srf);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 16px;
    text-align: center;
  }

  .dev-overlay[data-dev-panel-key='add-image'] {
    width: min(22em, calc(100vw - 2em));
  }

  .dev-add-image {
    display: grid;
    gap: var(--dev-panel-content-gap, 0.75em);
  }

  .dev-add-image__count {
    margin: 0;
    color: var(--sys-color-on-srf-variant);
    font: var(--dev-text-status);
  }

  .dev-add-image__types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .dev-add-image__types[hidden] {
    display: none !important;
  }

  /* Exit fade removes is-dev-overlay-open before preferredType resets — keep
     the type row gone so Cancel doesn't flash Single / Grid / Carousel. */
  .dev-overlay[data-dev-panel-key='add-image']:not(.is-dev-overlay-open) .dev-add-image__types {
    display: none !important;
  }
</style>
