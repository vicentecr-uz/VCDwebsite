---
import DevOverlay from './DevOverlay.astro';
import Button from './ui/Button.astro';
import PanelActions from './ui/PanelActions.astro';
import monitorIcon from 'lucide-static/icons/monitor.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import { sizeIcon } from '../lib/icons';

interface Props {
  documentKey: string;
}

const { documentKey } = Astro.props;
const monitorSvg = sizeIcon(monitorIcon, 16);
const globeSvg = sizeIcon(globeIcon, 16);
---

<div class="dev-image-drop" data-dev-image-drop hidden>
  <p data-dev-image-drop-label>Drop images to add</p>
</div>

<DevOverlay
  storageKey="add-image"
  panelKey="add-image"
  data-dev-image-picker
  data-document-key={documentKey}
  defaultHidden
>
  <div class="dev-add-image" data-dev-add-image>
    <div class="dev-drop" data-dev-image-dropzone tabindex="0">
      <div class="dev-drop__well">
        <p class="dev-drop__label">Drop/paste here</p>
        <button type="button" class="dev-btn dev-btn--ghost" data-dev-image-choose>
          <span class="dev-btn__icon" aria-hidden="true" set:html={monitorSvg} />
          File system
        </button>
        <button type="button" class="dev-btn dev-btn--ghost" data-dev-image-choose-assets>
          <span class="dev-btn__icon" aria-hidden="true" set:html={globeSvg} />
          Asset manager
        </button>
        <input type="file" accept="image/*" multiple hidden data-dev-image-file-input />
      </div>
    </div>

    <p class="dev-add-image__count" data-dev-image-picker-count hidden></p>

    <!-- Shown only when type was not chosen upstream (e.g. page drop of one file). -->
    <div class="dev-add-image__types" data-dev-image-type-actions hidden>
      <Button type="button" emphasis="soft" label="Single image" data-dev-image-pick="image" disabled />
      <Button type="button" emphasis="soft" label="Image grid" data-dev-image-pick="imageGrid" disabled />
      <Button type="button" emphasis="soft" label="Carousel" data-dev-image-pick="imageCarousel" disabled />
    </div>

    <PanelActions>
      <Button type="button" emphasis="ghost" label="Add placeholder" data-dev-image-placeholder />
      <Button type="button" emphasis="ghost" label="Cancel" data-dev-image-cancel />
    </PanelActions>
  </div>
</DevOverlay>

<script>
  import { PLACEHOLDER_IMAGE_VARIANTS } from '../lib/projectImageDefaults';
  import { getLastPointerPosition } from '../lib/lastPointer';

  const ASSET_DRAG_TYPE = 'application/x-vcd-asset-src';

  const dropZone = document.querySelector('[data-dev-project-drop-zone]');
  const pageDropVeil = document.querySelector('[data-dev-image-drop]');
  const panel = document.querySelector('[data-dev-image-picker]');
  const documentKey = panel instanceof HTMLElement ? (panel.dataset.documentKey || '') : '';
  const pickerCount = document.querySelector('[data-dev-image-picker-count]');
  const dropzone = document.querySelector('[data-dev-image-dropzone]');
  const typeActions = document.querySelector('[data-dev-image-type-actions]');
  const fileInput = document.querySelector('[data-dev-image-file-input]');
  const chooseButton = document.querySelector('[data-dev-image-choose]');
  const chooseAssetsButton = document.querySelector('[data-dev-image-choose-assets]');
  const pickButtons = panel?.querySelectorAll('[data-dev-image-pick]') ?? [];
  const placeholderButton = document.querySelector('[data-dev-image-placeholder]');
  const cancelButton = document.querySelector('[data-dev-image-cancel]');
  const titleEl = panel instanceof HTMLElement
    ? panel.querySelector('.dev-overlay__title')
    : null;

  let pendingFiles = [];
  /** @type {string[]} */
  let pendingSrcs = [];
  let pendingInsertIndex = 0;
  /** @type {string | null} */
  let preferredType = null;
  let dragDepth = 0;
  /** @type {HTMLElement | null} */
  let activePlaceholder = null;
  /** Skip reset when we hide this panel to open Asset manager mid-pick. */
  let suppressCloseReset = false;
  /** @type {{ documentKey: string, path: Array<string | number>, target: HTMLElement } | null} */
  let targetedCarousel = null;
  /** @type {HTMLElement | null} */
  let activeCarouselDrop = null;

  const dropLabel = pageDropVeil instanceof HTMLElement
    ? pageDropVeil.querySelector('[data-dev-image-drop-label]')
    : null;

  const clearPlaceholderTarget = () => {
    if (activePlaceholder) delete activePlaceholder.dataset.devDropTarget;
    activePlaceholder = null;
    document.documentElement.removeAttribute('data-dev-placeholder-drop');
    if (dropLabel instanceof HTMLElement) dropLabel.textContent = 'Drop images to add';
  };

  const clearCarouselDropTarget = () => {
    const target = activeCarouselDrop;
    activeCarouselDrop = null;
    if (!target) return;
    delete target.dataset.devCarouselDropActive;
    const veil = target.querySelector(':scope > .dev-carousel-drop-veil');
    if (!(veil instanceof HTMLElement)) return;
    veil.classList.remove('is-active');
    const remove = () => veil.remove();
    veil.addEventListener('transitionend', remove, { once: true });
    window.setTimeout(remove, 200);
  };

  const setCarouselDropTarget = (target) => {
    if (activeCarouselDrop === target) return;
    clearCarouselDropTarget();
    activeCarouselDrop = target;
    if (!target) return;
    target.dataset.devCarouselDropActive = 'true';
    const veil = document.createElement('div');
    veil.className = 'dev-carousel-drop-veil';
    const slot = document.createElement('div');
    slot.className = 'dev-carousel-drop-veil__slot';
    const label = document.createElement('span');
    label.className = 'dev-carousel-drop-veil__label';
    label.textContent = 'Add image to carousel';
    slot.append(label);
    veil.append(slot);
    target.append(veil);
    void veil.offsetWidth;
    veil.classList.add('is-active');
  };

  const clearDragState = () => {
    document.documentElement.removeAttribute('data-dev-image-drag');
    if (pageDropVeil instanceof HTMLElement) delete pageDropVeil.dataset.active;
    clearCarouselDropTarget();
    clearPlaceholderTarget();
  };

  const carouselAtPoint = (clientX, clientY) => {
    const hit = document.elementFromPoint(clientX, clientY);
    if (!(hit instanceof Element)) return null;
    return hit.closest('[data-dev-carousel-target]');
  };

  const carouselTargetFromElement = (target) => {
    if (!(target instanceof HTMLElement)) return null;
    const targetDocumentKey = target.dataset.devDocument || '';
    try {
      const path = JSON.parse(target.dataset.devCarouselPath || '[]');
      if (!targetDocumentKey || !Array.isArray(path) || !path.length) return null;
      return { documentKey: targetDocumentKey, path, target };
    } catch {
      return null;
    }
  };

  const standalonePlaceholderAtPoint = (clientX, clientY) => {
    const hit = document.elementFromPoint(clientX, clientY);
    if (!(hit instanceof Element)) return null;
    const figure = hit.closest('.project-media--placeholder');
    if (!(figure instanceof HTMLElement)) return null;
    // Grid-item placeholders stay out of scope — fill full image blocks only.
    if (figure.closest('.project-image-grid')) return null;
    return figure;
  };

  const sectionIndexFromPlaceholder = (figure) => {
    try {
      const imagePath = JSON.parse(figure.dataset.devImagePath || '[]');
      if (
        Array.isArray(imagePath)
        && imagePath[0] === 'sections'
        && typeof imagePath[1] === 'number'
        && imagePath.length === 2
      ) {
        return imagePath[1];
      }
    } catch {
      // Fall through to spacing path on the section root.
    }
    const root = figure.closest('[data-dev-spacing-path]');
    if (!(root instanceof HTMLElement)) return null;
    try {
      const spacingPath = JSON.parse(root.dataset.devSpacingPath || '[]');
      if (
        Array.isArray(spacingPath)
        && spacingPath[0] === 'sections'
        && typeof spacingPath[1] === 'number'
      ) {
        return spacingPath[1];
      }
    } catch {
      // Ignore malformed paths.
    }
    return null;
  };

  const setPlaceholderTarget = (figure) => {
    if (activePlaceholder === figure) return;
    if (activePlaceholder) delete activePlaceholder.dataset.devDropTarget;
    activePlaceholder = figure;
    if (figure) {
      figure.dataset.devDropTarget = 'true';
      document.documentElement.dataset.devPlaceholderDrop = 'true';
      if (dropLabel instanceof HTMLElement) dropLabel.textContent = 'Drop to fill placeholder';
    } else {
      document.documentElement.removeAttribute('data-dev-placeholder-drop');
      if (dropLabel instanceof HTMLElement) dropLabel.textContent = 'Drop images to add';
    }
  };

  const syncVisibility = () => {
    const devMode = document.documentElement.classList.contains('is-dev-mode');
    if (pageDropVeil instanceof HTMLElement) pageDropVeil.hidden = !devMode;
    if (!devMode) {
      dragDepth = 0;
      clearDragState();
      if (panel instanceof HTMLElement) panel.hidden = true;
    }
  };

  const spacingBlocks = () => Array.from(
    document.querySelectorAll('[data-dev-spacing-document]'),
  );

  const insertIndexForY = (clientY) => {
    const blocks = spacingBlocks();
    if (!blocks.length) return 0;
    for (let index = 0; index < blocks.length; index += 1) {
      const rect = blocks[index].getBoundingClientRect();
      if (clientY < rect.top + rect.height / 2) {
        const path = JSON.parse(blocks[index].dataset.devSpacingPath || '[]');
        const sectionIndex = path.at(-2);
        return typeof sectionIndex === 'number' ? sectionIndex : index;
      }
    }
    const last = blocks[blocks.length - 1];
    const path = JSON.parse(last.dataset.devSpacingPath || '[]');
    const sectionIndex = path.at(-2);
    return typeof sectionIndex === 'number' ? sectionIndex + 1 : blocks.length;
  };

  const hasPreferredType = () => (
    preferredType === 'image'
    || preferredType === 'imageGrid'
    || preferredType === 'imageCarousel'
  );

  const hasCarouselTarget = () => Boolean(targetedCarousel);

  const syncTitle = () => {
    if (!(titleEl instanceof HTMLElement)) return;
    titleEl.textContent = hasCarouselTarget()
      ? 'Add image'
      : preferredType === 'imageCarousel' ? 'Add carousel' : 'Add image';
  };

  const syncPickerState = () => {
    const fileCount = pendingFiles.length;
    const srcCount = pendingSrcs.length;
    const count = fileCount || srcCount;
    const typedUpstream = hasPreferredType() || hasCarouselTarget();

    syncTitle();

    if (typeActions instanceof HTMLElement) {
      typeActions.hidden = typedUpstream;
    }
    if (placeholderButton instanceof HTMLButtonElement) {
      placeholderButton.hidden = preferredType === 'imageCarousel' || hasCarouselTarget();
      placeholderButton.disabled = count > 0;
    }

    if (pickerCount instanceof HTMLElement) {
      pickerCount.hidden = count === 0 || typedUpstream;
      pickerCount.textContent = srcCount
        ? `${srcCount} asset${srcCount === 1 ? '' : 's'} selected`
        : `${fileCount} file${fileCount === 1 ? '' : 's'} selected`;
    }
    pickButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (srcCount > 0) {
        button.disabled = srcCount < 1;
        return;
      }
      button.disabled = fileCount === 0;
    });
  };

  const resetPickerState = () => {
    pendingFiles = [];
    pendingSrcs = [];
    preferredType = null;
    targetedCarousel = null;
    syncPickerState();
  };

  const hidePanel = () => {
    if (panel instanceof HTMLElement) panel.hidden = true;
  };

  const showPanel = (clientY) => {
    if (!(panel instanceof HTMLElement)) return;
    syncPickerState();
    panel.hidden = false;
    // edit-open sets is-dev-tuner-open + clears gap chrome; open-at places the panel.
    window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', {
      detail: { panel },
    }));
    const pointer = getLastPointerPosition();
    const x = pointer.x;
    const y = typeof clientY === 'number' ? clientY : pointer.y;
    window.dispatchEvent(new CustomEvent('vcd:dev-edit-open-at', {
      detail: { panel, clientX: x, clientY: y },
    }));
  };

  const closePicker = () => {
    // Hide type row before preferredType clears — otherwise it flashes mid-fade.
    if (typeActions instanceof HTMLElement) typeActions.hidden = true;
    resetPickerState();
    if (panel instanceof HTMLElement) {
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
        detail: { panel },
      }));
    }
  };

  const readFileAsBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const result = String(reader.result || '');
      const base64 = result.includes(',') ? result.split(',')[1] : result;
      resolve(base64);
    };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });

  const flushPendingEdits = (targetDocumentKey) => new Promise((resolve, reject) => {
    window.dispatchEvent(new CustomEvent('vcd:dev-flush-pending-edits', {
      detail: { documentKey: targetDocumentKey, resolve, reject },
    }));
  });

  const uploadFiles = async (files) => {
    const payload = await Promise.all(files.map(async (file) => ({
      filename: file.name,
      data: await readFileAsBase64(file),
      mimeType: file.type,
    })));
    const response = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ document: documentKey, files: payload }),
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Upload failed.');
    return result.filenames;
  };

  const insertSection = async (type, filenames = [], srcs = []) => {
    await flushPendingEdits(documentKey);

    const payloads = type === 'image' && (srcs.length > 1 || filenames.length > 1)
      ? (srcs.length
          ? srcs.map((src) => ({ type: 'image', srcs: [src] }))
          : filenames.map((filename) => ({ type: 'image', filenames: [filename] })))
      : [{
          type,
          ...(srcs.length ? { srcs } : filenames.length ? { filenames } : {}),
        }];

    let index = pendingInsertIndex;
    for (const payload of payloads) {
      const response = await fetch('/api/content-section', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          document: documentKey,
          index,
          ...payload,
        }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Could not insert images.');
      window.dispatchEvent(new CustomEvent('vcd:dev-section-inserted', {
        detail: {
          documentKey,
          index,
          section: result.section,
        },
      }));
      window.dispatchEvent(new CustomEvent('vcd:dev-section-structure-changed', {
        detail: {
          action: 'insert',
          index,
          type: payload.type,
          section: result.section ?? { type: payload.type },
        },
      }));
      index += 1;
    }

    closePicker();
  };

  const appendToCarousel = async (filenames = [], srcs = [], target = targetedCarousel) => {
    if (!target) throw new Error('Could not find that carousel.');
    const activeIndex = Number(target.target.dataset.activeIndex);
    const activeSlide = Number.isInteger(activeIndex)
      ? target.target.querySelector(
        `[data-carousel-slide][data-carousel-index="${activeIndex}"]:not([data-carousel-parked])`,
      )
      : null;
    const activeItemId = activeSlide instanceof HTMLElement
      ? activeSlide.dataset.gridItemId || undefined
      : undefined;
    await flushPendingEdits(target.documentKey);
    /** @type {Record<string, any>} */
    let source = {};
    /** @type {string[]} */
    let itemIds = [];
    try {
      const parsedSource = JSON.parse(
        target.target.dataset.devCarouselSettings
        || target.target.dataset.carouselSettings
        || '{}',
      );
      source = parsedSource && typeof parsedSource === 'object' && !Array.isArray(parsedSource)
        ? parsedSource
        : {};
      const items = JSON.parse(target.target.dataset.devCarouselItems || '[]');
      if (Array.isArray(items)) {
        itemIds = items.map((item) => String(item?.id || '')).filter(Boolean);
      }
    } catch {
      throw new Error('Could not read the current carousel settings.');
    }
    const settingsResponse = await fetch('/api/content-batch', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        carousels: [{
          document: target.documentKey,
          path: target.path,
          orientation: source.orientation === 'vertical' ? 'vertical' : 'horizontal',
          heightMode: source.heightMode === 'tallest' ? 'tallest' : 'dynamic',
          maxHeightVh: Number(source.maxHeightVh) || 0,
          scrollPinned: source.scrollPinned === true,
          dotsPlacement: ['over', 'hidden'].includes(source.dotsPlacement)
            ? source.dotsPlacement
            : 'outside',
          visible: Array.isArray(source.visible) ? source.visible : itemIds,
          breakpoints: source.breakpoints ?? null,
        }],
      }),
    });
    const settingsResult = await settingsResponse.json();
    if (!settingsResponse.ok) {
      throw new Error(settingsResult.error || 'Could not save the current carousel settings.');
    }
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', {
      detail: {
        id: `carousel:${target.documentKey}:${target.target.dataset.devCarouselPath || JSON.stringify(target.path)}`,
      },
    }));
    window.dispatchEvent(new CustomEvent('vcd:dev-carousel-prepare-append', {
      detail: { target: target.target },
    }));
    const response = await fetch('/api/content-section', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        document: target.documentKey,
        action: 'appendMediaItems',
        path: target.path,
        ...(srcs.length ? { srcs } : { filenames }),
      }),
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error || 'Could not add images to that carousel.');
    window.dispatchEvent(new CustomEvent('vcd:dev-carousel-media-appended', {
      detail: {
        documentKey: target.documentKey,
        index: result.index,
        section: result.section,
        activeItemId,
      },
    }));
  };

  const pickFromAssetManager = () => new Promise((resolve, reject) => {
    window.dispatchEvent(new CustomEvent('vcd:dev-asset-manager-open', {
      detail: {
        documentKey,
        project: documentKey,
        mode: 'pick',
        opener: panel instanceof HTMLElement ? panel : undefined,
        // Carry Add-block menu choice (Image / Carousel) into the pick session.
        ...(hasCarouselTarget()
          ? { type: 'imageCarousel' }
          : hasPreferredType() ? { type: preferredType } : {}),
        resolve,
        reject,
      },
    }));
  });

  const readImageDimsFromFile = (file) => new Promise((resolve) => {
    const url = URL.createObjectURL(file);
    const image = new Image();
    image.onload = () => {
      resolve({
        srcWidth: image.naturalWidth || undefined,
        srcHeight: image.naturalHeight || undefined,
      });
      URL.revokeObjectURL(url);
    };
    image.onerror = () => {
      URL.revokeObjectURL(url);
      resolve({});
    };
    image.src = url;
  });

  const capturePlaceholderSection = (figure) => {
    const root = figure.closest('[data-dev-spacing-document]');
    let variants = {};
    try {
      variants = JSON.parse(figure.dataset.devImageVariants || '{}');
    } catch {
      variants = {};
    }
    const img = figure.querySelector('img');
    /** @type {Record<string, unknown>} */
    const section = {
      type: 'image',
      id: figure.dataset.devCropId || 'placeholder',
      src: 'placeholder.svg',
      alt: img?.getAttribute('alt') || 'Placeholder',
      spacing: root instanceof HTMLElement
        ? (root.dataset.devSpacingValue || 'section')
        : 'section',
      variants,
    };
    if (root instanceof HTMLElement && root.id) section.sectionId = root.id;
    return section;
  };

  const fillPlaceholder = async (figure, file) => {
    const index = sectionIndexFromPlaceholder(figure);
    if (typeof index !== 'number') {
      throw new Error('Could not find which placeholder to fill.');
    }
    await flushPendingEdits(documentKey);
    const previousSection = capturePlaceholderSection(figure);
    const filenames = await uploadFiles([file]);
    const dims = await readImageDimsFromFile(file);
    const alt = String(previousSection.alt || '');
    const variants = (
      previousSection.variants
      && typeof previousSection.variants === 'object'
      && !Array.isArray(previousSection.variants)
      && Object.keys(previousSection.variants).length > 0
    )
      ? structuredClone(previousSection.variants)
      : structuredClone(PLACEHOLDER_IMAGE_VARIANTS);
    const section = {
      ...previousSection,
      type: 'image',
      src: filenames[0],
      alt: alt === 'Placeholder' ? '' : alt,
      // Keep the placeholder frame — fill is cover-in-frame, not a new crop.
      variants,
      ...(dims.srcWidth ? { srcWidth: dims.srcWidth } : {}),
      ...(dims.srcHeight ? { srcHeight: dims.srcHeight } : {}),
    };
    window.dispatchEvent(new CustomEvent('vcd:dev-placeholder-fill-pending', {
      detail: {
        documentKey,
        index,
        filenames,
        previousSection,
        section,
      },
    }));
  };

  const openPicker = (clientY) => {
    if (typeof clientY === 'number') {
      pendingInsertIndex = insertIndexForY(clientY);
    }
    showPanel(clientY);
  };

  const insertWithPreferredType = async (filenames = [], srcs = []) => {
    if (hasCarouselTarget()) {
      await appendToCarousel(filenames, srcs);
      closePicker();
      return true;
    }
    if (!hasPreferredType()) return false;
    await insertSection(preferredType, filenames, srcs);
    return true;
  };

  const setPendingFiles = (files) => {
    pendingFiles = Array.from(files).filter((file) => file.type.startsWith('image/'));
    pendingSrcs = [];
    syncPickerState();
  };

  const handleFiles = (files, clientY, clientX) => {
    const images = Array.from(files).filter((file) => file.type.startsWith('image/'));
    if (!images.length) return;

    const placeholder = typeof clientX === 'number'
      ? standalonePlaceholderAtPoint(clientX, clientY)
      : null;
    if (placeholder) {
      void (async () => {
        try {
          await fillPlaceholder(placeholder, images[0]);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not fill placeholder.');
        }
      })();
      return;
    }

    pendingInsertIndex = insertIndexForY(clientY);
    if (images.length === 1) {
      void (async () => {
        try {
          const filenames = await uploadFiles(images);
          await insertSection('image', filenames);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add image.');
        }
      })();
      return;
    }
    void (async () => {
      try {
        const filenames = await uploadFiles(images);
        await insertSection('imageGrid', filenames);
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Could not add images.');
      }
    })();
  };

  const prevent = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
  };

  const isValidImageDrag = (transfer) => {
    if (!transfer) return false;
    if (Array.from(transfer.types || []).includes(ASSET_DRAG_TYPE)) return true;
    if (!Array.from(transfer.types || []).includes('Files')) return false;
    const items = Array.from(transfer.items || []);
    return !items.length || items.some((item) => item.kind === 'file' && item.type.startsWith('image/'));
  };

  const onDragEnter = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    if (!isValidImageDrag(event.dataTransfer)) return;
    if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) {
      prevent(event);
      return;
    }
    dragDepth += 1;
    document.documentElement.dataset.devImageDrag = 'true';
    prevent(event);
  };

  const onDragOver = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    if (!isValidImageDrag(event.dataTransfer)) return;
    prevent(event);
    const carousel = carouselAtPoint(event.clientX, event.clientY);
    setCarouselDropTarget(carousel);
    const placeholder = standalonePlaceholderAtPoint(event.clientX, event.clientY);
    setPlaceholderTarget(carousel ? null : placeholder);
    if (pageDropVeil instanceof HTMLElement) {
      if (carousel || placeholder) delete pageDropVeil.dataset.active;
      else pageDropVeil.dataset.active = 'true';
    }
  };

  const onDragLeave = (event) => {
    if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
    dragDepth = 0;
    clearDragState();
  };

  const onDrop = (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    event.preventDefault();
    const { clientX, clientY } = event;
    const transfer = event.dataTransfer;
    if (!isValidImageDrag(transfer)) return;
    const carousel = carouselAtPoint(clientX, clientY);
    const carouselTarget = carouselTargetFromElement(carousel);
    const assetSrc = transfer?.getData(ASSET_DRAG_TYPE) || '';
    dragDepth = 0;
    clearDragState();
    if (carouselTarget && (assetSrc || transfer?.files?.length)) {
      void (async () => {
        try {
          if (assetSrc) {
            await appendToCarousel([], [assetSrc], carouselTarget);
            return;
          }
          const images = Array.from(transfer.files).filter((file) => file.type.startsWith('image/'));
          if (!images.length) return;
          const filenames = await uploadFiles(images);
          await appendToCarousel(filenames, [], carouselTarget);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images to that carousel.');
        }
      })();
      return;
    }
    if (assetSrc) {
      pendingInsertIndex = insertIndexForY(clientY);
      void insertSection('image', [], [assetSrc]).catch((error) => {
        window.alert(error instanceof Error ? error.message : 'Could not add image.');
      });
      return;
    }
    if (!transfer?.files?.length) return;
    handleFiles(transfer.files, clientY, clientX);
  };

  pickButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const type = button.getAttribute('data-dev-image-pick');
      if (!type) return;
      void (async () => {
        try {
          if (pendingSrcs.length) {
            await insertSection(type, [], pendingSrcs);
            return;
          }
          if (!pendingFiles.length) return;
          const filenames = await uploadFiles(pendingFiles);
          await insertSection(type, filenames);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    });
  });

  placeholderButton?.addEventListener('click', () => {
    void (async () => {
      try {
        await insertSection('placeholder');
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Could not add placeholder.');
      }
    })();
  });

  cancelButton?.addEventListener('click', () => {
    closePicker();
  });

  chooseButton?.addEventListener('click', () => {
    if (fileInput instanceof HTMLInputElement) fileInput.click();
  });

  chooseAssetsButton?.addEventListener('click', () => {
    void (async () => {
      try {
        suppressCloseReset = true;
        hidePanel();
        const result = await pickFromAssetManager();
        const srcs = Array.isArray(result?.srcs) ? result.srcs.filter(Boolean) : [];
        if (!srcs.length) {
          showPanel();
          return;
        }
        if (hasCarouselTarget()) {
          await appendToCarousel([], srcs);
          closePicker();
          return;
        }
        if (hasPreferredType()) {
          await insertSection(preferredType, [], srcs);
          return;
        }
        // Type not chosen yet — stage assets and show Single / Grid / Carousel.
        pendingFiles = [];
        pendingSrcs = srcs;
        showPanel();
      } catch (error) {
        if (error instanceof Error && error.message === 'cancelled') {
          showPanel();
          return;
        }
        window.alert(error instanceof Error ? error.message : 'Could not add images.');
        showPanel();
      } finally {
        suppressCloseReset = false;
      }
    })();
  });

  fileInput?.addEventListener('change', () => {
    if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.length) return;
    setPendingFiles(fileInput.files);
    fileInput.value = '';
    if ((hasPreferredType() || hasCarouselTarget()) && pendingFiles.length) {
      void (async () => {
        try {
          const filenames = await uploadFiles(pendingFiles);
          await insertWithPreferredType(filenames);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    }
  });

  dropzone?.addEventListener('dragover', (event) => {
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
    if (dropzone instanceof HTMLElement) dropzone.classList.add('is-dragover');
  });

  dropzone?.addEventListener('dragleave', () => {
    if (dropzone instanceof HTMLElement) dropzone.classList.remove('is-dragover');
  });

  dropzone?.addEventListener('drop', (event) => {
    event.preventDefault();
    if (dropzone instanceof HTMLElement) dropzone.classList.remove('is-dragover');
    if (!event.dataTransfer?.files?.length) return;
    setPendingFiles(event.dataTransfer.files);
    if ((hasPreferredType() || hasCarouselTarget()) && pendingFiles.length) {
      void (async () => {
        try {
          const filenames = await uploadFiles(pendingFiles);
          await insertWithPreferredType(filenames);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : 'Could not add images.');
        }
      })();
    }
  });

  window.addEventListener('vcd:dev-edit-close', ((event) => {
    const detail = event.detail ?? {};
    if (detail.panel !== panel) return;
    if (suppressCloseReset) return;
    resetPickerState();
  }));

  const root = dropZone?.closest('main') ?? dropZone ?? document.body;
  root.addEventListener('dragenter', onDragEnter);
  root.addEventListener('dragover', onDragOver);
  root.addEventListener('dragleave', onDragLeave);
  root.addEventListener('drop', onDrop);
  document.addEventListener('dragend', () => {
    dragDepth = 0;
    clearDragState();
  });

  window.addEventListener('vcd:dev-mode-change', syncVisibility);

  window.addEventListener('vcd:dev-image-picker-open', ((event) => {
    const detail = event.detail ?? {};
    if (detail.documentKey !== documentKey || typeof detail.index !== 'number') return;
    pendingInsertIndex = detail.index;
    targetedCarousel = null;
    preferredType = typeof detail.preferredType === 'string' ? detail.preferredType : null;
    pendingFiles = [];
    pendingSrcs = [];
    openPicker();
  }));

  window.addEventListener('vcd:dev-carousel-image-picker-open', ((event) => {
    const detail = event.detail ?? {};
    if (
      detail.documentKey !== documentKey
      || !Array.isArray(detail.path)
      || !detail.path.length
      || !(detail.target instanceof HTMLElement)
    ) return;
    targetedCarousel = {
      documentKey: detail.documentKey,
      path: detail.path,
      target: detail.target,
    };
    preferredType = null;
    pendingFiles = [];
    pendingSrcs = [];
    showPanel();
  }));

  syncVisibility();
  syncPickerState();
</script>

<style is:global>
  html.is-dev-mode[data-dev-image-drag='true'],
  html.is-dev-mode[data-dev-image-drag='true'] * {
    cursor: copy !important;
  }

  .dev-image-drop {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.55);
    color: #222;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .dev-image-drop[data-active='true'] {
    opacity: 1;
  }

  html.is-dev-mode[data-dev-placeholder-drop='true'] .dev-image-drop {
    opacity: 0;
  }

  html.is-dev-mode .project-media--placeholder[data-dev-drop-target='true'] {
    outline-color: var(--ref-palette-grey-400);
    background: var(--ref-palette-grey-900);
  }

  html.is-dev-mode .project-media--placeholder[data-dev-drop-target='true']::after {
    border-color: var(--ref-palette-grey-400);
  }

  .dev-carousel-drop-veil {
    position: absolute;
    inset: 0;
    z-index: 30;
    border-radius: inherit;
    background: color-mix(in srgb, var(--sys-color-srf) 72%, var(--sys-color-srf-container-low));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .dev-carousel-drop-veil.is-active {
    opacity: 1;
  }

  .dev-carousel-drop-veil__slot {
    position: absolute;
    inset: 12px;
    display: grid;
    place-items: center;
    border: var(--dev-edit-dash);
    border-radius: 8px;
  }

  .dev-carousel-drop-veil__label {
    color: var(--sys-color-on-srf);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 16px;
    text-align: center;
  }

  .dev-overlay[data-dev-panel-key='add-image'] {
    width: min(22em, calc(100vw - 2em));
  }

  .dev-add-image {
    display: grid;
    gap: var(--dev-panel-content-gap, 0.75em);
  }

  .dev-add-image__count {
    margin: 0;
    color: var(--sys-color-on-srf-variant);
    font: var(--dev-text-status);
  }

  .dev-add-image__types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .dev-add-image__types[hidden] {
    display: none !important;
  }

  /* Exit fade removes is-dev-overlay-open before preferredType resets — keep
     the type row gone so Cancel doesn't flash Single / Grid / Carousel. */
  .dev-overlay[data-dev-panel-key='add-image']:not(.is-dev-overlay-open) .dev-add-image__types {
    display: none !important;
  }
</style>
