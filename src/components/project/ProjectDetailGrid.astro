---
import { projectImage } from '../../lib/images';
import { projectStackClass, type ProjectStackSpacing } from '../../lib/projectStack';

interface Item {
  src: string;
  alt?: string;
  fullHeight?: boolean;
  hideOnMobile?: boolean;
}

interface Props {
  items: Item[];
  wide?: boolean;
  square?: boolean;
  showMobileOnly?: boolean;
  spacing?: ProjectStackSpacing;
}

const { items, wide = false, square = false, showMobileOnly = false, spacing = 'section' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', showMobileOnly && 'project-show-mobile-only', stackClass]}>
  <div class:list={['project-detail-grid', wide && 'project-detail-grid--wide', square && 'project-detail-grid--square']}>
    {items.map((item) => (
      <img
        src={projectImage(item.src)}
        alt={item.alt ?? ''}
        class:list={[item.fullHeight && 'project-media__img--full-height', item.hideOnMobile && 'project-hide-mobile']}
        loading="lazy"
      />
    ))}
  </div>
</div>
