---
import { projectImage } from '../../lib/images';

interface Props {
  baseSrc: string;
  baseAlt?: string;
  topSrc: string;
  topAlt?: string;
}

const { baseSrc, baseAlt = '', topSrc, topAlt = '' } = Astro.props;
---

<div class="project-block project-block--before-image">
  <figure class="project-hover-swap">
    <img src={projectImage(baseSrc)} alt={baseAlt} class="project-hover-swap__base" loading="lazy" />
    <img src={projectImage(topSrc)} alt={topAlt} class="project-hover-swap__top" loading="lazy" />
  </figure>
</div>
