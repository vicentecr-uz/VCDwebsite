---
import { projectImage } from '../../lib/images';

interface Props {
  src: string;
  alt?: string;
  caption: string;
  href: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt = '', caption, href, loading = 'lazy' } = Astro.props;
---

<figure class="project-reference-cell">
  <a href={href} target="_blank" rel="noopener noreferrer" class="project-reference-cell__link">
    <span class="project-caption">{caption}</span>
  </a>
  <img src={projectImage(src)} alt={alt} class="project-reference-cell__img" loading={loading} />
</figure>
