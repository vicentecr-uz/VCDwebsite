---
import { craftDemo } from '../../lib/craftDemos';
import { projectStackClass, type ProjectStackSpacing } from '../../lib/projectStack';

interface Props {
  demo: unknown;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
}
const { demo: id, spacing = 'section', sectionId } = Astro.props;
const demo = craftDemo(id);
---

{demo && (
  <div class:list={['project-block', 'project-interactive-demo', projectStackClass(spacing)]} id={sectionId}>
    <iframe
      src={`/preview/${demo.id}`}
      title={demo.title}
      loading="lazy"
      sandbox="allow-scripts allow-same-origin"
      referrerpolicy="no-referrer"
      style={`height:${demo.height}rem`}
    />
    <a href={`/preview/${demo.id}`} target="_blank" rel="noopener" aria-label={`Open ${demo.title}`}>Open demo</a>
  </div>
)}

<style>
  .project-interactive-demo iframe { display: block; width: 100%; border: 1px solid var(--sys-color-outline-variant); border-radius: var(--radius-control-smooth); }
  .project-interactive-demo a { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--space-unit); text-decoration: underline; text-underline-offset: 0.2em; }
  .project-interactive-demo a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
