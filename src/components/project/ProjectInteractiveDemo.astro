---
import '../../styles/devOverlayFrame.css';
import '../../styles/demoFrame.css';
import '../../styles/saveBar.css';
import '../../styles/assetManager.css';
import '../../styles/loading-spinner.css';
import '../../styles/demoIndicators.css';
import '../../styles/demoFinger.css';
import '../../lib/stageshow/cursor.css';
import maximizeIcon from 'lucide-static/icons/maximize.svg?raw';
import minimizeIcon from 'lucide-static/icons/minimize.svg?raw';
import { sizeIcon } from '../../lib/icons';
import Button from '../ui/Button.astro';
import loadingSpinner from '../ui/LoadingSpinner.svg?raw';
import ProgressiveImageDemo from './demos/ProgressiveImageDemo.astro';
import CropFrameDemo from './demos/CropFrameDemo.astro';
import SabiUrlField from './SabiUrlField.astro';
import BarChartDemo from './demos/BarChartDemo.astro';
import { craftDemo } from '../../lib/craftDemos';
import { projectStackClass, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import SiteAnnotationLayer from './SiteAnnotationLayer.astro';

interface Props {
  demo: unknown;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  annotations?: unknown;
  sample?: unknown;
}
const { demo: id, spacing = 'group', sectionId, contentId, documentKey, sectionPath, annotations, sample } = Astro.props;
const demo = craftDemo(id);
const urlSample = sample && typeof sample === 'object' ? sample as Record<string, unknown> : {};
const sampleText = (key: string) => typeof urlSample[key] === 'string' ? urlSample[key] : undefined;
const frame = demo && 'frame' in demo ? demo.frame : 'default';
const embedded = demo && !['progressive-image', 'image-framing', 'bar-chart', 'url-field'].includes(demo.id);
const expandable = demo?.id === 'editor-playground';
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
const authoring = import.meta.env.DEV && documentKey && sectionPath && contentId
  ? { documentKey, path: [...sectionPath, 'sample'], sectionId: contentId }
  : undefined;
---

{demo && (
  <div class:list={['project-block', 'project-interactive-demo', frame === 'default' && 'demo-frame', projectStackClass(spacing), sectionId && 'section-block']} id={sectionId} data-demo-frame={frame} data-interactive-demo={demo.id} data-site-annotation-section-id={contentId} data-site-annotation-document={import.meta.env.DEV ? documentKey : undefined} style={`--demo-height:${demo.height}rem;--demo-narrow-height:${'narrowHeight' in demo ? demo.narrowHeight : demo.height}rem`} {...(spacingAttrs ?? {})}>
    {demo.id === 'gap-spacing' && <p class="project-interactive-demo__mobile-notice">This demo is currently optimized for desktop</p>}
    <project-demo-content class="project-interactive-demo__content" data-demo-loading={embedded || undefined} aria-busy={embedded ? 'true' : undefined} popover={expandable ? 'manual' : undefined}>
      {expandable && <Button class="playground-expand" label="" raised aria-label="Expand demo" aria-expanded="false" data-playground-expand>
        <Fragment slot="icon">
          <span data-expand-icon set:html={sizeIcon(maximizeIcon, 18)} />
          <span data-minimize-icon set:html={sizeIcon(minimizeIcon, 18)} />
        </Fragment>
      </Button>}
      {embedded && <span class="project-interactive-demo__loading page-loading-indicator" role="status" aria-label="Loading demo" set:html={loadingSpinner} />}
      {demo.id === 'url-field' ? (
        <div class="project-interactive-demo__url-field"><SabiUrlField value={sampleText('url')} prefix={sampleText('prefix')} suffix={sampleText('suffix')} /></div>
      ) : demo.id === 'progressive-image' ? <ProgressiveImageDemo /> : demo.id === 'bar-chart' ? <BarChartDemo sample={sample} /> : demo.id === 'image-framing' ? <CropFrameDemo sample={sample} authoring={authoring} /> : <iframe
        src={'route' in demo ? demo.route : `/preview/${demo.id}`}
        title={demo.title}
        loading="lazy"
        sandbox={`allow-scripts allow-same-origin${demo.id === 'gap-spacing' ? ' allow-top-navigation-by-user-activation' : ''}`}
        referrerpolicy="no-referrer"
      />}
    </project-demo-content>
    {contentId && (import.meta.env.DEV || (Array.isArray(annotations) && annotations.length > 0)) && <SiteAnnotationLayer sectionId={contentId} annotations={annotations} />}
  </div>
)}

<script>
  import { bindPlaygroundExpansion } from '../../lib/playgroundExpansion';

  class ProjectDemoContent extends HTMLElement {
    private pending?: AbortController;

    connectedCallback() {
      const frame = this.querySelector('iframe');
      if (!frame) return;
      this.pending = new AbortController();
      const { signal } = this.pending;
      const expand = this.querySelector<HTMLButtonElement>('[data-playground-expand]');
      if (expand) bindPlaygroundExpansion(this, expand, frame, signal);
      const ready = () => {
        const document = frame.contentDocument;
        if (!document || document.URL === 'about:blank' || document.readyState !== 'complete') return;
        // The playground canvas is ready at load. Its desktop settings hydrate on
        // visibility, so waiting for them here would keep the iframe hidden forever.
        const islands = expand ? [] : document.querySelectorAll('astro-island[ssr]');
        if (islands.length) {
          islands.forEach((island) => island.addEventListener('astro:hydrate', ready, { once: true, signal }));
          return;
        }
        this.removeAttribute('data-demo-loading');
        this.removeAttribute('aria-busy');
        this.querySelector('.project-interactive-demo__loading')?.setAttribute('aria-hidden', 'true');
      };
      frame.addEventListener('load', ready, { signal });
      ready();
    }

    disconnectedCallback() {
      this.pending?.abort();
    }
  }
  if (!customElements.get('project-demo-content')) customElements.define('project-demo-content', ProjectDemoContent);
</script>

<style>
  .project-interactive-demo {
    position: relative;
    /* Edit mode's lift card sits concentric with these corners. */
    --section-content-radius: var(--radius-control-smooth);
  }

  .project-interactive-demo[data-demo-frame='none'] {
    background: transparent;
    box-shadow: none;
  }

  .project-interactive-demo[data-demo-frame='none']::after { display: none; }

  .project-interactive-demo__content {
    display: block;
    position: relative;
    border-radius: inherit;
    corner-shape: inherit;
  }

  [data-interactive-demo='editor-playground'] {
    min-height: var(--demo-height);
  }

  .project-interactive-demo__content[popover] {
    display: block;
    position: relative;
    inset: auto;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: clip;
    color: inherit;
    background: var(--comp-demo-frame-container);
  }

  .project-interactive-demo__content:popover-open {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    border-radius: 0;
  }

  .project-interactive-demo__content:popover-open::backdrop { background: transparent; }
  .project-interactive-demo__content[popover]:popover-open iframe { height: 100%; border-radius: 0; }

  .playground-expand {
    position: absolute;
    right: max(8px, env(safe-area-inset-right));
    top: max(8px, env(safe-area-inset-top));
    z-index: 4;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
  }

  [data-minimize-icon], .playground-expand[aria-expanded='true'] [data-expand-icon] { display: none; }
  .playground-expand[aria-expanded='true'] [data-minimize-icon] { display: grid; }

  @media (max-width: 40em) {
    [data-interactive-demo='editor-playground'] { min-height: var(--demo-narrow-height); }
    [data-interactive-demo='editor-playground'] iframe { pointer-events: none; }
    [data-interactive-demo='editor-playground'] :popover-open iframe { pointer-events: auto; }
  }

  .project-interactive-demo__url-field {
    display: grid;
    place-items: center;
    min-height: var(--demo-height);
    padding: var(--demo-frame-inset);
  }

  .project-interactive-demo__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease-out, visibility 0s linear 180ms;
  }

  .project-interactive-demo__content[data-demo-loading] .project-interactive-demo__loading {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .project-interactive-demo__content:not([data-demo-loading]) .project-interactive-demo__loading :global(rect) {
    animation-play-state: paused;
  }

  /* Controls an embedded demo hands to its host frame, outside the iframe's scroll. */
  .project-interactive-demo__content > :global(.demo-controls) {
    position: absolute;
    left: var(--space-unit);
    bottom: var(--space-unit);
    z-index: 2;
    display: flex;
    gap: calc(var(--space-unit) * 2);
  }

  .project-interactive-demo__content > :global(.block-demo-actions) {
    position: absolute;
    right: var(--space-unit);
    bottom: var(--space-unit);
    z-index: 2;
  }

  /* Scrolling demos fade at the frame's edges; the mask sits on the iframe so overscroll can't move it.
     The second layer keeps the scrollbar strip at the far right unmasked. */
  .project-interactive-demo[data-interactive-demo='gap-spacing'] .project-interactive-demo__content iframe {
    mask-image: linear-gradient(to bottom,
      transparent 0.5rem,
      rgb(0 0 0 / 0.04) 0.8rem,
      rgb(0 0 0 / 0.18) 1.1rem,
      rgb(0 0 0 / 0.5) 1.5rem,
      rgb(0 0 0 / 0.82) 1.9rem,
      rgb(0 0 0 / 0.96) 2.2rem,
      black 2.5rem,
      black calc(100% - 2.5rem),
      rgb(0 0 0 / 0.96) calc(100% - 2.2rem),
      rgb(0 0 0 / 0.82) calc(100% - 1.9rem),
      rgb(0 0 0 / 0.5) calc(100% - 1.5rem),
      rgb(0 0 0 / 0.18) calc(100% - 1.1rem),
      rgb(0 0 0 / 0.04) calc(100% - 0.8rem),
      transparent calc(100% - 0.5rem)),
      linear-gradient(black, black);
    mask-size: 100% 100%, 1.25rem 100%;
    mask-position: center, right;
    mask-repeat: no-repeat;
  }

  .project-interactive-demo__content > :global(.demo-controls .dev-btn) { --dev-btn-hit-inset: 8px; }

  @media (pointer: coarse) {
    .project-interactive-demo__content > :global(.demo-controls .dev-btn) { min-height: 44px; }
  }

  .project-interactive-demo__content[data-demo-loading] iframe {
    opacity: 0;
    visibility: hidden;
  }

  .project-interactive-demo__mobile-notice { display: none; }

  @media (max-width: 40em) {
    .project-interactive-demo__mobile-notice {
      display: block;
      margin: 0;
      padding: var(--space-unit);
      text-align: center;
      font: var(--dev-text-status);
      color: var(--sys-color-on-srf-variant);
      background: var(--comp-demo-frame-container);
      pointer-events: none;
    }
    /* Full bleed and the edge rings live in demoFrame.css (.project-block.demo-frame). */
    .project-interactive-demo {
      display: block;
      overflow: visible;
    }

    /* Frameless demos carry no .demo-frame but still bleed, as before. */
    .project-interactive-demo[data-demo-frame='none'] {
      width: auto;
      max-width: none;
      margin-inline: calc(-1 * var(--page-gutter));
    }

    .project-interactive-demo__content {
      overflow-x: clip;
    }

    .project-interactive-demo[data-interactive-demo='gap-spacing'] {
      height: min(var(--demo-narrow-height), calc(var(--vh-safe, 1svh) * 90));
      display: flex;
      flex-direction: column;
    }

    .project-interactive-demo[data-interactive-demo='gap-spacing'] .project-interactive-demo__mobile-notice {
      flex-shrink: 0;
    }

    .project-interactive-demo[data-interactive-demo='gap-spacing'] .project-interactive-demo__content {
      flex: 1;
      min-height: 0;
    }
  }

  .project-interactive-demo__content iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: inherit;
    corner-shape: inherit;
    height: var(--demo-height);
    opacity: 1;
    transition: opacity 180ms ease-out;
  }

  @media (max-width: 40em) {
    .project-interactive-demo__content iframe { height: var(--demo-narrow-height); }
    .project-interactive-demo[data-interactive-demo='gap-spacing'] .project-interactive-demo__content iframe { height: 100%; }
  }
</style>
