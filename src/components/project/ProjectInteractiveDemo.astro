---
import '../../styles/devOverlayFrame.css';
import '../../styles/assetManager.css';
import '../../styles/loading-spinner.css';
import loadingSpinner from '../ui/LoadingSpinner.svg?raw';
import ProgressiveImageDemo from './demos/ProgressiveImageDemo.astro';
import CropFrameDemo from './demos/CropFrameDemo.astro';
import { craftDemo } from '../../lib/craftDemos';
import { projectStackClass, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import SiteAnnotationLayer from './SiteAnnotationLayer.astro';

interface Props {
  demo: unknown;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  annotations?: unknown;
  sample?: unknown;
}
const { demo: id, spacing = 'group', sectionId, contentId, documentKey, sectionPath, annotations, sample } = Astro.props;
const demo = craftDemo(id);
const frame = demo && 'frame' in demo ? demo.frame : 'default';
const embedded = demo && !['progressive-image', 'image-framing'].includes(demo.id);
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
const authoring = import.meta.env.DEV && documentKey && sectionPath && contentId
  ? { documentKey, path: [...sectionPath, 'sample'], sectionId: contentId }
  : undefined;
---

{demo && (
  <div class:list={['project-block', 'project-interactive-demo', projectStackClass(spacing), sectionId && 'section-block']} id={sectionId} data-demo-frame={frame} data-site-annotation-section-id={contentId} data-site-annotation-document={import.meta.env.DEV ? documentKey : undefined} {...(spacingAttrs ?? {})}>
    {demo.id === 'gap-spacing' && <p class="project-interactive-demo__mobile-notice">This demo is optimized for desktop</p>}
    <project-demo-content class="project-interactive-demo__content" data-demo-loading={embedded || undefined} aria-busy={embedded ? 'true' : undefined}>
      {embedded && <span class="project-interactive-demo__loading page-loading-indicator" role="status" aria-label="Loading demo" set:html={loadingSpinner} />}
      {demo.id === 'progressive-image' ? <ProgressiveImageDemo /> : demo.id === 'image-framing' ? <CropFrameDemo sample={sample} authoring={authoring} /> : <iframe
        src={`/preview/${demo.id}`}
        title={demo.title}
        loading="lazy"
        sandbox={`allow-scripts allow-same-origin${demo.id === 'gap-spacing' ? ' allow-top-navigation-by-user-activation' : ''}`}
        referrerpolicy="no-referrer"
        style={`--demo-height:${demo.height}rem;--demo-narrow-height:${'narrowHeight' in demo ? demo.narrowHeight : demo.height}rem`}
      />}
    </project-demo-content>
    {contentId && (import.meta.env.DEV || (Array.isArray(annotations) && annotations.length > 0)) && <SiteAnnotationLayer sectionId={contentId} annotations={annotations} />}
  </div>
)}

<script>
  class ProjectDemoContent extends HTMLElement {
    private pending?: AbortController;

    connectedCallback() {
      const frame = this.querySelector('iframe');
      if (!frame) return;
      this.pending = new AbortController();
      const { signal } = this.pending;
      const ready = () => {
        const document = frame.contentDocument;
        if (!document || document.URL === 'about:blank' || document.readyState !== 'complete') return;
        const islands = document.querySelectorAll('astro-island[ssr]');
        if (islands.length) {
          islands.forEach((island) => island.addEventListener('astro:hydrate', ready, { once: true, signal }));
          return;
        }
        this.removeAttribute('data-demo-loading');
        this.removeAttribute('aria-busy');
        this.querySelector('.project-interactive-demo__loading')?.setAttribute('aria-hidden', 'true');
      };
      frame.addEventListener('load', ready, { signal });
      ready();
    }

    disconnectedCallback() {
      this.pending?.abort();
    }
  }
  if (!customElements.get('project-demo-content')) customElements.define('project-demo-content', ProjectDemoContent);
</script>

<style>
  .project-interactive-demo {
    position: relative;
    border-radius: var(--radius-control-smooth);
    background: var(--comp-demo-frame-container);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 4px 12px -4px rgb(0 0 0 / 0.04);
  }

  .project-interactive-demo[data-demo-frame='none'] {
    background: transparent;
    box-shadow: none;
  }

  .project-interactive-demo[data-demo-frame='none']::after { display: none; }

  .project-interactive-demo__content {
    display: block;
    position: relative;
    border-radius: inherit;
  }

  .project-interactive-demo__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease-out, visibility 0s linear 180ms;
  }

  .project-interactive-demo__content[data-demo-loading] .project-interactive-demo__loading {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .project-interactive-demo__content:not([data-demo-loading]) .project-interactive-demo__loading :global(rect) {
    animation-play-state: paused;
  }

  .project-interactive-demo__content[data-demo-loading] iframe {
    opacity: 0;
    visibility: hidden;
  }

  .project-interactive-demo__mobile-notice { display: none; }

  @media (max-width: 40em) {
    .project-interactive-demo__mobile-notice {
      display: block;
      margin: 0;
      padding: var(--space-unit);
      text-align: center;
      font: var(--dev-text-status);
      color: var(--sys-color-on-srf-variant);
      background: var(--comp-demo-frame-container);
      pointer-events: none;
    }
    .project-interactive-demo {
      /* Negative margins expand a block's auto width into the page gutter.
         `100% + 2 * gutter` overshoots when the inherited gutter does not
         match the parent padding, which caused horizontal scrolling. */
      width: auto;
      max-width: none;
      margin-inline: calc(-1 * var(--page-gutter));
      border-radius: 0;
      display: block;
      overflow: visible;
    }

    .project-interactive-demo__content {
      overflow-x: clip;
    }
  }

  .project-interactive-demo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: var(--surface-stroke-shadow);
  }

  .project-interactive-demo__content iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: inherit;
    height: var(--demo-height);
    opacity: 1;
    transition: opacity 180ms ease-out;
  }

  @media (max-width: 40em) {
    .project-interactive-demo__content iframe { height: var(--demo-narrow-height); }
  }
</style>
