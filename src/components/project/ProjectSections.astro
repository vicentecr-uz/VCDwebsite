---
import ProjectImageGrid from './ProjectImageGrid.astro';
import ProjectTagline from './ProjectTagline.astro';
import ProjectBodyText from './ProjectBodyText.astro';
import ProjectProse from './ProjectProse.astro';
import ProjectSectionTitle from './ProjectSectionTitle.astro';
import ProjectImage from './ProjectImage.astro';
import ProjectGrid from './ProjectGrid.astro';
import ProjectCaptionImage from './ProjectCaptionImage.astro';
import ProjectDetailImage from './ProjectDetailImage.astro';
import ProjectSystemGrid from './ProjectSystemGrid.astro';
import ProjectResearchGrid from './ProjectResearchGrid.astro';
import ProjectTripleGrid from './ProjectTripleGrid.astro';
import ProjectDetailGrid from './ProjectDetailGrid.astro';
import ProjectReferenceGrid from './ProjectReferenceGrid.astro';
import ProjectProcessGrid from './ProjectProcessGrid.astro';
import ProjectMoodboard from './ProjectMoodboard.astro';
import ProjectCaptionedImage from './ProjectCaptionedImage.astro';
import ProjectHoverSwap from './ProjectHoverSwap.astro';
import ProjectContextGrid from './ProjectContextGrid.astro';
import ProjectLayoutSplit from './ProjectLayoutSplit.astro';
import ProjectSketchModels from './ProjectSketchModels.astro';
import ProjectVideo from './ProjectVideo.astro';
import ProjectFinalHero from './ProjectFinalHero.astro';
import { projectImage } from '../../lib/images';
import { projectStackClass, resolveProjectSpacing, spacingDevAttrs } from '../../lib/projectStack';

interface Props {
  sections: any[];
  documentKey?: string;
}

const { sections, documentKey } = Astro.props;
---

{sections.map((section, sectionIndex) => {
  const spacing = resolveProjectSpacing(section.spacing, section.tightTop);
  const sectionPath = ['sections', sectionIndex];
  return (
  <>
    {section.type === 'heroImage' && (
      <ProjectImage
        src={section.src}
        alt={section.alt}
        kind="lead"
        layout={section.variant ?? 'default'}
        crop={section.crop}
        variants={section.variants}
        document={documentKey}
        path={sectionPath}
        cropId="hero"
        spacing={spacing}
      />
    )}

    {section.type === 'imageGrid' && (
      <ProjectImageGrid
        items={section.items}
        columns={section.columns ?? 2}
        document={documentKey}
        basePath={sectionPath}
        spacing={spacing}
      />
    )}

    {section.type === 'tagline' && (
      <ProjectTagline
        text={section.text}
        prefix={section.prefix}
        linkLabel={section.linkLabel}
        linkHref={section.linkHref}
        spacing={spacing}
        document={documentKey}
        sectionPath={sectionPath}
      />
    )}

    {section.type === 'bodyText' && (
      <ProjectBodyText
        paragraphs={section.paragraphs}
        documentKey={documentKey}
        pathPrefix={documentKey ? ['sections', sectionIndex, 'paragraphs'] : undefined}
        spacing={spacing}
      />
    )}

    {section.type === 'sectionTitle' && (
      <ProjectSectionTitle
        title={section.title}
        level={section.level ?? 2}
        tightBottom={section.tightBottom ?? true}
        spacing={spacing}
        document={documentKey}
        sectionPath={sectionPath}
      />
    )}

    {section.type === 'prose' && (
      <ProjectProse
        spacing={spacing}
        tightBottom={section.tightBottom ?? false}
        document={documentKey}
        sectionPath={sectionPath}
      >
        {section.heading && <h4 class="project-section-title">{section.heading}</h4>}
        {section.paragraphs.map((paragraph) => (
          <p set:html={paragraph} />
        ))}
      </ProjectProse>
    )}

    {section.type === 'image' && (
      section.showMobileOnly ? (
        <div
          class:list={['project-show-mobile-only', projectStackClass(spacing, { flush: section.flush })]}
          {...(spacingDevAttrs(documentKey, sectionPath, spacing) ?? {})}
        >
          <ProjectImage
            src={section.src}
            alt={section.alt}
            variants={section.variants}
            document={documentKey}
            path={sectionPath}
            constrained={section.constrained ?? false}
            mobileHeight={section.mobileHeight}
            flush={section.flush ?? false}
            mobileShort={section.mobileShort ?? false}
            max80={section.max80 ?? false}
            fullHeight={section.fullHeight ?? false}
            hideMobile={section.hideMobile ?? false}
            spacing="none"
          />
        </div>
      ) : (
        <ProjectImage
          src={section.src}
          alt={section.alt}
          variants={section.variants}
          document={documentKey}
          path={sectionPath}
          constrained={section.constrained ?? false}
          mobileHeight={section.mobileHeight}
          flush={section.flush ?? false}
          mobileShort={section.mobileShort ?? false}
          max80={section.max80 ?? false}
          fullHeight={section.fullHeight ?? false}
          hideMobile={section.hideMobile ?? false}
          imgModifier={section.imgModifier}
          spacing={spacing}
        />
      )
    )}

    {section.type === 'mediaGrid' && (
      <ProjectGrid
        cols={section.cols}
        spacing={spacing}
        document={documentKey}
        sectionPath={sectionPath}
      >
        {section.items.map((item) => (
          <>
            {item.style === 'caption' && (
              <ProjectCaptionImage
                src={item.src}
                alt={item.alt}
                caption={item.caption}
                square={item.square ?? false}
                variant={item.captionVariant ?? 'light'}
              />
            )}

            {item.style === 'detail' && (
              <ProjectDetailImage
                src={item.src}
                alt={item.alt}
                caption={item.caption}
                captionVariant={item.captionVariant ?? 'light'}
              />
            )}

            {item.style === 'cell' && (
              <figure class:list={['project-cell', item.stack && 'project-cell--stack', item.hideOnMobile && 'project-hide-mobile']}>
                <img src={projectImage(item.src)} alt={item.alt} class="project-cell__img" loading="lazy" />
              </figure>
            )}
          </>
        ))}
      </ProjectGrid>
    )}

    {section.type === 'constrainedCaptionImage' && (
      <div
        class:list={['project-block', projectStackClass(spacing)]}
        {...(spacingDevAttrs(documentKey, sectionPath, spacing) ?? {})}
      >
        <figure class="project-media project-media--constrained">
          <span class:list={['project-caption', section.captionVariant === 'dark' && 'project-caption--dark', section.captionVariant === 'black' && 'project-caption--black']}>
            {section.caption}
          </span>
          <img
            src={projectImage(section.src)}
            alt={section.alt}
            class:list={['project-media__img', section.mobileHeight && `project-media__img--h${section.mobileHeight}`]}
            loading="lazy"
          />
        </figure>
      </div>
    )}

    {section.type === 'systemGrid' && (
      <ProjectSystemGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'researchGrid' && (
      <ProjectResearchGrid columns={section.columns} spacing={spacing} />
    )}

    {section.type === 'tripleGrid' && (
      <ProjectTripleGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'detailGrid' && (
      <ProjectDetailGrid
        items={section.items}
        wide={section.wide ?? false}
        square={section.square ?? false}
        showMobileOnly={section.showMobileOnly ?? false}
        spacing={spacing}
      />
    )}

    {section.type === 'referenceGrid' && (
      <ProjectReferenceGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'processGrid' && (
      <ProjectProcessGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'moodboard' && (
      <ProjectMoodboard items={section.items} spacing={spacing} />
    )}

    {section.type === 'captionedImage' && (
      <ProjectCaptionedImage
        src={section.src}
        alt={section.alt}
        caption={section.caption}
        hideMobile={section.hideMobile ?? false}
        spacing={spacing}
      />
    )}

    {section.type === 'hoverSwap' && (
      <ProjectHoverSwap
        baseSrc={section.baseSrc}
        baseAlt={section.baseAlt}
        topSrc={section.topSrc}
        topAlt={section.topAlt}
        spacing={spacing}
      />
    )}

    {section.type === 'contextGrid' && (
      <ProjectContextGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'layoutSplit' && (
      <ProjectLayoutSplit leftSrc={section.leftSrc} leftAlt={section.leftAlt} items={section.items} spacing={spacing} />
    )}

    {section.type === 'sketchModels' && (
      <ProjectSketchModels setupSrc={section.setupSrc} setupAlt={section.setupAlt} items={section.items} spacing={spacing} />
    )}

    {section.type === 'video' && (
      <ProjectVideo src={section.src} title={section.title} spacing={spacing} />
    )}

    {section.type === 'finalHero' && (
      <ProjectFinalHero src={section.src} alt={section.alt} spacing={spacing} />
    )}
  </>
  );
})}
