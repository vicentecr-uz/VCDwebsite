---
import ProjectGrid from '../ProjectGrid.astro';
import ProjectBodyText from './ProjectBodyText.astro';
import ProjectImage from './ProjectImage.astro';
import ProjectImageCarousel from './ProjectImageCarousel.astro';
import ProjectImageGrid from './ProjectImageGrid.astro';
import ProjectPressQuoteTicker from './ProjectPressQuoteTicker.astro';
import ProjectRedditCommentCarousel from './ProjectRedditCommentCarousel.astro';
import ProjectSectionTitle from './ProjectSectionTitle.astro';
import ProjectVideo from './ProjectVideo.astro';
import ProjectInteractiveDemo from './ProjectInteractiveDemo.astro';
import ProjectDetails from './ProjectDetails.astro';
import ProjectAward from './ProjectAward.astro';
import ProjectScrollFinale from './ProjectScrollFinale.astro';
import ProjectSignup from './ProjectSignup.astro';
import { projectStackClass, resolveProjectSpacing, resolveStackSpacingForIndex, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import { PLACEHOLDER_IMAGE_VARIANTS } from '../../lib/projectImageDefaults';
import { getProjectGridListings } from '../../lib/projects';
import { introRun, resolveIntroHeight } from '../../lib/projectIntro';
import { shouldUseProjectScrollFinale } from '../../lib/projectScrollFinale';

interface Props {
  documentKey: string;
  sections: Array<Record<string, unknown>>;
  introHeight?: number;
  scrollFinale?: boolean;
}

const {
  documentKey,
  sections,
  introHeight: documentIntroHeight,
  scrollFinale = false,
} = Astro.props;
const introMembers = new Map<number, Record<string, unknown>>();
for (const run of introRun(sections)) {
  const height = resolveIntroHeight(documentIntroHeight, run);
  for (const member of run) {
    const index = sections.indexOf(member);
    if (index >= 0) introMembers.set(index, { ...member, introHeight: height });
  }
}

const sectionSpacing = (
  section: Record<string, unknown>,
  index: number,
  fallback = 'group',
) => {
  const raw = section?.spacing as ProjectStackSpacing | undefined;
  if (raw) return resolveStackSpacingForIndex(index, resolveProjectSpacing(raw));
  if (fallback !== 'group') return resolveStackSpacingForIndex(index, fallback as never);
  return resolveStackSpacingForIndex(index, undefined);
};

const finaleFadeSection = sections.at(-2);
const finaleTargetSection = sections.at(-1);
const useScrollFinale = shouldUseProjectScrollFinale(scrollFinale, sections);
const mainSections = useScrollFinale ? sections.slice(0, -2) : sections;
---

{mainSections.map((section, sectionIndex) => {
  const path = ['sections', sectionIndex];
  const spacing = sectionSpacing(section, sectionIndex);
  const type = String(section.type ?? '');
  const intro = introMembers.get(sectionIndex);
  const introHeight = intro?.introHeight as number | undefined;

  if (type === 'interactiveDemo') {
    return <ProjectInteractiveDemo demo={section.demo} spacing={spacing} sectionId={section.sectionId as string | undefined} contentId={section.id as string | undefined} documentKey={documentKey} sectionPath={path} />;
  }

  if (type === 'heroImage') {
    return (
      <ProjectImage
        src={String(section.src ?? '')}
        alt={String(section.alt ?? '')}
        kind="lead"
        variants={section.variants}
        srcWidth={section.srcWidth as number | undefined}
        srcHeight={section.srcHeight as number | undefined}
        background={section.background as string | undefined}
        document={documentKey}
        path={path}
        cropId={String(section.id ?? 'hero')}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
        spacing={spacing}
        mobileInset={section.mobileInset === true}
        audio={section.audio as never}
      />
    );
  }

  if (type === 'imageGrid') {
    return (
      <ProjectImageGrid
        columns={section.columns as number | undefined}
        items={section.items as never}
        defaultAspectRatio={String(section.defaultAspectRatio ?? '1:1')}
        constrained={section.constrained as never}
        layouts={section.layouts as never}
        matchHeight={section.matchHeight === true}
        document={documentKey}
        basePath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'imageCarousel') {
    return (
      <ProjectImageCarousel
        items={section.items as never}
        orientation={section.orientation as never}
        heightMode={section.heightMode as never}
        maxHeightVh={section.maxHeightVh as number | undefined}
        scrollPinned={section.scrollPinned === true}
        dotsPlacement={section.dotsPlacement as never}
        visible={section.visible as string[] | undefined}
        breakpoints={section.breakpoints as never}
        defaultAspectRatio={String(section.defaultAspectRatio ?? 'original')}
        constrained={section.constrained as never}
        document={documentKey}
        basePath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'bodyText') {
    return (
      <ProjectBodyText
        paragraphs={section.paragraphs as string[]}
        documentKey={documentKey}
        pathPrefix={[...path, 'paragraphs']}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
        intro={intro !== undefined}
        introHeight={introHeight}
        introHeightPath={intro ? ['introHeight'] : undefined}
        balance={section.balance === true}
        annotations={section.annotations}
      />
    );
  }

  if (type === 'signup') {
    return (
      <ProjectSignup
        label={String(section.label ?? 'Get involved')}
        placeholder={String(section.placeholder ?? 'johns.tern@apple.com')}
        documentKey={documentKey}
        sectionPath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'projectDetails') {
    const rows = Array.isArray(section.rows)
      ? section.rows.filter((row): row is { label: string; value: string } => (
        Boolean(row) && typeof row === 'object' && !Array.isArray(row)
        && typeof row.label === 'string' && typeof row.value === 'string'
      ))
      : [];
    return (
      <ProjectDetails
        title={String(section.title ?? 'Project details & credits')}
        rows={rows}
        documentKey={documentKey}
        sectionPath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'award') {
    return (
      <ProjectAward
        src={String(section.src ?? '/awards/if-design-2026.png')}
        alt={String(section.alt ?? 'iF Design Award 2026')}
        href={String(section.href ?? '')}
        documentKey={documentKey}
        sectionPath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'sectionTitle') {
    return (
      <ProjectSectionTitle
        title={String(section.title ?? '')}
        level={(section.level as 2 | 3 | undefined) ?? 2}
        tightBottom={(section.tightBottom as boolean | undefined) ?? true}
        spacing={spacing}
        document={documentKey}
        sectionPath={path}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
        showTitle={section.showTitle as never}
        hideWhenSidebarVisible={(section.hideWhenSidebarVisible as boolean | undefined) ?? false}
        intro={intro !== undefined}
        introHeight={introHeight}
        introHeightPath={intro ? ['introHeight'] : undefined}
        annotations={section.annotations}
      />
    );
  }

  if (type === 'image') {
    return (
      <ProjectImage
        src={String(section.src ?? '')}
        alt={String(section.alt ?? '')}
        variants={section.variants}
        srcWidth={section.srcWidth as number | undefined}
        srcHeight={section.srcHeight as number | undefined}
        background={section.background as string | undefined}
        document={documentKey}
        path={path}
        cropId={String(section.id ?? '')}
        constrained={section.constrained as never}
        centered={(section.centered as boolean | undefined) ?? false}
        maxVh={section.maxVh as number | undefined}
        max80={(section.max80 as boolean | undefined) ?? false}
        mobileHeight={section.mobileHeight as string | undefined}
        flush={(section.flush as boolean | undefined) ?? false}
        caption={section.caption as string | undefined}
        captions={section.captions as never}
        captionStyle={section.captionStyle as never}
        captionPosition={section.captionPosition as never}
        captionReveal={section.captionReveal as never}
        spacing={spacing}
        mobileInset={section.mobileInset === true}
        audio={section.audio as never}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'video') {
    return (
      <ProjectVideo
        src={section.src as string | undefined}
        poster={section.poster as string | undefined}
        alt={section.alt as string | undefined}
        autoplay={section.autoplay === true}
        aspectRatio={section.aspectRatio as string | undefined}
        spacing={spacing}
      />
    );
  }

  if (type === 'pressQuoteTicker') {
    return (
      <ProjectPressQuoteTicker
        items={section.items as never}
        documentKey={documentKey}
        sectionPath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
        speed={section.speed as number | undefined}
        logoOpacity={section.logoOpacity as number | undefined}
      />
    );
  }

  if (type === 'redditCommentCarousel') {
    return (
      <ProjectRedditCommentCarousel
        items={section.items as never}
        documentKey={documentKey}
        sectionPath={path}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
        viewportMaxEm={section.viewportMaxEm as { desktop?: number; tablet?: number; mobile?: number } | undefined}
      />
    );
  }

  if (type === 'placeholder') {
    return (
      <ProjectImage
        src="placeholder.svg"
        alt={String(section.label ?? 'Placeholder')}
        variants={(section.variants as never) ?? PLACEHOLDER_IMAGE_VARIANTS}
        srcWidth={section.srcWidth as number | undefined}
        srcHeight={section.srcHeight as number | undefined}
        background={section.background as string | undefined}
        document={documentKey}
        path={path}
        cropId={String(section.id ?? 'placeholder')}
        spacing={spacing}
        sectionId={section.sectionId as string | undefined}
        contentId={section.id as string | undefined}
      />
    );
  }

  if (type === 'projectGrid') {
    const sectionVariant = section.variant;
    const variant =
      sectionVariant === 'home' || sectionVariant === 'play'
        ? sectionVariant
        : documentKey === 'home' || documentKey === 'play'
          ? documentKey
          : 'home';
    return (
      <section
        class:list={['project-block', projectStackClass(spacing)]}
        {...(spacingDevAttrs(documentKey, path, spacing, { contentId: section.id as string | undefined }) ?? {})}
      >
        <ProjectGrid variant={variant} items={getProjectGridListings(variant)} />
      </section>
    );
  }

  return null;
})}

{useScrollFinale && finaleFadeSection && finaleTargetSection && (
  <Fragment>
    <ProjectImage
      src={String(finaleFadeSection.src ?? '')}
      alt={String(finaleFadeSection.alt ?? '')}
      variants={finaleFadeSection.variants}
      srcWidth={finaleFadeSection.srcWidth as number | undefined}
      srcHeight={finaleFadeSection.srcHeight as number | undefined}
      background={finaleFadeSection.background as string | undefined}
      document={documentKey}
      path={['sections', sections.length - 2]}
      cropId={String(finaleFadeSection.id ?? '')}
      constrained={finaleFadeSection.constrained as never}
      centered={(finaleFadeSection.centered as boolean | undefined) ?? false}
      maxVh={finaleFadeSection.maxVh as number | undefined}
      max80={(finaleFadeSection.max80 as boolean | undefined) ?? false}
      mobileHeight={finaleFadeSection.mobileHeight as string | undefined}
      flush={(finaleFadeSection.flush as boolean | undefined) ?? false}
      caption={finaleFadeSection.caption as string | undefined}
      captions={finaleFadeSection.captions as never}
      captionStyle={finaleFadeSection.captionStyle as never}
      captionPosition={finaleFadeSection.captionPosition as never}
      captionReveal={finaleFadeSection.captionReveal as never}
      spacing={sectionSpacing(finaleFadeSection, sections.length - 2)}
      sectionId={finaleFadeSection.sectionId as string | undefined}
      contentId={finaleFadeSection.id as string | undefined}
      mobileInset={finaleFadeSection.mobileInset === true}
      scrollFinaleRole="fade"
    />
    <ProjectImage
      src={String(finaleTargetSection.src ?? '')}
      alt={String(finaleTargetSection.alt ?? '')}
      variants={finaleTargetSection.variants}
      srcWidth={finaleTargetSection.srcWidth as number | undefined}
      srcHeight={finaleTargetSection.srcHeight as number | undefined}
      background={finaleTargetSection.background as string | undefined}
      document={documentKey}
      path={['sections', sections.length - 1]}
      cropId={String(finaleTargetSection.id ?? '')}
      constrained={finaleTargetSection.constrained as never}
      centered={(finaleTargetSection.centered as boolean | undefined) ?? false}
      maxVh={finaleTargetSection.maxVh as number | undefined}
      max80={(finaleTargetSection.max80 as boolean | undefined) ?? false}
      mobileHeight={finaleTargetSection.mobileHeight as string | undefined}
      flush={(finaleTargetSection.flush as boolean | undefined) ?? false}
      caption={finaleTargetSection.caption as string | undefined}
      captions={finaleTargetSection.captions as never}
      captionStyle={finaleTargetSection.captionStyle as never}
      captionPosition={finaleTargetSection.captionPosition as never}
      captionReveal={finaleTargetSection.captionReveal as never}
      spacing={sectionSpacing(finaleTargetSection, sections.length - 1)}
      sectionId={finaleTargetSection.sectionId as string | undefined}
      contentId={finaleTargetSection.id as string | undefined}
      mobileInset={finaleTargetSection.mobileInset === true}
      scrollFinaleRole="target"
    />
    <ProjectScrollFinale />
  </Fragment>
)}
