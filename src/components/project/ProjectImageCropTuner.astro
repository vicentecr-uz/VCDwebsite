---
import DevOverlay from '../DevOverlay.astro';
import ViewportSelector from '../ui/ViewportSelector.astro';
import SelectField from '../ui/SelectField.astro';
import PanelActions from '../ui/PanelActions.astro';
import Button from '../ui/Button.astro';
import alignCenterVerticalIcon from 'lucide-static/icons/align-center-vertical.svg?raw';
import alignCenterHorizontalIcon from 'lucide-static/icons/align-center-horizontal.svg?raw';
import lockIcon from 'lucide-static/icons/lock.svg?raw';
import monitorIcon from 'lucide-static/icons/monitor.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import circleAlertIcon from 'lucide-static/icons/circle-alert.svg?raw';
import { sizeIcon } from '../../lib/icons';

const alignXSvg = sizeIcon(alignCenterVerticalIcon, 14);
const alignYSvg = sizeIcon(alignCenterHorizontalIcon, 14);
const lockSvg = sizeIcon(lockIcon, 14);
const monitorSvg = sizeIcon(monitorIcon, 16);
const globeSvg = sizeIcon(globeIcon, 16);
const linkedAspectAlertSvg = sizeIcon(circleAlertIcon, 14);
---

<DevOverlay
  storageKey="project-image-crop"
  panelKey="image"
  defaultHidden
>
  <div class="tapico-crop-tuner" data-project-image-crop-tuner>
    <ViewportSelector dataAttr="data-crop-viewport" />

    <div class="dev-field" data-crop-background-wrap>
      <label class="dev-field__label" for="crop-background">Background</label>
      <div class="dev-field__value tapico-crop-tuner__background-value">
        <input id="crop-background" class="dev-field__input" type="text" maxlength="9" autocomplete="off" spellcheck="false" placeholder="None" data-crop-background />
        <button type="button" class="tapico-crop-tuner__background-swatch" aria-label="Choose image background colour" data-crop-background-swatch></button>
        <Button emphasis="ghost" label="None" data-crop-background-none />
      </div>
      <color-picker data-crop-background-picker label-title="Colour" label-hue="Hue" label-saturation="Saturation" label-lightness="Lightness" label-opacity="Opacity" label-ok="Done"></color-picker>
    </div>

    <SelectField
      label="Aspect ratio"
      data-crop-aspect-ratio-wrap
      data-crop-aspect-ratio
      options={[
        { value: 'original', label: 'Original' },
        {
          label: 'Landscape',
          options: [
            { value: '16:9', label: '16:9' },
            { value: '16:10', label: '16:10' },
            { value: '3:2', label: '3:2' },
            { value: '4:3', label: '4:3' },
            { value: '5:4', label: '5:4' },
          ],
        },
        {
          label: 'Square',
          options: [{ value: '1:1', label: '1:1' }],
        },
        {
          label: 'Portrait',
          options: [
            { value: '5:6', label: '5:6' },
            { value: '4:5', label: '4:5' },
            { value: '3:4', label: '3:4' },
            { value: '2:3', label: '2:3' },
            { value: '10:16', label: '10:16' },
            { value: '9:16', label: '9:16' },
          ],
        },
      ]}
    >
      <button
        slot="labelAccessory"
        type="button"
        class="tapico-crop-tuner__linked-aspect-hint"
        data-crop-linked-aspect-hint
        hidden
        aria-describedby="crop-linked-aspect-tooltip"
      >
        <span class="tapico-crop-tuner__linked-aspect-icon" aria-hidden="true" set:html={linkedAspectAlertSvg} />
        <span id="crop-linked-aspect-tooltip" class="tapico-crop-tuner__linked-aspect-tooltip" role="tooltip"></span>
      </button>
    </SelectField>

    <div class="tapico-crop-tuner__pair">
      <SelectField
        label="Width"
        hidden
        data-crop-width-constrain-wrap
        data-crop-width-constrain
        options={[
          { value: '100', label: 'Full' },
          { value: 'text', label: 'Match text' },
          { value: '90', label: '90%' },
          { value: '80', label: '80%' },
          { value: '70', label: '70%' },
          { value: '60', label: '60%' },
          { value: '50', label: '50%' },
          { value: '40', label: '40%' },
          { value: '30', label: '30%' },
        ]}
      />

      <SelectField
        label="Max view height"
        hidden
        data-crop-height-constrain-wrap
        data-crop-max-vh
        options={[
          { value: '', label: 'Off' },
          { value: '90', label: '90%' },
          { value: '80', label: '80%' },
          { value: '70', label: '70%' },
          { value: '60', label: '60%' },
          { value: '50', label: '50%' },
          { value: '40', label: '40%' },
          { value: '30', label: '30%' },
        ]}
      />
    </div>

    <div class="tapico-crop-tuner__stage">
      <div class="tapico-crop-tuner__preview" data-crop-preview>
        <div class="tapico-crop-tuner__preview-clip">
          <img alt="" data-crop-image draggable="false" />
          <span class="project-media__placeholder-label" aria-hidden="true">
            <span class="project-media__placeholder-label-text"></span>
          </span>
          <span class="tapico-crop-tuner__handle" aria-hidden="true"></span>
        </div>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--n" data-crop-resize="n" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--s" data-crop-resize="s" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--e" data-crop-resize="e" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--w" data-crop-resize="w" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--ne" data-crop-resize="ne" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--nw" data-crop-resize="nw" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--se" data-crop-resize="se" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--sw" data-crop-resize="sw" aria-hidden="true"></span>
      </div>
    </div>

    <div class="tapico-crop-tuner__toolbar" aria-label="Crop controls">
      <button type="button" data-crop-center-x aria-label="Centre horizontally">
        <span class="tapico-crop-tuner__icon" aria-hidden="true" set:html={alignXSvg} />
      </button>
      <button type="button" data-crop-center-y aria-label="Centre vertically">
        <span class="tapico-crop-tuner__icon" aria-hidden="true" set:html={alignYSvg} />
      </button>
      <button
        type="button"
        class="tapico-crop-tuner__constraint"
        data-crop-constraint
        aria-pressed="true"
      >
        <span
          class="tapico-crop-tuner__icon"
          data-crop-constraint-icon
          aria-hidden="true"
          set:html={lockSvg}
        />
        <span data-crop-constraint-state>Crop locked</span>
      </button>
    </div>

    <!-- Removed from the panel per Anto (2026-08-25) — wheel/pinch already
         zoom directly on the image. The input stays as the tuner's internal
         zoom-state store; a lot of the drag/wheel/pinch logic below reads
         and writes zoomInput.value directly. -->
    <label class="tapico-crop-tuner__control" hidden>
      <span>Zoom</span>
      <input data-crop-zoom type="range" min="0.01" max="100" step="0.005" value="1" />
      <output data-crop-zoom-output>100%</output>
    </label>

    <!-- JS writes readout.textContent and early-returns if the node is missing.
         Figma dropped this line; keep the node, do not paint it. -->
    <p class="tapico-crop-tuner__readout" data-crop-readout hidden>shows 100% of width · centre 0.500, 0.500</p>

    <div class="dev-field">
      <span class="dev-field__label">Replace image</span>
      <div
        class="dev-drop"
        data-crop-replace-drop
        tabindex="0"
        role="button"
        aria-label="Replace image"
      >
        <div class="dev-drop__well">
          <button type="button" class="dev-btn dev-btn--ghost" data-crop-replace-choose>
            <span class="dev-btn__icon" aria-hidden="true" set:html={monitorSvg} />
            File system
          </button>
          <button type="button" class="dev-btn dev-btn--ghost" data-crop-replace-assets>
            <span class="dev-btn__icon" aria-hidden="true" set:html={globeSvg} />
            Asset manager
          </button>
          <input type="file" accept="image/*,.heic,.heif" hidden data-crop-replace-file />
        </div>
      </div>
    </div>

    <PanelActions>
      <Button emphasis="ghost" label="Cancel" data-crop-cancel />
      <Button emphasis="ghost" label="Reset" hidden data-crop-reset />
      <Button emphasis="ghost" label="Revert changes" data-crop-revert />
      <Button emphasis="ghost" label="Use grid default" hidden data-crop-use-grid-default />
      <Button emphasis="filled" label="Save changes" data-crop-save />
    </PanelActions>

    <!-- JS early-returns if this node is missing. Figma dropped status lines;
         clip it so aria-live can still announce upload/replace errors. -->
    <p class="tapico-crop-tuner__status" data-crop-status aria-live="polite"></p>
  </div>
</DevOverlay>

<script>
  import { devEditPendingId } from '../../scripts/devEditTarget';
  import {
    imageGridConstrainedStyle,
    imageHasWidthConstraint,
    resolveImageGridConstrained,
    type ImageGridConstrainPercent,
  } from '../../lib/responsiveImage';
  import { projectImage } from '../../lib/images';
  import 'color-dialog-box';
  import { normalizeImageBackground } from '../../lib/imageBackground.mjs';
  import { isAcceptedImageFile } from '../../lib/imageUpload.mjs';
  import { isPlaceholderSrc, syncImageSourceDims, syncPlaceholderState } from '../../lib/projectImageFrame';
  import { cancelImagePreviewUpgrade } from '../../lib/imagePreviewUpgrade';
  import { bindFitPlaceholderLabel } from '../../lib/placeholderLabel';
  import { pageHistory, registerHistoryScope } from '../../lib/devHistory';
  import lockIcon from 'lucide-static/icons/lock.svg?raw';
  import lockOpenIcon from 'lucide-static/icons/lock-open.svg?raw';
  import { sizeIcon } from '../../lib/icons';

  const LOCK_ICON = sizeIcon(lockIcon, 14);
  const LOCK_OPEN_ICON = sizeIcon(lockOpenIcon, 14);

  type ImageViewport = 'desktop' | 'tablet' | 'mobile';
  type ConstrainedByViewport = Record<ImageViewport, ImageGridConstrainPercent>;

  /**
   * Frame + content. `aspect` shapes the box; `cx`/`cy`/`w` say which part of
   * the source sits in it, anchored to the source image rather than the frame.
   * See src/lib/responsiveImage.ts.
   */
  interface CropState {
    aspect: string;
    cx: number;
    cy: number;
    w: number;
  }

  const initProjectImageCropTuner = (tuner: HTMLElement) => {
    if (tuner.dataset.initialized === 'true') return;
    tuner.dataset.initialized = 'true';

    const preview = tuner.querySelector<HTMLElement>('[data-crop-preview]');
    const previewImage = tuner.querySelector<HTMLImageElement>('[data-crop-image]');
    const previewPlaceholderLabel = preview?.querySelector<HTMLElement>('.project-media__placeholder-label-text');
    const backgroundWrap = tuner.querySelector<HTMLElement>('[data-crop-background-wrap]');
    const backgroundInput = tuner.querySelector<HTMLInputElement>('[data-crop-background]');
    const backgroundSwatch = tuner.querySelector<HTMLButtonElement>('[data-crop-background-swatch]');
    const backgroundNone = tuner.querySelector<HTMLButtonElement>('[data-crop-background-none]');
    const backgroundPicker = tuner.querySelector<HTMLElement>('[data-crop-background-picker]');
    const aspectRatioSelect = tuner.querySelector<HTMLSelectElement>('[data-crop-aspect-ratio]');
    const linkedAspectHint = tuner.querySelector<HTMLButtonElement>('[data-crop-linked-aspect-hint]');
    const linkedAspectTooltip = linkedAspectHint?.querySelector<HTMLElement>('[role="tooltip"]');
    const widthConstrainWrap = tuner.querySelector<HTMLElement>('[data-crop-width-constrain-wrap]');
    const widthConstrainSelect = tuner.querySelector<HTMLSelectElement>('[data-crop-width-constrain]');
    const heightConstrainWrap = tuner.querySelector<HTMLElement>('[data-crop-height-constrain-wrap]');
    const maxVhSelect = tuner.querySelector<HTMLSelectElement>('[data-crop-max-vh]');
    const viewportButtons = [
      ...tuner.querySelectorAll<HTMLButtonElement>('[data-crop-viewport]'),
    ];
    const zoomInput = tuner.querySelector<HTMLInputElement>('[data-crop-zoom]');
    const zoomOutput = tuner.querySelector<HTMLOutputElement>('[data-crop-zoom-output]');
    const readout = tuner.querySelector<HTMLElement>('[data-crop-readout]');
    const status = tuner.querySelector<HTMLElement>('[data-crop-status]');
    const centerXButton = tuner.querySelector<HTMLButtonElement>('[data-crop-center-x]');
    const centerYButton = tuner.querySelector<HTMLButtonElement>('[data-crop-center-y]');
    const constraintButton = tuner.querySelector<HTMLButtonElement>('[data-crop-constraint]');
    const constraintState = tuner.querySelector<HTMLElement>('[data-crop-constraint-state]');
    const constraintIcon = tuner.querySelector<HTMLElement>('[data-crop-constraint-icon]');
    const saveButton = tuner.querySelector<HTMLButtonElement>('[data-crop-save]');
    const cancelButton = tuner.querySelector<HTMLButtonElement>('[data-crop-cancel]');
    const revertButton = tuner.querySelector<HTMLButtonElement>('[data-crop-revert]');
    const resetButton = tuner.querySelector<HTMLButtonElement>('[data-crop-reset]');
    const useGridDefaultButton = tuner.querySelector<HTMLButtonElement>('[data-crop-use-grid-default]');
    const replaceDrop = tuner.querySelector<HTMLElement>('[data-crop-replace-drop]');
    const replaceChooseButton = tuner.querySelector<HTMLButtonElement>('[data-crop-replace-choose]');
    const replaceAssetsButton = tuner.querySelector<HTMLButtonElement>('[data-crop-replace-assets]');
    const replaceFileInput = tuner.querySelector<HTMLInputElement>('[data-crop-replace-file]');
    const initialTarget = document.querySelector<HTMLElement>('[data-dev-image-target]');
    const initialImage = initialTarget?.querySelector<HTMLImageElement>('img');
    if (
      !preview ||
      !previewImage ||
      !aspectRatioSelect ||
      !widthConstrainWrap ||
      !widthConstrainSelect ||
      !heightConstrainWrap ||
      !maxVhSelect ||
      !viewportButtons.length ||
      !zoomInput ||
      !zoomOutput ||
      !readout ||
      !status ||
      !centerXButton ||
      !centerYButton ||
      !constraintButton ||
      !constraintState ||
      !constraintIcon ||
      !saveButton ||
      !revertButton ||
      !resetButton ||
      !useGridDefaultButton ||
      !replaceDrop ||
      !replaceChooseButton ||
      !replaceAssetsButton ||
      !replaceFileInput ||
      !initialTarget ||
      !initialImage
    ) return;

    // Untouched images render at natural ratio on the page — mirror that in the editor.
    const defaults: CropState = { aspect: 'original', cx: 0.5, cy: 0.5, w: 1 };
    type ResizeDir = 'n' | 's' | 'e' | 'w' | 'ne' | 'nw' | 'se' | 'sw';
    const resizeHandles = [
      ...tuner.querySelectorAll<HTMLElement>('[data-crop-resize]'),
    ];
    const PRESET_ASPECT_RATIOS = new Set(
      [...aspectRatioSelect.options]
        .filter((option) => !option.dataset.cropCustomRatio)
        .map((option) => option.value),
    );
    const RATIO_MIN = 9 / 16; // tallest portrait (~9:16 width/height)
    // Widest landscape — high enough that a full-width (~60em) frame can shrink to 12em tall.
    const RATIO_MAX = 5; // 5:1
    const MIN_FRAME_HEIGHT_EM = 12;
    const viewportForWidth = (): ImageViewport => {
      if (window.innerWidth <= 767) return 'mobile';
      if (window.innerWidth <= 991) return 'tablet';
      return 'desktop';
    };
    const constraintStorageKey = 'tapicoImageCropConstrained';
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const gcd = (a: number, b: number): number => {
      let x = Math.abs(Math.round(a));
      let y = Math.abs(Math.round(b));
      while (y) {
        const next = x % y;
        x = y;
        y = next;
      }
      return x || 1;
    };
    const formatAspectRatio = (aspectRatio: string) => {
      if (aspectRatio === 'original') return 'original';
      const [widthRaw, heightRaw] = aspectRatio.split(':').map(Number);
      if (!widthRaw || !heightRaw) return aspectRatio;
      const width = Math.round(widthRaw);
      const height = Math.round(heightRaw);
      const divisor = gcd(width, height);
      const a = width / divisor;
      const b = height / divisor;
      if (a <= 100 && b <= 100) return `${a}:${b}`;
      return widthRaw >= heightRaw
        ? `${(widthRaw / heightRaw).toFixed(1)}:1`
        : `1:${(heightRaw / widthRaw).toFixed(1)}`;
    };
    /** Natural ratio of the image being edited. */
    const srcAspect = () => {
      const w = previewImage.naturalWidth || editedImage.naturalWidth;
      const h = previewImage.naturalHeight || editedImage.naturalHeight;
      return w && h ? w / h : 1;
    };

    const frameAspectOf = (aspect: string) => {
      if (aspect === 'original') return srcAspect();
      const [w, h] = aspect.split(':').map(Number);
      return w > 0 && h > 0 ? w / h : srcAspect();
    };

    /** Largest `w` that still covers the frame — `w` beyond this leaves gaps. */
    const coverW = (aspect: string) => Math.min(1, frameAspectOf(aspect) / srcAspect());

    /** Visible source HEIGHT fraction implied by `w` and the frame aspect. */
    const contentH = (state: CropState) => (state.w * srcAspect()) / frameAspectOf(state.aspect);

    /** 1 = fits the frame exactly; unlocked crops may zoom below 1. */
    const zoomOf = (state: CropState) => coverW(state.aspect) / (state.w || 1);
    const wForZoom = (aspect: string, zoom: number) => coverW(aspect) / Math.max(zoom, 0.0001);
    const ZOOM_MIN = 0.01; // 1% — no practical zoom-out cap while unlocked.
    const ZOOM_MAX = 100; // 10000% — no practical cap (was 1.5)
    const minZoom = () => (constrainToFrame() ? 1 : ZOOM_MIN);

    const hoverImgSrcAspect = (target: HTMLElement) => {
      const hoverImg = target.querySelector<HTMLImageElement>('.project-grid__img--hover');
      if (!hoverImg) return null;
      const w = hoverImg.naturalWidth;
      const h = hoverImg.naturalHeight;
      if (w > 0 && h > 0) return w / h;
      hoverImg.loading = 'eager';
      return null;
    };

    const bindHoverSrcAspect = (target: HTMLElement, fromAspect?: string) => {
      const hoverImg = target.querySelector<HTMLImageElement>('.project-grid__img--hover');
      if (!hoverImg) return;
      if (hoverImg.naturalWidth > 0 && hoverImg.naturalHeight > 0) return;
      hoverImg.loading = 'eager';
      hoverImg.addEventListener('load', () => {
        if (editTarget !== target || !draftHoverVariants) return;
        syncLinkedListingAspect(draftCoverVariants[selectedViewport].aspect, fromAspect);
        paintDraftCrop();
        flushDraftChrome();
      }, { once: true });
    };

    const hoverCoverW = (aspect: string, hoverAspect: number) => (
      Math.min(1, frameAspectOf(aspect) / hoverAspect)
    );

    const hoverZoomOf = (state: CropState, hoverAspect: number) => (
      hoverCoverW(state.aspect, hoverAspect) / (state.w || 1)
    );

    const hoverWForZoom = (aspect: string, zoom: number, hoverAspect: number) => (
      hoverCoverW(aspect, hoverAspect) / Math.max(zoom, 0.0001)
    );

    const currentFrameSize = () => {
      const width = preview.clientWidth || 1;
      return { width, height: width / frameAspectOf(draft.aspect) };
    };
    const ratioFromSize = (width: number, height: number) => {
      const clampedRatio = clamp(width / Math.max(height, 1e-6), RATIO_MIN, RATIO_MAX);
      // Encode against a stable height base so 1px preview widths cannot round past the clamp.
      const baseHeight = 100;
      const baseWidth = Math.max(1, Math.round(clampedRatio * baseHeight));
      const divisor = gcd(baseWidth, baseHeight);
      return `${baseWidth / divisor}:${baseHeight / divisor}`;
    };
    const syncAspectRatioSelect = () => {
      const customOption = aspectRatioSelect.querySelector<HTMLOptionElement>('[data-crop-custom-ratio]');
      if (PRESET_ASPECT_RATIOS.has(draft.aspect)) {
        customOption?.remove();
        aspectRatioSelect.value = draft.aspect;
        return;
      }
      const option = customOption ?? document.createElement('option');
      option.dataset.cropCustomRatio = 'true';
      option.value = draft.aspect;
      option.textContent = `Custom (${formatAspectRatio(draft.aspect)})`;
      if (!customOption) {
        const originalOption = aspectRatioSelect.querySelector('option[value="original"]');
        if (originalOption?.nextSibling) {
          aspectRatioSelect.insertBefore(option, originalOption.nextSibling);
        } else {
          aspectRatioSelect.append(option);
        }
      }
      aspectRatioSelect.value = draft.aspect;
    };

    let editTarget = initialTarget;
    let editedImage = initialImage;
    let selectedViewport = viewportForWidth();
    // Panel is open for this image (preview mirrors it; page stays untouched until an edit).
    let editingSession = false;
    let draftDirty = false;
    // Write draft → live page. Stays false on open; flips on the first real crop edit.
    let liveApply = false;
    let targetWasCropped = false;
    /** Grid cells inheriting the grid default must go back to inheriting on cancel. */
    let targetHadOwnVariants = false;
    /** Rendered value of data-dev-image-variants, for a lossless cancel. */
    let targetVariantsAttr: string | null = null;
    let savedSinceSelect = false;
    let savedConstrained: ConstrainedByViewport = resolveImageGridConstrained(false);
    let draftConstrained: ConstrainedByViewport = resolveImageGridConstrained(false);
    let savedMaxVh: number | undefined;
    let draftMaxVh: number | undefined;
    let sourceRevision = 0;
    let savedBackground = 'transparent';
    let draftBackground = 'transparent';

    const isGridTarget = (target: HTMLElement) => target.classList.contains('project-image-grid__item');
    const isListingCover = (target: HTMLElement) => Boolean(target.dataset.devListingCover);
    const listingHasHoverImage = (target: HTMLElement) => {
      const item = target.closest('[data-dev-project-slug]');
      if (item?.getAttribute('data-dev-hover-image')) return true;
      return Boolean(target.querySelector('.project-grid__img--hover:not([hidden])'));
    };
    const listingEditSlot = (target: HTMLElement): 'cover' | 'hover' => {
      if (!isListingCover(target)) return 'cover';
      // Follow the hover chip, including an empty (still [hidden]) hover slot.
      if (target.classList.contains('is-dev-hover-forced')) return 'hover';
      return 'cover';
    };
    const isStandaloneMedia = (target: HTMLElement) => (
      target.classList.contains('project-media') && !isGridTarget(target)
    );
    /** Carousel slides get Max view height too — width constrain stays block-level. */
    const isCarouselItem = (target: HTMLElement) => (
      target.classList.contains('project-image-carousel__slide')
    );
    const supportsMaxVh = (target: HTMLElement) => (
      isStandaloneMedia(target) || isCarouselItem(target)
    );
    const MAX_VH_ALLOWED = new Set([90, 80, 70, 60, 50, 40, 30]);
    const normalizeMaxVh = (value: unknown): number | undefined => {
      if (value === true) return 80;
      if (value === false || value === null || value === undefined || value === '') return undefined;
      const n = Math.round(Number(value));
      return MAX_VH_ALLOWED.has(n) ? n : undefined;
    };

    const readConstrainedFromTarget = (target: HTMLElement): ConstrainedByViewport => {
      const raw = target.dataset.devConstrained;
      if (raw) {
        try {
          if (raw.startsWith('{')) {
            return resolveImageGridConstrained(JSON.parse(raw) as never);
          }
          if (raw === 'true') return resolveImageGridConstrained(true);
          if (raw === 'false') return resolveImageGridConstrained(false);
        } catch {
          // fall through
        }
      }
      if (target.classList.contains('project-media--constrained')) {
        return resolveImageGridConstrained(true);
      }
      return resolveImageGridConstrained(false);
    };

    const applyConstrainedStyle = (target: HTMLElement, constrained: ConstrainedByViewport) => {
      for (const part of imageGridConstrainedStyle(constrained).split(';')) {
        const colon = part.indexOf(':');
        if (colon < 0) continue;
        const key = part.slice(0, colon).trim();
        const value = part.slice(colon + 1).trim();
        if (key && value) target.style.setProperty(key, value);
      }
    };

    const readMaxVh = (target: HTMLElement): number | undefined => {
      const fromData = normalizeMaxVh(target.dataset.devMaxVh);
      if (fromData) return fromData;
      if (
        target.classList.contains('project-media--max-vh')
        || target.classList.contains('project-media--max80')
        || target.querySelector('.project-media__img--max-vh, .project-media__img--max80')
      ) {
        return 80;
      }
      return undefined;
    };

    const setMaxVhVar = (target: HTMLElement, maxVh: number | undefined) => {
      if (maxVh) target.style.setProperty('--project-max-vh', String(maxVh));
      else target.style.removeProperty('--project-max-vh');
    };

    /** Tell section chrome (drag handle, delete) that this frame's box moved. */
    const announceFrameChange = (target: HTMLElement) => {
      window.dispatchEvent(new CustomEvent('vcd:dev-frame-changed', { detail: { target } }));
    };

    const applyFrameFlagsLive = (
      target: HTMLElement,
      flags: { constrained: ConstrainedByViewport; maxVh: number | undefined },
    ) => {
      if (isCarouselItem(target)) {
        if (flags.maxVh) target.dataset.maxVh = String(flags.maxVh);
        else delete target.dataset.maxVh;
        target.dataset.devMaxVh = flags.maxVh ? String(flags.maxVh) : '';
        setMaxVhVar(target, flags.maxVh);
        announceFrameChange(target);
        window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', {
          detail: { block: target.closest('[data-project-image-carousel]') },
        }));
        return;
      }
      if (!isStandaloneMedia(target)) return;
      const hasConstraint = imageHasWidthConstraint(flags.constrained);
      applyConstrainedStyle(target, flags.constrained);
      target.classList.toggle('project-media--constrained', hasConstraint);
      target.dataset.devConstrained = JSON.stringify(flags.constrained);
      target.dataset.devCentered = hasConstraint ? 'true' : 'false';
      const hasMaxVh = !!flags.maxVh;
      target.classList.toggle('project-media--max-vh', hasMaxVh);
      target.classList.remove('project-media--max80');
      target.dataset.devMaxVh = hasMaxVh ? String(flags.maxVh) : '';
      setMaxVhVar(target, flags.maxVh);
      const image = target.querySelector<HTMLImageElement>('img');
      // The img-level class belongs on UNCROPPED images only — it carries a
      // max-height + object-fit:contain that would clamp and letterbox the
      // cover bitmap of a cropped frame (the frame CSS handles max-vh there).
      const cropped = target.classList.contains('project-cropped');
      image?.classList.toggle('project-media__img--max-vh', hasMaxVh && !cropped);
      image?.classList.remove('project-media__img--max80');
      const block = target.closest('.project-block');
      block?.classList.toggle('project-block--centered', hasConstraint || hasMaxVh);
      announceFrameChange(target);
    };

    const syncWidthConstrainUi = () => {
      const show = isStandaloneMedia(editTarget);
      widthConstrainWrap.hidden = !show;
      widthConstrainSelect.value = String(draftConstrained[selectedViewport]);
      heightConstrainWrap.hidden = !supportsMaxVh(editTarget);
      maxVhSelect.value = draftMaxVh ? String(draftMaxVh) : '';
    };

    const gridDefaultAspectFor = (target: HTMLElement) => {
      const raw = target.dataset.devListingDefaultAspects;
      if (raw) {
        try {
          const aspects = JSON.parse(raw) as Record<ImageViewport, string>;
          return aspects[selectedViewport] ?? aspects.mobile ?? '4:3';
        } catch {
          // fall through
        }
      }
      return (
        target.dataset.devGridDefaultAspect
        || target.closest<HTMLElement>('[data-dev-grid-default-aspect]')?.dataset.devGridDefaultAspect
        || '1:1'
      );
    };

    const gridDefaultVariantsFor = (target: HTMLElement): Record<ImageViewport, CropState> => {
      const raw = target.dataset.devListingDefaultAspects;
      if (raw) {
        try {
          const aspects = JSON.parse(raw) as Record<ImageViewport, string>;
          const result = {} as Record<ImageViewport, CropState>;
          for (const viewport of ['desktop', 'tablet', 'mobile'] as ImageViewport[]) {
            const aspect = aspects[viewport] ?? '4:3';
            result[viewport] = { aspect, cx: 0.5, cy: 0.5, w: coverW(aspect) };
          }
          return result;
        } catch {
          // fall through
        }
      }
      const aspect = gridDefaultAspectFor(target);
      const base = { aspect, cx: 0.5, cy: 0.5, w: coverW(aspect) };
      return { desktop: { ...base }, tablet: { ...base }, mobile: { ...base } };
    };

    const syncUseGridDefaultButton = () => {
      // Figma Panel Actions: Cancel + Revert + Save (Reset / Use grid default stay hidden).
      useGridDefaultButton.hidden = true;
    };

    const readAppliedVariants = (
      target: HTMLElement,
    ): Record<ImageViewport, CropState> => {
      try {
        const parsed = JSON.parse(target.dataset.devImageVariants || '{}');
        return {
          desktop: { ...defaults, ...parsed.desktop },
          tablet: { ...defaults, ...parsed.desktop, ...parsed.tablet },
          mobile: {
            ...defaults,
            ...parsed.desktop,
            ...parsed.tablet,
            ...parsed.mobile,
          },
        };
      } catch {
        return {
          desktop: { ...defaults },
          tablet: { ...defaults },
          mobile: { ...defaults },
        };
      }
    };

    const readHoverAppliedVariants = (
      target: HTMLElement,
    ): Record<ImageViewport, CropState> => {
      try {
        const parsed = JSON.parse(target.dataset.devHoverVariants || '{}');
        return {
          desktop: { ...defaults, ...parsed.desktop },
          tablet: { ...defaults, ...parsed.desktop, ...parsed.tablet },
          mobile: {
            ...defaults,
            ...parsed.desktop,
            ...parsed.tablet,
            ...parsed.mobile,
          },
        };
      } catch {
        return {
          desktop: { ...defaults },
          tablet: { ...defaults },
          mobile: { ...defaults },
        };
      }
    };

    const syncLinkedAspectHint = () => {
      if (!linkedAspectHint || !linkedAspectTooltip) return;
      const show = isListingCover(editTarget) && listingHasHoverImage(editTarget);
      linkedAspectHint.hidden = !show;
      if (!show) return;
      const editingHover = activeSlot === 'hover';
      linkedAspectTooltip.textContent = editingHover
        ? 'Linked to the cover'
        : 'Linked to the hover image';
      linkedAspectHint.setAttribute('aria-label', linkedAspectTooltip.textContent);
    };

    const readConstraints = (): Record<ImageViewport, boolean> => {
      const defaults = { desktop: true, tablet: true, mobile: true };
      try {
        const raw = window.localStorage.getItem(constraintStorageKey);
        if (raw === null) return defaults;
        if (raw === 'true' || raw === 'false') {
          const value = raw !== 'false';
          return { desktop: value, tablet: value, mobile: value };
        }
        const parsed = JSON.parse(raw) as Partial<Record<ImageViewport, unknown>>;
        return {
          desktop: parsed.desktop !== false,
          tablet: parsed.tablet !== false,
          mobile: parsed.mobile !== false,
        };
      } catch {
        return defaults;
      }
    };

    const writeConstraints = (next: Record<ImageViewport, boolean>) => {
      try {
        window.localStorage.setItem(constraintStorageKey, JSON.stringify(next));
      } catch {
        // Keep the toggle active for this page load.
      }
    };

    let savedVariants = readAppliedVariants(editTarget);
    let draftVariants = structuredClone(savedVariants);
    let savedCoverVariants = structuredClone(savedVariants);
    let draftCoverVariants = structuredClone(savedVariants);
    let savedHoverVariants: Record<ImageViewport, CropState> | null = null;
    let draftHoverVariants: Record<ImageViewport, CropState> | null = null;
    let activeSlot: 'cover' | 'hover' = 'cover';
    let saved: CropState = { ...savedVariants[selectedViewport] };
    let draft: CropState = { ...draftVariants[selectedViewport] };
    interface CropUndoEntry {
      cover: CropState;
      hover: CropState | null;
      lock: boolean;
      widthConstrain: ImageGridConstrainPercent;
      selectedViewport: ImageViewport;
      activeSlot: 'cover' | 'hover';
      allCover: Record<ImageViewport, CropState>;
      allHover: Record<ImageViewport, CropState> | null;
      allDraft: Record<ImageViewport, CropState>;
      allConstrained: ConstrainedByViewport;
      allLocks: Record<ImageViewport, boolean>;
      maxVhValue: number | undefined;
      background: string;
      cropped: boolean;
      ownVariants: boolean;
      hoverCropped: boolean;
      coverSrc: string;
      hoverSrc: string;
      src: string;
      srcWidth?: number;
      srcHeight?: number;
      coverWidth?: number;
      coverHeight?: number;
      /** Set only when this step changed max-vh. Use a wrapper so `undefined` (Off) is distinct from "not this step". */
      maxVh?: { value: number | undefined };
    }

    let undoStack: CropUndoEntry[] = [];
    let redoStack: CropUndoEntry[] = [];
    let unregisterHistoryScope: (() => void) | null = null;
    let openingSnapshot: CropUndoEntry | null = null;
    const pageBaselines = new Map<HTMLElement, CropUndoEntry>();
    const appliedSnapshots = new Map<HTMLElement, CropUndoEntry>();
    const semanticCrop = (state: CropUndoEntry) => JSON.stringify({
      variants: state.allCover, hover: state.allHover, constrained: state.allConstrained,
      background: state.background, maxVh: state.maxVhValue, coverSrc: state.coverSrc, hoverSrc: state.hoverSrc,
    });
    const GESTURE_UNDO_CAP = 20;

    const snapshotViewport = (): CropUndoEntry => {
      const vp = selectedViewport;
      // Flush live draft into maps first so cover/hover match what is on screen.
      draftVariants[vp] = { ...draft };
      if (isListingCover(editTarget)) {
        if (activeSlot === 'cover') draftCoverVariants[vp] = { ...draft };
        else if (draftHoverVariants) draftHoverVariants[vp] = { ...draft };
      }
      const cover = structuredClone(
        isListingCover(editTarget) ? draftCoverVariants[vp] : draftVariants[vp],
      );
      const hover = draftHoverVariants ? structuredClone(draftHoverVariants[vp]) : null;
      return {
        cover,
        hover,
        lock: constrainByViewport[vp],
        widthConstrain: draftConstrained[vp],
        selectedViewport: vp,
        activeSlot,
        allCover: structuredClone(isListingCover(editTarget) ? draftCoverVariants : draftVariants),
        allHover: draftHoverVariants ? structuredClone(draftHoverVariants) : null,
        allDraft: structuredClone(draftVariants),
        allConstrained: structuredClone(draftConstrained),
        allLocks: structuredClone(constrainByViewport),
        maxVhValue: draftMaxVh,
        background: draftBackground,
        cropped: editTarget.classList.contains('project-cropped') || isGridTarget(editTarget),
        ownVariants: editTarget.dataset.devHasOwnVariants === 'true',
        hoverCropped: editTarget.classList.contains('project-grid__cover--hover-cropped'),
        coverSrc: activeSlot === 'cover' ? draftSrc : canonicalSrcFromUrl(editTarget.dataset.devImageSrc ? projectImage(editTarget.dataset.devImageSrc) : editTarget.querySelector<HTMLImageElement>('.project-grid__img--base')?.src || ''),
        hoverSrc: activeSlot === 'hover' ? draftSrc : canonicalSrcFromUrl(editTarget.dataset.devHoverImageSrc ? projectImage(editTarget.dataset.devHoverImageSrc) : editTarget.querySelector<HTMLImageElement>('.project-grid__img--hover')?.getAttribute('src') || ''),
        src: draftSrc,
        srcWidth: draftSrcWidth,
        srcHeight: draftSrcHeight,
        coverWidth: activeSlot === 'cover' ? draftSrcWidth : openingSnapshot?.coverWidth,
        coverHeight: activeSlot === 'cover' ? draftSrcHeight : openingSnapshot?.coverHeight,
      };
    };

    const pushUndo = (extra?: Pick<CropUndoEntry, 'src' | 'srcWidth' | 'srcHeight' | 'maxVh' | 'allCover' | 'allHover' | 'allDraft'>) => {
      const entry: CropUndoEntry = { ...snapshotViewport(), ...extra };
      undoStack.push(entry);
      // Keep the opening baseline as the oldest entry when the local ceiling is hit.
      if (undoStack.length > GESTURE_UNDO_CAP) undoStack.splice(1, 1);
      redoStack = [];
    };

    const pushUndoIfNeeded = (captured: { value: boolean }, extra?: Pick<CropUndoEntry, 'src' | 'srcWidth' | 'srcHeight' | 'maxVh' | 'allCover' | 'allHover' | 'allDraft'>) => {
      if (captured.value) return;
      captured.value = true;
      pushUndo(extra);
    };

    const applyUndoEntry = (entry: CropUndoEntry) => {
      const vp = entry.selectedViewport;
      selectedViewport = vp;
      activeSlot = entry.activeSlot;
      const activeImage = activeSlot === 'hover'
        ? editTarget.querySelector<HTMLImageElement>('.project-grid__img--hover')
        : (editTarget.querySelector<HTMLImageElement>('.project-grid__img--base')
          ?? editTarget.querySelector<HTMLImageElement>('img'));
      if (activeImage) editedImage = activeImage;
      draftCoverVariants = structuredClone(entry.allCover);
      draftHoverVariants = entry.allHover ? structuredClone(entry.allHover) : null;
      draftVariants = isListingCover(editTarget) && activeSlot === 'hover' && draftHoverVariants
        ? draftHoverVariants : draftCoverVariants;
      draftConstrained = structuredClone(entry.allConstrained);
      draftMaxVh = entry.maxVhValue;
      draftBackground = entry.background;
      applyBackgroundLive(editTarget, draftBackground);
      draftSrc = entry.src;
      draftSrcWidth = entry.srcWidth;
      draftSrcHeight = entry.srcHeight;
      draft = { ...draftVariants[vp] };
      constrainByViewport = structuredClone(entry.allLocks);
      writeConstraints(constrainByViewport);
      {
        applySrcLive(editTarget, entry.src, {
          ...(entry.srcWidth ? { srcWidth: entry.srcWidth } : {}),
          ...(entry.srcHeight ? { srcHeight: entry.srcHeight } : {}),
        });
        const url = projectImage(entry.src);
        previewImage.src = url;
        if (pageStage) pageStage.ghostImg.src = url;
      }
      maxVhSelect.value = draftMaxVh ? String(draftMaxVh) : '';
      if (isStandaloneMedia(editTarget)) {
        applyFrameFlagsLive(editTarget, {
          constrained: draftConstrained,
          maxVh: draftMaxVh,
        });
      }
      if (entry.coverSrc) applySrcLive(editTarget, entry.coverSrc, { srcWidth: entry.coverWidth, srcHeight: entry.coverHeight }, 'cover');
      if (isListingCover(editTarget) && entry.hoverSrc) applySrcLive(editTarget, entry.hoverSrc, undefined, 'hover');
      if (entry.cropped) beginLiveEdits();
      if (!entry.cropped && !isGridTarget(editTarget)) {
        editTarget.classList.remove('project-cropped', 'project-responsive-image');
        removeCropClipIfOwned(editedImage);
        if (isListingCover(editTarget)) {
          editTarget.classList.add('overflow-hidden');
          editedImage.classList.add('w-full', 'h-full', 'object-cover');
        }
        liveApply = false;
      }
      renderConstraint();
      syncWidthConstrainUi();
      renderDraft();
      editTarget.dataset.devHasOwnVariants = String(entry.ownVariants);
      if (!entry.cropped && !isGridTarget(editTarget)) delete editTarget.dataset.devImageVariants;
      if (isListingCover(editTarget)) {
        editTarget.classList.toggle('project-grid__cover--hover-cropped', entry.hoverCropped);
        if (!entry.hoverCropped) delete editTarget.dataset.devHoverVariants;
      }
    };

    const snapshotForRedo = (entry: CropUndoEntry): CropUndoEntry => {
      const now = snapshotViewport();
      now.src = draftSrc;
      now.srcWidth = draftSrcWidth;
      now.srcHeight = draftSrcHeight;
      now.maxVhValue = draftMaxVh;
      return now;
    };

    const clearAllStacks = () => {
      undoStack = [];
      redoStack = [];
    };
    let constrainByViewport = readConstraints();
    const constrainToFrame = () => constrainByViewport[selectedViewport];
    /** Disk / last globally-saved baseline per pending id (survives popup close). */
    const diskBaselines = new Map<string, {
      variants: Record<ImageViewport, CropState>;
      constrained: ConstrainedByViewport;
      maxVh: number | undefined;
      cropped: boolean;
      src: string;
      srcWidth?: number;
      srcHeight?: number;
    }>();
    const VIEWPORTS: ImageViewport[] = ['desktop', 'tablet', 'mobile'];
    let savedSrc = '';
    let draftSrc = '';
    let savedSrcWidth: number | undefined;
    let savedSrcHeight: number | undefined;
    let draftSrcWidth: number | undefined;
    let draftSrcHeight: number | undefined;
    const stagedSources = new Map<string, {
      src: string;
      srcWidth?: number;
      srcHeight?: number;
    }>();
    const pendingIdFor = (target: HTMLElement, slot: 'cover' | 'hover' = activeSlot) =>
      `${devEditPendingId('crop', target)}${slot === 'hover' ? ':hover' : ''}`;

    const canonicalSrcFromUrl = (url: string) => {
      try {
        const pathname = new URL(url, window.location.origin).pathname;
        if (pathname.startsWith('/images/')) {
          return decodeURIComponent(pathname.slice('/images/'.length));
        }
      } catch {
        // Fall through.
      }
      return '';
    };

    const readTargetSrc = (image: HTMLImageElement) => {
      const target = image.closest<HTMLElement>('[data-dev-image-target]');
      const original = image.classList.contains('project-grid__img--hover')
        ? target?.dataset.devHoverImageSrc : target?.dataset.devImageSrc;
      return canonicalSrcFromUrl(original ? projectImage(original) : image.src || image.currentSrc);
    };

    const readTargetDims = (image: HTMLImageElement) => {
      const target = image.classList.contains('project-grid__img--hover') ? null : image.closest<HTMLElement>('[data-dev-image-target]');
      const srcWidth = Number(target?.dataset.devImageSrcWidth) || image.naturalWidth || undefined;
      const srcHeight = Number(target?.dataset.devImageSrcHeight) || image.naturalHeight || undefined;
      return {
        ...(srcWidth ? { srcWidth } : {}),
        ...(srcHeight ? { srcHeight } : {}),
      };
    };

    const snapshotBaseline = (target: HTMLElement) => {
      const image = target.querySelector<HTMLImageElement>('img');
      const dims = image ? readTargetDims(image) : {};
      return {
        variants: readAppliedVariants(target),
        constrained: isStandaloneMedia(target) ? readConstrainedFromTarget(target) : resolveImageGridConstrained(false),
        maxVh: supportsMaxVh(target) ? readMaxVh(target) : undefined,
        cropped: target.classList.contains('project-cropped') || isGridTarget(target),
        src: image ? readTargetSrc(image) : '',
        ...dims,
      };
    };

    const closePanel = () => {
      const panel = tuner.closest<HTMLElement>('[data-dev-panel-key]');
      if (!panel || panel.hidden) return;
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
        detail: { panel },
      }));
    };

    const applyVariantsToTarget = (
      target: HTMLElement,
      variants: Record<ImageViewport, CropState>,
      options?: { clearOwn?: boolean; hoverVariants?: Record<ImageViewport, CropState> | null },
    ) => {
      const image = pageImageFor(target);
      VIEWPORTS.forEach((viewport) => {
        setTargetVariant(target, viewport, variants[viewport]);
      });
      if (options?.clearOwn) {
        delete target.dataset.devHasOwnVariants;
        target.dataset.devImageVariants = JSON.stringify(variants);
      } else {
        target.dataset.devImageVariants = JSON.stringify(variants);
        if (isGridTarget(target)) target.dataset.devHasOwnVariants = 'true';
      }
      if (options?.hoverVariants) {
        target.dataset.devHoverVariants = JSON.stringify(options.hoverVariants);
        target.classList.add('project-grid__cover--hover-cropped');
        VIEWPORTS.forEach((viewport) => {
          setHoverTargetVariant(target, viewport, options.hoverVariants![viewport]);
        });
      }
    };

    const pageImageFor = (target: HTMLElement, slot?: 'cover' | 'hover') => {
      // While the on-page crop stage is mounted the ghost <img> is prepended
      // first — never treat that as the content bitmap.
      if (!slot && target === editTarget && editedImage?.isConnected) return editedImage;
      if (isListingCover(target) && (slot ?? activeSlot) === 'hover') {
        return target.querySelector<HTMLImageElement>('.project-grid__img--hover');
      }
      return (
        target.querySelector<HTMLImageElement>('.project-grid__img--base')
        ?? [...target.querySelectorAll<HTMLImageElement>('img')]
          .find((img) => !img.closest('.dev-crop-ghost'))
        ?? null
      );
    };

    const closeBackgroundPicker = () => {
      backgroundPicker?.shadowRoot?.querySelector<HTMLDialogElement>('dialog')?.close();
      backgroundPicker?.removeAttribute('open');
    };

    const syncBackgroundControl = () => {
      if (backgroundWrap) backgroundWrap.hidden = isListingCover(editTarget);
      if (isListingCover(editTarget)) return;
      if (backgroundInput) {
        backgroundInput.value = draftBackground === 'transparent' ? '' : draftBackground;
        backgroundInput.removeAttribute('aria-invalid');
      }
      if (backgroundSwatch) backgroundSwatch.style.backgroundColor = draftBackground;
      if (backgroundNone) {
        backgroundNone.setAttribute('aria-pressed', String(draftBackground === 'transparent'));
        backgroundNone.classList.toggle('is-selected', draftBackground === 'transparent');
      }
      const clip = preview.querySelector<HTMLElement>('.tapico-crop-tuner__preview-clip');
      if (clip) clip.style.backgroundColor = draftBackground;
      previewImage.style.backgroundColor = draftBackground;
      if (pageStage) pageStage.ghostImg.style.backgroundColor = draftBackground;
    };

    const applyBackgroundLive = (target: HTMLElement, value: string) => {
      if (isListingCover(target)) return;
      const background = normalizeImageBackground(value) ?? 'transparent';
      target.dataset.devImageBackground = background;
      target.style.setProperty('--project-image-background', background);
      if (target === editTarget) syncBackgroundControl();
    };

    const applySrcLive = (
      target: HTMLElement,
      src: string,
      dims?: { srcWidth?: number; srcHeight?: number },
      slot: 'cover' | 'hover' = activeSlot,
    ) => {
      if (!src) return null;
      const image = pageImageFor(target, slot);
      if (!image) return null;
      if (image.getAttribute('src') !== projectImage(src)) cancelImagePreviewUpgrade(image);
      sourceRevision += 1;
      image.removeAttribute('srcset');
      image.src = projectImage(src);
      syncPlaceholderState(target, src, slot);
      if (slot === 'hover') target.dataset.devHoverImageSrc = src;
      else {
        target.dataset.devImageSrc = src;
        syncImageSourceDims(target, dims);
      }
      if (isListingCover(target)) {
        const resolvedSrc = projectImage(src);
        if (slot === 'hover') {
          image.hidden = false;
          target.classList.add('project-grid__cover--has-hover');
        } else {
          delete target.dataset.devCoverEmpty;
        }
        const item = target.closest('[data-dev-project-slug]');
        const slug = item?.getAttribute('data-dev-project-slug');
        if (slug) {
          window.dispatchEvent(new CustomEvent('vcd:dev-listing-src', {
            detail: {
              slug,
              slot: slot === 'hover' ? 'hoverImage' : 'image',
              src: resolvedSrc,
            },
          }));
        }
      }
      if (target === editTarget) syncPreviewPlaceholder();
      return image;
    };

    /**
     * Pan bounds, closed form — no DOM measurement. The visible source rect is
     * `w` x `h` centred on (cx, cy), so keeping its edges inside the bitmap means
     * cx in [w/2, 1 - w/2] and likewise for cy. When w is 1 the bounds collapse
     * to 0.5: a frame showing the full width simply cannot pan horizontally.
     */
    const constrainDraft = () => {
      draft.w = clamp(draft.w, coverW(draft.aspect) / ZOOM_MAX, coverW(draft.aspect) / minZoom());
      if (!constrainToFrame()) {
        const h = contentH(draft);
        const xReach = Math.max(1.5, draft.w / 2);
        const yReach = Math.max(1.5, h / 2);
        draft.cx = clamp(draft.cx, 0.5 - xReach, 0.5 + xReach);
        draft.cy = clamp(draft.cy, 0.5 - yReach, 0.5 + yReach);
        return;
      }
      const h = contentH(draft);
      draft.cx = clamp(draft.cx, draft.w / 2, 1 - draft.w / 2);
      draft.cy = clamp(draft.cy, h / 2, 1 - h / 2);
    };

    const renderConstraint = () => {
      const locked = constrainToFrame();
      zoomInput.min = String(minZoom());
      constraintButton.setAttribute('aria-pressed', locked ? 'true' : 'false');
      constraintButton.classList.toggle('is-locked', locked);
      constraintIcon.innerHTML = locked ? LOCK_ICON : LOCK_OPEN_ICON;
      constraintState.textContent = locked ? 'Crop locked' : 'Crop unlocked';
    };

    const setCropVariables = (element: HTMLElement, crop: CropState) => {
      element.style.setProperty('--tuner-content-w', String(crop.w));
      element.style.setProperty('--tuner-content-cx', String(crop.cx));
      element.style.setProperty('--tuner-content-cy', String(crop.cy));
    };

    const setTargetVariant = (
      target: HTMLElement,
      viewport: ImageViewport,
      crop: CropState,
    ) => {
      const ratioNum = crop.aspect === 'original'
        ? null
        : (() => {
          const [widthRaw, heightRaw] = crop.aspect.split(':').map(Number);
          return widthRaw && heightRaw ? widthRaw / heightRaw : null;
        })();
      target.style.setProperty(
        `--project-image-ratio-${viewport}`,
        crop.aspect === 'original'
          ? 'var(--project-image-original-ratio, 1 / 1)'
          : crop.aspect.replace(':', ' / '),
      );
      target.style.setProperty(
        `--project-image-ratio-num-${viewport}`,
        ratioNum === null
          ? 'var(--project-image-original-ratio-num, 1)'
          : String(ratioNum),
      );
      target.style.setProperty(`--project-content-w-${viewport}`, String(crop.w));
      target.style.setProperty(`--project-content-cx-${viewport}`, String(crop.cx));
      target.style.setProperty(`--project-content-cy-${viewport}`, String(crop.cy));
    };

    const setHoverTargetVariant = (
      target: HTMLElement,
      viewport: ImageViewport,
      crop: CropState,
    ) => {
      target.style.setProperty(`--project-hover-content-w-${viewport}`, String(crop.w));
      target.style.setProperty(`--project-hover-content-cx-${viewport}`, String(crop.cx));
      target.style.setProperty(`--project-hover-content-cy-${viewport}`, String(crop.cy));
    };

    const syncLinkedListingAspect = (aspect: string, fromHoverAspect?: string) => {
      if (!isListingCover(editTarget)) return;
      draftCoverVariants[selectedViewport].aspect = aspect;
      if (draftHoverVariants) {
        const hoverState = draftHoverVariants[selectedViewport];
        // Zoom must be read from the *previous* aspect. Assigning `aspect`
        // first made hoverZoomOf / hoverWForZoom cancel out, so `w` never
        // moved and the hover bitmap letterboxed until a pan/zoom.
        const zoomAspect = fromHoverAspect ?? hoverState.aspect;
        const hoverSrcAspect = hoverImgSrcAspect(editTarget);
        if (hoverSrcAspect) {
          const zoom = hoverZoomOf({ ...hoverState, aspect: zoomAspect }, hoverSrcAspect);
          hoverState.w = hoverWForZoom(aspect, Math.max(minZoom(), zoom), hoverSrcAspect);
        } else {
          bindHoverSrcAspect(editTarget, zoomAspect);
        }
        hoverState.aspect = aspect;
        // Fill correction is display truth, not a draft crop edit — apply even
        // while liveApply is still false (otherwise the page letterboxes until
        // the first pan and then snaps).
        setHoverTargetVariant(editTarget, selectedViewport, hoverState);
        editTarget.classList.add('project-grid__cover--hover-cropped');
        editTarget.dataset.devHoverVariants = JSON.stringify(draftHoverVariants);
      }
    };

    /** First user crop change in this session — enable live page writes + frame classes. */
    const ensureCropClip = (target: HTMLElement, image: HTMLImageElement) => {
      if (isGridTarget(target)) return;
      if (image.parentElement?.classList.contains('project-crop-clip')) return;
      const clip = document.createElement('div');
      clip.className = 'project-crop-clip';
      image.replaceWith(clip);
      clip.append(image);
    };

    const ensureListingCropClip = (target: HTMLElement) => {
      const stack = target.querySelector('.project-grid__stack');
      if (!stack) return;
      let clip = stack.querySelector('.project-crop-clip');
      const base = stack.querySelector<HTMLImageElement>('.project-grid__img--base');
      const hover = stack.querySelector<HTMLElement>('.project-grid__hover-layer');
      if (!clip && base) {
        clip = document.createElement('div');
        clip.className = 'project-crop-clip';
        base.replaceWith(clip);
        clip.append(base);
      }
      if (clip && hover && hover.parentElement !== clip) {
        clip.append(hover);
      }
    };

    const removeCropClipIfOwned = (image: HTMLImageElement) => {
      const clip = image.parentElement;
      if (!clip?.classList.contains('project-crop-clip')) return;
      // Only unwrap when the clip has a single img (our live-edit wrapper).
      if (clip.childElementCount !== 1) return;
      clip.replaceWith(image);
    };

    const beginLiveEdits = () => {
      if (!editingSession || liveApply) return;
      liveApply = true;
      if (!isGridTarget(editTarget)) {
        editTarget.classList.add('project-responsive-image', 'project-cropped');
        if (isListingCover(editTarget)) {
          // Cover starts with utility overflow-hidden for object-fit; crop clip owns clipping.
          editTarget.classList.remove('overflow-hidden');
        }
        // SSR cropped frames already wrap <img> in .project-crop-clip; live-first
        // crop must add it or overflow:visible on .project-cropped lets zoom spill.
        if (isListingCover(editTarget)) {
          ensureListingCropClip(editTarget);
        } else {
          ensureCropClip(editTarget, editedImage);
        }
        // An uncropped max-vh image legitimately carries the img-level class from
        // SSR; now that the target is cropped it would clamp the cover bitmap.
        editedImage.classList.remove('project-media__img--max-vh', 'project-media__img--max80');
        editedImage.classList.remove('w-full', 'h-full', 'object-cover');
      }
    };

    /**
     * Crop CSS only — safe to call every animation frame during pan/pinch/wheel.
     * Skips panel chrome, stage remeasure, and frame-change events (those thrash).
     */
    const paintDraftCrop = () => {
      // Bounds are closed form now, so clamping on open can't shift a saved crop.
      constrainDraft();
      draftVariants[selectedViewport] = { ...draft };
      if (isListingCover(editTarget)) {
        if (activeSlot === 'cover') {
          draftCoverVariants[selectedViewport] = { ...draft };
        } else if (draftHoverVariants) {
          draftHoverVariants[selectedViewport] = { ...draft };
        }
      }
      setCropVariables(preview, draft);
      if (liveApply) {
        if (isListingCover(editTarget)) {
          setTargetVariant(editTarget, selectedViewport, draftCoverVariants[selectedViewport]);
          if (draftHoverVariants) {
            setHoverTargetVariant(editTarget, selectedViewport, draftHoverVariants[selectedViewport]);
            editTarget.classList.add('project-grid__cover--hover-cropped');
          }
        } else {
          setTargetVariant(editTarget, selectedViewport, draft);
        }
      }
    };

    /** Panel readouts + stage box — use after discrete edits, or throttled mid-gesture. */
    const flushDraftChrome = (options?: { announce?: boolean }) => {
      preview.style.aspectRatio = draft.aspect === 'original'
        ? `${previewImage.naturalWidth || 1} / ${previewImage.naturalHeight || 1}`
        : draft.aspect.replace(':', ' / ');
      if (liveApply) {
        if (editedImage.naturalWidth && editedImage.naturalHeight) {
          editTarget.style.setProperty(
            '--project-image-original-ratio',
            `${editedImage.naturalWidth} / ${editedImage.naturalHeight}`,
          );
          editTarget.style.setProperty(
            '--project-image-original-ratio-num',
            String(editedImage.naturalWidth / editedImage.naturalHeight),
          );
        }
        editTarget.dataset.devImageVariants = JSON.stringify(draftCoverVariants);
        if (draftHoverVariants) {
          editTarget.dataset.devHoverVariants = JSON.stringify(draftHoverVariants);
        }
        if (options?.announce !== false) announceFrameChange(editTarget);
      }
      syncAspectRatioSelect();
      viewportButtons.forEach((button) => {
        const active = button.dataset.cropViewport === selectedViewport;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      const zoom = zoomOf(draft);
      zoomInput.value = zoom.toFixed(3);
      zoomOutput.value = `${Math.round(zoom * 100)}%`;
      const ratioLabel = PRESET_ASPECT_RATIOS.has(draft.aspect)
        ? draft.aspect
        : formatAspectRatio(draft.aspect);
      readout.textContent = `${ratioLabel} · shows ${Math.round(draft.w * 100)}% of width · centre ${draft.cx.toFixed(3)}, ${draft.cy.toFixed(3)}`;
      // Frame edits reshape the clip; keep the on-page surface glued to it.
      syncPageStageBox();
    };

    const syncDraftDirty = () => {
      draftDirty = Boolean(openingSnapshot && semanticCrop(openingSnapshot) !== semanticCrop(snapshotViewport()));
    };
    const renderDraft = () => {
      paintDraftCrop();
      flushDraftChrome();
      syncDraftDirty();
    };

    const applyPageCrop = (target: HTMLElement, state: CropUndoEntry) => {
      if (!target.isConnected) throw new Error('Restore this image before restoring its crop.');
      const listing = isListingCover(target);
      applyVariantsToTarget(target, state.allCover, { clearOwn: !state.ownVariants, hoverVariants: state.allHover });
      target.classList.toggle('project-cropped', state.cropped && !isGridTarget(target));
      target.classList.toggle('project-responsive-image', state.cropped || isGridTarget(target));
      if (!state.cropped) delete target.dataset.devImageVariants;
      if (listing) {
        target.classList.toggle('overflow-hidden', !state.cropped);
        target.classList.toggle('project-grid__cover--hover-cropped', state.hoverCropped);
        if (!state.hoverCropped) delete target.dataset.devHoverVariants;
      }
      const image = pageImageFor(target, 'cover');
      if (image && !isGridTarget(target)) {
        if (state.cropped) {
          if (listing) ensureListingCropClip(target);
          else ensureCropClip(target, image);
          image.classList.remove('w-full', 'h-full', 'object-cover');
        } else {
          removeCropClipIfOwned(image);
          image.style.width = '';
          image.style.height = '';
          if (listing) image.classList.add('w-full', 'h-full', 'object-cover');
        }
      }
      if (state.coverSrc) applySrcLive(target, state.coverSrc, { srcWidth: state.coverWidth, srcHeight: state.coverHeight }, 'cover');
      if (listing) {
        if (state.hoverSrc) applySrcLive(target, state.hoverSrc, undefined, 'hover');
        else {
          const hoverImage = pageImageFor(target, 'hover');
          if (hoverImage) { hoverImage.removeAttribute('src'); hoverImage.hidden = true; }
          target.dataset.devHoverImageSrc = '';
          target.classList.remove('project-grid__cover--has-hover');
          const slug = target.closest<HTMLElement>('[data-dev-project-slug]')?.dataset.devProjectSlug;
          if (slug) window.dispatchEvent(new CustomEvent('vcd:dev-listing-src', { detail: { slug, slot: 'hoverImage', src: '' } }));
        }
      }
      if (isStandaloneMedia(target) || isCarouselItem(target)) applyFrameFlagsLive(target, { constrained: state.allConstrained, maxVh: state.maxVhValue });
      applyBackgroundLive(target, state.background);
      appliedSnapshots.set(target, structuredClone(state));
      for (const slot of listing ? ['cover', 'hover'] as const : ['cover'] as const) {
        const src = slot === 'cover' ? state.coverSrc : state.hoverSrc;
        stagedSources.set(pendingIdFor(target, slot), { src, srcWidth: state.srcWidth, srcHeight: state.srcHeight });
      }
      if (target === editTarget) {
        savedCoverVariants = structuredClone(state.allCover);
        savedHoverVariants = state.allHover ? structuredClone(state.allHover) : null;
        draftCoverVariants = structuredClone(savedCoverVariants);
        draftHoverVariants = savedHoverVariants ? structuredClone(savedHoverVariants) : null;
        draftVariants = listing && activeSlot === 'hover' && draftHoverVariants ? draftHoverVariants : draftCoverVariants;
        savedVariants = listing && activeSlot === 'hover' && savedHoverVariants ? savedHoverVariants : savedCoverVariants;
        savedConstrained = { ...state.allConstrained };
        draftConstrained = { ...state.allConstrained };
        savedMaxVh = draftMaxVh = state.maxVhValue;
        savedBackground = draftBackground = state.background;
        syncBackgroundControl();
        savedSrc = draftSrc = listing && activeSlot === 'hover' ? state.hoverSrc : state.coverSrc;
        savedSrcWidth = draftSrcWidth = state.srcWidth;
        savedSrcHeight = draftSrcHeight = state.srcHeight;
        targetWasCropped = state.cropped;
        targetHadOwnVariants = state.ownVariants;
        targetVariantsAttr = state.cropped ? JSON.stringify(state.allCover) : null;
        saved = { ...savedVariants[selectedViewport] };
        draft = { ...draftVariants[selectedViewport] };
        liveApply = false;
        openingSnapshot = structuredClone(state);
        clearAllStacks();
        renderDraft();
        syncWidthConstrainUi();
      }
      announceFrameChange(target);
    };
    const recordPageCrop = (target: HTMLElement, before: CropUndoEntry, after: CropUndoEntry) => {
      if (pageHistory.replaying || (semanticCrop(before) === semanticCrop(after)
        && before.ownVariants === after.ownVariants && before.cropped === after.cropped)) return;
      const restore = (state: CropUndoEntry) => {
        const disk = structuredClone(pageBaselines.get(target) ?? before);
        applyPageCrop(target, state);
        const slots = isListingCover(target) ? ['cover', 'hover'] as const : ['cover'] as const;
        for (const slot of slots) {
          const id = pendingIdFor(target, slot);
          if (semanticCrop(state) === semanticCrop(disk) && state.cropped === disk.cropped && state.ownVariants === disk.ownVariants) {
            window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id } }));
            continue;
          }
          const clearVariants = !state.cropped || (isGridTarget(target) && !state.ownVariants);
          window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', { detail: {
            id, kind: 'crop', payload: {
              document: target.dataset.devDocument, path: JSON.parse(target.dataset.devImagePath || '[]'),
              ...(slot === 'cover' ? {
                ...(!isListingCover(target) ? { background: state.background } : {}),
                ...(clearVariants ? { clearVariants: true } : { variants: structuredClone(state.allCover) }),
                ...(state.coverSrc ? { src: state.coverSrc, srcWidth: state.coverWidth, srcHeight: state.coverHeight } : {}),
                ...(isStandaloneMedia(target) ? { constrained: { ...state.allConstrained }, centered: imageHasWidthConstraint(state.allConstrained) } : {}),
                ...(supportsMaxVh(target) ? { maxVh: state.maxVhValue ?? 0 } : {}),
              } : {
                slot: 'hoverImage',
                ...(state.hoverSrc ? { src: state.hoverSrc } : { clearHoverImage: true }),
                ...(state.hoverCropped && state.allHover ? { hoverVariants: structuredClone(state.allHover) } : { clearHoverVariants: true }),
              }),
            }, revert: () => applyPageCrop(target, disk),
          } }));
        }
      };
      pageHistory.push({ label: 'Edit image', undo: () => restore(before), redo: () => restore(after) });
    };

    const saveDraft = () => {
      const target = editTarget;
      const beforeState = openingSnapshot ? structuredClone(openingSnapshot) : snapshotViewport();
      const documentKey = target.dataset.devDocument;
      let imagePath: Array<string | number> = [];
      try {
        imagePath = JSON.parse(target.dataset.devImagePath || '[]');
      } catch {
        imagePath = [];
      }
      if (!documentKey || !Array.isArray(imagePath) || !imagePath.length) {
        status.textContent = 'This image is not wired for saving.';
        return;
      }

      draftVariants[selectedViewport] = { ...draft };
      if (isListingCover(target)) {
        if (activeSlot === 'cover') {
          draftCoverVariants[selectedViewport] = { ...draft };
        } else if (draftHoverVariants) {
          draftHoverVariants[selectedViewport] = { ...draft };
        }
      }
      const stagedCoverVariants = structuredClone(draftCoverVariants);
      const stagedHoverVariants = draftHoverVariants
        ? structuredClone(draftHoverVariants)
        : null;
      const stagedVariants = isListingCover(target) ? stagedCoverVariants : structuredClone(draftVariants);
      const stagedConstrained = draftConstrained;
      const stagedMaxVh = draftMaxVh;
      const standalone = isStandaloneMedia(target);
      const carouselItem = isCarouselItem(target);
      const persistCrop = targetWasCropped || liveApply;
      const srcChanged = Boolean(draftSrc) && draftSrc !== savedSrc;
      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, {
          variants: structuredClone(savedVariants),
          constrained: savedConstrained,
          maxVh: savedMaxVh,
          cropped: targetWasCropped,
          src: savedSrc,
          ...(savedSrcWidth ? { srcWidth: savedSrcWidth } : {}),
          ...(savedSrcHeight ? { srcHeight: savedSrcHeight } : {}),
        });
      }
      const baseline = structuredClone(diskBaselines.get(pendingId)!);
      const srcPending = Boolean(draftSrc) && draftSrc !== baseline.src;
      const hadOwnVariants = target.dataset.devHasOwnVariants === 'true';

      if (srcPending) {
        stagedSources.set(pendingId, {
          src: draftSrc,
          ...(draftSrcWidth ? { srcWidth: draftSrcWidth } : {}),
          ...(draftSrcHeight ? { srcHeight: draftSrcHeight } : {}),
        });
      } else {
        stagedSources.delete(pendingId);
      }

      if (persistCrop) {
        applyVariantsToTarget(target, stagedVariants, {
          hoverVariants: stagedHoverVariants,
        });
        savedVariants = structuredClone(stagedVariants);
        savedCoverVariants = structuredClone(stagedCoverVariants);
        if (stagedHoverVariants) {
          savedHoverVariants = structuredClone(stagedHoverVariants);
          draftHoverVariants = structuredClone(stagedHoverVariants);
        }
        draftCoverVariants = structuredClone(stagedCoverVariants);
        saved = { ...stagedVariants[selectedViewport] };
        targetWasCropped = true;
      }
      if (srcChanged) {
        applySrcLive(target, draftSrc, activeSlot === 'hover'
          ? undefined
          : {
            ...(draftSrcWidth ? { srcWidth: draftSrcWidth } : {}),
            ...(draftSrcHeight ? { srcHeight: draftSrcHeight } : {}),
          });
        savedSrc = draftSrc;
        savedSrcWidth = draftSrcWidth;
        savedSrcHeight = draftSrcHeight;
      }
      if (standalone || carouselItem) {
        applyFrameFlagsLive(target, { constrained: stagedConstrained, maxVh: stagedMaxVh });
        savedConstrained = { ...stagedConstrained };
        savedMaxVh = stagedMaxVh;
      }
      savedBackground = draftBackground;
      savedSinceSelect = true;
      if (isGridTarget(target) && persistCrop) {
        target.dataset.devHasOwnVariants = 'true';
        targetHadOwnVariants = true;
        syncUseGridDefaultButton();
      }

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'crop',
          payload: {
            document: documentKey,
            path: imagePath,
            ...(!isListingCover(target) ? { background: draftBackground } : {}),
            ...(persistCrop ? { variants: stagedVariants } : {}),
            ...(persistCrop && stagedHoverVariants ? { hoverVariants: stagedHoverVariants } : {}),
            ...(isListingCover(target)
              ? { slot: activeSlot === 'hover' ? 'hoverImage' : 'image' }
              : {}),
            ...(srcPending
              ? {
                src: draftSrc,
                ...(activeSlot !== 'hover' && draftSrcWidth ? { srcWidth: draftSrcWidth } : {}),
                ...(activeSlot !== 'hover' && draftSrcHeight ? { srcHeight: draftSrcHeight } : {}),
              }
              : {}),
            ...(standalone
              ? {
                constrained: stagedConstrained,
                centered: imageHasWidthConstraint(stagedConstrained),
                maxVh: stagedMaxVh ?? 0,
              }
              : {}),
            ...(carouselItem ? { maxVh: stagedMaxVh ?? 0 } : {}),
          },
          revert: () => applyPageCrop(target, pageBaselines.get(target) ?? beforeState),
        },
      }));

      const afterState = snapshotViewport();
      if (!pageBaselines.has(target)) pageBaselines.set(target, structuredClone(beforeState));
      appliedSnapshots.set(target, structuredClone(afterState));
      recordPageCrop(target, beforeState, afterState);
      openingSnapshot = structuredClone(afterState);

      status.textContent = 'Staged — use Save in the page bar to write to disk.';
      clearAllStacks();
      draftDirty = false;
      closePanel();
    };

    const refreshCover = () => {
      if (editedImage.naturalWidth) renderDraft();
    };

    previewImage.addEventListener('load', refreshCover);
    window.addEventListener('resize', refreshCover);

    const resizeObserver = typeof ResizeObserver === 'undefined'
      ? null
      : new ResizeObserver(refreshCover);
    resizeObserver?.observe(preview);

    /** Take the crop frame back off a target that had none before this session. */
    const stripLiveCropFrame = () => {
      if (!editTarget || isGridTarget(editTarget)) return;
      editTarget.classList.remove('project-cropped', 'project-responsive-image');
      if (isListingCover(editTarget)) {
        editTarget.classList.add('overflow-hidden');
        editedImage.classList.add('w-full', 'h-full', 'object-cover');
      }
      // Restore the attribute rather than dropping it, so a cancelled session
      // leaves the target byte-identical to how it was rendered.
      if (targetVariantsAttr === null) delete editTarget.dataset.devImageVariants;
      else editTarget.dataset.devImageVariants = targetVariantsAttr;
      removeCropClipIfOwned(editedImage);
    };

    /**
     * Snap the page back to the last saved crop — the single "cancel" shared by
     * the Revert button, the panel close control, the Edit image toggle and
     * Escape. "Saved" means the last tuner Save (staged into the pending batch),
     * or the state read off the page when this target was selected; so saving
     * and then cancelling without touching anything is a no-op.
     */
    const revertToSaved = () => {
      const target = editTarget;
      if (!target) return;
      if (openingSnapshot) {
        applyPageCrop(target, openingSnapshot);
        draftDirty = false;
        return;
      }

      draftCoverVariants = structuredClone(savedCoverVariants);
      if (savedHoverVariants) {
        draftHoverVariants = structuredClone(savedHoverVariants);
      }
      draftVariants = isListingCover(target) && activeSlot === 'hover' && draftHoverVariants
        ? structuredClone(draftHoverVariants)
        : isListingCover(target)
          ? structuredClone(draftCoverVariants)
          : structuredClone(savedVariants);
      saved = { ...draftVariants[selectedViewport] };
      draft = { ...saved };
      draftConstrained = { ...savedConstrained };
      draftMaxVh = savedMaxVh;
      draftBackground = savedBackground;
      applyBackgroundLive(target, draftBackground);
      syncBackgroundControl();
      const srcNeedsRestore = Boolean(savedSrc) && draftSrc !== savedSrc;
      draftSrc = savedSrc;
      draftSrcWidth = savedSrcWidth;
      draftSrcHeight = savedSrcHeight;

      if (liveApply || savedSinceSelect || srcNeedsRestore) {
        if (srcNeedsRestore) {
          applySrcLive(target, savedSrc, {
            ...(savedSrcWidth ? { srcWidth: savedSrcWidth } : {}),
            ...(savedSrcHeight ? { srcHeight: savedSrcHeight } : {}),
          });
          const url = projectImage(savedSrc);
          previewImage.src = url;
          if (pageStage) pageStage.ghostImg.src = url;
        }
        if (targetWasCropped || savedSinceSelect) {
          // Restore every breakpoint, not just the one on screen — the session
          // may have edited others via the viewport chips.
          const variantsForTarget = isListingCover(target)
            ? savedCoverVariants
            : savedVariants;
          applyVariantsToTarget(
            target,
            variantsForTarget,
            {
              ...(isGridTarget(target) && !targetHadOwnVariants ? { clearOwn: true } : {}),
              ...(savedHoverVariants ? { hoverVariants: savedHoverVariants } : {}),
            },
          );
        } else if (liveApply || savedSinceSelect) {
          stripLiveCropFrame();
        }
      }

      // Order matters: the img-level max-vh class is only correct once the
      // frame classes above have settled (it must stay off cropped images).
      if (isStandaloneMedia(target)) {
        applyFrameFlagsLive(target, {
          constrained: savedConstrained,
          maxVh: savedMaxVh,
        });
      }
      syncWidthConstrainUi();
      liveApply = false;
      clearAllStacks();
      draftDirty = false;
    };

    let previewLabelObserver: MutationObserver | null = null;
    let previewLabelInputCleanup: (() => void) | null = null;
    let previewLabelFitCleanup: (() => void) | null = null;

    const isPlaceholderTarget = (target: HTMLElement | null): boolean => {
      if (!target) return false;
      if (target.classList.contains('project-media--placeholder')) return true;
      const src = activeSlot === 'hover'
        ? target.dataset.devHoverImageSrc
        : target.dataset.devImageSrc;
      if (src) return isPlaceholderSrc(src);
      const img = pageImageFor(target, activeSlot);
      return Boolean(img && isPlaceholderSrc(img.getAttribute('src') || img.src));
    };

    const syncPreviewPlaceholder = () => {
      if (!preview) return;
      const isPh = isPlaceholderTarget(editTarget);
      preview.classList.toggle('tapico-crop-tuner__preview--placeholder', isPh);
      previewLabelInputCleanup?.();
      previewLabelInputCleanup = null;
      previewLabelObserver?.disconnect();
      previewLabelObserver = null;
      previewLabelFitCleanup?.();
      previewLabelFitCleanup = null;

      if (!isPh || !previewPlaceholderLabel) return;

      const pageLabel = editTarget.querySelector<HTMLElement>('.project-media__placeholder-label-text');
      const syncLabelText = () => {
        if (!previewPlaceholderLabel) return;
        previewPlaceholderLabel.textContent = pageLabel?.textContent?.trim() || 'Placeholder';
        previewLabelFitCleanup?.();
        previewLabelFitCleanup = bindFitPlaceholderLabel(previewPlaceholderLabel);
      };
      syncLabelText();

      if (pageLabel) {
        const onInput = () => syncLabelText();
        pageLabel.addEventListener('input', onInput);
        pageLabel.addEventListener('keyup', onInput);
        previewLabelInputCleanup = () => {
          pageLabel.removeEventListener('input', onInput);
          pageLabel.removeEventListener('keyup', onInput);
        };
        previewLabelObserver = new MutationObserver(syncLabelText);
        previewLabelObserver.observe(pageLabel, { characterData: true, subtree: true, childList: true });
      }
    };

    const selectTarget = (target: HTMLElement, live: boolean) => {
      const preserveLiveApply = editingSession && live && target === editTarget && liveApply;
      const preserveLocalHistory = editingSession && live && target === editTarget;
      if (!preserveLocalHistory) clearAllStacks();
      activeSlot = listingEditSlot(target);
      const image = activeSlot === 'hover'
        ? target.querySelector<HTMLImageElement>('.project-grid__img--hover')
        : (target.querySelector<HTMLImageElement>('.project-grid__img--base')
          ?? target.querySelector<HTMLImageElement>('img'));
      if (!image) return;

      unmountPageStage();
      resizeObserver?.unobserve(editTarget);
      editTarget = target;
      editedImage = image;
      resizeObserver?.observe(editTarget);

      editingSession = live;
      // Preview-only until the user actually changes the crop.
      liveApply = preserveLiveApply;
      targetWasCropped = target.classList.contains('project-cropped') || isGridTarget(target);
      targetHadOwnVariants = target.dataset.devHasOwnVariants === 'true';
      targetVariantsAttr = target.dataset.devImageVariants ?? null;
      savedSinceSelect = false;

      selectedViewport = viewportForWidth();
      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, snapshotBaseline(editTarget));
      }
      const baseline = diskBaselines.get(pendingId)!;
      const stagedSource = stagedSources.get(pendingId);
      savedCoverVariants = readAppliedVariants(editTarget);
      draftCoverVariants = structuredClone(savedCoverVariants);
      if (isListingCover(target) && listingHasHoverImage(target)) {
        savedHoverVariants = readHoverAppliedVariants(editTarget);
        draftHoverVariants = structuredClone(savedHoverVariants);
        bindHoverSrcAspect(target);
        syncLinkedListingAspect(draftCoverVariants[selectedViewport].aspect);
      } else {
        savedHoverVariants = null;
        draftHoverVariants = null;
      }
      savedVariants = activeSlot === 'hover' && savedHoverVariants
        ? savedHoverVariants
        : savedCoverVariants;
      draftVariants = activeSlot === 'hover' && draftHoverVariants
        ? draftHoverVariants
        : draftCoverVariants;
      savedConstrained = isStandaloneMedia(target) ? readConstrainedFromTarget(target) : resolveImageGridConstrained(false);
      draftConstrained = { ...savedConstrained };
      closeBackgroundPicker();
      savedBackground = normalizeImageBackground(target.dataset.devImageBackground) ?? 'transparent';
      savedMaxVh = supportsMaxVh(target) ? readMaxVh(target) : undefined;
      draftMaxVh = savedMaxVh;
      draftBackground = savedBackground;
      applyBackgroundLive(target, draftBackground);
      syncBackgroundControl();
      saved = { ...savedVariants[selectedViewport] };
      draft = { ...saved };
      savedSrc = stagedSource?.src ?? readTargetSrc(editedImage) ?? baseline.src;
      draftSrc = savedSrc;
      savedSrcWidth = stagedSource?.srcWidth ?? baseline.srcWidth;
      savedSrcHeight = stagedSource?.srcHeight ?? baseline.srcHeight;
      draftSrcWidth = savedSrcWidth;
      draftSrcHeight = savedSrcHeight;
      previewImage.src = editedImage.currentSrc || editedImage.src;
      syncPreviewPlaceholder();

      if (editedImage.complete) {
        refreshCover();
      } else {
        editedImage.addEventListener('load', refreshCover, { once: true });
      }
      if (!preserveLocalHistory) {
        openingSnapshot = snapshotViewport();
        if (!pageBaselines.has(target)) pageBaselines.set(target, structuredClone(openingSnapshot));
      }
      draftDirty = false;
      renderConstraint();
      renderDraft();
      syncUseGridDefaultButton();
      syncWidthConstrainUi();
      syncLinkedAspectHint();
      if (live) {
        unregisterHistoryScope?.();
        unregisterHistoryScope = registerHistoryScope(tuner, {
          undo: undoLocal,
          redo: redoLocal,
        }, {
          owns: (target) => Boolean(target && (tuner.contains(target) || pageStage?.stage.contains(target) || target.closest('[data-dev-image-target]') === editTarget)),
        });
        mountPageStage();
        status.textContent = viewportGateOk()
          ? 'Editing this image — drag or two-finger swipe to pan, pinch/scroll to zoom, pull the handles to reshape.'
          : 'Editing this image. The page updates when you change the crop.';
      }
    };

    /* ── On-page crop surface ──────────────────────────────────────────
       Mounted only while this panel is editing a target — never on hover.
       Drag pans the content, wheel zooms around the pointer (and pans once
       zoomed in), edge/corner handles reshape the frame, and a faded ghost
       shows the source outside the frame. Gated to the real viewport:
       editing the tablet crop from a desktop window keeps the modal preview
       as the surface, since the page cannot display that variant. */
    let pageStage: {
      ghost: HTMLElement;
      ghostImg: HTMLImageElement;
      stage: HTMLElement;
      target: HTMLElement;
    } | null = null;
    /** In-flight exit fade — cancelled if a remount needs the DOM cleared now. */
    let closingStage: NonNullable<typeof pageStage> | null = null;
    let closingStageTimer = 0;

    const PAGE_RESIZE_DIRS: ResizeDir[] = ['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'];

    const pageFrameFor = (target: HTMLElement): HTMLElement => (
      target.querySelector<HTMLElement>(':scope > .project-crop-clip')
      // Gallery covers nest the clip under `.project-grid__stack` (hover + meta).
      ?? target.querySelector<HTMLElement>(':scope > .project-grid__stack > .project-crop-clip')
      // Carousel wraps the frame in `.project-image-carousel__surface`.
      ?? target.querySelector<HTMLElement>('.project-image-grid__frame')
      ?? target
    );

    const viewportGateOk = () => selectedViewport === viewportForWidth();

    const syncPageStageBox = () => {
      if (!pageStage) return;
      const { target, ghost, stage } = pageStage;
      const frame = pageFrameFor(target);
      // Uncropped targets have no clip yet. Listing covers: glue to the cover
      // box (object-fit fills it). Elsewhere: the content bitmap — never the
      // ghost <img> prepended by mountPageStage (querySelector('img') hits it
      // first and zeros the stage → all handles stacked at top-left).
      const ref = frame === target
        ? (isListingCover(target)
          ? target
          : (pageImageFor(target) ?? target))
        : frame;
      // Use viewport rects so a positioned surface (carousel width cap) between
      // the slide and frame does not zero-out offsetLeft/offsetTop.
      const box = ref === target
        ? { left: 0, top: 0, width: target.clientWidth, height: target.clientHeight }
        : (() => {
          const targetRect = target.getBoundingClientRect();
          const refRect = ref.getBoundingClientRect();
          return {
            left: refRect.left - targetRect.left + target.scrollLeft,
            top: refRect.top - targetRect.top + target.scrollTop,
            width: refRect.width,
            height: refRect.height,
          };
        })();
      for (const el of [ghost, stage]) {
        el.style.left = `${box.left}px`;
        el.style.top = `${box.top}px`;
        el.style.width = `${box.width}px`;
        el.style.height = `${box.height}px`;
      }
    };

    const finishClosingStage = (closing: NonNullable<typeof pageStage>) => {
      if (closingStage === closing) closingStage = null;
      if (closingStageTimer) {
        window.clearTimeout(closingStageTimer);
        closingStageTimer = 0;
      }
      closing.ghost.remove();
      closing.stage.remove();
      // Drop the host class with the nodes — keep overflow:visible while the
      // ghost is still fading out so handles/spill aren't clipped mid-exit.
      closing.target.classList.remove('dev-crop-stage-host');
      const carousel = closing.target.closest('[data-project-image-carousel]');
      const track = closing.target.closest<HTMLElement>('[data-carousel-track]');
      const clip = closing.target.closest<HTMLElement>('[data-carousel-clip]')
        ?? track?.parentElement;
      track?.style.removeProperty('--project-carousel-crop-lock-height');
      clip?.style.removeProperty('--project-carousel-crop-lock-height');
      if (carousel) {
        window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: carousel } }));
      }
    };

    const unmountPageStage = (options?: { immediate?: boolean }) => {
      // A remount must kill any in-flight exit fade first.
      if (closingStage) finishClosingStage(closingStage);
      if (!pageStage) return;
      const closing = pageStage;
      pageStage = null;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canFade = !options?.immediate
        && !reduceMotion
        && closing.ghost.classList.contains('is-visible');
      if (!canFade) {
        finishClosingStage(closing);
        return;
      }

      closingStage = closing;
      closing.ghost.classList.remove('is-visible');
      closing.stage.classList.remove('is-visible');
      const onEnd = (event: TransitionEvent) => {
        if (event.target !== closing.ghost || event.propertyName !== 'opacity') return;
        closing.ghost.removeEventListener('transitionend', onEnd);
        if (closingStage === closing) finishClosingStage(closing);
      };
      closing.ghost.addEventListener('transitionend', onEnd);
      closingStageTimer = window.setTimeout(() => {
        if (closingStage === closing) finishClosingStage(closing);
      }, 250);
    };

    /** Capture can throw once a pointer is gone (fast release, pen lift). */
    const capturePointer = (el: HTMLElement, pointerId: number) => {
      try {
        el.setPointerCapture(pointerId);
      } catch {
        // Drag still works off the shared pointer-id state.
      }
    };

    /*
      Trackpad wheel arrives in uneven chunks. A flat low gain feels precise but
      sluggish; a flat high gain covers ground but jumps. Blend by delta size:
      slow nudges stay fine, quicker flicks use the original full sensitivity.
      Apply through rAF (one paint/frame) so chunky packets don't grit the crop.
    */
    const WHEEL_ZOOM_GAIN_FINE = 0.00085;
    const WHEEL_ZOOM_GAIN_FAST = 0.0022;
    const WHEEL_PAN_GAIN_FINE = 0.38;
    const WHEEL_PAN_GAIN_FAST = 1;
    /** Higher knee = more of the common trackpad range stays in the fine→mid blend. */
    const WHEEL_GAIN_KNEE = 40;
    /** EMA toward per-frame |delta| so gain doesn't flicker with packet noise. */
    const WHEEL_SPEED_EMA = 0.32;
    const POINTER_PAN_GAIN = 1;
    const PINCH_ZOOM_EXPONENT = 1;
    /** Mid-gesture chrome (zoom % / readout) at most ~15 Hz — not every paint. */
    const GESTURE_CHROME_MS = 64;

    /** Smoothstep blend from fine → fast gain based on gesture speed. */
    const wheelGainForSpeed = (speed: number, fine: number, fast: number) => {
      const t = Math.min(1, Math.max(0, speed) / WHEEL_GAIN_KNEE);
      const blend = t * t * (3 - 2 * t);
      return fine + (fast - fine) * blend;
    };

    /** Zoom around a client point — mutates draft only; caller paints. */
    const zoomAtClientPoint = (
      clientX: number,
      clientY: number,
      factor: number,
      bounds: DOMRect,
      captured?: { value: boolean },
    ) => {
      if (!bounds.width || !bounds.height) return;
      if (captured) pushUndoIfNeeded(captured);
      const fx = (clientX - bounds.left) / bounds.width;
      const fy = (clientY - bounds.top) / bounds.height;
      const sourceX = draft.cx + (fx - 0.5) * draft.w;
      const sourceY = draft.cy + (fy - 0.5) * contentH(draft);
      const coverWidth = coverW(draft.aspect);
      beginLiveEdits();
      draft.w = clamp(draft.w / factor, coverWidth / ZOOM_MAX, coverWidth / minZoom());
      draft.cx = sourceX - (fx - 0.5) * draft.w;
      draft.cy = sourceY - (fy - 0.5) * contentH(draft);
    };

    /**
     * Shared pan / pinch / wheel gestures for the page crop stage and the
     * modal preview. One finger (or non-ctrl wheel) pans; pinch / ctrl-wheel
     * zooms; two-finger move pans while pinching.
     */
    const wireCropGestures = (
      surface: HTMLElement,
      options?: { stopPropagation?: boolean; ignoreSelector?: string },
    ) => {
      const pointers = new Map<number, { x: number; y: number }>();
      let panPointer: number | null = null;
      let panStartX = 0;
      let panStartY = 0;
      let panOriginX = 0.5;
      let panOriginY = 0.5;
      let panAxis: 'x' | 'y' | null = null;
      let pinch: {
        startDist: number;
        startW: number;
        startCx: number;
        startCy: number;
        startMidX: number;
        startMidY: number;
        sourceX: number;
        sourceY: number;
        bounds: DOMRect;
      } | null = null;
      /** Cached stage rect while a gesture is live — avoids layout thrash per move. */
      let gestureBounds: DOMRect | null = null;
      let paintRaf = 0;
      let chromeRaf = 0;
      let chromeTimer = 0;
      let wheelIdleTimer = 0;
      let lastChromeAt = 0;
      let pendingStatus: string | null = null;
      let pointerDirty = false;
      let wheelSpeedEma = 0;
      let pendingWheel: {
        dx: number;
        dy: number;
        zoom: boolean;
        clientX: number;
        clientY: number;
      } | null = null;
      const gestureUndoCaptured = { value: false };

      const pointList = () => [...pointers.values()];

      const refreshGestureBounds = () => {
        gestureBounds = surface.getBoundingClientRect();
        return gestureBounds;
      };

      const boundsOrRefresh = () => {
        if (gestureBounds && gestureBounds.width && gestureBounds.height) return gestureBounds;
        return refreshGestureBounds();
      };

      const clearChromeSchedule = () => {
        if (chromeTimer) {
          window.clearTimeout(chromeTimer);
          chromeTimer = 0;
        }
        if (chromeRaf) {
          cancelAnimationFrame(chromeRaf);
          chromeRaf = 0;
        }
      };

      const flushGestureChrome = (force = false) => {
        clearChromeSchedule();
        if (force) {
          flushDraftChrome();
          if (pendingStatus != null) {
            status.textContent = pendingStatus;
            pendingStatus = null;
          }
          lastChromeAt = performance.now();
          return;
        }
        const zoom = zoomOf(draft);
        zoomInput.value = zoom.toFixed(3);
        zoomOutput.value = `${Math.round(zoom * 100)}%`;
        if (pendingStatus != null) {
          status.textContent = pendingStatus;
          pendingStatus = null;
        }
        lastChromeAt = performance.now();
      };

      const scheduleGestureChrome = () => {
        if (chromeTimer || chromeRaf) return;
        const wait = Math.max(0, GESTURE_CHROME_MS - (performance.now() - lastChromeAt));
        const run = () => {
          chromeTimer = 0;
          chromeRaf = requestAnimationFrame(() => {
            chromeRaf = 0;
            flushGestureChrome(false);
          });
        };
        if (wait <= 0) {
          run();
          return;
        }
        chromeTimer = window.setTimeout(run, wait);
      };

      const applyPinchToDraft = () => {
        if (!pinch) return;
        const bounds = pinch.bounds;
        if (!bounds.width || !bounds.height) return;
        const [a, b] = pointList();
        if (!a || !b) return;
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (dist < 8) return;
        const midX = (a.x + b.x) / 2;
        const midY = (a.y + b.y) / 2;
        const coverWidth = coverW(draft.aspect);
        // Fingers apart → zoom in (smaller w); midpoint tracks with the gesture.
        const scale = Math.pow(pinch.startDist / dist, PINCH_ZOOM_EXPONENT);
        const newW = clamp(pinch.startW * scale, coverWidth / ZOOM_MAX, coverWidth / minZoom());
        const fx = (midX - bounds.left) / bounds.width;
        const fy = (midY - bounds.top) / bounds.height;
        pushUndoIfNeeded(gestureUndoCaptured);
        beginLiveEdits();
        draft.w = newW;
        draft.cx = pinch.sourceX - (fx - 0.5) * draft.w;
        draft.cy = pinch.sourceY - (fy - 0.5) * contentH(draft);
        pendingStatus = `Zoom ${Math.round(zoomOf(draft) * 100)}% — unsaved changes.`;
      };

      const applyPanToDraft = () => {
        if (panPointer == null) return;
        const point = pointers.get(panPointer);
        if (!point) return;
        const bounds = boundsOrRefresh();
        if (!bounds.width || !bounds.height) return;
        const deltaX = point.x - panStartX;
        const deltaY = point.y - panStartY;
        pushUndoIfNeeded(gestureUndoCaptured);
        beginLiveEdits();
        const nextX = panOriginX - (deltaX / bounds.width) * draft.w * POINTER_PAN_GAIN;
        const nextY = panOriginY - (deltaY / bounds.height) * contentH(draft) * POINTER_PAN_GAIN;
        draft.cx = panAxis === 'y' ? panOriginX : nextX;
        draft.cy = panAxis === 'x' ? panOriginY : nextY;
        pendingStatus = panAxis
          ? `${panAxis.toUpperCase()} axis locked — unsaved changes.`
          : 'Unsaved changes.';
      };

      const applyPendingWheel = () => {
        if (!pendingWheel) return;
        const { dx, dy, zoom, clientX, clientY } = pendingWheel;
        pendingWheel = null;
        const bounds = boundsOrRefresh();
        if (!bounds.width || !bounds.height) return;

        if (zoom) {
          const mag = Math.abs(dy);
          wheelSpeedEma += (mag - wheelSpeedEma) * WHEEL_SPEED_EMA;
          const gain = wheelGainForSpeed(wheelSpeedEma, WHEEL_ZOOM_GAIN_FINE, WHEEL_ZOOM_GAIN_FAST);
          const factor = Math.exp(-dy * gain);
          zoomAtClientPoint(clientX, clientY, factor, bounds, gestureUndoCaptured);
          pendingStatus = `Zoom ${Math.round(zoomOf(draft) * 100)}% — unsaved changes.`;
          return;
        }

        const mag = Math.hypot(dx, dy);
        wheelSpeedEma += (mag - wheelSpeedEma) * WHEEL_SPEED_EMA;
        const panGain = wheelGainForSpeed(wheelSpeedEma, WHEEL_PAN_GAIN_FINE, WHEEL_PAN_GAIN_FAST);
        pushUndoIfNeeded(gestureUndoCaptured);
        beginLiveEdits();
        draft.cx += (dx / bounds.width) * draft.w * panGain;
        draft.cy += (dy / bounds.height) * contentH(draft) * panGain;
        pendingStatus = 'Unsaved changes.';
      };

      const flushGesturePaint = () => {
        paintRaf = 0;
        if (pendingWheel) applyPendingWheel();
        if (pointerDirty) {
          pointerDirty = false;
          if (pointers.size >= 2) applyPinchToDraft();
          else applyPanToDraft();
        }
        paintDraftCrop();
        scheduleGestureChrome();
      };

      const requestGesturePaint = () => {
        if (paintRaf) return;
        paintRaf = requestAnimationFrame(flushGesturePaint);
      };

      const beginPinch = (bounds: DOMRect) => {
        const [a, b] = pointList();
        if (!a || !b || !bounds.width || !bounds.height) return;
        const startDist = Math.hypot(a.x - b.x, a.y - b.y);
        if (startDist < 8) return;
        const startMidX = (a.x + b.x) / 2;
        const startMidY = (a.y + b.y) / 2;
        const fx = (startMidX - bounds.left) / bounds.width;
        const fy = (startMidY - bounds.top) / bounds.height;
        gestureBounds = bounds;
        pinch = {
          startDist,
          startW: draft.w,
          startCx: draft.cx,
          startCy: draft.cy,
          startMidX,
          startMidY,
          sourceX: draft.cx + (fx - 0.5) * draft.w,
          sourceY: draft.cy + (fy - 0.5) * contentH(draft),
          bounds,
        };
        panPointer = null;
        surface.classList.add('is-dragging');
      };

      const releaseAllCaptures = () => {
        for (const id of pointers.keys()) {
          if (surface.hasPointerCapture(id)) surface.releasePointerCapture(id);
        }
      };

      /** Locked cover-fit crops cannot pan — treat that as "no room to pan". */
      const cropCanPan = () => {
        if (!constrainToFrame()) return true;
        const h = contentH(draft);
        const slackX = Math.max(0, 1 - draft.w);
        const slackY = Math.max(0, 1 - h);
        return slackX > 1e-4 || slackY > 1e-4;
      };

      const endGestureSession = () => {
        if (wheelIdleTimer) {
          window.clearTimeout(wheelIdleTimer);
          wheelIdleTimer = 0;
        }
        gestureBounds = null;
        wheelSpeedEma = 0;
        if (paintRaf) {
          cancelAnimationFrame(paintRaf);
          flushGesturePaint();
        }
        flushGestureChrome(true);
        // Reset after the last paint — a pending RAF would otherwise push a
        // second pose for the same gesture (Cmd+Z would only undo one frame).
        gestureUndoCaptured.value = false;
      };

      const armWheelIdleFlush = () => {
        if (wheelIdleTimer) window.clearTimeout(wheelIdleTimer);
        wheelIdleTimer = window.setTimeout(() => {
          wheelIdleTimer = 0;
          // Pointer gesture owns the session — don't reset mid-drag.
          if (pointers.size > 0 || pinch || panPointer != null) return;
          endGestureSession();
        }, 140);
      };

      surface.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 && event.pointerType === 'mouse') return;
        if (
          options?.ignoreSelector
          && (event.target as HTMLElement | null)?.closest?.(options.ignoreSelector)
        ) return;
        event.preventDefault();
        if (options?.stopPropagation) event.stopPropagation();

        pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        refreshGestureBounds();

        if (pointers.size >= 2) {
          // Capturing the first contact can starve the second on some browsers
          // (Safari especially) — drop captures so both fingers keep delivering.
          releaseAllCaptures();
          beginPinch(boundsOrRefresh());
          return;
        }

        pinch = null;
        panPointer = event.pointerId;
        panStartX = event.clientX;
        panStartY = event.clientY;
        panOriginX = draft.cx;
        panOriginY = draft.cy;
        panAxis = null;
        surface.classList.add('is-dragging');
        capturePointer(surface, event.pointerId);
      });

      surface.addEventListener('pointermove', (event) => {
        if (!pointers.has(event.pointerId)) return;
        pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

        if (pointers.size >= 2) {
          if (!pinch) beginPinch(boundsOrRefresh());
          pointerDirty = true;
          requestGesturePaint();
          return;
        }

        if (panPointer !== event.pointerId) return;
        if (event.pointerType === 'mouse' && event.buttons === 0) {
          panPointer = null;
          surface.classList.remove('is-dragging');
          endGestureSession();
          return;
        }
        const deltaX = event.clientX - panStartX;
        const deltaY = event.clientY - panStartY;
        if (event.shiftKey && !panAxis && Math.hypot(deltaX, deltaY) >= 3) {
          panAxis = Math.abs(deltaX) >= Math.abs(deltaY) ? 'x' : 'y';
        } else if (!event.shiftKey) {
          panAxis = null;
        }
        pointerDirty = true;
        requestGesturePaint();
      });

      const endPointer = (event: PointerEvent) => {
        if (!pointers.has(event.pointerId)) return;
        pointers.delete(event.pointerId);
        if (surface.hasPointerCapture(event.pointerId)) {
          surface.releasePointerCapture(event.pointerId);
        }

        if (pointers.size >= 2) {
          beginPinch(refreshGestureBounds());
          return;
        }

        pinch = null;
        if (pointers.size === 1) {
          // Drop back to one-finger pan with the remaining contact.
          const [id, point] = [...pointers.entries()][0];
          panPointer = id;
          panStartX = point.x;
          panStartY = point.y;
          panOriginX = draft.cx;
          panOriginY = draft.cy;
          panAxis = null;
          surface.classList.add('is-dragging');
          capturePointer(surface, id);
          return;
        }

        panPointer = null;
        surface.classList.remove('is-dragging');
        endGestureSession();
      };
      surface.addEventListener('pointerup', endPointer);
      surface.addEventListener('pointercancel', endPointer);
      surface.addEventListener('lostpointercapture', (event) => {
        // Ignore capture loss while pinching — we release captures on purpose
        // when the second finger lands, and ending the pointer then drops the pinch.
        if (pointers.size >= 2 || pinch) return;
        if (!pointers.has(event.pointerId)) return;
        endPointer(event);
      });

      surface.addEventListener('wheel', (event) => {
        event.preventDefault();
        if (!gestureBounds) refreshGestureBounds();

        // Trackpad pinch (and ctrl+wheel) always zooms. At locked cover-fit,
        // swipe falls back to scroll-to-zoom so the gesture still does something.
        const zoom = event.ctrlKey || !cropCanPan();
        if (!pendingWheel || pendingWheel.zoom !== zoom) {
          // Mode change mid-frame — flush the previous bucket first.
          if (pendingWheel && (pendingWheel.dx || pendingWheel.dy)) {
            if (paintRaf) {
              cancelAnimationFrame(paintRaf);
              flushGesturePaint();
            } else {
              applyPendingWheel();
              paintDraftCrop();
            }
          }
          pendingWheel = {
            dx: 0,
            dy: 0,
            zoom,
            clientX: event.clientX,
            clientY: event.clientY,
          };
        }
        pendingWheel.dx += event.deltaX;
        pendingWheel.dy += event.deltaY;
        pendingWheel.clientX = event.clientX;
        pendingWheel.clientY = event.clientY;
        requestGesturePaint();
        armWheelIdleFlush();
      }, { passive: false });
    };

    const wirePageStage = (stage: HTMLElement) => {
      wireCropGestures(stage, {
        stopPropagation: true,
        ignoreSelector: '[data-page-resize]',
      });

      stage.querySelectorAll<HTMLElement>('[data-page-resize]').forEach((handle) => {
        handle.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          event.preventDefault();
          // Bubble past the stage pan handler and the carousel track swipe.
          event.stopPropagation();
          const dir = handle.dataset.pageResize as ResizeDir | undefined;
          if (!dir) return;
          const bounds = stage.getBoundingClientRect();
          resizePointerId = event.pointerId;
          resizeDir = dir;
          startX = event.clientX;
          startY = event.clientY;
          resizeStartWidth = bounds.width;
          resizeStartHeight = bounds.height;
          stage.classList.add('is-resizing');
          capturePointer(handle, event.pointerId);
        });
        handle.addEventListener('pointermove', (event) => {
          if (resizePointerId !== event.pointerId) return;
          applyResizeFromPointer(event.clientX, event.clientY);
        });
        const endResize = (event: PointerEvent) => {
          if (resizePointerId !== event.pointerId) return;
          resizePointerId = null;
          resizeDir = null;
          resizeUndoCaptured.value = false;
          stage.classList.remove('is-resizing');
          if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
        };
        handle.addEventListener('pointerup', endResize);
        handle.addEventListener('pointercancel', endResize);
      });
    };

    const mountPageStage = () => {
      // Remounts (viewport chip, image switch) skip the exit fade so the old
      // ghost can't linger under the new stage.
      unmountPageStage({ immediate: true });
      if (!editingSession || !viewportGateOk()) return;
      const target = editTarget;

      const ghost = document.createElement('div');
      ghost.className = 'dev-crop-ghost';
      ghost.setAttribute('aria-hidden', 'true');
      const ghostImg = document.createElement('img');
      ghostImg.alt = '';
      ghostImg.draggable = false;
      ghostImg.style.backgroundColor = draftBackground;
      ghostImg.src = editedImage.src || editedImage.currentSrc;
      ghost.append(ghostImg);

      const stage = document.createElement('div');
      stage.className = 'dev-crop-stage';
      PAGE_RESIZE_DIRS.forEach((dir) => {
        const handle = document.createElement('span');
        handle.className = `dev-crop-stage__handle dev-crop-stage__handle--${dir}`;
        handle.dataset.pageResize = dir;
        handle.setAttribute('aria-hidden', 'true');
        stage.append(handle);
      });

      // Lock clip/track height while siblings are still measurable — isolation
      // hides them, and pin-to-tallest / dynamic clip would otherwise collapse.
      const track = target.closest<HTMLElement>('[data-carousel-track]');
      const clip = target.closest<HTMLElement>('[data-carousel-clip]')
        ?? track?.parentElement;
      if (track) {
        const lockHeight = Math.round(track.getBoundingClientRect().height);
        if (lockHeight > 0) {
          track.style.setProperty('--project-carousel-crop-lock-height', `${lockHeight}px`);
          clip?.style.setProperty('--project-carousel-crop-lock-height', `${lockHeight}px`);
        }
      }

      target.classList.add('dev-crop-stage-host');
      // Ghost first so the clip (later in DOM order) paints over the shared
      // region — only the content outside the frame reads as faded.
      target.prepend(ghost);
      target.append(stage);
      pageStage = { ghost, ghostImg, stage, target };
      wirePageStage(stage);
      syncPageStageBox();
      // Layout can settle a frame later (constrained width, fonts, overlay open)
      // — re-glue so handles aren't stranded at 0×0 and look "missing".
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (pageStage?.stage === stage) syncPageStageBox();
        });
      });
      // Fade ghost + stage chrome in after paint so opacity 0 → visible transitions.
      requestAnimationFrame(() => {
        if (pageStage?.ghost !== ghost) return;
        ghost.classList.add('is-visible');
        stage.classList.add('is-visible');
      });
      const carousel = target.closest('[data-project-image-carousel]');
      if (carousel) {
        window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: carousel } }));
      }
    };

    window.addEventListener('vcd:dev-listing-slot', ((event: CustomEvent<{ cover?: HTMLElement; slot?: 'cover' | 'hover' }>) => {
      const cover = event.detail?.cover;
      if (!(cover instanceof HTMLElement) || cover !== editTarget || !editingSession) return;
      selectTarget(cover, true);
    }) as EventListener);

    window.addEventListener('vcd:dev-edit-open', ((event: CustomEvent) => {
      // Only the image/crop panel — caption/grid opens must not hijack this target.
      const panel = event.detail?.panel as HTMLElement | undefined;
      const trigger = event.detail?.trigger as HTMLElement | undefined;
      if (!panel || panel.dataset.devPanelKey !== 'image') return;
      const target = trigger?.closest<HTMLElement>('[data-dev-image-target]')
        // Gallery crop chip sits on the --end rail (sibling of the cover target).
        ?? trigger?.closest('.project-grid__item')?.querySelector<HTMLElement>('[data-dev-image-target]')
        ?? null;
      if (target) selectTarget(target, true);
    }) as EventListener);

    const teardownEditSession = () => {
      closeBackgroundPicker();
      unregisterHistoryScope?.();
      unregisterHistoryScope = null;
      unmountPageStage();
      // Closing is a cancel: unsaved crop edits never survive the panel.
      revertToSaved();
      editingSession = false;
    };

    window.addEventListener('vcd:dev-edit-close', ((event: CustomEvent) => {
      const panel = event.detail?.panel as HTMLElement | undefined;
      if (panel && panel.dataset.devPanelKey !== 'image') return;
      teardownEditSession();
    }) as EventListener);

    // Esc closes open panels via vcd:dev-edit-close (DevModeController); Alt+D
    // can exit Dev Mode with a panel still open. Both must tear the page
    // surface down, or the orphaned ghost loses its dev-only styling and
    // renders as a full-size in-flow duplicate of the image.
    window.addEventListener('vcd:dev-panels-closed', teardownEditSession);
    window.addEventListener('vcd:dev-mode-change', ((event: CustomEvent<{ active?: boolean }>) => {
      if (event.detail?.active === false) teardownEditSession();
    }) as EventListener);

    // Prime the preview canvas without mutating the live page image.
    selectTarget(initialTarget, false);

    viewportButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const viewport = button.dataset.cropViewport as ImageViewport | undefined;
        if (!viewport || viewport === selectedViewport) return;
        draftVariants[selectedViewport] = { ...draft };
        selectedViewport = viewport;
        saved = { ...savedVariants[selectedViewport] };
        draft = { ...draftVariants[selectedViewport] };
        renderConstraint();
        renderDraft();
        syncWidthConstrainUi();
        // The page can only mirror the crop of the breakpoint it is showing.
        if (editingSession) mountPageStage();
        status.textContent = viewportGateOk()
          ? `Editing the ${selectedViewport} display crop.`
          : `Editing the ${selectedViewport} display crop — use the preview above; the page shows the ${viewportForWidth()} crop.`;
      });
    });

    aspectRatioSelect.addEventListener('change', () => {
      pushUndo();
      beginLiveEdits();
      // Hold the zoom level across the reshape; `w` follows the new cover bound.
      const zoom = zoomOf(draft);
      draft.aspect = aspectRatioSelect.value;
      draft.w = wForZoom(draft.aspect, zoom);
      syncLinkedListingAspect(draft.aspect);
      if (PRESET_ASPECT_RATIOS.has(draft.aspect)) {
        aspectRatioSelect.querySelector('[data-crop-custom-ratio]')?.remove();
      }
      renderDraft();
      status.textContent = 'Aspect ratio changed — unsaved changes.';
    });

    let zoomEditing = false;
    zoomInput.addEventListener('input', () => {
      if (!zoomEditing) { pushUndo(); zoomEditing = true; }
      beginLiveEdits();
      draft.w = wForZoom(draft.aspect, clamp(Number(zoomInput.value), minZoom(), ZOOM_MAX));
      renderDraft();
      status.textContent = 'Unsaved changes.';
    });

    zoomInput.addEventListener('change', () => { zoomEditing = false; });
    zoomInput.addEventListener('blur', () => { zoomEditing = false; });

    let startX = 0;
    let startY = 0;
    let resizePointerId: number | null = null;
    let resizeDir: ResizeDir | null = null;
    let resizeStartWidth = 0;
    let resizeStartHeight = 0;
    const resizeUndoCaptured = { value: false };

    const applyResizeFromPointer = (clientX: number, clientY: number) => {
      if (!resizeDir) return;
      pushUndoIfNeeded(resizeUndoCaptured);
      const width = resizeStartWidth || preview.clientWidth || 1;
      let height = resizeStartHeight;
      const deltaX = clientX - startX;
      const deltaY = clientY - startY;
      const edges = new Set(resizeDir.split(''));
      const affectsN = edges.has('n');
      const affectsS = edges.has('s');
      const affectsE = edges.has('e');
      const affectsW = edges.has('w');
      const vertical = affectsN || affectsS;
      const horizontalOnly = (affectsE || affectsW) && !vertical;

      if (affectsN) height = resizeStartHeight - deltaY;
      if (affectsS) height = resizeStartHeight + deltaY;
      if (horizontalOnly) {
        // Outward horizontal drag → wider ratio → shorter frame (width is layout-fixed).
        const impliedWidth = affectsE
          ? resizeStartWidth + deltaX
          : resizeStartWidth - deltaX;
        height = resizeStartHeight * (resizeStartWidth / Math.max(1, impliedWidth));
      }

      const rootFs = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      // 12em floor is an on-page length. Scale it when resizing the smaller panel
      // preview so both surfaces share the same shortest aspect (5:1 at full width).
      const pageWidth = Math.max(
        1,
        pageFrameFor(editTarget).getBoundingClientRect().width
          || editTarget.getBoundingClientRect().width
          || width,
      );
      const minHeightOnPage = rootFs * MIN_FRAME_HEIGHT_EM;
      const minHeight = Math.max(
        width / RATIO_MAX,
        minHeightOnPage * (width / pageWidth),
      );
      const maxHeight = width / RATIO_MIN;
      height = clamp(height, minHeight, maxHeight);
      beginLiveEdits();
      const zoom = zoomOf(draft);
      draft.aspect = ratioFromSize(width, height);
      draft.w = wForZoom(draft.aspect, zoom);
      syncLinkedListingAspect(draft.aspect);
      renderDraft();
      status.textContent = 'Frame resized — unsaved changes.';
    };

    resizeHandles.forEach((handle) => {
      handle.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        event.stopPropagation();
        const dir = handle.dataset.cropResize as ResizeDir | undefined;
        if (!dir) return;
        const size = currentFrameSize();
        resizePointerId = event.pointerId;
        resizeDir = dir;
        startX = event.clientX;
        startY = event.clientY;
        resizeStartWidth = size.width;
        resizeStartHeight = size.height;
        preview.classList.add('is-resizing');
        handle.setPointerCapture(event.pointerId);
      });

      handle.addEventListener('pointermove', (event) => {
        if (resizePointerId !== event.pointerId) return;
        applyResizeFromPointer(event.clientX, event.clientY);
      });

      const endResize = (event: PointerEvent) => {
        if (resizePointerId !== event.pointerId) return;
        resizePointerId = null;
        resizeDir = null;
        resizeUndoCaptured.value = false;
        preview.classList.remove('is-resizing');
        if (handle.hasPointerCapture(event.pointerId)) {
          handle.releasePointerCapture(event.pointerId);
        }
      };

      handle.addEventListener('pointerup', endResize);
      handle.addEventListener('pointercancel', endResize);
    });

    wireCropGestures(preview, { ignoreSelector: '[data-crop-resize]' });

    centerXButton.addEventListener('click', () => {
      pushUndo();
      beginLiveEdits();
      draft.cx = 0.5;
      renderDraft();
      status.textContent = 'Centred horizontally — unsaved changes.';
    });

    centerYButton.addEventListener('click', () => {
      pushUndo();
      beginLiveEdits();
      draft.cy = 0.5;
      renderDraft();
      status.textContent = 'Centred vertically — unsaved changes.';
    });

    constraintButton.addEventListener('click', () => {
      pushUndo();
      beginLiveEdits();
      const next = !constrainToFrame();
      constrainByViewport = {
        ...constrainByViewport,
        [selectedViewport]: next,
      };
      writeConstraints(constrainByViewport);
      renderConstraint();
      renderDraft();
      status.textContent = next
        ? `Crop locked on ${selectedViewport} within the image bounds.`
        : `Crop unlocked on ${selectedViewport} — image edges may enter the frame.`;
    });

    widthConstrainSelect.addEventListener('change', () => {
      if (!isStandaloneMedia(editTarget)) {
        widthConstrainSelect.value = '100';
        return;
      }
      pushUndo();
      draftConstrained = resolveImageGridConstrained({
        ...draftConstrained,
        [selectedViewport]: widthConstrainSelect.value,
      });
      applyFrameFlagsLive(editTarget, {
        constrained: draftConstrained,
        maxVh: draftMaxVh,
      });
      const percent = draftConstrained[selectedViewport];
      status.textContent = percent === 100
        ? `Full width on ${selectedViewport} — unsaved changes.`
        : percent === 'text'
          ? `Width matched to text on ${selectedViewport} — unsaved changes.`
          : `Width constrained to ${percent}% on ${selectedViewport} — unsaved changes.`;
      syncDraftDirty();
    });

    maxVhSelect.addEventListener('change', () => {
      if (!supportsMaxVh(editTarget)) {
        maxVhSelect.value = '';
        return;
      }
      pushUndo({ maxVh: { value: draftMaxVh } });
      draftMaxVh = normalizeMaxVh(maxVhSelect.value);
      applyFrameFlagsLive(editTarget, {
        constrained: draftConstrained,
        maxVh: draftMaxVh,
      });
      status.textContent = draftMaxVh
        ? `Height constrained to ${draftMaxVh}% view height — unsaved changes.`
        : 'Full height — unsaved changes.';
      syncDraftDirty();
    });

    const changeBackground = (value: string) => {
      const background = value.trim() ? normalizeImageBackground(value) : 'transparent';
      if (!background) {
        backgroundInput?.setAttribute('aria-invalid', 'true');
        status.textContent = 'Enter a hex colour, or choose None.';
        return;
      }
      if (background !== draftBackground) {
        pushUndo();
        draftBackground = background;
        applyBackgroundLive(editTarget, background);
        syncDraftDirty();
      } else syncBackgroundControl();
    };
    backgroundInput?.addEventListener('change', () => changeBackground(backgroundInput.value));
    backgroundNone?.addEventListener('click', () => {
      changeBackground('transparent');
      closeBackgroundPicker();
    });
    backgroundSwatch?.addEventListener('click', () => {
      backgroundPicker?.setAttribute('hex', draftBackground === 'transparent' ? '#ffffffff' : `${draftBackground}ff`);
      backgroundPicker?.setAttribute('open', 'true');
    });
    backgroundPicker?.addEventListener('update-color', ((event: CustomEvent<{ hex?: string }>) => {
      if (event.detail?.hex) changeBackground(event.detail.hex);
    }) as EventListener);

    const readFileAsBase64 = (file: File) => new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = String(reader.result || '');
        resolve(result.includes(',') ? result.split(',')[1] : result);
      };
      reader.onerror = () => reject(reader.error ?? new Error('Could not read the file.'));
      reader.readAsDataURL(file);
    });

    const uploadReplaceFile = async (file: File) => {
      const documentKey = editTarget.dataset.devDocument || '';
      if (!documentKey) throw new Error('This image is not wired for uploads.');
      const response = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          document: documentKey,
          files: [{
            filename: file.name,
            data: await readFileAsBase64(file),
            mimeType: file.type,
          }],
        }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Upload failed.');
      const filename = Array.isArray(result.filenames) ? String(result.filenames[0] || '') : '';
      if (!filename) throw new Error('Upload failed.');
      return filename;
    };

    const pickReplaceFromAssetManager = () => new Promise<{ srcs: string[] }>((resolve, reject) => {
      const documentKey = editTarget.dataset.devDocument || '';
      window.dispatchEvent(new CustomEvent('vcd:dev-asset-manager-open', {
        detail: {
          documentKey,
          project: documentKey,
          mode: 'pick',
          max: 1,
          resolve,
          reject,
        },
      }));
    });

    const applyReplacement = (src: string, dims?: { srcWidth?: number; srcHeight?: number }) => {
      if (!src) return;
      pushUndo({
        src: draftSrc,
        srcWidth: draftSrcWidth,
        srcHeight: draftSrcHeight,
        allCover: structuredClone(isListingCover(editTarget) ? draftCoverVariants : draftVariants),
        allHover: draftHoverVariants ? structuredClone(draftHoverVariants) : null,
        allDraft: structuredClone(draftVariants),
      });
      draftSrc = src;
      draftSrcWidth = dims?.srcWidth;
      draftSrcHeight = dims?.srcHeight;

      const url = projectImage(src);
      const replacementTarget = editTarget;
      const image = applySrcLive(replacementTarget, src, dims) ?? editedImage;
      const replacementRevision = sourceRevision;
      previewImage.src = url;
      if (pageStage) pageStage.ghostImg.src = url;

      const finish = () => {
        if (
          replacementRevision !== sourceRevision
          || editTarget !== replacementTarget
          || draftSrc !== src
          || image.getAttribute('src') !== url
        ) return;
        const nextDims = dims?.srcWidth && dims?.srcHeight
          ? dims
          : readTargetDims(image);
        if (nextDims.srcWidth && nextDims.srcHeight) {
          draftSrcWidth = nextDims.srcWidth;
          draftSrcHeight = nextDims.srcHeight;
          editTarget.style.setProperty(
            '--project-image-original-ratio',
            `${nextDims.srcWidth} / ${nextDims.srcHeight}`,
          );
          editTarget.style.setProperty(
            '--project-image-original-ratio-num',
            String(nextDims.srcWidth / nextDims.srcHeight),
          );
        }
        VIEWPORTS.forEach((viewport) => {
          const aspect = draftVariants[viewport].aspect;
          draftVariants[viewport] = {
            aspect,
            cx: 0.5,
            cy: 0.5,
            w: coverW(aspect),
          };
        });
        draft = { ...draftVariants[selectedViewport] };
        if (targetWasCropped || liveApply) beginLiveEdits();
        renderDraft();
        // Remounting reads currentSrc, which can lag one frame behind a
        // programmatic src swap — sync the live stage in place instead.
        if (pageStage) {
          pageStage.ghostImg.src = image.src || url;
          syncPageStageBox();
        } else if (editingSession) {
          mountPageStage();
        }
        status.textContent = 'Image replaced — unsaved changes.';
      };

      // `complete` can still reflect the previous bitmap for a tick after src
      // assignment — prefer decode(), fall back to load.
      const ready = (img: HTMLImageElement) => {
        if (typeof img.decode === 'function') {
          return img.decode().then(() => undefined, () => undefined);
        }
        if (img.complete && img.naturalWidth) return Promise.resolve();
        return new Promise<void>((resolve) => {
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => resolve(), { once: true });
        });
      };
      void Promise.all([ready(image), ready(previewImage)]).then(finish);
    };

    const replaceWithFile = (file: File | null | undefined) => {
      if (!file || !isAcceptedImageFile(file)) return;
      void (async () => {
        try {
          status.textContent = 'Uploading…';
          const src = await uploadReplaceFile(file);
          applyReplacement(src);
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Could not replace the image.';
        }
      })();
    };

    const replaceControlFrom = (event: Event) =>
      event.target instanceof Element && Boolean(event.target.closest('button, input'));

    // Click focuses the well for paste. Ghost buttons own Finder / library;
    // double-click (and Enter/Space on the well) still open the file picker.
    replaceDrop.addEventListener('click', (event) => {
      if (replaceControlFrom(event)) return;
      replaceDrop.focus();
    });
    replaceDrop.addEventListener('dblclick', (event) => {
      if (replaceControlFrom(event)) return;
      replaceFileInput.click();
    });
    replaceDrop.addEventListener('keydown', (event) => {
      if (replaceControlFrom(event)) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        replaceFileInput.click();
      }
    });
    replaceDrop.addEventListener('paste', (event) => {
      const items = event.clipboardData?.items;
      if (!items) return;
      const file = [...items]
        .map((item) => (item.kind === 'file' ? item.getAsFile() : null))
        .find(isAcceptedImageFile);
      if (!file) return;
      event.preventDefault();
      replaceWithFile(file);
    });

    replaceChooseButton.addEventListener('click', (event) => {
      event.stopPropagation();
      replaceFileInput.click();
    });

    replaceFileInput.addEventListener('change', () => {
      const file = replaceFileInput.files?.[0];
      replaceFileInput.value = '';
      replaceWithFile(file);
    });

    replaceAssetsButton.addEventListener('click', (event) => {
      event.stopPropagation();
      void (async () => {
        try {
          const result = await pickReplaceFromAssetManager();
          const src = Array.isArray(result?.srcs)
            ? String(result.srcs.find(Boolean) || '')
            : '';
          if (!src) return;
          applyReplacement(src);
        } catch (error) {
          if (error instanceof Error && error.message === 'cancelled') return;
          status.textContent = error instanceof Error ? error.message : 'Could not replace the image.';
        }
      })();
    });

    // Stop page-level image-drop from inserting a section when the well is the target.
    replaceDrop.addEventListener('dragenter', (event) => {
      event.preventDefault();
      event.stopPropagation();
      replaceDrop.classList.add('is-dragover');
    });
    replaceDrop.addEventListener('dragover', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
      replaceDrop.classList.add('is-dragover');
    });
    replaceDrop.addEventListener('dragleave', (event) => {
      event.stopPropagation();
      replaceDrop.classList.remove('is-dragover');
    });
    replaceDrop.addEventListener('drop', (event) => {
      event.preventDefault();
      event.stopPropagation();
      replaceDrop.classList.remove('is-dragover');
      replaceWithFile(event.dataTransfer?.files?.[0]);
    });

    saveButton.addEventListener('click', saveDraft);
    window.addEventListener('vcd:dev-before-save', () => {
      if (editingSession) { syncDraftDirty(); if (draftDirty) saveDraft(); }
    });
    window.addEventListener('vcd:dev-has-draft', ((event: CustomEvent<{ dirty?: boolean }>) => {
      if (editingSession) { syncDraftDirty(); if (draftDirty && event.detail) event.detail.dirty = true; }
    }) as EventListener);

    const undoLocal = () => {
      const previous = undoStack.pop();
      if (!previous) return;
      redoStack.push(snapshotForRedo(previous));
      applyUndoEntry(previous);
      status.textContent = 'Undid last edit.';
    };

    const redoLocal = () => {
      const next = redoStack.pop();
      if (!next) return;
      undoStack.push(snapshotForRedo(next));
      applyUndoEntry(next);
      status.textContent = 'Redid last edit.';
    };

    cancelButton?.addEventListener('click', () => {
      revertToSaved();
      renderDraft();
      closePanel();
    });

    revertButton.addEventListener('click', () => {
      revertToSaved();
      renderDraft();
      // The frame may have changed shape; re-glue the on-page surface to it.
      if (editingSession) mountPageStage();
      status.textContent = 'Reverted to the last saved crop.';
    });

    resetButton.addEventListener('click', () => {
      pushUndo();
      beginLiveEdits();
      draft = { aspect: draft.aspect, cx: 0.5, cy: 0.5, w: coverW(draft.aspect) };
      renderDraft();
      status.textContent = 'Reset to centred cover — unsaved changes.';
    });

    useGridDefaultButton.addEventListener('click', () => {
      if (!isGridTarget(editTarget) || editTarget.dataset.devHasOwnVariants !== 'true') return;
      const target = editTarget;
      const beforeDefault = snapshotViewport();
      const documentKey = target.dataset.devDocument;
      let imagePath: Array<string | number> = [];
      try {
        imagePath = JSON.parse(target.dataset.devImagePath || '[]');
      } catch {
        imagePath = [];
      }
      if (!documentKey || !Array.isArray(imagePath) || !imagePath.length) {
        status.textContent = 'This image is not wired for saving.';
        return;
      }

      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, {
          variants: structuredClone(savedVariants),
          constrained: savedConstrained,
          maxVh: savedMaxVh,
          cropped: targetWasCropped,
          src: savedSrc,
          ...(savedSrcWidth ? { srcWidth: savedSrcWidth } : {}),
          ...(savedSrcHeight ? { srcHeight: savedSrcHeight } : {}),
        });
      }
      const baseline = structuredClone(diskBaselines.get(pendingId)!);
      const defaultVariants = gridDefaultVariantsFor(target);

      applyVariantsToTarget(target, defaultVariants, { clearOwn: true });
      savedVariants = structuredClone(defaultVariants);
      savedCoverVariants = structuredClone(defaultVariants);
      draftCoverVariants = structuredClone(defaultVariants);
      draftVariants = draftCoverVariants;
      saved = { ...defaultVariants[selectedViewport] };
      draft = { ...saved };
      targetWasCropped = true;
      savedSinceSelect = true;
      renderDraft();
      syncUseGridDefaultButton();

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'crop',
          payload: {
            document: documentKey,
            path: imagePath,
            clearVariants: true,
            background: draftBackground,
          },
          revert: () => {
            applyVariantsToTarget(target, baseline.variants);
            target.dataset.devHasOwnVariants = 'true';
            if (editTarget === target) {
              savedVariants = structuredClone(baseline.variants);
              draftVariants = structuredClone(baseline.variants);
              saved = { ...baseline.variants[selectedViewport] };
              draft = { ...saved };
              renderDraft();
              syncUseGridDefaultButton();
            }
          },
        },
      }));

      const afterDefault = snapshotViewport();
      appliedSnapshots.set(target, structuredClone(afterDefault));
      recordPageCrop(target, beforeDefault, afterDefault);
      openingSnapshot = structuredClone(afterDefault);
      status.textContent = `Staged grid default (${gridDefaultAspectFor(target)}) — use Save in the page bar to write.`;
      closePanel();
    });

    window.addEventListener('vcd:dev-pending-committed', ((event: CustomEvent<{ ids?: string[] }>) => {
      const ids = event.detail?.ids;
      for (const [target, snapshot] of appliedSnapshots) {
        if (!ids || ids.some((id) => id === pendingIdFor(target, 'cover') || id === pendingIdFor(target, 'hover'))) {
          pageBaselines.set(target, structuredClone(snapshot));
        }
      }
      if (!ids) {
        stagedSources.clear();
        diskBaselines.clear();
      } else if (ids.length) {
        ids.forEach((id) => {
          stagedSources.delete(id);
          diskBaselines.delete(id);
        });
      }
      if (editTarget) {
        const currentId = pendingIdFor(editTarget);
        if (!ids || ids.includes(currentId)) diskBaselines.set(currentId, {
          variants: structuredClone(savedVariants),
          constrained: savedConstrained,
          maxVh: savedMaxVh,
          cropped: targetWasCropped,
          src: savedSrc,
          ...(savedSrcWidth ? { srcWidth: savedSrcWidth } : {}),
          ...(savedSrcHeight ? { srcHeight: savedSrcHeight } : {}),
        });
      }
    }) as EventListener);

    window.addEventListener('vcd:dev-pending-reverted', (() => {
      stagedSources.clear();
      diskBaselines.clear();
    }) as EventListener);
  };

  document.querySelectorAll<HTMLElement>('[data-project-image-crop-tuner]').forEach(initProjectImageCropTuner);
</script>

