---
import DevOverlay from '../DevOverlay.astro';
---

<DevOverlay
  title="Edit image"
  storageKey="project-image-crop"
  panelKey="image"
  defaultHidden
>
  <div class="tapico-crop-tuner" data-project-image-crop-tuner>
    <div class="tapico-crop-tuner__viewports" aria-label="Display width">
      <button type="button" data-crop-viewport="desktop">Desktop</button>
      <button type="button" data-crop-viewport="tablet">Tablet</button>
      <button type="button" data-crop-viewport="mobile">Mobile</button>
    </div>

    <label class="tapico-crop-tuner__select">
      <span>Aspect ratio</span>
      <select data-crop-aspect-ratio>
        <option value="original">Original</option>
        <optgroup label="Landscape">
          <option value="16:9">16:9</option>
          <option value="16:10">16:10</option>
          <option value="3:2">3:2</option>
          <option value="4:3">4:3</option>
          <option value="5:4">5:4</option>
        </optgroup>
        <optgroup label="Square">
          <option value="1:1">1:1</option>
        </optgroup>
        <optgroup label="Portrait">
          <option value="5:6">5:6</option>
          <option value="4:5">4:5</option>
          <option value="3:4">3:4</option>
          <option value="2:3">2:3</option>
          <option value="10:16">10:16</option>
          <option value="9:16">9:16</option>
        </optgroup>
      </select>
    </label>

    <label class="tapico-crop-tuner__toggle" data-crop-width-constrain-wrap hidden>
      <input type="checkbox" data-crop-width-constrain />
      <span>Constrain width</span>
      <span class="tapico-crop-tuner__toggle-hint">80% · centred</span>
    </label>

    <label class="tapico-crop-tuner__select" data-crop-height-constrain-wrap hidden>
      <span>Max view height</span>
      <select data-crop-max-vh>
        <option value="">Off</option>
        <option value="90">90%</option>
        <option value="80">80%</option>
        <option value="70">70%</option>
        <option value="60">60%</option>
        <option value="50">50%</option>
        <option value="40">40%</option>
        <option value="30">30%</option>
      </select>
    </label>

    <div class="tapico-crop-tuner__stage">
      <div class="tapico-crop-tuner__preview" data-crop-preview>
        <div class="tapico-crop-tuner__preview-clip">
          <img alt="" data-crop-image draggable="false" />
          <span class="tapico-crop-tuner__handle" aria-hidden="true"></span>
          <span class="tapico-crop-tuner__drag-label">Drag to reposition</span>
        </div>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--n" data-crop-resize="n" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--s" data-crop-resize="s" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--e" data-crop-resize="e" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--w" data-crop-resize="w" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--ne" data-crop-resize="ne" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--nw" data-crop-resize="nw" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--se" data-crop-resize="se" aria-hidden="true"></span>
        <span class="tapico-crop-tuner__resize tapico-crop-tuner__resize--sw" data-crop-resize="sw" aria-hidden="true"></span>
      </div>
    </div>

    <div class="tapico-crop-tuner__toolbar" aria-label="Crop controls">
      <button type="button" data-crop-center-x aria-label="Centre horizontally">
        <span class="tapico-crop-tuner__align-icon tapico-crop-tuner__align-icon--x" aria-hidden="true"></span>
      </button>
      <button type="button" data-crop-center-y aria-label="Centre vertically">
        <span class="tapico-crop-tuner__align-icon tapico-crop-tuner__align-icon--y" aria-hidden="true"></span>
      </button>
      <button
        type="button"
        class="tapico-crop-tuner__constraint"
        data-crop-constraint
        aria-pressed="true"
      >
        <span class="tapico-crop-tuner__lock-icon" aria-hidden="true"></span>
        <span data-crop-constraint-state>Crop locked</span>
      </button>
    </div>

    <label class="tapico-crop-tuner__control">
      <span>Zoom</span>
      <input data-crop-zoom type="range" min="1" max="1.5" step="0.01" value="1" />
      <output data-crop-zoom-output>100%</output>
    </label>

    <p class="tapico-crop-tuner__readout" data-crop-readout>shows 100% of width · centre 0.500, 0.500</p>

    <div class="tapico-crop-tuner__actions">
      <button type="button" data-crop-reset>Reset</button>
      <button type="button" data-crop-revert>Revert changes</button>
      <button type="button" data-crop-use-grid-default hidden>Use grid default</button>
      <button type="button" data-crop-save>Save changes</button>
    </div>

    <p class="tapico-crop-tuner__status" data-crop-status aria-live="polite">
      Hold Shift while dragging to lock movement to one axis.
    </p>
  </div>
</DevOverlay>

<script>
  type ImageViewport = 'desktop' | 'tablet' | 'mobile';

  /**
   * Frame + content. `aspect` shapes the box; `cx`/`cy`/`w` say which part of
   * the source sits in it, anchored to the source image rather than the frame.
   * See src/lib/responsiveImage.ts.
   */
  interface CropState {
    aspect: string;
    cx: number;
    cy: number;
    w: number;
  }

  const initProjectImageCropTuner = (tuner: HTMLElement) => {
    if (tuner.dataset.initialized === 'true') return;
    tuner.dataset.initialized = 'true';

    const preview = tuner.querySelector<HTMLElement>('[data-crop-preview]');
    const previewImage = tuner.querySelector<HTMLImageElement>('[data-crop-image]');
    const aspectRatioSelect = tuner.querySelector<HTMLSelectElement>('[data-crop-aspect-ratio]');
    const widthConstrainWrap = tuner.querySelector<HTMLElement>('[data-crop-width-constrain-wrap]');
    const widthConstrainInput = tuner.querySelector<HTMLInputElement>('[data-crop-width-constrain]');
    const heightConstrainWrap = tuner.querySelector<HTMLElement>('[data-crop-height-constrain-wrap]');
    const maxVhSelect = tuner.querySelector<HTMLSelectElement>('[data-crop-max-vh]');
    const viewportButtons = [
      ...tuner.querySelectorAll<HTMLButtonElement>('[data-crop-viewport]'),
    ];
    const zoomInput = tuner.querySelector<HTMLInputElement>('[data-crop-zoom]');
    const zoomOutput = tuner.querySelector<HTMLOutputElement>('[data-crop-zoom-output]');
    const readout = tuner.querySelector<HTMLElement>('[data-crop-readout]');
    const status = tuner.querySelector<HTMLElement>('[data-crop-status]');
    const centerXButton = tuner.querySelector<HTMLButtonElement>('[data-crop-center-x]');
    const centerYButton = tuner.querySelector<HTMLButtonElement>('[data-crop-center-y]');
    const constraintButton = tuner.querySelector<HTMLButtonElement>('[data-crop-constraint]');
    const constraintState = tuner.querySelector<HTMLElement>('[data-crop-constraint-state]');
    const saveButton = tuner.querySelector<HTMLButtonElement>('[data-crop-save]');
    const revertButton = tuner.querySelector<HTMLButtonElement>('[data-crop-revert]');
    const resetButton = tuner.querySelector<HTMLButtonElement>('[data-crop-reset]');
    const useGridDefaultButton = tuner.querySelector<HTMLButtonElement>('[data-crop-use-grid-default]');
    const initialTarget = document.querySelector<HTMLElement>('[data-dev-image-target]');
    const initialImage = initialTarget?.querySelector<HTMLImageElement>('img');
    if (
      !preview ||
      !previewImage ||
      !aspectRatioSelect ||
      !widthConstrainWrap ||
      !widthConstrainInput ||
      !heightConstrainWrap ||
      !maxVhSelect ||
      !viewportButtons.length ||
      !zoomInput ||
      !zoomOutput ||
      !readout ||
      !status ||
      !centerXButton ||
      !centerYButton ||
      !constraintButton ||
      !constraintState ||
      !saveButton ||
      !revertButton ||
      !resetButton ||
      !useGridDefaultButton ||
      !initialTarget ||
      !initialImage
    ) return;

    // Untouched images render at natural ratio on the page — mirror that in the editor.
    const defaults: CropState = { aspect: 'original', cx: 0.5, cy: 0.5, w: 1 };
    type ResizeDir = 'n' | 's' | 'e' | 'w' | 'ne' | 'nw' | 'se' | 'sw';
    const resizeHandles = [
      ...tuner.querySelectorAll<HTMLElement>('[data-crop-resize]'),
    ];
    const PRESET_ASPECT_RATIOS = new Set(
      [...aspectRatioSelect.options]
        .filter((option) => !option.dataset.cropCustomRatio)
        .map((option) => option.value),
    );
    const RATIO_MIN = 9 / 16; // tallest portrait (~9:16 width/height)
    const RATIO_MAX = 16 / 9; // widest landscape
    const viewportForWidth = (): ImageViewport => {
      if (window.innerWidth <= 767) return 'mobile';
      if (window.innerWidth <= 991) return 'tablet';
      return 'desktop';
    };
    const constraintStorageKey = 'tapicoImageCropConstrained';
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const gcd = (a: number, b: number): number => {
      let x = Math.abs(Math.round(a));
      let y = Math.abs(Math.round(b));
      while (y) {
        const next = x % y;
        x = y;
        y = next;
      }
      return x || 1;
    };
    const formatAspectRatio = (aspectRatio: string) => {
      if (aspectRatio === 'original') return 'original';
      const [widthRaw, heightRaw] = aspectRatio.split(':').map(Number);
      if (!widthRaw || !heightRaw) return aspectRatio;
      const width = Math.round(widthRaw);
      const height = Math.round(heightRaw);
      const divisor = gcd(width, height);
      const a = width / divisor;
      const b = height / divisor;
      if (a <= 100 && b <= 100) return `${a}:${b}`;
      return widthRaw >= heightRaw
        ? `${(widthRaw / heightRaw).toFixed(1)}:1`
        : `1:${(heightRaw / widthRaw).toFixed(1)}`;
    };
    /** Natural ratio of the image being edited. */
    const srcAspect = () => {
      const w = previewImage.naturalWidth || editedImage.naturalWidth;
      const h = previewImage.naturalHeight || editedImage.naturalHeight;
      return w && h ? w / h : 1;
    };

    const frameAspectOf = (aspect: string) => {
      if (aspect === 'original') return srcAspect();
      const [w, h] = aspect.split(':').map(Number);
      return w > 0 && h > 0 ? w / h : srcAspect();
    };

    /** Largest `w` that still covers the frame — `w` beyond this leaves gaps. */
    const coverW = (aspect: string) => Math.min(1, frameAspectOf(aspect) / srcAspect());

    /** Visible source HEIGHT fraction implied by `w` and the frame aspect. */
    const contentH = (state: CropState) => (state.w * srcAspect()) / frameAspectOf(state.aspect);

    /** 1 = fits the frame exactly; >1 = zoomed in. Drives the zoom slider. */
    const zoomOf = (state: CropState) => coverW(state.aspect) / (state.w || 1);
    const wForZoom = (aspect: string, zoom: number) => coverW(aspect) / Math.max(zoom, 0.0001);

    const currentFrameSize = () => {
      const width = preview.clientWidth || 1;
      return { width, height: width / frameAspectOf(draft.aspect) };
    };
    const ratioFromSize = (width: number, height: number) => {
      const clampedRatio = clamp(width / Math.max(height, 1e-6), RATIO_MIN, RATIO_MAX);
      // Encode against a stable height base so 1px preview widths cannot round past the clamp.
      const baseHeight = 100;
      const baseWidth = Math.max(1, Math.round(clampedRatio * baseHeight));
      const divisor = gcd(baseWidth, baseHeight);
      return `${baseWidth / divisor}:${baseHeight / divisor}`;
    };
    const syncAspectRatioSelect = () => {
      const customOption = aspectRatioSelect.querySelector<HTMLOptionElement>('[data-crop-custom-ratio]');
      if (PRESET_ASPECT_RATIOS.has(draft.aspect)) {
        customOption?.remove();
        aspectRatioSelect.value = draft.aspect;
        return;
      }
      const option = customOption ?? document.createElement('option');
      option.dataset.cropCustomRatio = 'true';
      option.value = draft.aspect;
      option.textContent = `Custom (${formatAspectRatio(draft.aspect)})`;
      if (!customOption) {
        const originalOption = aspectRatioSelect.querySelector('option[value="original"]');
        if (originalOption?.nextSibling) {
          aspectRatioSelect.insertBefore(option, originalOption.nextSibling);
        } else {
          aspectRatioSelect.append(option);
        }
      }
      aspectRatioSelect.value = draft.aspect;
    };

    let editTarget = initialTarget;
    let editedImage = initialImage;
    let selectedViewport = viewportForWidth();
    // Panel is open for this image (preview mirrors it; page stays untouched until an edit).
    let editingSession = false;
    // Write draft → live page. Stays false on open; flips on the first real crop edit.
    let liveApply = false;
    let targetWasCropped = false;
    /** Grid cells inheriting the grid default must go back to inheriting on cancel. */
    let targetHadOwnVariants = false;
    /** Rendered value of data-dev-image-variants, for a lossless cancel. */
    let targetVariantsAttr: string | null = null;
    let savedSinceSelect = false;
    let savedConstrained = false;
    let draftConstrained = false;
    let savedMaxVh: number | undefined;
    let draftMaxVh: number | undefined;

    const isGridTarget = (target: HTMLElement) => target.classList.contains('project-image-grid__item');
    const isStandaloneMedia = (target: HTMLElement) => (
      target.classList.contains('project-media') && !isGridTarget(target)
    );
    /** Carousel slides get Max view height too — width constrain stays block-level. */
    const isCarouselItem = (target: HTMLElement) => (
      target.classList.contains('project-image-carousel__slide')
    );
    const supportsMaxVh = (target: HTMLElement) => (
      isStandaloneMedia(target) || isCarouselItem(target)
    );
    const MAX_VH_ALLOWED = new Set([90, 80, 70, 60, 50, 40, 30]);
    const normalizeMaxVh = (value: unknown): number | undefined => {
      if (value === true) return 80;
      if (value === false || value === null || value === undefined || value === '') return undefined;
      const n = Math.round(Number(value));
      return MAX_VH_ALLOWED.has(n) ? n : undefined;
    };

    const readConstrained = (target: HTMLElement) => target.dataset.devConstrained === 'true'
      || target.classList.contains('project-media--constrained');

    const readMaxVh = (target: HTMLElement): number | undefined => {
      const fromData = normalizeMaxVh(target.dataset.devMaxVh);
      if (fromData) return fromData;
      if (
        target.classList.contains('project-media--max-vh')
        || target.classList.contains('project-media--max80')
        || target.querySelector('.project-media__img--max-vh, .project-media__img--max80')
      ) {
        return 80;
      }
      return undefined;
    };

    const setMaxVhVar = (target: HTMLElement, maxVh: number | undefined) => {
      if (maxVh) target.style.setProperty('--project-max-vh', String(maxVh));
      else target.style.removeProperty('--project-max-vh');
    };

    /** Tell section chrome (drag handle, delete) that this frame's box moved. */
    const announceFrameChange = (target: HTMLElement) => {
      window.dispatchEvent(new CustomEvent('vcd:dev-frame-changed', { detail: { target } }));
    };

    const applyFrameFlagsLive = (
      target: HTMLElement,
      flags: { constrained: boolean; maxVh: number | undefined },
    ) => {
      if (isCarouselItem(target)) {
        if (flags.maxVh) target.dataset.maxVh = String(flags.maxVh);
        else delete target.dataset.maxVh;
        target.dataset.devMaxVh = flags.maxVh ? String(flags.maxVh) : '';
        setMaxVhVar(target, flags.maxVh);
        announceFrameChange(target);
        window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', {
          detail: { block: target.closest('[data-project-image-carousel]') },
        }));
        return;
      }
      if (!isStandaloneMedia(target)) return;
      target.classList.toggle('project-media--constrained', flags.constrained);
      target.dataset.devConstrained = flags.constrained ? 'true' : 'false';
      target.dataset.devCentered = flags.constrained ? 'true' : 'false';
      const hasMaxVh = !!flags.maxVh;
      target.classList.toggle('project-media--max-vh', hasMaxVh);
      target.classList.remove('project-media--max80');
      target.dataset.devMaxVh = hasMaxVh ? String(flags.maxVh) : '';
      setMaxVhVar(target, flags.maxVh);
      const image = target.querySelector<HTMLImageElement>('img');
      // The img-level class belongs on UNCROPPED images only — it carries a
      // max-height + object-fit:contain that would clamp and letterbox the
      // cover bitmap of a cropped frame (the frame CSS handles max-vh there).
      const cropped = target.classList.contains('project-cropped');
      image?.classList.toggle('project-media__img--max-vh', hasMaxVh && !cropped);
      image?.classList.remove('project-media__img--max80');
      const block = target.closest('.project-block');
      block?.classList.toggle('project-block--centered', flags.constrained || hasMaxVh);
      announceFrameChange(target);
    };

    const syncWidthConstrainUi = () => {
      const show = isStandaloneMedia(editTarget);
      widthConstrainWrap.hidden = !show;
      widthConstrainInput.checked = draftConstrained;
      heightConstrainWrap.hidden = !supportsMaxVh(editTarget);
      maxVhSelect.value = draftMaxVh ? String(draftMaxVh) : '';
    };

    const gridDefaultAspectFor = (target: HTMLElement) => (
      target.dataset.devGridDefaultAspect
      || target.closest<HTMLElement>('[data-dev-grid-default-aspect]')?.dataset.devGridDefaultAspect
      || '1:1'
    );

    const gridDefaultVariantsFor = (target: HTMLElement): Record<ImageViewport, CropState> => {
      const aspect = gridDefaultAspectFor(target);
      const base = { aspect, cx: 0.5, cy: 0.5, w: coverW(aspect) };
      return { desktop: { ...base }, tablet: { ...base }, mobile: { ...base } };
    };

    const syncUseGridDefaultButton = () => {
      const show = isGridTarget(editTarget) && editTarget.dataset.devHasOwnVariants === 'true';
      useGridDefaultButton.hidden = !show;
    };

    const readAppliedVariants = (
      target: HTMLElement,
    ): Record<ImageViewport, CropState> => {
      try {
        const parsed = JSON.parse(target.dataset.devImageVariants || '{}');
        return {
          desktop: { ...defaults, ...parsed.desktop },
          tablet: { ...defaults, ...parsed.desktop, ...parsed.tablet },
          mobile: {
            ...defaults,
            ...parsed.desktop,
            ...parsed.tablet,
            ...parsed.mobile,
          },
        };
      } catch {
        return {
          desktop: { ...defaults },
          tablet: { ...defaults },
          mobile: { ...defaults },
        };
      }
    };

    const readConstraints = (): Record<ImageViewport, boolean> => {
      const defaults = { desktop: true, tablet: true, mobile: true };
      try {
        const raw = window.localStorage.getItem(constraintStorageKey);
        if (raw === null) return defaults;
        if (raw === 'true' || raw === 'false') {
          const value = raw !== 'false';
          return { desktop: value, tablet: value, mobile: value };
        }
        const parsed = JSON.parse(raw) as Partial<Record<ImageViewport, unknown>>;
        return {
          desktop: parsed.desktop !== false,
          tablet: parsed.tablet !== false,
          mobile: parsed.mobile !== false,
        };
      } catch {
        return defaults;
      }
    };

    const writeConstraints = (next: Record<ImageViewport, boolean>) => {
      try {
        window.localStorage.setItem(constraintStorageKey, JSON.stringify(next));
      } catch {
        // Keep the toggle active for this page load.
      }
    };

    let savedVariants = readAppliedVariants(editTarget);
    let draftVariants = structuredClone(savedVariants);
    let saved: CropState = { ...savedVariants[selectedViewport] };
    let draft: CropState = { ...draftVariants[selectedViewport] };
    let constrainByViewport = readConstraints();
    const constrainToFrame = () => constrainByViewport[selectedViewport];
    /** Disk / last globally-saved baseline per pending id (survives popup close). */
    const diskBaselines = new Map<string, {
      variants: Record<ImageViewport, CropState>;
      constrained: boolean;
      maxVh: number | undefined;
      cropped: boolean;
    }>();
    const VIEWPORTS: ImageViewport[] = ['desktop', 'tablet', 'mobile'];

    const pendingIdFor = (target: HTMLElement) => {
      const documentKey = target.dataset.devDocument || '';
      const imagePath = target.dataset.devImagePath || '[]';
      return `crop:${documentKey}:${imagePath}`;
    };

    const snapshotBaseline = (target: HTMLElement) => ({
      variants: readAppliedVariants(target),
      constrained: isStandaloneMedia(target) ? readConstrained(target) : false,
      maxVh: supportsMaxVh(target) ? readMaxVh(target) : undefined,
      cropped: target.classList.contains('project-cropped') || isGridTarget(target),
    });

    const closePanel = () => {
      const panel = tuner.closest<HTMLElement>('[data-dev-panel-key]');
      if (!panel || panel.hidden) return;
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
        detail: { panel },
      }));
    };

    const applyVariantsToTarget = (
      target: HTMLElement,
      variants: Record<ImageViewport, CropState>,
      options?: { clearOwn?: boolean },
    ) => {
      const image = target.querySelector<HTMLImageElement>('img');
      VIEWPORTS.forEach((viewport) => {
        setTargetVariant(target, viewport, variants[viewport]);
      });
      if (options?.clearOwn) {
        delete target.dataset.devHasOwnVariants;
        target.dataset.devImageVariants = JSON.stringify(variants);
      } else {
        target.dataset.devImageVariants = JSON.stringify(variants);
        if (isGridTarget(target)) target.dataset.devHasOwnVariants = 'true';
      }
    };

    /**
     * Pan bounds, closed form — no DOM measurement. The visible source rect is
     * `w` x `h` centred on (cx, cy), so keeping its edges inside the bitmap means
     * cx in [w/2, 1 - w/2] and likewise for cy. When w is 1 the bounds collapse
     * to 0.5: a frame showing the full width simply cannot pan horizontally.
     */
    const constrainDraft = () => {
      draft.w = clamp(draft.w, 0.01, 1);
      if (!constrainToFrame()) {
        draft.cx = clamp(draft.cx, -1, 2);
        draft.cy = clamp(draft.cy, -1, 2);
        return;
      }
      const h = contentH(draft);
      draft.cx = clamp(draft.cx, draft.w / 2, 1 - draft.w / 2);
      draft.cy = clamp(draft.cy, h / 2, 1 - h / 2);
    };

    const renderConstraint = () => {
      const locked = constrainToFrame();
      constraintButton.setAttribute('aria-pressed', locked ? 'true' : 'false');
      constraintButton.classList.toggle('is-locked', locked);
      constraintState.textContent = locked ? 'Crop locked' : 'Crop unlocked';
    };

    const setCropVariables = (element: HTMLElement, crop: CropState) => {
      element.style.setProperty('--tuner-content-w', String(crop.w));
      element.style.setProperty('--tuner-content-cx', String(crop.cx));
      element.style.setProperty('--tuner-content-cy', String(crop.cy));
    };

    const setTargetVariant = (
      target: HTMLElement,
      viewport: ImageViewport,
      crop: CropState,
    ) => {
      const ratioNum = crop.aspect === 'original'
        ? null
        : (() => {
          const [widthRaw, heightRaw] = crop.aspect.split(':').map(Number);
          return widthRaw && heightRaw ? widthRaw / heightRaw : null;
        })();
      target.style.setProperty(
        `--project-image-ratio-${viewport}`,
        crop.aspect === 'original'
          ? 'var(--project-image-original-ratio, 1 / 1)'
          : crop.aspect.replace(':', ' / '),
      );
      target.style.setProperty(
        `--project-image-ratio-num-${viewport}`,
        ratioNum === null
          ? 'var(--project-image-original-ratio-num, 1)'
          : String(ratioNum),
      );
      target.style.setProperty(`--project-content-w-${viewport}`, String(crop.w));
      target.style.setProperty(`--project-content-cx-${viewport}`, String(crop.cx));
      target.style.setProperty(`--project-content-cy-${viewport}`, String(crop.cy));
    };

    /** First user crop change in this session — enable live page writes + frame classes. */
    const ensureCropClip = (target: HTMLElement, image: HTMLImageElement) => {
      if (isGridTarget(target)) return;
      if (image.parentElement?.classList.contains('project-crop-clip')) return;
      const clip = document.createElement('div');
      clip.className = 'project-crop-clip';
      image.replaceWith(clip);
      clip.append(image);
    };

    const removeCropClipIfOwned = (image: HTMLImageElement) => {
      const clip = image.parentElement;
      if (!clip?.classList.contains('project-crop-clip')) return;
      // Only unwrap when the clip has a single img (our live-edit wrapper).
      if (clip.childElementCount !== 1) return;
      clip.replaceWith(image);
    };

    const beginLiveEdits = () => {
      if (!editingSession || liveApply) return;
      liveApply = true;
      if (!isGridTarget(editTarget)) {
        editTarget.classList.add('project-responsive-image', 'project-cropped');
        // SSR cropped frames already wrap <img> in .project-crop-clip; live-first
        // crop must add it or overflow:visible on .project-cropped lets zoom spill.
        ensureCropClip(editTarget, editedImage);
        // An uncropped max-vh image legitimately carries the img-level class from
        // SSR; now that the target is cropped it would clamp the cover bitmap.
        editedImage.classList.remove('project-media__img--max-vh', 'project-media__img--max80');
      }
    };

    const renderDraft = () => {
      preview.style.aspectRatio = draft.aspect === 'original'
        ? `${previewImage.naturalWidth || 1} / ${previewImage.naturalHeight || 1}`
        : draft.aspect.replace(':', ' / ');
      // Bounds are closed form now, so clamping on open can't shift a saved crop.
      constrainDraft();
      draftVariants[selectedViewport] = { ...draft };
      setCropVariables(preview, draft);
      if (liveApply) {
        if (editedImage.naturalWidth && editedImage.naturalHeight) {
          editTarget.style.setProperty(
            '--project-image-original-ratio',
            `${editedImage.naturalWidth} / ${editedImage.naturalHeight}`,
          );
          editTarget.style.setProperty(
            '--project-image-original-ratio-num',
            String(editedImage.naturalWidth / editedImage.naturalHeight),
          );
        }
        setTargetVariant(editTarget, selectedViewport, draft);
        editTarget.dataset.devImageVariants = JSON.stringify(draftVariants);
        announceFrameChange(editTarget);
      }
      syncAspectRatioSelect();
      viewportButtons.forEach((button) => {
        const active = button.dataset.cropViewport === selectedViewport;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      const zoom = zoomOf(draft);
      zoomInput.value = zoom.toFixed(2);
      zoomOutput.value = `${Math.round(zoom * 100)}%`;
      const ratioLabel = PRESET_ASPECT_RATIOS.has(draft.aspect)
        ? draft.aspect
        : formatAspectRatio(draft.aspect);
      readout.textContent = `${ratioLabel} · shows ${Math.round(draft.w * 100)}% of width · centre ${draft.cx.toFixed(3)}, ${draft.cy.toFixed(3)}`;
      // Frame edits reshape the clip; keep the on-page surface glued to it.
      syncPageStageBox();
    };

    const saveDraft = () => {
      const target = editTarget;
      const documentKey = target.dataset.devDocument;
      let imagePath: Array<string | number> = [];
      try {
        imagePath = JSON.parse(target.dataset.devImagePath || '[]');
      } catch {
        imagePath = [];
      }
      if (!documentKey || !Array.isArray(imagePath) || !imagePath.length) {
        status.textContent = 'This image is not wired for saving.';
        return;
      }

      draftVariants[selectedViewport] = { ...draft };
      const stagedVariants = structuredClone(draftVariants);
      const stagedConstrained = draftConstrained;
      const stagedMaxVh = draftMaxVh;
      const standalone = isStandaloneMedia(target);
      const carouselItem = isCarouselItem(target);
      const persistCrop = targetWasCropped || liveApply;
      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, {
          variants: structuredClone(savedVariants),
          constrained: savedConstrained,
          maxVh: savedMaxVh,
          cropped: targetWasCropped,
        });
      }
      const baseline = structuredClone(diskBaselines.get(pendingId)!);
      const hadOwnVariants = target.dataset.devHasOwnVariants === 'true';

      if (persistCrop) {
        applyVariantsToTarget(target, stagedVariants);
        savedVariants = structuredClone(stagedVariants);
        saved = { ...stagedVariants[selectedViewport] };
        targetWasCropped = true;
      }
      if (standalone || carouselItem) {
        applyFrameFlagsLive(target, { constrained: stagedConstrained, maxVh: stagedMaxVh });
        savedConstrained = stagedConstrained;
        savedMaxVh = stagedMaxVh;
      }
      savedSinceSelect = true;
      if (isGridTarget(target) && persistCrop) {
        target.dataset.devHasOwnVariants = 'true';
        targetHadOwnVariants = true;
        syncUseGridDefaultButton();
      }

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'crop',
          payload: {
            document: documentKey,
            path: imagePath,
            ...(persistCrop ? { variants: stagedVariants } : {}),
            ...(standalone
              ? {
                constrained: stagedConstrained,
                centered: stagedConstrained,
                maxVh: stagedMaxVh ?? 0,
              }
              : {}),
            ...(carouselItem ? { maxVh: stagedMaxVh ?? 0 } : {}),
          },
          revert: () => {
            if (persistCrop) {
              if (!baseline.cropped && !isGridTarget(target)) {
                target.classList.remove('project-cropped', 'project-responsive-image');
                delete target.dataset.devImageVariants;
                const image = target.querySelector<HTMLImageElement>('img');
                if (image) {
                  image.style.width = '';
                  image.style.height = '';
                  removeCropClipIfOwned(image);
                }
              } else if (isGridTarget(target) && !hadOwnVariants) {
                applyVariantsToTarget(target, baseline.variants, { clearOwn: true });
              } else {
                applyVariantsToTarget(target, baseline.variants);
                if (isGridTarget(target) && hadOwnVariants) {
                  target.dataset.devHasOwnVariants = 'true';
                }
              }
            }
            if (standalone || carouselItem) {
              applyFrameFlagsLive(target, {
                constrained: baseline.constrained,
                maxVh: baseline.maxVh,
              });
            }
            if (editTarget === target) {
              if (persistCrop) {
                savedVariants = structuredClone(baseline.variants);
                draftVariants = structuredClone(baseline.variants);
                saved = { ...baseline.variants[selectedViewport] };
                draft = { ...saved };
                targetWasCropped = baseline.cropped;
                renderDraft();
                syncUseGridDefaultButton();
              }
              savedConstrained = baseline.constrained;
              draftConstrained = baseline.constrained;
              savedMaxVh = baseline.maxVh;
              draftMaxVh = baseline.maxVh;
              syncWidthConstrainUi();
            }
          },
        },
      }));

      status.textContent = 'Staged — use Save in the page bar to write to disk.';
      closePanel();
    };

    const refreshCover = () => {
      if (editedImage.naturalWidth) renderDraft();
    };

    previewImage.addEventListener('load', refreshCover);
    window.addEventListener('resize', refreshCover);

    const resizeObserver = typeof ResizeObserver === 'undefined'
      ? null
      : new ResizeObserver(refreshCover);
    resizeObserver?.observe(preview);

    /** Take the crop frame back off a target that had none before this session. */
    const stripLiveCropFrame = () => {
      if (!editTarget || isGridTarget(editTarget)) return;
      editTarget.classList.remove('project-cropped', 'project-responsive-image');
      // Restore the attribute rather than dropping it, so a cancelled session
      // leaves the target byte-identical to how it was rendered.
      if (targetVariantsAttr === null) delete editTarget.dataset.devImageVariants;
      else editTarget.dataset.devImageVariants = targetVariantsAttr;
      removeCropClipIfOwned(editedImage);
    };

    /**
     * Snap the page back to the last saved crop — the single "cancel" shared by
     * the Revert button, the panel close control, the Edit image toggle and
     * Escape. "Saved" means the last tuner Save (staged into the pending batch),
     * or the state read off the page when this target was selected; so saving
     * and then cancelling without touching anything is a no-op.
     */
    const revertToSaved = () => {
      const target = editTarget;
      if (!target) return;

      draftVariants = structuredClone(savedVariants);
      saved = { ...savedVariants[selectedViewport] };
      draft = { ...saved };
      draftConstrained = savedConstrained;
      draftMaxVh = savedMaxVh;

      if (liveApply || savedSinceSelect) {
        if (targetWasCropped || savedSinceSelect) {
          // Restore every breakpoint, not just the one on screen — the session
          // may have edited others via the viewport chips.
          applyVariantsToTarget(
            target,
            savedVariants,
            isGridTarget(target) && !targetHadOwnVariants ? { clearOwn: true } : undefined,
          );
        } else {
          stripLiveCropFrame();
        }
      }

      // Order matters: the img-level max-vh class is only correct once the
      // frame classes above have settled (it must stay off cropped images).
      if (isStandaloneMedia(target)) {
        applyFrameFlagsLive(target, {
          constrained: savedConstrained,
          maxVh: savedMaxVh,
        });
      }
      syncWidthConstrainUi();
      liveApply = false;
    };

    const selectTarget = (target: HTMLElement, live: boolean) => {
      const image = target.querySelector<HTMLImageElement>('img');
      if (!image) return;

      unmountPageStage();
      resizeObserver?.unobserve(editTarget);
      editTarget = target;
      editedImage = image;
      resizeObserver?.observe(editTarget);

      editingSession = live;
      // Preview-only until the user actually changes the crop.
      liveApply = false;
      targetWasCropped = target.classList.contains('project-cropped') || isGridTarget(target);
      targetHadOwnVariants = target.dataset.devHasOwnVariants === 'true';
      targetVariantsAttr = target.dataset.devImageVariants ?? null;
      savedSinceSelect = false;

      selectedViewport = viewportForWidth();
      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, snapshotBaseline(editTarget));
      }
      savedVariants = readAppliedVariants(editTarget);
      draftVariants = structuredClone(savedVariants);
      savedConstrained = isStandaloneMedia(target) ? readConstrained(target) : false;
      draftConstrained = savedConstrained;
      savedMaxVh = supportsMaxVh(target) ? readMaxVh(target) : undefined;
      draftMaxVh = savedMaxVh;
      saved = { ...savedVariants[selectedViewport] };
      draft = { ...saved };
      previewImage.src = editedImage.currentSrc || editedImage.src;

      if (editedImage.complete) {
        refreshCover();
      } else {
        editedImage.addEventListener('load', refreshCover, { once: true });
      }
      renderConstraint();
      renderDraft();
      syncUseGridDefaultButton();
      syncWidthConstrainUi();
      if (live) {
        mountPageStage();
        status.textContent = viewportGateOk()
          ? 'Editing this image — drag on the page to reposition, scroll to zoom, pull the handles to reshape.'
          : 'Editing this image. The page updates when you change the crop.';
      }
    };

    /* ── On-page crop surface ──────────────────────────────────────────
       Mounted only while this panel is editing a target — never on hover.
       Drag pans the content, wheel zooms around the pointer, edge/corner
       handles reshape the frame, and a faded ghost shows the source
       outside the frame. Gated to the real viewport: editing the tablet
       crop from a desktop window keeps the modal preview as the surface,
       since the page cannot display that variant. */
    let pageStage: {
      ghost: HTMLElement;
      ghostImg: HTMLImageElement;
      stage: HTMLElement;
      target: HTMLElement;
    } | null = null;

    const PAGE_RESIZE_DIRS: ResizeDir[] = ['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'];

    const pageFrameFor = (target: HTMLElement): HTMLElement => (
      target.querySelector<HTMLElement>(':scope > .project-crop-clip')
      ?? target.querySelector<HTMLElement>(':scope > .project-image-grid__frame')
      ?? target
    );

    const viewportGateOk = () => selectedViewport === viewportForWidth();

    const syncPageStageBox = () => {
      if (!pageStage) return;
      const { target, ghost, stage } = pageStage;
      const frame = pageFrameFor(target);
      // Uncropped targets have no frame node yet — overlay the bitmap itself
      // (its box is what the first edit will turn into the frame).
      const ref = frame === target
        ? (target.querySelector<HTMLElement>('img') ?? target)
        : frame;
      const box = ref === target
        ? { left: 0, top: 0, width: target.clientWidth, height: target.clientHeight }
        : { left: ref.offsetLeft, top: ref.offsetTop, width: ref.offsetWidth, height: ref.offsetHeight };
      for (const el of [ghost, stage]) {
        el.style.left = `${box.left}px`;
        el.style.top = `${box.top}px`;
        el.style.width = `${box.width}px`;
        el.style.height = `${box.height}px`;
      }
    };

    const unmountPageStage = () => {
      if (!pageStage) return;
      pageStage.ghost.remove();
      pageStage.stage.remove();
      const carousel = pageStage.target.closest('[data-project-image-carousel]');
      const track = pageStage.target.closest<HTMLElement>('[data-carousel-track]');
      pageStage.target.classList.remove('dev-crop-stage-host');
      // Drop the height lock after the host class, so the tallest-mode
      // auto-height can see every sibling again on the next refresh.
      track?.style.removeProperty('--project-carousel-crop-lock-height');
      pageStage = null;
      // Slides un-isolate — put the carousel back on the one just cropped.
      if (carousel) {
        window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: carousel } }));
      }
    };

    /** Capture can throw once a pointer is gone (fast release, pen lift). */
    const capturePointer = (el: HTMLElement, pointerId: number) => {
      try {
        el.setPointerCapture(pointerId);
      } catch {
        // Drag still works off the shared pointer-id state.
      }
    };

    const wirePageStage = (stage: HTMLElement) => {
      let panPointer: number | null = null;
      let panStartX = 0;
      let panStartY = 0;
      let panOriginX = 0.5;
      let panOriginY = 0.5;
      let panAxis: 'x' | 'y' | null = null;

      stage.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        if ((event.target as HTMLElement | null)?.closest?.('[data-page-resize]')) return;
        event.preventDefault();
        // Keep the carousel track from starting a swipe and stealing capture.
        event.stopPropagation();
        panPointer = event.pointerId;
        panStartX = event.clientX;
        panStartY = event.clientY;
        panOriginX = draft.cx;
        panOriginY = draft.cy;
        panAxis = null;
        stage.classList.add('is-dragging');
        capturePointer(stage, event.pointerId);
      });

      stage.addEventListener('pointermove', (event) => {
        if (panPointer !== event.pointerId) return;
        // Guard: if capture was stolen, buttons may already be up.
        if (event.buttons === 0) {
          panPointer = null;
          stage.classList.remove('is-dragging');
          return;
        }
        const bounds = stage.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;
        const deltaX = event.clientX - panStartX;
        const deltaY = event.clientY - panStartY;
        if (event.shiftKey && !panAxis && Math.hypot(deltaX, deltaY) >= 3) {
          panAxis = Math.abs(deltaX) >= Math.abs(deltaY) ? 'x' : 'y';
        } else if (!event.shiftKey) {
          panAxis = null;
        }
        beginLiveEdits();
        // One frame-width of travel spans `w` of the source; content follows
        // the pointer, so the anchor point moves opposite.
        const nextX = panOriginX - (deltaX / bounds.width) * draft.w;
        const nextY = panOriginY - (deltaY / bounds.height) * contentH(draft);
        draft.cx = panAxis === 'y' ? panOriginX : nextX;
        draft.cy = panAxis === 'x' ? panOriginY : nextY;
        renderDraft();
        status.textContent = panAxis
          ? `${panAxis.toUpperCase()} axis locked — unsaved changes.`
          : 'Unsaved changes.';
      });

      const endPan = (event: PointerEvent) => {
        if (panPointer !== event.pointerId) return;
        panPointer = null;
        stage.classList.remove('is-dragging');
        if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      };
      stage.addEventListener('pointerup', endPan);
      stage.addEventListener('pointercancel', endPan);
      stage.addEventListener('lostpointercapture', (event) => {
        if (panPointer !== event.pointerId) return;
        panPointer = null;
        stage.classList.remove('is-dragging');
      });

      stage.addEventListener('wheel', (event) => {
        event.preventDefault();
        const bounds = stage.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;
        // Keep the source point under the pointer fixed while `w` changes.
        const fx = (event.clientX - bounds.left) / bounds.width;
        const fy = (event.clientY - bounds.top) / bounds.height;
        const sourceX = draft.cx + (fx - 0.5) * draft.w;
        const sourceY = draft.cy + (fy - 0.5) * contentH(draft);
        const maxW = coverW(draft.aspect);
        beginLiveEdits();
        const factor = Math.exp(-event.deltaY * 0.0022);
        draft.w = clamp(draft.w / factor, maxW / 1.5, maxW);
        draft.cx = sourceX - (fx - 0.5) * draft.w;
        draft.cy = sourceY - (fy - 0.5) * contentH(draft);
        renderDraft();
        status.textContent = `Zoom ${Math.round(zoomOf(draft) * 100)}% — unsaved changes.`;
      }, { passive: false });

      stage.querySelectorAll<HTMLElement>('[data-page-resize]').forEach((handle) => {
        handle.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          event.preventDefault();
          // Bubble past the stage pan handler and the carousel track swipe.
          event.stopPropagation();
          const dir = handle.dataset.pageResize as ResizeDir | undefined;
          if (!dir) return;
          const bounds = stage.getBoundingClientRect();
          resizePointerId = event.pointerId;
          resizeDir = dir;
          startX = event.clientX;
          startY = event.clientY;
          resizeStartWidth = bounds.width;
          resizeStartHeight = bounds.height;
          stage.classList.add('is-resizing');
          capturePointer(handle, event.pointerId);
        });
        handle.addEventListener('pointermove', (event) => {
          if (resizePointerId !== event.pointerId) return;
          applyResizeFromPointer(event.clientX, event.clientY);
        });
        const endResize = (event: PointerEvent) => {
          if (resizePointerId !== event.pointerId) return;
          resizePointerId = null;
          resizeDir = null;
          stage.classList.remove('is-resizing');
          if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
        };
        handle.addEventListener('pointerup', endResize);
        handle.addEventListener('pointercancel', endResize);
      });
    };

    const mountPageStage = () => {
      unmountPageStage();
      if (!editingSession || !viewportGateOk()) return;
      const target = editTarget;

      const ghost = document.createElement('div');
      ghost.className = 'dev-crop-ghost';
      ghost.setAttribute('aria-hidden', 'true');
      const ghostImg = document.createElement('img');
      ghostImg.alt = '';
      ghostImg.draggable = false;
      ghostImg.src = editedImage.currentSrc || editedImage.src;
      ghost.append(ghostImg);

      const stage = document.createElement('div');
      stage.className = 'dev-crop-stage';
      PAGE_RESIZE_DIRS.forEach((dir) => {
        const handle = document.createElement('span');
        handle.className = `dev-crop-stage__handle dev-crop-stage__handle--${dir}`;
        handle.dataset.pageResize = dir;
        handle.setAttribute('aria-hidden', 'true');
        stage.append(handle);
      });

      // Lock track height while siblings are still measurable — isolation
      // hides them, and pin-to-tallest would otherwise collapse.
      const track = target.closest<HTMLElement>('[data-carousel-track]');
      if (track) {
        const lockHeight = Math.round(track.getBoundingClientRect().height);
        if (lockHeight > 0) {
          track.style.setProperty('--project-carousel-crop-lock-height', `${lockHeight}px`);
        }
      }

      target.classList.add('dev-crop-stage-host');
      // Ghost first so the clip (later in DOM order) paints over the shared
      // region — only the content outside the frame reads as faded.
      target.prepend(ghost);
      target.append(stage);
      pageStage = { ghost, ghostImg, stage, target };
      wirePageStage(stage);
      syncPageStageBox();
      const carousel = target.closest('[data-project-image-carousel]');
      if (carousel) {
        window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: carousel } }));
      }
    };

    window.addEventListener('vcd:dev-edit-open', ((event: CustomEvent) => {
      // Only the image/crop panel — caption/grid opens must not hijack this target.
      const panel = event.detail?.panel as HTMLElement | undefined;
      const trigger = event.detail?.trigger as HTMLElement | undefined;
      if (!panel || panel.dataset.devPanelKey !== 'image') return;
      const target = trigger?.closest<HTMLElement>('[data-dev-image-target]');
      if (target) selectTarget(target, true);
    }) as EventListener);

    const teardownEditSession = () => {
      unmountPageStage();
      // Closing is a cancel: unsaved crop edits never survive the panel.
      revertToSaved();
      editingSession = false;
    };

    window.addEventListener('vcd:dev-edit-close', ((event: CustomEvent) => {
      const panel = event.detail?.panel as HTMLElement | undefined;
      if (panel && panel.dataset.devPanelKey !== 'image') return;
      teardownEditSession();
    }) as EventListener);

    // Escape hides every panel without per-panel close events, and Alt+D can
    // exit dev mode with the panel open. Both must tear the page surface down,
    // or the orphaned ghost loses its dev-only styling and renders as a
    // full-size in-flow duplicate of the image.
    window.addEventListener('vcd:dev-panels-closed', teardownEditSession);
    window.addEventListener('vcd:dev-mode-change', ((event: CustomEvent<{ active?: boolean }>) => {
      if (event.detail?.active === false) teardownEditSession();
    }) as EventListener);

    // Prime the preview canvas without mutating the live page image.
    selectTarget(initialTarget, false);

    viewportButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const viewport = button.dataset.cropViewport as ImageViewport | undefined;
        if (!viewport || viewport === selectedViewport) return;
        draftVariants[selectedViewport] = { ...draft };
        selectedViewport = viewport;
        saved = { ...savedVariants[selectedViewport] };
        draft = { ...draftVariants[selectedViewport] };
        renderConstraint();
        renderDraft();
        // The page can only mirror the crop of the breakpoint it is showing.
        if (editingSession) mountPageStage();
        status.textContent = viewportGateOk()
          ? `Editing the ${selectedViewport} display crop.`
          : `Editing the ${selectedViewport} display crop — use the preview above; the page shows the ${viewportForWidth()} crop.`;
      });
    });

    aspectRatioSelect.addEventListener('change', () => {
      beginLiveEdits();
      // Hold the zoom level across the reshape; `w` follows the new cover bound.
      const zoom = zoomOf(draft);
      draft.aspect = aspectRatioSelect.value;
      draft.w = wForZoom(draft.aspect, zoom);
      if (PRESET_ASPECT_RATIOS.has(draft.aspect)) {
        aspectRatioSelect.querySelector('[data-crop-custom-ratio]')?.remove();
      }
      renderDraft();
      status.textContent = 'Aspect ratio changed — unsaved changes.';
    });

    zoomInput.addEventListener('input', () => {
      beginLiveEdits();
      draft.w = wForZoom(draft.aspect, clamp(Number(zoomInput.value), 1, 1.5));
      renderDraft();
      status.textContent = 'Unsaved changes.';
    });

    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;
    let originX = 0;
    let originY = 0;
    let lockedAxis: 'x' | 'y' | null = null;
    let resizePointerId: number | null = null;
    let resizeDir: ResizeDir | null = null;
    let resizeStartWidth = 0;
    let resizeStartHeight = 0;

    const applyResizeFromPointer = (clientX: number, clientY: number) => {
      if (!resizeDir) return;
      const width = resizeStartWidth || preview.clientWidth || 1;
      let height = resizeStartHeight;
      const deltaX = clientX - startX;
      const deltaY = clientY - startY;
      const edges = new Set(resizeDir.split(''));
      const affectsN = edges.has('n');
      const affectsS = edges.has('s');
      const affectsE = edges.has('e');
      const affectsW = edges.has('w');
      const vertical = affectsN || affectsS;
      const horizontalOnly = (affectsE || affectsW) && !vertical;

      if (affectsN) height = resizeStartHeight - deltaY;
      if (affectsS) height = resizeStartHeight + deltaY;
      if (horizontalOnly) {
        // Outward horizontal drag → wider ratio → shorter frame (width is layout-fixed).
        const impliedWidth = affectsE
          ? resizeStartWidth + deltaX
          : resizeStartWidth - deltaX;
        height = resizeStartHeight * (resizeStartWidth / Math.max(1, impliedWidth));
      }

      const minHeight = width / RATIO_MAX;
      const maxHeight = width / RATIO_MIN;
      height = clamp(height, minHeight, maxHeight);
      beginLiveEdits();
      const zoom = zoomOf(draft);
      draft.aspect = ratioFromSize(width, height);
      draft.w = wForZoom(draft.aspect, zoom);
      renderDraft();
      status.textContent = 'Frame resized — unsaved changes.';
    };

    resizeHandles.forEach((handle) => {
      handle.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        event.stopPropagation();
        const dir = handle.dataset.cropResize as ResizeDir | undefined;
        if (!dir) return;
        const size = currentFrameSize();
        resizePointerId = event.pointerId;
        resizeDir = dir;
        startX = event.clientX;
        startY = event.clientY;
        resizeStartWidth = size.width;
        resizeStartHeight = size.height;
        preview.classList.add('is-resizing');
        handle.setPointerCapture(event.pointerId);
      });

      handle.addEventListener('pointermove', (event) => {
        if (resizePointerId !== event.pointerId) return;
        applyResizeFromPointer(event.clientX, event.clientY);
      });

      const endResize = (event: PointerEvent) => {
        if (resizePointerId !== event.pointerId) return;
        resizePointerId = null;
        resizeDir = null;
        preview.classList.remove('is-resizing');
        if (handle.hasPointerCapture(event.pointerId)) {
          handle.releasePointerCapture(event.pointerId);
        }
      };

      handle.addEventListener('pointerup', endResize);
      handle.addEventListener('pointercancel', endResize);
    });

    preview.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      if ((event.target as HTMLElement | null)?.closest?.('[data-crop-resize]')) return;
      event.preventDefault();
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      originX = draft.cx;
      originY = draft.cy;
      lockedAxis = null;
      preview.classList.add('is-dragging');
      preview.setPointerCapture(event.pointerId);
    });

    preview.addEventListener('pointermove', (event) => {
      if (pointerId !== event.pointerId) return;
      const bounds = preview.getBoundingClientRect();
      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      if (event.shiftKey && !lockedAxis && Math.hypot(deltaX, deltaY) >= 3) {
        lockedAxis = Math.abs(deltaX) >= Math.abs(deltaY) ? 'x' : 'y';
      } else if (!event.shiftKey) {
        lockedAxis = null;
      }

      // Dragging the content right moves the source point under the frame centre
      // LEFT, hence the negative. The frame spans `w` of the source width, so one
      // frame-width of travel is `w` of the source.
      const nextX = originX - (deltaX / bounds.width) * draft.w;
      const nextY = originY - (deltaY / bounds.height) * contentH(draft);
      beginLiveEdits();
      draft.cx = lockedAxis === 'y' ? originX : nextX;
      draft.cy = lockedAxis === 'x' ? originY : nextY;
      renderDraft();
      status.textContent = lockedAxis
        ? `${lockedAxis.toUpperCase()} axis locked — unsaved changes.`
        : 'Unsaved changes.';
    });

    const endDrag = (event: PointerEvent) => {
      if (pointerId !== event.pointerId) return;
      pointerId = null;
      preview.classList.remove('is-dragging');
      if (preview.hasPointerCapture(event.pointerId)) preview.releasePointerCapture(event.pointerId);
    };

    preview.addEventListener('pointerup', endDrag);
    preview.addEventListener('pointercancel', endDrag);

    centerXButton.addEventListener('click', () => {
      beginLiveEdits();
      draft.cx = 0.5;
      renderDraft();
      status.textContent = 'Centred horizontally — unsaved changes.';
    });

    centerYButton.addEventListener('click', () => {
      beginLiveEdits();
      draft.cy = 0.5;
      renderDraft();
      status.textContent = 'Centred vertically — unsaved changes.';
    });

    constraintButton.addEventListener('click', () => {
      beginLiveEdits();
      const next = !constrainToFrame();
      constrainByViewport = {
        ...constrainByViewport,
        [selectedViewport]: next,
      };
      writeConstraints(constrainByViewport);
      renderConstraint();
      renderDraft();
      status.textContent = next
        ? `Crop locked on ${selectedViewport} within the image bounds.`
        : `Crop unlocked on ${selectedViewport} — image edges may enter the frame.`;
    });

    widthConstrainInput.addEventListener('change', () => {
      if (!isStandaloneMedia(editTarget)) {
        widthConstrainInput.checked = false;
        return;
      }
      draftConstrained = widthConstrainInput.checked;
      applyFrameFlagsLive(editTarget, {
        constrained: draftConstrained,
        maxVh: draftMaxVh,
      });
      status.textContent = draftConstrained
        ? 'Width constrained to 80% (centred) — unsaved changes.'
        : 'Full width — unsaved changes.';
    });

    maxVhSelect.addEventListener('change', () => {
      if (!supportsMaxVh(editTarget)) {
        maxVhSelect.value = '';
        return;
      }
      draftMaxVh = normalizeMaxVh(maxVhSelect.value);
      applyFrameFlagsLive(editTarget, {
        constrained: draftConstrained,
        maxVh: draftMaxVh,
      });
      status.textContent = draftMaxVh
        ? `Height constrained to ${draftMaxVh}% view height — unsaved changes.`
        : 'Full height — unsaved changes.';
    });

    saveButton.addEventListener('click', saveDraft);

    revertButton.addEventListener('click', () => {
      revertToSaved();
      renderDraft();
      // The frame may have changed shape; re-glue the on-page surface to it.
      if (editingSession) mountPageStage();
      status.textContent = 'Reverted to the last saved crop.';
    });

    resetButton.addEventListener('click', () => {
      beginLiveEdits();
      draft = { aspect: draft.aspect, cx: 0.5, cy: 0.5, w: coverW(draft.aspect) };
      renderDraft();
      status.textContent = 'Reset to centred cover — unsaved changes.';
    });

    useGridDefaultButton.addEventListener('click', () => {
      if (!isGridTarget(editTarget) || editTarget.dataset.devHasOwnVariants !== 'true') return;
      const target = editTarget;
      const documentKey = target.dataset.devDocument;
      let imagePath: Array<string | number> = [];
      try {
        imagePath = JSON.parse(target.dataset.devImagePath || '[]');
      } catch {
        imagePath = [];
      }
      if (!documentKey || !Array.isArray(imagePath) || !imagePath.length) {
        status.textContent = 'This image is not wired for saving.';
        return;
      }

      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, {
          variants: structuredClone(savedVariants),
          constrained: savedConstrained,
          maxVh: savedMaxVh,
          cropped: targetWasCropped,
        });
      }
      const baseline = structuredClone(diskBaselines.get(pendingId)!);
      const defaultVariants = gridDefaultVariantsFor(target);

      applyVariantsToTarget(target, defaultVariants, { clearOwn: true });
      savedVariants = structuredClone(defaultVariants);
      draftVariants = structuredClone(defaultVariants);
      saved = { ...defaultVariants[selectedViewport] };
      draft = { ...saved };
      targetWasCropped = true;
      savedSinceSelect = true;
      renderDraft();
      syncUseGridDefaultButton();

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'crop',
          payload: {
            document: documentKey,
            path: imagePath,
            clearVariants: true,
          },
          revert: () => {
            applyVariantsToTarget(target, baseline.variants);
            target.dataset.devHasOwnVariants = 'true';
            if (editTarget === target) {
              savedVariants = structuredClone(baseline.variants);
              draftVariants = structuredClone(baseline.variants);
              saved = { ...baseline.variants[selectedViewport] };
              draft = { ...saved };
              renderDraft();
              syncUseGridDefaultButton();
            }
          },
        },
      }));

      status.textContent = `Staged grid default (${gridDefaultAspectFor(target)}) — use Save in the page bar to write.`;
      closePanel();
    });

    window.addEventListener('vcd:dev-pending-committed', (() => {
      diskBaselines.clear();
      if (editTarget) {
        diskBaselines.set(pendingIdFor(editTarget), {
          variants: structuredClone(savedVariants),
          constrained: savedConstrained,
          maxVh: savedMaxVh,
          cropped: targetWasCropped,
        });
      }
    }) as EventListener);

    window.addEventListener('vcd:dev-pending-reverted', (() => {
      diskBaselines.clear();
    }) as EventListener);
  };

  document.querySelectorAll<HTMLElement>('[data-project-image-crop-tuner]').forEach(initProjectImageCropTuner);
</script>

