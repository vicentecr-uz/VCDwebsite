---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';

export type PressQuoteTickerItem = {
  quote: string;
  logoSrc: string;
  logoAlt: string;
  href: string;
  /** Optional label for the outlet (used in aria). */
  name?: string;
};

interface Props {
  items: PressQuoteTickerItem[];
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  /** Pixels per second at full speed. */
  speed?: number;
  /** Logo opacity in light mode (0–1). */
  logoOpacity?: number;
}

const {
  items,
  documentKey,
  sectionPath,
  spacing = 'section',
  sectionId,
  speed = 36,
  logoOpacity = 0.6,
} = Astro.props;

const editable = import.meta.env.DEV && documentKey && sectionPath;
const stackClass = projectStackClass(spacing);
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing);
// Duplicate once for a seamless loop.
const loopItems = [...items, ...items];
---

<section
  id={sectionId}
  class:list={['project-block', 'press-quote-ticker', stackClass, sectionId && 'section-block']}
  style={`--press-ticker-logo-opacity: ${logoOpacity};`}
  data-press-quote-ticker
  data-press-ticker-speed={String(speed)}
  data-press-ticker-count={String(items.length)}
  {...(spacingAttrs ?? {})}
>
  <div class="press-quote-ticker__viewport" data-press-ticker-viewport>
    <div class="press-quote-ticker__track" data-press-ticker-track>
      {loopItems.map((item, index) => {
        const sourceIndex = index % items.length;
        const isClone = index >= items.length;
        const quotePath =
          editable && sectionPath
            ? JSON.stringify([...sectionPath, 'items', sourceIndex, 'quote'])
            : undefined;
        const name = item.name ?? item.logoAlt;

        return (
          <article
            class="press-quote-ticker__item"
            data-press-ticker-item
            data-press-ticker-source={String(sourceIndex)}
            data-press-ticker-href={item.href}
            aria-hidden={isClone ? 'true' : undefined}
          >
            <a
              class="press-quote-ticker__hit"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              tabindex={isClone ? -1 : undefined}
              aria-label={isClone ? undefined : `${name}: ${item.quote} (opens in a new tab)`}
              data-press-ticker-hit
            ></a>
            <p class="press-quote-ticker__quote">
              <span
                class="press-quote-ticker__quote-text"
                data-dev-text-document={editable ? documentKey : undefined}
                data-dev-text-path={editable ? quotePath : undefined}
                data-dev-text-kind={editable ? 'text' : undefined}
              >{item.quote}</span>
            </p>
            <span class="press-quote-ticker__logo-slot">
              <img
                class="press-quote-ticker__logo"
                src={item.logoSrc}
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </span>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .press-quote-ticker {
    /* Stay inside #site-wrapper gutters (same content column as images/text). */
    width: 100%;
    max-width: 60em;
  }

  .press-quote-ticker__viewport {
    position: relative;
    overflow: hidden;
    /* Vertical page scroll still works; horizontal drag is ours. */
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .press-quote-ticker__viewport.is-dragging {
    cursor: grabbing;
  }

  /* Fade to page background at the content edges (not full-bleed). */
  .press-quote-ticker__viewport::before,
  .press-quote-ticker__viewport::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3.5em;
    z-index: 1;
    pointer-events: none;
  }

  .press-quote-ticker__viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg) 0%, transparent 100%);
  }

  .press-quote-ticker__viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg) 0%, transparent 100%);
  }

  .press-quote-ticker__track {
    display: flex;
    width: max-content;
    gap: 3.5em;
    will-change: transform;
  }

  .press-quote-ticker__item {
    position: relative;
    display: grid;
    grid-template-rows: 5.8em 3em;
    align-items: center;
    justify-items: center;
    gap: 0.85em;
    flex: 0 0 auto;
    width: min(14em, 68vw);
    text-align: center;
    color: inherit;
  }

  /* Full-card hit target sits under the quote so Dev Mode caret clicks work. */
  .press-quote-ticker__hit {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 0;
  }

  .press-quote-ticker__quote,
  .press-quote-ticker__logo-slot {
    position: relative;
    z-index: 1;
  }

  .press-quote-ticker__quote {
    margin: 0;
    width: 100%;
    max-width: 14em;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05em;
    font-weight: 400;
    font-style: italic;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-text);
    opacity: var(--press-ticker-logo-opacity, 0.6);
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .press-quote-ticker__quote-text {
    pointer-events: none;
  }

  /* Only intercept clicks for caret placement while Dev Mode is on. */
  :global(html.is-dev-mode) .press-quote-ticker__quote-text {
    pointer-events: auto;
  }

  .press-quote-ticker__logo-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .press-quote-ticker__logo {
    display: block;
    width: auto;
    height: 2.25em;
    max-width: 13em;
    object-fit: contain;
    object-position: center;
    opacity: var(--press-ticker-logo-opacity, 0.6);
    transition: opacity 0.2s ease;
    /* Dark mode: invert black→white when theme lands — see GitHub issue. */
    /* filter: invert(1); */
  }

  /* Whole card hover: quote + logo go full black. */
  .press-quote-ticker__item:hover .press-quote-ticker__quote,
  .press-quote-ticker__item:focus-within .press-quote-ticker__quote,
  .press-quote-ticker__item:hover .press-quote-ticker__logo,
  .press-quote-ticker__item:focus-within .press-quote-ticker__logo {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .press-quote-ticker__track {
      transform: none !important;
    }
  }
</style>

<script>
  const CLEANUP_KEY = '__pressTickerCleanup';
  const BEAT_KEY = '__pressTickerBeat';
  const WATCH_KEY = '__pressTickerWatch';
  const STATE_PREFIX = 'press-ticker-state:';

  type TickerRoot = HTMLElement & {
    [CLEANUP_KEY]?: () => void;
    [BEAT_KEY]?: number;
  };

  const stateKeyFor = (root: HTMLElement) =>
    `${STATE_PREFIX}${location.pathname}#${root.id || root.dataset.pressTickerCount || 'ticker'}`;

  const readStoredState = (root: HTMLElement) => {
    try {
      const raw = sessionStorage.getItem(stateKeyFor(root));
      if (!raw) return null;
      const parsed = JSON.parse(raw) as {
        phase?: number;
        speed?: number;
        targetSpeed?: number;
        wall?: number;
      };
      if (typeof parsed.wall !== 'number' || Date.now() - parsed.wall > 8000) return null;
      return parsed;
    } catch {
      return null;
    }
  };

  const writeStoredState = (
    root: HTMLElement,
    state: { phase: number; speed: number; targetSpeed: number },
  ) => {
    try {
      sessionStorage.setItem(
        stateKeyFor(root),
        JSON.stringify({ ...state, wall: Date.now() }),
      );
    } catch {
      /* private mode / quota */
    }
  };

  const initPressQuoteTicker = (root: HTMLElement) => {
    const host = root as TickerRoot;
    // HMR / astro:page-load can reuse the node after the old rAF was torn down.
    // Always re-bind; tear down any previous instance first.
    host[CLEANUP_KEY]?.();

    const viewport = root.querySelector<HTMLElement>('[data-press-ticker-viewport]');
    const track = root.querySelector<HTMLElement>('[data-press-ticker-track]');
    if (!viewport || !track) return;

    const ac = new AbortController();
    const { signal } = ac;

    // Keep clone + original quotes in sync (both are editable so the scrolled
    // copy can be edited too; they share the same JSON path).
    const syncTwinQuote = (source: HTMLElement) => {
      const item = source.closest<HTMLElement>('[data-press-ticker-item]');
      if (!item) return;
      const sourceIndex = item.dataset.pressTickerSource;
      if (sourceIndex == null) return;
      const text = source.textContent ?? '';
      track
        .querySelectorAll<HTMLElement>(
          `[data-press-ticker-item][data-press-ticker-source="${sourceIndex}"] [data-dev-text-document]`,
        )
        .forEach((node) => {
          if (node === source) return;
          if ((node.textContent ?? '') !== text) node.textContent = text;
        });
    };

    track.addEventListener(
      'input',
      (event) => {
        const target = event.target as HTMLElement | null;
        const quote = target?.closest<HTMLElement>('[data-dev-text-document]');
        if (quote) syncTwinQuote(quote);
      },
      { signal },
    );

    // In Dev Mode, quote sits above the stretch link so caret placement works.
    // Outside Dev Mode the stretch link covers the card. Disable the hit link
    // while a quote is focused so focus/caret aren’t stolen.
    track.addEventListener(
      'pointerdown',
      (event) => {
        if (!document.documentElement.classList.contains('is-dev-mode')) return;
        const target = event.target as HTMLElement | null;
        if (!target?.closest('[data-dev-text-document]')) return;
        // Don’t let the absolute hit <a> under the quote take this gesture.
        event.stopPropagation();
      },
      { capture: true, signal },
    );

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      host[CLEANUP_KEY] = () => ac.abort();
      return;
    }

    const baseSpeed = Math.max(8, Number(root.dataset.pressTickerSpeed) || 36);
    // Positive speed = content moves right→left.
    let targetSpeed = baseSpeed;
    let speed = baseSpeed;
    // Phase 0..loopWidth maps to translateX = -phase.
    let phase = 0;
    let loopWidth = 0;
    let raf = 0;
    let lastTs = 0;
    let lastPersist = 0;
    // Soft hover pause / resume.
    const tauMs = 280;
    // Coast after flick: friction-like ease into steady auto-scroll (not a hard stop).
    const coastTauMs = 1100;
    // High enough that normal drag/trackpad flicks aren't clipped; still a safety rail.
    const maxFlickSpeed = 4500;
    const minFlickSpeed = 40;
    // Tip-of-gesture window — short enough to feel like the flick, not the whole drag.
    const sampleWindowMs = 70;
    let resumeTimer = 0;
    let wheelIdleTimer = 0;
    // Soft hover pause — armed after leave (or when cursor starts outside).
    // Drag/wheel disarms until the next leave→re-enter.
    let hoverArmed = !viewport.matches(':hover');
    let hoverPaused = false;
    let dragging = false;
    let coasting = false;
    let dragStartX = 0;
    let dragStartPhase = 0;
    let dragMoved = false;
    // Recent pointer samples for release-velocity (phase space = −pointer X).
    // Wheel reuses the same buffer via a virtual pointer so inertia matches drag.
    let samples: Array<{ t: number; x: number }> = [];
    let wheelVirtualX = 0;
    let wheelStartPhase = 0;
    let wheelGesture = false;

    const wrapPhase = (value: number) => {
      if (loopWidth <= 0) return value;
      return ((value % loopWidth) + loopWidth) % loopWidth;
    };

    const persist = () => {
      writeStoredState(root, { phase, speed, targetSpeed });
    };

    const measure = () => {
      const tickerItems = [...track.querySelectorAll<HTMLElement>('[data-press-ticker-item]')];
      const half = Math.floor(tickerItems.length / 2);
      if (half < 1) {
        loopWidth = 0;
        return;
      }
      const first = tickerItems[0].offsetLeft;
      const mid = tickerItems[half].offsetLeft;
      loopWidth = Math.max(0, mid - first);
      phase = wrapPhase(phase);
    };

    const apply = () => {
      track.style.transform = `translate3d(${-phase}px, 0, 0)`;
    };

    const pauseForUser = () => {
      targetSpeed = 0;
      window.clearTimeout(resumeTimer);
    };

    // After drag/wheel, stay-over should not keep it paused — only leave→re-enter.
    const releaseHoverPause = () => {
      hoverPaused = false;
      hoverArmed = false;
    };

    const beginCoast = (flick: number) => {
      releaseHoverPause();
      window.clearTimeout(resumeTimer);
      speed = flick;
      targetSpeed = baseSpeed;
      // Use the longer coast tau whenever we're settling from a flick (or from 0
      // back up to auto-scroll) so wheel and drag share the same feel.
      coasting = true;
    };

    const pushSample = (clientX: number) => {
      const t = performance.now();
      samples.push({ t, x: clientX });
      const cutoff = t - sampleWindowMs;
      while (samples.length > 1 && samples[0].t < cutoff) samples.shift();
    };

    const flickVelocityFromPointer = () => {
      if (samples.length < 2) return 0;
      const a = samples[0];
      const b = samples[samples.length - 1];
      const dt = b.t - a.t;
      if (dt < 8) return 0;
      // phase = startPhase − pointerX ⇒ phase velocity = −pointerVx
      const pointerVx = ((b.x - a.x) / dt) * 1000;
      let flick = -pointerVx;
      if (Math.abs(flick) < minFlickSpeed) return 0;
      return Math.max(-maxFlickSpeed, Math.min(maxFlickSpeed, flick));
    };

    const tick = (ts: number) => {
      if (!lastTs) lastTs = ts;
      const dt = Math.min(48, ts - lastTs);
      lastTs = ts;
      host[BEAT_KEY] = ts;

      const tau = coasting ? coastTauMs : tauMs;
      const alpha = 1 - Math.exp(-dt / tau);
      speed += (targetSpeed - speed) * alpha;

      if (coasting && Math.abs(speed - targetSpeed) < 0.5) {
        speed = targetSpeed;
        coasting = false;
      }

      // Finger owns phase while dragging; raf only coasts / auto-scrolls otherwise.
      if (loopWidth > 0 && Math.abs(speed) > 0.01 && !(dragging && dragMoved)) {
        phase = wrapPhase(phase + (speed * dt) / 1000);
        apply();
      }

      if (ts - lastPersist > 200) {
        lastPersist = ts;
        persist();
      }

      raf = requestAnimationFrame(tick);
    };

    // Soft hover pause — armed after leave (or when cursor starts outside).
    // Drag/wheel disarms until the next leave→re-enter.
    viewport.addEventListener(
      'pointerenter',
      () => {
        if (!hoverArmed) return;
        hoverPaused = true;
        pauseForUser();
      },
      { signal },
    );
    viewport.addEventListener(
      'pointerleave',
      () => {
        hoverArmed = true;
        hoverPaused = false;
        if (dragging) return;
        window.clearTimeout(resumeTimer);
        window.clearTimeout(wheelIdleTimer);
        targetSpeed = baseSpeed;
      },
      { signal },
    );

    // Drag / swipe to scrub with release momentum.
    // Plain clicks (open press link) do not pause — only a real drag does.
    viewport.addEventListener(
      'pointerdown',
      (event) => {
        if (event.button !== 0) return;
        // Dev Mode caret placement owns the gesture on quotes.
        if (
          document.documentElement.classList.contains('is-dev-mode') &&
          (event.target as HTMLElement | null)?.closest('[data-dev-text-document]')
        ) {
          return;
        }
        dragging = true;
        dragMoved = false;
        coasting = false;
        dragStartX = event.clientX;
        dragStartPhase = phase;
        samples = [{ t: performance.now(), x: event.clientX }];
        viewport.setPointerCapture(event.pointerId);
      },
      { signal },
    );

    viewport.addEventListener(
      'pointermove',
      (event) => {
        if (!dragging) return;
        const dx = event.clientX - dragStartX;
        if (!dragMoved) {
          if (Math.abs(dx) <= 4) return;
          dragMoved = true;
          viewport.classList.add('is-dragging');
          pauseForUser();
          speed = 0; // kill auto-scroll under the finger
          samples = [{ t: performance.now(), x: event.clientX }];
        }
        pushSample(event.clientX);
        // Drag right → reveal earlier content (phase decreases).
        phase = wrapPhase(dragStartPhase - dx);
        apply();
      },
      { signal },
    );

    const endDrag = () => {
      if (!dragging) return;
      const wasDragging = dragMoved;
      dragging = false;
      viewport.classList.remove('is-dragging');
      if (!wasDragging) {
        samples = [];
        return;
      }

      const flick = flickVelocityFromPointer();
      samples = [];
      beginCoast(flick);
    };

    viewport.addEventListener('pointerup', endDrag, { signal });
    viewport.addEventListener('pointercancel', endDrag, { signal });

    // After a drag, suppress the click so we don't open the press link.
    viewport.addEventListener(
      'click',
      (event) => {
        if (!dragMoved) return;
        event.preventDefault();
        event.stopPropagation();
        dragMoved = false;
      },
      { capture: true, signal },
    );

    // Wheel / trackpad: same virtual-pointer samples + beginCoast path as drag,
    // so release inertia matches. Coast starts on every event (no idle freeze).
    viewport.addEventListener(
      'wheel',
      (event) => {
        const absX = Math.abs(event.deltaX);
        const absY = Math.abs(event.deltaY);
        if (absX < 0.5 && absY < 0.5) return;
        const delta = absX >= absY ? event.deltaX : event.deltaY;
        event.preventDefault();

        const now = performance.now();
        if (!wheelGesture) {
          wheelGesture = true;
          wheelStartPhase = phase;
          wheelVirtualX = 0;
          // Seed slightly in the past so the first event can estimate velocity.
          samples = [{ t: now - 16, x: 0 }];
        }

        // Drag: phase = start − dx. Positive wheel delta should increase phase
        // (content moves left) ⇒ virtual pointer moves left (negative x).
        wheelVirtualX -= delta;
        pushSample(wheelVirtualX);
        phase = wrapPhase(wheelStartPhase - wheelVirtualX);
        apply();

        // Same handoff as pointerup — refresh coast velocity from shared estimator.
        // Reset lastTs so the next raf tick doesn't also step phase on top of this scrub.
        lastTs = now;
        beginCoast(flickVelocityFromPointer());

        window.clearTimeout(wheelIdleTimer);
        wheelIdleTimer = window.setTimeout(() => {
          wheelGesture = false;
          samples = [];
        }, 120);
      },
      { passive: false, signal },
    );

    // Resume across Vite full-reloads from other agents' edits: restore phase and
    // extrapolate as if auto-scroll continued during the brief reload gap.
    const stored = readStoredState(root);
    if (stored && typeof stored.phase === 'number') {
      const elapsedSec = Math.max(0, (Date.now() - (stored.wall ?? Date.now())) / 1000);
      const resumeTarget =
        typeof stored.targetSpeed === 'number' ? stored.targetSpeed : baseSpeed;
      // Don't resume into a hover-paused stop after reload — keep moving.
      targetSpeed = resumeTarget === 0 ? baseSpeed : resumeTarget;
      speed = typeof stored.speed === 'number' && stored.speed !== 0 ? stored.speed : targetSpeed;
      phase = stored.phase + targetSpeed * elapsedSec;
      hoverArmed = false;
      hoverPaused = false;
    }

    measure();
    apply();
    persist();
    host[BEAT_KEY] = performance.now();
    raf = requestAnimationFrame(tick);

    const ro = new ResizeObserver(() => {
      measure();
      apply();
    });
    ro.observe(track);
    ro.observe(viewport);

    const cleanup = () => {
      persist();
      cancelAnimationFrame(raf);
      window.clearTimeout(resumeTimer);
      window.clearTimeout(wheelIdleTimer);
      ro.disconnect();
      ac.abort();
      viewport.classList.remove('is-dragging');
      delete host[CLEANUP_KEY];
    };
    host[CLEANUP_KEY] = cleanup;

    window.addEventListener('pagehide', persist, { signal });
  };

  const boot = () => {
    document
      .querySelectorAll<HTMLElement>('[data-press-quote-ticker]')
      .forEach((node) => initPressQuoteTicker(node));
  };

  /** Restart any ticker whose rAF died after HMR without a clean re-bind. */
  const ensureTickersAlive = () => {
    if (document.hidden) return;
    const now = performance.now();
    document.querySelectorAll<HTMLElement>('[data-press-quote-ticker]').forEach((node) => {
      const host = node as TickerRoot;
      const beat = host[BEAT_KEY] ?? 0;
      const hasLoop = typeof host[CLEANUP_KEY] === 'function';
      if (!hasLoop || now - beat > 1600) {
        initPressQuoteTicker(node);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:after-swap', boot);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) ensureTickersAlive();
  });

  // One shared watchdog across HMR module re-evals.
  const previousWatch = (window as Window & { [WATCH_KEY]?: number })[WATCH_KEY];
  if (previousWatch) window.clearInterval(previousWatch);
  (window as Window & { [WATCH_KEY]?: number })[WATCH_KEY] = window.setInterval(
    ensureTickersAlive,
    1000,
  );

  if (import.meta.hot) {
    import.meta.hot.accept();
    import.meta.hot.dispose(() => {
      document.querySelectorAll<HTMLElement>('[data-press-quote-ticker]').forEach((node) => {
        (node as TickerRoot)[CLEANUP_KEY]?.();
      });
    });
    // Don't tear down a healthy loop on unrelated HMR — only revive dead ones.
    import.meta.hot.on('vite:afterUpdate', () => {
      queueMicrotask(ensureTickersAlive);
    });
  }
</script>
