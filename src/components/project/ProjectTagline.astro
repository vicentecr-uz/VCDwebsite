---
interface Props {
  text?: string;
  /** Optional inline-linked form: prefix + link + trailing period */
  prefix?: string;
  linkLabel?: string;
  linkHref?: string;
}

const { text, prefix, linkLabel, linkHref } = Astro.props;
---

<div class="project-block project-block--tight-bottom">
  <h1 class="project-tagline">
    {linkHref ? (
      <>{prefix}{' '}<a href={linkHref} target="_blank" rel="noopener noreferrer" class="project-inline-link">{linkLabel}</a>.</>
    ) : (
      text
    )}
  </h1>
</div>
