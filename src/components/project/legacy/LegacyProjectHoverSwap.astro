---
import { projectImage } from '../../../lib/images';
import { projectStackClass, type ProjectStackSpacing } from '../../../lib/projectStack';

interface Props {
  baseSrc: string;
  baseAlt?: string;
  topSrc: string;
  topAlt?: string;
  spacing?: ProjectStackSpacing;
}

const { baseSrc, baseAlt = '', topSrc, topAlt = '', spacing = 'group' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <figure class="project-hover-swap">
    <img src={projectImage(baseSrc)} alt={baseAlt} class="project-hover-swap__base" loading="lazy" />
    <img src={projectImage(topSrc)} alt={topAlt} class="project-hover-swap__top" loading="lazy" />
  </figure>
</div>
