---
import { projectImage } from '../../../lib/images';
import { projectStackClass, type ProjectStackSpacing } from '../../../lib/projectStack';

interface Item {
  src: string;
  alt?: string;
}

interface Props {
  setupSrc: string;
  setupAlt?: string;
  items: Item[];
  spacing?: ProjectStackSpacing;
}

const { setupSrc, setupAlt = '', items, spacing = 'section' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <div class="project-sketch-models">
    <figure class="project-sketch-models__setup">
      <img src={projectImage(setupSrc)} alt={setupAlt} loading="lazy" />
    </figure>
    <div class="project-sketch-models__grid">
      {items.map((item) => (
        <img src={projectImage(item.src)} alt={item.alt ?? ''} loading="lazy" />
      ))}
    </div>
  </div>
</div>
