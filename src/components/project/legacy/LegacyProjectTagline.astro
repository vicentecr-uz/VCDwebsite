---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../../lib/projectStack';

interface Props {
  text?: string;
  /** Optional inline-linked form: prefix + link + trailing period */
  prefix?: string;
  linkLabel?: string;
  linkHref?: string;
  spacing?: ProjectStackSpacing;
  document?: string;
  sectionPath?: Array<string | number>;
}

const {
  text,
  prefix,
  linkLabel,
  linkHref,
  spacing = 'section',
  document: documentKey,
  sectionPath,
} = Astro.props;
const stackClass = projectStackClass(spacing, { precedeRelated: true });
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing);
---

<div class:list={['project-block', stackClass]} {...(spacingAttrs ?? {})}>
  <h1 class="project-tagline">
    {linkHref ? (
      <>{prefix}{' '}<a href={linkHref} target="_blank" rel="noopener noreferrer" class="project-inline-link">{linkLabel}</a>.</>
    ) : (
      text
    )}
  </h1>
</div>
