---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../../lib/projectStack';

interface Props {
  cols: 2 | 3 | 5;
  spacing?: ProjectStackSpacing;
  document?: string;
  sectionPath?: Array<string | number>;
}

const { cols, spacing = 'section', document: documentKey, sectionPath } = Astro.props;
const stackClass = projectStackClass(spacing);
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing);
---

<div class:list={['project-block', stackClass]} {...(spacingAttrs ?? {})}>
  <div class:list={['project-grid', `project-grid--${cols}`]}>
    <slot />
  </div>
</div>
