---
import LegacyProjectContextImage from './LegacyProjectContextImage.astro';
import { projectStackClass, type ProjectStackSpacing } from '../../../lib/projectStack';

interface Item {
  src: string;
  alt?: string;
  caption: string;
}

interface Props {
  items: Item[];
  spacing?: ProjectStackSpacing;
}

const { items, spacing = 'group' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <div class="project-context-grid">
    {items.map((item) => (
      <LegacyProjectContextImage src={item.src} alt={item.alt} caption={item.caption} />
    ))}
  </div>
</div>
