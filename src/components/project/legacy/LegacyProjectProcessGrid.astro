---
import { projectImage } from '../../../lib/images';
import { projectStackClass, type ProjectStackSpacing } from '../../../lib/projectStack';

interface Item {
  src: string;
  alt?: string;
}

interface Props {
  items: Item[];
  spacing?: ProjectStackSpacing;
}

const { items, spacing = 'group' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <div class="project-process-grid">
    {items.map((item) => (
      <img src={projectImage(item.src)} alt={item.alt ?? ''} loading="lazy" />
    ))}
  </div>
</div>
