---
/**
 * Legacy Webflow-migration section renderer — used only by old case-study routes.
 * Signed-off case studies (e.g. Tapico) render sections in their own page file.
 */
import ProjectImageGrid from '../ProjectImageGrid.astro';
import ProjectBodyText from '../ProjectBodyText.astro';
import ProjectSectionTitle from '../ProjectSectionTitle.astro';
import ProjectImage from '../ProjectImage.astro';
import LegacyProjectTagline from './LegacyProjectTagline.astro';
import LegacyProjectProse from './LegacyProjectProse.astro';
import LegacyProjectGrid from './LegacyProjectGrid.astro';
import LegacyProjectCaptionImage from './LegacyProjectCaptionImage.astro';
import LegacyProjectDetailImage from './LegacyProjectDetailImage.astro';
import LegacyProjectSystemGrid from './LegacyProjectSystemGrid.astro';
import LegacyProjectResearchGrid from './LegacyProjectResearchGrid.astro';
import LegacyProjectTripleGrid from './LegacyProjectTripleGrid.astro';
import LegacyProjectDetailGrid from './LegacyProjectDetailGrid.astro';
import LegacyProjectReferenceGrid from './LegacyProjectReferenceGrid.astro';
import LegacyProjectProcessGrid from './LegacyProjectProcessGrid.astro';
import LegacyProjectMoodboard from './LegacyProjectMoodboard.astro';
import LegacyProjectCaptionedImage from './LegacyProjectCaptionedImage.astro';
import LegacyProjectHoverSwap from './LegacyProjectHoverSwap.astro';
import LegacyProjectContextGrid from './LegacyProjectContextGrid.astro';
import LegacyProjectLayoutSplit from './LegacyProjectLayoutSplit.astro';
import LegacyProjectSketchModels from './LegacyProjectSketchModels.astro';
import LegacyProjectVideo from './LegacyProjectVideo.astro';
import LegacyProjectFinalHero from './LegacyProjectFinalHero.astro';
import { projectImage } from '../../../lib/images';
import { projectStackClass, resolveProjectSpacing, spacingDevAttrs } from '../../../lib/projectStack';

interface Props {
  sections: any[];
  documentKey?: string;
}

const { sections, documentKey } = Astro.props;
---

{sections.map((section, sectionIndex) => {
  const spacing = resolveProjectSpacing(section.spacing, section.tightTop);
  const sectionPath = ['sections', sectionIndex];
  return (
  <>
    {section.type === 'heroImage' && (
      <ProjectImage
        src={section.src}
        alt={section.alt}
        kind="lead"
        layout={section.variant ?? 'default'}
        crop={section.crop}
        variants={section.variants}
        document={documentKey}
        path={sectionPath}
        cropId="hero"
        spacing={spacing}
      />
    )}

    {section.type === 'imageGrid' && (
      <ProjectImageGrid
        items={section.items}
        columns={section.columns ?? 2}
        defaultAspectRatio={section.defaultAspectRatio ?? '1:1'}
        constrained={section.constrained}
        layouts={section.layouts}
        matchHeight={section.matchHeight === true}
        document={documentKey}
        basePath={sectionPath}
        spacing={spacing}
      />
    )}

    {section.type === 'tagline' && (
      <LegacyProjectTagline
        text={section.text}
        prefix={section.prefix}
        linkLabel={section.linkLabel}
        linkHref={section.linkHref}
        spacing={spacing}
        document={documentKey}
        sectionPath={sectionPath}
      />
    )}

    {section.type === 'bodyText' && (
      <ProjectBodyText
        paragraphs={section.paragraphs}
        documentKey={documentKey}
        pathPrefix={documentKey ? ['sections', sectionIndex, 'paragraphs'] : undefined}
        spacing={spacing}
      />
    )}

    {section.type === 'sectionTitle' && (
      <ProjectSectionTitle
        title={section.title}
        level={section.level ?? 2}
        tightBottom={section.tightBottom ?? true}
        spacing={spacing}
        document={documentKey}
        sectionPath={sectionPath}
        showTitle={section.showTitle}
        hideWhenSidebarVisible={section.hideWhenSidebarVisible ?? false}
      />
    )}

    {section.type === 'prose' && (
      <LegacyProjectProse
        spacing={spacing}
        tightBottom={section.tightBottom ?? false}
        document={documentKey}
        sectionPath={sectionPath}
      >
        {section.heading && <h4 class="project-section-title">{section.heading}</h4>}
        {section.paragraphs.map((paragraph) => (
          <p set:html={paragraph} />
        ))}
      </LegacyProjectProse>
    )}

    {section.type === 'image' && (
      section.showMobileOnly ? (
        <div
          class:list={['project-show-mobile-only', projectStackClass(spacing, { flush: section.flush })]}
          {...(spacingDevAttrs(documentKey, sectionPath, spacing) ?? {})}
        >
          <ProjectImage
            src={section.src}
            alt={section.alt}
            variants={section.variants}
            document={documentKey}
            path={sectionPath}
            constrained={section.constrained ?? false}
            mobileHeight={section.mobileHeight}
            flush={section.flush ?? false}
            mobileShort={section.mobileShort ?? false}
            maxVh={section.maxVh}
            max80={section.max80 ?? false}
            fullHeight={section.fullHeight ?? false}
            hideMobile={section.hideMobile ?? false}
            caption={section.caption}
            captions={section.captions}
            captionStyle={section.captionStyle}
            captionPosition={section.captionPosition}
            captionReveal={section.captionReveal}
            spacing="none"
          />
        </div>
      ) : (
        <ProjectImage
          src={section.src}
          alt={section.alt}
          variants={section.variants}
          document={documentKey}
          path={sectionPath}
          constrained={section.constrained ?? false}
          centered={section.centered ?? false}
          mobileHeight={section.mobileHeight}
          flush={section.flush ?? false}
          mobileShort={section.mobileShort ?? false}
          maxVh={section.maxVh}
          max80={section.max80 ?? false}
          fullHeight={section.fullHeight ?? false}
          hideMobile={section.hideMobile ?? false}
          imgModifier={section.imgModifier}
          caption={section.caption}
          captions={section.captions}
          captionStyle={section.captionStyle}
          captionPosition={section.captionPosition}
          captionReveal={section.captionReveal}
          spacing={spacing}
        />
      )
    )}

    {section.type === 'mediaGrid' && (
      <LegacyProjectGrid
        cols={section.cols}
        spacing={spacing}
        document={documentKey}
        sectionPath={sectionPath}
      >
        {section.items.map((item) => (
          <>
            {item.style === 'caption' && (
              <LegacyProjectCaptionImage
                src={item.src}
                alt={item.alt}
                caption={item.caption}
                square={item.square ?? false}
                variant={item.captionVariant ?? 'light'}
              />
            )}

            {item.style === 'detail' && (
              <LegacyProjectDetailImage
                src={item.src}
                alt={item.alt}
                caption={item.caption}
                captionVariant={item.captionVariant ?? 'light'}
              />
            )}

            {item.style === 'cell' && (
              <figure class:list={['project-cell', item.stack && 'project-cell--stack', item.hideOnMobile && 'project-hide-mobile']}>
                <img src={projectImage(item.src)} alt={item.alt} class="project-cell__img" loading="lazy" />
              </figure>
            )}
          </>
        ))}
      </LegacyProjectGrid>
    )}

    {section.type === 'constrainedCaptionImage' && (
      <div
        class:list={['project-block', projectStackClass(spacing)]}
        {...(spacingDevAttrs(documentKey, sectionPath, spacing) ?? {})}
      >
        <figure class="project-media project-media--constrained">
          <span class:list={['project-caption', section.captionVariant === 'dark' && 'project-caption--dark', section.captionVariant === 'black' && 'project-caption--black']}>
            {section.caption}
          </span>
          <img
            src={projectImage(section.src)}
            alt={section.alt}
            class:list={['project-media__img', section.mobileHeight && `project-media__img--h${section.mobileHeight}`]}
            loading="lazy"
          />
        </figure>
      </div>
    )}

    {section.type === 'systemGrid' && (
      <LegacyProjectSystemGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'researchGrid' && (
      <LegacyProjectResearchGrid columns={section.columns} spacing={spacing} />
    )}

    {section.type === 'tripleGrid' && (
      <LegacyProjectTripleGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'detailGrid' && (
      <LegacyProjectDetailGrid
        items={section.items}
        wide={section.wide ?? false}
        square={section.square ?? false}
        showMobileOnly={section.showMobileOnly ?? false}
        spacing={spacing}
      />
    )}

    {section.type === 'referenceGrid' && (
      <LegacyProjectReferenceGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'processGrid' && (
      <LegacyProjectProcessGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'moodboard' && (
      <LegacyProjectMoodboard items={section.items} spacing={spacing} />
    )}

    {section.type === 'captionedImage' && (
      <LegacyProjectCaptionedImage
        src={section.src}
        alt={section.alt}
        caption={section.caption}
        captionPlacement={section.captionPlacement ?? 'overlay'}
        hideMobile={section.hideMobile ?? false}
        spacing={spacing}
      />
    )}

    {section.type === 'hoverSwap' && (
      <LegacyProjectHoverSwap
        baseSrc={section.baseSrc}
        baseAlt={section.baseAlt}
        topSrc={section.topSrc}
        topAlt={section.topAlt}
        spacing={spacing}
      />
    )}

    {section.type === 'contextGrid' && (
      <LegacyProjectContextGrid items={section.items} spacing={spacing} />
    )}

    {section.type === 'layoutSplit' && (
      <LegacyProjectLayoutSplit leftSrc={section.leftSrc} leftAlt={section.leftAlt} items={section.items} spacing={spacing} />
    )}

    {section.type === 'sketchModels' && (
      <LegacyProjectSketchModels setupSrc={section.setupSrc} setupAlt={section.setupAlt} items={section.items} spacing={spacing} />
    )}

    {section.type === 'video' && (
      <LegacyProjectVideo src={section.src} title={section.title} spacing={spacing} />
    )}

    {section.type === 'finalHero' && (
      <LegacyProjectFinalHero src={section.src} alt={section.alt} spacing={spacing} />
    )}
  </>
  );
})}
