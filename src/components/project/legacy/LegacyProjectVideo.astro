---
import { projectStackClass, type ProjectStackSpacing } from '../../../lib/projectStack';

interface Props {
  src: string;
  title: string;
  spacing?: ProjectStackSpacing;
}

const { src, title, spacing = 'group' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <div class="project-video">
    <iframe
      src={src}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"></iframe>
  </div>
</div>
