---
import '../../styles/dev-chrome.css';
import monitorIcon from 'lucide-static/icons/monitor.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import { sizeIcon } from '../../lib/icons';

interface Props { showAssetManager?: boolean; dropLabel?: string; }
const { showAssetManager = true, dropLabel } = Astro.props;
const monitorSvg = sizeIcon(monitorIcon, 16);
const globeSvg = sizeIcon(globeIcon, 16);
---
<div class="dev-field">
  <span class="dev-field__label">Replace image</span>
  <div class="dev-drop" data-crop-replace-drop tabindex="0" role="button" aria-label="Replace image">
    <div class="dev-drop__well">
      {dropLabel && <p class="dev-drop__label">{dropLabel}</p>}
      <span class="dev-file-picker">
        <button type="button" class="dev-btn dev-btn--ghost" data-crop-replace-choose tabindex="-1" aria-hidden="true">
          <span class="dev-btn__icon" aria-hidden="true" set:html={monitorSvg} />
          File system
        </button>
        <input type="file" accept="image/*,.heic,.heif" aria-label="File system" data-crop-replace-file />
      </span>
      {showAssetManager && <button type="button" class="dev-btn dev-btn--ghost" data-crop-replace-assets>
        <span class="dev-btn__icon" aria-hidden="true" set:html={globeSvg} />
        Asset manager
      </button>}
    </div>
  </div>
</div>

<style>
  .dev-file-picker {
    position: relative;
    display: inline-flex;
  }

  .dev-file-picker:has(> input:focus-visible) {
    outline: 2px solid var(--sys-color-outline);
    outline-offset: -2px;
    border-radius: var(--dev-radius-control);
  }

  @media (hover: hover) and (pointer: fine) {
    .dev-file-picker:has(> input:hover) > .dev-btn {
      background: var(--comp-button-ghost-container-hover);
    }
  }

  .dev-file-picker:has(> input:active) > .dev-btn {
    background: var(--comp-button-ghost-container-pressed);
    transform: scale(var(--motion-press-scale));
  }

  .dev-file-picker > input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    box-sizing: border-box;
    opacity: 0;
    cursor: pointer;
  }
</style>
