---
import DevOverlay from '../DevOverlay.astro';
---

<DevOverlay
  title="Edit grid"
  storageKey="project-image-grid"
  panelKey="grid"
  defaultHidden
>
  <div class="project-grid-tuner" data-project-image-grid-tuner>
    <div class="project-grid-tuner__viewports" aria-label="Display width">
      <button type="button" data-grid-viewport="desktop">Desktop</button>
      <button type="button" data-grid-viewport="tablet">Tablet</button>
      <button type="button" data-grid-viewport="mobile">Mobile</button>
    </div>

    <p class="project-grid-tuner__inherit" data-grid-inherit hidden>
      Inheriting from larger breakpoint — drag to create an override.
    </p>

    <label class="project-grid-tuner__select">
      <span>Columns</span>
      <select data-grid-columns>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
      </select>
    </label>

    <label class="project-grid-tuner__select">
      <span>Width</span>
      <select data-grid-constrained>
        <option value="100">Full</option>
        <option value="90">90%</option>
        <option value="80">80% (constrained)</option>
        <option value="70">70%</option>
        <option value="60">60%</option>
        <option value="50">50%</option>
        <option value="40">40%</option>
        <option value="30">30%</option>
      </select>
    </label>

    <label class="project-grid-tuner__select">
      <span>Default image aspect</span>
      <select data-grid-aspect-ratio>
        <option value="original">Original</option>
        <optgroup label="Landscape">
          <option value="16:9">16:9</option>
          <option value="16:10">16:10</option>
          <option value="3:2">3:2</option>
          <option value="4:3">4:3</option>
          <option value="5:4">5:4</option>
        </optgroup>
        <optgroup label="Square">
          <option value="1:1">1:1</option>
        </optgroup>
        <optgroup label="Portrait">
          <option value="5:6">5:6</option>
          <option value="4:5">4:5</option>
          <option value="3:4">3:4</option>
          <option value="2:3">2:3</option>
          <option value="10:16">10:16</option>
          <option value="9:16">9:16</option>
        </optgroup>
      </select>
    </label>

    <label class="project-grid-tuner__toggle">
      <input type="checkbox" data-grid-match-height />
      <span>Match row height</span>
    </label>
    <p class="project-grid-tuner__toggle-hint">
      Scale cells so each row shares one height; widths follow aspect ratios.
    </p>

    <div class="project-grid-tuner__board">
      <p class="project-grid-tuner__board-label">Visible</p>
      <div
        class="project-grid-tuner__visible"
        data-grid-visible
        data-grid-drop="visible"
      ></div>

      <p class="project-grid-tuner__board-label">Parking lot</p>
      <div
        class="project-grid-tuner__parking"
        data-grid-parking
        data-grid-drop="parking"
      >
        <span class="project-grid-tuner__parking-hint" data-grid-parking-hint>
          Drag images here to hide them at this breakpoint
        </span>
      </div>
    </div>

    <p class="project-grid-tuner__hint">
      Parking hides an image at this width only. Use Remove on a thumb to drop it from the grid while keeping the file in the asset manager.
    </p>

    <div class="project-grid-tuner__actions">
      <button type="button" data-grid-clear-override hidden>Clear override</button>
      <button type="button" data-grid-revert>Revert changes</button>
      <button type="button" data-grid-save>Save changes</button>
    </div>

    <p class="project-grid-tuner__status" data-grid-status aria-live="polite">
      Pick a grid to edit layout, columns, width, aspect, and match-height.
    </p>
  </div>
</DevOverlay>

<script>
  import { refreshProjectCropCovers } from '../../lib/projectCropCover';

  type ImageViewport = 'desktop' | 'tablet' | 'mobile';

  interface GridItem {
    id: string;
    src: string;
    alt: string;
  }

  type GridLayouts = Partial<Record<ImageViewport, { visible: string[] }>>;

  const VIEWPORTS: ImageViewport[] = ['desktop', 'tablet', 'mobile'];

  const initProjectImageGridTuner = (tuner: HTMLElement) => {
    if (tuner.dataset.initialized === 'true') return;
    tuner.dataset.initialized = 'true';

    const viewportButtons = [
      ...tuner.querySelectorAll<HTMLButtonElement>('[data-grid-viewport]'),
    ];
    const columnsSelect = tuner.querySelector<HTMLSelectElement>('[data-grid-columns]');
    const constrainedSelect = tuner.querySelector<HTMLSelectElement>('[data-grid-constrained]');
    const aspectSelect = tuner.querySelector<HTMLSelectElement>('[data-grid-aspect-ratio]');
    const matchHeightInput = tuner.querySelector<HTMLInputElement>('[data-grid-match-height]');
    const visibleBoard = tuner.querySelector<HTMLElement>('[data-grid-visible]');
    const parkingBoard = tuner.querySelector<HTMLElement>('[data-grid-parking]');
    const parkingHint = tuner.querySelector<HTMLElement>('[data-grid-parking-hint]');
    const inheritNote = tuner.querySelector<HTMLElement>('[data-grid-inherit]');
    const saveButton = tuner.querySelector<HTMLButtonElement>('[data-grid-save]');
    const revertButton = tuner.querySelector<HTMLButtonElement>('[data-grid-revert]');
    const clearOverrideButton = tuner.querySelector<HTMLButtonElement>('[data-grid-clear-override]');
    const status = tuner.querySelector<HTMLElement>('[data-grid-status]');
    const initialTarget = document.querySelector<HTMLElement>('[data-dev-grid-target]');
    if (
      !viewportButtons.length ||
      !columnsSelect ||
      !constrainedSelect ||
      !aspectSelect ||
      !matchHeightInput ||
      !visibleBoard ||
      !parkingBoard ||
      !parkingHint ||
      !inheritNote ||
      !saveButton ||
      !revertButton ||
      !clearOverrideButton ||
      !status ||
      !initialTarget
    ) return;

    const viewportForWidth = (): ImageViewport => {
      if (window.innerWidth <= 767) return 'mobile';
      if (window.innerWidth <= 991) return 'tablet';
      return 'desktop';
    };

    const readColumns = (target: HTMLElement) => {
      try {
        const parsed = JSON.parse(target.dataset.devGridColumns || '{}');
        return {
          desktop: Number(parsed.desktop) || 2,
          tablet: Number(parsed.tablet) || Number(parsed.desktop) || 2,
          mobile: Number(parsed.mobile) || Number(parsed.tablet) || Number(parsed.desktop) || 2,
        };
      } catch {
        return { desktop: 2, tablet: 2, mobile: 2 };
      }
    };

    const normalizeConstrainPercent = (value: unknown, fallback = 100): number => {
      if (value === true) return 80;
      if (value === false || value === null || value === undefined) return fallback;
      const n = Math.round(Number(value));
      if (!Number.isFinite(n) || n >= 100) return 100;
      const stepped = Math.round(n / 10) * 10;
      if (stepped < 30) return 30;
      if (stepped > 90) return 90;
      return stepped;
    };

    const readConstrained = (target: HTMLElement) => {
      try {
        const raw = target.dataset.devGridConstrained;
        if (!raw) return { desktop: 100, tablet: 100, mobile: 100 };
        const parsed = JSON.parse(raw);
        if (typeof parsed === 'boolean' || typeof parsed === 'number') {
          const percent = normalizeConstrainPercent(parsed, 100);
          return { desktop: percent, tablet: percent, mobile: percent };
        }
        const desktop = normalizeConstrainPercent(parsed?.desktop, 100);
        const tablet = parsed?.tablet === undefined
          ? desktop
          : normalizeConstrainPercent(parsed.tablet, desktop);
        const mobile = parsed?.mobile === undefined
          ? tablet
          : normalizeConstrainPercent(parsed.mobile, tablet);
        return { desktop, tablet, mobile };
      } catch {
        return { desktop: 100, tablet: 100, mobile: 100 };
      }
    };

    const readItems = (target: HTMLElement): GridItem[] => {
      try {
        const parsed = JSON.parse(target.dataset.devGridItems || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed
          .map((item) => ({
            id: String(item?.id || ''),
            src: String(item?.src || ''),
            alt: String(item?.alt || ''),
          }))
          .filter((item) => item.id && item.src);
      } catch {
        return [];
      }
    };

    const readLayouts = (target: HTMLElement): GridLayouts => {
      try {
        const parsed = JSON.parse(target.dataset.devGridLayouts || '{}');
        if (!parsed || typeof parsed !== 'object') return {};
        const layouts: GridLayouts = {};
        VIEWPORTS.forEach((viewport) => {
          const visible = parsed[viewport]?.visible;
          if (Array.isArray(visible)) {
            layouts[viewport] = { visible: visible.map(String) };
          }
        });
        return layouts;
      } catch {
        return {};
      }
    };

    const cloneLayouts = (layouts: GridLayouts): GridLayouts => {
      const next: GridLayouts = {};
      VIEWPORTS.forEach((viewport) => {
        if (layouts[viewport]?.visible) {
          next[viewport] = { visible: [...layouts[viewport]!.visible] };
        }
      });
      return next;
    };

    const resolveVisible = (
      itemIds: string[],
      layouts: GridLayouts,
      viewport: ImageViewport,
    ): { visible: string[]; overridden: boolean } => {
      let inherited = [...itemIds];
      let overridden = false;
      for (const candidate of VIEWPORTS) {
        if (layouts[candidate]?.visible) {
          const known = new Set(itemIds);
          const seen = new Set<string>();
          inherited = layouts[candidate]!.visible.filter((id) => {
            if (!known.has(id) || seen.has(id)) return false;
            seen.add(id);
            return true;
          });
          if (candidate === viewport) overridden = true;
        }
        if (candidate === viewport) break;
      }
      return { visible: inherited, overridden };
    };

    let editTarget = initialTarget;
    let catalog: GridItem[] = readItems(editTarget);
    let itemIds = catalog.map((item) => item.id);
    let selectedViewport = viewportForWidth();
    let savedColumns = readColumns(editTarget);
    let draftColumns = { ...savedColumns };
    let savedConstrained = readConstrained(editTarget);
    let draftConstrained = { ...savedConstrained };
    let savedAspect = editTarget.dataset.devGridDefaultAspect || '1:1';
    let draftAspect = savedAspect;
    let savedMatchHeight = editTarget.dataset.devGridMatchHeight === 'true'
      || editTarget.dataset.matchHeight === 'true';
    let draftMatchHeight = savedMatchHeight;
    let savedLayouts = readLayouts(editTarget);
    let draftLayouts = cloneLayouts(savedLayouts);
    let liveApply = false;
    let dragItemId: string | null = null;
    type GridBaseline = {
      columns: Record<ImageViewport, number>;
      constrained: Record<ImageViewport, number>;
      aspect: string;
      matchHeight: boolean;
      layouts: GridLayouts;
    };
    const diskBaselines = new Map<string, GridBaseline>();

    const pendingIdFor = (target: HTMLElement) => {
      const documentKey = target.dataset.devDocument || '';
      const gridPath = target.dataset.devGridPath || '[]';
      return `grid:${documentKey}:${gridPath}`;
    };

    const closePanel = () => {
      const panel = tuner.closest<HTMLElement>('[data-dev-panel-key]');
      if (!panel || panel.hidden) return;
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', {
        detail: { panel },
      }));
    };

    const snapshotBaseline = (target: HTMLElement): GridBaseline => ({
      columns: readColumns(target),
      constrained: readConstrained(target),
      aspect: target.dataset.devGridDefaultAspect || '1:1',
      matchHeight: target.dataset.devGridMatchHeight === 'true'
        || target.dataset.matchHeight === 'true',
      layouts: readLayouts(target),
    });

    const applyBaselineToTarget = (target: HTMLElement, baseline: GridBaseline) => {
      const wasLive = liveApply;
      const wasTarget = editTarget;
      editTarget = target;
      liveApply = true;
      draftColumns = { ...baseline.columns };
      draftConstrained = { ...baseline.constrained };
      draftAspect = baseline.aspect;
      draftMatchHeight = baseline.matchHeight;
      draftLayouts = cloneLayouts(baseline.layouts);
      applyColumnsLive();
      applyConstrainedLive();
      applyAspectLive();
      applyLayoutsLive();
      applyMatchHeightLive();
      liveApply = wasLive;
      editTarget = wasTarget;
    };

    const ratioCss = (aspectRatio: string) => (
      aspectRatio === 'original'
        ? 'var(--project-image-original-ratio, 1 / 1)'
        : aspectRatio.replace(':', ' / ')
    );

    const ratioNumCss = (aspectRatio: string) => {
      if (aspectRatio === 'original') {
        return 'var(--project-image-original-ratio-num, 1)';
      }
      const [widthRaw, heightRaw] = aspectRatio.split(':').map(Number);
      if (!widthRaw || !heightRaw) return '1';
      return String(widthRaw / heightRaw);
    };

    const ensureViewportOverride = () => {
      const resolved = resolveVisible(itemIds, draftLayouts, selectedViewport);
      if (!draftLayouts[selectedViewport]?.visible) {
        draftLayouts[selectedViewport] = { visible: [...resolved.visible] };
      }
    };

    const applyColumnsLive = () => {
      if (!liveApply) return;
      VIEWPORTS.forEach((viewport) => {
        editTarget.style.setProperty(
          `--project-image-grid-columns-${viewport}`,
          String(draftColumns[viewport]),
        );
      });
      editTarget.dataset.devGridColumns = JSON.stringify(draftColumns);
    };

    const applyConstrainedLive = () => {
      if (!liveApply) return;
      VIEWPORTS.forEach((viewport) => {
        editTarget.style.setProperty(
          `--project-image-grid-width-${viewport}`,
          `${draftConstrained[viewport]}%`,
        );
      });
      editTarget.dataset.devGridConstrained = JSON.stringify(draftConstrained);
    };

    const applyAspectLive = () => {
      if (!liveApply) return;
      editTarget.dataset.devGridDefaultAspect = draftAspect;
      editTarget
        .querySelectorAll<HTMLElement>('.project-image-grid__item')
        .forEach((item) => {
          item.dataset.devGridDefaultAspect = draftAspect;
          if (item.dataset.devHasOwnVariants === 'true') return;
          VIEWPORTS.forEach((viewport) => {
            item.style.setProperty(`--project-image-ratio-${viewport}`, ratioCss(draftAspect));
            item.style.setProperty(`--project-image-ratio-num-${viewport}`, ratioNumCss(draftAspect));
            item.style.setProperty(`--project-image-x-${viewport}`, '0%');
            item.style.setProperty(`--project-image-y-${viewport}`, '0%');
            item.style.setProperty(`--project-image-zoom-${viewport}`, '1');
          });
          item.dataset.devImageVariants = JSON.stringify({
            desktop: { aspectRatio: draftAspect, x: 0, y: 0, zoom: 1 },
            tablet: { aspectRatio: draftAspect, x: 0, y: 0, zoom: 1 },
            mobile: { aspectRatio: draftAspect, x: 0, y: 0, zoom: 1 },
          });
        });
      refreshProjectCropCovers(editTarget);
    };

    const applyMatchHeightLive = () => {
      if (!liveApply) return;
      editTarget.dataset.matchHeight = draftMatchHeight ? 'true' : 'false';
      editTarget.dataset.devGridMatchHeight = draftMatchHeight ? 'true' : 'false';
      editTarget.classList.toggle('project-image-grid--match-height', draftMatchHeight);
      refreshProjectCropCovers(editTarget);
    };

    const applyLayoutsLive = () => {
      if (!liveApply) return;
      editTarget.dataset.devGridLayouts = JSON.stringify(draftLayouts);
      const resolvedByViewport = Object.fromEntries(
        VIEWPORTS.map((viewport) => [viewport, resolveVisible(itemIds, draftLayouts, viewport)]),
      ) as Record<ImageViewport, { visible: string[]; overridden: boolean }>;

      editTarget.querySelectorAll<HTMLElement>('[data-grid-item-id]').forEach((figure) => {
        const id = figure.dataset.gridItemId;
        if (!id) return;
        VIEWPORTS.forEach((viewport) => {
          const visible = resolvedByViewport[viewport].visible;
          const visibleIndex = visible.indexOf(id);
          const hidden = visibleIndex < 0;
          const hiddenIds = itemIds.filter((itemId) => !visible.includes(itemId));
          const order = visibleIndex >= 0
            ? visibleIndex + 1
            : visible.length + hiddenIds.indexOf(id) + 1;
          figure.style.setProperty(`--project-image-grid-order-${viewport}`, String(order));
          if (viewport === 'desktop') figure.dataset.gridHiddenDesktop = hidden ? 'true' : 'false';
          if (viewport === 'tablet') figure.dataset.gridHiddenTablet = hidden ? 'true' : 'false';
          if (viewport === 'mobile') figure.dataset.gridHiddenMobile = hidden ? 'true' : 'false';
        });
      });
    };

    // Builds and dispatches the 'grid' pending upsert from the current saved*
    // state, shared between the tuner's own Save changes and the
    // reconciliation removeFromPage does when a layout edit is already
    // staged and an item gets removed on top of it.
    const dispatchGridUpsert = (
      target: HTMLElement,
      documentKey: string,
      gridPath: Array<string | number>,
      pendingId: string,
      baseline: GridBaseline,
    ) => {
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'grid',
          payload: {
            document: documentKey,
            path: gridPath,
            columns: { ...savedColumns },
            constrained: { ...savedConstrained },
            defaultAspectRatio: savedAspect,
            matchHeight: savedMatchHeight,
            layouts: cloneLayouts(savedLayouts),
          },
          revert: () => {
            applyBaselineToTarget(target, baseline);
            if (editTarget === target) {
              savedColumns = { ...baseline.columns };
              draftColumns = { ...baseline.columns };
              savedConstrained = { ...baseline.constrained };
              draftConstrained = { ...baseline.constrained };
              savedAspect = baseline.aspect;
              draftAspect = baseline.aspect;
              savedMatchHeight = baseline.matchHeight;
              draftMatchHeight = baseline.matchHeight;
              savedLayouts = cloneLayouts(baseline.layouts);
              draftLayouts = cloneLayouts(baseline.layouts);
              renderDraft();
            }
          },
        },
      }));
    };

    const gridStateMatchesBaseline = (baseline: GridBaseline) => (
      JSON.stringify(savedColumns) === JSON.stringify(baseline.columns)
      && JSON.stringify(savedConstrained) === JSON.stringify(baseline.constrained)
      && savedAspect === baseline.aspect
      && savedMatchHeight === baseline.matchHeight
      && JSON.stringify(savedLayouts) === JSON.stringify(baseline.layouts)
    );

    const removeFromPage = (id: string) => {
      if (itemIds.length <= 1) {
        status.textContent = 'Keep at least one image, or delete the whole section.';
        return;
      }
      const ok = window.confirm(
        'Remove this image from the page?\n\nIt stays in the asset manager so you can reuse it later.',
      );
      if (!ok) return;

      const target = editTarget;
      const documentKey = target.dataset.devDocument || '';
      let gridPath: Array<string | number> = [];
      try {
        gridPath = JSON.parse(target.dataset.devGridPath || '[]');
      } catch {
        gridPath = [];
      }
      if (!documentKey || !gridPath.length) {
        status.textContent = 'This grid is not wired for saving.';
        return;
      }

      const gridPendingId = pendingIdFor(target);
      const gridBaseline = diskBaselines.get(gridPendingId);

      // Snapshot everything the removal touches, so Revert in the page bar can
      // put the image back. The removal itself only writes to disk at Save.
      const beforeCatalog = catalog.map((item) => ({ ...item }));
      const beforeDraftLayouts = cloneLayouts(draftLayouts);
      // A layout edit staged earlier (Save changes) has to win over this
      // pre-removal snapshot on revert — otherwise Revert would leave that
      // edit half-applied instead of going all the way back to disk.
      const revertLayouts = gridBaseline ? cloneLayouts(gridBaseline.layouts) : beforeDraftLayouts;
      const removedNodes = [...target.querySelectorAll<HTMLElement>(
        `[data-grid-item-id="${CSS.escape(id)}"]`,
      )].map((node) => ({
        node,
        parent: node.parentElement,
        next: node.nextElementSibling,
      }));

      catalog = catalog.filter((item) => item.id !== id);
      itemIds = catalog.map((item) => item.id);
      target.dataset.devGridItems = JSON.stringify(catalog);

      for (const viewport of VIEWPORTS) {
        const visible = draftLayouts[viewport]?.visible;
        if (!Array.isArray(visible)) continue;
        draftLayouts[viewport] = {
          visible: visible.filter((entry) => entry !== id),
        };
      }
      savedLayouts = cloneLayouts(draftLayouts);
      target.dataset.devGridLayouts = JSON.stringify(draftLayouts);

      removedNodes.forEach(({ node }) => node.remove());

      // A layout edit staged earlier for this grid still describes a real,
      // un-disked change once the removed id is purged from its `visible`
      // lists — keep it live (re-upserted with the purge applied) instead of
      // dropping it, so the save bar's count and Save both still carry it.
      // Only drop it if purging brought it back to exactly matching disk.
      if (gridBaseline && !gridStateMatchesBaseline(gridBaseline)) {
        dispatchGridUpsert(target, documentKey, gridPath, gridPendingId, gridBaseline);
      } else {
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', {
          detail: { id: gridPendingId },
        }));
      }

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: `media-remove:${documentKey}:${target.dataset.devGridPath || '[]'}:${id}`,
          kind: 'media-remove',
          payload: {
            document: documentKey,
            action: 'removeMediaItem',
            path: gridPath,
            itemId: id,
          },
          revert: () => {
            removedNodes.forEach(({ node, parent, next }) => {
              if (!parent) return;
              if (next && next.parentElement === parent) parent.insertBefore(node, next);
              else parent.append(node);
            });
            target.dataset.devGridItems = JSON.stringify(beforeCatalog);
            target.dataset.devGridLayouts = JSON.stringify(revertLayouts);
            // Only the currently edited grid owns these closures — touching them
            // for any other target would corrupt the one on screen.
            if (editTarget === target) {
              catalog = beforeCatalog.map((item) => ({ ...item }));
              itemIds = catalog.map((item) => item.id);
              savedLayouts = cloneLayouts(revertLayouts);
              draftLayouts = cloneLayouts(revertLayouts);
              renderDraft();
            }
          },
        },
      }));

      renderDraft();
      status.textContent = 'Removed from page — Save in the page bar to write it to disk.';
    };

    const makeThumb = (item: GridItem) => {
      const wrap = document.createElement('div');
      wrap.className = 'project-grid-tuner__thumb-wrap';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'project-grid-tuner__thumb';
      button.draggable = true;
      button.dataset.gridItemId = item.id;
      button.title = item.alt || item.id;
      button.setAttribute('aria-label', item.alt || item.id);
      const image = document.createElement('img');
      image.src = item.src;
      image.alt = '';
      image.draggable = false;
      button.append(image);
      button.addEventListener('dragstart', (event) => {
        dragItemId = item.id;
        button.classList.add('is-dragging');
        event.dataTransfer?.setData('text/plain', item.id);
        if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
      });
      button.addEventListener('dragend', () => {
        dragItemId = null;
        button.classList.remove('is-dragging');
        visibleBoard.classList.remove('is-drop-target');
        parkingBoard.classList.remove('is-drop-target');
      });

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'project-grid-tuner__remove';
      removeButton.title = 'Remove from page (keep in asset manager)';
      removeButton.setAttribute('aria-label', `Remove ${item.alt || item.id} from page`);
      removeButton.textContent = 'Remove';
      removeButton.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        removeFromPage(item.id);
      });

      wrap.append(button, removeButton);
      return wrap;
    };

    const insertIdAt = (list: string[], id: string, beforeId: string | null) => {
      const without = list.filter((entry) => entry !== id);
      if (!beforeId) {
        without.push(id);
        return without;
      }
      const index = without.indexOf(beforeId);
      if (index < 0) {
        without.push(id);
        return without;
      }
      without.splice(index, 0, id);
      return without;
    };

    const moveItem = (id: string, destination: 'visible' | 'parking', beforeId: string | null) => {
      ensureViewportOverride();
      const current = [...(draftLayouts[selectedViewport]?.visible ?? [])];
      if (destination === 'parking') {
        draftLayouts[selectedViewport] = {
          visible: current.filter((entry) => entry !== id),
        };
      } else {
        draftLayouts[selectedViewport] = {
          visible: insertIdAt(current, id, beforeId),
        };
      }
      renderDraft();
      status.textContent = destination === 'parking'
        ? `Hidden on ${selectedViewport} — unsaved changes.`
        : `Rearranged on ${selectedViewport} — unsaved changes.`;
    };

    const bindDropZone = (zone: HTMLElement, destination: 'visible' | 'parking') => {
      zone.addEventListener('dragover', (event) => {
        if (!dragItemId) return;
        event.preventDefault();
        zone.classList.add('is-drop-target');
        if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
      });
      zone.addEventListener('dragleave', (event) => {
        if (event.target === zone) zone.classList.remove('is-drop-target');
      });
      zone.addEventListener('drop', (event) => {
        event.preventDefault();
        zone.classList.remove('is-drop-target');
        const id = dragItemId || event.dataTransfer?.getData('text/plain');
        if (!id) return;
        const overThumb = (event.target as HTMLElement | null)
          ?.closest<HTMLElement>('.project-grid-tuner__thumb');
        const beforeId = destination === 'visible' && overThumb && overThumb.dataset.gridItemId !== id
          ? overThumb.dataset.gridItemId || null
          : null;
        moveItem(id, destination, beforeId);
      });
    };

    bindDropZone(visibleBoard, 'visible');
    bindDropZone(parkingBoard, 'parking');

    const renderBoard = () => {
      const resolved = resolveVisible(itemIds, draftLayouts, selectedViewport);
      const visibleSet = new Set(resolved.visible);
      const byId = new Map(catalog.map((item) => [item.id, item]));

      visibleBoard.style.setProperty(
        '--project-grid-tuner-columns',
        String(draftColumns[selectedViewport]),
      );
      visibleBoard.dataset.gridColumns = String(draftColumns[selectedViewport]);
      visibleBoard.replaceChildren(
        ...resolved.visible
          .map((id) => byId.get(id))
          .filter((item): item is GridItem => !!item)
          .map(makeThumb),
      );

      const parked = itemIds
        .filter((id) => !visibleSet.has(id))
        .map((id) => byId.get(id))
        .filter((item): item is GridItem => !!item);

      parkingBoard.replaceChildren(
        parkingHint,
        ...parked.map(makeThumb),
      );
      parkingHint.hidden = parked.length > 0;

      inheritNote.hidden = selectedViewport === 'desktop' || resolved.overridden;
      clearOverrideButton.hidden = selectedViewport === 'desktop' || !resolved.overridden;
    };

    const renderDraft = () => {
      viewportButtons.forEach((button) => {
        const active = button.dataset.gridViewport === selectedViewport;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      columnsSelect.value = String(draftColumns[selectedViewport]);
      constrainedSelect.value = String(draftConstrained[selectedViewport]);
      aspectSelect.value = draftAspect;
      matchHeightInput.checked = draftMatchHeight;
      renderBoard();
      applyColumnsLive();
      applyConstrainedLive();
      applyAspectLive();
      applyLayoutsLive();
      applyMatchHeightLive();
    };

    const selectTarget = (target: HTMLElement, live: boolean) => {
      editTarget = target;
      liveApply = live;
      catalog = readItems(editTarget);
      itemIds = catalog.map((item) => item.id);
      selectedViewport = viewportForWidth();
      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, snapshotBaseline(target));
      }
      savedColumns = readColumns(editTarget);
      draftColumns = { ...savedColumns };
      savedConstrained = readConstrained(editTarget);
      draftConstrained = { ...savedConstrained };
      savedAspect = editTarget.dataset.devGridDefaultAspect || '1:1';
      draftAspect = savedAspect;
      savedMatchHeight = editTarget.dataset.devGridMatchHeight === 'true'
        || editTarget.dataset.matchHeight === 'true';
      draftMatchHeight = savedMatchHeight;
      savedLayouts = readLayouts(editTarget);
      draftLayouts = cloneLayouts(savedLayouts);
      renderDraft();
      if (live) status.textContent = 'Editing this grid. Drag thumbnails to rearrange or park.';
    };

    const saveDraft = () => {
      const target = editTarget;
      const documentKey = target.dataset.devDocument;
      let gridPath: Array<string | number> = [];
      try {
        gridPath = JSON.parse(target.dataset.devGridPath || '[]');
      } catch {
        gridPath = [];
      }
      if (!documentKey || !Array.isArray(gridPath) || !gridPath.length) {
        status.textContent = 'This grid is not wired for saving.';
        return;
      }

      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, {
          columns: { ...savedColumns },
          constrained: { ...savedConstrained },
          aspect: savedAspect,
          matchHeight: savedMatchHeight,
          layouts: cloneLayouts(savedLayouts),
        });
      }
      const baseline = structuredClone(diskBaselines.get(pendingId)!);

      liveApply = true;
      applyColumnsLive();
      applyConstrainedLive();
      applyAspectLive();
      applyLayoutsLive();
      applyMatchHeightLive();

      savedColumns = { ...draftColumns };
      savedConstrained = { ...draftConstrained };
      savedAspect = draftAspect;
      savedMatchHeight = draftMatchHeight;
      savedLayouts = cloneLayouts(draftLayouts);

      dispatchGridUpsert(target, documentKey, gridPath, pendingId, baseline);

      status.textContent = 'Staged — use Save in the page bar to write to disk.';
      closePanel();
    };

    window.addEventListener('vcd:dev-edit-open', ((event: CustomEvent) => {
      const trigger = event.detail?.trigger as HTMLElement | undefined;
      if (trigger?.dataset.devEditTrigger !== 'grid') return;
      const target = trigger.closest<HTMLElement>('[data-dev-grid-target]');
      if (target) selectTarget(target, true);
    }) as EventListener);

    window.addEventListener('vcd:dev-edit-close', ((event: CustomEvent) => {
      const trigger = event.detail?.trigger as HTMLElement | undefined;
      if (trigger?.dataset.devEditTrigger === 'grid') liveApply = false;
    }) as EventListener);

    selectTarget(initialTarget, false);

    viewportButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const viewport = button.dataset.gridViewport as ImageViewport | undefined;
        if (!viewport || viewport === selectedViewport) return;
        selectedViewport = viewport;
        renderDraft();
        const resolved = resolveVisible(itemIds, draftLayouts, selectedViewport);
        status.textContent = resolved.overridden
          ? `Editing ${selectedViewport} override.`
          : `Editing ${selectedViewport} (inheriting until you rearrange).`;
      });
    });

    columnsSelect.addEventListener('change', () => {
      draftColumns[selectedViewport] = Number(columnsSelect.value) || 1;
      renderDraft();
      status.textContent = 'Column count changed — unsaved changes.';
    });

    constrainedSelect.addEventListener('change', () => {
      draftConstrained[selectedViewport] = normalizeConstrainPercent(constrainedSelect.value, 100);
      renderDraft();
      const percent = draftConstrained[selectedViewport];
      status.textContent = percent >= 100
        ? `Full width on ${selectedViewport} — unsaved changes.`
        : `Constrained to ${percent}% on ${selectedViewport} — unsaved changes.`;
    });

    aspectSelect.addEventListener('change', () => {
      draftAspect = aspectSelect.value;
      renderDraft();
      status.textContent = 'Default aspect changed — unsaved changes.';
    });

    matchHeightInput.addEventListener('change', () => {
      draftMatchHeight = matchHeightInput.checked;
      renderDraft();
      status.textContent = draftMatchHeight
        ? 'Match row height on — unsaved changes.'
        : 'Match row height off — unsaved changes.';
    });

    clearOverrideButton.addEventListener('click', () => {
      if (selectedViewport === 'desktop') return;
      delete draftLayouts[selectedViewport];
      renderDraft();
      status.textContent = `Cleared ${selectedViewport} override — now inheriting.`;
    });

    saveButton.addEventListener('click', saveDraft);

    revertButton.addEventListener('click', () => {
      draftColumns = { ...savedColumns };
      draftConstrained = { ...savedConstrained };
      draftAspect = savedAspect;
      draftMatchHeight = savedMatchHeight;
      draftLayouts = cloneLayouts(savedLayouts);
      renderDraft();
      status.textContent = 'Reverted to the last saved grid settings.';
    });

    window.addEventListener('vcd:dev-pending-committed', (() => {
      diskBaselines.clear();
      if (editTarget) {
        diskBaselines.set(pendingIdFor(editTarget), {
          columns: { ...savedColumns },
          constrained: { ...savedConstrained },
          aspect: savedAspect,
          matchHeight: savedMatchHeight,
          layouts: cloneLayouts(savedLayouts),
        });
      }
    }) as EventListener);

    window.addEventListener('vcd:dev-pending-reverted', (() => {
      diskBaselines.clear();
    }) as EventListener);
  };

  document
    .querySelectorAll<HTMLElement>('[data-project-image-grid-tuner]')
    .forEach(initProjectImageGridTuner);
</script>

