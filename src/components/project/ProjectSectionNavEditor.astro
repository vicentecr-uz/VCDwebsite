---
/**
 * DEV Section Editor — outline markers (Obsidian-style ranges).
 * Enter with Alt+D while Dev Mode is on; Esc returns to Dev Mode.
 *
 * - Section group = Intro / Research / Development (boundary)
 * - Section = Overview / Public Reception / … (scroll target + range)
 * A section owns page blocks from its start until the next section or group.
 */
import DevOverlay from '../DevOverlay.astro';
---

<div class="section-nav-editor" data-section-nav-editor hidden>
  <div class="section-nav-editor__hint" data-nav-hint hidden>
    <span data-nav-hint-text>
      Click a block → section group and/or section · Esc closes marker · Esc again → Dev Mode
    </span>
  </div>

  <DevOverlay title="Outline marker" storageKey="section-nav-marker" panelKey="section-nav" defaultHidden>
    <div class="section-nav-editor__popover" data-nav-popover>
      <p class="section-nav-editor__belongs" data-nav-belongs hidden></p>

      <div class="section-nav-editor__group">
        <label class="dev-toggle">
          <span class="dev-toggle__box">
            <input type="checkbox" class="dev-toggle__checkbox" data-nav-as-group />
            <svg class="dev-toggle__check" viewBox="0 0 16 16" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="1.667" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3.5 8.5l3 3 6-6" />
            </svg>
          </span>
          <span class="dev-toggle__label">Section group</span>
        </label>
        <div class="section-nav-editor__field dev-field" data-nav-group-label-wrap>
          <div class="dev-field__value">
            <input type="text" class="dev-field__input" data-nav-group-label maxlength="120"
                   autocomplete="off" placeholder="Group name" aria-label="Group name" />
          </div>
        </div>
      </div>

      <div class="section-nav-editor__group">
        <label class="dev-toggle">
          <span class="dev-toggle__box">
            <input type="checkbox" class="dev-toggle__checkbox" data-nav-as-section />
            <svg class="dev-toggle__check" viewBox="0 0 16 16" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="1.667" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3.5 8.5l3 3 6-6" />
            </svg>
          </span>
          <span class="dev-toggle__label">Section</span>
        </label>
        <div class="section-nav-editor__field dev-field" data-nav-section-label-wrap>
          <div class="dev-field__value">
            <input type="text" class="dev-field__input" data-nav-section-label maxlength="120"
                   autocomplete="off" placeholder="Section name" aria-label="Section name" />
          </div>
        </div>
      </div>

      <div class="section-nav-editor__title-vis" data-nav-title-vis hidden>
        <p class="section-nav-editor__subtitle">Show in-page title</p>
        <div class="section-nav-editor__chips dev-segmented" role="group" aria-label="Title visibility">
          <button type="button" class="dev-btn dev-btn--ghost dev-btn--fill" data-title-bp="desktop" aria-pressed="true">Desktop</button>
          <button type="button" class="dev-btn dev-btn--ghost dev-btn--fill" data-title-bp="tablet" aria-pressed="true">Tablet</button>
          <button type="button" class="dev-btn dev-btn--ghost dev-btn--fill" data-title-bp="mobile" aria-pressed="true">Mobile</button>
        </div>
        <button type="button" class="section-nav-editor__preset dev-btn dev-btn--ghost dev-btn--fill" data-nav-hide-sidebar>
          Hide when sidebar shows
        </button>
      </div>

      <div class="section-nav-editor__actions dev-panel-actions">
        <button type="button" class="dev-btn dev-btn--ghost" data-nav-cancel>Cancel</button>
        <button type="button" class="section-nav-editor__save dev-btn dev-btn--filled" data-nav-apply>Apply</button>
      </div>
      <p class="section-nav-editor__status" data-nav-status hidden></p>
    </div>
  </DevOverlay>
</div>

<script>
  import {
    getDevSectionOutline,
    initDevSectionOutlineSync,
    setDevSectionOutline,
    syncDevSectionOutlineSidebar,
  } from '../../scripts/devSectionOutlineSync';
  import {
    outlineAnchorId as sharedOutlineAnchorId,
    insertOutlineEntriesAtPagePosition,
    reorderOutlinePreservingGroups,
    type OutlineEntry as SharedOutlineEntry,
  } from '../../lib/projectOutline';
  type OutlineGroup = {
    kind: 'group';
    id: string;
    label: string;
    defaultOpen?: boolean;
    anchor?: string;
  };
  type OutlineSection = {
    kind: 'section';
    id: string;
    label: string;
    anchor?: string;
  };
  type OutlineEntry = OutlineGroup | OutlineSection;
  type NavLink = { id: string; label: string };
  type NavGroup = { label: string; children: NavLink[]; defaultOpen?: boolean };
  type NavItem = NavLink | NavGroup;
  type ShowTitle = { desktop: boolean; tablet: boolean; mobile: boolean };

  const EDITOR_CLASS = 'show-section-nav-editor';

  const slugify = (label: string) => {
    const base = label
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
    return base || `section-${Date.now().toString(36)}`;
  };

  const parseJson = <T,>(raw: string | undefined, fallback: T): T => {
    if (!raw) return fallback;
    try {
      return JSON.parse(raw) as T;
    } catch {
      return fallback;
    }
  };

  const sectionIndexFromPath = (pathRaw: string | undefined) => {
    const path = parseJson<Array<string | number>>(pathRaw, []);
    if (path[0] !== 'sections' || typeof path[1] !== 'number') return null;
    return path[1];
  };

  const outlineAnchorId = (entry: OutlineEntry) =>
    sharedOutlineAnchorId(entry as SharedOutlineEntry);

  const deriveNavFromOutline = (outline: OutlineEntry[]): NavItem[] => {
    const nav: NavItem[] = [];
    let current: NavGroup | null = null;
    for (const entry of outline) {
      if (entry.kind === 'group') {
        current = {
          label: entry.label,
          children: [],
          defaultOpen: entry.defaultOpen !== false,
        };
        nav.push(current);
        continue;
      }
      const link = { id: outlineAnchorId(entry), label: entry.label };
      if (current) current.children.push(link);
      else nav.push(link);
    }
    return nav;
  };

  const initSectionNavEditor = () => {
    const root = document.querySelector<HTMLElement>('[data-section-nav-root]');
    const shell = document.querySelector<HTMLElement>('[data-section-nav-editor]');
    if (!root || !shell) return;

    const documentKey = root.dataset.sectionNavDocument?.trim();
    if (!documentKey) return;

    initDevSectionOutlineSync();

    const mainScope = '[data-section-nav-main]';
    const outlineOnly = root.dataset.sectionNavOutlineOnly === 'true';

    const isEditableBlock = (el: Element | null): el is HTMLElement => {
      if (!(el instanceof HTMLElement)) return false;
      if (!el.closest(mainScope)) return false;
      if (el.classList.contains('section-block') && el.id) return true;
      return sectionIndexFromPath(el.dataset.devSpacingPath) !== null;
    };

    const popover = shell.querySelector<HTMLElement>('[data-nav-popover]');
    const popoverPanel = shell.querySelector<HTMLElement>('[data-dev-panel-key="section-nav"]');
    const hint = shell.querySelector<HTMLElement>('[data-nav-hint]');
    const asGroupInput = shell.querySelector<HTMLInputElement>('[data-nav-as-group]');
    const asSectionInput = shell.querySelector<HTMLInputElement>('[data-nav-as-section]');
    const groupLabelInput = shell.querySelector<HTMLInputElement>('[data-nav-group-label]');
    const sectionLabelInput = shell.querySelector<HTMLInputElement>('[data-nav-section-label]');
    const groupLabelWrap = shell.querySelector<HTMLElement>('[data-nav-group-label-wrap]');
    const sectionLabelWrap = shell.querySelector<HTMLElement>('[data-nav-section-label-wrap]');
    const belongsEl = shell.querySelector<HTMLElement>('[data-nav-belongs]');
    const titleVis = shell.querySelector<HTMLElement>('[data-nav-title-vis]');
    const statusEl = shell.querySelector<HTMLElement>('[data-nav-status]');
    const applyBtn = shell.querySelector<HTMLButtonElement>('[data-nav-apply]');
    const cancelBtn = shell.querySelector<HTMLButtonElement>('[data-nav-cancel]');
    const hideSidebarBtn = shell.querySelector<HTMLButtonElement>('[data-nav-hide-sidebar]');

    if (
      !popover ||
      !popoverPanel ||
      !hint ||
      !asGroupInput ||
      !asSectionInput ||
      !groupLabelInput ||
      !sectionLabelInput ||
      !groupLabelWrap ||
      !sectionLabelWrap ||
      !belongsEl ||
      !titleVis ||
      !statusEl ||
      !applyBtn ||
      !cancelBtn ||
      !hideSidebarBtn
    ) {
      return;
    }

    /**
     * DevOverlay persists its own dragged position under this key (see
     * DevOverlay.astro's `positionStorageKey`) — absence means "never dragged",
     * which is when we anchor near the clicked block instead of reusing the panel's
     * last spot.
     */
    const OVERLAY_POSITION_KEY = 'devOverlay:section-nav-marker:position';
    const hasStoredPopoverPosition = () => {
      try {
        return Boolean(window.localStorage.getItem(OVERLAY_POSITION_KEY));
      } catch {
        return false;
      }
    };

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    const headerClearance = () => {
      const header = document.querySelector<HTMLElement>('.site-header');
      const bottom = header?.getBoundingClientRect().bottom ?? 0;
      return Math.max(12, bottom + 8);
    };

    const setPopoverPosition = (left: number, top: number) => {
      const pad = 12;
      const width = popoverPanel.offsetWidth || Math.min(300, window.innerWidth - pad * 2);
      const height = popoverPanel.offsetHeight || 0;
      const maxLeft = Math.max(pad, window.innerWidth - width - pad);
      const maxTop = Math.max(headerClearance(), window.innerHeight - height - pad);
      const nextLeft = clamp(left, pad, maxLeft);
      const nextTop = clamp(top, headerClearance(), maxTop);
      popoverPanel.style.left = `${nextLeft}px`;
      popoverPanel.style.top = `${nextTop}px`;
      popoverPanel.style.right = 'auto';
      popoverPanel.style.bottom = 'auto';
    };

    let outline = getDevSectionOutline();

    const replaceOutline = (next: OutlineEntry[]) => {
      outline.length = 0;
      outline.push(...next);
    };

    let activeBlock: HTMLElement | null = null;
    let hoverBlock: HTMLElement | null = null;
    let dirty = false;
    let pendingSectionIds: Record<string, string | null> = {};
    let pendingShowTitles: Record<string, ShowTitle> = {};
    /** Last saved (or session-start) outline — the save bar's Revert goes here. */
    let baselineOutline: OutlineEntry[] = [];
    let baselineBlockIds: Array<{ pageIndex: number; id: string | null }> = [];
    let baselineShowTitles: Record<string, ShowTitle> = {};

    const isActive = () =>
      document.documentElement.classList.contains(EDITOR_CLASS) &&
      document.documentElement.classList.contains('is-dev-mode');

    const cloneOutline = (entries: OutlineEntry[]) =>
      JSON.parse(JSON.stringify(entries)) as OutlineEntry[];

    /**
     * One entry per document, so a session of marker edits coalesces into a single
     * pending change rather than one per Apply. The payload is re-snapshotted on
     * every edit, which is what keeps it current — `outline` is mutated in place.
     */
    const pendingId = `section-nav:${documentKey}`;

    const setDirty = (next: boolean) => {
      dirty = next;
      if (!next) {
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', {
          detail: { id: pendingId },
        }));
        return;
      }
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'section-nav',
          payload: {
            document: documentKey,
            outline: cloneOutline(outline),
            ...(Object.keys(pendingSectionIds).length
              ? { sectionIds: { ...pendingSectionIds } }
              : {}),
            ...(Object.keys(pendingShowTitles).length
              ? { showTitles: { ...pendingShowTitles } }
              : {}),
          },
          revert: () => discardToBaseline(),
        },
      }));
    };

    const captureBaseline = () => {
      baselineOutline = cloneOutline(outline);
      baselineBlockIds = editableBlocks().map((block, pageIndex) => ({
        pageIndex,
        id: block.id || null,
      }));
      baselineShowTitles = {};
      editableBlocks().forEach((block) => {
        const index = blockContentIndex(block);
        if (index === null || block.dataset.devSectionTitle !== 'true') return;
        baselineShowTitles[String(index)] = readShowTitle(block);
      });
    };

    const discardToBaseline = () => {
      replaceOutline(cloneOutline(baselineOutline));
      setDevSectionOutline(outline);

      const blocks = editableBlocks();
      baselineBlockIds.forEach(({ pageIndex, id }) => {
        const block = blocks[pageIndex];
        if (!block) return;
        if (id) {
          block.id = id;
          block.classList.add('section-block');
        } else {
          block.removeAttribute('id');
          block.classList.remove('section-block');
        }
      });

      Object.entries(baselineShowTitles).forEach(([indexKey, showTitle]) => {
        const block = blocks.find((el) => String(blockContentIndex(el)) === indexKey);
        if (block) applyShowTitleClasses(block, showTitle);
      });

      pendingSectionIds = {};
      pendingShowTitles = {};
      syncSidebarDom();
      setDirty(false);
    };

    const editableBlocks = () =>
      [
        ...document.querySelectorAll<HTMLElement>(`${mainScope} [data-dev-spacing-path]`),
        ...document.querySelectorAll<HTMLElement>(`${mainScope} .section-block[id]`),
      ].filter((el, index, all) => all.indexOf(el) === index && isEditableBlock(el));

    const findBlockById = (id: string) =>
      editableBlocks().find((el) => el.id === id) ??
      document.querySelector<HTMLElement>(`${mainScope} #${CSS.escape(id)}`);

    const blockContentIndex = (block: HTMLElement) => {
      if (outlineOnly) return null;
      return sectionIndexFromPath(block.dataset.devSpacingPath);
    };

    const pageIndexForId = (id: string) => {
      if (!id) return Number.POSITIVE_INFINITY;
      const blocks = editableBlocks();
      const byId = blocks.findIndex((el) => el.id === id);
      if (byId >= 0) return byId;
      const el = document.getElementById(id);
      if (!(el instanceof HTMLElement)) return Number.POSITIVE_INFINITY;
      const idx = blocks.indexOf(el);
      return idx >= 0 ? idx : Number.POSITIVE_INFINITY;
    };

    const sortOutlineByPageOrder = (entries: OutlineEntry[]) =>
      reorderOutlinePreservingGroups(
        entries as SharedOutlineEntry[],
        pageIndexForId,
      ) as OutlineEntry[];

    const owningSectionForBlock = (block: HTMLElement) => {
      const blocks = editableBlocks();
      const blockIndex = blocks.indexOf(block);
      if (blockIndex < 0) {
        return { group: null as OutlineGroup | null, section: null as OutlineSection | null };
      }

      const sorted = sortOutlineByPageOrder(outline);
      let group: OutlineGroup | null = null;
      let section: OutlineSection | null = null;
      for (const entry of sorted) {
        const pageIndex =
          entry.kind === 'group'
            ? pageIndexForId(entry.anchor?.trim() || entry.id)
            : pageIndexForId(outlineAnchorId(entry));
        if (pageIndex > blockIndex) break;
        if (entry.kind === 'group') {
          group = entry;
          section = null;
        } else {
          section = entry;
        }
      }
      return { group, section };
    };

    const clearRangeHighlights = () => {
      editableBlocks().forEach((el) => el.classList.remove('is-section-nav-in-range'));
    };

    const highlightSectionRange = (sectionEntry: OutlineSection | null) => {
      clearRangeHighlights();
      if (!sectionEntry) return;
      const start = pageIndexForId(outlineAnchorId(sectionEntry));
      if (!Number.isFinite(start)) return;
      const sorted = sortOutlineByPageOrder(outline);
      const sectionPos = sorted.findIndex(
        (entry) => entry.kind === 'section' && entry.id === sectionEntry.id,
      );
      let end = editableBlocks().length;
      for (let i = sectionPos + 1; i < sorted.length; i += 1) {
        const next = sorted[i];
        const pageIndex =
          next.kind === 'group'
            ? pageIndexForId(next.anchor?.trim() || next.id)
            : pageIndexForId(outlineAnchorId(next));
        if (pageIndex > start) {
          end = pageIndex;
          break;
        }
      }
      editableBlocks().forEach((el, index) => {
        if (index >= start && index < end) el.classList.add('is-section-nav-in-range');
      });
    };

    const writeRootDatasets = () => {
      const nav = deriveNavFromOutline(outline);
      root.dataset.sectionOutline = JSON.stringify(outline);
      root.dataset.sectionNav = JSON.stringify(nav);
    };

    const uniqueId = (preferred: string, used: Set<string>) => {
      let candidate = preferred;
      let n = 2;
      while (used.has(candidate)) {
        candidate = `${preferred}-${n}`;
        n += 1;
      }
      return candidate;
    };

    const collectUsedIds = () => {
      const ids = new Set<string>();
      for (const entry of outline) ids.add(entry.id);
      return ids;
    };

    const entriesForBlock = (block: HTMLElement) => {
      const id = block.id;
      if (!id) return [] as OutlineEntry[];
      return outline.filter((entry) => outlineAnchorId(entry) === id);
    };

    const readShowTitle = (block: HTMLElement): ShowTitle => {
      const parsed = parseJson<Partial<ShowTitle> | null>(block.dataset.devShowTitle, null);
      return {
        desktop: parsed?.desktop ?? !block.classList.contains('project-section-title--hide-desktop'),
        tablet: parsed?.tablet ?? !block.classList.contains('project-section-title--hide-tablet'),
        mobile: parsed?.mobile ?? !block.classList.contains('project-section-title--hide-mobile'),
      };
    };

    const applyShowTitleClasses = (block: HTMLElement, showTitle: ShowTitle) => {
      block.classList.toggle('project-section-title--hide-desktop', !showTitle.desktop);
      block.classList.toggle('project-section-title--hide-tablet', !showTitle.tablet);
      block.classList.toggle('project-section-title--hide-mobile', !showTitle.mobile);
      block.classList.toggle('project-section-title--hide-when-sidebar', !showTitle.desktop);
      block.dataset.devShowTitle = JSON.stringify(showTitle);
    };

    const setTitleChip = (bp: keyof ShowTitle, on: boolean) => {
      const button = titleVis.querySelector<HTMLButtonElement>(`[data-title-bp="${bp}"]`);
      if (!button) return;
      button.setAttribute('aria-pressed', on ? 'true' : 'false');
      button.classList.toggle('is-on', on);
    };

    const readTitleChips = (): ShowTitle => ({
      desktop: titleVis.querySelector('[data-title-bp="desktop"]')?.getAttribute('aria-pressed') === 'true',
      tablet: titleVis.querySelector('[data-title-bp="tablet"]')?.getAttribute('aria-pressed') === 'true',
      mobile: titleVis.querySelector('[data-title-bp="mobile"]')?.getAttribute('aria-pressed') === 'true',
    });

    const setStatus = (message: string, isError = false) => {
      statusEl.hidden = !message;
      statusEl.textContent = message;
      statusEl.classList.toggle('is-error', isError);
    };

    const syncMarkerFields = () => {
      groupLabelWrap.hidden = !asGroupInput.checked;
      sectionLabelWrap.hidden = !asSectionInput.checked;
      groupLabelInput.disabled = !asGroupInput.checked;
      sectionLabelInput.disabled = !asSectionInput.checked;
    };

    /** Clears marker-editing state without touching the panel's hidden flag — shared
     * by closePopover and the DevOverlay traffic-light Hide button, which hides the
     * panel itself before this code ever finds out. */
    const clearPopoverState = () => {
      activeBlock?.classList.remove('is-section-nav-active');
      activeBlock = null;
      clearRangeHighlights();
      setStatus('');
    };

    const closePopover = () => {
      popoverPanel.hidden = true;
      clearPopoverState();
    };

    // DevOverlay's own traffic-light Hide button closes the panel directly and
    // only announces it afterwards — catch that path too, or activeBlock/highlight
    // state is left dangling on the page.
    window.addEventListener('vcd:dev-edit-close', ((event: CustomEvent<{ panel?: HTMLElement }>) => {
      if (event.detail?.panel?.dataset.devPanelKey !== 'section-nav') return;
      clearPopoverState();
    }) as EventListener);

    const anchorPopoverNearBlock = (block: HTMLElement) => {
      const pad = 12;
      const width = popoverPanel.offsetWidth || Math.min(300, window.innerWidth - pad * 2);
      const rect = block.getBoundingClientRect();
      const minTop = headerClearance();
      const left = clamp(rect.left, pad, window.innerWidth - width - pad);
      let top = rect.bottom + 8;

      popoverPanel.style.left = `${left}px`;
      popoverPanel.style.top = `${top}px`;
      popoverPanel.style.right = 'auto';
      popoverPanel.style.bottom = 'auto';

      requestAnimationFrame(() => {
        const popRect = popoverPanel.getBoundingClientRect();
        if (popRect.bottom > window.innerHeight - pad || popRect.top < minTop) {
          top = rect.top - popRect.height - 8;
          if (top < minTop) {
            top = minTop;
          }
          setPopoverPosition(left, top);
        }
      });
    };

    const suggestGroupLabel = () => 'Intro';
    const suggestSectionLabel = (block: HTMLElement) => {
      const title = block.querySelector('.project-section-title')?.textContent?.trim();
      if (title) return title;
      const img = block.querySelector('img');
      if (img?.alt?.trim()) {
        const alt = img.alt.trim();
        return alt.length > 40 ? `${alt.slice(0, 37)}…` : alt;
      }
      return 'Overview';
    };

    const openPopover = (block: HTMLElement) => {
      activeBlock?.classList.remove('is-section-nav-active');
      activeBlock = block;
      block.classList.add('is-section-nav-active');

      const markers = entriesForBlock(block);
      const groupMarker = markers.find((entry) => entry.kind === 'group');
      const sectionMarker = markers.find((entry) => entry.kind === 'section');

      asGroupInput.checked = Boolean(groupMarker);
      asSectionInput.checked = Boolean(sectionMarker);
      // Only fill labels for active markers — suggestions appear when the box is checked.
      groupLabelInput.value = groupMarker?.label || '';
      sectionLabelInput.value = sectionMarker?.label || '';
      syncMarkerFields();

      const owned = owningSectionForBlock(block);
      if (owned.section && !sectionMarker) {
        const groupBit = owned.group ? `${owned.group.label} › ` : '';
        belongsEl.hidden = false;
        belongsEl.textContent = `Already in range: ${groupBit}${owned.section.label} (no extra marker needed)`;
        highlightSectionRange(owned.section);
      } else if (sectionMarker) {
        belongsEl.hidden = false;
        belongsEl.textContent = 'This section covers blocks below until the next section or group.';
        highlightSectionRange(sectionMarker);
      } else {
        belongsEl.hidden = true;
        clearRangeHighlights();
      }

      const isTitle = block.dataset.devSectionTitle === 'true';
      titleVis.hidden = !isTitle;
      if (isTitle) {
        const showTitle = readShowTitle(block);
        setTitleChip('desktop', showTitle.desktop);
        setTitleChip('tablet', showTitle.tablet);
        setTitleChip('mobile', showTitle.mobile);
      }

      setStatus('');
      popoverPanel.hidden = false;
      if (!hasStoredPopoverPosition()) {
        anchorPopoverNearBlock(block);
      }
      if (asGroupInput.checked) {
        groupLabelInput.focus();
        groupLabelInput.select();
      } else if (asSectionInput.checked) {
        sectionLabelInput.focus();
        sectionLabelInput.select();
      }
    };

    const applyBlockSectionId = (block: HTMLElement, id: string | null) => {
      if (id) {
        block.id = id;
        block.classList.add('section-block');
      } else {
        const stillUsed = outline.some((entry) => outlineAnchorId(entry) === block.id);
        if (!stillUsed) {
          block.removeAttribute('id');
          block.classList.remove('section-block');
        }
      }
    };

    const syncSidebarDom = () => {
      replaceOutline(sortOutlineByPageOrder(outline));
      setDevSectionOutline(outline);
      syncDevSectionOutlineSidebar();
      bindSidebarLabelEdits();
    };

    const syncSidebarLabelEditability = () => {
      const list = document.querySelector<HTMLElement>('[data-section-sidebar-list]');
      if (!list) return;

      const editable = isActive();
      list.querySelectorAll<HTMLElement>('[data-section-nav-label]').forEach((labelEl) => {
        if (editable) {
          labelEl.setAttribute('contenteditable', 'true');
        } else {
          labelEl.removeAttribute('contenteditable');
        }
      });
    };

    const bindSidebarLabelEdits = () => {
      const list = document.querySelector<HTMLElement>('[data-section-sidebar-list]');
      if (!list) return;

      syncSidebarLabelEditability();

      list.querySelectorAll<HTMLElement>('[data-section-nav-label]').forEach((labelEl) => {
        labelEl.onclick = (event) => {
          if (!isActive()) return;
          event.preventDefault();
          event.stopPropagation();
        };
        labelEl.onmousedown = (event) => {
          if (!isActive()) return;
          event.stopPropagation();
        };
        labelEl.onblur = () => {
          if (!isActive()) return;
          const groupEl = labelEl.closest<HTMLElement>('[data-section-nav-group]');
          const nextLabel = labelEl.textContent?.trim() || 'Section';
          if (!groupEl) return;
          const prevLabel = groupEl.dataset.navLabel || '';
          groupEl.dataset.navLabel = nextLabel;
          const group = outline.find(
            (entry) => entry.kind === 'group' && entry.label === prevLabel,
          );
          if (group && group.kind === 'group') {
            group.label = nextLabel;
            group.id = slugify(nextLabel);
          }
          writeRootDatasets();
          setDirty(true);
        };
        labelEl.onkeydown = (event) => {
          if (!isActive()) return;
          if (event.key === 'Enter') {
            event.preventDefault();
            // Blur commits the rename into `outline` and stages it — Enter no
            // longer writes to disk on its own; the save bar owns that.
            labelEl.blur();
          }
        };
      });
    };

    const onSidebarLinkClick = (event: MouseEvent) => {
      if (!isActive()) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      const anchor = target.closest<HTMLAnchorElement>('[data-section-nav-link] a');
      if (!anchor) return;
      event.preventDefault();
      const li = anchor.closest<HTMLElement>('[data-section-nav-link]');
      const id = li?.dataset.navId;
      if (!id) return;
      const block = findBlockById(id);
      if (block) openPopover(block);
    };

    const sidebarList = document.querySelector<HTMLElement>('[data-section-sidebar-list]');
    sidebarList?.addEventListener('click', onSidebarLinkClick);

    /**
     * The shared save bar wrote our pending change to disk — the DOM is already
     * correct, so this only rebases what Revert would go back to.
     */
    window.addEventListener('vcd:dev-pending-committed', () => {
      if (!dirty) return;
      pendingSectionIds = {};
      pendingShowTitles = {};
      captureBaseline();
      dirty = false;
    });

    /**
     * Insert marker entries at this block’s page position — never push to the
     * end. Pushing made a re-added section inherit the last group in the file
     * (e.g. Outcome), so untoggling Research could spawn duplicate groups.
     */
    const insertOutlineEntriesAtBlock = (anchorId: string, entries: OutlineEntry[]) => {
      if (!entries.length) return;
      const next = insertOutlineEntriesAtPagePosition(
        outline,
        anchorId,
        entries as SharedOutlineEntry[],
        pageIndexForId,
      ) as OutlineEntry[];
      replaceOutline(next);
    };

    const onApply = () => {
      if (!activeBlock) return;
      const index = blockContentIndex(activeBlock);
      if (!outlineOnly && index === null) {
        setStatus('This block cannot be marked.', true);
        return;
      }

      const wantGroup = asGroupInput.checked;
      const wantSection = asSectionInput.checked;
      const groupLabel = groupLabelInput.value.trim() || suggestGroupLabel();
      const sectionLabel = sectionLabelInput.value.trim() || suggestSectionLabel(activeBlock);
      const previousId = activeBlock.id || '';

      replaceOutline(outline.filter((entry) => outlineAnchorId(entry) !== previousId));

      if (!wantGroup && !wantSection) {
        if (previousId) {
          if (index !== null) {
            pendingSectionIds[String(index)] = null;
          }
          applyBlockSectionId(activeBlock, null);
        }
      } else {
        const used = collectUsedIds();
        if (previousId) used.delete(previousId);

        const preferred = wantSection ? slugify(sectionLabel) : slugify(groupLabel);
        const anchorId = previousId || uniqueId(preferred, used);

        editableBlocks().forEach((block) => {
          if (block !== activeBlock && block.id === anchorId) {
            const otherIndex = blockContentIndex(block);
            if (otherIndex !== null) pendingSectionIds[String(otherIndex)] = null;
            block.removeAttribute('id');
            block.classList.remove('section-block');
            replaceOutline(outline.filter((entry) => outlineAnchorId(entry) !== anchorId));
          }
        });

        applyBlockSectionId(activeBlock, anchorId);
        if (index !== null) pendingSectionIds[String(index)] = anchorId;

        const newEntries: OutlineEntry[] = [];
        if (wantGroup) {
          const ids = collectUsedIds();
          ids.add(anchorId);
          const groupId = wantSection ? uniqueId(slugify(groupLabel), ids) : anchorId;
          newEntries.push({
            kind: 'group',
            id: groupId,
            label: groupLabel,
            defaultOpen: true,
            anchor: anchorId,
          });
        }

        if (wantSection) {
          newEntries.push({
            kind: 'section',
            id: anchorId,
            label: sectionLabel,
            anchor: anchorId,
          });
        }

        insertOutlineEntriesAtBlock(anchorId, newEntries);
      }

      if (!outlineOnly && activeBlock.dataset.devSectionTitle === 'true') {
        const showTitle = readTitleChips();
        if (index !== null) pendingShowTitles[String(index)] = showTitle;
        applyShowTitleClasses(activeBlock, showTitle);
      }

      replaceOutline(sortOutlineByPageOrder(outline));
      syncSidebarDom();
      setDirty(true);
      closePopover();
    };

    const setEditorChrome = (active: boolean) => {
      shell.hidden = !active;
      hint.hidden = !active;
      document.documentElement.classList.toggle('is-section-nav-editing', active);
      if (!active) {
        closePopover();
        hoverBlock?.classList.remove('is-section-nav-hover');
        hoverBlock = null;
        editableBlocks().forEach((el) => {
          el.classList.remove('is-section-nav-hover', 'is-section-nav-active');
        });
        // Leaving this mode keeps marker edits staged, the same way closing a crop
        // tuner does. Undoing them is the save bar's Revert, not Esc.
        syncSidebarLabelEditability();
      } else {
        syncSidebarDom();
        // Only rebase the revert target when nothing is staged — re-entering the
        // editor mid-edit must still be able to get back to what is on disk.
        if (!dirty) captureBaseline();
      }
    };

    asGroupInput.addEventListener('change', () => {
      syncMarkerFields();
      if (asGroupInput.checked) {
        if (!groupLabelInput.value.trim()) groupLabelInput.value = suggestGroupLabel();
      } else {
        // Clear so a hidden leftover label cannot be mistaken for an active group.
        groupLabelInput.value = '';
      }
    });
    asSectionInput.addEventListener('change', () => {
      syncMarkerFields();
      if (asSectionInput.checked) {
        if (!sectionLabelInput.value.trim() && activeBlock) {
          sectionLabelInput.value = suggestSectionLabel(activeBlock);
        }
      } else {
        sectionLabelInput.value = '';
      }
    });

    titleVis.querySelectorAll<HTMLButtonElement>('[data-title-bp]').forEach((button) => {
      button.addEventListener('click', () => {
        const on = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        button.classList.toggle('is-on', on);
      });
    });

    hideSidebarBtn.addEventListener('click', () => {
      setTitleChip('desktop', false);
      setTitleChip('tablet', true);
      setTitleChip('mobile', true);
    });

    const onLabelInputKeydown = (event: KeyboardEvent) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      onApply();
    };

    cancelBtn.addEventListener('click', closePopover);
    applyBtn.addEventListener('click', onApply);
    groupLabelInput.addEventListener('keydown', onLabelInputKeydown);
    sectionLabelInput.addEventListener('keydown', onLabelInputKeydown);

    // Marker edits only reach `outline` via Apply, so an open popover holds work
    // the save bar cannot see. Land it rather than letting Save drop it silently.
    window.addEventListener('vcd:dev-before-save', () => {
      if (!isActive() || popoverPanel.hidden || !activeBlock) return;
      onApply();
    });

    document.addEventListener(
      'click',
      (event) => {
        if (!isActive()) return;
        const target = event.target as HTMLElement | null;
        if (!target) return;
        // The whole DevOverlay panel, not just the inner content — its own
        // head (drag handle, traffic lights) sits outside [data-nav-popover].
        if (target.closest('[data-dev-panel-key="section-nav"]')) return;
        if (target.closest('.section-sidebar-nav')) return;
        if (target.closest('.site-header')) return;
        // This runs in capture, so a click on Save reached here first and closed
        // the popover before the save bar's own handler could flush it. Dev chrome
        // is not page content — clicking it must not dismiss the open marker.
        if (target.closest('.dev-text-actions')) return;

        const block = target.closest<HTMLElement>(`${mainScope} [data-dev-spacing-path], ${mainScope} .section-block[id]`);
        if (!block || !isEditableBlock(block)) {
          if (!popoverPanel.hidden) closePopover();
          return;
        }

        event.preventDefault();
        event.stopPropagation();
        openPopover(block);
      },
      true,
    );

    document.addEventListener('mousemove', (event) => {
      if (!isActive() || !popoverPanel.hidden) return;
      const target = event.target as HTMLElement | null;
      const block = target?.closest<HTMLElement>(`${mainScope} [data-dev-spacing-path], ${mainScope} .section-block[id]`);
      if (hoverBlock === block) return;
      hoverBlock?.classList.remove('is-section-nav-hover');
      hoverBlock = block && isEditableBlock(block) ? block : null;
      hoverBlock?.classList.add('is-section-nav-hover');
    });

    document.addEventListener('keydown', (event) => {
      if (!isActive()) return;
      if (event.key !== 'Escape') return;
      // Only dismiss the marker popover; DevModeController owns Esc → Dev Mode.
      if (popoverPanel.hidden) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      closePopover();
    }, true);

    // Dragging, position persistence, and resize-clamping are handled by
    // DevOverlay itself (see [data-drag-handle] in DevOverlay.astro).

    window.addEventListener('vcd:section-nav-editor-change', (() => {
      setEditorChrome(isActive());
    }) as EventListener);
    window.addEventListener('vcd:dev-mode-change', (() => {
      setEditorChrome(isActive());
    }) as EventListener);

    writeRootDatasets();
    setEditorChrome(isActive());
  };

  initSectionNavEditor();
</script>

<style is:global>
  html.is-section-nav-editing,
  html.is-section-nav-editing * {
    cursor: crosshair !important;
  }

  html.is-section-nav-editing .section-sidebar-nav,
  html.is-section-nav-editing .section-sidebar-nav * {
    cursor: default !important;
  }

  html.is-section-nav-editing .dev-overlay[data-dev-panel-key='section-nav'],
  html.is-section-nav-editing .dev-overlay[data-dev-panel-key='section-nav'] *,
  html.is-section-nav-editing .section-nav-editor__hint,
  html.is-section-nav-editing .section-nav-editor__hint *,
  /* The save bar is now the save surface for this mode, so it is chrome you click
     — the mode-wide crosshair over its buttons read as "not clickable here". */
  html.is-section-nav-editing .dev-text-actions,
  html.is-section-nav-editing .dev-text-actions * {
    cursor: auto !important;
  }

  html.is-section-nav-editing .dev-overlay[data-dev-panel-key='section-nav'] .dev-overlay__head {
    cursor: grab !important;
  }

  html.is-section-nav-editing .dev-overlay[data-dev-panel-key='section-nav'].is-dragging .dev-overlay__head {
    cursor: grabbing !important;
  }

  /* The blanket `auto` above outranks the panel's own `cursor: pointer` on
     buttons/links (higher specificity + !important) — restore it explicitly. */
  html.is-section-nav-editing .dev-overlay[data-dev-panel-key='section-nav'] button:not(:disabled),
  html.is-section-nav-editing .dev-overlay[data-dev-panel-key='section-nav'] .section-nav-editor__preset {
    cursor: pointer !important;
  }

  html.is-section-nav-editing [data-section-nav-main] .is-section-nav-hover {
    outline: 2px solid color-mix(in srgb, var(--sys-color-on-srf) 35%, transparent);
    outline-offset: 4px;
    border-radius: 0.15em;
  }

  html.is-section-nav-editing [data-section-nav-main] .is-section-nav-in-range {
    outline: 2px dashed color-mix(in srgb, var(--sys-color-on-srf) 28%, transparent);
    outline-offset: 4px;
    border-radius: 0.15em;
  }

  html.is-section-nav-editing [data-section-nav-main] .is-section-nav-active {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: 4px;
    border-radius: 0.15em;
  }

  html.is-section-nav-editing .section-sidebar-nav [data-section-nav-label] {
    outline: none;
    border-radius: 0.2em;
    cursor: text !important;
  }

  html.is-section-nav-editing .section-sidebar-nav [data-section-nav-label]:focus {
    background: color-mix(in srgb, var(--sys-color-srf-container-high) 80%, var(--sys-color-on-srf));
  }
</style>

<style>
  /*
    Bottom-left, not centred: the shared save bar owns bottom-right for the whole
    of this mode, and a centred hint ran underneath it.
  */
  .section-nav-editor__hint {
    position: fixed;
    left: max(1em, env(safe-area-inset-left));
    bottom: max(1em, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.75em;
    max-width: calc(100vw - 2em);
    padding: 0.55em 0.9em;
    border-radius: var(--radius-control-smooth);
    background: var(--sys-color-on-srf);
    color: var(--sys-color-srf);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    pointer-events: none;
    box-shadow: 0 0.25em 1em rgba(26, 26, 26, 0.18);
  }

  /* Not enough width for hint and save bar side by side — stack instead of overlap. */
  @media (max-width: 74em) {
    .section-nav-editor__hint {
      bottom: calc(max(1em, env(safe-area-inset-bottom)) + 3.5em);
    }
  }

  /* Chrome (position, background, shadow, drag handle, title) comes from DevOverlay. */
  .section-nav-editor__popover {
    display: flex;
    flex-direction: column;
    gap: var(--dev-panel-content-gap);
  }

  .section-nav-editor__group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .section-nav-editor__subtitle {
    margin: 0;
    font: var(--dev-text-field-label);
    color: var(--sys-color-on-srf-variant);
  }

  .section-nav-editor__belongs {
    margin: 0;
    padding: 0.45em 0.55em;
    border-radius: var(--dev-radius-control);
    background: var(--sys-color-srf-container-low);
    font: var(--dev-text-label);
    color: var(--sys-color-on-srf);
  }

  .section-nav-editor__belongs[hidden] {
    display: none;
  }

  .section-nav-editor__field[hidden] {
    display: none;
  }

  .section-nav-editor__field .dev-field__input::placeholder {
    color: var(--sys-color-on-srf-subtle);
  }

  .section-nav-editor__title-vis {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 8px;
    margin: 0;
  }

  /* Class kept only for the margin-bottom reset — pill chrome is .dev-segmented. */
  .section-nav-editor__chips {
    margin-bottom: 0;
    width: 100%;
  }

  /* No local rule: dev-btn dev-btn--ghost dev-btn--fill on the element owns
     every declaration this used to carry. The class stays on the element only
     because the is-section-nav-editing cursor override selects it. */

  /* display/justify-content/gap now come from .dev-panel-actions. */

  .section-nav-editor__status {
    margin: 0;
    font: var(--dev-text-label);
    color: var(--sys-color-on-srf-variant);
  }

  .section-nav-editor__status.is-error {
    color: #a33;
  }
</style>
