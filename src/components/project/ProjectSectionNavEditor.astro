---
/**
 * DEV Section Editor — outline markers (Obsidian-style ranges).
 * Enter with Alt+E while Dev Mode is on; Esc returns to Dev Mode.
 *
 * - Section group = Intro / Research / Development (boundary)
 * - Section = Overview / Public Reception / … (scroll target + range)
 * A section owns page blocks from its start until the next section or group.
 */
import DevOverlay from '../DevOverlay.astro';
import TextField from '../ui/TextField.astro';
import SelectField from '../ui/EditorSelectField.astro';
---

<div class="section-nav-editor" data-section-nav-editor hidden>
  <DevOverlay storageKey="section-nav-marker" panelKey="section-nav" title="Sections" defaultHidden>
    <div class="section-nav-editor__popover" data-nav-popover>
      <SelectField label="Block" options={[]} data-nav-block />

      <div class="section-nav-editor__group">
        <label class="dev-toggle">
          <span class="dev-toggle__box">
            <input type="checkbox" class="dev-toggle__checkbox" data-nav-as-group />
            <svg class="dev-toggle__check" viewBox="0 0 16 16" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="1.667" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3.5 8.5l3 3 6-6" />
            </svg>
          </span>
          <span class="dev-toggle__label">Start group</span>
        </label>
        <TextField class="section-nav-editor__field" label="Group name" data-nav-group-label maxlength="120" autocomplete="off" placeholder="Group name" />
      </div>

      <div class="section-nav-editor__group">
        <label class="dev-toggle">
          <span class="dev-toggle__box">
            <input type="checkbox" class="dev-toggle__checkbox" data-nav-as-section />
            <svg class="dev-toggle__check" viewBox="0 0 16 16" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="1.667" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3.5 8.5l3 3 6-6" />
            </svg>
          </span>
          <span class="dev-toggle__label">Start section</span>
        </label>
        <TextField class="section-nav-editor__field" label="Section name" data-nav-section-label maxlength="120" autocomplete="off" placeholder="Section name" />
      </div>

      <div class="section-nav-editor__title-vis" data-nav-title-vis hidden>
        <p class="section-nav-editor__subtitle">Show in-page title</p>
        <div class="section-nav-editor__chips dev-segmented" role="group" aria-label="Title visibility">
          <button type="button" class="dev-btn dev-btn--ghost dev-btn--fill" data-title-bp="desktop" aria-pressed="true">Desktop</button>
          <button type="button" class="dev-btn dev-btn--ghost dev-btn--fill" data-title-bp="tablet" aria-pressed="true">Tablet</button>
          <button type="button" class="dev-btn dev-btn--ghost dev-btn--fill" data-title-bp="mobile" aria-pressed="true">Mobile</button>
        </div>
        <button type="button" class="section-nav-editor__preset dev-btn dev-btn--ghost dev-btn--fill" data-nav-hide-sidebar>
          Hide when sidebar shows
        </button>
      </div>

      <div class="section-nav-editor__actions dev-panel-actions">
        <button type="button" class="dev-btn dev-btn--ghost" data-nav-undo disabled>Undo</button>
        <button type="button" class="dev-btn dev-btn--ghost" data-nav-redo disabled>Redo</button>
        <button type="button" class="section-nav-editor__save dev-btn dev-btn--filled" data-nav-done>Done</button>
      </div>

    </div>
  </DevOverlay>
</div>

<script>
  import {
    getDevSectionOutline,
    initDevSectionOutlineSync,
    setDevSectionOutline,
    syncDevSectionOutlineSidebar,
  } from '../../scripts/devSectionOutlineSync';
  import {
    outlineAnchorId,
    outlineEntriesForAnchor,
    owningOutlineSection,
    reorderOutlinePreservingGroups,
    type OutlineEntry,
  } from '../../lib/projectOutline';

  import textIcon from 'lucide-static/icons/type.svg?raw';
  import heading1Icon from 'lucide-static/icons/heading-1.svg?raw';
  import heading2Icon from 'lucide-static/icons/heading-2.svg?raw';
  import imageIcon from 'lucide-static/icons/image.svg?raw';
  import galleryIcon from 'lucide-static/icons/images.svg?raw';
  import quoteIcon from 'lucide-static/icons/quote.svg?raw';
  import commentsIcon from 'lucide-static/icons/messages-square.svg?raw';
  import blockIcon from 'lucide-static/icons/square.svg?raw';
  import { sizeIcon } from '../../lib/icons';
  import { getSectionRootsInDomOrder, sectionIndexFromElement } from '../../scripts/devSectionPaths';
  import { pageHistory, registerHistoryScope } from '../../lib/devHistory';
  import { onPageLoad } from '../../lib/pageLifecycle';

  type ShowTitle = { desktop: boolean; tablet: boolean; mobile: boolean };
  type BlockState = {
    block: HTMLElement;
    anchor: string;
    entries: OutlineEntry[];
    showTitle: ShowTitle | null;
  };

  const initSectionNavEditor = () => {
    const root = document.querySelector<HTMLElement>('[data-section-nav-root]');
    const shell = document.querySelector<HTMLElement>('[data-section-nav-editor]');
    const documentKey = root?.dataset.sectionNavDocument;
    if (!root || !shell || !documentKey) return;
    initDevSectionOutlineSync();
    const controller = new AbortController();
    const { signal } = controller;
    const panel = shell.querySelector<HTMLElement>('[data-dev-panel-key="section-nav"]')!;
    const blockSelect = shell.querySelector<HTMLSelectElement>('[data-nav-block]')!;
    const groupToggle = shell.querySelector<HTMLInputElement>('[data-nav-as-group]')!;
    const sectionToggle = shell.querySelector<HTMLInputElement>('[data-nav-as-section]')!;
    const groupLabel = shell.querySelector<HTMLInputElement>('[data-nav-group-label]')!;
    const sectionLabel = shell.querySelector<HTMLInputElement>('[data-nav-section-label]')!;
    const titleVis = shell.querySelector<HTMLElement>('[data-nav-title-vis]')!;
    const undoButton = shell.querySelector<HTMLButtonElement>('[data-nav-undo]')!;
    const redoButton = shell.querySelector<HTMLButtonElement>('[data-nav-redo]')!;
    const sidebar = document.querySelector<HTMLElement>('[data-section-sidebar-list]');
    const main = document.querySelector<HTMLElement>('[data-section-nav-main]');
    const pendingId = `section-nav:${documentKey}`;
    const touched = new Map<HTMLElement, BlockState>();
    const selectable = new Map<HTMLElement, { attributes: Array<[string, string | null]>; children: Map<HTMLElement, boolean>; ring: HTMLElement }>();
    let historyScope: ReturnType<typeof pageHistory.scope> | null = null;
    let unregisterHistoryScope: (() => void) | null = null;
    let pendingBefore: { block: HTMLElement; state: BlockState; input?: EventTarget | null } | null = null;
    let activeBlock: HTMLElement | null = null;
    let inputSession: EventTarget | null = null;
    let syncing = false;
    let dirty = false;
    let saving = false;

    const isActive = () => document.documentElement.classList.contains('show-section-nav-editor')
      && document.documentElement.classList.contains('is-dev-mode');
    const ownsHistoryTarget = (target: Element | null) => isActive()
      && Boolean(target?.closest('[data-section-nav-block]') || sidebar?.contains(target));
    const closePanel = () => {
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', { detail: { panel } }));
    };
    const contentIndex = (block: HTMLElement) => root.dataset.sectionNavOutlineOnly === 'true' ? null : sectionIndexFromElement(block);
    const blocks = () => {
      if (!main) return [];
      if (root.dataset.sectionNavOutlineOnly === 'true') return [...main.querySelectorAll<HTMLElement>('.section-block[id]')];
      return getSectionRootsInDomOrder(main).filter((block) => !block.hasAttribute('data-dev-spacing-write-path'));
    };
    const newId = () => crypto.randomUUID?.()
      ?? Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, '0')).join('');
    const blockKey = (block: HTMLElement) => block.dataset.devOutlineKey ||= newId();
    const blockLabel = (block: HTMLElement) => {
      const text = block.querySelector('.project-section-title, [data-dev-text-document]')?.textContent?.trim()
        || (block.matches('[data-dev-text-document]') ? block.textContent?.trim() : '')
        || block.querySelector('img')?.alt?.trim()
        || block.dataset.devSectionDeletable || 'Block';
      const words = text.split(/\s+/);
      return words.slice(0, 4).join(' ') + (words.length > 4 ? '…' : '');
    };
    const blockIconSvg = (block: HTMLElement) => {
      const kind = block.dataset.devSectionDeletable;
      return sizeIcon(kind === 'sectionTitle' ? (block.querySelector('h3.project-section-title') ? heading2Icon : heading1Icon)
        : kind === 'bodyText' ? textIcon
        : kind === 'imageGrid' || kind === 'imageCarousel' ? galleryIcon
        : block.hasAttribute('data-press-quote-ticker') ? quoteIcon
        : block.hasAttribute('data-reddit-comment-board') ? commentsIcon
        : block.querySelector('img') ? imageIcon : blockIcon, 16);
    };
    const syncSelectableBlocks = (enabled = isActive()) => {
      if (!enabled) {
        for (const [block, state] of selectable) {
          for (const [name, value] of state.attributes) {
            if (value === null) block.removeAttribute(name);
            else block.setAttribute(name, value);
          }
          for (const [child, inert] of state.children) child.inert = inert;
          state.ring.remove();
        }
        selectable.clear();
        return;
      }
      for (const block of blocks()) {
        if (!selectable.has(block)) {
          const ring = document.createElement('span');
          ring.className = 'section-nav-block-ring';
          ring.setAttribute('aria-hidden', 'true');
          const attributes = ['role', 'tabindex', 'aria-label', 'data-section-nav-block'].map((name) => [name, block.getAttribute(name)] as [string, string | null]);
          selectable.set(block, { attributes, children: new Map(), ring });
          block.append(ring);
          block.setAttribute('data-section-nav-block', '');
          block.setAttribute('role', 'button');
          block.tabIndex = 0;
        }
        const state = selectable.get(block)!;
        block.setAttribute('aria-label', blockLabel(block));
        for (const child of block.children) {
          if (!(child instanceof HTMLElement) || child === state.ring) continue;
          if (!state.children.has(child)) state.children.set(child, child.inert);
          child.inert = true;
        }
      }
    };
    const readVisibility = (block: HTMLElement): ShowTitle | null => {
      if (root.dataset.sectionNavOutlineOnly === 'true' || block.dataset.devSectionTitle !== 'true') return null;
      return {
        desktop: !block.classList.contains('project-section-title--hide-desktop'),
        tablet: !block.classList.contains('project-section-title--hide-tablet'),
        mobile: !block.classList.contains('project-section-title--hide-mobile'),
      };
    };
    const applyVisibility = (block: HTMLElement, value: ShowTitle) => {
      for (const bp of ['desktop', 'tablet', 'mobile'] as const) {
        block.classList.toggle(`project-section-title--hide-${bp}`, !value[bp]);
      }
      block.classList.toggle('project-section-title--hide-when-sidebar', !value.desktop);
      block.dataset.devShowTitle = JSON.stringify(value);
    };
    const capture = (block: HTMLElement): BlockState => ({
      block,
      anchor: block.id,
      entries: structuredClone(outlineEntriesForAnchor(getDevSectionOutline(), block.id)),
      showTitle: readVisibility(block),
    });
    const sameState = (a: BlockState, b: BlockState) => a.anchor === b.anchor
      && JSON.stringify(a.entries) === JSON.stringify(b.entries)
      && JSON.stringify(a.showTitle) === JSON.stringify(b.showTitle);
    const liveBlock = (state: BlockState) => state.block.isConnected ? state.block
      : state.block.id ? document.getElementById(state.block.id) : null;
    const orderedOutline = (entries: OutlineEntry[]) => {
      const order = blocks();
      return reorderOutlinePreservingGroups(entries, (id) => {
        const index = order.findIndex((block) => block.id === id);
        return index < 0 ? Infinity : index;
      });
    };
    const preparePayload = () => {
      const sectionIds: Record<string, string | null> = {};
      const showTitles: Record<string, ShowTitle> = {};
      for (const initial of touched.values()) {
        const block = liveBlock(initial);
        if (!block) continue;
        const index = contentIndex(block);
        if (index === null) continue;
        if (block.id !== initial.anchor) sectionIds[index] = block.id || null;
        const current = readVisibility(block);
        if (current && JSON.stringify(current) !== JSON.stringify(initial.showTitle)) showTitles[index] = current;
      }
      return {
        document: documentKey,
        outline: structuredClone(getDevSectionOutline()),
        sectionIds,
        showTitles,
      };
    };
    const stage = () => {
      dirty = [...touched.values()].some((initial) => {
        const block = liveBlock(initial);
        return block && !sameState(initial, capture(block));
      });
      undoButton.disabled = saving || pageHistory.busy || !historyScope?.canUndo;
      redoButton.disabled = saving || pageHistory.busy || !historyScope?.canRedo;
      if (!dirty) {
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
        return;
      }
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: { id: pendingId, kind: 'section-nav', payload: preparePayload(), prepare: preparePayload, revert },
      }));
    };
    const restore = (state: BlockState) => {
      const block = liveBlock(state);
      if (!block) {
        throw new Error('Could not restore outline edit because its block is no longer on the page.');
      }
      const next = getDevSectionOutline().filter((entry) => outlineAnchorId(entry) !== block.id);
      next.push(...structuredClone(state.entries));
      block.id = state.anchor;
      if (!state.anchor) block.removeAttribute('id');
      block.classList.toggle('section-block', Boolean(state.anchor));
      if (state.showTitle) applyVisibility(block, state.showTitle);
      setDevSectionOutline(orderedOutline(next));
    };
    const revert = () => {
      for (const initial of touched.values()) restore(initial);
      touched.clear();
      inputSession = null;
      syncDevSectionOutlineSidebar();
      renderSelection();
      stage();
    };
    const remember = (block: HTMLElement, input?: EventTarget | null) => {
      const before = capture(block);
      if (![...touched.values()].some((initial) => liveBlock(initial) === block)) touched.set(block, before);
      pendingBefore = { block, state: before, input };
      inputSession = input || null;
    };
    const syncBlockOptions = () => {
      const all = blocks();
      const options = all.map((block) => ({ value: blockKey(block), label: blockLabel(block), icon: blockIconSvg(block) }));
      const signature = JSON.stringify(options);
      if (blockSelect.dataset.options !== signature) {
        blockSelect.replaceChildren(new Option('Select block', ''), ...options.map((option) => {
          const node = new Option(option.label, option.value);
          node.dataset.iconSvg = option.icon;
          return node;
        }));
        blockSelect.dataset.options = signature;
      }
      blockSelect.value = activeBlock ? blockKey(activeBlock) : '';
      blockSelect.dispatchEvent(new Event('change', { bubbles: true }));
    };
    const renderSelection = (fillFields = true) => {
      syncing = true;
      syncSelectableBlocks();
      if (activeBlock && !activeBlock.isConnected) activeBlock = null;
      const entries = activeBlock ? outlineEntriesForAnchor(getDevSectionOutline(), activeBlock.id) : [];
      const group = entries.find((entry) => entry.kind === 'group');
      const section = entries.find((entry) => entry.kind === 'section');
      const order = blocks();
      const owned = activeBlock ? owningOutlineSection(
        getDevSectionOutline(), activeBlock.id || blockKey(activeBlock), order.map((block) => block.id || blockKey(block)),
      ) : null;
      sidebar?.querySelectorAll<HTMLElement>('[data-outline-id]').forEach((row) => {
        const selected = isActive() && (row.dataset.outlineKind === 'group'
          ? row.dataset.outlineId === (group || owned?.group)?.id
          : row.dataset.outlineId === (section || owned?.section)?.id);
        row.classList.toggle('is-section-nav-selected', selected);
        const control = row.matches('[data-section-nav-group]') ? row.querySelector('summary') : row.querySelector('a');
        if (isActive()) {
          if (selected) control?.setAttribute('aria-current', 'true');
          else control?.removeAttribute('aria-current');
        } else if (row.dataset.outlineKind === 'group') {
          control?.removeAttribute('aria-current');
        }
      });
      order.forEach((block) => block.classList.toggle('is-section-nav-active', isActive() && block === activeBlock));
      groupToggle.disabled = sectionToggle.disabled = !activeBlock;
      if (fillFields) {
        groupToggle.checked = Boolean(group);
        sectionToggle.checked = Boolean(section);
        groupLabel.value = group?.label || '';
        sectionLabel.value = section?.label || '';
      }
      groupLabel.closest<HTMLElement>('.section-nav-editor__field')!.hidden = !groupToggle.checked;
      sectionLabel.closest<HTMLElement>('.section-nav-editor__field')!.hidden = !sectionToggle.checked;
      const visibility = activeBlock && readVisibility(activeBlock);
      titleVis.hidden = !visibility;
      if (visibility) titleVis.querySelectorAll<HTMLButtonElement>('[data-title-bp]').forEach((button) => {
        button.setAttribute('aria-pressed', String(visibility[button.dataset.titleBp as keyof ShowTitle]));
      });
      if (pendingBefore && !pageHistory.replaying) {
        const current = capture(pendingBefore.block);
        if (!sameState(pendingBefore.state, current)) {
          const before = pendingBefore.state;
          const block = pendingBefore.block;
          const mergeKey = pendingBefore.input ? `section:${blockKey(block)}:${pendingBefore.input === groupLabel ? 'group' : 'section'}` : undefined;
          (historyScope ?? pageHistory).push({ label: 'Edit section outline', mergeKey, undo: () => {
            if (!touched.has(block)) touched.set(block, capture(block));
            restore(before); if (isActive()) activeBlock = liveBlock(before); syncDevSectionOutlineSidebar(); renderSelection(); stage();
            window.dispatchEvent(new CustomEvent('vcd:section-history-reveal', { detail: { block: liveBlock(before) } }));
          }, redo: () => {
            if (!touched.has(block)) touched.set(block, capture(block));
            restore(current); if (isActive()) activeBlock = liveBlock(current); syncDevSectionOutlineSidebar(); renderSelection(); stage();
            window.dispatchEvent(new CustomEvent('vcd:section-history-reveal', { detail: { block: liveBlock(current) } }));
          } });
        }
        pendingBefore = null;
      }
      undoButton.disabled = saving || pageHistory.busy || !historyScope?.canUndo;
      redoButton.disabled = saving || pageHistory.busy || !historyScope?.canRedo;
      syncBlockOptions();
      syncing = false;
    };
    const selectBlock = (block: HTMLElement | null, focusKind?: 'group' | 'section') => {
      if (panel.hidden) {
        unregisterHistoryScope?.();
        historyScope = pageHistory.scope();
        unregisterHistoryScope = registerHistoryScope(panel, historyScope, { owns: ownsHistoryTarget, signal });
      }
      activeBlock?.classList.remove('is-section-nav-active');
      activeBlock = block;
      inputSession = null;
      renderSelection();
      panel.hidden = false;
      if (focusKind) {
        const input = focusKind === 'group' ? groupLabel : sectionLabel;
        input.focus({ preventScroll: true });
        input.select();
      }
    };
    const changeMarker = (kind: 'group' | 'section', enabled: boolean, label?: string, input?: EventTarget | null) => {
      const block = activeBlock;
      if (!block || saving) return;
      const before = capture(block);
      const existing = before.entries.find((entry) => entry.kind === kind);
      const nextLabel = label === undefined ? existing?.label || (kind === 'group' ? 'Group' : block.querySelector('.project-section-title')?.textContent?.trim().slice(0, 120) || 'Section') : label.trim() || (kind === 'group' ? 'Group' : 'Section');
      if (enabled && existing?.label === nextLabel) return;
      if (!enabled && !existing) return;
      remember(block, input);
      if (!block.id && enabled) {
        block.id = `block-${newId()}`;
        block.classList.add('section-block');
      }
      const next = getDevSectionOutline().filter((entry) => !(outlineAnchorId(entry) === block.id && entry.kind === kind));
      if (enabled) next.push({
        ...(existing || { kind, id: `${kind}-${newId()}`, ...(kind === 'group' ? { defaultOpen: true } : {}) }),
        label: nextLabel,
        anchor: block.id,
      } as OutlineEntry);
      setDevSectionOutline(orderedOutline(next));
      syncDevSectionOutlineSidebar();
      renderSelection(!input);
      stage();
    };
    const reportHistoryError = (error: unknown) => window.dispatchEvent(new CustomEvent('vcd:dev-history-error', { detail: { message: error instanceof Error ? error.message : 'Could not restore outline edit.' } }));
    const undo = () => {
      if (saving) return;
      void historyScope?.undo().catch(reportHistoryError);
    };
    const syncMode = () => {
      if (isActive()) shell.hidden = false;
      document.documentElement.classList.toggle('is-section-nav-editing', isActive());
      if (isActive()) {
        if (!historyScope) {
          historyScope = pageHistory.scope();
          unregisterHistoryScope = registerHistoryScope(panel, historyScope, { owns: ownsHistoryTarget, signal });
        }
        syncDevSectionOutlineSidebar();
        panel.hidden = false;
      } else {
        unregisterHistoryScope?.();
        unregisterHistoryScope = null;
        historyScope = null;
        panel.hidden = true;
        main?.querySelectorAll('.is-section-nav-hover').forEach((block) => block.classList.remove('is-section-nav-hover'));
      }
      renderSelection();
    };

    blockSelect.addEventListener('change', () => {
      if (syncing) return;
      selectBlock(blocks().find((block) => blockKey(block) === blockSelect.value) || null);
    }, { signal });
    groupToggle.addEventListener('change', () => changeMarker('group', groupToggle.checked), { signal });
    sectionToggle.addEventListener('change', () => changeMarker('section', sectionToggle.checked), { signal });
    for (const [kind, input] of [['group', groupLabel], ['section', sectionLabel]] as const) {
      input.addEventListener('input', () => changeMarker(kind, true, input.value, input), { signal });
      input.addEventListener('blur', () => { inputSession = null; renderSelection(); }, { signal });
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') { event.preventDefault(); input.blur(); }
      }, { signal });
    }
    titleVis.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('[data-title-bp], [data-nav-hide-sidebar]');
      if (!button || !activeBlock) return;
      const visibility = readVisibility(activeBlock);
      if (!visibility) return;
      remember(activeBlock);
      if (button.hasAttribute('data-nav-hide-sidebar')) Object.assign(visibility, { desktop: false, tablet: true, mobile: true });
      else {
        const bp = button.dataset.titleBp as keyof ShowTitle;
        visibility[bp] = !visibility[bp];
      }
      applyVisibility(activeBlock, visibility);
      renderSelection();
      stage();
    }, { signal });
    undoButton.addEventListener('click', undo, { signal });
    redoButton.addEventListener('click', () => { void historyScope?.redo().catch(reportHistoryError); }, { signal });
    shell.querySelector('[data-nav-done]')!.addEventListener('click', closePanel, { signal });
    sidebar?.addEventListener('click', (event) => {
      if (!isActive()) return;
      const target = event.target as Element;
      const row = target.closest<HTMLElement>('[data-outline-id]');
      if (!row) return;
      const entry = getDevSectionOutline().find((entry) => entry.id === row.dataset.outlineId && entry.kind === row.dataset.outlineKind);
      if (!entry) return;
      const block = blocks().find((block) => block.id === outlineAnchorId(entry));
      if (!block) return;
      event.preventDefault();
      selectBlock(block, entry.kind);
    }, { capture: true, signal });
    document.addEventListener('pointerdown', (event) => {
      if (!isActive() || !(event.target instanceof Element)) return;
      const block = event.target.closest<HTMLElement>('[data-section-nav-block]');
      if (!block) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, { capture: true, signal });
    document.addEventListener('click', (event) => {
      if (!isActive()) return;
      const target = event.target as Element;
      if (target.closest('[data-dev-overlay], .section-sidebar-nav, .site-header, .dev-text-actions')) return;
      const block = target.closest<HTMLElement>('[data-section-nav-block]');
      if (!block || !blocks().includes(block)) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      block.focus({ preventScroll: true });
      selectBlock(block);
    }, { capture: true, signal });
    main?.addEventListener('pointermove', (event) => {
      if (!isActive()) return;
      const block = (event.target as Element).closest<HTMLElement>('[data-section-nav-block]');
      main.querySelectorAll('.is-section-nav-hover').forEach((el) => { if (el !== block) el.classList.remove('is-section-nav-hover'); });
      if (block && blocks().includes(block)) block.classList.add('is-section-nav-hover');
    }, { signal });
    main?.addEventListener('pointerleave', () => main.querySelectorAll('.is-section-nav-hover').forEach((block) => block.classList.remove('is-section-nav-hover')), { signal });
    document.addEventListener('keydown', (event) => {
      if (!isActive()) return;
      const target = event.target as HTMLElement;
      const block = target.closest<HTMLElement>('[data-section-nav-block]');
      if (block && (event.key === 'Enter' || event.key === ' ')) {
        event.preventDefault(); event.stopImmediatePropagation(); selectBlock(block);
        return;
      }
      if (target.closest('.dev-select__trigger')?.getAttribute('aria-expanded') === 'true') return;
      if (target.closest('[data-editor-select-popup]')) return;
      if (event.key === 'Escape' && !panel.hidden) {
        event.preventDefault(); event.stopImmediatePropagation(); closePanel();
      }
    }, { capture: true, signal });
    window.addEventListener('vcd:dev-history-change', () => {
      undoButton.disabled = saving || pageHistory.busy || !historyScope?.canUndo;
      redoButton.disabled = saving || pageHistory.busy || !historyScope?.canRedo;
    }, { signal });
    window.addEventListener('vcd:section-nav-editor-change', syncMode, { signal });
    window.addEventListener('vcd:dev-mode-change', syncMode, { signal });
    window.addEventListener('vcd:dev-edit-close', ((event: CustomEvent<{ panel?: HTMLElement }>) => {
      if (event.detail?.panel !== panel || !isActive()) return;
      window.dispatchEvent(new CustomEvent('vcd:section-nav-editor-request', { detail: { active: false } }));
    }) as EventListener, { signal });
    window.addEventListener('vcd:section-nav-sidebar-synced', () => { if (!syncing) renderSelection(false); }, { signal });
    window.addEventListener('vcd:dev-save-state', ((event: CustomEvent<{ saving: boolean }>) => {
      saving = event.detail.saving;
      panel.inert = saving;
    }) as EventListener, { signal });
    window.addEventListener('vcd:dev-pending-committed', ((event: CustomEvent<{ ids?: string[] }>) => {
      const ids = event.detail?.ids;
      if (Array.isArray(ids) && !ids.includes(pendingId)) return;
      touched.clear(); dirty = false; inputSession = null; pendingBefore = null; renderSelection();
    }) as EventListener, { signal });
    window.addEventListener('vcd:dev-pending-reverted', () => { syncDevSectionOutlineSidebar(); renderSelection(); }, { signal });
    window.addEventListener('vcd:dev-section-structure-changed', () => {
      inputSession = null; renderSelection(); if (dirty) stage();
    }, { signal });
    const dispose = () => {
      controller.abort();
      unregisterHistoryScope?.();
      panel.inert = false;
      if (dirty) revert();
      syncSelectableBlocks(false);
      document.documentElement.classList.remove('is-section-nav-editing');
      blocks().forEach((block) => block.classList.remove('is-section-nav-active', 'is-section-nav-hover'));
    };
    syncMode();
    return dispose;
  };

  const disposePage = onPageLoad(initSectionNavEditor);
  import.meta.hot?.dispose(disposePage);
</script>

