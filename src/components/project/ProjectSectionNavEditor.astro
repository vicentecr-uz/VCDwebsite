    cursor: default;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }
  html.is-section-nav-editing [data-section-nav-block] * {
    pointer-events: none !important;
    cursor: inherit !important;
  }
  html.is-section-nav-editing [data-section-nav-main] :is([data-dev-mode-only], [data-dev-edit-trigger], .dev-section-drag-handle, .dev-section-drag-bridge, .dev-section-delete, .dev-gap-toolbar) {
    visibility: hidden !important;
    pointer-events: none !important;
  }
  html.is-section-nav-editing [data-section-nav-main] :is([data-dev-text-document], [data-dev-section-deletable], [data-dev-spacing-document])::before,
  html.is-section-nav-editing [data-section-nav-main] :is([data-dev-text-document], [data-dev-section-deletable])::after {
    opacity: 0 !important;
  }
  .section-nav-block-ring {
    position: absolute;
    inset: calc(-0.5 * var(--space-unit));
    border: 3px solid var(--sys-color-outline-variant);
    border-radius: calc(0.75 * var(--space-unit));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }
  html.is-section-nav-editing [data-section-nav-block]:is(.is-section-nav-hover, :focus-visible, .is-section-nav-active) > .section-nav-block-ring {
    opacity: 1;
  }
  html.is-section-nav-editing [data-section-nav-block].is-section-nav-active > .section-nav-block-ring {
    border-color: var(--sys-color-on-srf);
  }
</style>

