---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';
import TextField from '../ui/TextField.astro';

interface Props {
  label?: string;
  placeholder?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
}

const {
  label = 'Get involved',
  placeholder = 'jternus@apple.com',
  documentKey,
  sectionPath,
  spacing = 'group',
  sectionId,
  contentId,
} = Astro.props;
const statusId = `signup-status-${sectionId ?? Math.random().toString(36).slice(2, 8)}`;
const editable = import.meta.env.DEV && documentKey && sectionPath;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', 'project-signup', projectStackClass(spacing), sectionId && 'section-block']}
  data-signup-motion
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={editable ? 'signup' : undefined}
>
  <form class="project-signup__form" data-project-signup-form novalidate>
    <div class="project-signup__control">
      <span class="project-signup__surface" aria-hidden="true"></span>
      <TextField
        class="project-signup__field"
        label="Email address"
        hideLabel
        pattern={String.raw`[^@\s]+@[^@\s]+\.[^@\s]+`}
        required
        autocomplete="email"
        inputmode="email"
        autocapitalize="none"
        spellcheck="false"
        placeholder={placeholder}
        aria-describedby={statusId}
        data-signup-email
      >
        <span slot="trail" class="project-signup__shortcut" data-signup-shortcut data-text-field-trail hidden aria-hidden="true">⏎</span>
      </TextField>
      <div class="project-signup__action">
        <button type="submit" aria-label={label} aria-keyshortcuts="Enter">
          <span class="project-signup__label" data-signup-label aria-hidden="true">{label}</span>
          <span class="project-signup__check" data-signup-check hidden aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
        </button>
      </div>
    </div>
    <div id={statusId} class="project-signup__status" data-signup-status aria-live="polite" aria-atomic="true">
      <p class="project-signup__status-message" data-signup-status-message></p>
    </div>
  </form>
  {import.meta.env.DEV && (
    <aside class="signup-motion-panel" data-signup-motion-panel aria-label="Success motion">
      <p class="signup-motion-panel__title">Success motion</p>
      <label>Preview speed
        <select data-ctrl="speed">
          <option value="1" selected>1×</option>
          <option value="0.5">0.5×</option>
          <option value="0.25">0.25×</option>
        </select>
      </label>
      <p class="signup-motion-panel__note">Get involved leaving and the check are locked. Controls below follow the rest of the routine.</p>
      <p class="signup-motion-panel__group">1. Check leaves</p>
      <label>Delay after check-out starts <output data-out="emailVsCheck">100ms</output>
        <input data-ctrl="emailVsCheck" type="range" min="-400" max="400" step="10" value="100" />
      </label>
      <p class="signup-motion-panel__group">2. Wind-up (left)</p>
      <label>Distance <output data-out="anticipate">10px</output>
        <input data-ctrl="anticipate" type="range" min="0" max="24" step="1" value="10" />
      </label>
      <label>Duration <output data-out="anticipateMs">100ms</output>
        <input data-ctrl="anticipateMs" type="range" min="40" max="240" step="10" value="100" />
      </label>
      <label>Ease
        <select data-ctrl="anticipateEase">
          <option value="cubic-bezier(0.55, 0.055, 0.675, 0.19)">accelerate — fastest at the left</option>
          <option value="cubic-bezier(0.5, 0, 0.75, 0.16)">accelerate hard</option>
          <option value="cubic-bezier(0.4, 0.05, 0.6, 0.95)" selected>coil — slow–fast–slow</option>
          <option value="cubic-bezier(0.25, 0.46, 0.45, 0.94)">settle — brakes into the pose</option>
          <option value="cubic-bezier(0.34, 1.4, 0.64, 1)">overshoot</option>
        </select>
      </label>
      <label>Taller and skinnier <output data-out="squash">0.10</output>
        <input data-ctrl="squash" type="range" min="0" max="0.3" step="0.02" value="0.1" />
      </label>
      <p class="signup-motion-panel__group">3. Store</p>
      <label>Hold at left <output data-out="storeMs">70ms</output>
        <input data-ctrl="storeMs" type="range" min="0" max="200" step="10" value="70" />
      </label>
      <p class="signup-motion-panel__group">4. Release (right)</p>
      <label>Duration fallback <output data-out="emailMs">500ms</output>
        <input data-ctrl="emailMs" type="range" min="200" max="1200" step="10" value="500" />
      </label>
      <label>Ease fallback
        <select data-ctrl="releaseEase">
          <option value="linear">constant — already at speed</option>
          <option value="cubic-bezier(0.55, 0.055, 0.675, 0.19)">accelerate from rest</option>
          <option value="cubic-bezier(0.5, 0, 0.75, 0.16)" selected>accelerate hard from rest</option>
        </select>
      </label>
      <label>Acceleration <output data-out="accel">12000 px/s²</output>
        <input data-ctrl="accel" type="range" min="0" max="40000" step="500" value="12000" />
      </label>
      <label>Max speed <output data-out="vmax">1600 px/s</output>
        <input data-ctrl="vmax" type="range" min="200" max="4000" step="50" value="1600" />
      </label>
      <p class="signup-motion-panel__note">Acceleration 0 uses Duration fallback + Ease fallback. Otherwise the throw is accelerate-then-coast at max speed.</p>
      <label>Shorter and wider <output data-out="stretch">0.10</output>
        <input data-ctrl="stretch" type="range" min="0" max="0.3" step="0.02" value="0.1" />
      </label>
      <p class="signup-motion-panel__group">5. Get involved back</p>
      <label>Start during release <output data-out="returnAt">80%</output>
        <input data-ctrl="returnAt" type="range" min="0" max="100" step="5" value="80" />
      </label>
      <label>Stagger across release <output data-out="returnSpan">40%</output>
        <input data-ctrl="returnSpan" type="range" min="10" max="100" step="5" value="40" />
      </label>
      <label>Each letter <output data-out="returnMs">300ms</output>
        <input data-ctrl="returnMs" type="range" min="80" max="800" step="10" value="300" />
      </label>
      <label>Letter ease
        <select data-ctrl="ease">
          <option value="cubic-bezier(0.25, 0.46, 0.45, 0.94)">ease-out-quad</option>
          <option value="cubic-bezier(0.215, 0.61, 0.355, 1)">ease-out-cubic</option>
          <option value="cubic-bezier(0.165, 0.84, 0.44, 1)">ease-out-quart</option>
          <option value="cubic-bezier(0.23, 1, 0.32, 1)" selected>ease-out-quint</option>
          <option value="cubic-bezier(0.32, 0.72, 0, 1)">ease-out-strong</option>
          <option value="cubic-bezier(0.645, 0.045, 0.355, 1)">ease-in-out-cubic</option>
        </select>
      </label>
      <p class="signup-motion-panel__group">6. Placeholder</p>
      <label>Wait, then fade in <output data-out="placeholderWait">400ms</output>
        <input data-ctrl="placeholderWait" type="range" min="0" max="2000" step="50" value="400" />
      </label>
      <p class="signup-motion-panel__note">Placeholder fade uses Letter ease. Empty / invalid submit uses the real field status.</p>
      <button type="button" class="signup-motion-panel__btn" data-copy>Copy config</button>
      <button type="button" class="signup-motion-panel__btn" data-save>Save</button>
      <button type="button" class="signup-motion-panel__btn" data-revert>Revert</button>
      <button type="button" class="signup-motion-panel__btn" data-replay>Replay</button>
    </aside>
  )}
</section>

<script>
  import tlds from 'tlds';
  import {
    animateRelease,
    bindSignupMotionPanel,
    readSignupMotionCfg,
    throwDurationMs,
  } from '../../scripts/signupSuccessMotion';

  const validTlds = new Set(tlds.map((tld) => new URL(`https://${tld}`).hostname));
  document.querySelectorAll<HTMLFormElement>('[data-project-signup-form]').forEach((form) => {
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const motionRoot = form.closest<HTMLElement>('[data-signup-motion]');
    const panel = motionRoot?.querySelector<HTMLElement>('[data-signup-motion-panel]');
    if (motionRoot && panel) bindSignupMotionPanel(panel, motionRoot);
    const input = form.querySelector<HTMLInputElement>('[data-signup-email]');
    const field = form.querySelector<HTMLElement>('.project-signup__field');
    const textField = form.querySelector<HTMLElement>('.dev-text-field');
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    let pressTimer: ReturnType<typeof setTimeout>;
    const shortcut = form.querySelector<HTMLElement>('[data-signup-shortcut]');
    const statusMessage = form.querySelector<HTMLElement>('[data-signup-status-message]');
    const surface = form.querySelector<HTMLElement>('.project-signup__surface');
    let statusTimer: ReturnType<typeof setTimeout>;
    const labelEl = form.querySelector<HTMLElement>('[data-signup-label]');
    const checkEl = form.querySelector<HTMLElement>('[data-signup-check]');
    let celebrating = false;
    let playId = 0;
    let ghost: HTMLElement | null = null;
    let lastEmail = '';
    if (labelEl && labelEl.dataset.split !== 'true') {
      const text = labelEl.textContent ?? '';
      labelEl.textContent = '';
      [...text].forEach((ch) => {
        const span = document.createElement('span');
        span.className = 'project-signup__char';
        span.textContent = ch === ' ' ? '\u00a0' : ch;
        span.dataset.char = '';
        labelEl.append(span);
      });
      labelEl.dataset.split = 'true';
    }
    const waitMs = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const settled = (animation: Animation) => animation.finished.catch(() => undefined);
    const waitCheckTransition = (ms: number) => new Promise<void>((resolve) => {
      if (!checkEl) return resolve();
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        checkEl.removeEventListener('transitionend', onEnd);
        resolve();
      };
      const onEnd = (event: TransitionEvent) => {
        if (event.target === checkEl && event.propertyName === 'opacity') finish();
      };
      checkEl.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, ms + 80);
    });
    const teardownGhost = () => {
      ghost?.remove();
      ghost = null;
      input?.classList.remove('is-signup-ghosted');
      textField?.classList.remove('is-signup-fade');
    };
    const mountEmailGhost = (className: string, text: string) => {
      const track = textField?.querySelector('.dev-text-field__track');
      if (!input || !textField || !track) return null;
      const next = document.createElement('span');
      next.className = className;
      next.setAttribute('aria-hidden', 'true');
      const style = getComputedStyle(input);
      const inputRect = input.getBoundingClientRect();
      const trackRect = track.getBoundingClientRect();
      next.style.font = style.font;
      next.style.letterSpacing = style.letterSpacing;
      next.style.left = `${inputRect.left - trackRect.left + track.scrollLeft}px`;
      next.style.top = `${inputRect.top - trackRect.top}px`;
      next.style.height = `${inputRect.height}px`;
      next.textContent = text;
      track.append(next);
      ghost = next;
      return next;
    };
    const playEmailAndReturn = async (
      reduce: boolean,
      chars: HTMLElement[],
    ) => {
      if (!input || !labelEl || !motionRoot) return;
      const c = readSignupMotionCfg(motionRoot);
      const emailEl = reduce ? null : mountEmailGhost('project-signup__email-ghost', input.value);
      if (emailEl) {
        input.classList.add('is-signup-ghosted');
        textField?.classList.add('is-signup-fade');
      }
      const fadeWidth = Number.parseFloat(
        getComputedStyle(textField ?? document.documentElement)
          .getPropertyValue('--dev-text-field-fade-width'),
      ) || 22;
      const travelPx = emailEl && textField
        ? textField.getBoundingClientRect().right - emailEl.getBoundingClientRect().left + fadeWidth
        : 0;
      const throwDistance = Math.max(0, travelPx + c.anticipate);
      const throwMs = reduce || c.accel <= 0 || c.vmax <= 0
        ? c.emailMs
        : throwDurationMs(throwDistance, c.accel, c.vmax, c.emailMs / c.speed) * c.speed;
      const runEmail = async () => {
        if (reduce) {
          input.classList.add('is-signup-ghosted');
          await settled(input.animate(
            [{ opacity: 1 }, { opacity: 0 }],
            { duration: c.emailMs, easing: c.ease, fill: 'forwards' },
          ));
          return;
        }
        if (!emailEl) return;
        if (c.anticipate > 0 && c.anticipateMs > 0) {
          const windup = emailEl.animate(
            [
              { transform: 'translateX(0) scaleX(1) scaleY(1)' },
              { transform: `translateX(${-c.anticipate}px) scaleX(${1 - c.squash}) scaleY(${1 + c.squash})` },
            ],
            { duration: c.anticipateMs, easing: c.anticipateEase, fill: 'forwards' },
          );
          await settled(windup);
          windup.commitStyles();
          windup.cancel();
          if (c.storeMs > 0) await waitMs(c.storeMs);
        }
        const release = animateRelease(
          emailEl,
          -c.anticipate,
          travelPx,
          1 - c.squash,
          1 + c.squash,
          1 + c.stretch,
          1 - c.stretch,
          c,
        );
        await release.finished;
      };
      const emailDone = runEmail();
      labelEl.hidden = false;
      const n = chars.length;
      const start = reduce ? 0 : c.anticipateMs + c.storeMs + c.returnAt * throwMs;
      const span = reduce ? Math.max(0, n - 1) * 30 : c.returnSpan * throwMs;
      const returnAnims = chars.map((el, i) => el.animate(
        reduce
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
            { opacity: 0, filter: `blur(${c.blur}px)`, transform: `scale(${c.scale})` },
            { opacity: 1, filter: 'blur(0px)', transform: 'scale(1)' },
          ],
        {
          duration: c.returnMs,
          delay: start + (n <= 1 ? 0 : (i / (n - 1)) * span),
          easing: c.ease,
          fill: 'both',
        },
      ));
      await Promise.all([emailDone, ...returnAnims.map(settled)]);
      input.classList.add('is-signup-placeholder-pending');
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.getAnimations().forEach((animation) => animation.cancel());
      teardownGhost();
      chars.forEach((el) => el.getAnimations().forEach((animation) => animation.cancel()));
      labelEl.getAnimations().forEach((animation) => animation.cancel());
    };
    const revealPlaceholder = async (id: number) => {
      if (!input || !motionRoot || id !== playId) return;
      const c = readSignupMotionCfg(motionRoot);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (input.value || document.activeElement === input) {
        input.classList.remove('is-signup-placeholder-pending');
        return;
      }
      const next = mountEmailGhost('project-signup__email-ghost is-placeholder', input.placeholder);
      if (!next) {
        input.classList.remove('is-signup-placeholder-pending');
        return;
      }
      await settled(next.animate(
        reduce
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
            { opacity: 0, filter: 'blur(4px)' },
            { opacity: 1, filter: 'blur(0px)' },
          ],
        { duration: 220 * c.speed, easing: c.ease, fill: 'forwards' },
      ));
      if (id !== playId) return;
      next.remove();
      if (ghost === next) ghost = null;
      input.classList.remove('is-signup-placeholder-pending');
    };
    const playSuccess = async () => {
      if (!button || !labelEl || !checkEl || !input || !motionRoot || celebrating) return;
      const id = ++playId;
      celebrating = true;
      button.setAttribute('aria-busy', 'true');
      input.readOnly = true;
      shortcut?.classList.add('is-inert');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const c = readSignupMotionCfg(motionRoot);
      const chars = [...labelEl.querySelectorAll<HTMLElement>('[data-char]')];
      const n = chars.length;
      const center = Math.max(n - 1, 1) / 2;
      const lastEnd = Math.max(...chars.map((_, i) => Math.min(i, n - 1 - i) * c.stagger + c.charMs));
      chars.forEach((node, i) => {
        const fromEdge = Math.min(i, n - 1 - i);
        const dist = Math.abs(i - center) / center;
        const dir = i < center ? 1 : i > center ? -1 : 0;
        const travel = c.move * (c.taper * dist + (1 - c.taper));
        const x = reduce ? 0 : dir * travel;
        node.animate(
          [
            { opacity: 1, filter: 'blur(0px)', transform: 'translateX(0) scale(1)' },
            { opacity: 0, filter: `blur(${reduce ? 0 : c.blur}px)`, transform: `translateX(${x}px) scale(${reduce ? 1 : c.scale})` },
          ],
          { duration: c.charMs, delay: fromEdge * c.stagger, easing: c.ease, fill: 'forwards' },
        );
      });
      await waitMs(Math.max(0, lastEnd - c.overlap));
      checkEl.hidden = false;
      checkEl.classList.toggle('is-reduced', reduce);
      checkEl.classList.remove('is-in', 'is-out');
      void checkEl.offsetWidth;
      await new Promise<void>((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      });
      checkEl.classList.add('is-in');
      await waitCheckTransition(c.checkMs);
      await Promise.all(chars.map((node) => Promise.all(node.getAnimations().map(settled))));
      labelEl.hidden = true;
      chars.forEach((el) => el.getAnimations().forEach((animation) => animation.cancel()));
      await waitMs(c.hold);
      if (id !== playId) return;
      let exitPromise = Promise.resolve();
      if (c.emailVsCheck >= 0) {
        checkEl.classList.remove('is-in');
        checkEl.classList.add('is-out');
        const checkDone = waitCheckTransition(c.checkMs);
        if (c.emailVsCheck > 0) await waitMs(c.emailVsCheck);
        exitPromise = playEmailAndReturn(reduce, chars);
        await checkDone;
      } else {
        exitPromise = playEmailAndReturn(reduce, chars);
        await waitMs(-c.emailVsCheck);
        checkEl.classList.remove('is-in');
        checkEl.classList.add('is-out');
        await waitCheckTransition(c.checkMs);
      }
      checkEl.hidden = true;
      checkEl.classList.remove('is-out', 'is-reduced');
      await exitPromise;
      input.readOnly = false;
      button.removeAttribute('aria-busy');
      celebrating = false;
      if (id !== playId) return;
      await waitMs(c.placeholderWait);
      await revealPlaceholder(id);
    };
    panel?.querySelector('[data-replay]')?.addEventListener('click', () => {
      if (celebrating || !input) return;
      if (!input.value.trim()) input.value = lastEmail || 'jternus@apple.com';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      void playSuccess();
    });
    let shakes: Animation[] = [];
    const dismissStatus = () => {
      clearTimeout(statusTimer);
      form.classList.remove('is-error', 'has-status');
    };
    const showStatus = (message: string, error = false) => {
      dismissStatus();
      if (statusMessage) {
        statusMessage.textContent = message;
        statusMessage.classList.toggle('project-signup__error', error);
      }
      form.classList.add('has-status');
      form.classList.toggle('is-error', error);
      statusTimer = setTimeout(dismissStatus, 2500);
    };
    const emailChecker = document.createElement('input');
    emailChecker.type = 'email';
    const updateShortcut = () => {
      if (!input || !shortcut) return;
      input.setCustomValidity('');
      emailChecker.value = input.value;
      if (emailChecker.validity.typeMismatch) {
        input.setCustomValidity('Enter a valid email address.');
      }
      if (input.validity.valid && !validTlds.has(input.value.split('.').at(-1)!.toLowerCase())) {
        input.setCustomValidity('Enter an email with a recognized TLD (like .com, .net, .org, etc...)');
      }
      shortcut.classList.toggle('is-valid', input.validity.valid);
      if ((celebrating) && input.value.length > 0) {
        shortcut.hidden = false;
        shortcut.classList.add('is-inert');
        return;
      }
      shortcut.classList.remove('is-inert');
      shortcut.hidden = input.value.length === 0 || document.activeElement !== input;
      input.dispatchEvent(new CustomEvent('vcd:text-field-sync', { bubbles: true }));
    };
    input?.addEventListener('input', () => {
      updateShortcut();
      dismissStatus();
      input.removeAttribute('aria-invalid');
    });
    input?.addEventListener('change', updateShortcut);
    input?.addEventListener('focus', updateShortcut);
    updateShortcut();
    field?.addEventListener('pointerdown', () => { field.dataset.pointerFocus = ''; });
    input?.addEventListener('blur', (event) => {
      if (field) delete field.dataset.pointerFocus;
      const toSubmit = event.relatedTarget instanceof Node && Boolean(button?.contains(event.relatedTarget));
      if (toSubmit && shortcut) {
        shortcut.classList.add('is-inert');
        return;
      }
      updateShortcut();
    });
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && field) delete field.dataset.pointerFocus;
      if (event.key === 'Enter' && !event.isComposing) {
        event.preventDefault();
        if (event.repeat) return;
        clearTimeout(pressTimer);
        button?.classList.add('is-keyboard-pressed');
        pressTimer = setTimeout(() => button?.classList.remove('is-keyboard-pressed'), 150);
        form.requestSubmit();
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (celebrating) return;
      updateShortcut();
      dismissStatus();
      if (!input) return;
      if (!input.value.trim()) {
        input.removeAttribute('aria-invalid');
        showStatus('The email address input is empty.');
        return;
      }
      if (!input.validity.valid) {
        input.setAttribute('aria-invalid', 'true');
        showStatus(input.validity.patternMismatch
          ? 'Enter a valid email address.'
          : input.validationMessage, true);
        shakes.forEach((animation) => animation.cancel());
        shakes = [];
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          shakes = [field, surface].filter((element): element is HTMLElement => !!element).map((element) => element.animate(
            [0, -4, 4, -3, 3, 0].map((x) => ({ transform: `translateX(${x}px)` })),
            { duration: 300, easing: 'ease-in-out' },
          ));
        }
        return;
      }
      input.removeAttribute('aria-invalid');
      lastEmail = input.value.trim();
      void playSuccess();
    });
  });
</script>

<style>
  .project-signup {
    --stagger: 10;
    --char-ms: 500;
    --move: 8;
    --taper: 20;
    --scale-to: 0.97;
    --blur: 10;
    --overlap: 400;
    --check-ms: 160;
    --hold: 1400;
    --email-vs-check: 100;
    --anticipate: 10;
    --anticipate-ms: 100;
    --anticipate-ease: cubic-bezier(0.4, 0.05, 0.6, 0.95);
    --squash: 0.1;
    --store-ms: 70;
    --email-ms: 500;
    --release-ease: cubic-bezier(0.5, 0, 0.75, 0.16);
    --release-accel: 12000;
