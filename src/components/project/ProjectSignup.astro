---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';
import TextField from '../ui/TextField.astro';

interface Props {
  label?: string;
  placeholder?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
}

const {
  label = 'Get involved',
  placeholder = 'jternus@apple.com',
  documentKey,
  sectionPath,
  spacing = 'group',
  sectionId,
  contentId,
} = Astro.props;
const statusId = `signup-status-${sectionId ?? Math.random().toString(36).slice(2, 8)}`;
const editable = import.meta.env.DEV && documentKey && sectionPath;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', 'project-signup', projectStackClass(spacing), sectionId && 'section-block']}
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={editable ? 'signup' : undefined}
>
  <form class="project-signup__form" data-project-signup-form novalidate>
    <div class="project-signup__control">
      <span class="project-signup__surface" aria-hidden="true"></span>
      <TextField
        class="project-signup__field"
        label="Email address"
        hideLabel
        pattern={String.raw`[^@\s]+@[^@\s]+\.[^@\s]+`}
        required
        autocomplete="email"
        inputmode="email"
        autocapitalize="none"
        spellcheck="false"
        placeholder={placeholder}
        aria-describedby={statusId}
        data-signup-email
      >
        <span slot="trail" class="project-signup__shortcut" data-signup-shortcut data-text-field-trail hidden aria-hidden="true">⏎</span>
      </TextField>
      <div class="project-signup__action">
        <button type="submit" aria-label={label} aria-keyshortcuts="Enter">
          <span class="project-signup__label" data-signup-label aria-hidden="true">{label}</span>
          <span class="project-signup__check" data-signup-check hidden aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
        </button>
      </div>
    </div>
    <div id={statusId} class="project-signup__status" data-signup-status aria-live="polite" aria-atomic="true">
      <p class="project-signup__status-message" data-signup-status-message></p>
    </div>
  </form>
</section>

<script>
  import tlds from 'tlds';

  const validTlds = new Set(tlds.map((tld) => new URL(`https://${tld}`).hostname));
  // Design-review only; replace this handler with the signup API before enabling subscriptions.
  document.querySelectorAll<HTMLFormElement>('[data-project-signup-form]').forEach((form) => {
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const input = form.querySelector<HTMLInputElement>('[data-signup-email]');
    const field = form.querySelector<HTMLElement>('.project-signup__field');
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    let pressTimer: ReturnType<typeof setTimeout>;
    const shortcut = form.querySelector<HTMLElement>('[data-signup-shortcut]');
    const statusMessage = form.querySelector<HTMLElement>('[data-signup-status-message]');
    const surface = form.querySelector<HTMLElement>('.project-signup__surface');
    let statusTimer: ReturnType<typeof setTimeout>;
    const labelEl = form.querySelector<HTMLElement>('[data-signup-label]');
    const checkEl = form.querySelector<HTMLElement>('[data-signup-check]');
    let celebrating = false;
    if (labelEl && labelEl.dataset.split !== 'true') {
      const text = labelEl.textContent ?? '';
      labelEl.textContent = '';
      [...text].forEach((ch) => {
        const span = document.createElement('span');
        span.className = 'project-signup__char';
        span.textContent = ch === ' ' ? '\u00a0' : ch;
        span.dataset.char = '';
        labelEl.append(span);
      });
      labelEl.dataset.split = 'true';
    }
    const waitMs = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const settled = (animation: Animation) => animation.finished.catch(() => undefined);
    const waitCheckTransition = (ms: number) => new Promise<void>((resolve) => {
      if (!checkEl) return resolve();
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        checkEl.removeEventListener('transitionend', onEnd);
        resolve();
      };
      const onEnd = (event: TransitionEvent) => {
        if (event.target === checkEl && event.propertyName === 'opacity') finish();
      };
      checkEl.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, ms + 80);
    });
    const showCheck = async (reduceMotion: boolean, ms: number) => {
      if (!checkEl) return;
      checkEl.hidden = false;
      checkEl.classList.toggle('is-reduced', reduceMotion);
      checkEl.classList.remove('is-in');
      void checkEl.offsetWidth;
      await new Promise<void>((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      });
      checkEl.classList.add('is-in');
      await waitCheckTransition(ms);
    };
    const hideCheck = async (ms: number) => {
      if (!checkEl) return;
      checkEl.classList.remove('is-in');
      await waitCheckTransition(ms);
      checkEl.hidden = true;
      checkEl.classList.remove('is-reduced');
    };
    const playSuccess = async () => {
      if (!button || !labelEl || !checkEl || celebrating) return;
      celebrating = true;
      button.setAttribute('aria-busy', 'true');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chars = [...labelEl.querySelectorAll<HTMLElement>('[data-char]')];
      const n = chars.length;
      const center = Math.max(n - 1, 1) / 2;
      const stagger = 32;
      const duration = 220;
      const ease = 'cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      const maxMove = 18;
      await Promise.all(chars.map((el, i) => {
        const fromEdge = Math.min(i, n - 1 - i);
        const dist = Math.abs(i - center) / center;
        const dir = i < center ? 1 : i > center ? -1 : 0;
        const x = reduce ? 0 : dir * maxMove * dist;
        const scale = reduce ? 1 : 0.97;
        const blur = reduce ? 0 : 4;
        return settled(el.animate(
          [
            { opacity: 1, filter: 'blur(0px)', transform: 'translateX(0) scale(1)' },
            { opacity: 0, filter: `blur(${blur}px)`, transform: `translateX(${x}px) scale(${scale})` },
          ],
          { duration, delay: fromEdge * stagger, easing: ease, fill: 'forwards' },
        ));
      }));
      labelEl.hidden = true;
      chars.forEach((el) => el.getAnimations().forEach((animation) => animation.cancel()));
      await showCheck(reduce, duration);
      await waitMs(2000);
      await hideCheck(duration);
      labelEl.hidden = false;
      await settled(labelEl.animate(
        reduce
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
            { opacity: 0, filter: 'blur(4px)' },
            { opacity: 1, filter: 'blur(0px)' },
          ],
        { duration, easing: ease, fill: 'forwards' },
      ));
      labelEl.getAnimations().forEach((animation) => animation.cancel());
      button.removeAttribute('aria-busy');
      celebrating = false;
    };
    let shakes: Animation[] = [];
    const dismissStatus = () => {
      clearTimeout(statusTimer);
      form.classList.remove('is-error', 'has-status');
    };
    const showStatus = (message: string, error = false) => {
      dismissStatus();
      if (statusMessage) {
        statusMessage.textContent = message;
        statusMessage.classList.toggle('project-signup__error', error);
      }
      form.classList.add('has-status');
      form.classList.toggle('is-error', error);
      statusTimer = setTimeout(dismissStatus, 2500);
    };
    const emailChecker = document.createElement('input');
    emailChecker.type = 'email';
    const updateShortcut = () => {
      if (!input || !shortcut) return;
      input.setCustomValidity('');
      emailChecker.value = input.value;
      if (emailChecker.validity.typeMismatch) {
        input.setCustomValidity('Enter a valid email address.');
      }
      if (input.validity.valid && !validTlds.has(input.value.split('.').at(-1)!.toLowerCase())) {
        input.setCustomValidity('Enter an email with a recognized TLD (like .com, .net, .org, etc...)');
      }
      shortcut.hidden = input.value.length === 0 || document.activeElement !== input;
      shortcut.classList.toggle('is-valid', input.validity.valid);
      input.dispatchEvent(new CustomEvent('vcd:text-field-sync', { bubbles: true }));
    };
    input?.addEventListener('input', () => {
      updateShortcut();
      dismissStatus();
      input.removeAttribute('aria-invalid');
    });
    input?.addEventListener('change', updateShortcut);
    input?.addEventListener('focus', updateShortcut);
    updateShortcut();
    field?.addEventListener('pointerdown', () => { field.dataset.pointerFocus = ''; });
    input?.addEventListener('blur', () => {
      if (field) delete field.dataset.pointerFocus;
      updateShortcut();
    });
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && field) delete field.dataset.pointerFocus;
      if (event.key === 'Enter' && !event.isComposing) {
        event.preventDefault();
        if (event.repeat) return;
        clearTimeout(pressTimer);
        button?.classList.add('is-keyboard-pressed');
        pressTimer = setTimeout(() => button?.classList.remove('is-keyboard-pressed'), 150);
        form.requestSubmit();
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (celebrating || form.dataset.protoPlaying === 'true') return;
      updateShortcut();
      dismissStatus();
      if (!input) return;
      if (!input.value.trim()) {
        input.removeAttribute('aria-invalid');
        showStatus('The email address input is empty.');
        return;
      }
      if (!input.validity.valid) {
        input.setAttribute('aria-invalid', 'true');
        showStatus(input.validity.patternMismatch
          ? 'Enter a valid email address.'
          : input.validationMessage, true);
        shakes.forEach((animation) => animation.cancel());
        shakes = [];
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          shakes = [field, surface].filter((element): element is HTMLElement => !!element).map((element) => element.animate(
            [0, -4, 4, -3, 3, 0].map((x) => ({ transform: `translateX(${x}px)` })),
            { duration: 300, easing: 'ease-in-out' },
          ));
        }
        return;
      }
      input.removeAttribute('aria-invalid');
      if (form.closest('[data-signup-proto]')) {
        form.dispatchEvent(new CustomEvent('signup:proto-success', { bubbles: true }));
        return;
      }
      showStatus('Signup is not available yet.');
      void playSuccess();
    });
  });
</script>

<style>
  .project-signup__form {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-related);
    max-width: 40em;
  }

  .project-signup__status {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--sys-color-on-srf-subtle);
    font-size: var(--text-input-status-size);
    font-weight: var(--text-input-status-weight);
    line-height: var(--text-input-status-leading);
    letter-spacing: var(--text-input-status-tracking);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s 180ms;
  }

  .project-signup__form.has-status .project-signup__status {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .project-signup__form.is-error .project-signup__surface {
    /* Softer than status text: keep full --sys-color-error on .project-signup__error only. */
    outline-color: color-mix(in srgb, var(--sys-color-error) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-signup__status { transform: none; }
  }

  .project-signup__control {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    align-items: center;
    gap: 0.25rem;
    min-height: 3.125rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
  }

  .project-signup__surface {
    outline: 2px solid transparent;
    outline-offset: 0;
    transition: outline-color 180ms ease;
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--sys-color-srf-container-lowest);
    pointer-events: none;
  }

  .project-signup__control button {
    display: grid;
    place-items: center;
    position: relative;
    width: 100%;
    min-height: 2.625rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
    cursor: pointer;
    font: 400 1.1rem / 1 var(--font-sans);
    /* Same press cue as .dev-btn: filled hover/active share one colour, so scale is the click signal. */
    transition: background-color 0.2s ease, transform var(--motion-press-duration) ease-out;
  }

  .project-signup__control button::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .project-signup__label,
  .project-signup__check {
    grid-area: 1 / 1;
  }

  .project-signup__label {
    display: inline-flex;
    white-space: nowrap;
  }

  .project-signup__char {
    display: inline-block;
  }

  .project-signup__label[hidden],
  .project-signup__check[hidden] {
    display: none;
  }

  .project-signup__check:not([hidden]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.97);
    filter: blur(4px);
    -webkit-filter: blur(4px);
    transition-property: opacity, transform, filter, -webkit-filter;
    transition-duration: 220ms;
    transition-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .project-signup__check.is-in {
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
    -webkit-filter: blur(0px);
  }

  .project-signup__check.is-reduced {
    transform: none;
    filter: none;
    -webkit-filter: none;
    transition-property: opacity;
  }

  .project-signup__check svg {
    display: block;
  }

  .project-signup__action {
    position: relative;
    min-width: 0;
  }

  .project-signup__shortcut {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 1;
    padding: 0 0 0 0.4em;
    color: var(--sys-color-on-srf-subtle);
    font-size: 0.8125rem;
    line-height: 1;
    pointer-events: none;
    transform: translateY(-50%);
    transition: color 150ms ease;
  }

  .project-signup__shortcut:not([hidden]) {
    animation: shortcut-enter 180ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @keyframes shortcut-enter {
    from {
      opacity: 0;
      filter: blur(2px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-signup__shortcut:not([hidden]) {
      animation-name: shortcut-fade;
    }
  }

  @keyframes shortcut-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .project-signup__shortcut.is-valid {
    color: var(--sys-color-on-srf);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-signup__control button:hover {
      background: var(--comp-button-filled-container-hover);
    }
  }

  .project-signup__control button:active,
  .project-signup__control button.is-keyboard-pressed {
    background: var(--comp-button-filled-container-hover);
    transform: scale(var(--motion-press-scale));
  }

  .project-signup__control button:focus-visible {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: 2px;
  }

  .project-signup__status-message { margin: 0; }

  .project-signup__error { color: var(--sys-color-error); }

  :global(.project-signup__field) {
    min-width: 0;
    width: 100%;
  }

  :global(.project-signup__field .dev-field__value) {
    min-width: 0;
    width: 100%;
    padding: 0;
    border-radius: 0.5rem;
    background: transparent;
  }

  /* Pointer/tap focus stays quiet: kill shared TextField hover fill + focus-within inset ring. */
  :global(.project-signup__field:hover .dev-field__value),
  :global(.project-signup__field .dev-field__value:focus-within) {
    background: transparent;
    box-shadow: none;
  }

  :global(.project-signup__field .dev-text-field) {
    --dev-text-field-edge-gutter: 12px;
    --dev-text-field-fade-surface: var(--sys-color-srf-container-lowest);
    min-width: 0;
    width: 100%;
    background: transparent;
  }

  :global(.project-signup__field:hover .dev-text-field),
  :global(.project-signup__field:focus-within .dev-text-field) {
    --dev-text-field-fade-surface: var(--sys-color-srf-container-lowest);
  }

  :global(.project-signup__field .dev-text-field__content) {
    padding-block: 0;
    padding-inline-start: 0.75rem;
    padding-inline-end: calc(0.75rem + var(--dev-text-field-trail-end, 0px));
  }

  :global(.project-signup__field .dev-field__input) {
    appearance: none;
    height: 2.625rem;
    margin: 0;
    padding: 0;
    outline: 0;
    -webkit-tap-highlight-color: transparent;
    color: var(--sys-color-on-srf);
    font: 400 1.1rem / 1 var(--font-sans);
  }

  :global(.project-signup__field .dev-field__input::placeholder) {
    color: var(--sys-color-on-srf-subtle);
    opacity: 1;
  }

  :global(.project-signup__field:not([data-pointer-focus]) .dev-field__value:has(input:focus-visible)) {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: -2px;
  }

  @media (max-width: 40em) {
    .project-signup__control {
      grid-template-columns: minmax(0, 1fr) 8.5rem;
    }

    /* Match phone body (0.875rem / 14px). Lifts the 16px iOS anti-zoom floor. */
    .project-signup__control button,
    :global(.project-signup__field .dev-field__input) {
      font-size: var(--text-body-size);
    }
  }
</style>
