---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';

interface Props {
  label?: string;
  placeholder?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
}

const {
  label = 'Get involved',
  placeholder = 'jternus@apple.com',
  documentKey,
  sectionPath,
  spacing = 'group',
  sectionId,
  contentId,
} = Astro.props;
const editable = import.meta.env.DEV && documentKey && sectionPath;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', 'project-signup', projectStackClass(spacing), sectionId && 'section-block']}
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={editable ? 'signup' : undefined}
>
  <form class="project-signup__form" data-project-signup-form>
    <div class="project-signup__control">
      <input
        type="email"
        pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
        required
        autocomplete="email"
        autocapitalize="none"
        spellcheck="false"
        placeholder={placeholder}
        aria-label="Email address"
      />
      <div class="project-signup__action">
        <span class="project-signup__shortcut" data-signup-shortcut hidden aria-hidden="true">
          Cmd/Ctrl + ⏎
          <svg class="project-signup__shortcut-tail" width="24" height="10" viewBox="0 0 24 10" focusable="false">
            <path d="M0 0 C4 0 5 0 7 3 L10 7 Q12 10 14 7 L17 3 C19 0 20 0 24 0 Z" />
          </svg>
        </span>
        <button type="submit" aria-keyshortcuts="Meta+Enter Control+Enter">{label}</button>
      </div>
    </div>
    <p class="project-signup__status" data-project-signup-status aria-live="polite" hidden>
      Signup is not available yet.
    </p>
  </form>
</section>

<script>
  // Design-review only; replace this handler with the signup API before enabling subscriptions.
  document.querySelectorAll<HTMLFormElement>('[data-project-signup-form]').forEach((form) => {
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const input = form.querySelector('input');
    const shortcut = form.querySelector<HTMLElement>('[data-signup-shortcut]');
    const updateShortcut = () => {
      if (!input || !shortcut) return;
      shortcut.hidden = input.value.length === 0;
      shortcut.classList.toggle('is-valid', input.validity.valid);
    };
    input?.addEventListener('input', updateShortcut);
    input?.addEventListener('change', updateShortcut);
    updateShortcut();
    input?.addEventListener('pointerdown', () => { input.dataset.pointerFocus = ''; });
    input?.addEventListener('blur', () => { delete input.dataset.pointerFocus; });
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') delete input.dataset.pointerFocus;
      if (event.key === 'Enter' && (event.metaKey || event.ctrlKey) && !event.isComposing) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-project-signup-status]');
      if (status) status.hidden = false;
    });
  });
</script>

<style>
  .project-signup__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-related);
    max-width: 40em;
  }

  .project-signup__control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    align-items: center;
    gap: 0.25rem;
    min-height: 3.125rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
    background: var(--sys-color-srf-container-lowest);
  }

  .project-signup__control input {
    appearance: none;
    width: 100%;
    min-width: 0;
    height: 2.625rem;
    min-height: 2.625rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    outline: 0;
    background: transparent;
    color: var(--sys-color-on-srf);
    font: 400 max(1rem, var(--text-body-size)) / 1 var(--font-sans);
  }

  .project-signup__control input::placeholder {
    color: var(--sys-color-on-srf-subtle);
    opacity: 1;
  }

  .project-signup__control input:focus-visible:not([data-pointer-focus]) {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: -2px;
  }

  .project-signup__control button {
    position: relative;
    width: 100%;
    min-height: 2.625rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
    cursor: pointer;
    font: 400 max(1rem, var(--text-body-size)) / 1 var(--font-sans);
  }

  .project-signup__control button::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .project-signup__action {
    position: relative;
    min-width: 0;
  }

  .project-signup__shortcut {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(100% + 1rem);
    padding: 0.375rem 0.5rem;
    border-radius: 0.5rem;
    background: var(--sys-color-srf-container-low);
    color: var(--sys-color-on-srf-subtle);
    font-size: 0.8125rem;
    line-height: 1.25;
    white-space: nowrap;
    pointer-events: none;
    transition: color 150ms ease;
  }

  .project-signup__shortcut-tail {
    position: absolute;
    top: calc(100% - 1px);
    left: 50%;
    transform: translateX(-50%);
    fill: var(--sys-color-srf-container-low);
  }

  .project-signup__shortcut.is-valid {
    color: var(--sys-color-on-srf);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-signup__control button:hover {
      background: var(--comp-button-filled-container-hover);
    }
  }

  .project-signup__control button:focus-visible {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: 2px;
  }

  .project-signup__status {
    margin: 0;
    color: var(--sys-color-on-srf-variant);
    font-size: var(--text-body-size);
  }

  @media (max-width: 40em) {
    .project-signup__control {
      grid-template-columns: minmax(0, 1fr) 8.5rem;
    }
  }
</style>
