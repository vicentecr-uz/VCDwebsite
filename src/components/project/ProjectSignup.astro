---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';
import TextField from '../ui/TextField.astro';

interface Props {
  label?: string;
  placeholder?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
}

const {
  label = 'Get involved',
  placeholder = 'johns.tern@apple.com',
  documentKey,
  sectionPath,
  spacing = 'group',
  sectionId,
  contentId,
} = Astro.props;
const statusId = `signup-status-${sectionId ?? Math.random().toString(36).slice(2, 8)}`;
const editable = import.meta.env.DEV && documentKey && sectionPath;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', 'project-signup', projectStackClass(spacing), sectionId && 'section-block']}
  data-signup-motion
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={editable ? 'signup' : undefined}
>
  <form class="project-signup__form" data-project-signup-form novalidate>
    <div class="project-signup__control">
      <span class="project-signup__surface" aria-hidden="true"></span>
      <TextField
        class="project-signup__field dev-field--quiet"
        label="Email address"
        hideLabel
        pattern={String.raw`[^@\s]+@[^@\s]+\.[^@\s]+`}
        required
        autocomplete="email"
        inputmode="email"
        autocapitalize="none"
        spellcheck="false"
        placeholder={placeholder}
        aria-describedby={statusId}
        data-signup-email
      >
        <span slot="trail" class="project-signup__shortcut" data-signup-shortcut data-text-field-trail hidden aria-hidden="true">⏎</span>
      </TextField>
      <div class="project-signup__action">
        <button type="submit" aria-label={label} aria-keyshortcuts="Enter">
          <span class="project-signup__label" data-signup-label aria-hidden="true">{label}</span>
          <span class="project-signup__check" data-signup-check hidden aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
        </button>
      </div>
    </div>
    <div id={statusId} class="project-signup__status" data-signup-status aria-live="polite" aria-atomic="true">
      <p class="project-signup__status-message" data-signup-status-message></p>
    </div>
  </form>
</section>

<script>
  import tlds from 'tlds';
  import {
    animateRelease,
    readSignupMotionCfg,
    throwDurationMs,
  } from '../../scripts/signupSuccessMotion';
  import { waitForSignupViewportSettlement } from '../../lib/signupViewport';

  const validTlds = new Set(tlds.map((tld) => new URL(`https://${tld}`).hostname));
  document.querySelectorAll<HTMLFormElement>('[data-project-signup-form]').forEach((form) => {
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const motionRoot = form.closest<HTMLElement>('[data-signup-motion]');
    const input = form.querySelector<HTMLInputElement>('[data-signup-email]');
    const field = form.querySelector<HTMLElement>('.project-signup__field');
    const textField = form.querySelector<HTMLElement>('.dev-text-field');
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    let pressTimer: ReturnType<typeof setTimeout>;
    const shortcut = form.querySelector<HTMLElement>('[data-signup-shortcut]');
    const statusMessage = form.querySelector<HTMLElement>('[data-signup-status-message]');
    const surface = form.querySelector<HTMLElement>('.project-signup__surface');
    let statusTimer: ReturnType<typeof setTimeout>;
    const labelEl = form.querySelector<HTMLElement>('[data-signup-label]');
    const checkEl = form.querySelector<HTMLElement>('[data-signup-check]');
    let celebrating = false;
    let submitting = false;
    let playId = 0;
    let ghost: HTMLElement | null = null;
    let lastBlurAt = Number.NEGATIVE_INFINITY;
    if (labelEl && labelEl.dataset.split !== 'true') {
      const text = labelEl.textContent ?? '';
      labelEl.textContent = '';
      [...text].forEach((ch) => {
        const span = document.createElement('span');
        span.className = 'project-signup__char';
        span.textContent = ch === ' ' ? '\u00a0' : ch;
        span.dataset.char = '';
        labelEl.append(span);
      });
      labelEl.dataset.split = 'true';
    }
    const waitMs = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const settled = (animation: Animation) => animation.finished.catch(() => undefined);
    const waitCheckTransition = (ms: number) => new Promise<void>((resolve) => {
      if (!checkEl) return resolve();
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        checkEl.removeEventListener('transitionend', onEnd);
        resolve();
      };
      const onEnd = (event: TransitionEvent) => {
        if (event.target === checkEl && event.propertyName === 'opacity') finish();
      };
      checkEl.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, ms + 80);
    });
    const teardownGhost = () => {
      ghost?.remove();
      ghost = null;
      input?.classList.remove('is-signup-ghosted');
      textField?.classList.remove('is-signup-fade');
    };
    const mountEmailGhost = (className: string, text: string) => {
      const track = textField?.querySelector('.dev-text-field__track');
      if (!input || !textField || !track) return null;
      const next = document.createElement('span');
      next.className = className;
      next.setAttribute('aria-hidden', 'true');
      const style = getComputedStyle(input);
      const inputRect = input.getBoundingClientRect();
      const trackRect = track.getBoundingClientRect();
      next.style.font = style.font;
      next.style.letterSpacing = style.letterSpacing;
      next.style.left = `${inputRect.left - trackRect.left + track.scrollLeft}px`;
      next.style.top = `${inputRect.top - trackRect.top}px`;
      next.style.height = `${inputRect.height}px`;
      next.textContent = text;
      track.append(next);
      ghost = next;
      return next;
    };
    const prepareThrow = (reduce: boolean) => {
      if (!input || !motionRoot) return null;
      const c = readSignupMotionCfg(motionRoot);
      const emailEl = reduce ? null : mountEmailGhost('project-signup__email-ghost', input.value);
      if (emailEl) {
        input.classList.add('is-signup-ghosted');
        textField?.classList.add('is-signup-fade');
      }
      const fadeWidth = Number.parseFloat(
        getComputedStyle(textField ?? document.documentElement)
          .getPropertyValue('--dev-text-field-fade-width'),
      ) || 22;
      const travelPx = emailEl && textField
        ? textField.getBoundingClientRect().right - emailEl.getBoundingClientRect().left + fadeWidth
        : 0;
      const throwDistance = Math.max(0, travelPx + c.anticipate);
      const throwMs = reduce || c.accel <= 0 || c.vmax <= 0
        ? c.emailMs
        : throwDurationMs(throwDistance, c.accel, c.vmax, c.emailMs / c.speed) * c.speed;
      const runEmail = async () => {
        if (reduce) {
          input.classList.add('is-signup-ghosted');
          await settled(input.animate(
            [{ opacity: 1 }, { opacity: 0 }],
            { duration: c.emailMs, easing: c.ease, fill: 'forwards' },
          ));
          return;
        }
        if (!emailEl) return;
        if (c.anticipate > 0 && c.anticipateMs > 0) {
          const windup = emailEl.animate(
            [
              { transform: 'translateX(0) scaleX(1) scaleY(1)' },
              { transform: `translateX(${-c.anticipate}px) scaleX(${1 - c.squash}) scaleY(${1 + c.squash})` },
            ],
            { duration: c.anticipateMs, easing: c.anticipateEase, fill: 'forwards' },
          );
          await settled(windup);
          windup.commitStyles();
          windup.cancel();
          if (c.storeMs > 0) await waitMs(c.storeMs);
        }
        const release = animateRelease(
          emailEl,
          -c.anticipate,
          travelPx,
          1 - c.squash,
          1 + c.squash,
          1 + c.stretch,
          1 - c.stretch,
          c,
        );
        await release.finished;
      };
      return { c, throwMs, runEmail };
    };
    const finishEmail = () => {
      if (!input) return;
      input.classList.add('is-signup-placeholder-pending');
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.getAnimations().forEach((animation) => animation.cancel());
      teardownGhost();
    };
    const playThrowFirst = async (
      reduce: boolean,
      chars: HTMLElement[],
      token: number,
    ) => {
      if (!labelEl || !motionRoot) return;
      const prepared = prepareThrow(reduce);
      if (!prepared) return;
      const { c, throwMs, runEmail } = prepared;
      const n = chars.length;
      const start = reduce ? 0 : c.anticipateMs + c.storeMs + c.returnAt * throwMs;
      const span = reduce ? Math.max(0, n - 1) * 30 : c.returnSpan * throwMs;
      const lastOutEnd = start + (n <= 1 ? 0 : span) + c.returnMs;
      const checkInAt = Math.max(0, lastOutEnd + c.checkVsLast);
      const emailDone = runEmail();
      const giOut = chars.map((el, i) => el.animate(
        reduce
          ? [{ opacity: 1 }, { opacity: 0 }]
          : [
            { opacity: 1, filter: 'blur(0px)', transform: 'scale(1)' },
            { opacity: 0, filter: `blur(${c.blur}px)`, transform: `scale(${c.scale})` },
          ],
        {
          duration: c.returnMs,
          delay: start + (n <= 1 ? 0 : (i / (n - 1)) * span),
          easing: c.ease,
          fill: 'both',
        },
      ));
      const giOutDone = Promise.all(giOut.map(settled));
      await waitMs(checkInAt);
      if (token !== playId) return;
      if (checkEl) {
        checkEl.hidden = false;
        checkEl.classList.toggle('is-reduced', reduce);
        checkEl.classList.remove('is-in', 'is-out');
        void checkEl.offsetWidth;
        await new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));
        checkEl.classList.add('is-in');
        await waitCheckTransition(c.checkMs);
      }
      if (token !== playId) return;
      await waitMs(c.hold);
      if (token !== playId) return;
      const checkOut = (async () => {
        if (!checkEl) return;
        checkEl.classList.remove('is-in');
        checkEl.classList.add('is-out');
        await waitCheckTransition(c.checkMs);
        checkEl.hidden = true;
        checkEl.classList.remove('is-out', 'is-reduced');
      })();
      await giOutDone;
      if (token !== playId) return;
      chars.forEach((el) => {
        el.getAnimations().forEach((animation) => animation.cancel());
        el.style.cssText = '';
      });
      finishEmail();
      const giIn = labelEl.animate(
        reduce
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
            { opacity: 0, filter: `blur(${c.inBlur}px)`, transform: `scale(${c.scale})` },
            { opacity: 1, filter: 'blur(0px)', transform: 'scale(1)' },
          ],
        { duration: c.inMs, easing: c.ease, fill: 'both' },
      );
      const placeholderIn = revealPlaceholder(token, { duration: c.inMs, blur: c.inBlur });
      await Promise.all([emailDone, checkOut, placeholderIn, settled(giIn)]);
      chars.forEach((el) => {
        el.style.cssText = '';
        el.getAnimations().forEach((animation) => animation.cancel());
      });
      giIn.cancel();
      labelEl.style.cssText = '';
    };
    const revealPlaceholder = async (
      id: number,
      motion?: { duration: number; blur?: number },
    ) => {
      if (!input || !motionRoot || id !== playId) return;
      const c = readSignupMotionCfg(motionRoot);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (input.value.trim()) {
        input.classList.remove('is-signup-placeholder-pending');
        return;
      }
      const next = mountEmailGhost('project-signup__email-ghost is-placeholder', input.placeholder);
      if (!next) {
        input.classList.remove('is-signup-placeholder-pending');
        return;
      }
      const duration = motion?.duration ?? 320 * c.speed;
      const blur = motion?.blur ?? 4;
      await settled(next.animate(
        reduce
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
            { opacity: 0, filter: `blur(${blur}px)` },
            { opacity: 1, filter: 'blur(0px)' },
          ],
        { duration, easing: c.ease, fill: 'forwards' },
      ));
      if (id !== playId) return;
      input.classList.remove('is-signup-placeholder-pending');
      next.remove();
      if (ghost === next) ghost = null;
    };
    const playSuccess = async () => {
      if (!button || !labelEl || !checkEl || !input || !motionRoot || celebrating) return;
      const id = ++playId;
      celebrating = true;
      form.classList.add('is-celebrating');
      button.setAttribute('aria-busy', 'true');
      shortcut?.classList.add('is-inert');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chars = [...labelEl.querySelectorAll<HTMLElement>('[data-char]')];
      await playThrowFirst(reduce, chars, id);
      if (id !== playId) return;
      button.removeAttribute('aria-busy');
      celebrating = false;
      form.classList.remove('is-celebrating');
    };
    let shakes: Animation[] = [];
    const dismissStatus = () => {
      clearTimeout(statusTimer);
      form.classList.remove('is-error', 'has-status');
    };
    const showStatus = (message: string, error = false) => {
      dismissStatus();
      if (statusMessage) {
        statusMessage.textContent = message;
        statusMessage.classList.toggle('project-signup__error', error);
      }
      form.classList.add('has-status');
      form.classList.toggle('is-error', error);
      statusTimer = setTimeout(dismissStatus, 2500);
    };
    const shakeInvalid = () => {
      shakes.forEach((animation) => animation.cancel());
      shakes = [];
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        shakes = [field, surface].filter((element): element is HTMLElement => !!element).map((element) => element.animate(
          [0, -4, 4, -3, 3, 0].map((x) => ({ transform: `translateX(${x}px)` })),
          { duration: 300, easing: 'ease-in-out' },
        ));
      }
    };
    const emailChecker = document.createElement('input');
    emailChecker.type = 'email';
    const updateShortcut = () => {
      if (!input || !shortcut) return;
      input.setCustomValidity('');
      emailChecker.value = input.value;
      if (emailChecker.validity.typeMismatch) {
        input.setCustomValidity('Enter a valid email address.');
      }
      if (input.validity.valid && !validTlds.has(input.value.split('.').at(-1)!.toLowerCase())) {
        input.setCustomValidity('Enter an email with a recognized TLD (like .com, .net, .org, etc...)');
      }
      shortcut.classList.toggle('is-valid', input.validity.valid);
      if (celebrating) {
        shortcut.classList.add('is-inert');
        return;
      }
      shortcut.classList.remove('is-inert');
      shortcut.hidden = input.value.length === 0 || document.activeElement !== input;
      input.dispatchEvent(new CustomEvent('vcd:text-field-sync', { bubbles: true }));
    };
    input?.addEventListener('input', () => {
      updateShortcut();
      dismissStatus();
      input.removeAttribute('aria-invalid');
    });
    input?.addEventListener('change', updateShortcut);
    input?.addEventListener('focus', updateShortcut);
    updateShortcut();
    field?.addEventListener('pointerdown', () => { field.dataset.pointerFocus = ''; });
    input?.addEventListener('blur', (event) => {
      lastBlurAt = performance.now();
      if (field) delete field.dataset.pointerFocus;
      const toSubmit = event.relatedTarget instanceof Node && Boolean(button?.contains(event.relatedTarget));
      if (toSubmit && shortcut) {
        shortcut.classList.add('is-inert');
        return;
      }
      updateShortcut();
    });
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && field) delete field.dataset.pointerFocus;
      if (event.key === 'Enter' && !event.isComposing) {
        event.preventDefault();
        if (event.repeat) return;
        clearTimeout(pressTimer);
        button?.classList.add('is-keyboard-pressed');
        pressTimer = setTimeout(() => button?.classList.remove('is-keyboard-pressed'), 150);
        form.requestSubmit();
      }
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (celebrating || submitting) return;
      updateShortcut();
      dismissStatus();
      if (!input) return;
      if (!input.value.trim()) {
        input.removeAttribute('aria-invalid');
        showStatus('The email address input is empty.');
        return;
      }
      if (!input.validity.valid) {
        input.setAttribute('aria-invalid', 'true');
        showStatus(input.validity.patternMismatch
          ? 'Enter a valid email address.'
          : input.validationMessage, true);
        shakeInvalid();
        return;
      }
      input.removeAttribute('aria-invalid');
      submitting = true;
      button?.setAttribute('aria-busy', 'true');
      const email = input.value.trim();
      const keyboardSettled = waitForSignupViewportSettlement(input, lastBlurAt);
      if (document.activeElement === input) input.blur();
      input.readOnly = true;
      try {
        const response = await fetch('/api/signup', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        let errorText = '';
        try {
          const payload = await response.json() as { error?: unknown };
          if (typeof payload?.error === 'string') errorText = payload.error;
        } catch {
          // non-JSON body
        }
        if (response.status === 200) {
          await keyboardSettled;
          if (form.isConnected) await playSuccess();
          return;
        }
        if (response.status === 502 || response.status === 503) {
          showStatus(errorText || 'Signup is not available yet.');
        } else if (response.status >= 400 && response.status < 500) {
          showStatus(errorText || 'Signup is not available yet.', true);
          if (response.status === 400) {
            input.setAttribute('aria-invalid', 'true');
            shakeInvalid();
          }
        } else {
          showStatus(errorText || 'Signup is not available yet.');
        }
      } catch {
        showStatus('Signup is not available yet.');
      } finally {
        input.readOnly = false;
        submitting = false;
        if (!celebrating) button?.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .project-signup {
    --stagger: 10;
    --char-ms: 500;
    --move: 8;
    --taper: 20;
    --scale-to: 0.97;
    --blur: 10;
    --overlap: 400;
    --check-ms: 160;
    --hold: 1000;
    --email-vs-check: 100;
    --anticipate: 10;
    --anticipate-ms: 100;
    --anticipate-ease: cubic-bezier(0.4, 0.05, 0.6, 0.95);
    --squash: 0.1;
    --store-ms: 70;
    --email-ms: 500;
    --release-ease: cubic-bezier(0.5, 0, 0.75, 0.16);
    --release-accel: 12000;
    --release-vmax: 1600;
    --stretch: 0.1;
    --return-at: 80;
    --return-span: 40;
    --return-ms: 300;
    --check-vs-last: 0;
    --gi-in-stagger: 50;
    --gi-in-move: 14;
    --gi-in-blur: 12;
    --gi-in-ms: 320;
    --placeholder-wait: 400;
    --speed: 1;
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
  }

  .project-signup__form {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-related);
    max-width: 40em;
  }

  .project-signup__status {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--sys-color-on-srf-subtle);
    font-size: var(--text-input-status-size);
    font-weight: var(--text-input-status-weight);
    line-height: var(--text-input-status-leading);
    letter-spacing: var(--text-input-status-tracking);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s 180ms;
  }

  .project-signup__form.has-status .project-signup__status {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .project-signup__form.is-error .project-signup__surface {
    /* Softer than status text: keep full --sys-color-error on .project-signup__error only. */
    outline-color: color-mix(in srgb, var(--sys-color-error) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-signup__status { transform: none; }
  }

  .project-signup__control {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    align-items: center;
    gap: 0.25rem;
    min-height: 3.125rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
  }

  .project-signup__surface {
    outline: 2px solid transparent;
    outline-offset: 0;
    transition: outline-color 180ms ease;
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--sys-color-srf-container-lowest);
    pointer-events: none;
  }

  .project-signup__control button {
    display: grid;
    place-items: center;
    position: relative;
    width: 100%;
    min-height: 2.625rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
    cursor: pointer;
    font: 400 1.1rem / 1 var(--font-sans);
    /* Same press cue as .dev-btn: filled hover/active share one colour, so scale is the click signal. */
    transition: background-color 0.2s ease, transform var(--motion-press-duration) ease-out;
  }

  .project-signup__control button::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .project-signup__label,
  .project-signup__check {
    grid-area: 1 / 1;
  }

  .project-signup__label {
    display: inline-flex;
    white-space: nowrap;
  }

  .project-signup__char {
    display: inline-block;
  }

  .project-signup__label[hidden],
  .project-signup__check[hidden] {
    display: none;
  }

  .project-signup__check:not([hidden]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(1.03);
    filter: blur(4px);
    -webkit-filter: blur(4px);
    transition-property: opacity, transform, filter, -webkit-filter;
    transition-duration: 160ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }

  .project-signup__check.is-in {
    opacity: 1;
    transform: scale(1);
    filter: blur(0px);
    -webkit-filter: blur(0px);
  }

  .project-signup__check.is-out {
    opacity: 0;
    transform: scale(0.97);
    filter: blur(4px);
    -webkit-filter: blur(4px);
  }

  .project-signup__check.is-reduced {
    transform: none;
    filter: none;
    -webkit-filter: none;
    transition-property: opacity;
  }

  .project-signup__check svg {
    display: block;
  }

  .project-signup__action {
    position: relative;
    min-width: 0;
  }

  .project-signup__shortcut {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 1;
    padding: 0 0 0 0.4em;
    color: var(--sys-color-on-srf-subtle);
    font-size: 0.8125rem;
    line-height: 1;
