---
import { projectImage, projectImageTier, projectVideoPoster } from '../../lib/images';
import {
  imageGridColumnsStyle,
  imageGridConstrainedStyle,
  resolveImageGridColumns,
  resolveImageGridConstrained,
  type ImageGridColumns,
  type ImageGridConstrained,
  type ImageGridLayouts,
  type ImageVariants,
} from '../../lib/responsiveImage';
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';
import {
  imageCaptionStyleClass,
  imageCaptionsHaveText,
  isBelowImageCaptionStyle,
  BELOW_IMAGE_CAPTION_REVEALS,
  resolveImageCaptionPosition,
  resolveImageCaptionReveals,
  resolveImageCaptionStyle,
  resolveImageCaptions,
  type ImageCaptionPositionId,
  type ImageCaptionReveal,
  type ImageCaptionReveals,
  type ImageCaptionStyleId,
  type ImageCaptions,
} from '../../lib/imageCaptions';
import {
  gridItemLayoutStyle,
  imageDevEditAttrs,
  joinMediaStyles,
  isPlaceholderSrc,
  resolveGridItemCrop,
  resolveGridItemLayout,
} from '../../lib/projectImageFrame';
import { placeholderLabelText } from '../../lib/placeholderLabel';
import { imageBackgroundStyle, normalizeImageBackground } from '../../lib/imageBackground.mjs';
import { isVideoSrc } from '../../lib/imageUpload.mjs';
import ProjectImageCarousel from './ProjectImageCarousel.astro';

interface Item {
  id?: string;
  src?: string;
  alt?: string;
  /** Legacy single caption (all breakpoints). Prefer `captions`. */
  caption?: string;
  /** Per-breakpoint caption text. Smaller breakpoints inherit when omitted. */
  captions?: Partial<ImageCaptions> | string;
  captionStyle?: ImageCaptionStyleId;
  /** Overlay bottom-edge alignment. Defaults to left. */
  captionPosition?: ImageCaptionPositionId;
  /** Per-breakpoint reveal: hover | always. Defaults desktop=hover, tablet/mobile=always. */
  captionReveal?: ImageCaptionReveal | Partial<ImageCaptionReveals>;
  crop?: { x?: number; y?: number; zoom?: number };
  variants?: ImageVariants;
  srcWidth?: number;
  srcHeight?: number;
  mobileInset?: boolean;
  background?: string;
  /** @deprecated Prefer layouts.mobile — kept for one-off legacy items. */
  hideOnMobile?: boolean;
  type?: string;
  items?: Item[];
  orientation?: 'horizontal' | 'vertical';
  heightMode?: 'dynamic' | 'tallest';
  maxHeightVh?: number;
  scrollPinned?: boolean;
  dotsPlacement?: 'outside' | 'over' | 'hidden';
  visible?: string[];
  breakpoints?: Record<string, unknown>;
  defaultAspectRatio?: string;
}

interface Props {
  items: Item[];
  columns?: ImageGridColumns;
  /** Default aspect for cells without their own variants. */
  defaultAspectRatio?: string;
  /** Per-breakpoint width constraint (30–90%, or 100 / omitted for full width). */
  constrained?: ImageGridConstrained;
  /** Per-breakpoint visible order. Smaller breakpoints inherit unless overridden. */
  layouts?: ImageGridLayouts;
  /**
   * Scale cells in each row to a shared height (widths follow aspect ratios).
   * Best with defaultAspectRatio "original" or mixed aspect cells.
   */
  matchHeight?: boolean;
  /** Editing wiring: which project JSON + path to this grid section. */
  document?: string;
  basePath?: (string | number)[];
  spacing?: ProjectStackSpacing;
  /** Anchor id for section sidebar nav scrollspy. */
  sectionId?: string;
  contentId?: string;
}

const {
  items,
  columns: columnsProp = 2,
  defaultAspectRatio = '1:1',
  constrained: constrainedProp,
  layouts: layoutsProp,
  matchHeight = false,
  document: documentKey,
  basePath,
  spacing = 'group',
  sectionId,
  contentId,
} = Astro.props;

const columns = resolveImageGridColumns(columnsProp);
const constrained = resolveImageGridConstrained(constrainedProp);
const itemIds = items.map((item, index) => item.id ?? `item-${index}`);

/** Seed mobile hide from legacy hideOnMobile when no layouts.mobile override exists. */
const layouts: ImageGridLayouts = { ...(layoutsProp ?? {}) };
if (!layouts.mobile && items.some((item) => item.hideOnMobile)) {
  layouts.mobile = {
    visible: itemIds.filter((_, index) => !items[index]?.hideOnMobile),
  };
}

const resolvedLayouts = resolveGridItemLayout(itemIds, layouts);
const showDevEditing = import.meta.env.DEV && !!documentKey && Array.isArray(basePath);
/** Single-row grids still need the editor — e.g. 3-wide desktop → 1-wide mobile. */
const showGridEditor = showDevEditing;
const stackClass = projectStackClass(spacing);
const spacingAttrs = spacingDevAttrs(documentKey, basePath, spacing, { contentId });

const editorItems = items.map((item, index) => ({
  id: itemIds[index],
  src: projectImage(String(item.src ?? item.items?.[0]?.src ?? '')),
  alt: item.alt ?? '',
  background: normalizeImageBackground(item.background) ?? 'transparent',
}));
---

<div
  id={sectionId}
  class:list={[
    'project-image-grid',
    matchHeight && 'project-image-grid--match-height',
    stackClass,
    sectionId && 'section-block',
    showGridEditor && 'dev-grid-edit-target',
  ]}
  style={`${imageGridColumnsStyle(columns)};${imageGridConstrainedStyle(constrained)};`}
  data-match-height={matchHeight ? 'true' : 'false'}
  data-dev-grid-target={showGridEditor ? 'grid' : undefined}
  data-dev-document={showGridEditor ? documentKey : undefined}
  data-dev-grid-path={showGridEditor ? JSON.stringify(basePath) : undefined}
  data-dev-grid-columns={showGridEditor ? JSON.stringify(columns) : undefined}
  data-dev-grid-constrained={showGridEditor ? JSON.stringify(constrained) : undefined}
  data-dev-grid-default-aspect={showGridEditor ? defaultAspectRatio : undefined}
  data-dev-grid-match-height={showGridEditor ? (matchHeight ? 'true' : 'false') : undefined}
  data-dev-grid-layouts={showGridEditor ? JSON.stringify(layouts) : undefined}
  data-dev-grid-items={showGridEditor ? JSON.stringify(editorItems) : undefined}
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={showDevEditing ? 'imageGrid' : undefined}
>
  {showGridEditor && (
    <button
      type="button"
      class="dev-grid-edit-trigger"
      data-dev-edit-trigger="grid"
      data-dev-corner="top-left"
      data-dev-mode-only
      hidden
    >
      Edit grid
    </button>
  )}
  {items.map((item, index) => {
    const itemId = itemIds[index];
    const mobileVisibleIndex = resolvedLayouts.mobile.visible.indexOf(itemId);
    const mobileBleedEligible = constrained.mobile === 100 && (
      columns.mobile === 1
      || (matchHeight && columns.mobile > 1
        && resolvedLayouts.mobile.visible.length % columns.mobile === 1
        && mobileVisibleIndex === resolvedLayouts.mobile.visible.length - 1)
    );
    const { hasOwnVariants, variants, style: variantStyle } = resolveGridItemCrop({ ...item, src: String(item.src ?? '') }, defaultAspectRatio);
    const layoutStyle = gridItemLayoutStyle(itemId, resolvedLayouts);
    const captions = resolveImageCaptions({ caption: item.caption, captions: item.captions });
    const captionStyle = resolveImageCaptionStyle(item.captionStyle);
    const captionPosition = resolveImageCaptionPosition(item.captionPosition, captionStyle);
    const isBelowCaption = isBelowImageCaptionStyle(captionStyle);
    const captionReveals = isBelowCaption
      ? BELOW_IMAGE_CAPTION_REVEALS
      : resolveImageCaptionReveals(item.captionReveal);
    const hasCaption = imageCaptionsHaveText(captions);
    const captionClass = imageCaptionStyleClass(captionStyle);
    const isPlaceholder = isPlaceholderSrc(String(item.src ?? ''));
    const isVideo = isVideoSrc(String(item.src ?? ''));
    const videoPoster = isVideo ? projectVideoPoster(String(item.src ?? '')) : undefined;
    const isNestedCarousel = item.type === 'imageCarousel' && Array.isArray(item.items);
    const itemLabelPath = showDevEditing ? [...basePath!, 'items', index, 'alt'] : undefined;
    const editAttrs = showDevEditing
      ? imageDevEditAttrs(true, {
          documentKey: documentKey!,
          path: [...basePath!, 'items', index],
          cropId: itemId,
          variants,
          authoredVariants: item.variants ?? {},
          src: item.src,
          srcWidth: item.srcWidth,
          srcHeight: item.srcHeight,
          caption: item.caption,
          captions: item.captions,
          captionStyle: item.captionStyle,
          captionPosition: item.captionPosition,
          captionReveal: item.captionReveal,
          gridDefaultAspect: defaultAspectRatio,
          hasOwnVariants,
          mobileInset: item.mobileInset,
          background: normalizeImageBackground(item.background) ?? 'transparent',
        })
      : {};
    const captionNode = hasCaption ? (
      <span
        class:list={['project-caption', 'project-image-grid__caption', captionClass]}
        data-project-image-caption
        data-caption-style={captionStyle}
        data-caption-position={captionPosition}
        data-caption-reveal-desktop={captionReveals.desktop}
        data-caption-reveal-tablet={captionReveals.tablet}
        data-caption-reveal-mobile={captionReveals.mobile}
      >
        <span class="project-image-grid__caption-bp project-image-grid__caption-bp--desktop" data-caption-bp="desktop">{captions.desktop}</span>
        <span class="project-image-grid__caption-bp project-image-grid__caption-bp--tablet" data-caption-bp="tablet">{captions.tablet}</span>
        <span class="project-image-grid__caption-bp project-image-grid__caption-bp--mobile" data-caption-bp="mobile">{captions.mobile}</span>
      </span>
    ) : null;
    if (isNestedCarousel) {
      return (
        <div
          class="project-image-grid__item"
          style={joinMediaStyles(layoutStyle, imageBackgroundStyle(item.background))}
          data-grid-item-id={itemId}
          data-dev-item-path={showDevEditing ? JSON.stringify([...basePath!, 'items', index]) : undefined}
          data-grid-hidden-desktop={resolvedLayouts.desktop.hidden.includes(itemId) ? 'true' : 'false'}
          data-grid-hidden-tablet={resolvedLayouts.tablet.hidden.includes(itemId) ? 'true' : 'false'}
          data-grid-hidden-mobile={resolvedLayouts.mobile.hidden.includes(itemId) ? 'true' : 'false'}
          data-mobile-inset={item.mobileInset === true ? 'true' : 'false'}
          data-mobile-bleed-eligible={mobileBleedEligible ? 'true' : 'false'}
        >
          <ProjectImageCarousel
            items={item.items! as never}
            orientation={item.orientation}
            heightMode={item.heightMode}
            maxHeightVh={item.maxHeightVh}
            scrollPinned={item.scrollPinned}
            dotsPlacement={item.dotsPlacement}
            visible={item.visible}
            breakpoints={item.breakpoints as never}
            defaultAspectRatio={item.defaultAspectRatio ?? defaultAspectRatio}
            constrained={{ desktop: 100, tablet: 100, mobile: 100 }}
            document={documentKey}
            basePath={showDevEditing ? [...basePath!, 'items', index] : undefined}
            spacing="none"
            nested
            mobileBleedEligible={mobileBleedEligible}
          />
        </div>
      );
    }
    return (
      <figure
        class:list={[
          'project-image-grid__item',
          'project-responsive-image',
          isPlaceholder && 'project-media--placeholder',
          showDevEditing && 'dev-image-edit-target',
        ]}
        style={joinMediaStyles(variantStyle, layoutStyle, imageBackgroundStyle(item.background))}
        data-grid-item-id={itemId}
        data-grid-hidden-desktop={resolvedLayouts.desktop.hidden.includes(itemId) ? 'true' : 'false'}
        data-grid-hidden-tablet={resolvedLayouts.tablet.hidden.includes(itemId) ? 'true' : 'false'}
        data-grid-hidden-mobile={resolvedLayouts.mobile.hidden.includes(itemId) ? 'true' : 'false'}
        {...editAttrs}
        data-mobile-inset={item.mobileInset === true ? 'true' : 'false'}
        data-mobile-bleed-eligible={mobileBleedEligible ? 'true' : 'false'}
      >
        <div class="project-image-grid__frame">
          {isVideo ? <video
            src={projectImage(item.src)}
            poster={videoPoster}
            aria-label={item.alt || 'Video'}
            class="project-image-grid__image project-inline-video"
            controls
            playsinline
            preload="metadata"
            data-project-inline-video
          /> : <img
            src={projectImageTier(item.src, 'thumb')}
            data-image-preview={isPlaceholder ? undefined : projectImageTier(item.src, 'preview')}
            alt={item.alt ?? ''}
            class="project-image-grid__image"
            loading="eager"
          />}
          {isPlaceholder && (
            <span class="project-media__placeholder-label" aria-hidden="true">
              <span
                class="project-media__placeholder-label-text"
                data-dev-text-document={showDevEditing ? documentKey : undefined}
                data-dev-text-path={itemLabelPath ? JSON.stringify(itemLabelPath) : undefined}
                data-dev-text-kind={showDevEditing ? 'text' : undefined}
              >{placeholderLabelText(item.alt ?? '')}</span>
            </span>
          )}
          {!isBelowCaption && captionNode}
        </div>
        <div class="project-image-grid__below-slot">
          {isBelowCaption && captionNode}
        </div>
        {showDevEditing && (
          <button
            type="button"
            class="dev-caption-add-trigger"
            data-dev-edit-trigger="caption"
            data-caption-action="add"
            data-dev-mode-only
            hidden
          >
            Add caption
          </button>
        )}
        {showDevEditing && (
          <button
            type="button"
            class="dev-image-edit-trigger"
            data-dev-edit-trigger="image"
            data-dev-mode-only
            hidden
          >
            Edit image
          </button>
        )}
      </figure>
    );
  })}
</div>

<script>
  import { bindProjectCropCovers } from '../../lib/projectCropCover';
  import { bindAllPlaceholderLabels } from '../../lib/placeholderLabel';

  bindProjectCropCovers();
  bindAllPlaceholderLabels();

  window.addEventListener('vcd:dev-section-inserted', () => {
    bindAllPlaceholderLabels();
  });
</script>
