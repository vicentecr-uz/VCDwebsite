---
import { projectImage } from '../../lib/images';
import {
  imageGridColumnsStyle,
  imageGridConstrainedStyle,
  imageGridItemLayoutStyle,
  normalizeImageVariants,
  resolveImageGridColumns,
  resolveImageGridConstrained,
  resolveImageGridLayouts,
  responsiveImageStyle,
  type ImageGridColumns,
  type ImageGridConstrained,
  type ImageGridLayouts,
  type ImageVariants,
} from '../../lib/responsiveImage';
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';

interface Item {
  id?: string;
  src: string;
  alt?: string;
  caption?: string;
  crop?: { x?: number; y?: number; zoom?: number };
  variants?: ImageVariants;
  /** @deprecated Prefer layouts.mobile — kept for one-off legacy items. */
  hideOnMobile?: boolean;
}

interface Props {
  items: Item[];
  columns?: ImageGridColumns;
  /** Default aspect for cells without their own variants. */
  defaultAspectRatio?: string;
  /** Per-breakpoint width constraint (30–90%, or 100 / omitted for full width). */
  constrained?: ImageGridConstrained;
  /** Per-breakpoint visible order. Smaller breakpoints inherit unless overridden. */
  layouts?: ImageGridLayouts;
  /** Editing wiring: which project JSON + path to this grid section. */
  document?: string;
  basePath?: (string | number)[];
  spacing?: ProjectStackSpacing;
  /** Anchor id for section sidebar nav scrollspy. */
  sectionId?: string;
}

const {
  items,
  columns: columnsProp = 2,
  defaultAspectRatio = '1:1',
  constrained: constrainedProp,
  layouts: layoutsProp,
  document: documentKey,
  basePath,
  spacing = 'section',
  sectionId,
} = Astro.props;

const columns = resolveImageGridColumns(columnsProp);
const constrained = resolveImageGridConstrained(constrainedProp);
const itemIds = items.map((item, index) => item.id ?? `item-${index}`);

/** Seed mobile hide from legacy hideOnMobile when no layouts.mobile override exists. */
const layouts: ImageGridLayouts = { ...(layoutsProp ?? {}) };
if (!layouts.mobile && items.some((item) => item.hideOnMobile)) {
  layouts.mobile = {
    visible: itemIds.filter((_, index) => !items[index]?.hideOnMobile),
  };
}

const resolvedLayouts = resolveImageGridLayouts(itemIds, layouts);
const showDevEditing = import.meta.env.DEV && !!documentKey && Array.isArray(basePath);
/** Single-row grids still need the editor — e.g. 3-wide desktop → 1-wide mobile. */
const showGridEditor = showDevEditing;
const stackClass = projectStackClass(spacing);
const spacingAttrs = spacingDevAttrs(documentKey, basePath, spacing);

const editorItems = items.map((item, index) => ({
  id: itemIds[index],
  src: projectImage(item.src),
  alt: item.alt ?? '',
}));
---

<div
  id={sectionId}
  class:list={[
    'project-image-grid',
    stackClass,
    sectionId && 'section-block',
    showGridEditor && 'dev-grid-edit-target',
  ]}
  style={`${imageGridColumnsStyle(columns)};${imageGridConstrainedStyle(constrained)};`}
  data-dev-grid-target={showGridEditor ? 'grid' : undefined}
  data-dev-document={showGridEditor ? documentKey : undefined}
  data-dev-grid-path={showGridEditor ? JSON.stringify(basePath) : undefined}
  data-dev-grid-columns={showGridEditor ? JSON.stringify(columns) : undefined}
  data-dev-grid-constrained={showGridEditor ? JSON.stringify(constrained) : undefined}
  data-dev-grid-default-aspect={showGridEditor ? defaultAspectRatio : undefined}
  data-dev-grid-layouts={showGridEditor ? JSON.stringify(layouts) : undefined}
  data-dev-grid-items={showGridEditor ? JSON.stringify(editorItems) : undefined}
  {...(spacingAttrs ?? {})}
>
  {showGridEditor && (
    <button
      type="button"
      class="dev-grid-edit-trigger"
      data-dev-edit-trigger="grid"
      data-dev-mode-only
      hidden
    >
      Edit grid
    </button>
  )}
  {items.map((item, index) => {
    const itemId = itemIds[index];
    const hasOwnVariants = !!item.variants;
    const variants = normalizeImageVariants(
      hasOwnVariants ? item.variants : undefined,
      defaultAspectRatio,
      item.crop,
    );
    const layoutStyle = imageGridItemLayoutStyle(itemId, resolvedLayouts);
    return (
      <figure
        class:list={[
          'project-image-grid__item',
          'project-responsive-image',
          showDevEditing && 'dev-image-edit-target',
        ]}
        style={`${responsiveImageStyle(variants)};${layoutStyle}`}
        data-grid-item-id={itemId}
        data-grid-hidden-desktop={resolvedLayouts.desktop.hidden.includes(itemId) ? 'true' : 'false'}
        data-grid-hidden-tablet={resolvedLayouts.tablet.hidden.includes(itemId) ? 'true' : 'false'}
        data-grid-hidden-mobile={resolvedLayouts.mobile.hidden.includes(itemId) ? 'true' : 'false'}
        data-dev-image-target={showDevEditing ? 'image' : undefined}
        data-dev-document={showDevEditing ? documentKey : undefined}
        data-dev-image-path={showDevEditing ? JSON.stringify([...basePath, 'items', index]) : undefined}
        data-dev-crop-id={showDevEditing ? itemId : undefined}
        data-dev-image-variants={showDevEditing ? JSON.stringify(variants) : undefined}
        data-dev-grid-default-aspect={showDevEditing ? defaultAspectRatio : undefined}
        data-dev-has-own-variants={showDevEditing && hasOwnVariants ? 'true' : undefined}
      >
        <img
          src={projectImage(item.src)}
          alt={item.alt ?? ''}
          class="project-image-grid__image"
          loading="lazy"
        />
        {item.caption && (
          <span class="project-caption project-image-grid__caption">{item.caption}</span>
        )}
        {showDevEditing && (
          <button
            type="button"
            class="dev-image-edit-trigger"
            data-dev-edit-trigger="image"
            data-dev-mode-only
            hidden
          >
            Edit image
          </button>
        )}
      </figure>
    );
  })}
</div>

<script>
  const initProjectImageGridCover = (frame: HTMLElement) => {
    if (frame.dataset.coverInitialized === 'true') return;
    frame.dataset.coverInitialized = 'true';
    const image = frame.querySelector<HTMLImageElement>('.project-image-grid__image');
    if (!image) return;

    const sizeToCover = () => {
      if (!image.naturalWidth || !image.naturalHeight) return;
      frame.style.setProperty(
        '--project-image-original-ratio',
        `${image.naturalWidth} / ${image.naturalHeight}`,
      );
      const frameWidth = frame.clientWidth;
      const frameHeight = frame.clientHeight;
      if (!frameWidth || !frameHeight) return;
      const scale = Math.max(
        (frameWidth + 2) / image.naturalWidth,
        (frameHeight + 2) / image.naturalHeight,
      );
      image.style.width = `${Math.ceil(image.naturalWidth * scale)}px`;
      image.style.height = `${Math.ceil(image.naturalHeight * scale)}px`;
    };

    image.addEventListener('load', sizeToCover);
    if (image.complete) sizeToCover();
    window.addEventListener('resize', sizeToCover);
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(sizeToCover).observe(frame);
    }
  };

  document
    .querySelectorAll<HTMLElement>('.project-image-grid__item')
    .forEach(initProjectImageGridCover);
</script>

<style>
  .project-image-grid {
    --project-image-grid-columns: var(--project-image-grid-columns-desktop, 2);
    --project-image-grid-width: var(--project-image-grid-width-desktop, 100%);
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--project-image-grid-columns), minmax(0, 1fr));
    gap: 1em;
    width: var(--project-image-grid-width);
    max-width: 100%;
    margin-inline: auto;
  }

  @media (max-width: 991px) {
    .project-image-grid {
      --project-image-grid-columns: var(--project-image-grid-columns-tablet, var(--project-image-grid-columns-desktop, 2));
      --project-image-grid-width: var(--project-image-grid-width-tablet, var(--project-image-grid-width-desktop, 100%));
    }
  }

  @media (max-width: 767px) {
    .project-image-grid {
      --project-image-grid-columns: var(--project-image-grid-columns-mobile, var(--project-image-grid-columns-tablet, var(--project-image-grid-columns-desktop, 2)));
      --project-image-grid-width: var(--project-image-grid-width-mobile, var(--project-image-grid-width-tablet, var(--project-image-grid-width-desktop, 100%)));
    }
  }

  .project-image-grid__item {
    position: relative;
    order: var(--project-image-grid-order-desktop, 0);
    aspect-ratio: var(--project-image-ratio);
    margin: 0;
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .project-image-grid__item[data-grid-hidden-desktop='true'] {
      display: none;
    }
  }

  @media (max-width: 991px) and (min-width: 768px) {
    .project-image-grid__item {
      order: var(--project-image-grid-order-tablet, var(--project-image-grid-order-desktop, 0));
    }

    .project-image-grid__item[data-grid-hidden-tablet='true'] {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .project-image-grid__item {
      order: var(--project-image-grid-order-mobile, var(--project-image-grid-order-tablet, var(--project-image-grid-order-desktop, 0)));
    }

    .project-image-grid__item[data-grid-hidden-mobile='true'] {
      display: none;
    }
  }

  .project-image-grid__image {
    position: absolute;
    top: calc(50% + var(--tapico-crop-y));
    left: calc(50% + var(--tapico-crop-x));
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: translate(-50%, -50%) scale(var(--tapico-crop-zoom));
    transform-origin: center;
  }

  .project-image-grid__caption {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .project-image-grid__item:hover .project-image-grid__caption,
  .project-image-grid__item:focus-within .project-image-grid__caption {
    opacity: 1;
  }

  @media (hover: none) {
    .project-image-grid__caption {
      display: none;
    }
  }
</style>
