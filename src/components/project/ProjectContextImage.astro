---
import { projectImage } from '../../lib/images';

interface Props {
  src: string;
  alt?: string;
  caption: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt = '', caption, loading = 'lazy' } = Astro.props;
---

<figure class="project-context-cell">
  <span class="project-context-caption">{caption}</span>
  <img src={projectImage(src)} alt={alt} class="project-context-cell__img" loading={loading} />
</figure>
