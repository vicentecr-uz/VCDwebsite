---
interface Props {
  /** Extra px below the computed centre-lock spacer (breathing room at max scroll). */
  spacerBufferPx?: number;
}

const { spacerBufferPx = 16 } = Astro.props;
---

<div
  class="project-scroll-finale"
  data-project-scroll-finale
  data-spacer-buffer={spacerBufferPx}
>
  <div class="project-scroll-finale__fade" data-project-scroll-finale-fade>
    <slot name="fade" />
  </div>
  <div class="project-scroll-finale__target" data-project-scroll-finale-target>
    <slot name="target" />
  </div>
  <div class="project-scroll-finale__spacer" data-project-scroll-finale-spacer aria-hidden="true"></div>
</div>

<script>
  const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

  const initScrollFinale = (root: HTMLElement) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const fadeWrap = root.querySelector('[data-project-scroll-finale-fade]');
    const targetWrap = root.querySelector('[data-project-scroll-finale-target]');
    const spacer = root.querySelector('[data-project-scroll-finale-spacer]');
    if (
      !(fadeWrap instanceof HTMLElement) ||
      !(targetWrap instanceof HTMLElement) ||
      !(spacer instanceof HTMLElement)
    ) {
      return;
    }

    const sidebar = document.querySelector('.section-sidebar-nav');
    const bufferPx = Number(root.dataset.spacerBuffer) || 16;
    const fadeRangePx = 96;
    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let scrollRafId = 0;
    let layoutRafId = 0;

    const measureTarget = () => {
      const rect = targetWrap.getBoundingClientRect();
      return {
        docTop: rect.top + window.scrollY,
        height: rect.height,
      };
    };

    /** Spacer height so max scroll places the finale image centre on the viewport centre. */
    const layoutSpacer = () => {
      spacer.style.height = '0px';

      const vh = window.innerHeight;
      const maxScrollBase = document.documentElement.scrollHeight - vh;
      const { docTop, height } = measureTarget();

      if (!height) return;

      const idealMaxScroll = docTop + height / 2 - vh / 2;
      const spacerHeight = Math.max(0, idealMaxScroll - maxScrollBase + bufferPx);

      spacer.style.height = `${spacerHeight}px`;
    };

    const scheduleLayout = () => {
      if (layoutRafId) return;
      layoutRafId = requestAnimationFrame(() => {
        layoutRafId = 0;
        layoutSpacer();
        updateFade();
      });
    };

    const updateFade = () => {
      scrollRafId = 0;

      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
      const distFromBottom = maxScroll - window.scrollY;

      const progress = prefersReducedMotion()
        ? distFromBottom <= 2
          ? 1
          : 0
        : clamp01(1 - distFromBottom / fadeRangePx);

      const fadeOpacity = 1 - progress;
      fadeWrap.style.opacity = fadeOpacity < 0.999 ? String(fadeOpacity) : '';
      root.classList.toggle('is-centered', progress >= 0.98);

      if (sidebar instanceof HTMLElement) {
        if (fadeOpacity < 0.999) {
          sidebar.style.opacity = String(fadeOpacity);
          sidebar.style.pointerEvents = fadeOpacity < 0.05 ? 'none' : '';
        } else {
          sidebar.style.opacity = '';
          sidebar.style.pointerEvents = '';
        }
      }
    };

    const scheduleFade = () => {
      if (scrollRafId) return;
      scrollRafId = requestAnimationFrame(updateFade);
    };

    layoutSpacer();
    updateFade();

    window.addEventListener('scroll', scheduleFade, { passive: true });
    window.addEventListener('resize', scheduleLayout);

    targetWrap.querySelectorAll('img').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      if (!img.complete) img.addEventListener('load', scheduleLayout, { once: true });
    });

    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(scheduleLayout);
      ro.observe(targetWrap);
      ro.observe(fadeWrap);
    }
  };

  document.querySelectorAll('[data-project-scroll-finale]').forEach((root) => {
    if (root instanceof HTMLElement) initScrollFinale(root);
  });
</script>

<style>
  .project-scroll-finale {
    background: var(--sys-color-srf, #ffffff);
  }

  .project-scroll-finale__fade {
    will-change: opacity;
  }

  .project-scroll-finale__target {
    margin-top: var(--space-section);
  }

  .project-scroll-finale__spacer {
    height: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-scroll-finale__fade {
      will-change: auto;
    }
  }
</style>
