---
interface Props {
  /** Extra px below the computed centre-lock spacer (breathing room at max scroll). */
  spacerBufferPx?: number;
}

const { spacerBufferPx = 16 } = Astro.props;
---

<div
  class="project-scroll-finale"
  data-project-scroll-finale
  data-spacer-buffer={spacerBufferPx}
>
  <div class="project-scroll-finale__spacer" data-project-scroll-finale-spacer aria-hidden="true"></div>
</div>

<script>
  import { createPageScope, onPageLoad } from '../../lib/pageLifecycle';
  const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

  const initScrollFinale = (root: HTMLElement) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const spacer = root.querySelector('[data-project-scroll-finale-spacer]');
    if (!(spacer instanceof HTMLElement) || !root.parentElement) return;

    const scope = createPageScope();
    const dropZone = root.parentElement;
    const sidebar = document.querySelector('.section-sidebar-nav');
    const html = document.documentElement;
    const bufferPx = Number(root.dataset.spacerBuffer) || 16;
    const fadeRangePx = 96;
    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let scrollRafId = 0;
    let layoutRafId = 0;
    let observedFade: HTMLElement | null = null;
    let observedTarget: HTMLElement | null = null;
    let resizeObserver: ResizeObserver | null = null;

    const getFinaleElements = () => {
      const children = Array.from(dropZone.children);
      const fade = children.find((child) =>
        child instanceof HTMLElement && child.dataset.projectScrollFinaleRole === 'fade') as HTMLElement | undefined;
      const target = children.find((child) =>
        child instanceof HTMLElement && child.dataset.projectScrollFinaleRole === 'target') as HTMLElement | undefined;
      const valid = fade !== undefined
        && target !== undefined
        && fade.nextElementSibling === target
        && target.nextElementSibling === root;
      return {
        fade: valid ? fade : null,
        target: valid ? target : null,
      };
    };

    const mediaFor = (section: HTMLElement | null) => {
      if (!section) return null;
      if (section.matches('.project-media, .project-image')) return section;
      return section.querySelector<HTMLElement>('.project-media, .project-image');
    };

    const setSidebarFade = (opacity: string) => {
      if (!(sidebar instanceof HTMLElement)) return;
      sidebar.style.opacity = opacity;
      sidebar.style.pointerEvents = opacity && Number(opacity) < 0.05 ? 'none' : '';
    };

    const resetFade = () => {
      const markedFade = Array.from(dropZone.children).find((child) =>
        child instanceof HTMLElement && child.dataset.projectScrollFinaleRole === 'fade') as HTMLElement | undefined;
      const media = mediaFor(markedFade ?? null);
      if (media) {
        media.style.opacity = '';
        media.inert = false;
      }
      root.classList.remove('is-centered');
      setSidebarFade('');
    };

    const syncObservedElements = (fade: HTMLElement | null, target: HTMLElement | null) => {
      if (!resizeObserver) return;
      if (observedFade !== fade) {
        if (observedFade) resizeObserver.unobserve(observedFade);
        observedFade = fade;
        if (observedFade) resizeObserver.observe(observedFade);
      }
      if (observedTarget !== target) {
        if (observedTarget) resizeObserver.unobserve(observedTarget);
        observedTarget = target;
        if (observedTarget) resizeObserver.observe(observedTarget);
      }
    };

    const measureTarget = (target: HTMLElement) => {
      const rect = target.getBoundingClientRect();
      return {
        docTop: rect.top + window.scrollY,
        height: rect.height,
      };
    };

    /** Spacer height so max scroll places the finale image centre on the viewport centre. */
    const layoutSpacer = () => {
      spacer.style.height = '0px';
      const { fade, target } = getFinaleElements();
      syncObservedElements(fade, target);
      if (!target || html.classList.contains('is-dev-mode')) return;

      const vh = window.innerHeight;
      const maxScrollBase = document.documentElement.scrollHeight - vh;
      const { docTop, height } = measureTarget(target);
      if (!height) return;

      const idealMaxScroll = docTop + height / 2 - vh / 2;
      const spacerHeight = Math.max(0, idealMaxScroll - maxScrollBase + bufferPx);
      spacer.style.height = `${spacerHeight}px`;
    };

    const updateFade = () => {
      scrollRafId = 0;
      const { fade, target } = getFinaleElements();
      syncObservedElements(fade, target);
      if (!fade || !target || html.classList.contains('is-dev-mode')) {
        resetFade();
        return;
      }

      const media = mediaFor(fade);
      if (!media) return;
      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
      const distFromBottom = maxScroll - window.scrollY;
      const progress = prefersReducedMotion()
        ? distFromBottom <= 2 ? 1 : 0
        : clamp01(1 - distFromBottom / fadeRangePx);
      const fadeOpacity = 1 - progress;

      media.style.opacity = fadeOpacity < 0.999 ? String(fadeOpacity) : '';
      media.inert = fadeOpacity < 0.05;
      root.classList.toggle('is-centered', progress >= 0.98);
      setSidebarFade(fadeOpacity < 0.999 ? String(fadeOpacity) : '');
    };

    const scheduleLayout = () => {
      if (layoutRafId) return;
      layoutRafId = scope.frame(() => {
        layoutRafId = 0;
        layoutSpacer();
        updateFade();
      });
    };

    if (typeof ResizeObserver !== 'undefined') {
      resizeObserver = new ResizeObserver(scheduleLayout);
    }

    const scheduleFade = () => {
      if (scrollRafId) return;
      scrollRafId = scope.frame(updateFade);
    };

    layoutSpacer();
    updateFade();

    scope.listen(window, 'scroll', scheduleFade, { passive: true });
    scope.listen(window, 'resize', scheduleLayout);
    scope.listen(window, 'vcd:dev-mode-change', scheduleLayout);

    const mutationObserver = typeof MutationObserver !== 'undefined'
      ? new MutationObserver(scheduleLayout)
      : null;
    mutationObserver?.observe(dropZone, { childList: true });

    dropZone.querySelectorAll<HTMLElement>('[data-project-scroll-finale-role] img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', scheduleLayout, { once: true });
    });
    return () => { scope.destroy(); resizeObserver?.disconnect(); mutationObserver?.disconnect(); resetFade(); delete root.dataset.initialized; };
  };

  const dispose = onPageLoad(() => {
    const cleanups = [...document.querySelectorAll<HTMLElement>('[data-project-scroll-finale]')].map(initScrollFinale);
    return () => cleanups.forEach((cleanup) => cleanup?.());
  });
  import.meta.hot?.dispose(dispose);
</script>

<style>
  .project-scroll-finale {
    margin-top: 0 !important;
    background: var(--sys-color-srf, #ffffff);
  }

  .project-scroll-finale__spacer {
    height: 0;
    margin: 0;
    pointer-events: none;
  }

  :global([data-project-scroll-finale-role='fade'] .project-media),
  :global([data-project-scroll-finale-role='fade'] .project-image) {
    will-change: opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-project-scroll-finale-role='fade'] .project-media),
    :global([data-project-scroll-finale-role='fade'] .project-image) {
      will-change: auto;
    }
  }
</style>
