import Button from '../../ui/Button.astro';
---

<vcd-reorder-demo>
  <section class="reorder-demo" aria-labelledby="reorder-demo-title">
    <div class="reorder-demo__header">
      <h1 id="reorder-demo-title">Block reorder</h1>
      <Button label="Reset" type="button" data-reorder-demo-reset />
    </div>

    <div class="reorder-demo__list" data-reorder-demo-list>
      {['Research', 'Sketch', 'Prototype', 'Refine'].map((title) => (
        <article class="reorder-demo__block" data-reorder-demo-block data-title={title}>
          <button class="reorder-demo__handle" type="button" data-reorder-demo-handle aria-label={`Move ${title}`}>
            <span aria-hidden="true">{title}</span>
            <span aria-hidden="true" class="reorder-demo__grip">↕</span>
          </button>
        </article>
      ))}
    </div>
    <div class="reorder-demo__status" aria-live="polite" aria-atomic="true"></div>
  </section>
</vcd-reorder-demo>

<style>
  vcd-reorder-demo {
    display: block;
    width: min(100%, 32em);
  }

  .reorder-demo {
    padding: calc(var(--space-unit) * 1.5);
    color: var(--sys-color-on-srf);
    background: var(--sys-color-srf);
    border: 1px solid var(--sys-color-srf-container-low);
    border-radius: var(--radius-card-smooth);
    box-shadow: var(--dev-panel-shadow);
  }

  .reorder-demo__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-unit);
    margin-bottom: var(--space-unit);
  }

  .reorder-demo h1 {
    margin: 0;
    font: var(--dev-text-panel-title);
  }

  .reorder-demo__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-unit);
    overflow-anchor: none;
  }

  .reorder-demo__block {
    position: relative;
    min-height: 4em;
    overflow-anchor: none;
    color: var(--sys-color-on-srf);
    background: var(--sys-color-srf-container-low);
    border: 1px solid var(--sys-color-srf-container);
    border-radius: var(--radius-control-smooth);
  }

  .reorder-demo__handle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 4em;
    padding: var(--space-unit);
    color: inherit;
    font: inherit;
    text-align: left;
    touch-action: none;
    background: transparent;
    border: 0;
    border-radius: inherit;
    cursor: grab;
  }

  .reorder-demo__handle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .reorder-demo__handle:active {
    cursor: grabbing;
  }

  .reorder-demo__grip {
    opacity: 0.55;
    font-size: 1.25em;
  }

  .reorder-demo__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(vcd-reorder-demo .vcd-reorder-demo__block.vcd-reorder-demo__lifted) {
    position: fixed;
    z-index: 100;
    margin: 0;
  }

  :global(vcd-reorder-demo .vcd-reorder-demo__block.vcd-reorder-demo__lifted.is-lifted-raised) {
    transform: scale(1.02);
    box-shadow: 0 0.85em 2.4em rgb(0 0 0 / 18%);
  }

  :global(vcd-reorder-demo .vcd-reorder-demo__indicator) {
    display: grid;
    grid-template-rows: var(--gap-top, 0px) auto var(--gap-bottom, 0px);
    margin: 0;
    padding: 0;
    overflow-anchor: none;
    pointer-events: none;
  }

  :global(vcd-reorder-demo .vcd-reorder-demo__indicator-body) {
    grid-row: 2;
    height: var(--gap-height, 0px);
    box-sizing: border-box;
    border: 2px dashed currentColor;
    border-radius: var(--radius-control-smooth);
    opacity: 0;
  }

  :global(vcd-reorder-demo .vcd-reorder-demo__indicator-body.vcd-reorder-demo__fade-ghost) {
    position: fixed;
    z-index: 99;
    margin: 0;
    pointer-events: none;
  }

  :global(vcd-reorder-demo .vcd-reorder-demo__flip) {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(vcd-reorder-demo .vcd-reorder-demo__block.vcd-reorder-demo__lifted.is-lifted-raised) {
      transform: none;
    }
  }

  @media (max-width: 40em) {
    .reorder-demo {
      padding: var(--space-unit);
    }
  }
</style>

<script>
  import { createReorderController } from '../../../scripts/sectionReorder';

  class BlockReorderDemo extends HTMLElement {
    private lifecycle?: AbortController;
    private controller?: ReturnType<typeof createReorderController>;
    private dragItem: HTMLElement | null = null;
    private dragHandle: HTMLButtonElement | null = null;
    private pointerId: number | null = null;
    private originalNodes: ChildNode[] = [];

    connectedCallback() {
      this.lifecycle?.abort();
      const lifecycle = new AbortController();
      this.lifecycle = lifecycle;
      const { signal } = lifecycle;
      const list = this.querySelector<HTMLElement>('[data-reorder-demo-list]');
      const reset = this.querySelector<HTMLButtonElement>('[data-reorder-demo-reset]');
      const status = this.querySelector<HTMLElement>('.reorder-demo__status');
      if (!list || !reset || !status) return;
      this.originalNodes = [...list.childNodes];

      const items = () => [...list.querySelectorAll<HTMLElement>('[data-reorder-demo-block]')]
        .filter((item) => item !== this.dragItem);
      const announce = () => {
        if (!this.dragItem) return;
        const state = this.controller?.getState();
        const position = state?.phase === 'lifted' ? state.targetIndex : items().indexOf(this.dragItem);
        if (position >= 0) status.textContent = `${this.dragItem.dataset.title} · ${position + 1}`;
      };
      const makeController = () => createReorderController({
        getItems: items,
        getDropZone: () => list,
        getDragItem: () => this.dragItem,
        classes: {
          indicator: 'vcd-reorder-demo__indicator',
          indicatorBody: 'vcd-reorder-demo__indicator-body',
          flipMoving: 'vcd-reorder-demo__flip',
          lifted: 'vcd-reorder-demo__lifted',
          fadeGhost: 'vcd-reorder-demo__fade-ghost',
        },
        measureLiftGaps: () => ({ top: '0px', bottom: '0px' }),
        measureInsertGaps: () => ({ top: '0px', bottom: '0px', marginTop: '0px' }),
        scrollTuning: { maxScrollSpeed: 0 }, // Fixture ceiling: no page auto-scroll; the full engine supports taller hosts.
        onStatus: announce,
      });
      this.controller = makeController();

      const restore = () => {
        this.controller?.destroy();
        this.controller = makeController();
        for (const node of this.originalNodes) list.append(node);
        this.dragItem = null;
        this.dragHandle = null;
        this.pointerId = null;
        status.textContent = '';
      };
      const finishDrop = async () => {
        const controller = this.controller;
        if (!controller) return;
        await controller.endDrop();
        if (controller !== this.controller || signal.aborted) return;
        this.dragItem = null;
        this.dragHandle = null;
        this.pointerId = null;
        status.textContent = '';
      };
      const pickUp = (item: HTMLElement, handle: HTMLButtonElement, x: number, y: number, followPointer = true) => {
        if (this.controller?.isActive()) return;
        const sourceIndex = items().indexOf(item);
        this.dragItem = item;
        this.dragHandle = handle;
        this.controller?.beginLift(item, handle, x, y, sourceIndex, { followPointer });
        announce();
      };
      const dropOrPick = (item: HTMLElement, handle: HTMLButtonElement, event: KeyboardEvent) => {
        event.preventDefault();
        if (this.dragItem === item && this.controller?.getState().phase === 'lifted') {
          void finishDrop();
          return;
        }
        if (!this.dragItem) pickUp(item, handle, 0, 0, false);
      };

      for (const item of items()) {
        const handle = item.querySelector<HTMLButtonElement>('[data-reorder-demo-handle]');
        if (!handle) continue;
        handle.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          event.preventDefault();
          pickUp(item, handle, event.clientX, event.clientY);
          this.pointerId = event.pointerId;
          handle.setPointerCapture(event.pointerId);
        }, { signal });
        handle.addEventListener('pointermove', (event) => {
          if (event.pointerId !== this.pointerId || this.dragItem !== item) return;
          this.controller?.setPointer(event.clientX, event.clientY);
        }, { signal });
        handle.addEventListener('pointerup', (event) => {
          if (event.pointerId !== this.pointerId || this.dragItem !== item) return;
          this.pointerId = null;
          void finishDrop();
        }, { signal });
        handle.addEventListener('pointercancel', (event) => {
          if (event.pointerId !== this.pointerId) return;
          restore();
        }, { signal });
        handle.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            restore();
            handle.focus();
            return;
          }
          if (event.key === ' ' || event.key === 'Enter') {
            dropOrPick(item, handle, event);
            return;
          }
          if (this.dragItem !== item || this.controller?.getState().phase !== 'lifted') return;
          const state = this.controller.getState();
          const max = items().length;
          const next = event.key === 'ArrowUp' ? state.targetIndex - 1
            : event.key === 'ArrowDown' ? state.targetIndex + 1
              : event.key === 'Home' ? 0 : event.key === 'End' ? max : null;
          if (next === null) return;
          event.preventDefault();
          this.controller.setTargetIndex(next);
          requestAnimationFrame(announce);
        }, { signal });
      }
      reset.addEventListener('click', restore, { signal });
    }

    disconnectedCallback() {
      this.lifecycle?.abort();
      this.controller?.destroy();
      this.controller = undefined;
      this.dragItem = null;
      this.dragHandle = null;
      this.pointerId = null;
      this.lifecycle = undefined;
    }
  }

  if (!customElements.get('vcd-reorder-demo')) customElements.define('vcd-reorder-demo', BlockReorderDemo);
</script>
