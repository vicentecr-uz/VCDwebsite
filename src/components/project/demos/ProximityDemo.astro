---
import Button from '../../ui/Button.astro';
import DevPanel from '../../ui/DevPanel.astro';
---

<vcd-proximity-demo>
  <DevPanel title="Proximity reveal" titleTag="h1" showLights={false} class="proximity-demo">
    <div class="proximity-demo__tiles" data-proximity-tiles>
      {['One', 'Two', 'Three'].map((label) => <div class="proximity-demo__tile" data-proximity-tile><Button label={label} type="button" aria-pressed="false" data-proximity-button /></div>)}
    </div>
  </DevPanel>
  <div class="demo-controls"><Button label="Start" type="button" aria-pressed="false" data-proximity-start /><Button label="Reset" type="button" data-proximity-reset /></div>
</vcd-proximity-demo>

<style>
  vcd-proximity-demo { display: block; width: min(100%, 28em); }
  .proximity-demo__tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-unit); }
  .proximity-demo__tile { display: grid; place-items: center; min-height: 8em; background: var(--sys-color-srf-container-low); border-radius: var(--radius-control-smooth); }
  .proximity-demo__tile :global(.dev-btn) { opacity: 0; pointer-events: none; transform: none; transition: opacity var(--motion-press-duration) ease; }
  .proximity-demo__tile[data-revealed] :global(.dev-btn), .proximity-demo__tile :global(.dev-btn:focus-visible), .proximity-demo__tile :global(.dev-btn[aria-pressed='true']) { opacity: 1; pointer-events: auto; }
  @media (pointer: coarse) { .proximity-demo__tile :global(.dev-btn) { opacity: 1; pointer-events: auto; min-height: 44px; } }
</style>

<script>
  import { createProximityReveal, type ProximityReveal } from '../../../scripts/proximityReveal';

  class ProximityDemo extends HTMLElement {
    private controller?: AbortController;
    private reveal?: ProximityReveal;

    connectedCallback() {
      this.controller?.abort();
      this.reveal?.destroy();
      const controller = new AbortController();
      this.controller = controller;
      const { signal } = controller;
      const tiles = [...this.querySelectorAll<HTMLElement>('[data-proximity-tile]')];
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-proximity-button]')];
      const start = this.querySelector<HTMLButtonElement>('[data-proximity-start]');
      const reset = this.querySelector<HTMLButtonElement>('[data-proximity-reset]');
      if (!start || !reset) return;
      const clear = () => {
        this.reveal?.destroy();
        this.reveal = undefined;
        tiles.forEach((tile) => tile.removeAttribute('data-revealed'));
      };
      const arm = () => {
        this.reveal = createProximityReveal({
          getTargets: () => tiles,
          isEnabled: () => this.dataset.started === 'true',
          setRevealed: (target) => {
            tiles.forEach((tile) => tile.removeAttribute('data-revealed'));
            target?.setAttribute('data-revealed', '');
          },
        });
        this.dataset.started = 'true';
      };
      start.addEventListener('click', () => {
        if (this.reveal) return;
        arm();
        start.setAttribute('aria-pressed', 'true');
      }, { signal });
      reset.addEventListener('click', () => {
        delete this.dataset.started;
        start.setAttribute('aria-pressed', 'false');
        buttons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
        clear();
      }, { signal });
      buttons.forEach((button) => button.addEventListener('click', () => {
        button.setAttribute('aria-pressed', button.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      }, { signal }));
    }
    disconnectedCallback() { this.controller?.abort(); this.controller = undefined; this.reveal?.destroy(); this.reveal = undefined; }
  }
  if (!customElements.get('vcd-proximity-demo')) customElements.define('vcd-proximity-demo', ProximityDemo);
</script>
