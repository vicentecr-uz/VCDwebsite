---
import '../../../styles/project.css';
import Button from '../../ui/Button.astro';
import EditorSelectField from '../../ui/EditorSelectField.astro';
import ProjectImage from '../ProjectImage.astro';
import { normalizeImageVariants } from '../../../lib/responsiveImage';
const pose = { aspect: '4:3', cx: 0.5, cy: 0.5, w: 0.8 };
const variants = normalizeImageVariants({ desktop: pose, tablet: pose, mobile: pose }, '4:3', { width: 4032, height: 3024 });
---

<vcd-crop-frame-demo data-crop-demo>
  <div class="crop-frame-demo__controls">
    <EditorSelectField label="Aspect ratio" value="4:3" options={[
      { value: '4:3', label: '4:3' }, { value: '1:1', label: '1:1' }, { value: '3:4', label: '3:4' },
    ]} />
  </div>
  <div class="crop-frame-demo__canvas">
    <ProjectImage kind="lead" src="IMG_2480.jpeg" srcWidth={4032} srcHeight={3024} variants={variants} spacing="none" loading="eager" alt="Disassembled utility knife on a cutting mat" />
  </div>
  <div class="demo-controls"><Button label="Reset" data-crop-reset /></div>
</vcd-crop-frame-demo>

<style>
  vcd-crop-frame-demo { display: block; width: min(100%, 38rem); }
  .crop-frame-demo__controls { width: 10rem; margin-bottom: var(--space-unit); }
  .crop-frame-demo__canvas { width: min(100%, 28rem, calc(22rem * var(--crop-demo-aspect, 1.333333))); margin-inline: auto; padding: var(--space-unit); }
  .crop-frame-demo__canvas :global(.project-image) { margin: 0; }
  .crop-frame-demo__canvas :global(.dev-crop-stage:focus-visible) { outline: 2px solid var(--sys-color-on-srf); outline-offset: 3px; }
</style>

<script>
  import { coverWidthFraction, normalizeImageVariants, responsiveImageStyle } from '../../../lib/responsiveImage';
  import { createImageCropStage, cropResizeHeight, type CropResizeDirection } from '../../../lib/imageCropStage';

  class CropFrameDemo extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      this.dispose?.();
      const host = this.querySelector<HTMLElement>('.project-image');
      const image = host?.querySelector<HTMLImageElement>('img');
      const select = this.querySelector<HTMLSelectElement>('select.dev-select__native');
      const reset = this.querySelector<HTMLButtonElement>('[data-crop-reset]');
      if (!host || !image || !select || !reset) return;
      const lifecycle = new AbortController();
      const { signal } = lifecycle;
      const { stage, ghost, ghostImg } = createImageCropStage({ src: image.dataset.imagePreview || image.src, document: this.ownerDocument });
      image.src = image.dataset.imagePreview || image.src;
      image.removeAttribute('role');
      image.removeAttribute('tabindex');
      image.removeAttribute('aria-label');
      host.classList.add('dev-crop-stage-host');
      host.prepend(ghost);
      host.append(stage);
      stage.style.inset = ghost.style.inset = '0';
      stage.classList.add('is-visible');
      ghost.classList.add('is-visible');
      stage.tabIndex = 0;
      stage.setAttribute('role', 'group');
      stage.setAttribute('aria-label', 'Crop image. Drag or use arrow keys to pan; use Ctrl+wheel or plus and minus to zoom. Drag an edge to resize.');

      const dims = { width: 4032, height: 3024 };
      const sourceAspect = dims.width / dims.height;
      const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
      let aspect = '4:3';
      let zoom = 1.25;
      let cx = 0.5;
      let cy = 0.5;
      let gesture: { id: number; x: number; y: number; cx: number; cy: number; width: number; height: number; direction?: CropResizeDirection } | undefined;
      const bounds = () => {
        const [a, b] = aspect.split(':').map(Number);
        const w = coverWidthFraction(aspect, sourceAspect) / zoom;
        return { w, h: w * sourceAspect / (a / b) };
      };
      const render = () => {
        const { w, h } = bounds();
        cx = clamp(cx, w / 2, 1 - w / 2);
        cy = clamp(cy, h / 2, 1 - h / 2);
        const pose = { aspect, cx, cy, w };
        host.style.cssText = responsiveImageStyle(normalizeImageVariants({ desktop: pose, tablet: pose, mobile: pose }, aspect, dims), dims);
        host.dataset.cropAspect = aspect;
        const [a, b] = aspect.split(':').map(Number);
        this.style.setProperty('--crop-demo-aspect', String(a / b));
        ghostImg.style.setProperty('--project-content-w', String(w));
        ghostImg.style.setProperty('--project-content-cx', String(cx));
        ghostImg.style.setProperty('--project-content-cy', String(cy));
      };
      const release = () => {
        const id = gesture?.id;
        gesture = undefined;
        stage.classList.remove('is-dragging', 'is-resizing');
        if (id !== undefined && stage.hasPointerCapture(id)) stage.releasePointerCapture(id);
      };
      const syncSelect = () => {
        let custom = select.querySelector<HTMLOptionElement>('[data-crop-custom]');
        const preset = [...select.options].some((option) => option.value === aspect && option !== custom);
        if (preset) custom?.remove();
        else {
          if (!custom) {
            custom = this.ownerDocument.createElement('option');
            custom.dataset.cropCustom = '';
            select.append(custom);
          }
          custom.value = aspect;
          custom.textContent = 'Custom';
        }
        select.value = aspect;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      };
      select.addEventListener('change', () => { aspect = select.value; render(); }, { signal });
      stage.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || gesture) return;
        const rect = stage.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        event.preventDefault();
        stage.focus();
        const direction = (event.target as HTMLElement).closest<HTMLElement>('[data-page-resize]')?.dataset.pageResize as CropResizeDirection | undefined;
        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, cx, cy, width: rect.width, height: rect.height, direction };
        stage.classList.add(direction ? 'is-resizing' : 'is-dragging');
        stage.setPointerCapture(event.pointerId);
      }, { signal });
      stage.addEventListener('pointermove', (event) => {
        if (event.pointerId !== gesture?.id) return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        if (gesture.direction) {
          const height = cropResizeHeight(gesture.direction, gesture.width, gesture.height, dx, dy);
          aspect = `${Math.round(gesture.width)}:${Math.round(height)}`;
        } else {
          const { w, h } = bounds();
          cx = gesture.cx - dx / gesture.width * w;
          cy = gesture.cy - dy / gesture.height * h;
        }
        render();
      }, { signal });
      const end = (event: PointerEvent) => {
        if (event.pointerId !== gesture?.id) return;
        const resized = Boolean(gesture.direction);
        release();
        if (resized) syncSelect();
      };
      stage.addEventListener('pointerup', end, { signal });
      stage.addEventListener('pointercancel', end, { signal });
      stage.addEventListener('lostpointercapture', end, { signal });
      const zoomAt = (factor: number, x = 0.5, y = 0.5) => {
        const before = bounds();
        const sourceX = cx + (x - 0.5) * before.w;
        const sourceY = cy + (y - 0.5) * before.h;
        // Demo ceiling: 4× locked crop; the full editor supports unlocked framing.
        zoom = clamp(zoom * factor, 1, 4);
        const after = bounds();
        cx = sourceX - (x - 0.5) * after.w;
        cy = sourceY - (y - 0.5) * after.h;
        render();
      };
      stage.addEventListener('wheel', (event) => {
        const rect = stage.getBoundingClientRect();
        if (!rect.width || !rect.height || gesture) return;
        event.preventDefault();
        const { w, h } = bounds();
        if (event.ctrlKey || (w >= 0.9999 && h >= 0.9999)) {
          zoomAt(Math.exp(-event.deltaY * 0.005), (event.clientX - rect.left) / rect.width, (event.clientY - rect.top) / rect.height);
        } else {
          cx += event.deltaX / rect.width * w;
          cy += event.deltaY / rect.height * h;
          render();
        }
      }, { signal, passive: false });
      stage.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 0.05 : 0.02;
        if (event.key === 'Escape') release();
        else if (event.key === '+' || event.key === '=') zoomAt(1.1);
        else if (event.key === '-') zoomAt(1 / 1.1);
        else if (event.key === 'ArrowLeft') cx -= step;
        else if (event.key === 'ArrowRight') cx += step;
        else if (event.key === 'ArrowUp') cy -= step;
        else if (event.key === 'ArrowDown') cy += step;
        else return;
        event.preventDefault();
        render();
      }, { signal });
      reset.addEventListener('click', () => {
        release();
        aspect = '4:3'; zoom = 1.25; cx = cy = 0.5;
        syncSelect();
      }, { signal });
      this.dispose = () => {
        release();
        lifecycle.abort();
        stage.remove();
        ghost.remove();
        host.classList.remove('dev-crop-stage-host');
      };
      render();
    }
    disconnectedCallback() { this.dispose?.(); this.dispose = undefined; }
  }
  if (!customElements.get('vcd-crop-frame-demo')) customElements.define('vcd-crop-frame-demo', CropFrameDemo);
</script>
