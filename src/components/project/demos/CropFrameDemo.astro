---
import '../../../styles/project.css';
import Button from '../../ui/Button.astro';
import Field from '../../ui/Field.astro';
import SelectField from '../../ui/SelectField.astro';
const initialVariants = normalizeImageVariants({ desktop: { aspect: '4:3' }, tablet: { aspect: '4:3' }, mobile: { aspect: '4:3' } }, '4:3', { width: 1200, height: 800 });
const initialStyle = responsiveImageStyle(initialVariants, { width: 1200, height: 800 });
---

<vcd-crop-frame-demo>
  <section class="demo-surface crop-frame-demo">
    <h1 class="demo-title">Image framing</h1>
    <div class="crop-frame-demo__controls">
      <SelectField label="Frame" name="frame" value="4:3" options={[{ value: '1:1', label: '1:1' }, { value: '4:3', label: '4:3' }, { value: '16:9', label: '16:9' }]} />
      <Field label="Zoom"><input type="range" min="100" max="250" step="1" value="100" aria-label="Zoom" data-crop-zoom /></Field>
    </div>
    <div class="crop-frame-demo__frame project-cropped project-responsive-image" style={initialStyle} role="img" aria-label="Image framing" data-crop-frame>
      <div class="project-crop-clip"><img src="/demo-fixtures/studio.svg" width="1200" height="800" alt="" draggable="false" data-crop-image /></div>
    </div>
    <div class="crop-frame-demo__ranges">
      <Field label="X"><input type="range" min="0" max="100" step="1" value="50" aria-label="X position" data-crop-x /></Field>
      <Field label="Y"><input type="range" min="0" max="100" step="1" value="50" aria-label="Y position" data-crop-y /></Field>
    </div>
    <div class="demo-actions"><Button label="Reset" type="button" data-crop-reset /></div>
  </section>
</vcd-crop-frame-demo>

<style>
  vcd-crop-frame-demo { display: block; width: min(100%, 28em); }
  .demo-surface { display: flex; flex-direction: column; gap: var(--space-unit); padding: calc(var(--space-unit) * 1.5); color: var(--sys-color-on-srf); background: var(--sys-color-srf); border: 1px solid var(--sys-color-srf-container-low); border-radius: var(--radius-card-smooth); box-shadow: var(--dev-panel-shadow); }
  .demo-title { margin: 0; font: var(--dev-text-panel-title); }
  .crop-frame-demo__controls, .crop-frame-demo__ranges { display: grid; gap: var(--space-unit); }
  .crop-frame-demo__frame { width: 100%; overflow: visible; border-radius: var(--radius-control-smooth); outline: none; touch-action: none; cursor: grab; }
  .crop-frame-demo__frame:active { cursor: grabbing; }
  .crop-frame-demo__frame .project-crop-clip { border-radius: inherit; }
  .crop-frame-demo__frame img { user-select: none; -webkit-user-drag: none; }
  .demo-actions { display: flex; justify-content: flex-end; padding: 8px; margin: -8px; }
  .demo-actions :global(.dev-btn) { --dev-btn-hit-inset: 8px; }
  .crop-frame-demo input[type='range'] { display: block; width: 100%; accent-color: var(--sys-color-on-srf); }
  @media (max-width: 40em) { .demo-surface { padding: var(--space-unit); } }
  @media (pointer: coarse) { .crop-frame-demo :global(.dev-btn), .crop-frame-demo input[type='range'] { min-height: 44px; } }
</style>

<script>
  import { coverWidthFraction, normalizeImageVariants, responsiveImageStyle } from '../../../lib/responsiveImage';

  class CropFrameDemo extends HTMLElement {
    private controller?: AbortController;
    private frame = '4:3';
    private zoom = 100;
    private cx = 0.5;
    private cy = 0.5;
    private pointerId?: number;
    private activeHost?: HTMLElement;

    connectedCallback() {
      this.controller?.abort();
      const controller = new AbortController(); this.controller = controller; const { signal } = controller;
      const host = this.querySelector<HTMLElement>('[data-crop-frame]');
      const image = this.querySelector<HTMLImageElement>('[data-crop-image]');
      const select = this.querySelector<HTMLSelectElement>('select.dev-select__native');
      const zoom = this.querySelector<HTMLInputElement>('[data-crop-zoom]');
      const x = this.querySelector<HTMLInputElement>('[data-crop-x]');
      const y = this.querySelector<HTMLInputElement>('[data-crop-y]');
      const reset = this.querySelector<HTMLButtonElement>('[data-crop-reset]');
      if (!host || !image || !select || !zoom || !x || !y || !reset) return;
      this.activeHost = host;
      // One local frame adapter; the full crop tuner and its history stay elsewhere.
      const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
      const render = () => {
        const srcAspect = 1200 / 800;
        const baseW = coverWidthFraction(this.frame, srcAspect);
        const w = Math.min(1, baseW / (this.zoom / 100));
        const frameAspect = this.frame === '1:1' ? 1 : this.frame === '16:9' ? 16 / 9 : 4 / 3;
        const h = Math.min(1, (w * srcAspect) / frameAspect);
        this.cx = clamp(this.cx, w / 2, 1 - w / 2);
        this.cy = clamp(this.cy, h / 2, 1 - h / 2);
        const variants = normalizeImageVariants({ desktop: { aspect: this.frame, cx: this.cx, cy: this.cy, w }, tablet: { aspect: this.frame, cx: this.cx, cy: this.cy, w }, mobile: { aspect: this.frame, cx: this.cx, cy: this.cy, w } }, this.frame, { width: 1200, height: 800 });
        host.style.cssText = responsiveImageStyle(variants, { width: 1200, height: 800 });
        host.setAttribute('aria-label', `Image framing ${this.frame}`);
        x.value = String(Math.round(this.cx * 100));
        y.value = String(Math.round(this.cy * 100));
        zoom.value = String(this.zoom);
        zoom.setAttribute('aria-valuetext', `${this.zoom}%`);
      };
      select.addEventListener('change', () => { this.frame = select.value; render(); }, { signal });
      zoom.addEventListener('input', () => { this.zoom = Number(zoom.value); render(); }, { signal });
      x.addEventListener('input', () => { this.cx = Number(x.value) / 100; render(); }, { signal });
      y.addEventListener('input', () => { this.cy = Number(y.value) / 100; render(); }, { signal });
      let pointerX = 0; let pointerY = 0;
      host.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || this.pointerId !== undefined) return;
        event.preventDefault();
        this.pointerId = event.pointerId;
        pointerX = event.clientX;
        pointerY = event.clientY;
        host.setPointerCapture(event.pointerId);
      }, { signal });
      host.addEventListener('pointermove', (event) => {
        if (event.pointerId !== this.pointerId || !host.hasPointerCapture(event.pointerId)) return;
        const rect = host.getBoundingClientRect();
        const w = coverWidthFraction(this.frame, 1.5) / (this.zoom / 100);
        this.cx -= (event.clientX - pointerX) / rect.width * w;
        this.cy -= (event.clientY - pointerY) / rect.width * w * 1.5;
        pointerX = event.clientX;
        pointerY = event.clientY;
        render();
      }, { signal });
      const release = (event: PointerEvent) => {
        if (event.pointerId !== this.pointerId) return;
        if (host.hasPointerCapture(event.pointerId)) host.releasePointerCapture(event.pointerId);
        this.pointerId = undefined;
      };
      host.addEventListener('pointerup', release, { signal });
      host.addEventListener('pointercancel', release, { signal });
      reset.addEventListener('click', () => {
        this.frame = '4:3';
        this.zoom = 100;
        this.cx = 0.5;
        this.cy = 0.5;
        select.value = this.frame;
        if (this.pointerId !== undefined && host.hasPointerCapture(this.pointerId)) host.releasePointerCapture(this.pointerId);
        this.pointerId = undefined;
        render();
      }, { signal });
      render();
    }
    disconnectedCallback() {
      this.controller?.abort();
      this.controller = undefined;
      if (this.pointerId !== undefined && this.activeHost?.hasPointerCapture(this.pointerId)) this.activeHost.releasePointerCapture(this.pointerId);
      this.pointerId = undefined;
      this.activeHost = undefined;
    }
  }
  if (!customElements.get('vcd-crop-frame-demo')) customElements.define('vcd-crop-frame-demo', CropFrameDemo);
</script>
