---
import '../../../styles/project.css';
import '../../../styles/loading-spinner.css';
import loadingSpinner from '../../ui/LoadingSpinner.svg?raw';
import DevOverlayFrame from '../../ui/DevOverlayFrame.astro';
import ImageCropControls from '../ImageCropControls.astro';
import ImageReplaceControls from '../ImageReplaceControls.astro';
import Button from '../../ui/Button.astro';
import PanelActions from '../../ui/PanelActions.astro';
import AssetManagerContent from '../../ui/AssetManagerContent.astro';
import ProjectImage from '../ProjectImage.astro';
import { aspectRatioNumber, normalizeImageVariants, type ImageVariants } from '../../../lib/responsiveImage';
import { projectImageTier } from '../../../lib/images';
import type { DemoAssetProject } from '../../../lib/demoAssetPicker';
interface Props {
  sample?: unknown;
  catalog?: DemoAssetProject[];
  authoring?: { documentKey: string; path: Array<string | number>; sectionId: string };
}
const { sample: suppliedSample, catalog = [], authoring } = Astro.props;
const fallbackPose = { aspect: '4:3', cx: 0.5, cy: 0.5, w: 0.8 };
const fallback = { src: 'Good Home Tools Range Landscape 5.jpg', srcWidth: 7244, srcHeight: 5433, variants: { desktop: fallbackPose } };
const candidate = suppliedSample as typeof fallback | undefined;
const sample = candidate && typeof candidate.src === 'string' && candidate.src && Number.isFinite(candidate.srcWidth) && candidate.srcWidth > 0 && Number.isFinite(candidate.srcHeight) && candidate.srcHeight > 0 ? candidate : fallback;
const sampleSrc = sample.src;
const imageSrc = projectImageTier(sampleSrc, 'preview');
const imageAlt = sampleSrc === fallback.src ? 'GoodHome brushes, rollers and painting tools' : sampleSrc.split('/').pop()!;
const variants = normalizeImageVariants(sample.variants as ImageVariants, '4:3', { width: sample.srcWidth, height: sample.srcHeight });
const pose = variants.desktop;
const cropHeight = pose.w * (sample.srcWidth / sample.srcHeight) / (aspectRatioNumber(pose.aspect) ?? sample.srcWidth / sample.srcHeight);
const locked = pose.cx >= pose.w / 2 && pose.cx <= 1 - pose.w / 2 && pose.cy >= cropHeight / 2 && pose.cy <= 1 - cropHeight / 2;
const initialState = { source: { src: imageSrc, width: sample.srcWidth, height: sample.srcHeight, alt: imageAlt }, crop: pose, locked };
const authoringConfig = import.meta.env.DEV && authoring ? { ...authoring, src: sampleSrc } : undefined;
---

<vcd-crop-frame-demo data-crop-demo data-initial-state={JSON.stringify(initialState)} data-authoring={authoringConfig ? JSON.stringify(authoringConfig) : undefined}>
  <div class="crop-frame-demo__layout">
    <div class="crop-frame-demo__panel">
      <DevOverlayFrame title="Image" embedded data-crop-panel>
        <div class="tapico-crop-tuner">
          <ImageCropControls imageSrc={imageSrc} aspect={variants.desktop.aspect} />
          <ImageReplaceControls dropLabel="Drag and drop here" />
          <PanelActions>
            <Button emphasis="ghost" label="Reset" data-demo-author-reset />
            <Button emphasis="ghost" label="Revert changes" data-demo-author-revert />
            <Button emphasis="filled" label="Save changes" data-demo-author-save data-save-state="idle" aria-label="Save changes">
              <span class="crop-demo-save" aria-hidden="true">
                <span data-save-label="idle">Save changes</span>
                <span data-save-label="saving" set:html={loadingSpinner} />
                <span data-save-label="saved">Saved</span>
              </span>
            </Button>
          </PanelActions>
          <p data-image-replacement-status role="status" hidden></p>
        </div>
      </DevOverlayFrame>
    </div>
    <div class="crop-frame-demo__canvas">
      <ProjectImage kind="lead" src={sampleSrc} srcWidth={sample.srcWidth} srcHeight={sample.srcHeight} variants={variants} spacing="none" loading="eager" alt={imageAlt} />
    </div>
  </div>
  <DevOverlayFrame title="Asset manager" layout="landscape" defaultHidden data-demo-asset-picker role="dialog" aria-label="Asset manager">
    <AssetManagerContent showFilters={false} />
  </DevOverlayFrame>
  <script is:inline type="application/json" data-published-demo-assets set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
</vcd-crop-frame-demo>

<style>
  :global(html:has(vcd-crop-frame-demo)), :global(body:has(vcd-crop-frame-demo)) { overflow: hidden; }
  vcd-crop-frame-demo { display: block; width: min(100%, 58rem); align-self: start; }
  .crop-frame-demo__layout { display: grid; grid-template-columns: minmax(16rem, 20rem) minmax(0, 1fr); align-items: start; gap: calc(var(--space-unit) * 2); }
  .crop-frame-demo__panel { width: min(100%, 20rem); z-index: 1; }
  .crop-frame-demo__panel :global(.dev-overlay) { width: 100%; max-height: none; }
  .crop-frame-demo__panel :global(.dev-overlay__head) { cursor: default; }
  .crop-frame-demo__panel :global(.dev-overlay__resize) { display: none; }
  .crop-frame-demo__canvas { width: min(100%, 28rem, calc(22rem * var(--crop-demo-aspect, 1.333333))); margin-inline: auto; padding: var(--space-unit); z-index: 0; }
  .crop-frame-demo__panel :global(.tapico-crop-tuner__preview) { width: min(100%, calc(14rem * var(--crop-demo-aspect, 1.333333))); margin-inline: auto; }
  .crop-frame-demo__canvas :global(.project-image) { margin: 0; }
  .crop-frame-demo__canvas :global(.project-image.dev-crop-stage-host) { overflow: visible; }
  .crop-frame-demo__canvas :global(.dev-crop-stage:focus-visible:not(.is-dragging):not(.is-resizing)) { outline: 2px solid var(--sys-color-on-srf); outline-offset: 3px; }
  .crop-demo-save { display: grid; place-items: center; }
  .crop-demo-save > span { grid-area: 1 / 1; opacity: 0; filter: blur(3px); transition: opacity 160ms ease, filter 160ms ease; }
  :global([data-save-state="idle"]) .crop-demo-save > [data-save-label="idle"],
  :global([data-save-state="saving"]) .crop-demo-save > [data-save-label="saving"],
  :global([data-save-state="saved"]) .crop-demo-save > [data-save-label="saved"] { opacity: 1; filter: blur(0); }
  .crop-demo-save :global(svg) { display: block; width: 16px; height: 16px; }
  :global([data-save-state]:not([data-save-state="saving"])) .crop-demo-save :global(rect) { animation: none; }
  [data-image-replacement-status] { margin: 0; font: var(--dev-text-status); }
  @media (prefers-reduced-motion: reduce) {
    .crop-demo-save > span { filter: none; }
    .crop-demo-save :global(rect) { animation: none; opacity: 1; }
  }
  @media (max-width: 40em) { .crop-frame-demo__layout { grid-template-columns: 1fr; } .crop-frame-demo__canvas { order: -1; } .crop-frame-demo__panel { width: min(100%, 22rem); margin-inline: auto; } }
</style>

<script>
  import { createDemoImageCrop } from '../../../lib/demoImageCrop';
  import { createDemoImageReplacement } from '../../../lib/demoImageReplacement';
  import { createDevPanelCollapse } from '../../../lib/devPanelCollapse';
  import { createDemoAssetPicker } from '../../../lib/demoAssetPicker';
  class CropFrameDemo extends HTMLElement {
    private dispose?: () => void;
    connectedCallback() {
      this.dispose?.();
      const host = this.querySelector<HTMLElement>('.project-image');
      const panel = this.querySelector<HTMLElement>('[data-crop-panel]');
      const assetPanel = this.querySelector<HTMLElement>('[data-demo-asset-picker]');
      const assetOpener = panel?.querySelector<HTMLElement>('[data-crop-replace-assets]');
      if (!host || !panel || !assetPanel || !assetOpener) return;
      const lifecycle = new AbortController();
      const { signal } = lifecycle;
      const initialState = this.dataset.initialState ? JSON.parse(this.dataset.initialState) : undefined;
      const crop = createDemoImageCrop({ host, controls: panel, initialAspect: '4:3', initialState });
      const catalog = JSON.parse(this.querySelector('[data-published-demo-assets]')?.textContent || '[]');
      const picker = createDemoAssetPicker(assetPanel, catalog, assetOpener);
      let replacement = { reset: () => crop.reset(), destroy() {} };
      if (import.meta.env.DEV && this.dataset.authoring) {
        void import('../../../lib/cropDemoAuthoring').then(({ createCropDemoAuthoring }) => {
          if (!signal.aborted) replacement = createCropDemoAuthoring(panel, crop, { ...JSON.parse(this.dataset.authoring!), chooseAsset: picker.open });
        }).catch(() => {
          if (signal.aborted) return;
          const status = panel.querySelector<HTMLElement>('[data-image-replacement-status]');
          if (status) { status.textContent = 'Could not load image controls. Reload the page to try again.'; status.hidden = false; }
        });
      } else replacement = createDemoImageReplacement(panel, crop, { chooseAsset: picker.open });
      const collapse = createDevPanelCollapse(panel);
      let restoreTimer = 0;
      const show = () => {
        window.clearTimeout(restoreTimer);
        restoreTimer = 0;
        if (panel.classList.contains('is-minimized')) collapse.set(false, false);
        panel.inert = false;
        panel.classList.add('is-dev-overlay-open');
        crop.setActive(true);
      };
      const hide = () => {
        window.clearTimeout(restoreTimer);
        panel.inert = true;
        panel.classList.remove('is-dev-overlay-open');
        crop.setActive(false);
        restoreTimer = window.setTimeout(show, 2000);
      };
      panel.querySelector('[data-minimize-toggle]')?.addEventListener('click', () => collapse.set(!panel.classList.contains('is-minimized')), { signal });
      panel.querySelector('[data-hide-toggle]')?.addEventListener('click', hide, { signal });
      this.querySelector('[data-demo-author-reset]')?.addEventListener('click', () => { collapse.set(false); show(); }, { signal });
      this.dispose = () => {
        lifecycle.abort();
        window.clearTimeout(restoreTimer);
        collapse.destroy();
        replacement.destroy();
        picker.destroy();
        crop.destroy();
      };
    }
    disconnectedCallback() { this.dispose?.(); this.dispose = undefined; }
  }
  if (!customElements.get('vcd-crop-frame-demo')) customElements.define('vcd-crop-frame-demo', CropFrameDemo);
</script>
