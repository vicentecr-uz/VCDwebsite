---
import '../../../styles/project.css';
import DevPanel from '../../ui/DevPanel.astro';
import ImageCropControls from '../ImageCropControls.astro';
import Button from '../../ui/Button.astro';
import ProjectImage from '../ProjectImage.astro';
import { normalizeImageVariants } from '../../../lib/responsiveImage';
import { projectImageTier } from '../../../lib/images';
const imageSrc = projectImageTier('IMG_2480.jpeg', 'preview');
const pose = { aspect: '4:3', cx: 0.5, cy: 0.5, w: 0.8 };
const variants = normalizeImageVariants({ desktop: pose, tablet: pose, mobile: pose }, '4:3', { width: 4032, height: 3024 });
---

<vcd-crop-frame-demo data-crop-demo>
  <div class="crop-frame-demo__layout">
    <div class="crop-frame-demo__panel">
      <DevPanel title="Image" showLights={false}>
        <div class="tapico-crop-tuner">
          <ImageCropControls imageSrc={imageSrc} aspect="4:3" />
        </div>
      </DevPanel>
    </div>
    <div class="crop-frame-demo__canvas">
      <ProjectImage kind="lead" src="IMG_2480.jpeg" srcWidth={4032} srcHeight={3024} variants={variants} spacing="none" loading="eager" alt="Disassembled utility knife on a cutting mat" />
    </div>
  </div>
  <div class="demo-controls"><Button label="Reset" data-crop-reset /></div>
</vcd-crop-frame-demo>

<style>
  vcd-crop-frame-demo { display: block; width: min(100%, 58rem); }
  .crop-frame-demo__layout { display: grid; grid-template-columns: minmax(16rem, 20rem) minmax(0, 1fr); align-items: start; gap: calc(var(--space-unit) * 2); }
  .crop-frame-demo__panel { width: min(100%, 20rem); }
  .crop-frame-demo__canvas { width: min(100%, 28rem, calc(22rem * var(--crop-demo-aspect, 1.333333))); margin-inline: auto; padding: var(--space-unit); }
  .crop-frame-demo__panel :global(.tapico-crop-tuner__preview) { width: min(100%, calc(14rem * var(--crop-demo-aspect, 1.333333))); margin-inline: auto; }
  .crop-frame-demo__canvas :global(.project-image) { margin: 0; }
  .crop-frame-demo__canvas :global(.project-image.dev-crop-stage-host) { overflow: visible; }
  .crop-frame-demo__canvas :global(.dev-crop-stage:focus-visible) { outline: 2px solid var(--sys-color-on-srf); outline-offset: 3px; }
  @media (max-width: 40em) { .crop-frame-demo__layout { grid-template-columns: 1fr; } .crop-frame-demo__canvas { order: -1; } .crop-frame-demo__panel { width: min(100%, 22rem); margin-inline: auto; } }
</style>

<script>
  import { createDemoImageCrop } from '../../../lib/demoImageCrop';
  class CropFrameDemo extends HTMLElement {
    private dispose?: { destroy(): void; reset(): void };
    connectedCallback() {
      this.dispose?.destroy();
      const host = this.querySelector<HTMLElement>('.project-image');
      const panel = this;
      if (host) this.dispose = createDemoImageCrop({ host, controls: panel, initialAspect: '4:3' });
    }
    disconnectedCallback() { this.dispose?.destroy(); this.dispose = undefined; }
  }
  if (!customElements.get('vcd-crop-frame-demo')) customElements.define('vcd-crop-frame-demo', CropFrameDemo);
</script>
