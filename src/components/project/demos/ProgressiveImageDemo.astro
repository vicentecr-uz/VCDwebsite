      const limit = bounds();
      const now = performance.now();
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY, lastX: event.clientX, lastY: event.clientY,
        origin: { x: unresist(position.x, limit.x), y: unresist(position.y, limit.y) },
        time: now, startTime: now, maxDistance: 0, velocity: { x: 0, y: 0 }, samples: [{ t: now, x: position.x, y: position.y }] };
      lens.setPointerCapture(event.pointerId);
      lens.style.cursor = 'grabbing';
      event.preventDefault();
    }, { signal });
    lens.addEventListener('pointermove', (event) => {
      if (!pointer || pointer.id !== event.pointerId) return;
      pointer.lastX = event.clientX;
      pointer.lastY = event.clientY;
      pointer.maxDistance = Math.max(pointer.maxDistance, Math.hypot(event.clientX - pointer.x, event.clientY - pointer.y));
      const limit = bounds();
      const next = { x: resistance(pointer.origin.x + event.clientX - pointer.x, limit.x), y: resistance(pointer.origin.y + event.clientY - pointer.y, limit.y) };
      const now = performance.now();
      const elapsed = Math.max(1, now - pointer.time) / 1000;
      pointer.velocity = { x: (next.x - position.x) / elapsed, y: (next.y - position.y) / elapsed };
      pointer.time = now;
      pointer.samples.push({ t: now, x: next.x, y: next.y });
      if (pointer.samples.length > 16) pointer.samples.shift();
      position = next;
      place();
    }, { signal });
    const release = (event) => {
      if (!pointer || pointer.id !== event.pointerId) return;
      const now = performance.now();
      pointer.maxDistance = Math.max(pointer.maxDistance, Math.hypot(event.clientX - pointer.x, event.clientY - pointer.y));
      let velocity = { x: 0, y: 0 };
      if (event.type === 'pointerup') {
        const samples = pointer.samples.filter((sample) => now - sample.t <= 80);
        if (samples.length >= 2) {
          const first = samples[0];
          const last = samples[samples.length - 1];
          const elapsed = Math.max(1, last.t - first.t) / 1000;
          velocity = { x: (last.x - first.x) / elapsed, y: (last.y - first.y) / elapsed };
        }
      }
      const id = pointer.id;
      const tapDuration = now - pointer.startTime;
      const isTap = event.type === 'pointerup' && tapDuration <= 300 && pointer.maxDistance <= 6;
      const wasDoubleTap = isTap && lastTap && now - lastTap.time <= 350 && Math.hypot(event.clientX - lastTap.x, event.clientY - lastTap.y) <= 24;
      if (isTap) lastTap = wasDoubleTap ? undefined : { time: now, x: event.clientX, y: event.clientY };
      else lastTap = undefined;
      pointer = undefined;
      if (lens.hasPointerCapture(id)) lens.releasePointerCapture(id);
      lens.style.cursor = 'grab';
      if (wasDoubleTap) toggleLoading();
      const speed = Math.hypot(velocity.x, velocity.y);
      if (reducedMotion.matches || event.type !== 'pointerup' || speed < LENS_INERTIA.threshold) {
        settle(speed < LENS_INERTIA.threshold ? { x: 0, y: 0 } : velocity);
        return;
      }
      const max = 2400;
      if (speed > max) velocity = { x: velocity.x / speed * max, y: velocity.y / speed * max };
      startCoast(velocity);
    };
    for (const event of ['pointerup', 'pointercancel', 'lostpointercapture']) lens.addEventListener(event, release, { signal });
    host.addEventListener('pointerdown', () => { hideTooltip(); if (hinting) stopHint(); }, { signal });
    host.addEventListener('keydown', stopHint, { signal });
    lens.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        if (event.repeat) return;
        hideTooltip();
        toggleLoading();
        return;
      }
      const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
      const direction = directions[event.key];
      if (!direction) return;
      event.preventDefault();
      if (pointer) return;
      stopHint();
      stopSpring();
      const limit = bounds();
      const step = event.shiftKey ? 20 : 8;
      position.x = clamp(position.x + direction[0] * step, limit.x);
      position.y = clamp(position.y + direction[1] * step, limit.y);
      place();
    }, { signal });

    const setFrameWidth = () => {
      if (widthControl && widthValue) {
        host.style.setProperty('--progressive-demo-host-width', widthControl.value === 'auto' ? '100%' : `${widthControl.value}px`);
        widthValue.textContent = `${Math.round(host.clientWidth)}px`;
      }
      configure();
    };
    if (isDev && widthControl) widthControl.addEventListener('change', setFrameWidth, { signal });

    if (isDev && copyButton && copyStatus) copyButton.addEventListener('click', async () => {
      const formatPreset = (key: Breakpoint) => {
        const preset = presets[key];
        return `${breakpointLabel(key)} · diameter: ${preset.diameter}px · refraction: ${preset.refraction.toFixed(2)} · rim: ${preset.edgeHighlight.toFixed(2)} · highlights: ${preset.specular.toFixed(2)} · shadow: ${preset.shadowOpacity.toFixed(2)} · zoom: ${preset.zoom.toFixed(1)}× · depth: ${preset.zRadius}px · edge width: ${preset.bevelWidth}px · rim width: ${preset.rimWidth.toFixed(1)}px · sheen: ${preset.sheen.toFixed(2)} · sheen inset: ${preset.sheenInset.toFixed(1)}px · sheen width: ${preset.sheenWidth.toFixed(1)}px · colour pickup: ${preset.colourPickup.toFixed(2)} · glow: ${preset.glowStrength.toFixed(2)} · glow spread: ${preset.glowSpread}px · lens X: ${preset.hintX.toFixed(1)}% · lens Y: ${preset.hintY.toFixed(1)}%`;
      };
      const text = (['mobile', 'tablet', 'desktop'] as Breakpoint[]).map(formatPreset).join('\n');
      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
        else { const area = document.createElement('textarea'); area.value = text; area.style.position = 'fixed'; area.style.opacity = '0'; document.body.append(area); area.select(); const copied = document.execCommand('copy'); area.remove(); if (!copied) throw new Error('Copy failed'); }
        copyStatus.textContent = 'Copied';
      } catch { copyStatus.textContent = 'Copy failed'; }
      window.setTimeout(() => { copyStatus.textContent = ''; }, 1200);
    }, { signal });

    for (const control of configControls) {
      control.addEventListener('input', () => {
        const key = control.dataset.config as keyof LensConfig;
        presets[activeBreakpoint][key] = Number(control.value);
        const output = control.closest('.lens-control')?.querySelector('output');
        if (output) output.textContent = formatValue(key, Number(control.value));
        config = { ...presets[activeBreakpoint] };
        try { sessionStorage.setItem(presetsStorageKey, JSON.stringify(presets)); } catch {}
        configure();
        drawSource();
      }, { signal });
    }
    if (isDev && useLensPosition) useLensPosition.addEventListener('click', () => {
      if (!geometry.width || !geometry.height) return;
      stopHint();
      const preset = presets[activeBreakpoint];
      preset.hintX = Math.max(0, Math.min(100, Math.round((position.x + geometry.diameter / 2) / geometry.width * 1000) / 10));
      preset.hintY = Math.max(0, Math.min(100, Math.round((position.y + geometry.diameter / 2) / geometry.height * 1000) / 10));
      updateControls();
      try { sessionStorage.setItem(presetsStorageKey, JSON.stringify(presets)); } catch {}
    }, { signal });
    if (isDev && replayHint) replayHint.addEventListener('click', () => { if (!lens.hidden) playHint(); }, { signal });

    if (isDev) {
    const controlsPanel = host.querySelector<HTMLDetailsElement>('#lens-controls')!;
    controlsPanel.open = matchMedia('(min-width: 40.01em)').matches;
    const panelSummary = controlsPanel.querySelector('summary')!;
    let drag: { id: number; startX: number; startY: number; left: number; top: number; moved: boolean } | undefined;
    const clampPanel = (left: number, top: number) => ({
      left: Math.max(8, Math.min(left, window.innerWidth - controlsPanel.offsetWidth - 8)),
      top: Math.max(8, Math.min(top, window.innerHeight - controlsPanel.offsetHeight - 8)),
    });
    const reclampPanel = () => {
      if (!controlsPanel.style.left) return;
      const rect = controlsPanel.getBoundingClientRect();
      const next = clampPanel(rect.left, rect.top);
      controlsPanel.style.left = `${next.left}px`;
      controlsPanel.style.top = `${next.top}px`;
    };
    controlsPanel.addEventListener('toggle', reclampPanel, { signal });
    window.addEventListener('resize', reclampPanel, { signal });
    try {
      const saved = JSON.parse(sessionStorage.getItem('vcd-progressive-lens-panel') || 'null');
      if (saved && Number.isFinite(saved.left) && Number.isFinite(saved.top)) {
        const position = clampPanel(saved.left, saved.top);
        controlsPanel.style.left = `${position.left}px`;
        controlsPanel.style.top = `${position.top}px`;
        controlsPanel.style.right = 'auto';
        controlsPanel.style.bottom = 'auto';
      }
    } catch {}
    let suppressDragClick = false;
    panelSummary.addEventListener('click', (event) => {
      if (!suppressDragClick) return;
      suppressDragClick = false;
      event.preventDefault();
    }, { signal });
    panelSummary.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      const rect = controlsPanel.getBoundingClientRect();
      drag = { id: event.pointerId, startX: event.clientX, startY: event.clientY, left: rect.left, top: rect.top, moved: false };
      panelSummary.setPointerCapture(event.pointerId);
    }, { signal });
    panelSummary.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const dx = event.clientX - drag.startX;
      const dy = event.clientY - drag.startY;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      drag.moved = true;
      const position = clampPanel(drag.left + dx, drag.top + dy);
      controlsPanel.style.left = `${position.left}px`;
      controlsPanel.style.top = `${position.top}px`;
      controlsPanel.style.right = 'auto';
      controlsPanel.style.bottom = 'auto';
      event.preventDefault();
    }, { signal });
    const releasePanel = (event: PointerEvent) => {
      if (!drag || drag.id !== event.pointerId) return;
      const moved = drag.moved;
      if (panelSummary.hasPointerCapture(event.pointerId)) panelSummary.releasePointerCapture(event.pointerId);
      drag = undefined;
      if (moved) {
        const rect = controlsPanel.getBoundingClientRect();
        try { sessionStorage.setItem('vcd-progressive-lens-panel', JSON.stringify({ left: rect.left, top: rect.top })); } catch {}
        suppressDragClick = true;
        window.setTimeout(() => { suppressDragClick = false; }, 0);
      }
    };
    panelSummary.addEventListener('pointerup', releasePanel, { signal });
    panelSummary.addEventListener('pointercancel', releasePanel, { signal });
    }
    setFrameWidth();

    function setLoadingState(value: boolean) {
      loading = value;
      toolbar.toggleAttribute('data-loading', value);
      load.setAttribute('aria-label', value ? 'Unload' : 'Load');
      load.querySelector<HTMLElement>('[data-load-label="load"]')?.setAttribute('aria-hidden', value ? 'true' : 'false');
      load.querySelector<HTMLElement>('[data-load-label="unload"]')?.setAttribute('aria-hidden', value ? 'false' : 'true');
    }

    function startLoad() {
      const run = ++generation;
      upgrade?.destroy();
      if (activeImage !== thumbnail) activeImage.remove();
      const incoming = template.content.cloneNode(true);
      const image = incoming.querySelector<HTMLImageElement>('[data-progressive-image]');
      if (!image) throw new Error('Progressive image template is missing its image');
      thumbnail.insertAdjacentElement('afterend', image);
      activeImage = image;
      setLoadingState(true);
      status.textContent = '';
      activeImage.dataset.imagePreview = host.dataset.imagePreviewUrl;
      upgrade = createImagePreviewUpgrade({ onError: () => {
        if (run !== generation || signal.aborted) return;
        upgrade?.destroy();
        setLoadingState(false);
        status.textContent = 'Image unavailable. Try Load again.';
        drawSource();
      } });
      upgrade.bind(stack);
      upgrade.open();
    }

    function restoreLow() {
      if (!thumbnail.complete || !thumbnail.naturalWidth) {
        status.textContent = 'Low-resolution image unavailable. Try Unload again.';
        return;
      }
      ++generation;
      upgrade?.destroy();
      cancelAnimationFrame(frame);
      setLoadingState(false);
      if (activeImage !== thumbnail) activeImage.remove();
      activeImage = thumbnail;
      syncBadges();
      drawSource();
      status.textContent = 'Low-resolution image shown';
    }

    function toggleLoading() {
      hideTooltip();
      if (loading) restoreLow();
      else startLoad();
    }
    load.addEventListener('click', toggleLoading, { signal });

    reducedMotion.addEventListener('change', () => { if (reducedMotion.matches && springFrame) settle(); }, { signal });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { configure(); }
    }, { signal });
    const observer = new MutationObserver(followReveal);
    observer.observe(stack, { childList: true, subtree: true, attributes: true, attributeFilter: ['src', 'data-image-upgraded', 'class'] });
    const resize = new ResizeObserver(() => { configure(); });
    resize.observe(root);
    resize.observe(host);
    resize.observe(toolbar);
    const theme = new MutationObserver(configure);
    theme.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

    async function initialize() {
      try {
        await currentImage().decode();
        await document.fonts.ready;
        if (signal.aborted) return;
        if (!context || !maskContext) throw new Error('Canvas unavailable');
        configure();
        drawSource();
        lens.hidden = false;
        position = { x: root.clientWidth * 0.76 - config.diameter / 2, y: root.clientHeight * 0.31 - config.diameter / 2 };
        configure();
        const instance = await LiquidGlass.init({ root, glassElements: [lens] });
        if (signal.aborted) { instance.destroy(); return; }
        glass = instance;
        if (signal.aborted) return;
        drawSource();
        lens.dataset.ready = '';
        status.textContent = '';
        playHint();
      } catch (error) {
        if (signal.aborted) return;
        lens.hidden = true;
        status.textContent = 'Glass unavailable in this browser. Load and Unload still work.';
        console.error('Image magnifier:', error);
      }
    }
    initialize();
    function dispose() {
      if (signal.aborted) return;
      stopHint();
      stopSpring();
      const pointerId = pointer?.id;
      pointer = undefined;
      if (pointerId !== undefined && lens.hasPointerCapture(pointerId)) lens.releasePointerCapture(pointerId);
      lifecycle.abort();
      generation += 1;
      observer.disconnect();
      resize.disconnect();
      theme.disconnect();
      hideTooltip();
      host.append(lensTooltip);
      cancelAnimationFrame(frame);
      upgrade?.destroy();
      glass?.destroy();
    }
    window.addEventListener('pagehide', (event) => { if (!event.persisted) dispose(); }, { signal });
    return dispose;
  }
  if (!customElements.get('vcd-progressive-image-demo')) customElements.define('vcd-progressive-image-demo', ProgressiveImageDemo);
</script>
