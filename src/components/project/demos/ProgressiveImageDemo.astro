---
import Button from '../../ui/Button.astro';
import Hairline from '../../ui/Hairline.astro';
import { projectImageTier } from '../../../lib/images';
import rotateIcon from 'lucide-static/icons/rotate-ccw.svg?raw';
import '../../../styles/project.css';

const image = 'IMG_2480.jpeg';
const thumb = projectImageTier(image, 'thumb');
const preview = projectImageTier(image, 'preview');
---

<vcd-progressive-image-demo data-image-preview-url={preview}>
  <div class="progressive-image-demo">
    <div class="progressive-image-demo__frame" data-image-root>
      <img data-progressive-image width="4032" height="3024" src={thumb} alt="Disassembled utility knife arranged on a gridded cutting mat" />
      <template data-image-template>
        <img data-progressive-image width="4032" height="3024" src={thumb} alt="Disassembled utility knife arranged on a gridded cutting mat" />
      </template>
    </div>

    <div class="progressive-image-demo__controls dev-surface" role="group" aria-label="Image loading">
      <Button label="Load" type="button" emphasis="ghost" data-load />
      <Hairline orientation="vertical" />
      <Button label="" type="button" emphasis="ghost" data-reset aria-label="Reset">
        <span slot="icon" aria-hidden="true" set:html={rotateIcon} />
      </Button>
    </div>
    <div class="progressive-image-demo__status" aria-live="polite" data-status></div>
  </div>
</vcd-progressive-image-demo>

<style>
  :global(.demo-page:has(vcd-progressive-image-demo[data-image-preview-url])) {
    height: 100%;
    padding-block: 0;
  }

  vcd-progressive-image-demo {
    display: block;
    width: min(100%, 28em);
    height: 100%;
    container-type: inline-size;
  }

  .progressive-image-demo {
    position: relative;
    display: grid;
    grid-template-rows: 1fr 75cqw 1fr;
    justify-items: center;
    height: 100%;
  }

  .progressive-image-demo__frame {
    grid-row: 2;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sys-color-srf-container-low);
    border-radius: var(--radius-control-smooth);
  }

  .progressive-image-demo__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .progressive-image-demo__controls {
    grid-row: 3;
    align-self: center;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 12px;
  }

  .progressive-image-demo__controls :global([data-load]::before) {
    right: -6px;
  }

  .progressive-image-demo__controls :global([data-reset]::before) {
    left: -6px;
  }

  .progressive-image-demo__controls :global(.dev-btn__icon),
  .progressive-image-demo__controls :global(.dev-btn__icon svg) {
    width: 16px;
    height: 16px;
  }

  .progressive-image-demo__controls :global(.dev-hairline--vertical) {
    margin-inline: 2px;
  }

  .progressive-image-demo__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .progressive-image-demo__status.is-visible {
    bottom: var(--space-unit);
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    color: var(--sys-color-on-srf-variant);
    font: var(--dev-text-label);
  }

  @media (pointer: coarse) {
    .progressive-image-demo :global(.dev-btn) { min-height: 44px; }
  }
</style>

<script>
  type PreviewUpgrade = { bind(root: ParentNode): void; open(): void; destroy(): void };

  class ProgressiveImageDemo extends HTMLElement {
    private controller?: AbortController;
    private factory?: PreviewUpgrade;
    private observer?: MutationObserver;
    private generation = 0;
    private image?: HTMLImageElement;

    connectedCallback() {
      this.controller?.abort();
      this.factory?.destroy();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const root = this.querySelector<HTMLElement>('[data-image-root]');
      const template = this.querySelector<HTMLTemplateElement>('[data-image-template]');
      const load = this.querySelector<HTMLButtonElement>('[data-load]');
      const reset = this.querySelector<HTMLButtonElement>('[data-reset]');
      const status = this.querySelector<HTMLElement>('[data-status]');
      const preview = this.dataset.imagePreviewUrl;
      if (!root || !template || !load || !reset || !status || !preview) return;

      this.factory = undefined;
      this.image = root.querySelector<HTMLImageElement>('[data-progressive-image]') ?? undefined;
      const setStatus = (value: string, visible = false) => {
        status.textContent = value;
        status.classList.toggle('is-visible', visible);
      };
      const observeImage = () => {
        this.observer?.disconnect();
        this.image = root.querySelector<HTMLImageElement>('[data-progressive-image]') ?? undefined;
        if (!this.image) return;
        this.observer = new MutationObserver(() => {
          if (this.image?.dataset.imageUpgraded === 'true') setStatus('Preview');
        });
        this.observer.observe(this.image, { attributes: true, attributeFilter: ['data-image-upgraded'] });
      };

      observeImage();
      setStatus('Thumbnail');
      load.addEventListener('click', async () => {
        if (load.disabled || !this.image) return;
        const run = ++this.generation;
        this.factory?.destroy();
        this.factory = undefined;
        load.disabled = true;
        setStatus('Loading');
        try {
          const { createImagePreviewUpgrade } = await import('../../../lib/imagePreviewUpgrade');
          if (signal.aborted || run !== this.generation || !this.image) return;
          this.image.dataset.imagePreview = preview;
          this.factory = createImagePreviewUpgrade({ onError: () => {
            if (signal.aborted || run !== this.generation) return;
            this.factory?.destroy();
            this.factory = undefined;
            load.disabled = false;
            setStatus('Image unavailable', true);
          } });
          this.factory.bind(root);
          this.factory.open();
        } catch {
          if (signal.aborted || run !== this.generation) return;
          this.factory?.destroy();
          this.factory = undefined;
          load.disabled = false;
          setStatus('Image unavailable', true);
        }
      }, { signal });

      reset.addEventListener('click', () => {
        this.generation += 1;
        this.factory?.destroy();
        this.factory = undefined;
        this.observer?.disconnect();
        root.querySelector('[data-progressive-image]')?.remove();
        root.insertBefore(template.content.cloneNode(true), root.firstChild);
        observeImage();
        load.disabled = false;
        setStatus('Thumbnail');
      }, { signal });
    }

    disconnectedCallback() {
      this.generation += 1;
      this.observer?.disconnect();
      this.factory?.destroy();
      this.controller?.abort();
      this.observer = undefined;
      this.factory = undefined;
      this.controller = undefined;
    }
  }

  if (!customElements.get('vcd-progressive-image-demo')) customElements.define('vcd-progressive-image-demo', ProgressiveImageDemo);
</script>
