---
import Button from '../../ui/Button.astro';
import ProjectImage from '../ProjectImage.astro';
import ProjectBodyText from '../ProjectBodyText.astro';
import ProjectSectionTitle from '../ProjectSectionTitle.astro';
import { sectionReorderHandleMarkup } from '../../../lib/sectionReorderChrome';
import { spacingButtonsHtml } from '../../../lib/gapSpacingControl';
import '../../../styles/project.css';
import '../../../styles/gapSpacingControl.css';
import '../../../styles/sectionReorderChrome.css';
const blocks = [
  { type: 'title', title: 'Made for a slower morning' },
  { type: 'image', title: 'Teapot and mug' },
  { type: 'text', title: 'The small details' },
];
const pose = { aspect: '4:3', cx: 0.5, cy: 0.5, w: 0.6 };
---

<vcd-gap-spacing-demo class="is-dev-mode" data-crop-demo>
  <div class="gap-spacing-demo__column" data-reorder-demo-list>
    {blocks.map((block) => (
      <article class="gap-spacing-demo__block" data-reorder-demo-block data-dev-section-reorderable data-title={block.title}>
        <div class="dev-section-lift-backdrop" aria-hidden="true"></div>
        <div class="dev-section-drag-bridge" aria-hidden="true"></div>
        <Fragment set:html={sectionReorderHandleMarkup({ label: `Drag to reorder ${block.title}`, title: 'Drag to reorder', tabIndex: 0, demo: true, pressed: false })} />
        <div class="dev-gap-toolbar" data-gap-toolbar>
          <div class="dev-gap-toolbar__pill dev-surface" role="group" aria-label={`Space before ${block.title}`}>
            <div class="dev-gap-toolbar__spacing" set:html={spacingButtonsHtml(false, false)}></div>
          </div>
        </div>
        {block.type === 'title' && <ProjectSectionTitle title={block.title} spacing="none" />}
        {block.type === 'image' && <ProjectImage kind="lead" src="Solo Teapot and Mug Side View.png" srcWidth={1920} srcHeight={1080} alt="A white teapot and matching mug" variants={{ desktop: pose, tablet: pose, mobile: pose }} mobileInset spacing="none" loading="eager" />}
        {block.type === 'text' && <ProjectBodyText paragraphs={['A teapot and mug, made to sit comfortably together. A quiet shape, a generous handle, and enough room for the next cup.', 'Try moving the picture before the heading. Give the words a little more space, or bring a detail closer. The same pieces can tell a different story.']} spacing="none" />}
      </article>
    ))}
  </div>
  <div class="reorder-demo__status" aria-live="polite" aria-atomic="true"></div>
  <div class="demo-controls"><Button label="Reset" type="button" data-gap-reset data-reorder-demo-reset /></div>
</vcd-gap-spacing-demo>

<style>
  vcd-gap-spacing-demo { display: block; width: min(100%, 38rem); margin-inline: auto; }
  .gap-spacing-demo__column { padding-inline: calc(var(--space-unit) * 2); overflow-anchor: none; }
  .gap-spacing-demo__block { position: relative; margin-top: var(--demo-block-gap, var(--space-group)); overflow-anchor: none; }
  .gap-spacing-demo__block:first-child { margin-top: 0; }
  .gap-spacing-demo__block:first-child > .dev-gap-toolbar { display: none; }
  .dev-gap-toolbar {
    position: absolute;
    top: calc(var(--demo-block-gap, var(--space-group)) / -2);
    left: 50%;
    width: max-content;
    z-index: 80;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .dev-gap-toolbar__pill { opacity: 0; pointer-events: none; transition: opacity 150ms ease; }
  .dev-gap-toolbar.is-near-spacing > .dev-gap-toolbar__pill,
  .dev-gap-toolbar:focus-within > .dev-gap-toolbar__pill { opacity: 1; pointer-events: auto; }
  .dev-gap-toolbar[data-relocating] > .dev-gap-toolbar__pill,
  vcd-gap-spacing-demo[data-gap-suppressed] .dev-gap-toolbar__pill { opacity: 0; pointer-events: none; }
  .gap-spacing-demo__block:has(> .dev-gap-toolbar.is-near-spacing),
  .gap-spacing-demo__block:has(> .dev-gap-toolbar:focus-within) { z-index: 65; }
  .gap-spacing-demo__block:focus-within > :global(.dev-section-drag-handle) { opacity: 1; pointer-events: auto; }
  .gap-spacing-demo__block :global(.project-image) { margin: 0; }
  vcd-gap-spacing-demo[data-crop-active] :global(.dev-section-drag-handle) { opacity: 0; pointer-events: none; }
  vcd-gap-spacing-demo[data-reordering] :global(.dev-image-edit-trigger) { opacity: 0; pointer-events: none; }
  .reorder-demo__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (pointer: coarse) {
    .dev-gap-toolbar__pill { opacity: 1; pointer-events: auto; }
    .gap-spacing-demo__block > :global(.dev-section-drag-handle) { opacity: 1; pointer-events: auto; }
  }
</style>

<script>
  import { createDemoBlockReorder } from '../../../lib/demoBlockReorder';
  import { createDemoImageCrop } from '../../../lib/demoImageCrop';
  import { createDemoGapSpacing } from '../../../lib/demoGapSpacing';

  class GapSpacingDemo extends HTMLElement {
    private dispose?: () => void;
    connectedCallback() {
      this.dispose?.();
      const life = new AbortController();
      const { signal } = life;
      const image = this.querySelector<HTMLElement>('.project-image')!;
      const crop = createDemoImageCrop({ host: image, sourceAspect: 16 / 9, initialAspect: '4:3', active: false });
      const gaps = createDemoGapSpacing(this);
      const trigger = this.ownerDocument.createElement('button');
      trigger.type = 'button';
      trigger.className = 'dev-image-edit-trigger';
      trigger.textContent = 'Edit image';
      trigger.setAttribute('aria-pressed', 'false');
      image.classList.add('dev-image-edit-target');
      image.append(trigger);
      const setCropActive = (active: boolean) => {
        crop.setActive(active);
        gaps.setSuppressed(active);
        this.toggleAttribute('data-crop-active', active);
        image.classList.toggle('is-dev-image-selected', active);
        trigger.setAttribute('aria-pressed', String(active));
      };
      const reorder = createDemoBlockReorder(this, {
        scroll: true,
        onLift: () => { setCropActive(false); gaps.setSuppressed(true); this.toggleAttribute('data-reordering', true); },
        onSettle: () => { gaps.setSuppressed(false); this.removeAttribute('data-reordering'); },
      });
      trigger.addEventListener('click', (event) => { event.stopPropagation(); setCropActive(!this.hasAttribute('data-crop-active')); }, { signal });
      this.ownerDocument.addEventListener('pointerdown', (event) => {
        if (this.hasAttribute('data-crop-active') && !image.contains(event.target as Node)) setCropActive(false);
      }, { signal });
      this.ownerDocument.addEventListener('keydown', (event) => { if (event.key === 'Escape') setCropActive(false); }, { signal });
      this.querySelector('[data-gap-reset]')?.addEventListener('click', () => {
        crop.reset(); gaps.reset(); setCropActive(false);
        const viewport = this.closest<HTMLElement>('[data-page-viewport]');
        if (viewport) viewport.scrollTo({ top: 0, behavior: 'instant' });
        else this.ownerDocument.defaultView?.scrollTo({ top: 0, behavior: 'instant' });
      }, { signal });
      this.dispose = () => {
        life.abort(); reorder.destroy(); gaps.destroy(); crop.destroy(); trigger.remove();
        image.classList.remove('dev-image-edit-target', 'is-dev-image-selected');
        this.removeAttribute('data-crop-active');
      };
    }
    disconnectedCallback() { this.dispose?.(); this.dispose = undefined; }
  }
  if (!customElements.get('vcd-gap-spacing-demo')) customElements.define('vcd-gap-spacing-demo', GapSpacingDemo);
</script>
