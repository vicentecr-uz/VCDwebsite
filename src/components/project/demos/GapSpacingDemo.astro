---
import Button from '../../ui/Button.astro';
import ProjectImage from '../ProjectImage.astro';
import ProjectSectionTitle from '../ProjectSectionTitle.astro';
import '../../../styles/project.css';
import '../../../styles/gapSpacingControl.css';
import { spacingButtonsHtml } from '../../../lib/gapSpacingControl';
---

<vcd-gap-spacing-demo>
  <div class="gap-spacing-demo__viewport" data-gap-viewport tabindex="0" role="region" aria-label="Sample page">
    <div class="gap-spacing-demo__sample">
      <ProjectSectionTitle title="Inside the object" spacing="none" />
      <div class="gap-spacing-demo__gap" data-gap-space aria-hidden="true"></div>
      <ProjectImage src="IMG_2480.jpeg" srcWidth={4032} srcHeight={3024} alt="The parts of a utility knife on a cutting mat" variants={{ desktop: { aspect: "2:1", w: 1 } }} mobileInset spacing="none" />
    </div>
    <div class="gap-spacing-demo__toolbar" data-gap-toolbar data-visible>
      <div class="dev-gap-toolbar__pill dev-surface" role="group" aria-label="Gap size">
        <div class="dev-gap-toolbar__spacing" data-gap-control set:html={spacingButtonsHtml(false, false)}></div>
      </div>
    </div>
  </div>
  <div class="demo-controls"><Button label="Reset" type="button" data-gap-reset /></div>
</vcd-gap-spacing-demo>

<style>
  vcd-gap-spacing-demo { display: block; width: min(100%, 38rem); }
  .gap-spacing-demo__viewport {
    position: relative;
    height: 24rem;
    min-height: 20rem;
    overflow: auto;
    overflow-anchor: none;
    overscroll-behavior: contain;
    border: 1px solid var(--sys-color-srf-container);
    border-radius: var(--radius-control-smooth);
    background: var(--sys-color-srf-container-low);
    scrollbar-color: var(--sys-color-srf-container-high) transparent;
  }
  .gap-spacing-demo__sample { padding: calc(var(--space-unit) * 2); }
  .gap-spacing-demo__gap { height: var(--gap-spacing-value, var(--space-group)); }
  .gap-spacing-demo__toolbar {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50%;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: opacity 150ms ease;
  }
  .gap-spacing-demo__toolbar[data-visible] { opacity: 1; pointer-events: auto; }
  .gap-spacing-demo__toolbar[data-relocating] { opacity: 0; pointer-events: none; }
  .gap-spacing-demo__viewport:focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
  .gap-spacing-demo__viewport:focus-within .gap-spacing-demo__toolbar,
  .gap-spacing-demo__toolbar[data-visible] { opacity: 1; pointer-events: auto; }
  .gap-spacing-demo__viewport:focus-within .gap-spacing-demo__toolbar[data-relocating] { opacity: 0; pointer-events: none; }
  @media (pointer: coarse) {
    .gap-spacing-demo__toolbar { opacity: 1; pointer-events: auto; }
    .gap-spacing-demo__toolbar :global(.dev-spacing-control__btn) { min-height: 44px; min-width: 44px; }
  }
</style>

<script>
  type GapToken = 'related' | 'group' | 'section' | 'major';
  const values: Record<GapToken, string> = {
    related: 'var(--space-related)', group: 'var(--space-group)', section: 'var(--space-section)', major: 'var(--space-major)',
  };

  class GapSpacingDemo extends HTMLElement {
    private lifecycle?: AbortController;
    private resizeObserver?: ResizeObserver;
    private relocation?: number;
    private generation = 0;
    private pinned = false;

    connectedCallback() {
      this.lifecycle?.abort();
      this.resizeObserver?.disconnect();
      const lifecycle = new AbortController();
      this.lifecycle = lifecycle;
      const { signal } = lifecycle;
      const viewport = this.querySelector<HTMLElement>('[data-gap-viewport]');
      const gap = this.querySelector<HTMLElement>('[data-gap-space]');
      const toolbar = this.querySelector<HTMLElement>('[data-gap-toolbar]');
      const choices = [...this.querySelectorAll<HTMLButtonElement>('[data-dev-spacing-option]')];
      const reset = this.querySelector<HTMLButtonElement>('[data-gap-reset]');
      if (!viewport || !gap || !toolbar || !reset || choices.length === 0) return;
      this.querySelectorAll('img').forEach((image) => {
        image.removeAttribute('role');
        image.removeAttribute('tabindex');
        image.removeAttribute('aria-label');
      });
      choices.forEach((choice) => {
        const selected = choice.dataset.devSpacingOption === 'group';
        choice.classList.toggle('is-active', selected);
        choice.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });

      const cancelRelocation = () => {
        this.generation += 1;
        if (this.relocation) window.clearTimeout(this.relocation);
        this.relocation = undefined;
        toolbar.removeAttribute('data-relocating');
      };
      const midpoint = () => {
        const viewportRect = viewport.getBoundingClientRect();
        const gapRect = gap.getBoundingClientRect();
        toolbar.style.top = `${gapRect.top - viewportRect.top + gapRect.height / 2 + viewport.scrollTop}px`;
      };
      const revealIfNear = (event: PointerEvent) => {
        if (event.pointerType === 'touch' || this.pinned) return;
        const rect = toolbar.getBoundingClientRect();
        const distanceX = Math.max(rect.left - event.clientX, 0, event.clientX - rect.right);
        const distanceY = Math.max(rect.top - event.clientY, 0, event.clientY - rect.bottom);
        toolbar.toggleAttribute('data-visible', Math.hypot(distanceX, distanceY) <= 56);
      };
      const release = () => {
        toolbar.removeAttribute('data-visible');
        if (!this.pinned) return;
        this.pinned = false;
        cancelRelocation();
        toolbar.setAttribute('data-relocating', '');
        const generation = this.generation;
        this.relocation = window.setTimeout(() => {
          if (generation !== this.generation) return;
          midpoint();
          toolbar.removeAttribute('data-relocating');
          toolbar.setAttribute('data-visible', '');
          this.relocation = undefined;
        }, 150);
      };
      const choose = (choice: HTMLButtonElement) => {
        const next = choice.dataset.devSpacingOption as GapToken | undefined;
        if (!next || !values[next]) return;
        cancelRelocation();
        gap.style.setProperty('--gap-spacing-value', values[next]);
        choices.forEach((item) => {
          item.classList.toggle('is-active', item === choice);
          item.setAttribute('aria-pressed', item === choice ? 'true' : 'false');
        });
        if (!this.pinned) midpoint();
        if (choice.matches(':focus-visible') || document.activeElement === choice) toolbar.setAttribute('data-visible', '');
        if (eventIsTouch) {
          this.pinned = false;
          midpoint();
          toolbar.removeAttribute('data-visible');
        }
      };
      let eventIsTouch = false;

      midpoint();
      viewport.addEventListener('pointermove', revealIfNear, { signal });
      viewport.addEventListener('pointerleave', () => {
        cancelRelocation();
        this.pinned = false;
        midpoint();
        toolbar.removeAttribute('data-visible');
      }, { signal });
      toolbar.addEventListener('pointerenter', () => {
        this.pinned = true;
        cancelRelocation();
        toolbar.setAttribute('data-visible', '');
      }, { signal });
      toolbar.addEventListener('pointerleave', release, { signal });
      toolbar.addEventListener('wheel', (event) => event.preventDefault(), { signal, passive: false });
      toolbar.addEventListener('pointerdown', (event) => { eventIsTouch = event.pointerType === 'touch'; }, { signal });
      choices.forEach((choice) => choice.addEventListener('click', () => choose(choice), { signal }));
      reset.addEventListener('click', () => {
        cancelRelocation();
        this.pinned = false;
        gap.style.setProperty('--gap-spacing-value', values.group);
        choices.forEach((choice) => {
          const selected = choice.dataset.devSpacingOption === 'group';
          choice.classList.toggle('is-active', selected);
          choice.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
        viewport.scrollTop = 0;
        midpoint();
        toolbar.setAttribute('data-visible', '');
      }, { signal });
      const ResizeObserverCtor = window.ResizeObserver;
      if (ResizeObserverCtor) {
        this.resizeObserver = new ResizeObserverCtor(() => {
          cancelRelocation();
          this.pinned = false;
          midpoint();
        });
        this.resizeObserver.observe(viewport);
      }
    }

    disconnectedCallback() {
      this.generation += 1;
      this.pinned = false;
      this.lifecycle?.abort();
      this.lifecycle = undefined;
      this.resizeObserver?.disconnect();
      this.resizeObserver = undefined;
      if (this.relocation) window.clearTimeout(this.relocation);
      this.relocation = undefined;
    }
  }
  if (!customElements.get('vcd-gap-spacing-demo')) customElements.define('vcd-gap-spacing-demo', GapSpacingDemo);
</script>
