---
import { demoCursorGlyphs } from '../../../lib/demoCursorGlyphs';
import '../../../styles/demoIndicators.css';
const { ...attrs } = Astro.props;
---
<span class="block-demo-cursor" aria-hidden="true" {...attrs}>
  {Object.entries(demoCursorGlyphs).map(([kind, glyph]) => (
    <span data-cursor-glyph={kind} style={`left:${-glyph.x}px;top:${-glyph.y}px`}>
      <img src={glyph.src} width={glyph.width} height={glyph.height} alt="" draggable="false" />
    </span>
  ))}
</span>
