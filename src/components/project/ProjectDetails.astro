---
import { isEditableDocument } from '../../lib/playgroundDocument.mjs';
import { projectStackClass, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import Button from '../ui/Button.astro';
import ellipsisIcon from 'lucide-static/icons/ellipsis.svg?raw';
import { sizeIcon } from '../../lib/icons';
import SiteAnnotationLayer from './SiteAnnotationLayer.astro';

interface Props {
  title: string;
  rows: Array<{ label: string; value: string }>;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
  annotations?: unknown;
}

const {
  title,
  rows,
  documentKey = '',
  sectionPath = [],
  spacing = 'group',
  sectionId,
  contentId,
  annotations,
} = Astro.props;
const editable = isEditableDocument(documentKey) && Boolean(documentKey && sectionPath.length);
const path = (field: string | number) => JSON.stringify([...sectionPath, field]);
const rowPath = (index: number, field: 'label' | 'value') => JSON.stringify([...sectionPath, 'rows', index, field]);
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', 'project-details', projectStackClass(spacing), sectionId && 'section-block']}
  {...(spacingDevAttrs(documentKey, sectionPath, spacing, { contentId }) ?? {})}
  data-site-annotation-section-id={contentId}
  data-site-annotation-document={isEditableDocument(documentKey) ? documentKey : undefined}
  data-dev-section-deletable={editable ? "projectDetails" : undefined}
  data-dev-project-details={editable ? "" : undefined}
>
  <h2
    class="project-details__title"
    data-dev-text-document={editable ? documentKey : undefined}
    data-dev-text-path={editable ? path('title') : undefined}
    data-dev-text-kind={editable ? 'text' : undefined}
  >{title}</h2>
  <dl class="project-details__list">
    {rows.map((row, index) => (
      <div class="project-details__row" data-project-details-row>
        <dt
          class="project-details__label"
          data-project-details-label
          data-dev-text-document={editable ? documentKey : undefined}
          data-dev-text-path={editable ? rowPath(index, 'label') : undefined}
          data-dev-text-kind={editable ? 'text' : undefined}
        >{row.label}</dt>
        <dd
          class="project-details__value"
          data-project-details-value
          data-dev-text-document={editable ? documentKey : undefined}
          data-dev-text-path={editable ? rowPath(index, 'value') : undefined}
          data-dev-text-kind={editable ? 'text' : undefined}
        >{row.value}</dd>
        {editable && <Button label="" emphasis="ghost" class="project-details__actions" data-project-details-actions data-dev-mode-only aria-label={`Row actions for ${row.label || `row ${index + 1}`}`} aria-haspopup="menu" aria-expanded="false"><span slot="icon" aria-hidden="true" set:html={sizeIcon(ellipsisIcon, 16)} /></Button>}
      </div>
    ))}
  </dl>
  {editable && <button type="button" class="project-details__add" data-project-details-add data-dev-mode-only>Add row</button>}
  {contentId && (isEditableDocument(documentKey) || (Array.isArray(annotations) && annotations.length > 0)) && <SiteAnnotationLayer authoring={isEditableDocument(documentKey)} sectionId={contentId} annotations={annotations} />}
</section>
