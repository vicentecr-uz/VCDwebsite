---
import chevronDownIcon from 'lucide-static/icons/chevron-down.svg?raw';
import chevronUpIcon from 'lucide-static/icons/chevron-up.svg?raw';
import { sizeIcon } from '../../lib/icons';
import Hairline from '../ui/Hairline.astro';
import { projectStackClass, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import '../../styles/dev-chrome.css';
import '../../lib/sabi/styles.css';
import './sabi-page.css';

interface Props {
  title: string;
  tagline: string;
  links: Array<{ label: string; href: string }>;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
}

const { title, tagline, links, documentKey, sectionPath, spacing = 'group', sectionId, contentId } = Astro.props;
const editable = import.meta.env.DEV && documentKey && sectionPath;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
const textAttrs = (...path: Array<string | number>) => editable ? {
  'data-dev-text-document': documentKey,
  'data-dev-text-path': JSON.stringify([...sectionPath, ...path]),
  'data-dev-text-kind': 'text',
} : {};

// The first link is the docs, set under the buttons; the rest stay buttons beside Install.
const [docs, ...buttons] = links;
const installPrompt = "Install Sabi (npm package `sabi-input`) in this project. Follow the setup at https://github.com/vicentecr-uz/sabi#readme: add it with the project's package manager, register it once (or use the React component in a React app), then wrap the text inputs whose values can run past the field's edge, such as URLs, titles, search and passwords. Leave `type=\"email\"` and `type=\"number\"` fields as they are; if a long email address needs the fades, follow the README's link to Email and number fields.";
const q = encodeURIComponent(installPrompt);
// Each opens the agent's desktop app with the prompt in the composer, unsent.
const agents = [
  { label: 'Claude Code', href: `claude://code/new?q=${q}` },
  { label: 'Codex', href: `codex://new?prompt=${q}` },
  { label: 'Cursor', href: `cursor://anysphere.cursor-deeplink/prompt?text=${q}` },
];
---

<header
  id={sectionId}
  class:list={['project-block', 'product-hero', projectStackClass(spacing), sectionId && 'section-block']}
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={editable ? 'productHero' : undefined}
>
  <h1 class="product-hero__title" {...textAttrs('title')}>{title}</h1>
  <p class="product-hero__tagline" {...textAttrs('tagline')}>{tagline}</p>
  <label class="sabi-page-field product-hero__field">
    <sabi-input>
      <span>https://</span>
      <input aria-label="URL" value="example.com/a/long/path/that/runs/past/the/edge/of/the/field" />
    </sabi-input>
  </label>
  <div class="product-hero__links">
    <div class="product-hero__install" data-install-menu>
      <button
        type="button"
        class="dev-btn dev-btn--filled dev-btn--raised dev-btn--align-center"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="product-hero-install-menu"
      >Install<span class="dev-btn__icon product-hero__chevron"><span data-chevron="down" set:html={sizeIcon(chevronDownIcon, 16)} /><span data-chevron="up" set:html={sizeIcon(chevronUpIcon, 16)} /></span></button>
      <div class="dev-menu dev-menu--page product-hero__menu" id="product-hero-install-menu" popover="manual" role="menu" aria-label="Install with">
        {agents.map(({ label, href }) => (
          <a class="dev-btn dev-btn--ghost dev-btn--align-start dev-btn--fill dev-menu__item" role="menuitem" tabindex="-1" href={href}>{label}</a>
        ))}
        <Hairline />
        <button type="button" class="dev-btn dev-btn--ghost dev-btn--align-start dev-btn--fill dev-menu__item" role="menuitem" tabindex="-1" data-copy-prompt={installPrompt}>Copy prompt</button>
      </div>
    </div>
    {buttons.map(({ label, href }, index) => (
      <a class="dev-btn dev-btn--soft dev-btn--raised dev-btn--align-center" href={href}><span {...textAttrs('links', index + 1, 'label')}>{label}</span></a>
    ))}
  </div>
  {docs && <a class="product-hero__docs" href={docs.href}>Documentation</a>}
</header>

<script>
  import { define } from '../../lib/sabi/core';
  import { clampToViewport } from '../../lib/floatingLayer';
  define();

  // In Edit mode a link's label is text to edit, so clicks stay on the page. Capture,
  // so this runs before the page-transition listener on the link (as in Header).
  document.addEventListener('click', (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    if ((event.target as Element).closest('.product-hero__links > a, .product-hero__docs')) event.preventDefault();
  }, true);

  let lifecycle: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    lifecycle?.abort();
    lifecycle = new AbortController();
    const { signal } = lifecycle;

    for (const root of document.querySelectorAll<HTMLElement>('[data-install-menu]')) {
      const trigger = root.querySelector<HTMLButtonElement>('[aria-haspopup]')!;
      const menu = root.querySelector<HTMLElement>('[role="menu"]')!;
      const items = [...root.querySelectorAll<HTMLElement>('[role="menuitem"]')];
      const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
      // Opened by a mouse passing over, it closes when the mouse leaves; a click pins it.
      let hoverOpened = false;
      let closeTimer = 0;
      const setOpen = (open: boolean) => {
        clearTimeout(closeTimer);
        if (!open) hoverOpened = false;
        trigger.setAttribute('aria-expanded', String(open));
        menu.togglePopover(open);
        if (open) place();
      };
      // A top-layer popover, centred 6px under the button and at least as wide.
      const place = () => {
        const rect = trigger.getBoundingClientRect();
        menu.style.minWidth = `${rect.width}px`;
        clampToViewport(menu, rect.left + (rect.width - menu.offsetWidth) / 2, rect.bottom + 6);
      };
      window.addEventListener('scroll', () => isOpen() && place(), { capture: true, signal });
      window.addEventListener('resize', () => isOpen() && place(), { signal });
      const focusItem = (index: number) => items.at(index % items.length)?.focus();

      root.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return;
        clearTimeout(closeTimer);
        if (!isOpen()) {
          hoverOpened = true;
          setOpen(true);
        }
      }, { signal });
      root.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse' && hoverOpened) closeTimer = window.setTimeout(() => setOpen(false), 200);
      }, { signal });

      trigger.addEventListener('click', (event) => {
        if (hoverOpened) {
          hoverOpened = false;
          return;
        }
        setOpen(!isOpen());
        if (isOpen() && event.detail === 0) focusItem(0);
      }, { signal });
      trigger.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        setOpen(true);
        focusItem(event.key === 'ArrowDown' ? 0 : -1);
      }, { signal });

      root.addEventListener('keydown', (event) => {
        const index = items.indexOf(event.target as HTMLElement);
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          trigger.focus();
        } else if (event.key === 'Tab') {
          setOpen(false);
        } else if (index !== -1 && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          event.preventDefault();
          focusItem({ ArrowDown: index + 1, ArrowUp: index - 1, Home: 0, End: -1 }[event.key]!);
        }
      }, { signal });

      document.addEventListener('pointerdown', (event) => {
        if (isOpen() && !root.contains(event.target as Node)) setOpen(false);
      }, { signal });

      for (const item of items) {
        item.addEventListener('click', async () => {
          const prompt = item.dataset.copyPrompt;
          if (prompt === undefined) return setOpen(false);
          await navigator.clipboard.writeText(prompt);
          item.textContent = 'Copied';
          window.setTimeout(() => {
            item.textContent = 'Copy prompt';
            setOpen(false);
          }, 1000);
        }, { signal });
      }
    }
  });
</script>

<style>
  /* minmax(0, 1fr) caps the column at the page width: WebKit sizes an auto
     column by the URL field's unclamped text, centring everything in a column
     wider than the page. */
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .product-hero__title {
    margin: 0;
    font-size: var(--text-display-size, 2.5em);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .product-hero__tagline {
    margin: 0.25em 0 0;
    font-size: var(--text-body-size);
    color: var(--sys-color-on-srf-variant);
    text-wrap: balance;
  }

  .product-hero__field {
    width: min(100%, 22em);
    margin-block: var(--space-group);
    text-align: start;
  }

  .product-hero__links {
    display: flex;
    gap: 0.5em;
  }

  /* Hero-sized, as on Sonner: 40px tall, 152px wide, labels the size of the
     Documentation link below. */
  .product-hero__links > a,
  .product-hero__install > button {
    min-width: 152px;
    min-height: 40px;
    padding-inline: 1.5em;
    font-size: 1rem;
    font-weight: 500;
  }

  .product-hero__install .dev-btn__icon {
    margin-inline-end: -2px;
  }

  /* Down and up chevrons stacked; the expanded state swaps them with the
     traffic lights' icon swap rather than rotating one. */
  .product-hero__chevron {
    display: grid;
  }

  .product-hero__chevron > span {
    grid-area: 1 / 1;
    display: grid;
    transition:
      opacity var(--icon-swap-dur) var(--icon-swap-ease),
      filter var(--icon-swap-dur) var(--icon-swap-ease),
      transform var(--icon-swap-dur) var(--icon-swap-ease);
  }

  .product-hero__install > button[aria-expanded='false'] [data-chevron='up'],
  .product-hero__install > button[aria-expanded='true'] [data-chevron='down'] {
    opacity: 0;
    filter: blur(var(--icon-swap-blur));
    transform: scale(var(--icon-swap-start-scale));
  }

  /* Reduced motion keeps the crossfade and drops the blur and scale. */
  @media (prefers-reduced-motion: reduce) {
    .product-hero__install > button[aria-expanded='false'] [data-chevron='up'],
    .product-hero__install > button[aria-expanded='true'] [data-chevron='down'] {
      filter: none;
      transform: none;
    }
  }

  .product-hero__menu {
    text-align: start;
  }

  /* The body-text link underline from project.css. */
  .product-hero__docs {
    margin-top: 1em;
    font-size: 1rem;
    color: var(--sys-color-on-srf-variant);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 10%, transparent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
    transition: color 0.2s ease, text-decoration-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-hero__docs:hover {
      color: var(--sys-color-on-srf);
      text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    }
  }
</style>
