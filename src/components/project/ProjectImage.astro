---
import { projectImage, projectImageTier, projectVideoPoster } from '../../lib/images';
import {
  responsiveImageStyle,
  imageGridConstrainedStyle,
  imageHasWidthConstraint,
  resolveImageGridConstrained,
  type ImageGridConstrained,
  type ImageVariants,
} from '../../lib/responsiveImage';
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';
import {
  BELOW_IMAGE_CAPTION_REVEALS,
  imageCaptionStyleClass,
  imageCaptionsHaveText,
  isBelowImageCaptionStyle,
  resolveImageCaptionPosition,
  resolveImageCaptionReveals,
  resolveImageCaptionStyle,
  resolveImageCaptions,
  type ImageCaptionPositionId,
  type ImageCaptionReveal,
  type ImageCaptionReveals,
  type ImageCaptionStyleId,
  type ImageCaptions,
} from '../../lib/imageCaptions';
import {
  imageDevEditAttrs,
  imageSourceDims,
  isPlaceholderSrc,
  joinMediaStyles,
  maxVhStyle,
  resolveInlineImageCrop,
  resolveMaxVh,
  type MaxVhPercent,
} from '../../lib/projectImageFrame';
import { placeholderLabelText } from '../../lib/placeholderLabel';
import { imageBackgroundStyle, normalizeImageBackground } from '../../lib/imageBackground.mjs';
import { isVideoSrc } from '../../lib/imageUpload.mjs';
import type { VideoAudioSetting } from '../../lib/videoAudio';

interface Props {
  src: string;
  alt?: string;
  /** 'lead' = top-of-page image (cover / crop); 'inline' = image between prose. */
  kind?: 'lead' | 'inline';
  /** Presentation tweak, independent of crop data. */
  layout?: 'default' | 'conic';
  /** Saved per-viewport crop. Presence switches the image into a cropped frame. */
  variants?: ImageVariants;
  /** Natural pixel dimensions. Lets the frame resolve server-side. */
  srcWidth?: number;
  srcHeight?: number;
  /** Editing wiring: which project JSON + path to the image node. */
  document?: string;
  path?: (string | number)[];
  cropId?: string;
  /** Stack rhythm before this block (parent-owned). */
  spacing?: ProjectStackSpacing;
  /** Per-breakpoint width constraint (30–90%, or 100 / omitted for full width). */
  constrained?: ImageGridConstrained;
  centered?: boolean;
  mobileHeight?: '35' | '40' | '50' | '60';
  loading?: 'eager' | 'lazy';
  flush?: boolean;
  mobileShort?: boolean;
  /** Solid media-frame fill; `transparent` means no fill. */
  background?: string;
  /** Cap height at N% of the viewport. Prefer over legacy `max80`. */
  maxVh?: MaxVhPercent | number;
  /** @deprecated use `maxVh: 80` */
  max80?: boolean;
  mobileInset?: boolean;
  fullHeight?: boolean;
  hideMobile?: boolean;
  imgModifier?: string;
  /** Anchor id for section sidebar nav scrollspy. */
  sectionId?: string;
  contentId?: string;
  /** Legacy single caption (all breakpoints). Prefer `captions`. */
  caption?: string;
  /** Per-breakpoint caption text. Smaller breakpoints inherit when omitted. */
  captions?: Partial<ImageCaptions> | string;
  captionStyle?: ImageCaptionStyleId;
  /** Overlay bottom-edge alignment. Defaults to left. */
  captionPosition?: ImageCaptionPositionId;
  /** Per-breakpoint reveal: hover | always. Defaults desktop=hover, tablet/mobile=always. */
  captionReveal?: ImageCaptionReveal | Partial<ImageCaptionReveals>;
  audio?: VideoAudioSetting;
}

const {
  src,
  alt = '',
  kind = 'inline',
  layout = 'default',
  variants: suppliedVariants,
  srcWidth,
  srcHeight,
  document: documentKey,
  path,
  cropId,
  spacing = 'group',
  constrained: constrainedProp = false,
  centered = false,
  mobileHeight,
  loading,
  flush = false,
  mobileShort = false,
  background: backgroundProp,
  maxVh: maxVhProp,
  max80 = false,
  mobileInset = false,
  fullHeight = false,
  hideMobile = false,
  imgModifier,
  sectionId,
  contentId,
  caption,
  captions: captionsProp,
  captionStyle: captionStyleProp,
  captionPosition: captionPositionProp,
  captionReveal,
  audio,
} = Astro.props;

const stackClass = projectStackClass(spacing, { flush });
const spacingAttrs = spacingDevAttrs(documentKey, path, spacing, { contentId });

const isLead = kind === 'lead';
const isPlaceholder = isPlaceholderSrc(src);
const isVideo = isVideoSrc(src);
const videoPoster = isVideo ? projectVideoPoster(src) : undefined;
const srcDims = imageSourceDims({ srcWidth, srcHeight });
const { hasCrop, normalized } = resolveInlineImageCrop(src, suppliedVariants, {
  lead: isLead,
  srcDims,
});

const resolvedConstrained = resolveImageGridConstrained(constrainedProp);
const constrainedStyle = imageGridConstrainedStyle(resolvedConstrained);
const hasWidthConstraint = imageHasWidthConstraint(resolvedConstrained);
const editable = import.meta.env.DEV && !!documentKey && Array.isArray(path) && path.length > 0;
const resolvedLoading = loading ?? (isLead ? 'eager' : 'lazy');
const heightClass = mobileHeight ? `project-media__img--h${mobileHeight}` : '';
const maxVh = resolveMaxVh({ maxVh: maxVhProp, max80 });
const mediaStyle = joinMediaStyles(
  normalized ? responsiveImageStyle(normalized, srcDims) : undefined,
  maxVhStyle(maxVh),
  !isLead ? constrainedStyle : undefined,
);
const captions = resolveImageCaptions({ caption, captions: captionsProp });
const captionStyle = resolveImageCaptionStyle(captionStyleProp);
const captionPosition = resolveImageCaptionPosition(captionPositionProp, captionStyle);
const captionReveals = isBelowImageCaptionStyle(captionStyle)
  ? BELOW_IMAGE_CAPTION_REVEALS
  : resolveImageCaptionReveals(captionReveal);
const hasCaption = imageCaptionsHaveText(captions);
const captionClass = imageCaptionStyleClass(captionStyle);
const placeholderLabel = placeholderLabelText(alt);
const placeholderLabelPath = editable && path ? [...path, 'alt'] : undefined;
const background = normalizeImageBackground(backgroundProp) ?? 'transparent';

const editAttrs = editable
  ? imageDevEditAttrs(true, {
      documentKey: documentKey!,
      path: path!,
      cropId: cropId ?? 'image',
      variants: normalized,
      authoredVariants: suppliedVariants ?? {},
      src,
      srcWidth,
      srcHeight,
      background,
      caption,
      captions: captionsProp,
      captionStyle: captionStyleProp,
      captionPosition: captionPositionProp,
      captionReveal,
      ...(isLead ? {} : { constrained: constrainedProp, centered, maxVh }),
      ...(isLead ? {} : { authoredConstrained: Astro.props.constrained }),
      mobileInset,
      videoAudio: audio,
    })
  : {};
---

{isLead ? (
  <div
    id={sectionId}
    class:list={[
      'project-image',
      layout !== 'default' && `project-image--${layout}`,
      hasCrop && 'project-cropped project-responsive-image',
      isPlaceholder && 'project-media--placeholder',
      editable && 'dev-image-edit-target',
      sectionId && 'section-block',
      stackClass,
    ]}
    style={joinMediaStyles(normalized ? responsiveImageStyle(normalized, srcDims) : undefined, imageBackgroundStyle(background))}
    {...editAttrs}
    {...(spacingAttrs ?? {})}
    data-dev-section-deletable={editable ? 'image' : undefined}
    data-mobile-inset={mobileInset ? 'true' : 'false'}
      data-mobile-bleed-eligible={!maxVh && resolvedConstrained.mobile === 100 ? 'true' : 'false'}
      data-video-audio={audio !== undefined ? JSON.stringify(audio) : undefined}
  >
    {hasCrop ? (
      <div class="project-crop-clip">
        {isVideo && (<video
          src={projectImage(src)}
          poster={videoPoster}
          aria-label={alt || 'Video'}
          class="project-image__img project-inline-video"
          controls
          playsinline
          preload="metadata"
          data-project-inline-video
        />)}
        {!isVideo && (<img
          src={projectImageTier(src, 'thumb')}
          data-image-preview={isPlaceholder ? undefined : projectImageTier(src, 'preview')}
          data-image-original={isPlaceholder ? undefined : projectImage(src)}
          alt={alt}
          role={isPlaceholder ? undefined : 'button'}
          tabindex={isPlaceholder ? undefined : '0'}
          aria-label={isPlaceholder ? undefined : `Open image: ${alt || 'image'}`}
          class="project-image__img"
          loading={resolvedLoading}
        />)}
        {isPlaceholder && (
          <span class="project-media__placeholder-label" aria-hidden="true">
            <span
              class="project-media__placeholder-label-text"
              data-dev-text-document={editable ? documentKey : undefined}
              data-dev-text-path={placeholderLabelPath ? JSON.stringify(placeholderLabelPath) : undefined}
              data-dev-text-kind={editable ? 'text' : undefined}
            >{placeholderLabel}</span>
          </span>
        )}
      </div>
    ) : (
      <Fragment>
      {isVideo && (<video
        src={projectImage(src)}
        poster={videoPoster}
        aria-label={alt || 'Video'}
        class="project-image__img project-inline-video"
        controls
        playsinline
        preload="metadata"
        data-project-inline-video
      />)}
      {!isVideo && (<img
        src={projectImageTier(src, 'thumb')}
        data-image-preview={isPlaceholder ? undefined : projectImageTier(src, 'preview')}
        data-image-original={isPlaceholder ? undefined : projectImage(src)}
        alt={alt}
        role={isPlaceholder ? undefined : 'button'}
        tabindex={isPlaceholder ? undefined : '0'}
        aria-label={isPlaceholder ? undefined : `Open image: ${alt || 'image'}`}
        class="project-image__img"
        loading={resolvedLoading}
      />)}
      </Fragment>
    )}
    {isPlaceholder && !hasCrop && (
      <span class="project-media__placeholder-label" aria-hidden="true">
        <span
          class="project-media__placeholder-label-text"
          data-dev-text-document={editable ? documentKey : undefined}
          data-dev-text-path={placeholderLabelPath ? JSON.stringify(placeholderLabelPath) : undefined}
          data-dev-text-kind={editable ? 'text' : undefined}
        >{placeholderLabel}</span>
      </span>
    )}
    {hasCaption && (
      <span
        class:list={['project-caption', 'project-image-grid__caption', captionClass]}
        data-project-image-caption
        data-caption-style={captionStyle}
        data-caption-position={captionPosition}
        data-caption-reveal-desktop={captionReveals.desktop}
        data-caption-reveal-tablet={captionReveals.tablet}
        data-caption-reveal-mobile={captionReveals.mobile}
      >
        <span class="project-image-grid__caption-bp project-image-grid__caption-bp--desktop" data-caption-bp="desktop">{captions.desktop}</span>
        <span class="project-image-grid__caption-bp project-image-grid__caption-bp--tablet" data-caption-bp="tablet">{captions.tablet}</span>
        <span class="project-image-grid__caption-bp project-image-grid__caption-bp--mobile" data-caption-bp="mobile">{captions.mobile}</span>
      </span>
    )}
    {editable && (
      <button
        type="button"
        class="dev-caption-add-trigger"
        data-dev-edit-trigger="caption"
        data-caption-action="add"
        data-dev-mode-only
        hidden
      >
        Add caption
      </button>
    )}
    {editable && (
      <button
        type="button"
        class="dev-image-edit-trigger"
        data-dev-edit-trigger="image"
        data-dev-mode-only
        hidden
      >
        Edit image
      </button>
    )}
  </div>
) : (
  <div
    id={sectionId}
    class:list={[
      'project-block',
      (centered || hasWidthConstraint || maxVh) && 'project-block--centered',
      hideMobile && 'project-hide-mobile',
      sectionId && 'section-block',
      stackClass,
    ]}
    {...(spacingAttrs ?? {})}
    data-dev-section-deletable={editable ? 'image' : undefined}
  >
    <figure
      class:list={[
        'project-media',
        hasWidthConstraint && 'project-media--constrained',
        maxVh && 'project-media--max-vh',
        hasCrop && 'project-cropped project-responsive-image',
        isPlaceholder && 'project-media--placeholder',
        editable && 'dev-image-edit-target',
      ]}
      style={joinMediaStyles(mediaStyle, imageBackgroundStyle(background))}
      {...editAttrs}
      data-mobile-inset={mobileInset ? 'true' : 'false'}
    data-mobile-bleed-eligible={!maxVh && resolvedConstrained.mobile === 100 ? 'true' : 'false'}
    data-video-audio={audio !== undefined ? JSON.stringify(audio) : undefined}
    >
      {hasCrop ? (
        <div class="project-crop-clip">
          {/*
            No --max-vh here: the cropped <img> is the cover bitmap, sized in px
            by JS and drawn with object-fit:fill. A CSS max-height would clamp
            that box and stretch the pixels. The height cap belongs on the clip.
          */}
            {isVideo && (<video
              src={projectImage(src)}
              poster={videoPoster}
              aria-label={alt || 'Video'}
              class:list={['project-media__img', 'project-inline-video', heightClass, fullHeight && 'project-media__img--full-height']}
              controls
              playsinline
              preload="metadata"
              data-project-inline-video
            />)}
            {!isVideo && (<img
            src={projectImageTier(src, 'thumb')}
            data-image-preview={isPlaceholder ? undefined : projectImageTier(src, 'preview')}
            data-image-original={isPlaceholder ? undefined : projectImage(src)}
            alt={alt}
            role={isPlaceholder ? undefined : 'button'}
            tabindex={isPlaceholder ? undefined : '0'}
            aria-label={isPlaceholder ? undefined : `Open image: ${alt || 'image'}`}
            class:list={[
              'project-media__img',
              heightClass,
              mobileShort && 'project-media__img--mobile-short',
              fullHeight && 'project-media__img--full-height',
              imgModifier && `project-media__img--${imgModifier}`,
            ]}
            loading={resolvedLoading}
          />)}
          {isPlaceholder && (
            <span class="project-media__placeholder-label" aria-hidden="true">
              <span
                class="project-media__placeholder-label-text"
                data-dev-text-document={editable ? documentKey : undefined}
                data-dev-text-path={placeholderLabelPath ? JSON.stringify(placeholderLabelPath) : undefined}
                data-dev-text-kind={editable ? 'text' : undefined}
              >{placeholderLabel}</span>
            </span>
          )}
        </div>
      ) : (
        <Fragment>
        {isVideo && (<video
          src={projectImage(src)}
          poster={videoPoster}
          aria-label={alt || 'Video'}
          class:list={['project-media__img', 'project-inline-video', heightClass, mobileShort && 'project-media__img--mobile-short', maxVh && 'project-media__img--max-vh', fullHeight && 'project-media__img--full-height']}
          controls
          playsinline
          preload="metadata"
          data-project-inline-video
        />)}
        {!isVideo && (<img
          src={projectImageTier(src, 'thumb')}
          data-image-preview={isPlaceholder ? undefined : projectImageTier(src, 'preview')}
          data-image-original={isPlaceholder ? undefined : projectImage(src)}
          alt={alt}
          role={isPlaceholder ? undefined : 'button'}
          tabindex={isPlaceholder ? undefined : '0'}
          aria-label={isPlaceholder ? undefined : `Open image: ${alt || 'image'}`}
          class:list={[
            'project-media__img',
            heightClass,
            mobileShort && 'project-media__img--mobile-short',
            maxVh && 'project-media__img--max-vh',
            fullHeight && 'project-media__img--full-height',
            imgModifier && `project-media__img--${imgModifier}`,
          ]}
          loading={resolvedLoading}
        />)}
        </Fragment>
      )}
      {isPlaceholder && !hasCrop && (
        <span class="project-media__placeholder-label" aria-hidden="true">
          <span
            class="project-media__placeholder-label-text"
            data-dev-text-document={editable ? documentKey : undefined}
            data-dev-text-path={placeholderLabelPath ? JSON.stringify(placeholderLabelPath) : undefined}
            data-dev-text-kind={editable ? 'text' : undefined}
          >{placeholderLabel}</span>
        </span>
      )}
      {hasCaption && (
        <span
          class:list={['project-caption', 'project-image-grid__caption', captionClass]}
          data-project-image-caption
          data-caption-style={captionStyle}
          data-caption-position={captionPosition}
          data-caption-reveal-desktop={captionReveals.desktop}
          data-caption-reveal-tablet={captionReveals.tablet}
          data-caption-reveal-mobile={captionReveals.mobile}
        >
          <span class="project-image-grid__caption-bp project-image-grid__caption-bp--desktop" data-caption-bp="desktop">{captions.desktop}</span>
          <span class="project-image-grid__caption-bp project-image-grid__caption-bp--tablet" data-caption-bp="tablet">{captions.tablet}</span>
          <span class="project-image-grid__caption-bp project-image-grid__caption-bp--mobile" data-caption-bp="mobile">{captions.mobile}</span>
        </span>
      )}
      {editable && (
        <button
          type="button"
          class="dev-caption-add-trigger"
          data-dev-edit-trigger="caption"
          data-caption-action="add"
          data-dev-mode-only
          hidden
        >
          Add caption
        </button>
      )}
      {editable && (
        <button
          type="button"
          class="dev-image-edit-trigger"
          data-dev-edit-trigger="image"
          data-dev-mode-only
          hidden
        >
          Edit image
        </button>
      )}
    </figure>
  </div>
)}

<script>
  import { bindProjectCropCovers } from '../../lib/projectCropCover';
  import { bindAllPlaceholderLabels } from '../../lib/placeholderLabel';

  bindProjectCropCovers();
  bindAllPlaceholderLabels();

  window.addEventListener('vcd:dev-section-inserted', () => {
    bindAllPlaceholderLabels();
  });
</script>
