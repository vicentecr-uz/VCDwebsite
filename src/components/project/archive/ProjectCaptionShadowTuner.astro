---
import DevOverlay from '../../DevOverlay.astro';
import Field from '../../ui/Field.astro';
import Button from '../../ui/Button.astro';
---

<DevOverlay
  storageKey="caption-shadow"
  panelKey="caption-shadow"
  defaultHidden
>
  <div class="caption-shadow-tuner" data-caption-shadow-tuner>
    <Field label="Extension" labelFor="caption-shadow-extension">
      <div class="caption-shadow-tuner__control">
        <input id="caption-shadow-extension" data-shadow-extension type="range" min="0" max="200" step="1" value="0" />
        <output for="caption-shadow-extension" data-shadow-extension-output>+0px</output>
      </div>
    </Field>
    <Button label="Reset" emphasis="ghost" data-shadow-extension-reset />
  </div>
</DevOverlay>

<script>
  const STORAGE_KEY = 'vcd-caption-shadow-extension-v1';
  const MAX_EXTENSION = 200;

  const clampExtension = (value: number) => (
    Number.isFinite(value) ? Math.min(MAX_EXTENSION, Math.max(0, value)) : 0
  );

  const initCaptionShadowExtension = (tuner: HTMLElement) => {
    if (tuner.dataset.initialized === 'true') return;
    const panel = tuner.closest<HTMLElement>('[data-dev-panel-key="caption-shadow"]');
    if (!panel) return;
    const input = tuner.querySelector<HTMLInputElement>('[data-shadow-extension]');
    const output = tuner.querySelector<HTMLOutputElement>('[data-shadow-extension-output]');
    const reset = tuner.querySelector<HTMLButtonElement>('[data-shadow-extension-reset]');
    if (!input || !output || !reset) return;
    tuner.dataset.initialized = 'true';

    const readStored = () => {
      try {
        return clampExtension(Number(window.localStorage.getItem(STORAGE_KEY)));
      } catch {
        return 0;
      }
    };

    const apply = (value: number, persist = true) => {
      const extension = clampExtension(value);
      input.value = String(extension);
      output.textContent = `+${extension}px`;
      document.documentElement.style.setProperty('--caption-shadow-extension', `${extension}px`);
      if (persist) {
        try { window.localStorage.setItem(STORAGE_KEY, String(extension)); } catch { /* Storage is optional. */ }
      }
      window.dispatchEvent(new CustomEvent('vcd:caption-shadow-change', { detail: { extension } }));
    };

    input.addEventListener('input', () => apply(Number(input.value)));
    reset.addEventListener('click', () => apply(0));

    const openWhenActive = (active: boolean) => {
      if (!active) return;
      panel.hidden = false;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', { detail: { panel } }));
    };
    window.addEventListener('vcd:dev-mode-change', ((event: CustomEvent<{ active?: boolean }>) => {
      openWhenActive(event.detail?.active === true);
    }) as EventListener);

    apply(readStored(), false);
    openWhenActive(document.documentElement.classList.contains('is-dev-mode'));
    const requestPreviewMode = () => {
      window.dispatchEvent(new CustomEvent('vcd:dev-mode-request', { detail: { active: true } }));
    };
    if (document.readyState === 'complete') requestAnimationFrame(requestPreviewMode);
    else window.addEventListener('load', requestPreviewMode, { once: true });
  };

  document
    .querySelectorAll<HTMLElement>('[data-caption-shadow-tuner]')
    .forEach(initCaptionShadowExtension);
</script>

<style>
  .caption-shadow-tuner {
    display: grid;
    gap: var(--space-unit);
  }

  .caption-shadow-tuner__control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4em;
    align-items: center;
    gap: var(--space-unit);
    font-size: 1rem;
  }

  .caption-shadow-tuner input {
    width: 100%;
    accent-color: var(--sys-color-on-srf);
  }

  .caption-shadow-tuner output {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>
