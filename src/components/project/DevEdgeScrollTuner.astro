---
import DevPanel from '../ui/DevPanel.astro';
import RangeField from '../ui/RangeField.astro';
import ToggleRow from '../ui/ToggleRow.astro';
import PanelActions from '../ui/PanelActions.astro';
import Button from '../ui/Button.astro';

const fields = [
  { key: 'edgeZoneRatio', label: 'Zone', min: 5, max: 40, step: 1, unit: '%', value: 18 },
  { key: 'edgeZoneMinPx', label: 'Zone min', min: 0, max: 200, step: 4, unit: 'px', value: 56 },
  { key: 'edgeZoneMaxPx', label: 'Zone max', min: 40, max: 400, step: 4, unit: 'px', value: 160 },
  { key: 'maxScrollSpeed', label: 'Max speed', min: 2, max: 80, step: 1, unit: 'px/frame', value: 24 },
  { key: 'maxSpeedInsetPx', label: 'Max speed inset', min: 0, max: 200, step: 1, unit: 'px', value: 12 },
  { key: 'curve', label: 'Curve', min: 0.5, max: 4, step: 0.1, unit: '', value: 2 },
  { key: 'velocitySmoothing', label: 'Smoothing', min: 0.02, max: 1, step: 0.01, unit: '', value: 0.1 },
  { key: 'activationPx', label: 'Activation', min: 0, max: 40, step: 1, unit: 'px', value: 8 },
];
---

<DevPanel class="edge-scroll-panel" title="Edge scroll" showLights={false} draggable>
  <div class="edge-scroll-tuner" data-edge-scroll-tuner>
    {fields.map((f) => (
      <RangeField
        label={f.label}
        id={`edge-scroll-${f.key}`}
        unit={f.unit}
        min={f.min}
        max={f.max}
        step={f.step}
        value={f.value}
        data-edge-scroll-field={f.key}
        data-default={f.value}
      />
    ))}
    <ToggleRow label="Show zones" checked data-edge-scroll-zones />
    <PanelActions>
      <Button emphasis="ghost" label="Reset" data-edge-scroll-reset />
      <Button emphasis="filled" label="Copy values" data-edge-scroll-copy />
    </PanelActions>
  </div>
</DevPanel>

<style>
  .edge-scroll-panel {
    position: fixed;
    right: 1em;
    bottom: 1em;
    z-index: 60;
    max-width: calc(100vw - 2em);
    max-height: calc(100dvh - 2em);
    overflow: auto;
  }
</style>

<style is:global>
  .edge-scroll-tuner { display: grid; gap: var(--dev-panel-gap); }
  .edge-scroll-zone {
    position: fixed;
    inset-inline: 0;
    z-index: 55;
    pointer-events: none;
    background: linear-gradient(
      var(--edge-scroll-zone-direction),
      color-mix(in srgb, var(--sys-color-primary) 24%, transparent) 0,
      var(--edge-scroll-ramp-stops)
    );
  }
  .edge-scroll-zone[hidden] { display: none; }
  .edge-scroll-zone::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    border-top: 1px dashed color-mix(in srgb, var(--sys-color-primary) 38%, transparent);
  }
  .edge-scroll-zone--top { top: 0; --edge-scroll-zone-direction: to bottom; }
  .edge-scroll-zone--bottom { bottom: 0; --edge-scroll-zone-direction: to top; }
  .edge-scroll-zone--top::after { top: var(--edge-scroll-zone-inset, 0px); }
  .edge-scroll-zone--bottom::after { bottom: var(--edge-scroll-zone-inset, 0px); }
</style>

<script>
  import { createPageScope, onPageLoad } from '../../lib/pageLifecycle';
  import { edgeScrollOverrides, edgeScrollZoneRegistration, type EdgeScrollZones } from '../../scripts/sectionReorder';

  const STORAGE_KEY = 'vcd:edge-scroll-tuning';
  type Key = keyof typeof edgeScrollOverrides;

  const dispose = onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-edge-scroll-tuner]');
    if (!root) return;
    const scope = createPageScope();
    const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-edge-scroll-field]')];
    const zones = root.querySelector<HTMLInputElement>('[data-edge-scroll-zones]');

    let saved: Record<string, number> = {};
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}') ?? {};
    } catch {}

    const read = () => Object.fromEntries(inputs.map((i) => [i.dataset.edgeScrollField!, Number(i.value)])) as Record<Key, number>;
    const apply = () => {
      const v = read();
      Object.assign(edgeScrollOverrides, { ...v, edgeZoneRatio: v.edgeZoneRatio / 100 });
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(v));
      } catch {}
      renderZones();
    };
    const set = (input: HTMLInputElement, value: number) => {
      input.value = String(value);
      input.dispatchEvent(new Event('vcd:range-refresh'));
    };

    inputs.forEach((input) => {
      const value = saved[input.dataset.edgeScrollField!];
      if (typeof value === 'number') set(input, value);
      scope.listen(input, 'input', apply);
    });

    scope.listen(root.querySelector('[data-edge-scroll-reset]')!, 'click', () => {
      inputs.forEach((input) => set(input, Number(input.dataset.default)));
      apply();
    });
    scope.listen(root.querySelector('[data-edge-scroll-copy]')!, 'click', () => {
      const v = read();
      const text = `export const EDGE_SCROLL = {
  EDGE_ZONE_RATIO: ${(v.edgeZoneRatio / 100).toFixed(2)},
  EDGE_ZONE_MIN_PX: ${v.edgeZoneMinPx},
  EDGE_ZONE_MAX_PX: ${v.edgeZoneMaxPx},
  MAX_SCROLL_SPEED: ${v.maxScrollSpeed},
  MAX_SPEED_INSET_PX: ${v.maxSpeedInsetPx},
  CURVE: ${v.curve},
  VELOCITY_SMOOTHING: ${v.velocitySmoothing},
  ACTIVATION_PX: ${v.activationPx},
};`;
      navigator.clipboard?.writeText(text).catch(() => {});
    });

    const bands = (['top', 'bottom'] as const).map((side) => {
      const band = document.createElement('div');
      band.className = `edge-scroll-zone edge-scroll-zone--${side}`;
      band.hidden = true;
      document.body.append(band);
      return band;
    });
    let activeZones: EdgeScrollZones | null = null;
    let renderedCurve: number | undefined;
    const renderZones = () => {
      const show = Boolean(zones?.checked);
      bands.forEach((band) => { band.hidden = !show; });
      if (!show) return;

      const curve = edgeScrollOverrides.curve!;
      if (curve !== renderedCurve) {
        const stops = Array.from({ length: 17 }, (_, index) => {
          const progress = index / 16;
          const strength = 24 * (1 - progress) ** curve;
          const offset = `calc(${progress * 100}% + var(--edge-scroll-zone-inset, 0px) * ${1 - progress})`;
          return `color-mix(in srgb, var(--sys-color-primary) ${strength}%, transparent) ${offset}`;
        }).join(', ');
        bands.forEach((band) => band.style.setProperty('--edge-scroll-ramp-stops', stops));
        renderedCurve = curve;
      }

      const height = window.visualViewport?.height ?? window.innerHeight;
      const depth = Math.min(height / 2, edgeScrollOverrides.edgeZoneMaxPx!,
        Math.max(edgeScrollOverrides.edgeZoneMinPx!, height * edgeScrollOverrides.edgeZoneRatio!));
      const inset = Math.min(depth / 2, edgeScrollOverrides.maxSpeedInsetPx!);
      const { top, bottom, topInset, bottomInset } = activeZones ?? {
        top: depth, bottom: depth, topInset: inset, bottomInset: inset,
      };
      bands.forEach((band, index) => {
        band.style.height = `${index === 0 ? top : bottom}px`;
        band.style.setProperty('--edge-scroll-zone-inset', `${index === 0 ? topInset : bottomInset}px`);
      });
    };
    edgeScrollZoneRegistration.onZones = (next) => {
      activeZones = next;
      renderZones();
    };
    scope.add(() => { delete edgeScrollZoneRegistration.onZones; });
    scope.add(() => bands.forEach((b) => b.remove()));
    if (zones) scope.listen(zones, 'change', renderZones);
    scope.listen(window.visualViewport ?? window, 'resize', renderZones);
    apply();

    return () => scope.destroy();
  });
  import.meta.hot?.dispose(dispose);
</script>
