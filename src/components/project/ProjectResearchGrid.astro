---
import { projectImage } from '../../lib/images';

interface Item {
  src: string;
  alt?: string;
}

interface Props {
  columns: Item[][];
}

const { columns } = Astro.props;
---

<div class="project-block project-block--before-image">
  <div class="project-research-grid">
    {columns.map((column) => (
      <div class="project-research-col">
        {column.map((item) => (
          <img src={projectImage(item.src)} alt={item.alt ?? ''} loading="lazy" />
        ))}
      </div>
    ))}
  </div>
</div>
