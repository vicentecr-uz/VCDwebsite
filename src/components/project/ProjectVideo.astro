---
import { projectStackClass, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import ProjectVideoControls from './ProjectVideoControls.astro';
import SiteAnnotationLayer from './SiteAnnotationLayer.astro';

interface Props {
  src?: string;
  poster?: string;
  alt?: string;
  autoplay?: boolean;
  aspectRatio?: string;
  spacing?: ProjectStackSpacing;
  documentKey?: string;
  contentId?: string;
  sectionId?: string;
  sectionPath?: Array<string | number>;
  annotations?: unknown;
}

const {
  src,
  poster,
  alt = '',
  autoplay = false,
  aspectRatio = '16:9',
  spacing = 'group',
  documentKey,
  contentId,
  sectionId,
  sectionPath,
  annotations,
} = Astro.props;

const stackClass = projectStackClass(spacing);

/** `demo.mp4` → `/videos/demo.mp4`; a leading `/` is used as-is. */
const resolveVideoSrc = (input?: string) => {
  if (!input) return undefined;
  return input.startsWith('/') ? input : `/videos/${input}`;
};

/** `demo-poster.jpg` → `/images/demo-poster.jpg`; a leading `/` is used as-is. */
const resolvePosterSrc = (input?: string) => {
  if (!input) return undefined;
  return input.startsWith('/') ? input : `/images/${input}`;
};

const parseAspectRatio = (input: string) => {
  const [w, h] = input.split(':').map(Number);
  if (!w || !h) return '16 / 9';
  return `${w} / ${h}`;
};

const resolvedSrc = resolveVideoSrc(src);
const resolvedPoster = resolvePosterSrc(poster);
const aspectRatioValue = parseAspectRatio(aspectRatio);
const containerStyle = `--project-video-aspect-ratio: ${aspectRatioValue};`;

if (!resolvedSrc) {
  console.warn(`[ProjectVideo] missing "src" for video section${alt ? ` ("${alt}")` : ''} — rendering empty block.`);
}
---

<div id={sectionId} class:list={['project-block', stackClass, sectionId && 'section-block']} data-site-annotation-section-id={contentId} data-site-annotation-document={import.meta.env.DEV ? documentKey : undefined} {...(spacingDevAttrs(documentKey, sectionPath, spacing, { contentId }) ?? {})}>
  {resolvedSrc ? (
    <div class="project-video-player" data-project-video style={containerStyle}>
      <media-controller
        class="project-video-player__controller"
        novolumepref
        nomutedpref
        keyboardforwardseekoffset="5"
        keyboardbackwardseekoffset="5"
      >
        <video
          slot="media"
          class="project-video-player__video"
          src={resolvedSrc}
          poster={resolvedPoster}
          aria-label={alt || undefined}
          controls
          preload="none"
          muted={autoplay ? true : undefined}
          loop={autoplay ? true : undefined}
          playsinline
          data-autoplay={autoplay ? 'true' : undefined}
          data-project-inline-video
        />
      </media-controller>
    </div>
  ) : (
    <div class="project-video-player project-video-player--empty" style={containerStyle}></div>
  )}
  {contentId && (import.meta.env.DEV || (Array.isArray(annotations) && annotations.length > 0)) && <SiteAnnotationLayer sectionId={contentId} annotations={annotations} />}
</div>

{(resolvedSrc || import.meta.env.DEV) && <ProjectVideoControls />}
