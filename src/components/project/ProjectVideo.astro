---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="project-block project-block--before-image">
  <div class="project-video">
    <iframe
      src={src}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"></iframe>
  </div>
</div>
