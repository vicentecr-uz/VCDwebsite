---
import DevOverlay from '../DevOverlay.astro';
---

<DevOverlay
  title="Edit carousel"
  storageKey="project-image-carousel"
  panelKey="carousel"
  defaultHidden
>
  <div class="project-carousel-tuner" data-project-image-carousel-tuner>
    <div class="project-carousel-tuner__segmented" aria-label="Direction">
      <button type="button" data-carousel-orientation="horizontal">Left to right</button>
      <button type="button" data-carousel-orientation="vertical">Up to down</button>
    </div>

    <div class="project-carousel-tuner__viewports" aria-label="Display width">
      <button type="button" data-carousel-viewport="desktop">Desktop</button>
      <button type="button" data-carousel-viewport="tablet">Tablet</button>
      <button type="button" data-carousel-viewport="mobile">Mobile</button>
    </div>

    <p class="project-carousel-tuner__inherit" data-carousel-inherit hidden>
      Inheriting from larger breakpoint — change a setting to create an override.
    </p>

    <label class="project-carousel-tuner__select">
      <span>Position dots</span>
      <select data-carousel-dots-placement>
        <option value="outside">Beside images</option>
        <option value="over">Over images</option>
        <option value="hidden">Hidden</option>
      </select>
    </label>

    <label class="project-carousel-tuner__select">
      <span>Block height</span>
      <select data-carousel-height-mode>
        <option value="dynamic">Follow each image</option>
        <option value="tallest">Pin to tallest</option>
      </select>
    </label>

    <label class="project-carousel-tuner__select">
      <span>Max height</span>
      <select data-carousel-max-vh>
        <option value="">Off</option>
        <option value="90">90% of screen</option>
        <option value="80">80% of screen</option>
        <option value="70">70% of screen</option>
        <option value="60">60% of screen</option>
        <option value="50">50% of screen</option>
        <option value="40">40% of screen</option>
        <option value="30">30% of screen</option>
      </select>
    </label>

    <label class="project-carousel-tuner__toggle">
      <input type="checkbox" data-carousel-scroll-pinned />
      <span>Advance on page scroll</span>
    </label>
    <p class="project-carousel-tuner__hint project-carousel-tuner__hint--indent">
      Pins the block mid-viewport and steps through every image as the reader
      scrolls. Saved, but not wired up yet — swipe still drives the carousel.
    </p>

    <div class="project-carousel-tuner__board">
      <p class="project-carousel-tuner__board-label">Visible</p>
      <div
        class="project-carousel-tuner__visible"
        data-carousel-visible
        data-carousel-drop="visible"
      ></div>

      <p class="project-carousel-tuner__board-label">Parking lot</p>
      <div
        class="project-carousel-tuner__parking"
        data-carousel-parking
        data-carousel-drop="parking"
      >
        <span class="project-carousel-tuner__parking-hint" data-carousel-parking-hint>
          Drag images here to omit them at this breakpoint
        </span>
      </div>
    </div>

    <p class="project-carousel-tuner__hint">
      Parking hides an image at this width only. Use Remove from page on a thumb to drop it from the carousel while keeping the file in the asset manager.
    </p>

    <div class="project-carousel-tuner__actions">
      <button type="button" data-carousel-clear-override hidden>Clear override</button>
      <button type="button" data-carousel-revert>Revert changes</button>
      <button type="button" data-carousel-save>Save changes</button>
    </div>

    <p class="project-carousel-tuner__status" data-carousel-status aria-live="polite">
      Pick a carousel to edit its direction, height, and images.
    </p>
  </div>
</DevOverlay>

<script>
  import { applyCarouselViewportSettings } from '../../lib/projectImageCarousel';
  import {
    IMAGE_VIEWPORTS,
    matchCarouselViewport,
    resolveCarouselSettings,
    serializeCarouselSettings,
    type CarouselDotsPlacement,
    type CarouselHeightMode,
    type CarouselOrientation,
    type CarouselSettingsSource,
    type ImageViewport,
    type ResolvedCarouselBreakpoint,
  } from '../../lib/projectImageCarouselSettings';

  interface CatalogItem {
    id: string;
    src: string;
    alt: string;
  }

  interface Draft {
    orientation: CarouselOrientation;
    byViewport: Record<ImageViewport, ResolvedCarouselBreakpoint>;
  }

  const MAX_VH_STEPS = [90, 80, 70, 60, 50, 40, 30];

  const initProjectImageCarouselTuner = (tuner: HTMLElement) => {
    if (tuner.dataset.initialized === 'true') return;
    tuner.dataset.initialized = 'true';

    const orientationButtons = [
      ...tuner.querySelectorAll<HTMLButtonElement>('[data-carousel-orientation]'),
    ];
    const viewportButtons = [
      ...tuner.querySelectorAll<HTMLButtonElement>('[data-carousel-viewport]'),
    ];
    const inheritNote = tuner.querySelector<HTMLElement>('[data-carousel-inherit]');
    const heightSelect = tuner.querySelector<HTMLSelectElement>('[data-carousel-height-mode]');
    const maxSelect = tuner.querySelector<HTMLSelectElement>('[data-carousel-max-vh]');
    const pinnedInput = tuner.querySelector<HTMLInputElement>('[data-carousel-scroll-pinned]');
    const dotsSelect = tuner.querySelector<HTMLSelectElement>('[data-carousel-dots-placement]');
    const visibleBoard = tuner.querySelector<HTMLElement>('[data-carousel-visible]');
    const parkingBoard = tuner.querySelector<HTMLElement>('[data-carousel-parking]');
    const parkingHint = tuner.querySelector<HTMLElement>('[data-carousel-parking-hint]');
    const clearOverrideButton = tuner.querySelector<HTMLButtonElement>('[data-carousel-clear-override]');
    const saveButton = tuner.querySelector<HTMLButtonElement>('[data-carousel-save]');
    const revertButton = tuner.querySelector<HTMLButtonElement>('[data-carousel-revert]');
    const status = tuner.querySelector<HTMLElement>('[data-carousel-status]');
    const initialTarget = document.querySelector<HTMLElement>('[data-dev-carousel-target]');
    if (
      !orientationButtons.length
      || !viewportButtons.length
      || !inheritNote
      || !heightSelect
      || !maxSelect
      || !pinnedInput
      || !dotsSelect
      || !visibleBoard
      || !parkingBoard
      || !parkingHint
      || !clearOverrideButton
      || !saveButton
      || !revertButton
      || !status
      || !initialTarget
    ) return;

    const readCatalog = (target: HTMLElement): CatalogItem[] => {
      try {
        const parsed = JSON.parse(target.dataset.devCarouselItems || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed
          .map((item) => ({
            id: String(item?.id || ''),
            src: String(item?.src || ''),
            alt: String(item?.alt || ''),
          }))
          .filter((item) => item.id && item.src);
      } catch {
        return [];
      }
    };

    const readSource = (target: HTMLElement): CarouselSettingsSource => {
      try {
        const parsed = JSON.parse(
          target.dataset.devCarouselSettings || target.dataset.carouselSettings || '{}',
        );
        if (parsed && typeof parsed === 'object') return parsed as CarouselSettingsSource;
      } catch {
        // fall through to legacy attrs
      }
      const rawMax = Math.round(Number(target.dataset.devCarouselMaxVh));
      return {
        orientation: target.dataset.devCarouselOrientation === 'vertical' ? 'vertical' : 'horizontal',
        heightMode: target.dataset.devCarouselHeightMode === 'tallest' ? 'tallest' : 'dynamic',
        maxHeightVh: MAX_VH_STEPS.includes(rawMax) ? rawMax : undefined,
        scrollPinned: target.dataset.devCarouselScrollPinned === 'true',
        dotsPlacement: (['outside', 'over', 'hidden'] as CarouselDotsPlacement[])
          .find((placement) => placement === target.dataset.devCarouselDotsPlacement) ?? 'outside',
        visible: (() => {
          try {
            return JSON.parse(target.dataset.devCarouselVisible || 'null');
          } catch {
            return undefined;
          }
        })(),
      };
    };

    const cloneDraft = (draft: Draft): Draft => ({
      orientation: draft.orientation,
      byViewport: {
        desktop: { ...draft.byViewport.desktop, visible: [...draft.byViewport.desktop.visible] },
        tablet: { ...draft.byViewport.tablet, visible: [...draft.byViewport.tablet.visible] },
        mobile: { ...draft.byViewport.mobile, visible: [...draft.byViewport.mobile.visible] },
      },
    });

    const draftFromSource = (source: CarouselSettingsSource, ids: string[]): Draft => {
      const resolved = resolveCarouselSettings(source, ids);
      return {
        orientation: resolved.orientation,
        byViewport: resolved.byViewport,
      };
    };

    const parentViewport = (viewport: ImageViewport): ImageViewport | null => (
      viewport === 'mobile' ? 'tablet' : viewport === 'tablet' ? 'desktop' : null
    );

    let editTarget = initialTarget;
    let catalog = readCatalog(editTarget);
    let itemIds = catalog.map((item) => item.id);
    let selectedViewport: ImageViewport = matchCarouselViewport();
    let saved = draftFromSource(readSource(editTarget), itemIds);
    let draft = cloneDraft(saved);
    let liveApply = false;
    let dragItemId: string | null = null;
    const diskBaselines = new Map<string, Draft>();

    const bp = () => draft.byViewport[selectedViewport];

    const pendingIdFor = (target: HTMLElement) => {
      const documentKey = target.dataset.devDocument || '';
      const carouselPath = target.dataset.devCarouselPath || '[]';
      return `carousel:${documentKey}:${carouselPath}`;
    };

    const closePanel = () => {
      const panel = tuner.closest<HTMLElement>('[data-dev-panel-key]');
      if (!panel || panel.hidden) return;
      panel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', { detail: { panel } }));
    };

    /** Ensure tablet/mobile has its own override before mutating a field. */
    const ensureOverride = () => {
      if (selectedViewport === 'desktop') return;
      const current = bp();
      if (current.overridden) return;
      const parent = parentViewport(selectedViewport)!;
      const inherited = draft.byViewport[parent];
      draft.byViewport[selectedViewport] = {
        heightMode: inherited.heightMode,
        maxHeightVh: inherited.maxHeightVh,
        scrollPinned: inherited.scrollPinned,
        dotsPlacement: inherited.dotsPlacement,
        visible: [...inherited.visible],
        overridden: true,
      };
    };

    const clearOverride = () => {
      if (selectedViewport === 'desktop') return;
      const parent = parentViewport(selectedViewport)!;
      const inherited = draft.byViewport[parent];
      draft.byViewport[selectedViewport] = {
        heightMode: inherited.heightMode,
        maxHeightVh: inherited.maxHeightVh,
        scrollPinned: inherited.scrollPinned,
        dotsPlacement: inherited.dotsPlacement,
        visible: [...inherited.visible],
        overridden: false,
      };
      // Mobile inherits from tablet — if we cleared tablet, refresh mobile when it wasn't overridden.
      if (selectedViewport === 'tablet' && !draft.byViewport.mobile.overridden) {
        draft.byViewport.mobile = {
          ...draft.byViewport.tablet,
          visible: [...draft.byViewport.tablet.visible],
          overridden: false,
        };
      }
    };

    const writeSettingsJson = (target: HTMLElement, next: Draft) => {
      const source = serializeCarouselSettings(next.orientation, next.byViewport, itemIds);
      const json = JSON.stringify(source);
      target.dataset.carouselSettings = json;
      target.dataset.devCarouselSettings = json;
    };

    const applyLayoutLive = (target: HTMLElement, visible: string[]) => {
      const visibleSet = new Set(visible);
      const track = target.querySelector<HTMLElement>('[data-carousel-track]');
      const strip = target.querySelector<HTMLElement>('[data-carousel-dot-strip]');
      const captionSlot = target.querySelector<HTMLElement>('[data-carousel-caption-slot]');
      if (!track) return;

      const slidesById = new Map(
        [...target.querySelectorAll<HTMLElement>('[data-carousel-slide][data-grid-item-id]')]
          .map((slide) => [slide.dataset.gridItemId || '', slide]),
      );
      const dotsById = new Map(
        [...target.querySelectorAll<HTMLElement>('[data-carousel-dot][data-carousel-item-id]')]
          .map((dot) => [dot.dataset.carouselItemId || '', dot]),
      );
      const captionsById = new Map(
        [...target.querySelectorAll<HTMLElement>('[data-carousel-caption][data-carousel-item-id]')]
          .map((caption) => [caption.dataset.carouselItemId || '', caption]),
      );

      const order = [
        ...visible,
        ...itemIds.filter((id) => !visibleSet.has(id)),
      ];

      order.forEach((id) => {
        const parked = !visibleSet.has(id);
        const slide = slidesById.get(id);
        if (slide) {
          if (parked) slide.dataset.carouselParked = 'true';
          else delete slide.dataset.carouselParked;
          track.append(slide);
        }
        const dot = dotsById.get(id);
        if (dot && strip) {
          if (parked) {
            dot.dataset.carouselParked = 'true';
            dot.setAttribute('aria-hidden', 'true');
            dot.tabIndex = -1;
          } else {
            delete dot.dataset.carouselParked;
            dot.removeAttribute('aria-hidden');
            dot.tabIndex = 0;
          }
          strip.append(dot);
        }
        const caption = captionsById.get(id);
        if (caption && captionSlot) {
          if (parked) caption.dataset.carouselParked = 'true';
          else delete caption.dataset.carouselParked;
          captionSlot.append(caption);
        }
      });

      target.dataset.devCarouselVisible = JSON.stringify(visible);
    };

    const applyToTarget = (target: HTMLElement, next: Draft, viewport: ImageViewport) => {
      const live = next.byViewport[viewport];
      writeSettingsJson(target, next);
      target.dataset.carouselTunerPreview = 'true';
      target.dataset.orientation = next.orientation;
      target.dataset.heightMode = live.heightMode;
      target.dataset.scrollPinned = live.scrollPinned ? 'true' : 'false';
      target.dataset.dotsPlacement = live.dotsPlacement;
      target.dataset.devCarouselDotsPlacement = live.dotsPlacement;
      target.dataset.devCarouselOrientation = next.orientation;
      target.dataset.devCarouselHeightMode = live.heightMode;
      target.dataset.devCarouselScrollPinned = live.scrollPinned ? 'true' : 'false';
      if (live.maxHeightVh) {
        target.style.setProperty('--project-carousel-max-vh', String(live.maxHeightVh));
        target.dataset.devCarouselMaxVh = String(live.maxHeightVh);
      } else {
        target.style.removeProperty('--project-carousel-max-vh');
        target.dataset.devCarouselMaxVh = '';
      }
      applyLayoutLive(target, live.visible);
      window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: target } }));
    };

    const clearTunerPreview = (target: HTMLElement) => {
      delete target.dataset.carouselTunerPreview;
    };

    const applyLive = () => {
      if (!liveApply) return;
      applyToTarget(editTarget, draft, selectedViewport);
    };

    const removeFromPage = (id: string) => {
      if (itemIds.length <= 1) {
        status.textContent = 'Keep at least one image, or delete the whole section.';
        return;
      }
      const ok = window.confirm(
        'Remove this image from the page?\n\nIt stays in the asset manager so you can reuse it later.',
      );
      if (!ok) return;

      const target = editTarget;
      const documentKey = target.dataset.devDocument || '';
      let carouselPath: Array<string | number> = [];
      try {
        carouselPath = JSON.parse(target.dataset.devCarouselPath || '[]');
      } catch {
        carouselPath = [];
      }
      if (!documentKey || !carouselPath.length) {
        status.textContent = 'This carousel is not wired for saving.';
        return;
      }

      // Snapshot everything the removal touches, so Revert in the page bar can
      // put the image back. The removal itself only writes to disk at Save.
      const pendingId = pendingIdFor(target);
      const beforeCatalog = catalog.map((item) => ({ ...item }));
      const carouselBaseline = diskBaselines.has(pendingId)
        ? cloneDraft(diskBaselines.get(pendingId)!)
        : null;
      // A layout edit staged earlier (drag/park, or Save changes) has to win
      // over a pre-removal snapshot on revert — otherwise Revert would leave
      // that edit half-applied instead of going all the way back to disk.
      const revertDraft = carouselBaseline ?? cloneDraft(draft);
      // writeSettingsJson() serializes against the closure's itemIds, which only
      // describe the target being edited — keep the literal string instead so a
      // revert can restore a carousel the tuner has since moved off.
      const revertSettingsJson = JSON.stringify(
        serializeCarouselSettings(revertDraft.orientation, revertDraft.byViewport, itemIds),
      );
      const removedNodes = [...target.querySelectorAll<HTMLElement>(
        `[data-grid-item-id="${CSS.escape(id)}"], [data-carousel-item-id="${CSS.escape(id)}"]`,
      )].map((node) => ({
        node,
        parent: node.parentElement,
        next: node.nextElementSibling,
      }));

      catalog = catalog.filter((item) => item.id !== id);
      itemIds = catalog.map((item) => item.id);
      target.dataset.devCarouselItems = JSON.stringify(catalog);

      for (const viewport of IMAGE_VIEWPORTS) {
        draft.byViewport[viewport].visible = draft.byViewport[viewport].visible
          .filter((entry) => entry !== id);
        if (!draft.byViewport[viewport].visible.length) {
          draft.byViewport[viewport].visible = [...itemIds];
        }
      }
      saved = cloneDraft(draft);
      writeSettingsJson(target, draft);

      removedNodes.forEach(({ node }) => node.remove());

      // A layout edit staged earlier for this carousel still describes a
      // real, un-disked change once the removed id is purged from its
      // `visible` lists — keep it live instead of dropping it, so the save
      // bar's count and Save both still carry it. stageDraft drops it on its
      // own if purging brought the draft back to exactly matching disk.
      stageDraft('Removed from page — Save in the page bar to write it to disk.');

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: `media-remove:${documentKey}:${target.dataset.devCarouselPath || '[]'}:${id}`,
          kind: 'media-remove',
          payload: {
            document: documentKey,
            action: 'removeMediaItem',
            path: carouselPath,
            itemId: id,
          },
          revert: () => {
            removedNodes.forEach(({ node, parent, next }) => {
              if (!parent) return;
              if (next && next.parentElement === parent) parent.insertBefore(node, next);
              else parent.append(node);
            });
            target.dataset.devCarouselItems = JSON.stringify(beforeCatalog);
            target.dataset.carouselSettings = revertSettingsJson;
            target.dataset.devCarouselSettings = revertSettingsJson;
            // Only the currently edited carousel owns these closures — touching
            // them for any other target would corrupt the one on screen.
            if (editTarget === target) {
              catalog = beforeCatalog.map((item) => ({ ...item }));
              itemIds = catalog.map((item) => item.id);
              saved = cloneDraft(revertDraft);
              draft = cloneDraft(revertDraft);
              renderDraft();
            }
            window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: target } }));
          },
        },
      }));

      renderDraft();
      window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: target } }));
      status.textContent = 'Removed from page — Save in the page bar to write it to disk.';
    };

    const makeThumb = (item: CatalogItem) => {
      const wrap = document.createElement('div');
      wrap.className = 'project-carousel-tuner__thumb-wrap';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'project-carousel-tuner__thumb';
      button.draggable = true;
      button.dataset.carouselItemId = item.id;
      button.title = item.alt || item.id;
      button.setAttribute('aria-label', item.alt || item.id);
      const image = document.createElement('img');
      image.src = item.src;
      image.alt = '';
      image.draggable = false;
      button.append(image);
      button.addEventListener('dragstart', (event) => {
        dragItemId = item.id;
        button.classList.add('is-dragging');
        event.dataTransfer?.setData('text/plain', item.id);
        if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
      });
      button.addEventListener('dragend', () => {
        dragItemId = null;
        button.classList.remove('is-dragging');
        visibleBoard.classList.remove('is-drop-target');
        parkingBoard.classList.remove('is-drop-target');
      });

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'project-carousel-tuner__remove';
      removeButton.title = 'Remove from page (keep in asset manager)';
      removeButton.setAttribute('aria-label', `Remove ${item.alt || item.id} from page`);
      removeButton.textContent = 'Remove';
      removeButton.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        removeFromPage(item.id);
      });

      wrap.append(button, removeButton);
      return wrap;
    };

    const insertIdAt = (list: string[], id: string, beforeId: string | null) => {
      const without = list.filter((entry) => entry !== id);
      if (!beforeId) {
        without.push(id);
        return without;
      }
      const index = without.indexOf(beforeId);
      if (index < 0) {
        without.push(id);
        return without;
      }
      without.splice(index, 0, id);
      return without;
    };

    const draftsEqual = (a: Draft, b: Draft) => {
      if (a.orientation !== b.orientation) return false;
      return IMAGE_VIEWPORTS.every((viewport) => {
        const left = a.byViewport[viewport];
        const right = b.byViewport[viewport];
        return left.overridden === right.overridden
          && left.heightMode === right.heightMode
          && left.maxHeightVh === right.maxHeightVh
          && left.scrollPinned === right.scrollPinned
          && left.dotsPlacement === right.dotsPlacement
          && left.visible.length === right.visible.length
          && left.visible.every((id, index) => id === right.visible[index]);
      });
    };

    const stageDraft = (message: string) => {
      const target = editTarget;
      const documentKey = target.dataset.devDocument;
      let carouselPath: Array<string | number> = [];
      try {
        carouselPath = JSON.parse(target.dataset.devCarouselPath || '[]');
      } catch {
        carouselPath = [];
      }
      if (!documentKey || !Array.isArray(carouselPath) || !carouselPath.length) {
        status.textContent = 'This carousel is not wired for saving.';
        return false;
      }

      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, cloneDraft(saved));
      }
      const baseline = cloneDraft(diskBaselines.get(pendingId)!);

      liveApply = true;
      applyLive();
      const staged = cloneDraft(draft);
      const source = serializeCarouselSettings(staged.orientation, staged.byViewport, itemIds);

      if (draftsEqual(staged, baseline)) {
        window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', {
          detail: { id: pendingId },
        }));
        status.textContent = message;
        return true;
      }

      window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
        detail: {
          id: pendingId,
          kind: 'carousel',
          payload: {
            document: documentKey,
            path: carouselPath,
            orientation: source.orientation,
            heightMode: source.heightMode ?? 'dynamic',
            maxHeightVh: source.maxHeightVh ?? 0,
            scrollPinned: source.scrollPinned === true,
            dotsPlacement: source.dotsPlacement ?? 'outside',
            visible: source.visible ?? [...itemIds],
            breakpoints: source.breakpoints ?? null,
          },
          revert: () => {
            applyToTarget(target, baseline, selectedViewport);
            if (editTarget === target) {
              saved = cloneDraft(baseline);
              draft = cloneDraft(baseline);
              renderDraft();
            }
          },
        },
      }));

      status.textContent = message;
      return true;
    };

    const moveItem = (id: string, destination: 'visible' | 'parking', beforeId: string | null) => {
      ensureOverride();
      const current = bp();
      const previous = [...current.visible];
      if (destination === 'parking') {
        if (current.visible.length <= 1 && current.visible.includes(id)) {
          status.textContent = 'Keep at least one image in the carousel.';
          return;
        }
        current.visible = current.visible.filter((entry) => entry !== id);
      } else {
        current.visible = insertIdAt(current.visible, id, beforeId);
      }
      if (
        previous.length === current.visible.length
        && previous.every((entry, index) => entry === current.visible[index])
      ) {
        return;
      }
      // Keep mobile in sync when it still inherits from tablet.
      if (selectedViewport === 'tablet' && !draft.byViewport.mobile.overridden) {
        draft.byViewport.mobile = {
          ...draft.byViewport.tablet,
          visible: [...draft.byViewport.tablet.visible],
          overridden: false,
        };
      }
      renderDraft();
      stageDraft(
        destination === 'parking'
          ? 'Image parked — use Save in the page bar to write to disk.'
          : 'Images rearranged — use Save in the page bar to write to disk.',
      );
    };

    const bindDropZone = (zone: HTMLElement, destination: 'visible' | 'parking') => {
      zone.addEventListener('dragover', (event) => {
        if (!dragItemId) return;
        event.preventDefault();
        zone.classList.add('is-drop-target');
        if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
      });
      zone.addEventListener('dragleave', (event) => {
        if (event.target === zone) zone.classList.remove('is-drop-target');
      });
      zone.addEventListener('drop', (event) => {
        event.preventDefault();
        zone.classList.remove('is-drop-target');
        const id = dragItemId || event.dataTransfer?.getData('text/plain');
        if (!id) return;
        const overThumb = (event.target as HTMLElement | null)
          ?.closest<HTMLElement>('.project-carousel-tuner__thumb');

        if (overThumb?.dataset.carouselItemId === id) return;

        if (destination === 'parking') {
          moveItem(id, 'parking', null);
          return;
        }

        if (overThumb) {
          moveItem(id, 'visible', overThumb.dataset.carouselItemId || null);
          return;
        }

        if (bp().visible.includes(id)) return;
        moveItem(id, 'visible', null);
      });
    };

    bindDropZone(visibleBoard, 'visible');
    bindDropZone(parkingBoard, 'parking');

    const renderBoard = () => {
      const byId = new Map(catalog.map((item) => [item.id, item]));
      const visible = bp().visible;
      const visibleSet = new Set(visible);
      visibleBoard.replaceChildren(
        ...visible
          .map((id) => byId.get(id))
          .filter((item): item is CatalogItem => !!item)
          .map(makeThumb),
      );
      const parked = itemIds
        .filter((id) => !visibleSet.has(id))
        .map((id) => byId.get(id))
        .filter((item): item is CatalogItem => !!item);
      parkingBoard.replaceChildren(parkingHint, ...parked.map(makeThumb));
      parkingHint.hidden = parked.length > 0;
    };

    const renderDraft = () => {
      orientationButtons.forEach((button) => {
        const active = button.dataset.carouselOrientation === draft.orientation;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      viewportButtons.forEach((button) => {
        const active = button.dataset.carouselViewport === selectedViewport;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      const live = bp();
      heightSelect.value = live.heightMode;
      maxSelect.value = live.maxHeightVh ? String(live.maxHeightVh) : '';
      pinnedInput.checked = live.scrollPinned;
      dotsSelect.value = live.dotsPlacement;
      const showInherit = selectedViewport !== 'desktop' && !live.overridden;
      inheritNote.hidden = !showInherit;
      clearOverrideButton.hidden = selectedViewport === 'desktop' || !live.overridden;
      renderBoard();
      applyLive();
    };

    const selectTarget = (target: HTMLElement, live: boolean) => {
      if (editTarget && editTarget !== target) clearTunerPreview(editTarget);
      editTarget = target;
      liveApply = live;
      catalog = readCatalog(target);
      itemIds = catalog.map((item) => item.id);
      selectedViewport = matchCarouselViewport();
      const pendingId = pendingIdFor(target);
      if (!diskBaselines.has(pendingId)) {
        diskBaselines.set(pendingId, draftFromSource(readSource(target), itemIds));
      }
      saved = draftFromSource(readSource(target), itemIds);
      draft = cloneDraft(saved);
      renderDraft();
      if (live) {
        status.textContent = 'Editing this carousel. Pick a breakpoint, then drag thumbnails to rearrange or park.';
      }
    };

    const saveDraft = () => {
      if (stageDraft('Staged — use Save in the page bar to write to disk.')) {
        saved = cloneDraft(draft);
        closePanel();
      }
    };

    window.addEventListener('vcd:dev-edit-open', ((event: CustomEvent) => {
      const trigger = event.detail?.trigger as HTMLElement | undefined;
      if (trigger?.dataset.devEditTrigger !== 'carousel') return;
      const target = trigger.closest<HTMLElement>('[data-dev-carousel-target]');
      if (target) selectTarget(target, true);
    }) as EventListener);

    window.addEventListener('vcd:dev-edit-close', ((event: CustomEvent) => {
      const trigger = event.detail?.trigger as HTMLElement | undefined;
      if (trigger?.dataset.devEditTrigger !== 'carousel') return;
      liveApply = false;
      // Keep staged JSON on the block, but drop preview so the live window bp wins.
      writeSettingsJson(editTarget, draft);
      clearTunerPreview(editTarget);
      applyCarouselViewportSettings(editTarget, matchCarouselViewport());
      window.dispatchEvent(new CustomEvent('vcd:carousel-refresh', { detail: { block: editTarget } }));
    }) as EventListener);

    selectTarget(initialTarget, false);

    orientationButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const orientation = button.dataset.carouselOrientation as CarouselOrientation | undefined;
        if (!orientation || orientation === draft.orientation) return;
        draft.orientation = orientation;
        renderDraft();
        status.textContent = orientation === 'vertical'
          ? 'Scrolls up to down — unsaved changes.'
          : 'Scrolls left to right — unsaved changes.';
      });
    });

    viewportButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const viewport = button.dataset.carouselViewport as ImageViewport | undefined;
        if (!viewport || viewport === selectedViewport) return;
        selectedViewport = viewport;
        renderDraft();
        status.textContent = `Editing ${viewport} settings.`;
      });
    });

    heightSelect.addEventListener('change', () => {
      ensureOverride();
      bp().heightMode = heightSelect.value as CarouselHeightMode;
      if (selectedViewport === 'tablet' && !draft.byViewport.mobile.overridden) {
        draft.byViewport.mobile.heightMode = bp().heightMode;
      }
      renderDraft();
      status.textContent = 'Block height changed — unsaved changes.';
    });

    maxSelect.addEventListener('change', () => {
      ensureOverride();
      bp().maxHeightVh = Number(maxSelect.value) || null;
      if (selectedViewport === 'tablet' && !draft.byViewport.mobile.overridden) {
        draft.byViewport.mobile.maxHeightVh = bp().maxHeightVh;
      }
      renderDraft();
      status.textContent = bp().maxHeightVh
        ? `Capped at ${bp().maxHeightVh}% of the screen — unsaved changes.`
        : 'Height cap off — unsaved changes.';
    });

    dotsSelect.addEventListener('change', () => {
      ensureOverride();
      bp().dotsPlacement = dotsSelect.value as CarouselDotsPlacement;
      if (selectedViewport === 'tablet' && !draft.byViewport.mobile.overridden) {
        draft.byViewport.mobile.dotsPlacement = bp().dotsPlacement;
      }
      renderDraft();
      status.textContent = 'Position dots moved — unsaved changes.';
    });

    pinnedInput.addEventListener('change', () => {
      ensureOverride();
      bp().scrollPinned = pinnedInput.checked;
      if (selectedViewport === 'tablet' && !draft.byViewport.mobile.overridden) {
        draft.byViewport.mobile.scrollPinned = bp().scrollPinned;
      }
      renderDraft();
      status.textContent = bp().scrollPinned
        ? 'Scroll advance on — saved, but not wired up yet.'
        : 'Scroll advance off — unsaved changes.';
    });

    clearOverrideButton.addEventListener('click', () => {
      clearOverride();
      renderDraft();
      stageDraft(`Cleared ${selectedViewport} override — use Save in the page bar to write to disk.`);
    });

    saveButton.addEventListener('click', saveDraft);

    revertButton.addEventListener('click', () => {
      draft = cloneDraft(saved);
      renderDraft();
      stageDraft('Reverted to the last saved carousel settings.');
    });

    window.addEventListener('vcd:dev-pending-committed', (() => {
      diskBaselines.clear();
      if (editTarget) diskBaselines.set(pendingIdFor(editTarget), cloneDraft(saved));
    }) as EventListener);

    window.addEventListener('vcd:dev-pending-reverted', (() => {
      diskBaselines.clear();
    }) as EventListener);
  };

  document
    .querySelectorAll<HTMLElement>('[data-project-image-carousel-tuner]')
    .forEach(initProjectImageCarouselTuner);
</script>

