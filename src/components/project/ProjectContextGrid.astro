---
import ProjectContextImage from './ProjectContextImage.astro';

interface Item {
  src: string;
  alt?: string;
  caption: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="project-block project-block--before-image">
  <div class="project-context-grid">
    {items.map((item) => (
      <ProjectContextImage src={item.src} alt={item.alt} caption={item.caption} />
    ))}
  </div>
</div>
