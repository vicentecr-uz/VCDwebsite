---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';

interface Props {
  paragraphs: string[];
  documentKey?: string;
  pathPrefix?: Array<string | number>;
  spacing?: ProjectStackSpacing;
}

const { paragraphs, documentKey, pathPrefix, spacing = 'section' } = Astro.props;
const editable = import.meta.env.DEV && documentKey && pathPrefix;
const sectionPath =
  pathPrefix?.at(-1) === 'paragraphs' ? pathPrefix.slice(0, -1) : undefined;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing);
const stackClass = projectStackClass(spacing);
---

<section class:list={['project-block', stackClass]} {...(spacingAttrs ?? {})}>
  <div
    class="project-body-text"
    data-dev-text-document={editable ? documentKey : undefined}
    data-dev-text-path={editable ? JSON.stringify(pathPrefix) : undefined}
    data-dev-text-kind={editable ? 'paragraphs' : undefined}
  >
    {paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </div>
</section>
