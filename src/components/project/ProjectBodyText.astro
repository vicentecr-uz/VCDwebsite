---
import { isEditableDocument } from '../../lib/playgroundDocument.mjs';
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';
import { resolveTextWrapHtml } from '../../lib/projectTextWrap';
import { DASH_LINE_HTML } from '../../lib/devTextDom';
import SiteAnnotationLayer from './SiteAnnotationLayer.astro';

interface Props {
  paragraphs: string[];
  documentKey?: string;
  pathPrefix?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  /** Anchor id for section sidebar nav scrollspy. */
  sectionId?: string;
  contentId?: string;
  intro?: boolean;
  introHeight?: number;
  introHeightPath?: Array<string | number>;
  balance?: boolean;
  inlineSidenotes?: boolean;
  annotations?: unknown;
}

const {
  paragraphs,
  documentKey,
  pathPrefix,
  spacing = 'group',
  sectionId,
  contentId,
  intro = false,
  introHeight,
  introHeightPath,
  balance = false,
  inlineSidenotes = false,
  annotations,
} = Astro.props;
const editable = isEditableDocument(documentKey) && documentKey && pathPrefix;
const sectionPath =
  pathPrefix?.at(-1) === 'paragraphs' ? pathPrefix.slice(0, -1) : undefined;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
const stackClass = projectStackClass(spacing);
const deletable = Boolean(editable && sectionPath);
const rawIntroHeight = Number(introHeight);
const normalizedIntroHeight = Number.isFinite(rawIntroHeight)
  ? Math.min(100, Math.max(1, Math.round(rawIntroHeight)))
  : 75;
const paragraphWrapClass = (paragraph: string) => [
  `project-body-text__wrap-${resolveTextWrapHtml(paragraph, balance)}`,
  DASH_LINE_HTML.test(paragraph) && 'project-body-text__dash',
];
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', stackClass, sectionId && 'section-block', intro && 'project-block--intro']}
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={deletable ? 'bodyText' : undefined}
  data-inline-sidenote-block={inlineSidenotes && !intro ? 'true' : undefined}
  data-dev-inline-sidenotes={editable && inlineSidenotes && !intro ? 'true' : undefined}
  data-dev-intro={intro ? 'true' : undefined}
  data-dev-intro-height-document={intro && editable ? documentKey : undefined}
  data-dev-intro-height-path={intro && editable ? JSON.stringify(introHeightPath ?? [...sectionPath!, 'introHeight']) : undefined}
  data-dev-intro-height-value={intro ? String(normalizedIntroHeight) : undefined}
  style={intro ? `--intro-height: ${normalizedIntroHeight}` : undefined}
  data-site-annotation-section-id={contentId}
  data-site-annotation-document={isEditableDocument(documentKey) ? documentKey : undefined}
>
  <div
    class="project-body-text"
    style={balance ? 'text-wrap: balance' : undefined}
    data-dev-text-document={editable ? documentKey : undefined}
    data-dev-text-path={editable ? JSON.stringify(pathPrefix) : undefined}
    data-dev-text-kind={editable ? 'paragraphs' : undefined}
    data-dev-text-legacy-balance={editable && balance ? 'true' : undefined}
  >
    {paragraphs.map((paragraph) => (
      <p class:list={paragraphWrapClass(paragraph)} set:html={paragraph} />
    ))}
  </div>
  {contentId && (isEditableDocument(documentKey) || (Array.isArray(annotations) && annotations.length > 0)) && <SiteAnnotationLayer authoring={isEditableDocument(documentKey)} sectionId={contentId} annotations={annotations} />}
</section>

<script>
  import { bindInlineSidenotes } from '../../scripts/inlineSidenotes';
  import { onPageLoad } from '../../lib/pageLifecycle';
  const dispose = onPageLoad(() => bindInlineSidenotes(document));
  import.meta.hot?.dispose(dispose);
</script>

<style>
  :global(.project-block[data-inline-sidenote-block='true'].has-inline-sidenotes) { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 13rem; column-gap: 2rem; align-items: start; }
  :global(.project-block[data-inline-sidenote-block='true'] > .project-body-text) { grid-column: 1; min-width: 0; }
  :global(.dev-inline-sidenotes) { grid-column: 2; grid-row: 1; display: grid; gap: 1rem; color: var(--sys-color-on-srf-subtle); font-size: .875rem; line-height: 1.45; }
  :global(.dev-inline-sidenotes__note) { display: flex; align-items: baseline; gap: .5em; min-width: 0; }
  :global(.dev-inline-sidenotes__number) { flex: none; font-size: .75em; font-variant-numeric: tabular-nums; }
  :global(.dev-inline-sidenotes__text) { min-width: 0; outline: none; white-space: pre-wrap; }
  :global(.dev-inline-sidenotes__text[contenteditable='plaintext-only']:empty::before) { content: attr(data-placeholder); color: color-mix(in srgb, currentColor 60%, transparent); pointer-events: none; }
  :global(.dev-inline-sidenotes__text:focus-visible) { outline: 2px solid var(--sys-color-on-srf); outline-offset: 2px; }
  @media (min-width: 69.5em) {
    :global(.project-block--text[data-inline-sidenote-block='true'].has-inline-sidenotes) { width: calc(var(--page-text-max-width) + 15rem); max-width: none; grid-template-columns: minmax(0, var(--page-text-max-width)) 13rem; }
    :global(.dev-inline-sidenotes) { position: absolute; inset-block: 0; inset-inline-end: 0; width: 13rem; display: block; pointer-events: none; }
    :global(.dev-inline-sidenotes__note) { position: absolute; inset-inline: 0; pointer-events: auto; }
  }
  @media (max-width: 69.499em) {
    :global(.project-block[data-inline-sidenote-block='true'].has-inline-sidenotes) { grid-template-columns: minmax(0, 1fr); row-gap: .75rem; }
    :global(.dev-inline-sidenotes) { grid-column: 1; grid-row: auto; }
    :global(.dev-inline-sidenotes__note:not(.is-open)) { display: none; }
  }
</style>
