---
import {
  projectStackClass,
  spacingDevAttrs,
  type ProjectStackSpacing,
} from '../../lib/projectStack';

interface Props {
  paragraphs: string[];
  documentKey?: string;
  pathPrefix?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  /** Anchor id for section sidebar nav scrollspy. */
  sectionId?: string;
  contentId?: string;
  intro?: boolean;
  introHeight?: number;
  introHeightPath?: Array<string | number>;
}

const {
  paragraphs,
  documentKey,
  pathPrefix,
  spacing = 'section',
  sectionId,
  contentId,
  intro = false,
  introHeight,
  introHeightPath,
} = Astro.props;
const editable = import.meta.env.DEV && documentKey && pathPrefix;
const sectionPath =
  pathPrefix?.at(-1) === 'paragraphs' ? pathPrefix.slice(0, -1) : undefined;
const spacingAttrs = spacingDevAttrs(documentKey, sectionPath, spacing, { contentId });
const stackClass = projectStackClass(spacing);
const deletable = Boolean(editable && sectionPath);
const rawIntroHeight = Number(introHeight);
const normalizedIntroHeight = Number.isFinite(rawIntroHeight)
  ? Math.min(100, Math.max(1, Math.round(rawIntroHeight)))
  : 75;
---

<section
  id={sectionId}
  class:list={['project-block', 'project-block--text', stackClass, sectionId && 'section-block', intro && 'project-block--intro']}
  {...(spacingAttrs ?? {})}
  data-dev-section-deletable={deletable ? 'bodyText' : undefined}
  data-dev-intro={intro ? 'true' : undefined}
  data-dev-intro-height-document={intro && editable ? documentKey : undefined}
  data-dev-intro-height-path={intro && editable ? JSON.stringify(introHeightPath ?? [...sectionPath!, 'introHeight']) : undefined}
  data-dev-intro-height-value={intro ? String(normalizedIntroHeight) : undefined}
  style={intro ? `--intro-height: ${normalizedIntroHeight}` : undefined}
>
  <div
    class="project-body-text"
    data-dev-text-document={editable ? documentKey : undefined}
    data-dev-text-path={editable ? JSON.stringify(pathPrefix) : undefined}
    data-dev-text-kind={editable ? 'paragraphs' : undefined}
  >
    {paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </div>
</section>
