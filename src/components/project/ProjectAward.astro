---
import { projectStackClass, spacingDevAttrs, type ProjectStackSpacing } from '../../lib/projectStack';
import { normalizeHref } from '../../lib/normalizeHref.mjs';
import { projectImage } from '../../lib/images';
import TextField from '../ui/TextField.astro';
import Button from '../ui/Button.astro';
import { sizeIcon } from '../../lib/icons';
import trashIcon from 'lucide-static/icons/trash-2.svg?raw';
import checkIcon from 'lucide-static/icons/check.svg?raw';

interface Props {
  src?: string;
  alt?: string;
  href?: string;
  documentKey?: string;
  sectionPath?: Array<string | number>;
  spacing?: ProjectStackSpacing;
  sectionId?: string;
  contentId?: string;
}
const {
  src = '/awards/if-design-2026.png', alt = 'iF Design Award 2026', href = '',
  documentKey = '', sectionPath = [], spacing = 'group', sectionId, contentId,
} = Astro.props;
const editable = import.meta.env.DEV && Boolean(documentKey && sectionPath.length);
const safeHref = normalizeHref(href) || undefined;
---

<section
  id={sectionId}
  class:list={['project-block', 'project-award', projectStackClass(spacing), sectionId && 'section-block']}
  {...(spacingDevAttrs(documentKey, sectionPath, spacing, { contentId }) ?? {})}
  data-dev-section-deletable={editable ? 'award' : undefined}
  data-project-award
>
  {editable && <span
    class="project-award__proxy" hidden
    data-dev-text-document={documentKey}
    data-dev-text-path={JSON.stringify([...sectionPath, 'href'])}
    data-dev-text-kind="text"
  >{safeHref || ''}</span>}
  <div class="project-award__control">
    <a class="project-award__hit" href={safeHref} target={safeHref ? '_blank' : undefined} rel={safeHref ? 'noopener noreferrer' : undefined}>
      <img src={projectImage(src)} alt={alt} width="4612" height="2362" loading="lazy" decoding="async" draggable="false" />
    </a>
    {editable && <button type="button" class="dev-image-edit-trigger project-award__edit" data-award-edit data-dev-mode-only aria-expanded="false">Edit award</button>}
    {editable && <form class="project-award__editor dev-surface" data-award-editor aria-label="Edit award link" hidden>
      <Button emphasis="soft" label="" data-award-remove aria-label="Remove link" title="Remove link">
        <span slot="icon" set:html={sizeIcon(trashIcon, 16)} />
      </Button>
      <TextField class="project-award__input" label="Link URL" hideLabel inputmode="url" data-award-input placeholder="google.com" autocomplete="off" spellcheck="false" />
      <Button type="submit" emphasis="filled" label="" aria-label="Apply link" title="Apply link">
        <span slot="icon" set:html={sizeIcon(checkIcon, 16)} />
      </Button>
    </form>}
  </div>
</section>

<style is:global>
  .project-award { display: grid; place-items: center; width: 100%; }
  .project-award__control { position: relative; display: grid; place-items: center; width: 100%; min-height: 8em; }
  .project-award__hit { position: relative; display: block; max-width: 100%; }
  .project-award__hit[href]::after { content: ''; position: absolute; inset: -8px; }
  .project-award__hit img { display: block; height: 6em; width: auto; max-width: 100%; object-fit: contain; opacity: 1; transition: opacity .2s ease; }
  .project-award__hit:hover img, .project-award__hit:focus-visible img { opacity: .6; }
  .project-award .project-award__edit, .project-award__editor { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  .project-award .project-award__edit { right: auto; opacity: 1; pointer-events: auto; white-space: nowrap; }
  .project-award__edit::after { content: ''; position: absolute; inset: -8px; }
  .project-award__editor { display: grid; grid-template-columns: max-content minmax(0, 1fr) max-content; align-items: center; gap: 4px; padding: 6px; width: min(22em, calc(100vw - 32px)); box-sizing: border-box; border-radius: 12px; z-index: 5; }
  .project-award__input { width: 100%; min-width: 0; overflow: hidden; }
  .project-award__editor .dev-btn { padding: 8px; width: var(--dev-control-height); min-width: var(--dev-control-height); min-height: var(--dev-control-height); }
  .project-award__editor[hidden], .project-award__edit[hidden],
  html:not(.is-dev-mode) .project-award__editor, html:not(.is-dev-mode) .project-award__edit,
  html.show-section-nav-editor .project-award__editor, html.show-section-nav-editor .project-award__edit { display: none; }
</style>
