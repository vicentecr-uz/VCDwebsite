---
import ProjectReferenceImage from './ProjectReferenceImage.astro';
import { projectStackClass, type ProjectStackSpacing } from '../../lib/projectStack';

interface Item {
  src: string;
  alt?: string;
  caption: string;
  href: string;
}

interface Props {
  items: Item[];
  spacing?: ProjectStackSpacing;
}

const { items, spacing = 'section' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <div class="project-reference-grid">
    {items.map((item) => (
      <ProjectReferenceImage src={item.src} alt={item.alt} caption={item.caption} href={item.href} />
    ))}
  </div>
</div>
