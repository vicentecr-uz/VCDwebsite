---
import ProjectReferenceImage from './ProjectReferenceImage.astro';

interface Item {
  src: string;
  alt?: string;
  caption: string;
  href: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="project-block project-block--before-image">
  <div class="project-reference-grid">
    {items.map((item) => (
      <ProjectReferenceImage src={item.src} alt={item.alt} caption={item.caption} href={item.href} />
    ))}
  </div>
</div>
