---
import { projectImage } from '../../lib/images';

interface Props {
  src: string;
  alt?: string;
}

const { src, alt = '' } = Astro.props;
---

<div class="project-block project-block--flush">
  <figure class="project-final-hero">
    <img src={projectImage(src)} alt={alt} class="project-final-hero__img" loading="lazy" />
  </figure>
</div>
