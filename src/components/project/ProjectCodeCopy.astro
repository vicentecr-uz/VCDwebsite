---
import copyIcon from 'lucide-static/icons/copy.svg?raw';
import { sizeIcon } from '../../lib/icons';

interface Props {
  code: string;
  top?: boolean;
}

const { code, top = false } = Astro.props;
---

<button
  type="button"
  class:list={['dev-btn', 'dev-btn--ghost', 'code-copy', top && 'code-copy--top']}
  aria-label="Copy"
  title="Copy"
  data-copy-code={code.trim()}
>
  <span class="dev-btn__icon code-copy__icons" aria-hidden="true">
    <span class="code-copy__glyph code-copy__glyph--copy" set:html={sizeIcon(copyIcon, 16)} />
    <span class="code-copy__glyph code-copy__glyph--check">✓</span>
  </span>
  <span class="sr-only" role="status"></span>
</button>

<style>
  .code-copy {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: 0.5em;
    translate: 0 -50%;
    /* Quieter at rest; fades to the ghost button's label colour on hover. */
    color: var(--sys-color-on-srf-subtle);
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .code-copy:hover {
      color: var(--comp-button-label);
      background-color: var(--comp-button-ghost-container-pressed);
    }
  }

  .code-copy:active { background-color: var(--sys-color-srf-container-high); }

  .code-copy:focus-visible { color: var(--comp-button-label); }

  .code-copy--top {
    top: 0.5em;
    translate: none;
  }

  .code-copy__icons {
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .code-copy__glyph {
    grid-area: 1 / 1;
    line-height: 1;
    transition:
      opacity var(--icon-swap-dur) var(--icon-swap-ease),
      filter var(--icon-swap-dur) var(--icon-swap-ease),
      transform var(--icon-swap-dur) var(--icon-swap-ease);
  }

  .code-copy:not([data-copied]) .code-copy__glyph--check,
  .code-copy[data-copied] .code-copy__glyph--copy {
    opacity: 0;
    filter: blur(var(--icon-swap-blur));
    transform: scale(var(--icon-swap-start-scale));
  }

  @media (prefers-reduced-motion: reduce) {
    .code-copy {
      --icon-swap-blur: 0px;
      --icon-swap-start-scale: 1;
      transition: none;
    }
    .code-copy__glyph { transition-property: opacity; }
  }
</style>
