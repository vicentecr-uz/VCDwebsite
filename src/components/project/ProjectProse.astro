---
import { projectStackClass, resolveProjectSpacing, type ProjectStackSpacing } from '../../lib/projectStack';

interface Props {
  tightTop?: boolean;
  tightBottom?: boolean;
  /** Prefer over tightTop when set. */
  spacing?: ProjectStackSpacing;
}

const { tightTop = false, tightBottom = false, spacing } = Astro.props;
const stackClass = projectStackClass(resolveProjectSpacing(spacing, tightTop), {
  precedeRelated: tightBottom,
});
---

<section class:list={['project-block', 'project-prose', stackClass]}>
  <slot />
</section>
