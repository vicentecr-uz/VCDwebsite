---
import { projectImage } from '../../lib/images';
import { projectStackClass, type ProjectStackSpacing } from '../../lib/projectStack';

interface Item {
  src: string;
  alt?: string;
}

interface Props {
  leftSrc: string;
  leftAlt?: string;
  items: Item[];
  spacing?: ProjectStackSpacing;
}

const { leftSrc, leftAlt = '', items, spacing = 'section' } = Astro.props;
const stackClass = projectStackClass(spacing);
---

<div class:list={['project-block', stackClass]}>
  <div class="project-layout-split">
    <div class="project-layout-split__left">
      <img src={projectImage(leftSrc)} alt={leftAlt} loading="lazy" />
    </div>
    <div class="project-ikea-grid">
      {items.map((item) => (
        <img src={projectImage(item.src)} alt={item.alt ?? ''} loading="lazy" />
      ))}
    </div>
  </div>
</div>
