---
import { projectImage } from '../../lib/images';
import {
  normalizeImageVariants,
  responsiveImageStyle,
  type ImageVariants,
} from '../../lib/responsiveImage';

interface Props {
  src: string;
  alt: string;
  variant?: 'default' | 'conic' | 'tapico';
  crop?: { x?: number; y?: number; zoom?: number };
  variants?: ImageVariants;
}

const { src, alt, variant = 'default', crop, variants: suppliedVariants } = Astro.props;
const variants = variant === 'tapico'
  ? normalizeImageVariants(suppliedVariants, '16:10', crop)
  : undefined;
const editPanelKey = import.meta.env.DEV && variant === 'tapico' ? 'tapico-image' : undefined;
---

<div
  class:list={[
    'project-hero',
    variant !== 'default' && `project-hero--${variant}`,
    variants && 'project-responsive-image',
    editPanelKey && 'dev-image-edit-target',
  ]}
  style={variants ? responsiveImageStyle(variants) : undefined}
  data-dev-image-target={editPanelKey}
  data-dev-crop-id={editPanelKey ? 'hero' : undefined}
  data-dev-image-variants={editPanelKey && variants ? JSON.stringify(variants) : undefined}
>
  <img src={projectImage(src)} alt={alt} class="project-hero__img" loading="eager" />
  {editPanelKey && (
    <button
      type="button"
      class="dev-image-edit-trigger"
      data-dev-edit-trigger={editPanelKey}
      data-dev-mode-only
      hidden
    >
      Edit image
    </button>
  )}
</div>

{variant === 'tapico' && (
  <script>
    const sizeTapicoHeroCovers = () => {
      document.querySelectorAll<HTMLElement>('.project-hero--tapico').forEach((hero) => {
        const image = hero.querySelector<HTMLImageElement>('.project-hero__img');
        if (!image?.naturalWidth || !image.naturalHeight) return;

        const frameWidth = hero.clientWidth;
        const frameHeight = hero.clientHeight;
        if (!frameWidth || !frameHeight) return;

        const coverScale = Math.max(
          (frameWidth + 2) / image.naturalWidth,
          (frameHeight + 2) / image.naturalHeight,
        );
        image.style.width = `${Math.ceil(image.naturalWidth * coverScale)}px`;
        image.style.height = `${Math.ceil(image.naturalHeight * coverScale)}px`;
      });
    };

    const initTapicoHeroCover = () => {
      sizeTapicoHeroCovers();
      document.querySelectorAll<HTMLImageElement>('.project-hero--tapico .project-hero__img').forEach((image) => {
        image.addEventListener('load', sizeTapicoHeroCovers);
      });
      window.addEventListener('resize', sizeTapicoHeroCovers);
      if (typeof ResizeObserver !== 'undefined') {
        document.querySelectorAll<HTMLElement>('.project-hero--tapico').forEach((hero) => {
          new ResizeObserver(sizeTapicoHeroCovers).observe(hero);
        });
      }
    };

    initTapicoHeroCover();
  </script>
)}
