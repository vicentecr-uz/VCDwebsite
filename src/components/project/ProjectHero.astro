---
import { projectImage } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  variant?: 'default' | 'conic';
}

const { src, alt, variant = 'default' } = Astro.props;
---

<div class:list={['project-hero', variant === 'conic' && 'project-hero--conic']}>
  <img src={projectImage(src)} alt={alt} class="project-hero__img" loading="eager" />
</div>
