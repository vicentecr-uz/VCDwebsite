<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    if (params.get('videoDebug') !== '1') return;
    const errors = [];
    let sent = false;
    const addError = (message, filename) => {
      if (errors.length >= 8) return;
      errors.push({ message: String(message || '').slice(0, 300), filename: String(filename || '').slice(0, 300) });
    };
    window.addEventListener('error', (event) => {
      if (event.target && event.target !== window) {
        const tag = event.target.tagName?.toLowerCase();
        if (tag !== 'script') return;
        addError('Script load failed', event.target.src || event.filename);
        return;
      }
      addError(event.message, event.filename);
    }, true);
    window.addEventListener('unhandledrejection', (event) => addError(event.reason?.message || event.reason, 'unhandledrejection'));
    const send = async () => {
      if (sent) return;
      sent = true;
      const tags = ['media-controller', 'media-play-button', 'media-time-range', 'media-mute-button', 'media-volume-range'];
      const definitions = Object.fromEntries(tags.map((tag) => [tag, Boolean(customElements.get(tag))]));
      const videos = [...document.querySelectorAll('video')].slice(0, 8).map((video) => {
        const controller = video.closest('media-controller');
        const style = getComputedStyle(video);
        return {
          controls: video.controls,
          playsInline: video.playsInline,
          readyState: video.readyState,
          errorCode: video.error?.code ?? null,
          controllerExists: Boolean(controller),
          enhancedMarker: Boolean(controller?.hasAttribute('data-project-video-controller')),
          customPlayCount: controller?.querySelectorAll('.project-video-player__play').length || 0,
          computedVideoTransform: style.transform,
          computedControllerDisplay: controller ? getComputedStyle(controller).display : null,
        };
      });
      const report = { pathname: location.pathname, userAgent: navigator.userAgent.slice(0, 300), errors, definitions, videos };
      const badge = document.createElement('div');
      badge.textContent = 'Video diagnostic sent';
      badge.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:2147483647;padding:6px 8px;background:#111;color:#fff;font:12px system-ui';
      try {
        const response = await fetch('/api/video-diagnostics', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(report) });
        if (!response.ok) throw new Error('diagnostic request failed');
      } catch {
        badge.textContent = 'Video diagnostic failed';
      }
      document.body.append(badge);
    };
    const start = () => setTimeout(send, 5000);
    if (document.readyState === 'loading') window.addEventListener('load', start, { once: true });
    else start();
  })();
</script>
