---
/** Singleton dev dialogs + handlers for Home / Work / Play project grids. */
import { getTeaserPassword } from '../lib/teaserAuth';

const teaserPassword = getTeaserPassword();
const listingGrids = ['home', 'work', 'play'] as const;
---

<dialog class="dev-project-dialog" data-dev-project-create-dialog>
  <form method="dialog" class="dev-project-dialog__panel" data-dev-project-create-form>
    <h2>New project page</h2>
    <label>
      Title
      <input type="text" name="title" required placeholder="Project title" />
    </label>
    <label>
      Slug
      <input type="text" name="slug" required placeholder="project-slug" pattern="[a-z0-9-]+" />
    </label>
    <div class="dev-project-dialog__actions">
      <button type="button" value="cancel">Cancel</button>
      <button type="submit" value="create">Create</button>
    </div>
  </form>
</dialog>

<dialog class="dev-project-dialog dev-project-dialog--settings" data-dev-project-settings-dialog>
  <form method="dialog" class="dev-project-dialog__shell" data-dev-project-settings-form>
    <div class="dev-project-dialog__scroll">
      <h2>Project settings</h2>
      <input type="hidden" name="slug" />
      <div class="dev-project-dialog__basics">
        <label>
          Title
          <input type="text" name="title" required />
        </label>
        <label>
          Visibility
          <select name="status">
            <option value="published">Published</option>
            <option value="draft">Draft</option>
            <option value="teaser">Teaser</option>
          </select>
        </label>
        <label class="dev-project-dialog__span-all">
          Description
          <textarea name="description" rows="2"></textarea>
        </label>
      </div>

      <div class="dev-project-dialog__grids">
        {listingGrids.map((grid) => (
          <fieldset class="dev-project-dialog__grid" data-dev-grid-panel={grid}>
            <legend class="dev-project-dialog__grid-legend">
              <label class="dev-project-dialog__grid-toggle">
                <input type="checkbox" name={`listing-${grid}`} data-dev-grid-toggle={grid} />
                <span>{grid === 'home' ? 'Home' : grid === 'work' ? 'Work' : 'Play'}</span>
              </label>
            </legend>
            <div class="dev-project-dialog__grid-fields" data-dev-grid-fields={grid}>
              <div class="dev-project-dialog__cover-drop" data-dev-cover-drop={grid}>
                <img alt="" data-dev-cover-preview={grid} hidden />
                <p class="dev-project-dialog__cover-drop-label" data-dev-cover-drop-label={grid}>
                  Drop cover image
                </p>
                <button type="button" data-dev-cover-choose={grid}>Choose file</button>
                <input type="file" accept="image/*" hidden data-dev-cover-file={grid} />
              </div>
              <label>
                Cover image URL
                <input type="text" name={`image-${grid}`} data-dev-cover-url={grid} />
              </label>
              <label>
                Card background
                <input type="text" name={`bg-${grid}`} />
              </label>
              <label class="dev-project-dialog__inline">
                <input type="checkbox" name={`dark-${grid}`} />
                Light text on card
              </label>
              <label class="dev-project-dialog__inline">
                <input type="checkbox" name={`full-${grid}`} />
                Full-width card
              </label>
              <label>
                {grid === 'play' ? 'Meta' : 'Year'}
                <input type="text" name={`subtitle-${grid}`} />
              </label>
            </div>
          </fieldset>
        ))}
      </div>

      <div class="dev-project-dialog__basics">
        <label>
          Teaser label
          <input type="text" name="teaserLabel" placeholder="Coming soon" />
        </label>
        <label>
          Teaser cover image URL
          <input type="text" name="teaserCover" />
        </label>
      </div>

      <fieldset class="dev-project-dialog__danger">
        <legend>Advanced</legend>
        <label>
          Rename slug
          <input type="text" name="newSlug" placeholder="new-project-slug" pattern="[a-z0-9-]+" />
        </label>
        <div class="dev-project-dialog__danger-actions">
          <button type="button" data-dev-project-rename>Rename</button>
          <button type="button" data-dev-project-delete>Delete project</button>
        </div>
      </fieldset>
    </div>

    <div class="dev-project-dialog__actions dev-project-dialog__actions--footer">
      <button type="button" value="cancel">Cancel</button>
      <button type="submit" value="save">Save</button>
    </div>
  </form>
</dialog>

<script define:vars={{ teaserPassword, listingGrids }}>
  const createDialog = document.querySelector('[data-dev-project-create-dialog]');
  const createForm = document.querySelector('[data-dev-project-create-form]');
  const settingsDialog = document.querySelector('[data-dev-project-settings-dialog]');
  const settingsForm = document.querySelector('[data-dev-project-settings-form]');
  const renameButton = settingsForm?.querySelector('[data-dev-project-rename]');
  const deleteButton = settingsForm?.querySelector('[data-dev-project-delete]');

  let activeGrid = 'work';

  const slugify = (value) => value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 48);

  const setFieldValue = (form, name, value) => {
    const field = form.elements.namedItem(name);
    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
      field.value = value;
    }
  };

  const setFieldChecked = (form, name, checked) => {
    const field = form.elements.namedItem(name);
    if (field instanceof HTMLInputElement) field.checked = checked;
  };

  const syncGridFieldVisibility = (form, grid) => {
    const toggle = form.elements.namedItem(`listing-${grid}`);
    const fields = form.querySelector(`[data-dev-grid-fields="${grid}"]`);
    const enabled = toggle instanceof HTMLInputElement && toggle.checked;
    if (fields instanceof HTMLElement) {
      fields.hidden = !enabled;
    }
  };

  const syncAllGridFieldVisibility = (form) => {
    for (const grid of listingGrids) syncGridFieldVisibility(form, grid);
  };

  const readFileAsBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const result = String(reader.result || '');
      resolve(result.includes(',') ? result.split(',')[1] : result);
    };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });

  const syncCoverPreview = (form, grid, url = '') => {
    const preview = form.querySelector(`[data-dev-cover-preview="${grid}"]`);
    const label = form.querySelector(`[data-dev-cover-drop-label="${grid}"]`);
    const drop = form.querySelector(`[data-dev-cover-drop="${grid}"]`);
    const trimmed = String(url || '').trim();
    if (preview instanceof HTMLImageElement) {
      if (trimmed) {
        preview.src = trimmed;
        preview.hidden = false;
      } else {
        preview.removeAttribute('src');
        preview.hidden = true;
      }
    }
    if (label instanceof HTMLElement) {
      label.textContent = trimmed ? 'Drop to replace cover image' : 'Drop cover image';
    }
    if (drop instanceof HTMLElement) {
      drop.classList.toggle('has-image', Boolean(trimmed));
    }
  };

  const uploadCoverImage = async (slug, file) => {
    const data = await readFileAsBase64(file);
    const response = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        document: slug,
        files: [{ filename: file.name, data, mimeType: file.type }],
      }),
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || 'Could not upload the cover image.');
    const filename = payload.filenames?.[0];
    if (!filename) throw new Error('Could not upload the cover image.');
    return `/draft-media/${slug}/${filename}`;
  };

  const applyCoverFile = async (form, grid, file) => {
    if (!(file instanceof File) || !file.type.startsWith('image/')) return;
    const slugField = form.elements.namedItem('slug');
    const slug = slugField instanceof HTMLInputElement ? slugField.value.trim() : '';
    if (!slug) {
      window.alert('Could not determine which project to upload to.');
      return;
    }
    try {
      const url = await uploadCoverImage(slug, file);
      setFieldValue(form, `image-${grid}`, url);
      syncCoverPreview(form, grid, url);
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not upload the cover image.');
    }
  };

  const initCoverDropZones = (form) => {
    for (const grid of listingGrids) {
      const drop = form.querySelector(`[data-dev-cover-drop="${grid}"]`);
      const fileInput = form.querySelector(`[data-dev-cover-file="${grid}"]`);
      const chooseButton = form.querySelector(`[data-dev-cover-choose="${grid}"]`);
      const urlInput = form.querySelector(`[data-dev-cover-url="${grid}"]`);

      chooseButton?.addEventListener('click', () => {
        if (fileInput instanceof HTMLInputElement) fileInput.click();
      });

      fileInput?.addEventListener('change', () => {
        if (!(fileInput instanceof HTMLInputElement) || !fileInput.files?.[0]) return;
        void applyCoverFile(form, grid, fileInput.files[0]);
        fileInput.value = '';
      });

      drop?.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
        if (drop instanceof HTMLElement) drop.dataset.active = 'true';
      });

      drop?.addEventListener('dragleave', () => {
        if (drop instanceof HTMLElement) delete drop.dataset.active;
      });

      drop?.addEventListener('drop', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (drop instanceof HTMLElement) delete drop.dataset.active;
        const file = event.dataTransfer?.files?.[0];
        if (file) void applyCoverFile(form, grid, file);
      });

      urlInput?.addEventListener('input', () => {
        if (urlInput instanceof HTMLInputElement) {
          syncCoverPreview(form, grid, urlInput.value);
        }
      });
    }
  };

  if (settingsForm instanceof HTMLFormElement) {
    initCoverDropZones(settingsForm);
  }

  const confirmBeforeReload = () => {
    const event = new CustomEvent('vcd:before-reload', { cancelable: true });
    window.dispatchEvent(event);
    return !event.defaultPrevented;
  };

  const reloadPage = () => {
    if (!confirmBeforeReload()) return;
    window.location.reload();
  };

  const navigateAway = (href) => {
    if (!confirmBeforeReload()) return;
    window.location.assign(href);
  };

  const buildListingPayload = (grid, formData) => {
    if (!formData.get(`listing-${grid}`)) return null;
    const listing = {
      image: String(formData.get(`image-${grid}`) || ''),
      bg: String(formData.get(`bg-${grid}`) || '#efefef'),
      dark: formData.get(`dark-${grid}`) === 'on',
      full: formData.get(`full-${grid}`) === 'on',
    };
    if (grid === 'play') {
      return { ...listing, meta: String(formData.get(`subtitle-${grid}`) || '') };
    }
    return { ...listing, year: String(formData.get(`subtitle-${grid}`) || '') };
  };

  const openCreateDialog = () => {
    if (!(createDialog instanceof HTMLDialogElement) || !(createForm instanceof HTMLFormElement)) return;
    createForm.reset();
    createDialog.showModal();
    const titleInput = createForm.querySelector('input[name="title"]');
    const slugInput = createForm.querySelector('input[name="slug"]');
    if (titleInput instanceof HTMLInputElement) {
      titleInput.focus();
      titleInput.addEventListener('input', () => {
        if (slugInput instanceof HTMLInputElement && !slugInput.dataset.touched) {
          slugInput.value = slugify(titleInput.value);
        }
      }, { once: true });
    }
    if (slugInput instanceof HTMLInputElement) {
      slugInput.addEventListener('input', () => {
        slugInput.dataset.touched = 'true';
      }, { once: true });
    }
  };

  const openSettingsDialog = async (slug) => {
    if (!(settingsDialog instanceof HTMLDialogElement) || !(settingsForm instanceof HTMLFormElement)) return;
    const response = await fetch(`/api/project-settings?slug=${encodeURIComponent(slug)}`);
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not load project settings.');
      return;
    }

    const form = settingsForm;
    setFieldValue(form, 'slug', slug);
    setFieldValue(form, 'title', payload.title ?? '');
    setFieldValue(form, 'description', payload.description ?? '');
    setFieldValue(form, 'status', payload.status ?? 'draft');
    setFieldValue(form, 'teaserLabel', payload.teaser?.label ?? '');
    setFieldValue(form, 'teaserCover', payload.teaser?.coverImage ?? '');
    setFieldValue(form, 'newSlug', '');

    for (const grid of listingGrids) {
      const listing = payload.listings?.[grid];
      setFieldChecked(form, `listing-${grid}`, Boolean(listing));
      setFieldValue(form, `image-${grid}`, listing?.image ?? '');
      setFieldValue(form, `bg-${grid}`, listing?.bg ?? '#efefef');
      setFieldChecked(form, `dark-${grid}`, Boolean(listing?.dark));
      setFieldChecked(form, `full-${grid}`, Boolean(listing?.full));
      setFieldValue(
        form,
        `subtitle-${grid}`,
        grid === 'play' ? (listing?.meta ?? '') : (listing?.year ?? ''),
      );
      syncCoverPreview(form, grid, listing?.image ?? '');
    }

    syncAllGridFieldVisibility(form);
    settingsDialog.showModal();
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const newButton = target.closest('[data-dev-project-new]');
    if (newButton) {
      event.preventDefault();
      const gridRoot = newButton.closest('[data-dev-project-grid]');
      activeGrid = gridRoot?.getAttribute('data-dev-project-grid') ?? 'work';
      openCreateDialog();
      return;
    }

    const settingsButton = target.closest('[data-dev-project-settings]');
    if (settingsButton instanceof HTMLElement) {
      event.preventDefault();
      event.stopPropagation();
      const slug = settingsButton.dataset.devProjectSettings;
      if (slug) void openSettingsDialog(slug);
      return;
    }

    const teaserCard = target.closest('[data-dev-teaser-slug]');
    if (teaserCard instanceof HTMLElement && event.altKey) {
      event.preventDefault();
      const href = teaserCard.dataset.devTeaserHref;
      const password = window.prompt('Enter teaser password');
      if (!password) return;
      if (password !== teaserPassword) {
        window.alert('Incorrect password.');
        return;
      }
      if (href) navigateAway(href);
    }
  });

  settingsForm?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || !(settingsForm instanceof HTMLFormElement)) return;
    const grid = target.dataset.devGridToggle;
    if (grid) syncGridFieldVisibility(settingsForm, grid);
  });

  createForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(createForm instanceof HTMLFormElement)) return;
    const formData = new FormData(createForm);
    const title = String(formData.get('title') || '').trim();
    const slug = String(formData.get('slug') || '').trim();
    const response = await fetch('/api/project-create', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title, slug, grid: activeGrid }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not create the project.');
      return;
    }
    navigateAway(`/${slug}`);
  });

  createForm?.querySelector('button[value="cancel"]')?.addEventListener('click', () => {
    if (createDialog instanceof HTMLDialogElement) createDialog.close();
  });

  settingsForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(settingsForm instanceof HTMLFormElement)) return;
    const formData = new FormData(settingsForm);
    const slug = String(formData.get('slug') || '').trim();
    const listings = {};
    for (const grid of listingGrids) {
      listings[grid] = buildListingPayload(grid, formData);
    }
    const response = await fetch('/api/project-settings', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        slug,
        title: String(formData.get('title') || '').trim(),
        description: String(formData.get('description') || '').trim(),
        status: String(formData.get('status') || 'draft'),
        listings,
        teaser: {
          label: String(formData.get('teaserLabel') || ''),
          coverImage: String(formData.get('teaserCover') || ''),
        },
      }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not save project settings.');
      return;
    }
    if (payload.moved?.length) {
      window.alert(`Published ${payload.moved.length} image(s) to public/images.`);
    }
    reloadPage();
  });

  settingsForm?.querySelector('button[value="cancel"]')?.addEventListener('click', () => {
    if (settingsDialog instanceof HTMLDialogElement) settingsDialog.close();
  });

  renameButton?.addEventListener('click', async () => {
    if (!(settingsForm instanceof HTMLFormElement)) return;
    const formData = new FormData(settingsForm);
    const slug = String(formData.get('slug') || '').trim();
    const newSlug = String(formData.get('newSlug') || '').trim();
    if (!newSlug || newSlug === slug) {
      window.alert('Enter a new slug that differs from the current one.');
      return;
    }
    if (!window.confirm(`Rename "${slug}" to "${newSlug}"?`)) return;
    const response = await fetch('/api/project-rename', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug, newSlug }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not rename the project.');
      return;
    }
    navigateAway(`/${newSlug}`);
  });

  deleteButton?.addEventListener('click', async () => {
    if (!(settingsForm instanceof HTMLFormElement)) return;
    const slug = String(new FormData(settingsForm).get('slug') || '').trim();
    if (!window.confirm(`Delete "${slug}" and its draft media? This cannot be undone.`)) return;
    const response = await fetch('/api/project-delete', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not delete the project.');
      return;
    }
    navigateAway('/work');
  });

</script>

<style is:global>
  .dev-project-dialog {
    border: 0;
    padding: 0;
    margin: auto;
    background: transparent;
  }

  .dev-project-dialog:not([open]) {
    display: none !important;
  }

  .dev-project-dialog::backdrop {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(8px);
  }

  .dev-project-dialog--settings {
    width: min(58em, calc(100vw - 2em));
    max-height: calc(100vh - 2em);
    border: 1px solid #ddd;
    border-radius: 0.5em;
    background: #fff;
    color: #111;
    overflow: hidden;
  }

  .dev-project-dialog__panel {
    display: grid;
    gap: 0.85em;
    width: min(28em, calc(100vw - 2em));
    padding: 1.25em;
    border: 1px solid #ddd;
    border-radius: 0.5em;
    background: #fff;
    color: #111;
  }

  .dev-project-dialog__shell {
    display: flex;
    flex-direction: column;
    max-height: min(35em, calc(100vh - 2em));
    margin: 0;
  }

  .dev-project-dialog__scroll {
    display: grid;
    gap: 0.75em;
    min-height: 0;
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 1.1em 1.25em 0.9em;
    overscroll-behavior: contain;
  }

  .dev-project-dialog__scroll h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .dev-project-dialog__basics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65em;
  }

  .dev-project-dialog__span-all {
    grid-column: 1 / -1;
  }

  .dev-project-dialog__grids {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65em;
  }

  .dev-project-dialog__grids .dev-project-dialog__grid:last-child {
    grid-column: 1 / -1;
  }

  .dev-project-dialog__grids .dev-project-dialog__grid:last-child .dev-project-dialog__grid-fields {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dev-project-dialog__grids .dev-project-dialog__grid:last-child .dev-project-dialog__cover-drop {
    grid-column: 1 / -1;
  }

  .dev-project-dialog__panel h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .dev-project-dialog__scroll label,
  .dev-project-dialog__scroll fieldset,
  .dev-project-dialog__panel label,
  .dev-project-dialog__panel fieldset {
    display: grid;
    gap: 0.35em;
    font-size: 0.92rem;
  }

  .dev-project-dialog__grid {
    border: 1px solid #e5e5e5;
    border-radius: 0.35em;
    padding: 0.65em 0.75em;
    margin: 0;
  }

  .dev-project-dialog__grid-legend {
    padding: 0;
    margin: 0 0 0.45em;
  }

  .dev-project-dialog__grid-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 600;
  }

  .dev-project-dialog__grid-fields {
    display: grid;
    gap: 0.55em;
  }

  .dev-project-dialog__inline {
    display: flex !important;
    align-items: center;
    gap: 0.45em;
  }

  .dev-project-dialog__cover-drop {
    display: grid;
    gap: 0.45em;
    justify-items: center;
    min-height: 5.5em;
    padding: 0.65em;
    border: 1px dashed #ccc;
    border-radius: 0.35em;
    background: #fafafa;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .dev-project-dialog__cover-drop[data-active='true'] {
    border-color: #888;
    background: #f3f3f3;
  }

  .dev-project-dialog__cover-drop.has-image {
    min-height: 6.5em;
  }

  .dev-project-dialog__cover-drop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  .dev-project-dialog__cover-drop-label {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #555;
    font-size: 0.82rem;
  }

  .dev-project-dialog__cover-drop button {
    position: relative;
    z-index: 1;
    padding: 0.3em 0.55em;
    border: 1px solid #ccc;
    border-radius: 0.3em;
    background: rgba(255, 255, 255, 0.92);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .dev-project-dialog__danger {
    border-color: #f0d4d4;
    background: #fff8f8;
    margin: 0;
  }

  .dev-project-dialog__danger-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .dev-project-dialog__scroll input[type='text'],
  .dev-project-dialog__scroll textarea,
  .dev-project-dialog__scroll select,
  .dev-project-dialog__panel input[type='text'],
  .dev-project-dialog__panel textarea,
  .dev-project-dialog__panel select {
    width: 100%;
    padding: 0.55em 0.65em;
    border: 1px solid #ccc;
    border-radius: 0.35em;
    font: inherit;
  }

  .dev-project-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    justify-content: flex-end;
  }

  .dev-project-dialog__actions--footer {
    flex-shrink: 0;
    padding: 0.55em 1.25em 0.75em;
    border-top: 1px solid #eee;
    background: #fff;
  }

  .dev-project-dialog__actions button,
  .dev-project-dialog__danger-actions button {
    padding: 0.35em 0.65em;
    border: 1px solid #ccc;
    border-radius: 0.35em;
    background: #f7f7f7;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }

  .dev-project-dialog__danger-actions button[data-dev-project-delete] {
    border-color: #d88;
