---
/** Singleton dev dialogs + handlers for Home / Work / Play project grids. */
import DevOverlay from './DevOverlay.astro';
import { getTeaserPassword } from '../lib/teaserAuth';

const teaserPassword = getTeaserPassword();
---

<dialog class="dev-project-dialog" data-dev-project-create-dialog>
  <form method="dialog" class="dev-project-dialog__panel" data-dev-project-create-form>
    <h2>New project page</h2>
    <label>
      Title
      <input type="text" name="title" required placeholder="Project title" />
    </label>
    <label>
      Slug
      <input type="text" name="slug" required placeholder="project-slug" pattern="[a-z0-9-]+" />
    </label>
    <div class="dev-project-dialog__actions">
      <button type="button" value="cancel">Cancel</button>
      <button type="submit" value="create">Create</button>
    </div>
  </form>
</dialog>

<DevOverlay
  title="Project settings"
  storageKey="project-settings"
  panelKey="project-settings"
  defaultHidden
>
  <div class="dev-project-settings" data-dev-project-settings-root>
    <p class="dev-project-settings__hint">
      Edit the title and subtitle on the card directly. Other changes stage until Save.
    </p>

    <label class="dev-project-settings__field">
      <span>Visibility</span>
      <select data-ps-status>
        <option value="published">Published</option>
        <option value="draft">Draft</option>
        <option value="teaser">Teaser</option>
      </select>
    </label>

    <div class="dev-project-settings__listing" data-ps-listing-fields>
      <div data-ps-cover-fields>
        <div class="dev-project-settings__cover-drop" data-ps-cover-drop>
          <img alt="" data-ps-cover-preview hidden />
          <p class="dev-project-settings__cover-label" data-ps-cover-drop-label>
            Drop cover image
          </p>
          <button type="button" data-ps-cover-choose>Choose file</button>
          <input type="file" accept="image/*" hidden data-ps-cover-file />
        </div>

        <label class="dev-project-settings__field">
          <span>Cover image URL</span>
          <input type="text" data-ps-cover-url />
        </label>
      </div>

      <label class="dev-project-settings__field" data-ps-hover-wrap>
        <span>Hover image URL</span>
        <input type="text" data-ps-hover-url placeholder="Optional in-context shot" />
      </label>

      <label class="dev-project-settings__field">
        <span>Card background</span>
        <input type="text" data-ps-bg />
      </label>

      <label class="dev-project-settings__inline">
        <input type="checkbox" data-ps-dark />
        <span>Light text on card</span>
      </label>

      <label class="dev-project-settings__inline" data-ps-full-wrap hidden>
        <input type="checkbox" data-ps-full />
        <span>Full-width card</span>
      </label>
    </div>

    <div class="dev-project-settings__teaser" data-ps-teaser-fields hidden>
      <label class="dev-project-settings__field">
        <span>Teaser cover image URL</span>
        <input type="text" data-ps-teaser-cover />
      </label>
      <p class="dev-project-settings__note">
        Teaser label is edited on the card. Hover image is not used in teaser mode.
      </p>
    </div>

    <fieldset class="dev-project-settings__advanced">
      <legend>Advanced</legend>
      <label class="dev-project-settings__field">
        <span>Description</span>
        <textarea data-ps-description rows="2"></textarea>
      </label>
      <label class="dev-project-settings__field">
        <span>Rename slug</span>
        <input type="text" data-ps-new-slug placeholder="new-project-slug" pattern="[a-z0-9-]+" />
      </label>
      <div class="dev-project-settings__danger-actions">
        <button type="button" data-ps-rename>Rename</button>
        <button type="button" data-ps-delete>Delete project</button>
      </div>
    </fieldset>

    <p class="dev-project-settings__status" data-ps-status-line aria-live="polite"></p>
  </div>
</DevOverlay>

<script define:vars={{ teaserPassword }}>
  const createDialog = document.querySelector('[data-dev-project-create-dialog]');
  const createForm = document.querySelector('[data-dev-project-create-form]');
  const settingsPanel = document.querySelector('[data-dev-panel-key="project-settings"]');
  const settingsRoot = document.querySelector('[data-dev-project-settings-root]');

  const statusSelect = settingsRoot?.querySelector('[data-ps-status]');
  const listingFields = settingsRoot?.querySelector('[data-ps-listing-fields]');
  const teaserFields = settingsRoot?.querySelector('[data-ps-teaser-fields]');
  const hoverWrap = settingsRoot?.querySelector('[data-ps-hover-wrap]');
  const fullWrap = settingsRoot?.querySelector('[data-ps-full-wrap]');
  const coverFields = settingsRoot?.querySelector('[data-ps-cover-fields]');
  const coverDrop = settingsRoot?.querySelector('[data-ps-cover-drop]');
  const coverPreview = settingsRoot?.querySelector('[data-ps-cover-preview]');
  const coverDropLabel = settingsRoot?.querySelector('[data-ps-cover-drop-label]');
  const coverChoose = settingsRoot?.querySelector('[data-ps-cover-choose]');
  const coverFile = settingsRoot?.querySelector('[data-ps-cover-file]');
  const coverUrl = settingsRoot?.querySelector('[data-ps-cover-url]');
  const hoverUrl = settingsRoot?.querySelector('[data-ps-hover-url]');
  const bgInput = settingsRoot?.querySelector('[data-ps-bg]');
  const darkInput = settingsRoot?.querySelector('[data-ps-dark]');
  const fullInput = settingsRoot?.querySelector('[data-ps-full]');
  const teaserCoverInput = settingsRoot?.querySelector('[data-ps-teaser-cover]');
  const descriptionInput = settingsRoot?.querySelector('[data-ps-description]');
  const newSlugInput = settingsRoot?.querySelector('[data-ps-new-slug]');
  const renameButton = settingsRoot?.querySelector('[data-ps-rename]');
  const deleteButton = settingsRoot?.querySelector('[data-ps-delete]');
  const statusLine = settingsRoot?.querySelector('[data-ps-status-line]');
  const overlayTitle = settingsPanel?.querySelector('.dev-overlay__title');

  let createActiveGrid = 'work';
  let activeSlug = '';
  let activeGrid = 'work';
  /** @type {HTMLElement | null} */
  let activeItem = null;
  /** @type {ReturnType<typeof emptySnapshot> | null} */
  let savedSnapshot = null;
  /** @type {ReturnType<typeof emptySnapshot> | null} */
  let draftSnapshot = null;

  const titleColor = (dark) => (dark ? '#f7f7f7' : '#6d6d6d');
  const subtitleColor = (dark) => (dark ? 'rgba(247,247,247,0.5)' : 'rgba(109,109,109,0.5)');

  const slugify = (value) => value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 48);

  const pendingId = (slug, grid) => `project-settings:${slug}:${grid}`;

  const emptyListing = () => ({
    image: '',
    hoverImage: '',
    bg: '#efefef',
    dark: false,
    full: false,
    subtitle: '',
  });

  const emptySnapshot = () => ({
    title: '',
    subtitle: '',
    teaserLabel: '',
    description: '',
    status: 'draft',
    listing: emptyListing(),
    teaser: { label: '', coverImage: '' },
  });

  const readFileAsBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const result = String(reader.result || '');
      resolve(result.includes(',') ? result.split(',')[1] : result);
    };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });

  const confirmBeforeReload = () => {
    const event = new CustomEvent('vcd:before-reload', { cancelable: true });
    window.dispatchEvent(event);
    return !event.defaultPrevented;
  };

  const navigateAway = (href) => {
    if (!confirmBeforeReload()) return;
    window.location.assign(href);
  };

  const gridItemForSlug = (slug) =>
    document.querySelector(`[data-dev-project-slug="${CSS.escape(slug)}"]`);

  const readInlineText = (item) => {
    const titleNode = item?.querySelector('[data-dev-project-title]');
    const subtitleNode = item?.querySelector('[data-dev-project-subtitle]');
    const teaserLabelNode = item?.querySelector('[data-dev-project-teaser-label]');
    return {
      title: titleNode?.textContent?.trim() ?? '',
      subtitle: subtitleNode?.textContent?.trim() ?? '',
      teaserLabel: teaserLabelNode?.textContent?.trim() ?? '',
    };
  };

  const snapshotsMatch = (left, right) => JSON.stringify(left) === JSON.stringify(right);

  const readFormIntoDraft = () => {
    if (!draftSnapshot) return;
    const inline = readInlineText(activeItem);
    draftSnapshot.title = inline.title;
    draftSnapshot.subtitle = inline.subtitle;
    draftSnapshot.teaserLabel = inline.teaserLabel;
    draftSnapshot.status = statusSelect instanceof HTMLSelectElement ? statusSelect.value : 'draft';
    draftSnapshot.description = descriptionInput instanceof HTMLTextAreaElement
      ? descriptionInput.value.trim()
      : '';
    draftSnapshot.listing.image = coverUrl instanceof HTMLInputElement ? coverUrl.value.trim() : '';
    draftSnapshot.listing.hoverImage = hoverUrl instanceof HTMLInputElement ? hoverUrl.value.trim() : '';
    draftSnapshot.listing.bg = bgInput instanceof HTMLInputElement ? bgInput.value.trim() : '#efefef';
    draftSnapshot.listing.dark = darkInput instanceof HTMLInputElement && darkInput.checked;
    draftSnapshot.listing.full = fullInput instanceof HTMLInputElement && fullInput.checked;
    draftSnapshot.listing.subtitle = inline.subtitle;
    draftSnapshot.teaser.label = inline.teaserLabel;
    draftSnapshot.teaser.coverImage = teaserCoverInput instanceof HTMLInputElement
      ? teaserCoverInput.value.trim()
      : '';
  };

  const buildListingPayload = (grid, listing, status) => {
    const hoverImage = String(listing.hoverImage || '').trim();
    const base = {
      image: String(listing.image || '').trim(),
      bg: String(listing.bg || '#efefef'),
      dark: Boolean(listing.dark),
      full: Boolean(listing.full),
    };
    if (status !== 'teaser' && hoverImage) base.hoverImage = hoverImage;
    if (grid === 'play') {
      return { ...base, meta: String(listing.subtitle || '') };
    }
    return { ...base, year: String(listing.subtitle || '') };
  };

  const buildSavePayload = () => {
    readFormIntoDraft();
    if (!draftSnapshot || !activeSlug) return null;
    const listings = {};
    listings[activeGrid] = buildListingPayload(activeGrid, draftSnapshot.listing, draftSnapshot.status);
    return {
      slug: activeSlug,
      title: draftSnapshot.title,
      description: draftSnapshot.description,
      status: draftSnapshot.status,
      listings,
      teaser: {
        label: draftSnapshot.teaserLabel,
        coverImage: draftSnapshot.teaser.coverImage,
      },
    };
  };

  const applyListingPreview = (item, snapshot, grid) => {
    if (!item || !snapshot) return;
    const cover = item.querySelector('.project-grid__cover');
    const baseImg = item.querySelector('.project-grid__img--base');
    const hoverImg = item.querySelector('.project-grid__img--hover');
    const titleNode = item.querySelector('[data-dev-project-title]');
    const teaserLabelNode = item.querySelector('[data-dev-project-teaser-label]');
    const card = item.querySelector('.project-grid__card');
    const isTeaser = snapshot.status === 'teaser';
    const listing = snapshot.listing;
    const displayImage = isTeaser
      ? (snapshot.teaser.coverImage || listing.image)
      : listing.image;

    item.classList.toggle('project-grid__item--full', Boolean(listing.full) && grid !== 'play');
    if (cover instanceof HTMLElement) {
      cover.style.backgroundColor = listing.bg;
      cover.classList.toggle('project-grid__cover--has-hover', !isTeaser && Boolean(listing.hoverImage));
    }
    if (baseImg instanceof HTMLImageElement && displayImage) {
      baseImg.src = displayImage;
    }
    if (hoverImg instanceof HTMLImageElement) {
      if (!isTeaser && listing.hoverImage) {
        hoverImg.src = listing.hoverImage;
        hoverImg.hidden = false;
      } else {
        hoverImg.removeAttribute('src');
        hoverImg.hidden = true;
      }
    }
    if (titleNode instanceof HTMLElement) {
      if (titleNode.textContent !== snapshot.title) titleNode.textContent = snapshot.title;
      titleNode.style.color = titleColor(listing.dark);
    }
    item.querySelectorAll('[data-dev-project-subtitle], [data-dev-project-teaser-label]').forEach((node) => {
      if (node instanceof HTMLElement) node.style.color = subtitleColor(listing.dark);
    });
    if (teaserLabelNode instanceof HTMLElement) {
      const next = snapshot.teaserLabel || 'Coming soon';
      if (teaserLabelNode.textContent !== next) teaserLabelNode.textContent = next;
    }
    if (card instanceof HTMLElement) {
      card.classList.toggle('project-grid__card--teaser', isTeaser);
    }
    const badge = item.querySelector('.project-grid__status-badge');
    if (badge instanceof HTMLElement) {
      const label = snapshot.status && snapshot.status !== 'published' ? snapshot.status : '';
      badge.textContent = label;
      badge.hidden = !label;
    }
  };

  const syncCoverPreview = (url = '') => {
    const trimmed = String(url || '').trim();
    if (coverPreview instanceof HTMLImageElement) {
      if (trimmed) {
        coverPreview.src = trimmed;
        coverPreview.hidden = false;
      } else {
        coverPreview.removeAttribute('src');
        coverPreview.hidden = true;
      }
    }
    if (coverDropLabel instanceof HTMLElement) {
      coverDropLabel.textContent = trimmed ? 'Drop to replace cover image' : 'Drop cover image';
    }
    if (coverDrop instanceof HTMLElement) {
      coverDrop.classList.toggle('has-image', Boolean(trimmed));
    }
  };

  const renderFormFromDraft = () => {
    if (!draftSnapshot) return;
    if (statusSelect instanceof HTMLSelectElement) statusSelect.value = draftSnapshot.status;
    if (coverUrl instanceof HTMLInputElement) coverUrl.value = draftSnapshot.listing.image;
    if (hoverUrl instanceof HTMLInputElement) hoverUrl.value = draftSnapshot.listing.hoverImage;
    if (bgInput instanceof HTMLInputElement) bgInput.value = draftSnapshot.listing.bg;
    if (darkInput instanceof HTMLInputElement) darkInput.checked = draftSnapshot.listing.dark;
    if (fullInput instanceof HTMLInputElement) fullInput.checked = draftSnapshot.listing.full;
    if (teaserCoverInput instanceof HTMLInputElement) {
      teaserCoverInput.value = draftSnapshot.teaser.coverImage;
    }
    if (descriptionInput instanceof HTMLTextAreaElement) {
      descriptionInput.value = draftSnapshot.description;
    }
    if (newSlugInput instanceof HTMLInputElement) newSlugInput.value = '';
    syncCoverPreview(draftSnapshot.listing.image);

    const isTeaser = draftSnapshot.status === 'teaser';
    if (listingFields instanceof HTMLElement) listingFields.hidden = false;
    if (teaserFields instanceof HTMLElement) teaserFields.hidden = !isTeaser;
    if (coverFields instanceof HTMLElement) coverFields.hidden = isTeaser;
    if (hoverWrap instanceof HTMLElement) hoverWrap.hidden = isTeaser;
    if (fullWrap instanceof HTMLElement) fullWrap.hidden = activeGrid === 'play';

    const gridLabel = activeGrid === 'home' ? 'Home' : activeGrid === 'work' ? 'Work' : 'Play';
    if (overlayTitle instanceof HTMLElement) {
      overlayTitle.textContent = `Project settings — ${gridLabel}`;
    }
    if (statusLine instanceof HTMLElement) {
      const subtitleLabel = activeGrid === 'play' ? 'meta' : 'year';
      statusLine.textContent = isTeaser
        ? `Teaser mode — edit title and teaser label on the card. Save stages ${gridLabel} listing changes.`
        : `Edit title and ${subtitleLabel} on the card. Save stages ${gridLabel} listing changes.`;
    }
  };

  const disableInlineEditing = (item) => {
    if (!item) return;
    item.classList.remove('is-dev-project-settings-active');
    item.querySelectorAll(
      '[data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label]',
    ).forEach((node) => {
      node.removeAttribute('contenteditable');
      node.removeAttribute('spellcheck');
    });
  };

  const enableInlineEditing = (item, status) => {
    if (!item) return;
    item.classList.add('is-dev-project-settings-active');
    const setEditable = (node) => {
      if (!(node instanceof HTMLElement)) return;
      try {
        node.contentEditable = 'plaintext-only';
        if (node.contentEditable !== 'plaintext-only') node.contentEditable = 'true';
      } catch {
        node.contentEditable = 'true';
      }
      node.setAttribute('spellcheck', 'true');
    };
    setEditable(item.querySelector('[data-dev-project-title]'));
    setEditable(item.querySelector('[data-dev-project-subtitle]'));
    if (status === 'teaser') setEditable(item.querySelector('[data-dev-project-teaser-label]'));
  };

  const revertToSaved = () => {
    if (!savedSnapshot || !activeItem) return;
    draftSnapshot = structuredClone(savedSnapshot);
    applyListingPreview(activeItem, draftSnapshot, activeGrid);
    renderFormFromDraft();
  };

  const syncPending = () => {
    if (!activeSlug || !savedSnapshot || !draftSnapshot) return;
    readFormIntoDraft();
    applyListingPreview(activeItem, draftSnapshot, activeGrid);
    const id = pendingId(activeSlug, activeGrid);
    if (snapshotsMatch(savedSnapshot, draftSnapshot)) {
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id } }));
      return;
    }
    const payload = buildSavePayload();
    if (!payload) return;
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
      detail: {
        id,
        kind: 'project-settings',
        payload,
        revert: () => {
          revertToSaved();
        },
      },
    }));
  };

  const closeSettings = () => {
    if (activeItem) disableInlineEditing(activeItem);
    activeSlug = '';
    activeItem = null;
    savedSnapshot = null;
    draftSnapshot = null;
    if (settingsPanel instanceof HTMLElement && !settingsPanel.hidden) {
      settingsPanel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', { detail: { panel: settingsPanel } }));
    }
  };

  const openSettingsPanel = () => {
    if (!(settingsPanel instanceof HTMLElement)) return;
    settingsPanel.hidden = false;
    window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', {
      detail: { panel: settingsPanel },
    }));
    window.dispatchEvent(new Event('resize'));
  };

  const uploadCoverImage = async (slug, file) => {
    const data = await readFileAsBase64(file);
    const response = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        document: slug,
        files: [{ filename: file.name, data, mimeType: file.type }],
      }),
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || 'Could not upload the cover image.');
    const filename = payload.filenames?.[0];
    if (!filename) throw new Error('Could not upload the cover image.');
    window.dispatchEvent(new CustomEvent('vcd:dev-content-written'));
    return `/draft-media/${slug}/${filename}`;
  };

  const applyCoverFile = async (file) => {
    if (!(file instanceof File) || !file.type.startsWith('image/') || !activeSlug) return;
    try {
      const url = await uploadCoverImage(activeSlug, file);
      if (coverUrl instanceof HTMLInputElement) coverUrl.value = url;
      if (draftSnapshot) draftSnapshot.listing.image = url;
      syncCoverPreview(url);
      syncPending();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not upload the cover image.');
    }
  };

  const openSettings = async (slug, grid) => {
    if (!slug) return;
    if (activeSlug && activeSlug !== slug) closeSettings();

    const item = gridItemForSlug(slug);
    if (!(item instanceof HTMLElement)) {
      window.alert('Could not find that project on this page.');
      return;
    }

    const response = await fetch(
      `/api/project-settings?slug=${encodeURIComponent(slug)}&grid=${encodeURIComponent(grid)}`,
    );
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not load project settings.');
      return;
    }

    const listing = payload.listings?.[grid] ?? payload.listing ?? {};
    const inline = readInlineText(item);
    const snapshot = {
      title: inline.title || payload.title || '',
      subtitle: inline.subtitle || (grid === 'play' ? listing.meta : listing.year) || '',
      teaserLabel: inline.teaserLabel || payload.teaser?.label || '',
      description: payload.description ?? '',
      status: payload.status ?? 'draft',
      listing: {
        image: listing.image ?? '',
        hoverImage: listing.hoverImage ?? '',
        bg: listing.bg ?? '#efefef',
        dark: Boolean(listing.dark),
        full: Boolean(listing.full),
        subtitle: inline.subtitle || (grid === 'play' ? listing.meta : listing.year) || '',
      },
      teaser: {
        label: inline.teaserLabel || payload.teaser?.label || '',
        coverImage: payload.teaser?.coverImage ?? '',
      },
    };

    activeSlug = slug;
    activeGrid = grid;
    activeItem = item;
    savedSnapshot = structuredClone(snapshot);
    draftSnapshot = structuredClone(snapshot);

    applyListingPreview(item, draftSnapshot, grid);
    renderFormFromDraft();
    enableInlineEditing(item, snapshot.status);
    openSettingsPanel();
    syncPending();
  };

  coverChoose?.addEventListener('click', () => {
    if (coverFile instanceof HTMLInputElement) coverFile.click();
  });

  coverFile?.addEventListener('change', () => {
    if (!(coverFile instanceof HTMLInputElement) || !coverFile.files?.[0]) return;
    void applyCoverFile(coverFile.files[0]);
    coverFile.value = '';
  });

  if (coverDrop instanceof HTMLElement) {
    coverDrop.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
      coverDrop.dataset.active = 'true';
    });
    coverDrop.addEventListener('dragleave', () => {
      delete coverDrop.dataset.active;
    });
    coverDrop.addEventListener('drop', (event) => {
      event.preventDefault();
      event.stopPropagation();
      delete coverDrop.dataset.active;
      const file = event.dataTransfer?.files?.[0];
      if (file) void applyCoverFile(file);
    });
  }

  coverUrl?.addEventListener('input', () => {
    if (coverUrl instanceof HTMLInputElement) syncCoverPreview(coverUrl.value);
    syncPending();
  });

  settingsRoot?.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.matches('[data-ps-status], [data-ps-hover-url], [data-ps-bg], [data-ps-description], [data-ps-teaser-cover]')) return;
    if (target.matches('[data-ps-status]') && draftSnapshot && target instanceof HTMLSelectElement) {
      draftSnapshot.status = target.value;
      renderFormFromDraft();
      if (activeItem) enableInlineEditing(activeItem, draftSnapshot.status);
    }
    syncPending();
  });

  settingsRoot?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.matches('[data-ps-dark], [data-ps-full]')) return;
    syncPending();
  });

  document.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !activeItem) return;
    if (!activeItem.contains(target)) return;
    if (!target.matches('[data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label]')) return;
    syncPending();
  });

  const openCreateDialog = () => {
    if (!(createDialog instanceof HTMLDialogElement) || !(createForm instanceof HTMLFormElement)) return;
    createForm.reset();
    createDialog.showModal();
    const titleInput = createForm.querySelector('input[name="title"]');
    const slugInput = createForm.querySelector('input[name="slug"]');
    if (titleInput instanceof HTMLInputElement) {
      titleInput.focus();
      titleInput.addEventListener('input', () => {
        if (slugInput instanceof HTMLInputElement && !slugInput.dataset.touched) {
          slugInput.value = slugify(titleInput.value);
        }
      }, { once: true });
    }
    if (slugInput instanceof HTMLInputElement) {
      slugInput.addEventListener('input', () => {
        slugInput.dataset.touched = 'true';
      }, { once: true });
    }
  };

  // Capture phase + stopImmediatePropagation so the card <a> never navigates
  // when the ⋮ (or its SVG child) is the click target.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const settingsButton = target.closest('[data-dev-project-settings]');
    if (settingsButton instanceof HTMLElement) {
      event.preventDefault();
      event.stopImmediatePropagation();
      const slug = settingsButton.dataset.devProjectSettings;
      const gridRoot = settingsButton.closest('[data-dev-project-grid]');
      const grid = gridRoot?.getAttribute('data-dev-project-grid') ?? 'work';
      if (slug) void openSettings(slug, grid);
      return;
    }

    const newButton = target.closest('[data-dev-project-new]');
    if (newButton) {
      event.preventDefault();
      event.stopImmediatePropagation();
      const gridRoot = newButton.closest('[data-dev-project-grid]');
      createActiveGrid = gridRoot?.getAttribute('data-dev-project-grid') ?? 'work';
      openCreateDialog();
      return;
    }

    const teaserCard = target.closest('[data-dev-teaser-slug]');
    if (teaserCard instanceof HTMLElement && event.altKey) {
      event.preventDefault();
      const href = teaserCard.dataset.devTeaserHref;
      const password = window.prompt('Enter teaser password');
      if (!password) return;
      if (password !== teaserPassword) {
        window.alert('Incorrect password.');
        return;
      }
      if (href) navigateAway(href);
    }
  }, true);

  createForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(createForm instanceof HTMLFormElement)) return;
    const formData = new FormData(createForm);
    const title = String(formData.get('title') || '').trim();
    const slug = String(formData.get('slug') || '').trim();
    const response = await fetch('/api/project-create', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title, slug, grid: createActiveGrid }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not create the project.');
      return;
    }
    navigateAway(`/${slug}`);
  });

  createForm?.querySelector('button[value="cancel"]')?.addEventListener('click', () => {
    if (createDialog instanceof HTMLDialogElement) createDialog.close();
  });

  renameButton?.addEventListener('click', async () => {
    if (!activeSlug || !(newSlugInput instanceof HTMLInputElement)) return;
    const newSlug = newSlugInput.value.trim();
    if (!newSlug || newSlug === activeSlug) {
      window.alert('Enter a new slug that differs from the current one.');
      return;
    }
    if (!window.confirm(`Rename "${activeSlug}" to "${newSlug}"?`)) return;
    const response = await fetch('/api/project-rename', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug: activeSlug, newSlug }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not rename the project.');
      return;
    }
    navigateAway(`/${newSlug}`);
  });

  deleteButton?.addEventListener('click', async () => {
    if (!activeSlug) return;
    if (!window.confirm(`Delete "${activeSlug}" and its draft media? This cannot be undone.`)) return;
    const response = await fetch('/api/project-delete', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug: activeSlug }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not delete the project.');
      return;
    }
    navigateAway('/work');
  });

  window.addEventListener('vcd:dev-edit-close', (event) => {
    const panel = event.detail?.panel;
    if (panel?.dataset?.devPanelKey !== 'project-settings') return;
    if (activeItem) disableInlineEditing(activeItem);
    activeSlug = '';
    activeItem = null;
    savedSnapshot = null;
    draftSnapshot = null;
  });

  window.addEventListener('vcd:dev-pending-reverted', () => {
    if (!activeSlug || !savedSnapshot) return;
    revertToSaved();
  });

  window.addEventListener('vcd:dev-pending-committed', () => {
    if (!activeSlug || !draftSnapshot) return;
    savedSnapshot = structuredClone(draftSnapshot);
    syncPending();
  });

  window.addEventListener('vcd:dev-mode-change', (event) => {
    if (event.detail?.active) return;
    closeSettings();
  });
</script>

