---
/** Singleton dev dialogs + handlers for Home / Work / Play project grids. */
import DevOverlay from './DevOverlay.astro';
import eyeOffIcon from 'lucide-static/icons/eye-off.svg?raw';
import filePenIcon from 'lucide-static/icons/file-pen.svg?raw';
import globeIcon from 'lucide-static/icons/globe.svg?raw';
import { sizeIcon } from '../lib/icons';
import { getTeaserPassword } from '../lib/teaserAuth';
import { PLACEHOLDER_COVER } from '../lib/placeholderCover.mjs';

const teaserPassword = getTeaserPassword();
const statusIcons = {
  published: sizeIcon(globeIcon, 14),
  draft: sizeIcon(filePenIcon, 14),
  teaser: sizeIcon(eyeOffIcon, 14),
};
---

<dialog class="dev-project-dialog" data-dev-project-create-dialog>
  <form method="dialog" class="dev-project-dialog__panel" data-dev-project-create-form>
    <h2>New project page</h2>
    <label>
      Title
      <input type="text" name="title" required placeholder="Project title" />
    </label>
    <label>
      Slug
      <input type="text" name="slug" required placeholder="project-slug" pattern="[a-z0-9-]+" />
    </label>
    <div class="dev-project-dialog__actions">
      <button type="button" value="cancel">Cancel</button>
      <button type="submit" value="create">Create</button>
    </div>
  </form>
</dialog>

<DevOverlay
  title="Project settings"
  storageKey="project-settings"
  panelKey="project-settings"
  defaultHidden
>
  <div class="dev-project-settings" data-dev-project-settings-root>
    <p class="dev-project-settings__hint" hidden></p>

    <div class="dev-project-settings__listing" data-ps-listing-fields>
      <label class="dev-project-settings__field">
        <span>Card background</span>
        <input type="text" data-ps-bg />
      </label>

      <label class="dev-project-settings__inline">
        <input type="checkbox" data-ps-dark />
        <span>Light text on card</span>
      </label>

      <label class="dev-project-settings__inline">
        <input type="checkbox" data-ps-hover-dark />
        <span>Light text on hover</span>
      </label>
    </div>

    <div class="dev-project-settings__danger-actions">
      <button type="button" data-ps-delete>Delete project</button>
    </div>

    <p class="dev-project-settings__status" data-ps-status-line aria-live="polite"></p>
  </div>
</DevOverlay>

<script>
  // #182 — measurement lives in its own module (coverLuminance.ts) so #172 can
  // lift it verbatim for runtime sampling later. The rest of this file's
  // script is `define:vars` (inline, no `import`), so this one hands the
  // function across on `window` instead of sharing scope directly.
  //
  // Must stay a plain <script>: Astro only bundles and rewrites imports for
  // unadorned tags. With type="module" it stayed inline and the browser
  // resolved `../scripts/coverLuminance` against the page URL
  // (/work -> /scripts/coverLuminance, 404), so the module never ran and every
  // drop silently took the `dark` fallback.
  import {
    coverBoxRegionToSourceRegion,
    isRegionDark,
    measureRegionLuma,
  } from '../scripts/coverLuminance';

  window.__vcdMeasureHoverDark = async function measureHoverDark(file, item) {
    let objectUrl = '';
    try {
      const cover = item?.querySelector('.project-grid__cover');
      const meta = item?.querySelector('.project-grid__meta');
      if (!(cover instanceof HTMLElement) || !(meta instanceof HTMLElement)) return null;

      const coverRect = cover.getBoundingClientRect();
      const metaRect = meta.getBoundingClientRect();
      if (!coverRect.width || !coverRect.height) return null;

      // Title's region, not the whole image — derived from real geometry so
      // it tracks the meta box's padding and the card's aspect ratio instead
      // of a hard-coded "bottom-left" guess.
      const region = {
        x: (metaRect.left - coverRect.left) / coverRect.width,
        y: (metaRect.top - coverRect.top) / coverRect.height,
        w: metaRect.width / coverRect.width,
        h: metaRect.height / coverRect.height,
      };

      objectUrl = URL.createObjectURL(file);
      const img = await new Promise((resolve, reject) => {
        const el = new Image();
        el.onload = () => resolve(el);
        el.onerror = () => reject(new Error('Could not decode image for measurement.'));
        el.src = objectUrl;
      });

      // The hover image always renders through plain `object-fit: cover`
      // (ProjectGrid.astro never wraps it in `.project-crop-clip`, unlike the
      // base cover) — so this projection is exact, not an approximation.
      const sourceRegion = coverBoxRegionToSourceRegion(
        region,
        { width: coverRect.width, height: coverRect.height },
        { width: img.naturalWidth, height: img.naturalHeight },
      );
      const luma = measureRegionLuma(img, sourceRegion);
      return isRegionDark(luma);
    } catch {
      return null;
    } finally {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    }
  };
</script>

<script define:vars={{ teaserPassword, statusIcons, placeholderCover: PLACEHOLDER_COVER }}>
  const createDialog = document.querySelector('[data-dev-project-create-dialog]');
  const createForm = document.querySelector('[data-dev-project-create-form]');
  const settingsPanel = document.querySelector('[data-dev-panel-key="project-settings"]');
  const settingsRoot = document.querySelector('[data-dev-project-settings-root]');

  const bgInput = settingsRoot?.querySelector('[data-ps-bg]');
  const darkInput = settingsRoot?.querySelector('[data-ps-dark]');
  const hoverDarkInput = settingsRoot?.querySelector('[data-ps-hover-dark]');
  const deleteButton = settingsRoot?.querySelector('[data-ps-delete]');
  const statusLine = settingsRoot?.querySelector('[data-ps-status-line]');
  const overlayTitle = settingsPanel?.querySelector('.dev-overlay__title');

  let createActiveGrid = 'work';
  /** @type {string} */
  let panelSlug = '';
  /** @type {Map<string, { grid: string, item: HTMLElement, saved: any, draft: any }>} */
  const caches = new Map();

  const titleColor = (dark) => (dark ? '#f7f7f7' : '#6d6d6d');
  const subtitleColor = (dark) => (dark ? 'rgba(247,247,247,0.5)' : 'rgba(109,109,109,0.5)');

  const slugify = (value) => value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 48);

  const pendingId = (slug, grid) => `project-settings:${slug}:${grid}`;

  const HOVER_CHIP_LABEL_OFF = 'Showing cover image — switch to hover image';
  const HOVER_CHIP_LABEL_ON = 'Showing hover image — switch to cover image';

  /** Every card carries this chip, so the accessible name has to name the card
   * too — a dozen buttons reading "switch to hover image" is unnavigable. */
  const setHoverChipLabel = (btn, pressed) => {
    if (!(btn instanceof HTMLElement)) return;
    const state = pressed ? HOVER_CHIP_LABEL_ON : HOVER_CHIP_LABEL_OFF;
    const title = btn.dataset.devHoverChipFor;
    btn.setAttribute(
      'aria-label',
      title ? `${title}: ${state.charAt(0).toLowerCase()}${state.slice(1)}` : state,
    );
    btn.title = state;
  };

  /** Mirror of isPlaceholderCoverSrc — a define:vars script is inline and
   * cannot import, so the constant comes through define:vars and the two-line
   * test is restated here. Keep in step with src/lib/placeholderCover.mjs. */
  const isPlaceholderCover = (src) => {
    const value = String(src || '').trim();
    if (!value) return true;
    return value === placeholderCover || value.includes('black-token');
  };

  const emptyListing = () => ({
    image: '',
    hoverImage: '',
    hoverDark: undefined,
    bg: '#efefef',
    dark: false,
    full: false,
    subtitle: '',
  });

  const emptySnapshot = () => ({
    title: '',
    subtitle: '',
    teaserLabel: '',
    description: '',
    status: 'draft',
    listing: emptyListing(),
    teaser: { label: '', coverImage: '' },
  });

  const readFileAsBase64 = (file) => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const result = String(reader.result || '');
      resolve(result.includes(',') ? result.split(',')[1] : result);
    };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });

  const confirmBeforeReload = () => {
    const event = new CustomEvent('vcd:before-reload', { cancelable: true });
    window.dispatchEvent(event);
    return !event.defaultPrevented;
  };

  const navigateAway = (href) => {
    if (!confirmBeforeReload()) return;
    window.location.assign(href);
  };

  const gridForItem = (item) =>
    item.closest('[data-dev-project-grid]')?.getAttribute('data-dev-project-grid') ?? 'work';

  const gridItemForSlug = (slug) =>
    document.querySelector(`[data-dev-project-slug="${CSS.escape(slug)}"]`);

  const readInlineText = (item) => {
    const titleNode = item?.querySelector('[data-dev-project-title]');
    const subtitleNode = item?.querySelector('[data-dev-project-subtitle]');
    const teaserLabelNode = item?.querySelector('[data-dev-project-teaser-label]');
    return {
      title: titleNode?.textContent?.trim() ?? '',
      subtitle: subtitleNode?.textContent?.trim() ?? '',
      teaserLabel: teaserLabelNode?.textContent?.trim() ?? '',
    };
  };

  const snapshotsMatch = (left, right) => JSON.stringify(left) === JSON.stringify(right);

  const setEditable = (node) => {
    if (!(node instanceof HTMLElement)) return;
    try {
      node.contentEditable = 'plaintext-only';
      if (node.contentEditable !== 'plaintext-only') node.contentEditable = 'true';
    } catch {
      node.contentEditable = 'true';
    }
    node.setAttribute('spellcheck', 'true');
  };

  /** Browsers often leave a lone <br> after clearing — normalize so :empty / placeholder work. */
  const normalizeEmptyEditable = (node) => {
    if (!(node instanceof HTMLElement)) return;
    const text = node.textContent?.replace(/\u00a0/g, ' ').trim() ?? '';
    if (text) return;
    if (node.innerHTML !== '') node.textContent = '';
  };

  const ensureSubtitleHost = (item) => {
    let node = item.querySelector('[data-dev-project-subtitle]');
    if (node instanceof HTMLElement) return node;
    const row = item.querySelector('.project-grid__meta .flex');
    if (!(row instanceof HTMLElement)) return null;
    node = document.createElement('span');
    node.className = 'project-grid__subtitle font-bold';
    node.setAttribute('data-dev-project-subtitle', '');
    node.dataset.placeholder = gridForItem(item) === 'play' ? 'Meta' : 'Year';
    row.append(node);
    return node;
  };

  const enableCardEditing = (item) => {
    if (!(item instanceof HTMLElement) || !item.dataset.devProjectSlug) return;
    const status = item.dataset.devStatus || 'published';
    const title = item.querySelector('[data-dev-project-title]');
    const subtitle = ensureSubtitleHost(item);
    const teaser = status === 'teaser' ? item.querySelector('[data-dev-project-teaser-label]') : null;
    setEditable(title);
    setEditable(subtitle);
    if (teaser) setEditable(teaser);
    normalizeEmptyEditable(title);
    normalizeEmptyEditable(subtitle);
    if (teaser) normalizeEmptyEditable(teaser);
  };

  const disableCardEditing = (item) => {
    if (!(item instanceof HTMLElement)) return;
    item.querySelectorAll(
      '[data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label]',
    ).forEach((node) => {
      node.removeAttribute('contenteditable');
      node.removeAttribute('spellcheck');
    });
  };

  const enableAllCardEditing = () => {
    document.querySelectorAll('[data-dev-project-slug]').forEach((item) => {
      if (item instanceof HTMLElement) enableCardEditing(item);
    });
    disarmCardLinks();
  };

  const disableAllCardEditing = () => {
    document.querySelectorAll('[data-dev-project-slug]').forEach((item) => {
      if (item instanceof HTMLElement) disableCardEditing(item);
    });
    document.querySelectorAll('.is-dev-hover-forced').forEach((node) => {
      node.classList.remove('is-dev-hover-forced');
    });
    document.querySelectorAll('[data-dev-project-hover][aria-pressed="true"]').forEach((btn) => {
      btn.setAttribute('aria-pressed', 'false');
      setHoverChipLabel(btn, false);
    });
    closeAllStatusMenus();
    restoreCardLinks();
  };

  const disarmCardLinks = () => {
    document.querySelectorAll('a.project-grid__card[href]').forEach((anchor) => {
      if (!(anchor instanceof HTMLAnchorElement)) return;
      anchor.dataset.devHref = anchor.getAttribute('href') || '';
      anchor.removeAttribute('href');
    });
  };

  const restoreCardLinks = () => {
    document.querySelectorAll('a.project-grid__card[data-dev-href]').forEach((anchor) => {
      if (!(anchor instanceof HTMLAnchorElement)) return;
      const href = anchor.dataset.devHref || '';
      if (href) anchor.setAttribute('href', href);
      delete anchor.dataset.devHref;
    });
  };

  const buildListingPayload = (grid, listing, status) => {
    const hoverImage = String(listing.hoverImage || '').trim();
    const base = {
      image: String(listing.image || '').trim(),
      bg: String(listing.bg || '#efefef'),
      dark: Boolean(listing.dark),
      full: Boolean(listing.full),
    };
    if (hoverImage) {
      base.hoverImage = hoverImage;
      if (typeof listing.hoverDark === 'boolean') base.hoverDark = listing.hoverDark;
    }
    if (grid === 'play') {
      return { ...base, meta: String(listing.subtitle || '') };
    }
    return { ...base, year: String(listing.subtitle || '') };
  };

  const buildSavePayload = (slug, grid, draft) => {
    const listings = {};
    listings[grid] = buildListingPayload(grid, draft.listing, draft.status);
    return {
      slug,
      title: draft.title,
      description: draft.description,
      status: draft.status,
      listings,
      teaser: {
        label: draft.teaserLabel,
        coverImage: draft.teaser.coverImage,
      },
    };
  };

  /** Blob object-URLs shown on the card until Save; draft URLs live only in `entry.draft`. */
  const liveCoverBlobs = new Map();

  const revokeLiveCover = (slug) => {
    const url = liveCoverBlobs.get(slug);
    if (!url) return;
    URL.revokeObjectURL(url);
    liveCoverBlobs.delete(slug);
  };

  /** Same lifecycle as liveCoverBlobs but for the hover slot — separate map,
   * separate lifetime (the hover image is never visible under a choreographed
   * crossfade at rest, so it does not share the base image's promote path). */
  const liveHoverBlobs = new Map();

  const revokeLiveHover = (slug) => {
    const url = liveHoverBlobs.get(slug);
    if (!url) return;
    URL.revokeObjectURL(url);
    liveHoverBlobs.delete(slug);
  };

  const applyListingPreview = (item, snapshot, grid) => {
    if (!item || !snapshot) return;
    const cover = item.querySelector('.project-grid__cover');
    const baseImg = item.querySelector('.project-grid__img--base');
    const hoverImg = item.querySelector('.project-grid__img--hover');
    const titleNode = item.querySelector('[data-dev-project-title]');
    const teaserLabelNode = item.querySelector('[data-dev-project-teaser-label]');
    const card = item.querySelector('.project-grid__card');
    const isTeaser = snapshot.status === 'teaser';
    const listing = snapshot.listing;
    const slug = item.getAttribute('data-dev-project-slug');
    const liveCover = slug ? liveCoverBlobs.get(slug) : null;
    const liveHover = slug ? liveHoverBlobs.get(slug) : null;
    const displayImage = liveCover
      || (isTeaser ? (snapshot.teaser.coverImage || listing.image) : listing.image);

    item.dataset.devStatus = snapshot.status;
    item.dataset.devBg = listing.bg;
    item.dataset.devDark = listing.dark ? 'true' : 'false';
    if (listing.hoverImage) item.dataset.devHoverImage = listing.hoverImage;
    else delete item.dataset.devHoverImage;

    item.classList.toggle('project-grid__item--full', Boolean(listing.full));
    if (cover instanceof HTMLElement) {
      cover.classList.toggle('project-grid__cover--has-hover', Boolean(listing.hoverImage));
      // #176 — the empty state is server-rendered, so it has to be re-derived
      // here or the "Drop cover image" label and its wash sit on top of the
      // image you just dropped until the next reload.
      if (isPlaceholderCover(displayImage)) cover.dataset.devCoverEmpty = 'true';
      else delete cover.dataset.devCoverEmpty;
    }
    if (baseImg instanceof HTMLImageElement && displayImage) {
      baseImg.src = displayImage;
    }
    if (hoverImg instanceof HTMLImageElement) {
      if (liveHover || listing.hoverImage) {
        hoverImg.src = liveHover || listing.hoverImage;
        hoverImg.hidden = false;
      } else {
        hoverImg.removeAttribute('src');
        hoverImg.hidden = true;
      }
    }
    if (titleNode instanceof HTMLElement) {
      if (document.activeElement !== titleNode && titleNode.textContent !== snapshot.title) {
        titleNode.textContent = snapshot.title;
      }
    }
    // Subtitle (Year on home/work, Meta on play) — must restore on Revert; title
    // was handled above but this field was missed, so clearing Year then Revert
    // left the DOM empty while the draft snapshot had the saved year again.
    const subtitleNode = ensureSubtitleHost(item);
    if (subtitleNode instanceof HTMLElement && document.activeElement !== subtitleNode) {
      const next = String(listing.subtitle ?? snapshot.subtitle ?? '');
      if (subtitleNode.textContent !== next) subtitleNode.textContent = next;
    }
    const meta = item.querySelector('.project-grid__meta');
    if (meta instanceof HTMLElement) {
      // Custom properties, not inline `color` — the hover swap is a `:hover`
      // rule in ProjectGrid.astro's CSS, which inline `style="color"` can't
      // respond to. `hoverDark` falls back to the base `dark` value, same as
      // the server-rendered markup.
      const hoverDark = typeof listing.hoverDark === 'boolean' ? listing.hoverDark : listing.dark;
      meta.style.setProperty('--title-ink', titleColor(listing.dark));
      meta.style.setProperty('--subtitle-ink', subtitleColor(listing.dark));
      meta.style.setProperty('--title-ink-hover', titleColor(hoverDark));
      meta.style.setProperty('--subtitle-ink-hover', subtitleColor(hoverDark));
    }
    if (teaserLabelNode instanceof HTMLElement && document.activeElement !== teaserLabelNode) {
      const next = snapshot.teaserLabel || 'Coming soon';
      if (teaserLabelNode.textContent !== next) teaserLabelNode.textContent = next;
    }
    if (card instanceof HTMLElement) {
      card.classList.toggle('project-grid__card--teaser', isTeaser);
    }
    syncStatusChip(item, snapshot.status);
    enableCardEditing(item);
  };

  const syncStatusChip = (item, status) => {
    const btn = item.querySelector('[data-dev-project-status]');
    const icon = btn?.querySelector('.project-grid__chip-icon');
    const svg = statusIcons[status] || statusIcons.published;
    if (btn instanceof HTMLElement) {
      btn.setAttribute('aria-label', `Visibility: ${status}`);
      btn.title = `Visibility: ${status}`;
    }
    if (icon instanceof HTMLElement) icon.innerHTML = svg;
    item.querySelectorAll('[data-dev-status-option]').forEach((option) => {
      if (!(option instanceof HTMLElement)) return;
      option.setAttribute(
        'aria-selected',
        option.dataset.devStatusOption === status ? 'true' : 'false',
      );
    });
  };

  window.__vcdSyncStatusChip = syncStatusChip;
  window.__vcdEnableCardEditing = enableCardEditing;

  const readInlineIntoDraft = (entry) => {
    const inline = readInlineText(entry.item);
    entry.draft.title = inline.title;
    entry.draft.subtitle = inline.subtitle;
    entry.draft.teaserLabel = inline.teaserLabel;
    entry.draft.listing.subtitle = inline.subtitle;
    entry.draft.teaser.label = inline.teaserLabel;
  };

  const syncPendingFor = (slug) => {
    const entry = caches.get(slug);
    if (!entry) return;
    readInlineIntoDraft(entry);
    applyListingPreview(entry.item, entry.draft, entry.grid);
    const id = pendingId(slug, entry.grid);
    if (snapshotsMatch(entry.saved, entry.draft)) {
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id } }));
      return;
    }
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
      detail: {
        id,
        kind: 'project-settings',
        payload: buildSavePayload(slug, entry.grid, entry.draft),
        revert: () => {
          revokeLiveCover(slug);
          revokeLiveHover(slug);
          entry.draft = structuredClone(entry.saved);
          applyListingPreview(entry.item, entry.draft, entry.grid);
          if (panelSlug === slug) renderPanelFromEntry(entry);
        },
      },
    }));
  };

  const ensureLoaded = async (slug, item) => {
    const existing = caches.get(slug);
    if (existing) {
      existing.item = item;
      return existing;
    }
    const grid = gridForItem(item);
    const response = await fetch(
      `/api/project-settings?slug=${encodeURIComponent(slug)}&grid=${encodeURIComponent(grid)}`,
    );
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || 'Could not load project settings.');

    const listing = payload.listings?.[grid] ?? payload.listing ?? {};
    const inline = readInlineText(item);
    const snapshot = {
      title: inline.title || payload.title || '',
      subtitle: inline.subtitle || (grid === 'play' ? listing.meta : listing.year) || '',
      teaserLabel: inline.teaserLabel || payload.teaser?.label || '',
      description: payload.description ?? '',
      status: payload.status ?? item.dataset.devStatus ?? 'draft',
      listing: {
        image: listing.image ?? item.querySelector('.project-grid__img--base')?.getAttribute('src') ?? '',
        hoverImage: listing.hoverImage ?? item.dataset.devHoverImage ?? '',
        hoverDark: typeof listing.hoverDark === 'boolean' ? listing.hoverDark : undefined,
        bg: listing.bg ?? item.dataset.devBg ?? '#efefef',
        dark: listing.dark ?? item.dataset.devDark === 'true',
        full: listing.full ?? item.classList.contains('project-grid__item--full'),
        subtitle: inline.subtitle || (grid === 'play' ? listing.meta : listing.year) || '',
      },
      teaser: {
        label: inline.teaserLabel || payload.teaser?.label || '',
        coverImage: payload.teaser?.coverImage ?? '',
      },
    };
    const entry = {
      grid,
      item,
      saved: structuredClone(snapshot),
      draft: structuredClone(snapshot),
    };
    caches.set(slug, entry);
    return entry;
  };

  const renderPanelFromEntry = (entry) => {
    if (bgInput instanceof HTMLInputElement) bgInput.value = entry.draft.listing.bg;
    if (darkInput instanceof HTMLInputElement) darkInput.checked = entry.draft.listing.dark;
    if (hoverDarkInput instanceof HTMLInputElement) {
      hoverDarkInput.checked = entry.draft.listing.hoverDark ?? entry.draft.listing.dark;
    }
    const gridLabel = entry.grid === 'home' ? 'Home' : entry.grid === 'work' ? 'Work' : 'Play';
    if (overlayTitle instanceof HTMLElement) {
      overlayTitle.textContent = `Project settings — ${gridLabel}`;
    }
    if (statusLine instanceof HTMLElement) {
      statusLine.textContent = 'Card background and text colour. Title, visibility, cover, and span edit on the card.';
    }
  };

  const openSettingsPanel = () => {
    if (!(settingsPanel instanceof HTMLElement)) return;
    settingsPanel.hidden = false;
    window.dispatchEvent(new CustomEvent('vcd:dev-edit-open', {
      detail: { panel: settingsPanel },
    }));
    window.dispatchEvent(new Event('resize'));
  };

  const closeSettingsPanel = () => {
    panelSlug = '';
    if (settingsPanel instanceof HTMLElement && !settingsPanel.hidden) {
      settingsPanel.hidden = true;
      window.dispatchEvent(new CustomEvent('vcd:dev-edit-close', { detail: { panel: settingsPanel } }));
    }
  };

  const openSettings = async (slug) => {
    const item = gridItemForSlug(slug);
    if (!(item instanceof HTMLElement)) {
      window.alert('Could not find that project on this page.');
      return;
    }
    try {
      const entry = await ensureLoaded(slug, item);
      panelSlug = slug;
      renderPanelFromEntry(entry);
      openSettingsPanel();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not load project settings.');
    }
  };

  window.addEventListener('vcd:dev-project-settings-open', ((event) => {
    const slug = String(event.detail?.slug || '').trim();
    if (slug) void openSettings(slug);
  }));

  /** @type {HTMLElement | null} */
  let spanModeItem = null;
  /** @type {HTMLButtonElement | null} */
  let spanModeChip = null;
  /** @type {HTMLElement | null} */
  let spanFrame = null;
  /** @type {HTMLButtonElement | null} */
  let spanHandle = null;
  let spanDrag = null;

  const cropPanelOpen = () => {
    const panel = document.querySelector('[data-dev-panel-key="image"]');
    return panel instanceof HTMLElement && !panel.hidden;
  };

  const syncSpanHandleSide = (item, handle) => {
    if (!(item instanceof HTMLElement) || !(handle instanceof HTMLElement)) return;
    const full = item.classList.contains('project-grid__item--full');
    // Free/resize edge: full or left-column half → right; right-column half → left.
    const side = full || item.offsetLeft < 24 ? 'end' : 'start';
    handle.dataset.side = side;
  };

  const exitSpanMode = () => {
    if (spanDrag) {
      spanDrag = null;
    }
    if (spanModeChip) spanModeChip.setAttribute('aria-pressed', 'false');
    if (spanModeItem) {
      spanModeItem.classList.remove('is-span-mode', 'is-span-disabled');
    }
    spanFrame?.remove();
    spanHandle?.remove();
    spanFrame = null;
    spanHandle = null;
    spanModeItem = null;
    spanModeChip = null;
  };

  const setSpanFull = async (item, full) => {
    const slug = item.getAttribute('data-dev-project-slug');
    if (!slug) return;
    const grid = gridForItem(item);
    try {
      const entry = await ensureLoaded(slug, item);
      entry.draft.listing.full = Boolean(full);
      syncPendingFor(slug);
      if (spanHandle) syncSpanHandleSide(item, spanHandle);
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not update span.');
    }
  };

  const enterSpanMode = (item, chip) => {
    if (cropPanelOpen()) return;
    exitSpanMode();
    spanModeItem = item;
    spanModeChip = chip;
    item.classList.add('is-span-mode');
    chip.setAttribute('aria-pressed', 'true');

    const frame = document.createElement('div');
    frame.className = 'project-grid__span-frame';
    frame.setAttribute('aria-hidden', 'true');
    const handle = document.createElement('button');
    handle.type = 'button';
    handle.className = 'project-grid__span-handle';
    handle.setAttribute('aria-label', 'Drag to change column span');
    syncSpanHandleSide(item, handle);
    item.append(frame, handle);
    spanFrame = frame;
    spanHandle = handle;

    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      if (cropPanelOpen()) return;
      event.preventDefault();
      event.stopPropagation();
      const grid = item.closest('[data-dev-project-grid]');
      if (!(grid instanceof HTMLElement)) return;
      const styles = getComputedStyle(grid);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
      const oneCol = (grid.clientWidth - gap) / 2;
      const twoCol = grid.clientWidth;
      const mid = (oneCol + twoCol) / 2;
      const side = handle.dataset.side === 'start' ? 'start' : 'end';
      spanDrag = {
        pointerId: event.pointerId,
        startX: event.clientX,
        startWidth: item.getBoundingClientRect().width,
        side,
        mid,
      };
      try {
        handle.setPointerCapture(event.pointerId);
      } catch {
        // Pointer capture can throw after a fast release.
      }
    });
  };

  const toggleSpanMode = async (item, chip) => {
    if (spanModeItem === item) {
      exitSpanMode();
      return;
    }
    enterSpanMode(item, chip);
  };

  document.addEventListener('pointermove', (event) => {
    if (!spanDrag || !spanModeItem) return;
    if (event.pointerId !== spanDrag.pointerId) return;
    const delta = event.clientX - spanDrag.startX;
    const signed = spanDrag.side === 'end' ? delta : -delta;
    const preview = spanDrag.startWidth + signed;
    const nextFull = preview >= spanDrag.mid;
    const current = spanModeItem.classList.contains('project-grid__item--full');
    if (nextFull !== current) {
      spanModeItem.classList.toggle('project-grid__item--full', nextFull);
      if (spanHandle) syncSpanHandleSide(spanModeItem, spanHandle);
    }
  });

  document.addEventListener('pointerup', (event) => {
    if (!spanDrag || !spanModeItem) return;
    if (event.pointerId !== spanDrag.pointerId) return;
    const full = spanModeItem.classList.contains('project-grid__item--full');
    spanDrag = null;
    void setSpanFull(spanModeItem, full);
  });

  document.addEventListener('pointercancel', (event) => {
    if (!spanDrag || event.pointerId !== spanDrag.pointerId) return;
    spanDrag = null;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!spanModeItem) return;
    event.preventDefault();
    event.stopPropagation();
    exitSpanMode();
  }, true);

  window.addEventListener('vcd:dev-edit-open', ((event) => {
    const panel = event.detail?.panel;
    if (!(panel instanceof HTMLElement)) return;
    if (panel.dataset.devPanelKey === 'image') {
      // Exit span first so frame/handles are gone before crop chrome takes over.
      if (spanModeItem) exitSpanMode();
      document.documentElement.classList.add('is-dev-crop-open');
    }
  }));

  window.addEventListener('vcd:dev-edit-close', ((event) => {
    const panel = event.detail?.panel;
    if (panel?.dataset?.devPanelKey === 'image') {
      document.documentElement.classList.remove('is-dev-crop-open');
    }
  }));

  const uploadCoverImage = async (slug, file) => {
    const data = await readFileAsBase64(file);
    const response = await fetch('/api/upload', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        document: slug,
        files: [{ filename: file.name, data, mimeType: file.type }],
      }),
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || 'Could not upload the cover image.');
    const filename = payload.filenames?.[0];
    if (!filename) throw new Error('Could not upload the cover image.');
    window.dispatchEvent(new CustomEvent('vcd:dev-content-written'));
    // Media is a flat site-wide library (#201/#211) — no per-project segment.
    return `/images/${encodeURIComponent(filename)}`;
  };

  const applyCoverFileToCard = async (slug, file, blobUrl, slot = 'image') => {
    if (!(file instanceof File) || !file.type.startsWith('image/')) return;
    const item = gridItemForSlug(slug);
    if (!(item instanceof HTMLElement)) return;
    try {
      const entry = await ensureLoaded(slug, item);
      const url = await uploadCoverImage(slug, file);
      if (slot === 'hoverImage') {
        entry.draft.listing.hoverImage = url;
        // Re-measure on every drop (replace included) — never keep a stale
        // flag from a previous hover image. Falls back to the base `dark`
        // value if measurement throws or the helper isn't ready.
        let hoverDark = entry.draft.listing.dark;
        try {
          const measured = typeof window.__vcdMeasureHoverDark === 'function'
            ? await window.__vcdMeasureHoverDark(file, item)
            : null;
          if (typeof measured === 'boolean') hoverDark = measured;
          // The fallback is indistinguishable from a real measurement that
          // happens to agree with `dark`, which is exactly how a broken
          // measurement path stayed invisible once already. Say so out loud.
          else console.warn('[vcd #182] Hover legibility not measured — fell back to the card\'s `dark` value. Check that the coverLuminance module loaded.');
        } catch (error) {
          console.warn('[vcd #182] Hover legibility measurement failed — using the card\'s `dark` value.', error);
        }
        entry.draft.listing.hoverDark = hoverDark;
      } else {
        entry.draft.listing.image = url;
      }
      // DOM keeps showing the blob until Save; draft URL is save-payload only.
      if (typeof blobUrl === 'string' && blobUrl) {
        const blobs = slot === 'hoverImage' ? liveHoverBlobs : liveCoverBlobs;
        const previous = blobs.get(slug);
        if (previous && previous !== blobUrl) URL.revokeObjectURL(previous);
        blobs.set(slug, blobUrl);
      }
      syncPendingFor(slug);
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not upload the cover image.');
      throw error;
    }
  };

  /**
   * On Save: put draft URL on the base under a still-visible blob overlay, then
   * lift the overlay only once the draft image has painted.
   */
  const promoteLiveCoverOnSave = async (slug, entry) => {
    const blobUrl = liveCoverBlobs.get(slug);
    if (!blobUrl) return;

    const draftUrl = entry.draft?.listing?.image;
    const cover = entry.item?.querySelector('.project-grid__cover');
    const baseImg = entry.item?.querySelector('.project-grid__img--base');
    if (!(cover instanceof HTMLElement) || !(baseImg instanceof HTMLImageElement) || !draftUrl) {
      revokeLiveCover(slug);
      return;
    }

    const overlay = document.createElement('img');
    overlay.className = 'project-grid__crossfade is-in';
    overlay.alt = '';
    overlay.draggable = false;
    overlay.src = blobUrl;
    cover.dataset.devCrossfadeActive = 'true';
    cover.append(overlay);
    await waitImageReady(overlay);

    liveCoverBlobs.delete(slug);
    baseImg.src = draftUrl;
    await waitImageReady(baseImg);

    overlay.remove();
    delete cover.dataset.devCrossfadeActive;
    URL.revokeObjectURL(blobUrl);
  };

  /**
   * Hover image isn't visible at rest, so unlike the base cover it needs
   * none of the overlay-under-blob choreography — just swap the src once the
   * draft URL is ready and revoke the blob.
   */
  const promoteLiveHoverOnSave = async (slug, entry) => {
    const blobUrl = liveHoverBlobs.get(slug);
    if (!blobUrl) return;

    const draftUrl = entry.draft?.listing?.hoverImage;
    const hoverImg = entry.item?.querySelector('.project-grid__img--hover');
    if (!(hoverImg instanceof HTMLImageElement) || !draftUrl) {
      revokeLiveHover(slug);
      return;
    }

    hoverImg.src = draftUrl;
    await waitImageReady(hoverImg);
    revokeLiveHover(slug);
  };

  /**
   * "Replace cover image" is only right for one of four cases. Name the slot
   * you are actually dropping into, and say Drop rather than Replace when
   * there is nothing there yet — a brand new card has no cover to replace.
   */
  const syncDropLabel = (cover) => {
    const label = cover.querySelector('[data-dev-drop-label]');
    if (!(label instanceof HTMLElement)) return;
    const hoverImg = cover.querySelector('.project-grid__img--hover');
    if (cover.classList.contains('is-dev-hover-forced')) {
      const empty = !(hoverImg instanceof HTMLImageElement) || hoverImg.hidden;
      label.textContent = empty ? 'Drop hover image' : 'Replace hover image';
      return;
    }
    label.textContent = cover.dataset.devCoverEmpty === 'true'
      ? 'Drop cover image'
      : 'Replace cover image';
  };

  const clearAllCoverDropActive = () => {
    document.querySelectorAll('[data-dev-cover-drop][data-dev-drop-active]').forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      // Don't clear hover chrome mid-crossfade.
      if (node.dataset.devCrossfadeActive) return;
      delete node.dataset.devDropActive;
    });
  };

  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const waitImageReady = async (img) => {
    if (!(img instanceof HTMLImageElement)) return;
    if (img.decode) {
      try {
        await img.decode();
        return;
      } catch {
        // Fall through to load event.
      }
    }
    if (img.complete && img.naturalWidth > 0) return;
    await new Promise((resolve) => {
      const done = () => resolve();
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    });
  };

  const waitTransition = (el, propertyName, fallbackMs = 700) => new Promise((resolve) => {
    if (prefersReducedMotion() || !(el instanceof HTMLElement)) {
      resolve();
      return;
    }
    let settled = false;
    const finish = () => {
      if (settled) return;
      settled = true;
      el.removeEventListener('transitionend', done);
      resolve();
    };
    const done = (event) => {
      if (event.target !== el) return;
      if (propertyName && event.propertyName !== propertyName) return;
      finish();
    };
    el.addEventListener('transitionend', done);
    window.setTimeout(finish, fallbackMs);
  });

  const delay = (ms) => new Promise((resolve) => {
    window.setTimeout(resolve, prefersReducedMotion() ? 0 : ms);
  });

  /**
   * Old cover fades out → short gap → new cover fades in (blob overlay).
   * Returns `{ finish, blobUrl }`. Call `finish()` to park the blob on the base
   * (or, for the hover slot, the hover image) under the overlay, then remove
   * the overlay — keep the blob until Save.
   */
  const playCoverCrossfade = (cover, file, slot = 'image') => new Promise((resolve, reject) => {
    const blobUrl = URL.createObjectURL(file);
    const overlay = document.createElement('img');
    overlay.className = 'project-grid__crossfade';
    overlay.alt = '';
    overlay.draggable = false;
    const stack = cover.querySelector('.project-grid__stack');

    const abort = async () => {
      overlay.remove();
      delete cover.dataset.devFadeOut;
      delete cover.dataset.devCrossfadeActive;
      delete cover.dataset.devDropActive;
      if (stack instanceof HTMLElement) {
        stack.style.transition = '';
        stack.style.opacity = '';
      }
      URL.revokeObjectURL(blobUrl);
    };

    const finish = async () => {
      const targetImg = cover.querySelector(
        slot === 'hoverImage' ? '.project-grid__img--hover' : '.project-grid__img--base',
      );
      if (targetImg instanceof HTMLImageElement) {
        // Hover img starts hidden when the slot is empty — unhide before
        // assigning src, or the crossfade lands on a display:none element.
        if (slot === 'hoverImage') targetImg.hidden = false;
        targetImg.src = blobUrl;
        await waitImageReady(targetImg);
      }
      if (stack instanceof HTMLElement) {
        stack.style.transition = 'none';
        stack.style.opacity = '1';
      }
      delete cover.dataset.devFadeOut;
      await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
      overlay.remove();
      delete cover.dataset.devCrossfadeActive;
      delete cover.dataset.devDropActive;
      if (stack instanceof HTMLElement) {
        stack.style.transition = '';
        stack.style.opacity = '';
      }
    };

    const run = async () => {
      try {
        delete cover.dataset.devDropActive;
        cover.dataset.devCrossfadeActive = 'true';
        cover.append(overlay);
        overlay.src = blobUrl;
        await waitImageReady(overlay);
        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

        cover.dataset.devFadeOut = 'true';
        await waitTransition(stack, 'opacity', 700);

        await delay(140);

        overlay.classList.add('is-in');
        await waitTransition(overlay, 'opacity', 700);

        resolve({ finish, blobUrl });
      } catch (error) {
        await abort();
        reject(error);
      }
    };

    void run();
  });

  const coverFromPoint = (clientX, clientY, fallbackTarget) => {
    const fromEvent = fallbackTarget instanceof Element
      ? fallbackTarget.closest('[data-dev-cover-drop]')
      : null;
    if (fromEvent instanceof HTMLElement) return fromEvent;
    const hit = document.elementFromPoint(clientX, clientY);
    if (!(hit instanceof Element)) return null;
    const cover = hit.closest('[data-dev-cover-drop]');
    return cover instanceof HTMLElement ? cover : null;
  };

  const closeAllStatusMenus = () => {
    document.querySelectorAll('[data-dev-status-menu]').forEach((menu) => {
      if (menu instanceof HTMLElement) menu.hidden = true;
    });
    document.querySelectorAll('[data-dev-project-status]').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
  };

  const setCardStatus = async (slug, status) => {
    const item = gridItemForSlug(slug);
    if (!(item instanceof HTMLElement)) return;
    try {
      const entry = await ensureLoaded(slug, item);
      entry.draft.status = status;
      closeAllStatusMenus();
      syncPendingFor(slug);
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Could not update visibility.');
    }
  };

  // Chips sit on the <li> (outside the card <a>). preventDefault only — do not
  // stopPropagation here or DevModeController never sees [data-dev-edit-trigger]
  // (crop). Status / hover / span handlers below stop bubble themselves.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('.project-grid__chips, [data-dev-status-menu]')) {
      event.preventDefault();
      return;
    }
    // Belt-and-suspenders: title/year clicks must not bubble to the card's
    // leftover transition listener (Layout bound it while href was still set).
    const editable = target.closest(
      '[data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label]',
    );
    if (editable instanceof HTMLElement && editable.isContentEditable) {
      event.preventDefault();
      event.stopPropagation();
    }
  }, true);

  document.addEventListener('mousedown', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    // Don't steal focus from contenteditable — only stop chip mousedown bubbling to drag/link logic.
    if (target.closest('.project-grid__chips, [data-dev-status-menu]')) {
      event.stopPropagation();
    }
  }, true);

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const statusBtn = target.closest('[data-dev-project-status]');
    if (statusBtn instanceof HTMLElement) {
      event.preventDefault();
      event.stopPropagation();
      const wrap = statusBtn.closest('.project-grid__status-wrap');
      const menu = wrap?.querySelector('[data-dev-status-menu]');
      const open = menu instanceof HTMLElement && menu.hidden;
      closeAllStatusMenus();
      if (open && menu instanceof HTMLElement) {
        menu.hidden = false;
        statusBtn.setAttribute('aria-expanded', 'true');
      }
      return;
    }

    const statusOption = target.closest('[data-dev-status-option]');
    if (statusOption instanceof HTMLElement) {
      event.preventDefault();
      event.stopPropagation();
      const item = statusOption.closest('[data-dev-project-slug]');
      const slug = item?.getAttribute('data-dev-project-slug');
      const status = statusOption.dataset.devStatusOption;
      if (slug && status) void setCardStatus(slug, status);
      return;
    }

    const hoverBtn = target.closest('[data-dev-project-hover]');
    if (hoverBtn instanceof HTMLElement) {
      event.preventDefault();
      event.stopPropagation();
      const item = hoverBtn.closest('[data-dev-project-slug]');
      const cover = item?.querySelector('.project-grid__cover');
      if (!(cover instanceof HTMLElement)) return;
      const next = !cover.classList.contains('is-dev-hover-forced');
      cover.classList.toggle('is-dev-hover-forced', next);
      hoverBtn.setAttribute('aria-pressed', next ? 'true' : 'false');
      setHoverChipLabel(hoverBtn, next);
      return;
    }

    // Was buried in the crop tuner's "Card settings" button; now its own chip.
    // Same toggle as crop: click again while open for this card closes the panel.
    const settingsButton = target.closest('[data-dev-project-settings]');
    if (settingsButton instanceof HTMLElement) {
      event.preventDefault();
      event.stopPropagation();
      const item = settingsButton.closest('[data-dev-project-slug]');
      const slug = item?.getAttribute('data-dev-project-slug');
      if (!slug) return;
      const panelOpen = settingsPanel instanceof HTMLElement && !settingsPanel.hidden;
      if (panelOpen && panelSlug === slug) {
        closeSettingsPanel();
        return;
      }
      void openSettings(slug);
      return;
    }

    const spanButton = target.closest('[data-dev-project-span]');
    if (spanButton instanceof HTMLElement) {
      event.preventDefault();
      event.stopPropagation();
      const item = spanButton.closest('[data-dev-project-slug]');
      if (!(item instanceof HTMLElement)) return;
      void toggleSpanMode(item, spanButton);
      return;
    }

    const newButton = target.closest('[data-dev-project-new]');
    if (newButton) {
      event.preventDefault();
      event.stopPropagation();
      const gridRoot = newButton.closest('[data-dev-project-grid]');
      createActiveGrid = gridRoot?.getAttribute('data-dev-project-grid') ?? 'work';
      openCreateDialog();
      return;
    }

    if (!target.closest('[data-dev-status-menu], [data-dev-project-status]')) {
      closeAllStatusMenus();
    }

    const teaserCard = target.closest('[data-dev-teaser-slug]');
    if (teaserCard instanceof HTMLElement && event.altKey) {
      event.preventDefault();
      const href = teaserCard.dataset.devTeaserHref;
      const password = window.prompt('Enter teaser password');
      if (!password) return;
      if (password !== teaserPassword) {
        window.alert('Incorrect password.');
        return;
      }
      if (href) navigateAway(href);
    }
  }, true);

  document.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.matches('[data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label]')) return;
    normalizeEmptyEditable(target);
    const item = target.closest('[data-dev-project-slug]');
    const slug = item?.getAttribute('data-dev-project-slug');
    if (!(item instanceof HTMLElement) || !slug) return;
    void (async () => {
      try {
        await ensureLoaded(slug, item);
        syncPendingFor(slug);
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Could not stage that edit.');
      }
    })();
  });

  document.addEventListener('focusout', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.matches('[data-dev-project-title], [data-dev-project-subtitle], [data-dev-project-teaser-label]')) return;
    normalizeEmptyEditable(target);
  });

  // Drop image onto cover → replace listing cover (hover wash + crossfade).
  document.addEventListener('dragover', (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;

    const cover = coverFromPoint(event.clientX, event.clientY, event.target);
    document.querySelectorAll('[data-dev-cover-drop][data-dev-drop-active]').forEach((node) => {
      if (node !== cover && node instanceof HTMLElement) delete node.dataset.devDropActive;
    });
    if (!cover) return;

    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
    syncDropLabel(cover);
    cover.dataset.devDropActive = 'true';
  });

  document.addEventListener('dragleave', (event) => {
    // Only clear when the pointer leaves the window / document — per-cover
    // clear is driven by dragover (above) so child enter/leave doesn't flicker.
    if (event.relatedTarget == null || event.relatedTarget === document.documentElement) {
      clearAllCoverDropActive();
    }
  });

  document.addEventListener('drop', (event) => {
    if (!document.documentElement.classList.contains('is-dev-mode')) return;
    const cover = coverFromPoint(event.clientX, event.clientY, event.target);
    if (!cover) {
      clearAllCoverDropActive();
      return;
    }
    event.preventDefault();
    event.stopPropagation();
    document.querySelectorAll('[data-dev-cover-drop][data-dev-drop-active]').forEach((node) => {
      if (node !== cover && node instanceof HTMLElement) delete node.dataset.devDropActive;
    });
    const slug = cover.dataset.devCoverDrop;
    const file = event.dataTransfer?.files?.[0];
    if (!slug || !(file instanceof File) || !file.type.startsWith('image/')) {
      delete cover.dataset.devDropActive;
      return;
    }
    // Slot derived once, at drop time, from whichever image is currently forced
    // to show — #175. Doesn't change which cover the drop targets (#176).
    const slot = cover.classList.contains('is-dev-hover-forced') ? 'hoverImage' : 'image';
    // Drop the empty state before the crossfade, not after — otherwise its
    // 55% page-white wash sits over the incoming image for the whole fade.
    // applyListingPreview re-derives it from the draft once the upload lands.
    if (slot === 'image') delete cover.dataset.devCoverEmpty;

    void (async () => {
      try {
        const { finish, blobUrl } = await playCoverCrossfade(cover, file, slot);
        await finish();
        await applyCoverFileToCard(slug, file, blobUrl, slot);
      } catch (error) {
        if (error instanceof Error && !/upload/i.test(error.message)) {
          window.alert(error.message);
        }
      }
    })();
  });

  document.addEventListener('dragend', () => {
    clearAllCoverDropActive();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    clearAllCoverDropActive();
  });

  settingsRoot?.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (!target.matches('[data-ps-bg]')) return;
    if (!panelSlug) return;
    const entry = caches.get(panelSlug);
    if (!entry) return;
    entry.draft.listing.bg = bgInput instanceof HTMLInputElement ? bgInput.value.trim() : '#efefef';
    syncPendingFor(panelSlug);
  });

  settingsRoot?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    if (target.matches('[data-ps-dark]')) {
      if (!panelSlug) return;
      const entry = caches.get(panelSlug);
      if (!entry) return;
      entry.draft.listing.dark = darkInput instanceof HTMLInputElement && darkInput.checked;
      syncPendingFor(panelSlug);
      return;
    }
    if (target.matches('[data-ps-hover-dark]')) {
      // Manual override wins from here on — the measurement was a starting
      // point, not an authority.
      if (!panelSlug) return;
      const entry = caches.get(panelSlug);
      if (!entry) return;
      entry.draft.listing.hoverDark = hoverDarkInput instanceof HTMLInputElement
        ? hoverDarkInput.checked
        : entry.draft.listing.dark;
      syncPendingFor(panelSlug);
    }
  });

  const openCreateDialog = () => {
    if (!(createDialog instanceof HTMLDialogElement) || !(createForm instanceof HTMLFormElement)) return;
    createForm.reset();
    createDialog.showModal();
    const titleInput = createForm.querySelector('input[name="title"]');
    const slugInput = createForm.querySelector('input[name="slug"]');
    if (titleInput instanceof HTMLInputElement) {
      titleInput.focus();
      titleInput.addEventListener('input', () => {
        if (slugInput instanceof HTMLInputElement && !slugInput.dataset.touched) {
          slugInput.value = slugify(titleInput.value);
        }
      }, { once: true });
    }
    if (slugInput instanceof HTMLInputElement) {
      slugInput.addEventListener('input', () => {
        slugInput.dataset.touched = 'true';
      }, { once: true });
    }
  };

  createForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(createForm instanceof HTMLFormElement)) return;
    const formData = new FormData(createForm);
    const title = String(formData.get('title') || '').trim();
    const slug = String(formData.get('slug') || '').trim();
    const response = await fetch('/api/project-create', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title, slug, grid: createActiveGrid }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not create the project.');
      return;
    }
    navigateAway(`/${slug}`);
  });

  createForm?.querySelector('button[value="cancel"]')?.addEventListener('click', () => {
    if (createDialog instanceof HTMLDialogElement) createDialog.close();
  });

  deleteButton?.addEventListener('click', async () => {
    if (!panelSlug) return;
    if (!window.confirm(`Delete "${panelSlug}" and its draft media? This cannot be undone.`)) return;
    const response = await fetch('/api/project-delete', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug: panelSlug }),
    });
    const payload = await response.json();
    if (!response.ok) {
      window.alert(payload.error || 'Could not delete the project.');
      return;
    }
    navigateAway('/work');
  });

  window.addEventListener('vcd:dev-edit-close', (event) => {
    const panel = event.detail?.panel;
    if (panel?.dataset?.devPanelKey !== 'project-settings') return;
    panelSlug = '';
  });

  window.addEventListener('vcd:dev-pending-reverted', () => {
    liveCoverBlobs.forEach((url) => URL.revokeObjectURL(url));
    liveCoverBlobs.clear();
    liveHoverBlobs.forEach((url) => URL.revokeObjectURL(url));
    liveHoverBlobs.clear();
    caches.forEach((entry, slug) => {
      entry.draft = structuredClone(entry.saved);
      applyListingPreview(entry.item, entry.draft, entry.grid);
      if (panelSlug === slug) renderPanelFromEntry(entry);
    });
  });

  window.addEventListener('vcd:dev-pending-committed', () => {
    void (async () => {
      for (const [slug, entry] of caches) {
        await promoteLiveCoverOnSave(slug, entry);
        await promoteLiveHoverOnSave(slug, entry);
        entry.saved = structuredClone(entry.draft);
      }
    })();
  });

  window.addEventListener('vcd:dev-mode-change', (event) => {
    if (event.detail?.active) {
      enableAllCardEditing();
      return;
    }
    exitSpanMode();
    disableAllCardEditing();
    closeSettingsPanel();
  });

  if (document.documentElement.classList.contains('is-dev-mode')) {
    enableAllCardEditing();
  }
</script>

