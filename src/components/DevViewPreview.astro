---
/**
 * Dev-only employer-view badge. The active view is rendered server-side (via
 * VIEW_ID), so nav/grids/sections are already tailored — this just labels it.
 */
import { getActiveViewId, loadViewConfig } from '../lib/views';

const viewId = getActiveViewId() || '';
const viewTitle = viewId ? loadViewConfig(viewId)?.title || viewId : '';
---

{viewId && (
  <p class="dev-view-preview-badge">{viewTitle} preview</p>
)}

<style>
  .dev-view-preview-badge {
    position: fixed;
    left: max(1em, env(safe-area-inset-left));
    bottom: max(1em, env(safe-area-inset-bottom));
    z-index: 88;
    margin: 0;
    padding: 0.4em 0.7em;
    border-radius: var(--radius-control-smooth);
    background: color-mix(in srgb, var(--color-surface-soft) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 0.35em 1.1em rgb(0 0 0 / 0.1);
    color: var(--color-text-soft);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    pointer-events: none;
    user-select: none;
  }

  .dev-view-preview-badge[hidden] {
    display: none;
  }
</style>
