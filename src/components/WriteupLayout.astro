---
import Layout from '../layouts/Layout.astro';
import { WRITEUP_CARD_WIDTH, WRITEUP_CARD_HEIGHT } from '../lib/writeupShareCard';
import Footer from './Footer.astro';
import DocumentationContents from './DocumentationContents.astro';
import ProjectImageGridTuner from './project/ProjectImageGridTuner.astro';
import ProjectImageCarouselTuner from './project/ProjectImageCarouselTuner.astro';
import ProjectImageCaptionTuner from './project/ProjectImageCaptionTuner.astro';
import WriteupBacklink from './WriteupBacklink.astro';
import { getProjectGridListings } from '../lib/projects';
import '../styles/project.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Where the Index control returns to. */
  indexHref?: string;
  backlinkLabel?: string;
  /** Section anchors for an On this page rail beside the column. */
  contents?: Array<{ id: string; label: string }>;
}

const { title, description, ogImage, indexHref = '/digital', backlinkLabel = 'Index', contents = [] } = Astro.props;
const showDevTools = import.meta.env.DEV;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isTapicoResearch = pathname === '/tapico-research-paper';
// Next follows the Digital grid's published projects in order and wraps; other pages get only Index.
const digital = getProjectGridListings('play').filter((item) => item.status === 'published' && item.href?.startsWith('/'));
const digitalIndex = digital.findIndex((item) => item.href === pathname);
const next = digitalIndex >= 0 && digital.length > 1 ? digital[(digitalIndex + 1) % digital.length] : undefined;
const backHref = isTapicoResearch ? '/' : indexHref;
---

<Layout
  title={`${title} — Vicente Cruz`}
  socialTitle={title}
  socialDescription="by Vicente Cruz"
  description={description || "by Vicente Cruz"}
  ogImage={ogImage}
  ogType="article"
  ogImageDetails={ogImage ? { alt: `${title} — Vicente Cruz`, width: WRITEUP_CARD_WIDTH, height: WRITEUP_CARD_HEIGHT } : undefined}
>
  <div data-page-shell data-writeup-page class="writeup-page flex flex-col min-h-dvh">
    <header class="writeup-masthead">
      <WriteupBacklink href={backHref} label={backlinkLabel} data-writeup-index />
      <h1 class="sr-only">{title}</h1>
    </header>
    {isTapicoResearch && <script is:inline>
      if (document.referrer) {
        const source = new URL(document.referrer);
        if (source.origin === location.origin && source.pathname.replace(/\/$/, '') === '/tapico') {
          document.querySelectorAll('[data-writeup-index]').forEach((link) => {
            link.href = '/tapico';
            link.querySelector('.writeup-backlink__label').textContent = 'Back';
          });
        }
      }
    </script>}

    <main id="main-content" class="project-page__main flex-1">
      <slot />
    </main>
    <nav class="writeup-pager" data-writeup-pager aria-label="Write-ups">
      <div class="writeup-pager__inner">
        <div class="writeup-pager__row">
          <WriteupBacklink href={backHref} label={backlinkLabel} data-writeup-index />
          {next && (
            <WriteupBacklink href={next.href} label={next.title} direction="next" rel="next" />
          )}
        </div>
      </div>
    </nav>
    {contents.length > 0 && <aside class="writeup-contents"><DocumentationContents contents={contents} /></aside>}

    <Footer />
  </div>
  {showDevTools && <ProjectImageGridTuner />}
  {showDevTools && <ProjectImageCarouselTuner />}
  {showDevTools && <ProjectImageCaptionTuner />}
</Layout>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  // The bottom pager appears only once the top Index has scrolled out of view.
  onPageLoad(() => {
    const top = document.querySelector('.writeup-masthead .writeup-backlink');
    const pager = document.querySelector<HTMLElement>('[data-writeup-pager]');
    if (!top || !pager) return;
    const observer = new IntersectionObserver(([entry]) => {
      pager.toggleAttribute('data-revealed', !entry.isIntersecting);
    });
    observer.observe(top);
    return () => observer.disconnect();
  });
</script>

<style>
  /* One column: media caps at the text width, and the gutter follows it. */
  :global(#site-wrapper:has(> [data-writeup-page])) {
    --page-media-max-width: var(--page-text-max-width);
    --page-max-width: var(--page-text-max-width);
    --text-body-measure: 100%;
  }

  .writeup-masthead {
    padding-top: var(--page-top-offset);
    margin-bottom: var(--page-masthead-gap);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    letter-spacing: var(--text-body-tracking);
  }

  /* The docs' On this page rail, in the gutter beside the single column. It needs the column,
     a 3rem gap, its own 12rem and a margin: 37.5em + 2 × (3rem + 12rem + 1rem) = 69.5em. */
  .writeup-contents {
    --documentation-navigation-muted: var(--ref-palette-grey-450);
    --documentation-divider: var(--comp-documentation-divider);
    display: none;
  }

  @media (min-width: 70em) {
    .writeup-contents {
      display: block;
      position: fixed;
      top: var(--page-top-offset);
      left: calc(50% + var(--page-text-max-width) / 2 + 3rem);
      width: 12rem;
      max-height: calc(var(--vh-safe, 1svh) * 100 - var(--page-top-offset) - 2rem);
      overflow-y: auto;
    }
  }

  .writeup-pager {
    --writeup-pager-motion: 350ms cubic-bezier(0.23, 1, 0.32, 1);
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--writeup-pager-motion);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    letter-spacing: var(--text-body-tracking);
  }

  /* All of the pager's room lives inside the collapsing row; the inline padding keeps the
     links' hit areas and focus rings clear of the clip. */
  .writeup-pager__inner {
    min-height: 0;
    overflow: hidden;
    margin-inline: -12px;
    transition: opacity var(--writeup-pager-motion), visibility var(--writeup-pager-motion);
  }

  .writeup-pager__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-group);
    padding: var(--space-group) 12px;
  }

  /* Without scripting nothing would reveal it, so it stays shown. */
  @media (scripting: enabled) {
    .writeup-pager:not([data-revealed]) {
      grid-template-rows: 0fr;
    }

    .writeup-pager:not([data-revealed]) .writeup-pager__inner {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writeup-pager {
      transition: none;
    }
  }
</style>
