---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import ProjectImageGridTuner from './project/ProjectImageGridTuner.astro';
import ProjectImageCarouselTuner from './project/ProjectImageCarouselTuner.astro';
import ProjectImageCaptionTuner from './project/ProjectImageCaptionTuner.astro';
import cornerUpLeftIcon from 'lucide-static/icons/corner-up-left.svg?raw';
import '../styles/project.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const showDevTools = import.meta.env.DEV;
---

<Layout title={`${title} — Vicente Cruz`} description={description} ogImage={ogImage}>
  <div data-page-shell data-writeup-page class="writeup-page flex flex-col min-h-dvh">
    <header class="writeup-masthead">
      <a href="/digital" class="writeup-backlink">
        <span class="writeup-backlink__icon" aria-hidden="true" set:html={cornerUpLeftIcon} />
        <span class="writeup-backlink__label">Index</span>
      </a>
      <h1 class="sr-only">{title}</h1>
    </header>

    <main id="main-content" class="project-page__main flex-1">
      <slot />
    </main>

    <Footer />
  </div>
  {showDevTools && <ProjectImageGridTuner />}
  {showDevTools && <ProjectImageCarouselTuner />}
  {showDevTools && <ProjectImageCaptionTuner />}
</Layout>

<style>
  /* One column: media caps at the text width, and the gutter follows it. */
  :global(#site-wrapper:has(> [data-writeup-page])) {
    --page-media-max-width: var(--page-text-max-width);
    --page-max-width: var(--page-text-max-width);
    --text-body-measure: 100%;
  }

  .writeup-masthead {
    padding-top: var(--page-top-offset);
    margin-bottom: var(--page-masthead-gap);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    letter-spacing: var(--text-body-tracking);
  }

  .writeup-backlink {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-unit) * 0.5);
    color: var(--sys-color-on-srf-variant);
    text-decoration: none;
  }

  .writeup-backlink::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .writeup-backlink__icon {
    display: inline-flex;
    color: var(--sys-color-on-srf-subtle);
  }

  :global(.writeup-backlink__icon svg) {
    width: 1em;
    height: 1em;
  }

  .writeup-backlink:hover > .writeup-backlink__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .writeup-backlink:focus-visible {
    outline: 2px solid var(--sys-color-outline);
    outline-offset: 4px;
  }

</style>
