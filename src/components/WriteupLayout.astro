---
import Layout from '../layouts/Layout.astro';
import { WRITEUP_CARD_WIDTH, WRITEUP_CARD_HEIGHT } from '../lib/writeupShareCard';
import Footer from './Footer.astro';
import DocumentationContents from './DocumentationContents.astro';
import ProjectImageGridTuner from './project/ProjectImageGridTuner.astro';
import ProjectImageCarouselTuner from './project/ProjectImageCarouselTuner.astro';
import ProjectImageCaptionTuner from './project/ProjectImageCaptionTuner.astro';
import cornerUpLeftIcon from 'lucide-static/icons/corner-up-left.svg?raw';
import '../styles/project.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Where the Index control returns to. */
  indexHref?: string;
  /** Section anchors for an On this page rail beside the column. */
  contents?: Array<{ id: string; label: string }>;
}

const { title, description, ogImage, indexHref = '/digital', contents = [] } = Astro.props;
const showDevTools = import.meta.env.DEV;
const isTapicoResearch = Astro.url.pathname.replace(/\/$/, '') === '/tapico-research-paper';
---

<Layout
  title={`${title} — Vicente Cruz`}
  socialTitle={title}
  socialDescription="by Vicente Cruz"
  description={description || "by Vicente Cruz"}
  ogImage={ogImage}
  ogType="article"
  ogImageDetails={ogImage ? { alt: `${title} — Vicente Cruz`, width: WRITEUP_CARD_WIDTH, height: WRITEUP_CARD_HEIGHT } : undefined}
>
  <div data-page-shell data-writeup-page class="writeup-page flex flex-col min-h-dvh">
    <header class="writeup-masthead">
      <a href={isTapicoResearch ? '/' : indexHref} class="writeup-backlink">
        <span class="writeup-backlink__icon" aria-hidden="true" set:html={cornerUpLeftIcon} />
        <span class="writeup-backlink__label">Index</span>
      </a>
      <h1 class="sr-only">{title}</h1>
    </header>
    {isTapicoResearch && <script is:inline>
      if (document.referrer) {
        const source = new URL(document.referrer);
        if (source.origin === location.origin && source.pathname.replace(/\/$/, '') === '/tapico') {
          const link = document.querySelector('.writeup-backlink');
          link.href = '/tapico';
          link.querySelector('.writeup-backlink__label').textContent = 'Back';
        }
      }
    </script>}

    <main id="main-content" class="project-page__main flex-1">
      <slot />
    </main>
    {contents.length > 0 && <aside class="writeup-contents"><DocumentationContents contents={contents} /></aside>}

    <Footer />
  </div>
  {showDevTools && <ProjectImageGridTuner />}
  {showDevTools && <ProjectImageCarouselTuner />}
  {showDevTools && <ProjectImageCaptionTuner />}
</Layout>

<style>
  /* One column: media caps at the text width, and the gutter follows it. */
  :global(#site-wrapper:has(> [data-writeup-page])) {
    --page-media-max-width: var(--page-text-max-width);
    --page-max-width: var(--page-text-max-width);
    --text-body-measure: 100%;
  }

  .writeup-masthead {
    padding-top: var(--page-top-offset);
    margin-bottom: var(--page-masthead-gap);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    letter-spacing: var(--text-body-tracking);
  }

  /* The docs' On this page rail, in the gutter beside the single column. It needs the column,
     a 3rem gap, its own 12rem and a margin: 37.5em + 2 × (3rem + 12rem + 1rem) = 69.5em. */
  .writeup-contents {
    --documentation-navigation-muted: var(--ref-palette-grey-450);
    --documentation-divider: var(--comp-documentation-divider);
    display: none;
  }

  @media (min-width: 70em) {
    .writeup-contents {
      display: block;
      position: fixed;
      top: var(--page-top-offset);
      left: calc(50% + var(--page-text-max-width) / 2 + 3rem);
      width: 12rem;
      max-height: calc(var(--vh-safe, 1svh) * 100 - var(--page-top-offset) - 2rem);
      overflow-y: auto;
    }
  }

  .writeup-backlink {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-unit) * 0.5);
    color: var(--sys-color-on-srf-subtle);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .writeup-backlink::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .writeup-backlink__icon {
    display: inline-flex;
  }

  :global(.writeup-backlink__icon svg) {
    width: 1em;
    height: 1em;
  }

  @media (hover: hover) and (pointer: fine) {
    .writeup-backlink:hover {
      color: var(--sys-color-on-srf);
    }
  }

  .writeup-backlink:focus-visible {
    color: var(--sys-color-on-srf);
    outline: 2px solid var(--sys-color-outline);
    outline-offset: 4px;
  }

</style>
