---
/**
 * Throwaway T11 A/B: body letter-spacing −0.05em / −0.01em / 0.
 * Not a DevOverlay — those are Edit-gated (exit Edit hides every
 * [data-dev-panel-key]). Delete once Anto picks. DEV-only via Layout.
 */
import SegmentedControl from './ui/SegmentedControl.astro';
import Button from './ui/Button.astro';
---

<div class="dev-body-tracking" data-dev-body-tracking>
  <p class="dev-body-tracking__title">Tracking</p>
  <SegmentedControl label="Tracking">
    <Button
      emphasis="ghost"
      width="fill"
      label="−0.05em"
      data-body-tracking="-0.05em"
      aria-pressed="false"
    />
    <Button
      emphasis="ghost"
      width="fill"
      label="−0.01em"
      data-body-tracking="-0.01em"
      aria-pressed="false"
    />
    <Button
      emphasis="ghost"
      width="fill"
      label="0"
      data-body-tracking="0"
      aria-pressed="true"
    />
  </SegmentedControl>
</div>

<style>
  .dev-body-tracking {
    position: fixed;
    top: 1em;
    right: 1em;
    z-index: 80;
    display: flex;
    flex-direction: column;
    gap: var(--dev-panel-label-gap, 4px);
    width: min(28em, calc(100vw - 2em));
    padding: var(--dev-panel-pad, 12px);
    border: 1px solid var(--sys-color-srf-container-low);
    border-radius: var(--dev-radius-panel, 12px);
    background: var(--sys-color-srf);
    box-shadow: var(--dev-panel-shadow);
    font-family: var(--font-sans);
    color: var(--sys-color-on-srf);
  }

  .dev-body-tracking__title {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .dev-body-tracking :global(.dev-segmented) {
    width: 100%;
  }
</style>

<script>
  const STORAGE_KEY = 'vcd:body-tracking';
  const DEFAULT: Tracking = '0';

  type Tracking = '0' | '-0.01em' | '-0.05em';

  const isTracking = (value: unknown): value is Tracking =>
    value === '0' || value === '-0.01em' || value === '-0.05em';

  const readStored = (): Tracking => {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return isTracking(raw) ? raw : DEFAULT;
    } catch {
      return DEFAULT;
    }
  };

  const apply = (value: Tracking) => {
    document.documentElement.style.setProperty('--text-body-tracking', value);
    try {
      sessionStorage.setItem(STORAGE_KEY, value);
    } catch {
      /* ignore quota / private mode */
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-body-tracking]')) {
      btn.setAttribute('aria-pressed', String(btn.dataset.bodyTracking === value));
    }
  };

  const bind = (root: ParentNode) => {
    const host = root.querySelector<HTMLElement>('[data-dev-body-tracking]');
    if (!host || host.dataset.bound === 'true') return;
    host.dataset.bound = 'true';
    host.addEventListener('click', (event) => {
      const btn = (event.target as Element | null)?.closest?.('[data-body-tracking]');
      if (!(btn instanceof HTMLElement)) return;
      const value = btn.dataset.bodyTracking;
      if (!isTracking(value)) return;
      apply(value);
    });
    apply(readStored());
  };

  bind(document);
  document.addEventListener('astro:page-load', () => bind(document));
</script>
