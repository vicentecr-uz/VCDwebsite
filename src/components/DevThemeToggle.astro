---
import SegmentedControl from './ui/SegmentedControl.astro';
import Button from './ui/Button.astro';

/**
 * Figma master: Theme Selector (520:2249) — Segmented Control, 3 icon-only
 * segments, selected = Page on the track.
 * https://www.figma.com/design/$FIGMA_FILE_KEY?node-id=520-2249
 */
---

<div class="dev-theme-toggle" data-dev-theme-toggle>
  <SegmentedControl label="Theme">
    <Button
      emphasis="ghost"
      width="fill"
      label=""
      data-theme-mode="system"
      aria-label="Follow system theme"
      title="Follow system theme"
      aria-pressed="false"
    >
      <span slot="icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.167" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <rect width="13.333" height="9.333" x="1.333" y="2" rx="1.333" />
          <line x1="5.333" x2="10.667" y1="14" y2="14" />
          <line x1="8" x2="8" y1="11.333" y2="14" />
        </svg>
      </span>
    </Button>
    <Button
      emphasis="ghost"
      width="fill"
      label=""
      data-theme-mode="light"
      aria-label="Light theme"
      title="Light theme"
      aria-pressed="false"
    >
      <span slot="icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.167" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="8" cy="8" r="2.667" />
          <path d="M8 1.333v1.333" />
          <path d="M8 13.333v1.333" />
          <path d="m3.287 3.287 0.94 0.94" />
          <path d="m11.773 11.773 0.94 0.94" />
          <path d="M1.333 8h1.333" />
          <path d="M13.333 8h1.333" />
          <path d="m4.227 11.773 -0.94 0.94" />
          <path d="m12.713 3.287 -0.94 0.94" />
        </svg>
      </span>
    </Button>
    <Button
      emphasis="ghost"
      width="fill"
      label=""
      data-theme-mode="dark"
      aria-label="Dark theme"
      title="Dark theme"
      aria-pressed="false"
    >
      <span slot="icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.167" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M13.99 8.324a6 6 0 1 1-6.315-6.315c.27-.015.411.307.268.535a4 4 0 0 0 5.512 5.512c.229-.143.55-.003.535.267" />
        </svg>
      </span>
    </Button>
  </SegmentedControl>
</div>

<style>
  /* Footer: only show while Edit mode is on (master is Edit chrome). */
  .dev-theme-toggle {
    display: none;
    /* Segmented track is width:100% by default — hug content in the footer. */
    width: max-content;
  }

  :global(html.is-dev-mode) .dev-theme-toggle {
    display: block;
  }

  .dev-theme-toggle :global(.dev-segmented) {
    width: auto;
  }

  /* Figma Theme Selector segments are fixed 72px (icon-only). */
  .dev-theme-toggle :global(.dev-btn) {
    min-width: 72px;
  }
</style>

<script>
  import { onPageLoad, createPageScope } from '../lib/pageLifecycle';

  const dispose = onPageLoad(() => {
    const scope = createPageScope();

  type ThemeMode = 'system' | 'light' | 'dark';

  const STORAGE_KEY = 'vcd:theme';

  const isThemeMode = (value: unknown): value is ThemeMode =>
    value === 'system' || value === 'light' || value === 'dark';

  const readStoredMode = (): ThemeMode => {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return isThemeMode(stored) ? stored : 'system';
    } catch {
      return 'system';
    }
  };

  const persistMode = (mode: ThemeMode) => {
    try {
      localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      /* private mode / storage disabled — mode still applies for this load */
    }
  };

  const applyMode = (mode: ThemeMode) => {
    if (mode === 'system') {
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.setAttribute('data-theme', mode);
    }
  };

  const root = document.querySelector<HTMLElement>('[data-dev-theme-toggle]');
  const buttons = root
    ? [...root.querySelectorAll<HTMLButtonElement>('button[data-theme-mode]')]
    : [];

  const updatePressedState = (mode: ThemeMode) => {
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeMode === mode));
    });
  };

  let currentMode: ThemeMode = readStoredMode();
  applyMode(currentMode);
  updatePressedState(currentMode);

  const setMode = (mode: ThemeMode) => {
    currentMode = mode;
    persistMode(mode);
    applyMode(mode);
    updatePressedState(mode);
    window.dispatchEvent(new CustomEvent('vcd:theme-change', { detail: { mode } }));
  };

  buttons.forEach((button) => {
    scope.listen(button, 'click', () => {
      const mode = button.dataset.themeMode;
      if (isThemeMode(mode)) setMode(mode);
    });
  });

  const isTypingTarget = (target: EventTarget | null) => {
    const el = target instanceof HTMLElement ? target : null;
    return Boolean(el && (el.isContentEditable || el.closest('input, textarea, select')));
  };

  scope.listen(document, 'keydown', (event) => {
    // Deliberately NOT gated on is-dev-mode: the shortcut switches which theme
    // you are looking at, which is useful while working on the page itself.
    // The whole component is dev-build-only, so this never reaches production.
    if (!(event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.code === 'KeyT')) return;
    if (isTypingTarget(event.target)) return;

    event.preventDefault();

    let nextMode: ThemeMode;
    if (currentMode === 'light') {
      nextMode = 'dark';
    } else if (currentMode === 'dark') {
      nextMode = 'light';
    } else {
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      nextMode = systemPrefersDark ? 'light' : 'dark';
    }
    setMode(nextMode);
  });
    return () => scope.destroy();
  });
  import.meta.hot?.dispose(dispose);
</script>
