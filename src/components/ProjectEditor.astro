---
import DevTextEditor from './DevTextEditor.astro';
import ToastStack from './ui/ToastStack.astro';
import CommandMenu from './reports/CommandMenu.astro';
import DevVideoEditor from './DevVideoEditor.astro';
import DevModeController from './DevModeController.astro';
import DevAwardBadgeSize from './DevAwardBadgeSize.astro';
import DevAwardBlockSize from './DevAwardBlockSize.astro';
import DevRedditBoardHeight from './DevRedditBoardHeight.astro';
import DevSectionReorderEditor from './DevSectionReorderEditor.astro';
import ProjectImageCropTuner from './project/ProjectImageCropTuner.astro';
import DevShortcutsHelp from './DevShortcutsHelp.astro';
import DevViewportPreview from './DevViewportPreview.astro';
import DevAssetManager from './DevAssetManager.astro';
import DevImageDescriptions from './DevImageDescriptions.astro';
import { PLAYGROUND_DOCUMENT } from '../lib/playgroundDocument.mjs';

interface Props { documentKey?: string; }
const { documentKey } = Astro.props;
---

<DevTextEditor documentKey={documentKey} />
<ToastStack fixed />
<CommandMenu contextual />
<DevVideoEditor />
<DevModeController />
<DevAwardBadgeSize />
<DevAwardBlockSize />
<DevRedditBoardHeight />
<DevSectionReorderEditor />
<ProjectImageCropTuner />
<DevShortcutsHelp playground={documentKey === PLAYGROUND_DOCUMENT} />
<DevViewportPreview />
<DevAssetManager documentKey={documentKey} />
<DevImageDescriptions />

<script>
  import '../lib/siteAnnotationEditor';
</script>
