---
// Objects that peek out from under a video once it plays. Picking one lifts it over the frame,
// drops it onto the video with a ripple, and opens its clip in the space at the top.
// Sits beside a ProjectVideo inside a positioned parent that is the video's size.
interface Clip {
  id: 'board' | 'cube' | 'pick';
  label: string;
  /** Root-relative clip URL. */
  src: string;
}

interface Props {
  clips: Clip[];
}

const { clips } = Astro.props;

// Original stand-ins, drawn here; swap for supplied artwork by replacing these strings.
const art: Record<Clip['id'], string> = {
  board: '<svg viewBox="0 0 64 64" aria-hidden="true"><g transform="rotate(-18 32 32)"><rect x="5" y="24" width="54" height="11" rx="5.5" fill="#ff5a3c"/><rect x="9" y="26" width="46" height="3" rx="1.5" fill="#ffd166"/><circle cx="18" cy="41" r="5.5" fill="#1d1d1f"/><circle cx="46" cy="41" r="5.5" fill="#1d1d1f"/><circle cx="18" cy="41" r="2" fill="#fff"/><circle cx="46" cy="41" r="2" fill="#fff"/></g></svg>',
  cube: '<svg viewBox="0 0 64 64" aria-hidden="true"><rect x="9" y="9" width="46" height="46" rx="11" fill="#5b8cff"/><rect x="9" y="9" width="46" height="23" rx="11" fill="#7da4ff"/><circle cx="24" cy="28" r="4.5" fill="#10214d"/><circle cx="40" cy="28" r="4.5" fill="#10214d"/><path d="M22 40q10 9 20 0" fill="none" stroke="#10214d" stroke-width="4" stroke-linecap="round"/></svg>',
  pick: '<svg viewBox="0 0 64 64" aria-hidden="true"><rect x="29" y="14" width="6" height="46" rx="3" transform="rotate(45 32 32)" fill="#9a6b3f"/><path d="M12 30C16 14 34 6 52 12C40 12 28 18 22 34Z" fill="#35d0c0"/><path d="M12 30C16 14 34 6 52 12C40 10 24 14 16 28Z" fill="#8cf0e4"/></svg>',
};
---

{clips.length > 0 && (
  <div class="side-clips" data-side-clips>
    {clips.map((clip, index) => (
      <button
        type="button"
        class="side-clips__item"
        style={`--slot: ${index};`}
        data-side-clip={clip.id}
        data-clip-src={clip.src}
        data-clip-label={clip.label}
        aria-label={`Play ${clip.label} clip`}
        tabindex="-1"
      >
        <span class="side-clips__art" set:html={art[clip.id]} />
      </button>
    ))}
  </div>
)}

<style is:global>
  .side-clips {
    --side-clip-size: max(44px, 17cqi);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .side-clips__item {
    --lift: 0;
    position: absolute;
    top: calc(7% + var(--slot) * 13.5%);
    left: 100%;
    z-index: 0;
    width: var(--side-clip-size);
    height: var(--side-clip-size);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Tucked under the video until it plays. */
    translate: -105% 0;
    rotate: calc(-9deg + var(--slot) * 10deg);
    transition: translate 520ms cubic-bezier(0.34, 1.45, 0.64, 1) calc(var(--slot) * 90ms);
    filter: drop-shadow(0 calc(var(--lift) * 18px) calc(var(--lift) * 14px) rgb(0 0 0 / calc(var(--lift) * 0.32)));
  }

  .side-clips[data-revealed] .side-clips__item:not([data-used]) {
    pointer-events: auto;
    translate: -52% 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .side-clips[data-revealed] .side-clips__item:not([data-used], [data-flying]):hover {
      translate: -38% 0;
      transition-delay: 0s;
    }
  }

  .side-clips__item[data-flying] {
    z-index: 3;
    pointer-events: none;
    transition: none;
  }

  .side-clips__item:focus-visible {
    outline: 2px solid var(--sys-color-outline);
    outline-offset: 2px;
    border-radius: var(--radius-control);
  }

  .side-clips__art,
  .side-clips__art svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The clip: a 16:9 card in the space at the top of the frame, grown from where the object landed. */
  .side-clips__card {
    position: absolute;
    top: 5%;
    left: 6%;
    z-index: 1;
    width: 88%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius-card) * var(--continuous-corner-scale, 1) * 0.75);
    corner-shape: var(--squircle-shape);
    overflow: hidden;
    background: #1d1d1f;
    box-shadow: 0 10px 30px rgb(0 0 0 / 30%);
    cursor: pointer;
    opacity: 0;
    scale: 0.3;
    transition: opacity 220ms ease, scale 420ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .side-clips__card[data-open] {
    opacity: 1;
    scale: 1;
  }

  .side-clips__card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    outline: 1px solid rgb(255 255 255 / 12%);
    outline-offset: -1px;
    pointer-events: none;
  }

  .side-clips__card video,
  .side-clips__card-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .side-clips__card video { object-fit: cover; }
  .side-clips__card-art { display: grid; place-items: center; }
  .side-clips__card-art svg { width: 34%; height: auto; }

  .side-clips__card:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }

  .side-clips__ripple {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .side-clips__item { transition: opacity 200ms ease; }
    .side-clips__card { scale: 1; transition: opacity 220ms ease; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { onPageLoad } from '../lib/pageLifecycle';

  const VERTEX = 'attribute vec2 p; varying vec2 uv; void main() { uv = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }';
  // One ring travels out from the impact point, bending the frame as it passes and fading as it goes.
  const FRAGMENT = `precision mediump float;
    uniform sampler2D frame; uniform vec2 center; uniform float progress; uniform float aspect; varying vec2 uv;
    void main() {
      vec2 d = uv - center; d.y *= aspect;
      float r = length(d);
      float front = progress * 1.5;
      float ring = sin(46.0 * (r - front)) * exp(-pow((r - front) * 7.0, 2.0)) * (1.0 - progress);
      vec2 dir = r > 0.0 ? d / r : vec2(0.0);
      dir.y /= aspect;
      vec4 color = texture2D(frame, uv + dir * ring * 0.03);
      color.rgb += ring * 0.09;
      gl_FragColor = color;
    }`;

  /** Plays one ripple over `video`, centred at (x, y) in 0–1 frame coordinates. Returns nothing if WebGL is missing. */
  function ripple(host: HTMLElement, video: HTMLVideoElement, x: number, y: number) {
    const canvas = document.createElement('canvas');
    const gl = canvas.getContext('webgl', { premultipliedAlpha: false });
    if (!gl) return;
    const box = host.getBoundingClientRect();
    canvas.width = Math.round(box.width * Math.min(devicePixelRatio, 2));
    canvas.height = Math.round(box.height * Math.min(devicePixelRatio, 2));
    canvas.className = 'side-clips__ripple';
    canvas.setAttribute('aria-hidden', 'true');
    canvas.setAttribute('noautohide', '');
    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      return shader;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, 'p');
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
    gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
    for (const [name, value] of [[gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE], [gl.TEXTURE_MIN_FILTER, gl.LINEAR], [gl.TEXTURE_MAG_FILTER, gl.LINEAR]]) {
      gl.texParameteri(gl.TEXTURE_2D, name, value);
    }
    gl.uniform2f(gl.getUniformLocation(program, 'center'), x, 1 - y);
    gl.uniform1f(gl.getUniformLocation(program, 'aspect'), box.height / box.width);
    const progress = gl.getUniformLocation(program, 'progress');
    gl.viewport(0, 0, canvas.width, canvas.height);
    video.after(canvas);
    const start = performance.now();
    const DURATION = 1100;
    const frame = (now: number) => {
      const t = Math.min(1, (now - start) / DURATION);
      if (!canvas.isConnected) return;
      try {
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, video);
      } catch {
        canvas.remove();
        return;
      }
      gl.uniform1f(progress, t);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (t < 1) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);
  }

  const dispose = onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-side-clips]');
    const player = root?.parentElement?.querySelector<HTMLElement>('[data-project-video]');
    const video = player?.querySelector<HTMLVideoElement>('video[data-project-inline-video]');
    if (!root || !player || !video) return;
    const controller = new AbortController();
    const { signal } = controller;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-side-clip]')];
    // Where the object lands and the card grows from: the middle of the card, in frame coordinates.
    const LANDING = { x: 0.5, y: 0.05 + (0.88 * 9 / 16) * (9 / 16) / 2 };
    let card: HTMLButtonElement | undefined;
    let active: HTMLButtonElement | undefined;
    let flight: gsap.core.Timeline | undefined;

    const restore = (item: HTMLButtonElement) => {
      gsap.set(item, { clearProps: 'transform,opacity,--lift' });
      item.removeAttribute('data-flying');
      // One frame tucked under the video, so it slides back out rather than appearing in place.
      requestAnimationFrame(() => item.removeAttribute('data-used'));
    };
    const closeCard = () => {
      const closing = card;
      card = undefined;
      if (active) restore(active);
      active = undefined;
      if (!closing) return;
      closing.removeAttribute('data-open');
      closing.querySelector('video')?.pause();
      setTimeout(() => closing.remove(), 420);
    };
    const openCard = (item: HTMLButtonElement) => {
      const next = document.createElement('button');
      next.type = 'button';
      next.className = 'side-clips__card';
      next.setAttribute('noautohide', '');
      next.setAttribute('aria-label', `Hide ${item.dataset.clipLabel} clip`);
      next.style.transformOrigin = '50% 50%';
      // The object's own drawing stands in until the clip has loaded, or when there is no clip yet.
      const stand = document.createElement('span');
      stand.className = 'side-clips__card-art';
      stand.innerHTML = item.querySelector('.side-clips__art')?.innerHTML ?? '';
      const clip = document.createElement('video');
      clip.muted = true;
      clip.loop = true;
      clip.playsInline = true;
      clip.preload = 'auto';
      clip.hidden = true;
      clip.addEventListener('loadeddata', () => { clip.hidden = false; }, { signal });
      clip.src = item.dataset.clipSrc ?? '';
      next.append(stand, clip);
      next.addEventListener('click', (event) => { event.stopPropagation(); closeCard(); }, { signal });
      (video.parentElement ?? player).append(next);
      card = next;
      requestAnimationFrame(() => next.setAttribute('data-open', ''));
      if (!video.paused) clip.play().catch(() => {});
    };

    const pick = (item: HTMLButtonElement) => {
      if (flight?.isActive()) return;
      closeCard();
      active = item;
      const frame = player.getBoundingClientRect();
      const from = item.getBoundingClientRect();
      const dx = frame.left + frame.width * LANDING.x - (from.left + from.width / 2);
      const dy = frame.top + frame.height * LANDING.y - (from.top + from.height / 2);
      const land = () => {
        item.setAttribute('data-used', '');
        if (!reduced.matches) ripple(player, video, LANDING.x, LANDING.y);
        openCard(item);
      };
      item.setAttribute('data-flying', '');
      if (reduced.matches) {
        flight = gsap.timeline().to(item, { opacity: 0, duration: 0.2 }).add(land);
        return;
      }
      flight = gsap.timeline()
        // Out from under the video.
        .to(item, { x: from.width * 0.75, duration: 0.26, ease: 'power2.out' })
        // Up toward the viewer, and across to the top of the frame.
        .to(item, { scale: 1.75, rotation: -6, '--lift': 1, duration: 0.34, ease: 'power2.out' })
        .to(item, { x: dx, duration: 0.6, ease: 'power2.inOut' }, '<0.06')
        .to(item, { y: dy - frame.height * 0.05, duration: 0.6, ease: 'power2.out' }, '<')
        // Down onto the video.
        .to(item, { y: dy, scale: 0.8, '--lift': 0, duration: 0.2, ease: 'power2.in' })
        .add(land)
        .to(item, { scale: 0.4, opacity: 0, duration: 0.18, ease: 'power1.out' });
    };

    items.forEach((item) => item.addEventListener('click', () => pick(item), { signal }));
    video.addEventListener('play', () => {
      root.setAttribute('data-revealed', '');
      items.forEach((item) => { item.tabIndex = 0; });
      card?.querySelector('video')?.play().catch(() => {});
    }, { signal });
    video.addEventListener('pause', () => card?.querySelector('video')?.pause(), { signal });

    return () => {
      controller.abort();
      flight?.kill();
      card?.remove();
      player.querySelectorAll('.side-clips__ripple').forEach((canvas) => canvas.remove());
      items.forEach((item) => {
        gsap.set(item, { clearProps: 'transform,opacity,--lift' });
        item.removeAttribute('data-flying');
        item.removeAttribute('data-used');
      });
      root.removeAttribute('data-revealed');
    };
  });
  import.meta.hot?.dispose(dispose);
</script>
