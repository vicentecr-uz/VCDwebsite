---
import DevOverlay from './DevOverlay.astro';
import Field from './ui/Field.astro';
import ViewportSelector from './ui/ViewportSelector.astro';
import Button from './ui/Button.astro';
import PanelActions from './ui/PanelActions.astro';
---

<DevOverlay storageKey="award-badge-size" panelKey="award-badge-size" defaultHidden>
  <div data-award-badge-size>
    <ViewportSelector dataAttr="data-award-viewport" />
    <Field label="Width" labelFor="award-badge-width">
      <output slot="labelAccessory" for="award-badge-width" data-award-size-readout>64px</output>
      <input id="award-badge-width" class="award-badge-size__range" type="range" min="16" max="160" step="1" value="64" data-award-size />
    </Field>
    <PanelActions><Button emphasis="ghost" label="Reset" data-award-size-reset /></PanelActions>
  </div>
</DevOverlay>

<style>
  [data-award-badge-size] { display: grid; gap: var(--space-unit); }
  .award-badge-size__range { display: block; width: 100%; accent-color: var(--sys-color-on-srf); }
</style>

<script>
  const STORAGE_KEY = 'vcd:goodhome-award-size:v1';
  const DEFAULTS = { desktop: 64, tablet: 48, mobile: 40 };
  type Viewport = keyof typeof DEFAULTS;
  let cleanup: (() => void) | undefined;

  const init = () => {
    cleanup?.();
    const panel = document.querySelector<HTMLElement>('[data-award-badge-size]');
    if (!panel) return;
    const controller = new AbortController();
    const { signal } = controller;
    const values = { ...DEFAULTS };
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      for (const viewport of Object.keys(DEFAULTS) as Viewport[]) {
        if (typeof saved?.[viewport] === 'number' && Number.isFinite(saved[viewport]) && saved[viewport] >= 16 && saved[viewport] <= 160) {
          values[viewport] = saved[viewport];
        }
      }
    } catch { /* Keep defaults when browser storage is unavailable. */ }
    const field = panel.querySelector<HTMLInputElement>('[data-award-size]');
    const readout = panel.querySelector<HTMLOutputElement>('[data-award-size-readout]');
    const viewportButtons = [...panel.querySelectorAll<HTMLButtonElement>('[data-award-viewport]')];
    if (!field || !readout || !viewportButtons.length) return;
    const actualViewport = (): Viewport => window.innerWidth <= 767 ? 'mobile' : window.innerWidth <= 991 ? 'tablet' : 'desktop';
    let selected = actualViewport();
    const apply = () => {
      for (const viewport of Object.keys(DEFAULTS) as Viewport[]) {
        document.documentElement.style.setProperty(`--goodhome-award-width-${viewport}`, `${values[viewport]}px`);
      }
    };
    const sync = () => {
      field.value = String(values[selected]);
      readout.textContent = `${values[selected]}px`;
      viewportButtons.forEach((button) => {
        const active = button.dataset.awardViewport === selected;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };
    const persist = () => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(values)); } catch { /* Live sizing still works without storage. */ }
    };
    viewportButtons.forEach((button) => button.addEventListener('click', () => {
      const viewport = button.dataset.awardViewport as Viewport;
      if (!Object.hasOwn(DEFAULTS, viewport)) return;
      selected = viewport;
      sync();
    }, { signal }));
    field.addEventListener('input', () => {
      if (!field.validity.valid || !Number.isFinite(field.valueAsNumber)) return;
      values[selected] = field.valueAsNumber;
      readout.textContent = `${values[selected]}px`;
      apply();
      persist();
    }, { signal });
    field.addEventListener('change', () => {
      if (!field.validity.valid || !Number.isFinite(field.valueAsNumber)) sync();
    }, { signal });
    panel.querySelector('[data-award-size-reset]')?.addEventListener('click', () => {
      Object.assign(values, DEFAULTS);
      apply();
      sync();
      persist();
    }, { signal });
    apply();
    sync();
    cleanup = () => {
      controller.abort();
      for (const viewport of Object.keys(DEFAULTS)) document.documentElement.style.removeProperty(`--goodhome-award-width-${viewport}`);
    };
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
  if (import.meta.hot) import.meta.hot.dispose(() => cleanup?.());
  init();
</script>
