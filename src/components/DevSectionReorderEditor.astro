---
/** Lift-and-scroll reorder for project page blocks in dev mode (sections[]). */
---

<script>
  import {
    captureSectionOrder,
    ensureSectionOrderIds,
    getDropZone,
    getSectionRootsInDomOrder,
    sectionOrderId,
  } from '../scripts/devSectionPaths';
  import { syncDevSectionOutlineSidebar } from '../scripts/devSectionOutlineSync';

  const DRAG_HANDLE_ATTR = 'data-dev-section-drag-handle';
  const DRAG_BRIDGE_CLASS = 'dev-section-drag-bridge';
  const HOME_CLASS = 'dev-section-reorder-home';
  const GAP_CLASS = 'dev-section-reorder-gap';
  const LIFT_BACKDROP_CLASS = 'dev-section-lift-backdrop';
  const SECTION_DRAGGING_CLASS = 'is-section-reorder-dragging';

  type InteractionState = 'idle' | 'lifted' | 'scrollMode' | 'dragMode';

  const HOVER_LEAVE_MS = 450;
  const SCROLL_ACTIVATE_PX = 2;
  const SCROLL_DRIVER_THRESHOLD_PX = 4;
  const SCROLL_DRIVER_GAIN = 0.35;
  const SCROLL_DRIVER_MAX = 28;
  const BOUNDARY_PUSH_PX = 12;
  const AUTO_SCROLL_EDGE_PX = 96;
  const AUTO_SCROLL_MAX_SPEED = 18;
  const GAP_EXIT_MS = 90;
  const GAP_ENTER_MS = 140;
  const HOME_FADE_MS = 90;

  let reorderActive = false;
  let interactionState: InteractionState = 'idle';
  let dragItem: HTMLElement | null = null;
  let dragHandle: HTMLElement | null = null;
  let dragPointerId: number | null = null;
  let homePlaceholder: HTMLElement | null = null;
  let liftBackdrop: HTMLElement | null = null;
  let gapElement: HTMLElement | null = null;
  let keyboardGrabItem: HTMLElement | null = null;
  let keyboardGrabSnapshot: number[] | null = null;
  let grabOrderSnapshot: number[] | null = null;
  let baselineOrder: number[] | null = null;
  let documentKey = '';

  let sourceIndex = 0;
  let targetInsertIndex = 0;
  let liftedBlockHeight = 0;
  let liftAnchorY = 0;
  let grabPointerX = 0;
  let grabPointerY = 0;
  let lastPointerY = 0;
  let boundaryPushY = 0;
  let gapAnimationToken = 0;
  let gapAnimationTimer: ReturnType<typeof setTimeout> | null = null;
  let autoScrollRafId = 0;
  let sessionTickRafId = 0;
  let sessionPointerActive = false;
  let sessionButtonDown = false;
  let lastClientX = 0;
  let lastClientY = 0;

  const trackClientPosition = (event: MouseEvent | PointerEvent) => {
    lastClientX = event.clientX;
    lastClientY = event.clientY;
  };

  document.addEventListener('pointermove', trackClientPosition, { capture: true, passive: true });
  document.addEventListener('mousemove', trackClientPosition, { capture: true, passive: true });

  const driveScrollFromPointer = () => {
    const delta = dragPointerY - grabPointerY;
    if (Math.abs(delta) < SCROLL_DRIVER_THRESHOLD_PX) return;

    const speed = Math.min(
      SCROLL_DRIVER_MAX,
      Math.max(3, Math.abs(delta) * SCROLL_DRIVER_GAIN),
    );
    window.scrollBy(0, delta < 0 ? -speed : speed);
  };

  const processSessionFrame = () => {
    if (!dragItem || !sessionButtonDown) return;

    dragPointerX = lastClientX;
    dragPointerY = lastClientY;

    if (interactionState === 'lifted' || interactionState === 'scrollMode') {
      interactionState = 'scrollMode';
      driveScrollFromPointer();
      lastPointerY = lastClientY;
      return;
    }

    if (interactionState === 'dragMode') {
      updateDragModeHover(lastClientX, lastClientY);
      lastPointerY = lastClientY;
    }
  };

  const sessionTick = () => {
    sessionTickRafId = 0;
    processSessionFrame();
    if (dragItem && sessionButtonDown) {
      sessionTickRafId = requestAnimationFrame(sessionTick);
    }
  };

  const startSessionTick = () => {
    if (sessionTickRafId) return;
    sessionTickRafId = requestAnimationFrame(sessionTick);
  };

  const stopSessionTick = () => {
    if (!sessionTickRafId) return;
    cancelAnimationFrame(sessionTickRafId);
    sessionTickRafId = 0;
  };

  const stopScrollDriver = () => {
    stopSessionTick();
  };

  const startScrollDriver = () => {
    startSessionTick();
  };

  const stopAutoScroll = () => {
    if (!autoScrollRafId) return;
    cancelAnimationFrame(autoScrollRafId);
    autoScrollRafId = 0;
  };

  const autoScrollStep = () => {
    autoScrollRafId = 0;
    if (!dragItem || interactionState !== 'dragMode') return;

    const viewportHeight = window.innerHeight;
    let scrollDelta = 0;

    if (dragPointerY < AUTO_SCROLL_EDGE_PX) {
      const depth = (AUTO_SCROLL_EDGE_PX - dragPointerY) / AUTO_SCROLL_EDGE_PX;
      scrollDelta = -Math.max(2, Math.round(AUTO_SCROLL_MAX_SPEED * depth));
    } else if (dragPointerY > viewportHeight - AUTO_SCROLL_EDGE_PX) {
      const depth = (dragPointerY - (viewportHeight - AUTO_SCROLL_EDGE_PX)) / AUTO_SCROLL_EDGE_PX;
      scrollDelta = Math.max(2, Math.round(AUTO_SCROLL_MAX_SPEED * depth));
    }

    if (scrollDelta !== 0) {
      const prevScroll = window.scrollY;
      window.scrollBy(0, scrollDelta);
      if (window.scrollY !== prevScroll) {
        updateDragModeHover(dragPointerX, dragPointerY);
      }
      autoScrollRafId = requestAnimationFrame(autoScrollStep);
    }
  };

  const startAutoScroll = () => {
    if (autoScrollRafId || interactionState !== 'dragMode') return;
    autoScrollRafId = requestAnimationFrame(autoScrollStep);
  };

  const hoverLeaveTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const dropZone = () => getDropZone();

  const isChromeNode = (el: HTMLElement) =>
    el.classList.contains(HOME_CLASS) || el.classList.contains(GAP_CLASS);

  const getContentSections = () =>
    getSectionRootsInDomOrder().filter((el) => el !== dragItem && !isChromeNode(el));

  const resolveSectionRoot = (element: HTMLElement | null): HTMLElement | null => {
    if (!element) return null;
    const items = getSectionRootsInDomOrder();
    if (items.includes(element)) return element;
    return items.find((item) => item === element || item.contains(element)) ?? null;
  };

  const measureBlockHeight = (el: HTMLElement) => el.getBoundingClientRect().height;

  const ordersMatch = (left: number[], right: number[]) =>
    JSON.stringify(left) === JSON.stringify(right);

  const restoreDomOrder = (order: number[]) => {
    const zone = dropZone();
    if (!zone) return;

    const rootsById = new Map<number, HTMLElement>();
    getSectionRootsInDomOrder().forEach((root) => {
      const id = sectionOrderId(root);
      if (id !== null) rootsById.set(id, root);
    });

    for (const id of order) {
      const root = rootsById.get(id);
      if (!root) continue;
      zone.append(root);
    }
  };

  const syncPending = () => {
    const zone = dropZone();
    if (!zone || !documentKey) return;

    if (!baselineOrder) baselineOrder = captureSectionOrder(zone);
    const baseline = baselineOrder;
    const current = captureSectionOrder(zone);
    const pendingId = `section-order:${documentKey}`;

    if (ordersMatch(baseline, current)) {
      zone.classList.remove('is-section-order-dirty');
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
      return;
    }

    zone.classList.add('is-section-order-dirty');
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
      detail: {
        id: pendingId,
        kind: 'section-order',
        payload: {
          document: documentKey,
          order: current,
        },
        revert: () => {
          restoreDomOrder(structuredClone(baseline));
          zone.classList.remove('is-section-order-dirty');
          syncDevSectionOutlineSidebar();
        },
      },
    }));
    syncDevSectionOutlineSidebar();
  };

  const moveSectionToIndex = (item: HTMLElement, insertIndex: number) => {
    const zone = dropZone();
    if (!zone) return;

    const others = getContentSections().filter((entry) => entry !== item);
    const nextIndex = Math.max(0, Math.min(insertIndex, others.length));

    if (nextIndex >= others.length) {
      zone.append(item);
      return;
    }

    const before = others[nextIndex];
    const parent = before.parentElement;
    if (parent) parent.insertBefore(item, before);
    else zone.insertBefore(item, before);
  };

  const placeGapBeforeIndex = (index: number) => {
    const zone = dropZone();
    if (!zone || !gapElement) return;

    const sections = getContentSections();
    if (index >= sections.length) zone.append(gapElement);
    else sections[index].before(gapElement);
  };

  const clearGapAnimationTimer = () => {
    if (gapAnimationTimer) clearTimeout(gapAnimationTimer);
    gapAnimationTimer = null;
  };

  const waitMs = (ms: number) => new Promise<void>((resolve) => {
    gapAnimationTimer = setTimeout(resolve, ms);
  });

  const removeGapElement = () => {
    if (!gapElement) return;
    gapElement.remove();
    gapElement = null;
  };

  const updateHomeSlot = () => {
    if (!homePlaceholder) return;
    const showHome = targetInsertIndex === sourceIndex;
    homePlaceholder.classList.toggle('is-active', showHome);
    homePlaceholder.style.transitionDuration = prefersReducedMotion() ? '0ms' : `${HOME_FADE_MS}ms`;
  };

  const setGapPreviewIndex = async (nextIndex: number) => {
    const clamped = Math.max(0, Math.min(nextIndex, getContentSections().length));
    if (clamped === targetInsertIndex && (clamped === sourceIndex || gapElement)) {
      updateHomeSlot();
      return;
    }

    const token = ++gapAnimationToken;
    clearGapAnimationTimer();

    if (gapElement) {
      if (prefersReducedMotion()) {
        removeGapElement();
      } else {
        gapElement.classList.remove('is-entering');
        gapElement.classList.add('is-exiting');
        await waitMs(GAP_EXIT_MS);
        if (token !== gapAnimationToken) return;
        removeGapElement();
      }
    }

    targetInsertIndex = clamped;
    updateHomeSlot();

    if (clamped === sourceIndex || interactionState === 'dragMode') return;

    gapElement = document.createElement('div');
    gapElement.className = GAP_CLASS;
    gapElement.setAttribute('aria-hidden', 'true');
    gapElement.style.setProperty('--gap-height', `${liftedBlockHeight}px`);
    placeGapBeforeIndex(clamped);

    if (prefersReducedMotion()) {
      gapElement.classList.add('is-entering');
      return;
    }

    requestAnimationFrame(() => {
      if (token !== gapAnimationToken || !gapElement) return;
      gapElement.classList.add('is-entering');
    });
  };

  const resolveInsertIndex = (clientY: number) => {
    const sections = getContentSections();
    for (let i = 0; i < sections.length; i += 1) {
      const rect = sections[i].getBoundingClientRect();
      const mid = rect.top + rect.height / 2;
      if (clientY < mid) return i;
    }
    return sections.length;
  };

  const applyFixedLift = (root: HTMLElement) => {
    const rect = root.getBoundingClientRect();
    const sectionStyle = getComputedStyle(root);
    liftedBlockHeight = measureBlockHeight(root);
    liftAnchorY = rect.top + rect.height / 2;

    homePlaceholder = document.createElement('div');
    homePlaceholder.className = `${HOME_CLASS} is-active`;
    homePlaceholder.setAttribute('aria-hidden', 'true');
    homePlaceholder.style.setProperty('--gap-height', `${liftedBlockHeight}px`);
    // Keep sibling spacing so blocks below don't jump when the section leaves flow.
    homePlaceholder.style.marginTop = sectionStyle.marginTop;
    homePlaceholder.style.marginBottom = sectionStyle.marginBottom;
    root.before(homePlaceholder);

    liftBackdrop = document.createElement('div');
    liftBackdrop.className = LIFT_BACKDROP_CLASS;
    liftBackdrop.setAttribute('aria-hidden', 'true');
    root.prepend(liftBackdrop);

    root.classList.add('is-section-lifted');
    root.style.position = 'fixed';
    root.style.left = `${rect.left}px`;
    root.style.top = `${rect.top}px`;
    root.style.width = `${rect.width}px`;
    root.style.margin = '0';
    root.style.zIndex = '100';
  };

  const clearFixedLift = () => {
    if (!dragItem) return;
    liftBackdrop?.remove();
    liftBackdrop = null;
    dragItem.querySelector(`.${LIFT_BACKDROP_CLASS}`)?.remove();
    dragItem.classList.remove('is-section-lifted');
    dragItem.style.position = '';
    dragItem.style.left = '';
    dragItem.style.top = '';
    dragItem.style.width = '';
    dragItem.style.margin = '';
    dragItem.style.zIndex = '';
  };

  const teardownLiftChrome = () => {
    gapAnimationToken += 1;
    clearGapAnimationTimer();
    removeGapElement();
    homePlaceholder?.remove();
    homePlaceholder = null;
    clearFixedLift();
    getSectionRootsInDomOrder().forEach((item) => {
      if (!isChromeNode(item)) item.classList.remove('is-section-drop-target');
    });
    dragItem?.classList.remove('is-section-dragging', 'is-section-keyboard-grabbed');
    dragItem?.setAttribute('aria-grabbed', 'false');
    dragHandle?.setAttribute('aria-grabbed', 'false');
  };

  const setSectionDragging = (active: boolean) => {
    document.documentElement.classList.toggle(SECTION_DRAGGING_CLASS, active);
    if (active) {
      document.querySelector('.site-header')?.classList.add('is-scrolled-hidden');
    }
  };

  const enterLift = (root: HTMLElement, handle: HTMLButtonElement, pointerId: number, x: number, y: number) => {
    dragItem = root;
    dragHandle = handle;
    dragPointerId = pointerId >= 0 ? pointerId : null;
    interactionState = 'lifted';
    sessionButtonDown = pointerId >= 0;

    const sections = getSectionRootsInDomOrder().filter((el) => !isChromeNode(el));
    sourceIndex = sections.indexOf(root);
    if (sourceIndex < 0) sourceIndex = 0;
    targetInsertIndex = sourceIndex;

    lastClientX = x;
    lastClientY = y;
    grabPointerX = x;
    grabPointerY = y;
    lastPointerY = y;
    boundaryPushY = y;
    grabOrderSnapshot = captureSectionOrder();

    if (pointerId >= 0) {
      try {
        handle.setPointerCapture(pointerId);
      } catch {
        // RAF session tick still tracks pointer position.
      }
    }

    applyFixedLift(root);
    pinSectionControls(root);
    setSectionDragging(true);

    root.classList.add('is-section-lifted-session');
    bindSessionPointerListeners();
    startSessionTick();
  };

  const enterScrollMode = () => {
    if (interactionState !== 'lifted') return;
    interactionState = 'scrollMode';
    startScrollDriver();
  };

  const enterDragMode = async () => {
    if (!dragItem || interactionState === 'dragMode') return;
    interactionState = 'dragMode';

    gapAnimationToken += 1;
    clearGapAnimationTimer();
    removeGapElement();
    homePlaceholder?.remove();
    homePlaceholder = null;

    clearFixedLift();
    moveSectionToIndex(dragItem, targetInsertIndex);
    dragItem.classList.add('is-section-dragging');
    dragItem.style.pointerEvents = 'none';
    dragHandle?.style.setProperty('pointer-events', 'auto');
  };

  const commitReorder = () => {
    if (!dragItem) return;

    if (interactionState === 'scrollMode' || interactionState === 'lifted') {
      if (targetInsertIndex !== sourceIndex) {
        clearFixedLift();
        homePlaceholder?.remove();
        homePlaceholder = null;
        removeGapElement();
        moveSectionToIndex(dragItem, targetInsertIndex);
      }
    }

    teardownLiftChrome();
    grabOrderSnapshot = null;
    syncPending();
  };

  const cancelReorder = (revertDom: boolean) => {
    if (revertDom) {
      const snapshot = keyboardGrabSnapshot ?? grabOrderSnapshot;
      if (snapshot) restoreDomOrder(snapshot);
    }
    teardownLiftChrome();
    grabOrderSnapshot = null;
  };

  const finishPointerSession = () => {
    const root = dragItem;
    sessionButtonDown = false;
    stopSessionTick();
    stopAutoScroll();
    unbindSessionPointerListeners();

    if (dragHandle && dragPointerId != null) {
      try {
        dragItem?.releasePointerCapture(dragPointerId);
      } catch {
        // Pointer may already be released.
      }
      try {
        dragHandle.releasePointerCapture(dragPointerId);
      } catch {
        // Pointer may already be released.
      }
    }

    if (interactionState === 'scrollMode' || interactionState === 'lifted') {
      commitReorder();
    } else if (interactionState === 'dragMode') {
      teardownLiftChrome();
      syncPending();
    }

    setSectionDragging(false);
    dragItem = null;
    dragHandle = null;
    dragPointerId = null;
    interactionState = 'idle';

    if (root) {
      root.classList.remove('is-section-lifted-session');
      root.style.pointerEvents = '';
      scheduleUnpinSectionControls(root);
    }
  };

  const onSessionPointerUp = (event: PointerEvent) => {
    if (!sessionButtonDown || !dragItem) return;
    if (dragPointerId !== null && event.pointerId !== dragPointerId) return;
    finishPointerSession();
  };

  const onSessionMouseUp = (event: MouseEvent) => {
    if (!sessionButtonDown || !dragItem) return;
    if (event.button !== 0) return;
    finishPointerSession();
  };

  const bindSessionPointerListeners = () => {
    if (sessionPointerActive) return;
    sessionPointerActive = true;
    document.addEventListener('pointerup', onSessionPointerUp, { capture: true });
    document.addEventListener('mouseup', onSessionMouseUp, { capture: true });
  };

  const unbindSessionPointerListeners = () => {
    if (!sessionPointerActive) return;
    sessionPointerActive = false;
    document.removeEventListener('pointerup', onSessionPointerUp, { capture: true });
    document.removeEventListener('mouseup', onSessionMouseUp, { capture: true });
  };

  const maxScrollY = () =>
    Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);

  const checkBoundaryDragMode = () => {
    if (interactionState !== 'scrollMode') return;

    const atTop = window.scrollY <= 0;
    const atBottom = window.scrollY >= maxScrollY();
    const movingUp = dragPointerY < lastPointerY;
    const movingDown = dragPointerY > lastPointerY;

    if (atTop && movingUp) {
      boundaryPushY = Math.min(boundaryPushY, dragPointerY);
      if (boundaryPushY - dragPointerY >= BOUNDARY_PUSH_PX) {
        void enterDragMode();
      }
      return;
    }

    if (atBottom && movingDown) {
      boundaryPushY = Math.max(boundaryPushY, dragPointerY);
      if (dragPointerY - boundaryPushY >= BOUNDARY_PUSH_PX) {
        void enterDragMode();
      }
      return;
    }

    boundaryPushY = dragPointerY;
  };

  const insertRelativeToHover = (
    item: HTMLElement,
    hoverItem: HTMLElement,
    clientY: number,
  ) => {
    const others = getContentSections().filter((entry) => entry !== item);
    const hoverRoot = resolveSectionRoot(hoverItem);
    if (!hoverRoot) return;

    let refIndex = others.indexOf(hoverRoot);
    if (refIndex < 0) return;

    const rect = hoverRoot.getBoundingClientRect();
    const before = clientY < rect.top + rect.height / 2;
    if (!before) refIndex += 1;

    moveSectionToIndex(item, refIndex);
  };

  const hoverItemAtPoint = (clientX: number, clientY: number) => {
    const stack = document.elementsFromPoint(clientX, clientY);
    for (const node of stack) {
      if (!(node instanceof HTMLElement)) continue;
      if (dragItem && (node === dragItem || dragItem.contains(node))) continue;
      if (isChromeNode(node)) continue;

      const item = node.closest<HTMLElement>('[data-dev-section-reorderable]');
      const root = resolveSectionRoot(item);
      if (root && root !== dragItem) return root;
    }
    return null;
  };

  const updateDragModeHover = (clientX: number, clientY: number) => {
    if (!dragItem) return;
    const hoverItem = hoverItemAtPoint(clientX, clientY);
    getContentSections().forEach((item) => item.classList.remove('is-section-drop-target'));
    if (!hoverItem || hoverItem === dragItem) return;
    hoverItem.classList.add('is-section-drop-target');
    insertRelativeToHover(dragItem, hoverItem, clientY);
  };

  const handlePointerMove = (clientX: number, clientY: number) => {
    lastClientX = clientX;
    lastClientY = clientY;
    processSessionFrame();
  };

  const pinSectionControls = (root: HTMLElement) => {
    const pending = hoverLeaveTimers.get(root);
    if (pending) clearTimeout(pending);
    hoverLeaveTimers.delete(root);
    root.classList.add('is-dev-section-controls-visible');
  };

  const scheduleUnpinSectionControls = (root: HTMLElement | null) => {
    if (!root) return;
    if (
      root.classList.contains('is-section-lifted-session')
      || root.classList.contains('is-section-keyboard-grabbed')
    ) {
      return;
    }
    const pending = hoverLeaveTimers.get(root);
    if (pending) clearTimeout(pending);
    hoverLeaveTimers.set(root, setTimeout(() => {
      hoverLeaveTimers.delete(root);
      if (
        root.classList.contains('is-section-lifted-session')
        || root.classList.contains('is-section-keyboard-grabbed')
      ) {
        return;
      }
      if (!root.matches(':hover')) {
        root.classList.remove('is-dev-section-controls-visible');
      }
    }, HOVER_LEAVE_MS));
  };

  const wireSectionControlHover = (root: HTMLElement) => {
    if (root.dataset.devSectionControlsWired === 'true') return;
    root.dataset.devSectionControlsWired = 'true';
    root.addEventListener('mouseenter', () => pinSectionControls(root));
    root.addEventListener('mouseleave', () => scheduleUnpinSectionControls(root));
  };

  const wireDragHandle = (root: HTMLElement, handle: HTMLButtonElement) => {
    if (handle.dataset.devSectionDragWired === 'true') return;
    handle.dataset.devSectionDragWired = 'true';

    handle.addEventListener('focus', () => pinSectionControls(root));
    handle.addEventListener('blur', () => scheduleUnpinSectionControls(root));
    handle.addEventListener('click', (event) => event.preventDefault());

    handle.addEventListener('pointerdown', (event) => {
      if (!reorderActive || keyboardGrabItem) return;
      if (event.button !== 0) return;

      enterLift(root, handle, event.pointerId, event.clientX, event.clientY);
      event.preventDefault();
    });
  };

  const mountDragHandle = (root: HTMLElement) => {
    let bridge = root.querySelector<HTMLElement>(`.${DRAG_BRIDGE_CLASS}`);
    if (!bridge) {
      bridge = document.createElement('div');
      bridge.className = DRAG_BRIDGE_CLASS;
      bridge.setAttribute('aria-hidden', 'true');
      root.prepend(bridge);
    }

    let handle = root.querySelector<HTMLButtonElement>(`[${DRAG_HANDLE_ATTR}]`);
    if (!handle) {
      handle = document.createElement('button');
      handle.type = 'button';
      handle.className = 'dev-section-drag-handle';
      handle.setAttribute(DRAG_HANDLE_ATTR, '');
      handle.setAttribute('aria-label', 'Reorder section');
      handle.setAttribute('title', 'Drag to reorder · Save to persist');
      handle.setAttribute('aria-grabbed', 'false');
      handle.innerHTML = `
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
          <circle cx="4.5" cy="3" r="1.1" fill="currentColor"/>
          <circle cx="9.5" cy="3" r="1.1" fill="currentColor"/>
          <circle cx="4.5" cy="7" r="1.1" fill="currentColor"/>
          <circle cx="9.5" cy="7" r="1.1" fill="currentColor"/>
          <circle cx="4.5" cy="11" r="1.1" fill="currentColor"/>
          <circle cx="9.5" cy="11" r="1.1" fill="currentColor"/>
        </svg>
      `;
      root.append(handle);
    }

    root.setAttribute('data-dev-section-reorderable', '');
    handle.tabIndex = reorderActive ? 0 : -1;
    wireSectionControlHover(root);
    wireDragHandle(root, handle);
  };

  const syncDragHandles = () => {
    const zone = dropZone();
    if (!zone) return;

    ensureSectionOrderIds(zone);
    getSectionRootsInDomOrder().forEach((root) => {
      if (isChromeNode(root)) return;
      mountDragHandle(root);
      root.toggleAttribute('data-dev-section-reorderable', reorderActive);
      const handle = root.querySelector<HTMLButtonElement>(`[${DRAG_HANDLE_ATTR}]`);
      if (handle) {
        handle.hidden = !reorderActive;
        handle.tabIndex = reorderActive ? 0 : -1;
      }
    });

    if (!documentKey) {
      const first = getSectionRootsInDomOrder().find((el) => !isChromeNode(el));
      documentKey = first?.dataset.devSpacingDocument ?? '';
    }
  };

  const enterKeyboardLift = (root: HTMLElement, handle: HTMLButtonElement) => {
    keyboardGrabItem = root;
    keyboardGrabSnapshot = captureSectionOrder();
    enterLift(root, handle, -1, 0, 0);
    interactionState = 'scrollMode';
    root.classList.add('is-section-keyboard-grabbed');
    root.setAttribute('aria-grabbed', 'true');
    handle.setAttribute('aria-grabbed', 'true');
    void setGapPreviewIndex(sourceIndex);
  };

  const releaseKeyboardGrab = (revert: boolean) => {
    if (!keyboardGrabItem) return;
    const root = keyboardGrabItem;
    keyboardGrabItem = null;
    sessionButtonDown = false;
    stopSessionTick();
    unbindSessionPointerListeners();

    if (revert && keyboardGrabSnapshot) {
      cancelReorder(true);
      keyboardGrabSnapshot = null;
    } else {
      commitReorder();
      keyboardGrabSnapshot = null;
    }

    setSectionDragging(false);
    dragItem = null;
    dragHandle = null;
    dragPointerId = null;
    interactionState = 'idle';
    root.classList.remove('is-section-lifted-session', 'is-section-keyboard-grabbed');
    root.style.pointerEvents = '';
    scheduleUnpinSectionControls(root);
  };

  const moveKeyboardGrab = (delta: number) => {
    if (!keyboardGrabItem || !dragItem) return;
    const max = getContentSections().length;
    const next = Math.max(0, Math.min(targetInsertIndex + delta, max));
    void setGapPreviewIndex(next);

    const sections = getContentSections();
    const scrollTarget = sections[next] ?? sections[next - 1];
    scrollTarget?.scrollIntoView({ block: 'nearest', behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
  };

  const abortActiveSession = () => {
    if (interactionState === 'idle' && !keyboardGrabItem) return;
    const root = dragItem ?? keyboardGrabItem;
    const snapshot = keyboardGrabSnapshot ?? grabOrderSnapshot;
    sessionButtonDown = false;
    stopSessionTick();
    stopAutoScroll();
    unbindSessionPointerListeners();
    if (snapshot) restoreDomOrder(snapshot);
    teardownLiftChrome();
    if (root) {
      root.classList.remove('is-section-lifted-session');
      root.style.pointerEvents = '';
    }
    setSectionDragging(false);
    dragItem = null;
    dragHandle = null;
    dragPointerId = null;
    keyboardGrabItem = null;
    keyboardGrabSnapshot = null;
    grabOrderSnapshot = null;
    interactionState = 'idle';
  };

  const setReorderActive = (active: boolean) => {
    reorderActive = active;
    if (active) {
      syncDragHandles();
      baselineOrder = captureSectionOrder();
    } else {
      abortActiveSession();
      releaseKeyboardGrab(true);
      dropZone()?.classList.remove('is-section-order-dirty');
    }
    syncDragHandles();
  };

  const onDevModeChange = () => {
    const active = document.documentElement.classList.contains('is-dev-mode') && Boolean(dropZone());
    setReorderActive(active);
  };

  window.addEventListener('vcd:dev-mode-change', onDevModeChange);
  window.addEventListener('vcd:dev-section-structure-changed', () => {
    if (!reorderActive) return;
    syncDragHandles();
  });

  window.addEventListener('vcd:dev-pending-committed', () => {
    const zone = dropZone();
    if (!zone) return;
    baselineOrder = captureSectionOrder(zone);
    zone.classList.remove('is-section-order-dirty');
  });

  window.addEventListener('vcd:dev-pending-reverted', () => {
    dropZone()?.classList.remove('is-section-order-dirty');
    if (reorderActive) {
      baselineOrder = captureSectionOrder();
      syncDevSectionOutlineSidebar();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!reorderActive) return;
    if (event.altKey || event.ctrlKey || event.metaKey) return;
    if (event.repeat) return;

    const target = event.target;
    const handle = target instanceof HTMLElement
      ? target.closest<HTMLElement>(`[${DRAG_HANDLE_ATTR}]`)
      : null;

    if (keyboardGrabItem) {
      if (event.key === ' ' || event.key === 'Enter') {
        event.preventDefault();
        event.stopPropagation();
        releaseKeyboardGrab(false);
        return;
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        releaseKeyboardGrab(true);
        return;
      }

      if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
        event.preventDefault();
        event.stopPropagation();
        moveKeyboardGrab(-1);
        return;
      }

      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
        event.preventDefault();
        event.stopPropagation();
        moveKeyboardGrab(1);
        return;
      }
      return;
    }

    if (!handle || document.activeElement !== handle) return;

    if (event.key === ' ' || event.key === 'Enter') {
      event.preventDefault();
      event.stopPropagation();
      const root = resolveSectionRoot(handle);
      if (!root) return;
      enterKeyboardLift(root, handle);
    }
  });

  onDevModeChange();
</script>

