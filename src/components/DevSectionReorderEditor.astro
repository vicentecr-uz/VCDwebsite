---
/** Lift-and-scroll reorder for project page blocks in dev mode (sections[]). */
---

<script>
  import {
    captureSectionOrder,
    ensureSectionOrderIds,
    getDropZone,
    getSectionRootsInDomOrder,
    sectionOrderId,
  } from '../scripts/devSectionPaths';
  import { syncDevSectionOutlineSidebar } from '../scripts/devSectionOutlineSync';
  import { createReorderController } from '../scripts/sectionReorder';

  const DRAG_HANDLE_ATTR = 'data-dev-section-drag-handle';
  const DRAG_BRIDGE_CLASS = 'dev-section-drag-bridge';
  const DROP_INDICATOR_CLASS = 'dev-section-drop-indicator';
  const DROP_INDICATOR_BODY_CLASS = 'dev-section-drop-indicator__body';
  const LIFT_BACKDROP_CLASS = 'dev-section-lift-backdrop';
  const SECTION_DRAGGING_CLASS = 'is-section-reorder-dragging';
  const SPACER_CLASS = 'dev-section-reorder-spacer';
  const FLIP_MOVING_CLASS = 'is-section-flip-moving';
  const HOVER_LEAVE_MS = 450;

  let reorderActive = false;
  let dragItem: HTMLElement | null = null;
  let dragHandle: HTMLElement | null = null;
  let dragPointerId: number | null = null;
  let liftBackdrop: HTMLElement | null = null;
  let grabOrderSnapshot: number[] | null = null;
  let baselineOrder: number[] | null = null;
  let documentKey = '';
  let sessionPointerActive = false;
  let sessionButtonDown = false;
  let dropInProgress = false;

  const dropZone = () => getDropZone();

  const isChromeNode = (el: HTMLElement) =>
    el.classList.contains(SPACER_CLASS)
    || el.classList.contains(DROP_INDICATOR_CLASS);

  const getContentSections = () =>
    getSectionRootsInDomOrder().filter((el) => el !== dragItem && !isChromeNode(el));

  const ordersMatch = (left: number[], right: number[]) =>
    JSON.stringify(left) === JSON.stringify(right);

  const restoreDomOrder = (order: number[]) => {
    const zone = dropZone();
    if (!zone) return;

    const rootsById = new Map<number, HTMLElement>();
    getSectionRootsInDomOrder().forEach((root) => {
      const id = sectionOrderId(root);
      if (id !== null) rootsById.set(id, root);
    });

    for (const id of order) {
      const root = rootsById.get(id);
      if (root) zone.append(root);
    }
  };

  const syncPending = () => {
    const zone = dropZone();
    if (!zone || !documentKey) return;

    if (!baselineOrder) baselineOrder = captureSectionOrder(zone);
    const baseline = baselineOrder;
    const current = captureSectionOrder(zone);
    const pendingId = `section-order:${documentKey}`;

    if (ordersMatch(baseline, current)) {
      zone.classList.remove('is-section-order-dirty');
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
      return;
    }

    zone.classList.add('is-section-order-dirty');
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
      detail: {
        id: pendingId,
        kind: 'section-order',
        payload: {
          document: documentKey,
          order: current,
        },
        revert: () => {
          restoreDomOrder(structuredClone(baseline));
          zone.classList.remove('is-section-order-dirty');
          syncDevSectionOutlineSidebar();
        },
      },
    }));
    syncDevSectionOutlineSidebar();
  };

  const controller = createReorderController({
    getItems: getContentSections,
    getDropZone: dropZone,
    getDragItem: () => dragItem,
    classes: {
      indicator: DROP_INDICATOR_CLASS,
      indicatorBody: DROP_INDICATOR_BODY_CLASS,
      flipMoving: FLIP_MOVING_CLASS,
      lifted: 'is-section-lifted',
      fadeGhost: 'is-drop-indicator-fade-ghost',
    },
    measureLiftGaps: (item) => ({
      top: getComputedStyle(item).marginTop || '0px',
      bottom: '0px',
    }),
    // Tapico spaces via margin-top. Put that margin on the indicator itself
    // (not --gap-top) so collapse matches the live section and the dashed
    // body lines up with the border box. Internal rails stay at 0.
    measureInsertGaps: (_insertIndex, _sourceIndex, liftGaps) => ({
      top: '0px',
      bottom: '0px',
      marginTop: liftGaps.top,
    }),
  });

  const removeLiftBackdrop = () => {
    liftBackdrop?.remove();
    liftBackdrop = null;
    dragItem?.querySelector(`.${LIFT_BACKDROP_CLASS}`)?.remove();
  };

  const attachLiftBackdrop = (root: HTMLElement) => {
    removeLiftBackdrop();
    liftBackdrop = document.createElement('div');
    liftBackdrop.className = LIFT_BACKDROP_CLASS;
    liftBackdrop.setAttribute('aria-hidden', 'true');
    root.prepend(liftBackdrop);
  };

  const setSectionDragging = (active: boolean) => {
    document.documentElement.classList.toggle(SECTION_DRAGGING_CLASS, active);
    if (active) {
      document.querySelector('.site-header')?.classList.add('is-scrolled-hidden');
    }
  };

  const hoverLeaveTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  const pinSectionControls = (root: HTMLElement) => {
    const pending = hoverLeaveTimers.get(root);
    if (pending) clearTimeout(pending);
    hoverLeaveTimers.delete(root);
    root.classList.add('is-dev-section-controls-visible');
  };

  const scheduleUnpinSectionControls = (root: HTMLElement | null) => {
    if (!root) return;
    if (root.classList.contains('is-section-lifted-session')) return;
    const pending = hoverLeaveTimers.get(root);
    if (pending) clearTimeout(pending);
    hoverLeaveTimers.set(root, setTimeout(() => {
      hoverLeaveTimers.delete(root);
      if (root.classList.contains('is-section-lifted-session')) return;
      if (!root.matches(':hover')) {
        root.classList.remove('is-dev-section-controls-visible');
      }
    }, HOVER_LEAVE_MS));
  };

  const clearHostLiftChrome = () => {
    removeLiftBackdrop();
    getSectionRootsInDomOrder().forEach((item) => {
      if (!isChromeNode(item)) item.classList.remove('is-section-drop-target');
    });
    dragItem?.classList.remove('is-section-dragging');
  };

  const enterLift = (
    root: HTMLElement,
    handle: HTMLButtonElement,
    pointerId: number,
    y: number,
  ) => {
    if (controller.isActive()) return;

    dragItem = root;
    dragHandle = handle;
    dragPointerId = pointerId;
    sessionButtonDown = true;

    const sections = getSectionRootsInDomOrder().filter((el) => !isChromeNode(el));
    let sourceIndex = sections.indexOf(root);
    if (sourceIndex < 0) sourceIndex = 0;

    grabOrderSnapshot = captureSectionOrder();

    try {
      handle.setPointerCapture(pointerId);
    } catch {
      // Document listeners still track pointer position.
    }

    controller.beginLift(root, handle, y, sourceIndex);
    attachLiftBackdrop(root);

    pinSectionControls(root);
    getSectionRootsInDomOrder().forEach((section) => {
      if (isChromeNode(section) || section === root) return;
      section.classList.remove('is-dev-section-controls-visible');
    });
    setSectionDragging(true);
    root.classList.add('is-section-lifted-session');
    bindSessionPointerListeners();
  };

  const finishPointerSession = async () => {
    if (dropInProgress || !dragItem) return;
    if (!controller.isActive() && !sessionButtonDown) return;

    const root = dragItem;
    sessionButtonDown = false;
    unbindSessionPointerListeners();

    if (dragHandle && dragPointerId != null) {
      try {
        dragItem?.releasePointerCapture(dragPointerId);
      } catch {
        // Pointer may already be released.
      }
      try {
        dragHandle.releasePointerCapture(dragPointerId);
      } catch {
        // Pointer may already be released.
      }
    }

    dropInProgress = true;
    try {
      if (controller.isActive()) {
        await controller.endDrop();
      }
      clearHostLiftChrome();
      grabOrderSnapshot = null;
      syncPending();
    } finally {
      dropInProgress = false;
      setSectionDragging(false);
      dragItem = null;
      dragHandle = null;
      dragPointerId = null;
      if (root) {
        root.classList.remove('is-section-lifted-session');
        root.style.pointerEvents = '';
        scheduleUnpinSectionControls(root);
      }
    }
  };

  const onSessionPointerUp = (event: PointerEvent) => {
    if (!sessionButtonDown || !dragItem) return;
    if (dragPointerId !== null && event.pointerId !== dragPointerId) return;
    void finishPointerSession();
  };

  const onSessionMouseUp = (event: MouseEvent) => {
    if (!sessionButtonDown || !dragItem) return;
    if (event.button !== 0) return;
    void finishPointerSession();
  };

  const bindSessionPointerListeners = () => {
    if (sessionPointerActive) return;
    sessionPointerActive = true;
    document.addEventListener('pointerup', onSessionPointerUp, { capture: true });
    document.addEventListener('mouseup', onSessionMouseUp, { capture: true });
  };

  const unbindSessionPointerListeners = () => {
    if (!sessionPointerActive) return;
    sessionPointerActive = false;
    document.removeEventListener('pointerup', onSessionPointerUp, { capture: true });
    document.removeEventListener('mouseup', onSessionMouseUp, { capture: true });
  };

  document.addEventListener('pointermove', (event) => {
    controller.setPointerY(event.clientY);
  }, { capture: true, passive: true });

  document.addEventListener('mousemove', (event) => {
    controller.setPointerY(event.clientY);
  }, { capture: true, passive: true });

  const wireSectionControlHover = (root: HTMLElement) => {
    if (root.dataset.devSectionControlsWired === 'true') return;
    root.dataset.devSectionControlsWired = 'true';
    root.addEventListener('mouseenter', () => pinSectionControls(root));
    root.addEventListener('mouseleave', () => scheduleUnpinSectionControls(root));
  };

  const wireDragHandle = (root: HTMLElement, handle: HTMLButtonElement) => {
    if (handle.dataset.devSectionDragWired === 'true') return;
    handle.dataset.devSectionDragWired = 'true';

    handle.addEventListener('click', (event) => event.preventDefault());

    handle.addEventListener('pointerdown', (event) => {
      if (!reorderActive) return;
      if (event.button !== 0) return;

      enterLift(root, handle, event.pointerId, event.clientY);
      event.preventDefault();
    });
  };

  const mountDragHandle = (root: HTMLElement) => {
    let bridge = root.querySelector<HTMLElement>(`.${DRAG_BRIDGE_CLASS}`);
    if (!bridge) {
      bridge = document.createElement('div');
      bridge.className = DRAG_BRIDGE_CLASS;
      bridge.setAttribute('aria-hidden', 'true');
      root.prepend(bridge);
    }

    let handle = root.querySelector<HTMLButtonElement>(`[${DRAG_HANDLE_ATTR}]`);
    if (!handle) {
      handle = document.createElement('button');
      handle.type = 'button';
      handle.className = 'dev-section-drag-handle';
      handle.setAttribute(DRAG_HANDLE_ATTR, '');
      handle.setAttribute('aria-label', 'Drag to reorder section');
      handle.setAttribute('title', 'Drag to reorder · Save to persist');
      handle.tabIndex = -1;
      handle.innerHTML = `
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
          <circle cx="4.5" cy="3" r="1.1" fill="currentColor"/>
          <circle cx="9.5" cy="3" r="1.1" fill="currentColor"/>
          <circle cx="4.5" cy="7" r="1.1" fill="currentColor"/>
          <circle cx="9.5" cy="7" r="1.1" fill="currentColor"/>
          <circle cx="4.5" cy="11" r="1.1" fill="currentColor"/>
          <circle cx="9.5" cy="11" r="1.1" fill="currentColor"/>
        </svg>
      `;
      root.append(handle);
    }

    root.setAttribute('data-dev-section-reorderable', '');
    handle.tabIndex = -1;
    wireSectionControlHover(root);
    wireDragHandle(root, handle);
  };

  const syncDragHandles = () => {
    const zone = dropZone();
    if (!zone) return;

    ensureSectionOrderIds(zone);
    getSectionRootsInDomOrder().forEach((root) => {
      if (isChromeNode(root)) return;
      mountDragHandle(root);
      root.toggleAttribute('data-dev-section-reorderable', reorderActive);
      const handle = root.querySelector<HTMLButtonElement>(`[${DRAG_HANDLE_ATTR}]`);
      if (handle) {
        handle.hidden = !reorderActive;
        handle.tabIndex = -1;
      }
    });

    if (!documentKey) {
      const first = getSectionRootsInDomOrder().find((el) => !isChromeNode(el));
      documentKey = first?.dataset.devSpacingDocument ?? '';
    }
  };

  const abortActiveSession = () => {
    if (!controller.isActive() && !dragItem) return;
    const root = dragItem;
    sessionButtonDown = false;
    unbindSessionPointerListeners();
    if (grabOrderSnapshot) restoreDomOrder(grabOrderSnapshot);
    controller.destroy();
    clearHostLiftChrome();
    if (root) {
      root.classList.remove('is-section-lifted-session');
      root.style.pointerEvents = '';
    }
    setSectionDragging(false);
    dragItem = null;
    dragHandle = null;
    dragPointerId = null;
    grabOrderSnapshot = null;
  };

  const setReorderActive = (active: boolean) => {
    reorderActive = active;
    if (active) {
      syncDragHandles();
      baselineOrder = captureSectionOrder();
    } else {
      abortActiveSession();
      dropZone()?.classList.remove('is-section-order-dirty');
    }
    syncDragHandles();
  };

  const onDevModeChange = () => {
    const active = document.documentElement.classList.contains('is-dev-mode') && Boolean(dropZone());
    setReorderActive(active);
  };

  window.addEventListener('vcd:dev-mode-change', onDevModeChange);
  window.addEventListener('vcd:dev-section-structure-changed', () => {
    if (!reorderActive) return;
    syncDragHandles();
  });

  window.addEventListener('vcd:dev-pending-committed', () => {
    const zone = dropZone();
    if (!zone) return;
    baselineOrder = captureSectionOrder(zone);
    zone.classList.remove('is-section-order-dirty');
  });

  window.addEventListener('vcd:dev-pending-reverted', () => {
    dropZone()?.classList.remove('is-section-order-dirty');
    if (reorderActive) {
      baselineOrder = captureSectionOrder();
      syncDevSectionOutlineSidebar();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!reorderActive || event.key !== 'Escape') return;
    if (!controller.isActive() && !dragItem) return;
    event.preventDefault();
    abortActiveSession();
  });

  onDevModeChange();
</script>


<style is:global>
  .is-dev-mode .section-sidebar-nav {
    pointer-events: none;
  }

  .is-dev-mode .section-sidebar-nav a,
  .is-dev-mode .section-sidebar-nav summary,
  .is-dev-mode .section-sidebar-nav button,
  .is-dev-mode .section-sidebar-nav [contenteditable='true'] {
    pointer-events: auto;
  }

  .is-dev-mode [data-dev-section-reorderable] {
    position: relative;
  }

  .is-dev-mode
    [data-dev-section-reorderable]:is(
      :hover,
      .is-section-lifted-session,
      .is-dev-section-controls-visible
    ) {
    z-index: 60;
  }

  .is-dev-mode [data-dev-project-drop-zone] {
    position: relative;
    isolation: isolate;
  }

  /* Lifted block is position:fixed inside this isolated context — raise the
     whole zone above the sticky sidebar (z-index 2–20) while dragging. */
  html.is-section-reorder-dragging [data-dev-project-drop-zone] {
    z-index: 70;
  }

  .is-dev-mode [data-dev-project-drop-zone].is-section-order-dirty {
    outline: 1px solid #6f6b62;
    outline-offset: 0.35em;
  }

  .dev-section-drag-bridge {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -4.5em;
    width: 4.5em;
    z-index: 2;
    pointer-events: none;
  }

  .is-dev-mode
    [data-dev-section-reorderable].is-dev-section-controls-visible
    > .dev-section-drag-bridge,
  .is-dev-mode [data-dev-section-reorderable]:hover > .dev-section-drag-bridge {
    pointer-events: auto;
  }

  .dev-section-drag-handle {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-surface-soft) 92%, transparent);
    backdrop-filter: blur(8px);
    padding: 0.45em 0.55em;
    color: var(--color-text);
    box-shadow: 0 0.25em 0.8em rgb(0 0 0 / 0.08);
    cursor: grab;
    opacity: 0;
    pointer-events: none;
    transform: translate(calc(-100% - 0.55em), -50%);
    transition:
      opacity 0.15s ease 0.35s,
      background-color 0.15s ease 0s;
    touch-action: none;
  }

  .is-dev-mode
    [data-dev-section-reorderable].is-dev-section-controls-visible:not(
      :has(> .dev-gap-toolbar :hover, > .dev-gap-toolbar:focus-within)
    )
    > .dev-section-drag-handle,
  .is-dev-mode [data-dev-section-reorderable]:hover:not(
      :has(> .dev-gap-toolbar :hover, > .dev-gap-toolbar:focus-within)
    )
    > .dev-section-drag-handle,
  .is-dev-mode .dev-section-drag-handle:hover,
  .is-dev-mode [data-dev-section-reorderable].is-section-lifted-session > .dev-section-drag-handle {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .is-dev-mode .dev-section-drag-handle:hover {
    background: var(--color-surface-strong);
  }

  .is-dev-mode .is-section-lifted {
    position: relative;
    isolation: isolate;
    pointer-events: none;
    touch-action: none;
    transform: scale(1);
    transition: transform 200ms ease-out;
  }

  .is-dev-mode .is-section-lifted.is-dropping {
    transition:
      top 350ms ease-out,
      left 350ms ease-out,
      transform 200ms ease-out;
    transform: scale(1);
  }

  .is-dev-mode .is-section-lifted.is-lifted-raised {
    transform: scale(1.02);
  }

  .is-dev-mode .is-section-lifted.is-lifted-raised.is-dropping {
    transform: scale(1.02);
  }

  .is-dev-mode .is-section-lifted.is-dropping .dev-section-lift-backdrop {
    box-shadow: none;
    transition: box-shadow 200ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .is-dev-mode .is-section-lifted {
      transition: none;
    }
  }

  .is-dev-mode .is-section-lifted.is-section-lifted-session {
    pointer-events: auto;
  }

  .dev-section-lift-backdrop {
    position: absolute;
    inset: -0.75em;
    z-index: -1;
    background: var(--color-bg, #ffffff);
    border-radius: var(--radius-control-smooth, 0.35em);
    box-shadow: 0 0.6em 2em rgb(0 0 0 / 0.14);
    pointer-events: none;
    transition: box-shadow 200ms ease-out;
  }

  .is-section-lifted.is-lifted-raised .dev-section-lift-backdrop {
    box-shadow: 0 0.85em 2.4em rgb(0 0 0 / 0.18);
  }

  .is-dev-mode [data-dev-section-reorderable].is-section-flip-moving {
    position: relative;
    z-index: 2;
    will-change: transform;
  }

  html.is-section-reorder-dragging {
    touch-action: none;
    user-select: none;
    cursor: grabbing;
  }

  html.is-section-reorder-dragging .dev-section-drag-handle {
    cursor: grabbing;
    opacity: 0;
    pointer-events: none;
  }

  html.is-section-reorder-dragging
    [data-dev-section-reorderable]:is(.is-section-lifted-session, .is-section-dragging)
    > .dev-section-drag-handle {
    opacity: 1;
    pointer-events: auto;
  }

  html.is-section-reorder-dragging
    [data-dev-section-reorderable]:not(
      .is-section-lifted-session,
      .is-section-dragging
    ):hover
    > .dev-section-drag-bridge,
  html.is-section-reorder-dragging
    [data-dev-section-reorderable]:not(
      .is-section-lifted-session,
      .is-section-dragging
    )
    > .dev-section-drag-handle {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-section-lift-backdrop {
      box-shadow: 0 0.35em 1.2em rgb(0 0 0 / 0.12);
    }
  }

  .is-dev-mode [data-dev-project-drop-zone] > .dev-section-drop-indicator {
    margin-inline: 0;
  }

  .is-dev-mode [data-dev-project-drop-zone] > .is-drop-preview-below {
    margin-top: 0 !important;
  }

  .dev-section-reorder-spacer {
    box-sizing: border-box;
    padding: 0;
    border: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .dev-section-drop-indicator {
    display: grid;
    grid-template-rows: var(--gap-top, 0px) auto var(--gap-bottom, 0px);
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    pointer-events: none;
  }

  .dev-section-drop-indicator__body {
    grid-row: 2;
    min-height: 0;
    height: 0;
    box-sizing: border-box;
    border: 1px dashed transparent;
    background: transparent;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition:
      height 140ms ease-out,
      opacity 90ms ease-out,
      background-color 90ms ease-out,
      border-color 90ms ease-out;
  }

  .dev-section-drop-indicator.is-visible .dev-section-drop-indicator__body {
    height: var(--gap-height, 0px);
    opacity: 1;
    border-color: color-mix(in srgb, var(--color-text-muted) 45%, transparent);
    background: color-mix(in srgb, var(--color-surface-soft) 85%, transparent);
  }

  .dev-section-drop-indicator.is-fading-out .dev-section-drop-indicator__body {
    opacity: 0;
    transition:
      opacity 90ms ease-out,
      background-color 90ms ease-out,
      border-color 90ms ease-out;
  }

  .dev-section-drop-indicator.is-visible.is-exiting .dev-section-drop-indicator__body,
  .dev-section-drop-indicator.is-exiting .dev-section-drop-indicator__body {
    height: 0;
    opacity: 0;
    transition:
      height 140ms ease-out,
      opacity 90ms ease-out,
      background-color 90ms ease-out,
      border-color 90ms ease-out;
  }

  .dev-section-drop-indicator.is-repositioning {
    transition: none !important;
  }

  .dev-section-drop-indicator.is-repositioning .dev-section-drop-indicator__body {
    transition-property: height, background-color, border-color;
    transition-duration: 0s;
    transition-timing-function: ease-out;
  }

  .dev-section-drop-indicator__body.is-drop-indicator-fade-ghost {
    position: fixed;
    margin: 0;
    box-sizing: border-box;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
    border: 1px dashed color-mix(in srgb, var(--color-text-muted) 45%, transparent);
    background: color-mix(in srgb, var(--color-surface-soft) 85%, transparent);
    border-radius: var(--radius-control-smooth, 0.35em);
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-section-drop-indicator__body {
      transition: none;
    }

    .dev-section-drop-indicator.is-visible .dev-section-drop-indicator__body {
      height: var(--gap-height, 0px);
      opacity: 1;
    }
  }

  .is-dev-mode [data-dev-section-reorderable].is-section-dragging {
    opacity: 0.55;
    outline: 2px solid #6f6b62;
    outline-offset: 2px;
  }

  .is-dev-mode [data-dev-section-reorderable].is-section-drop-target {
    outline: 2px solid #6f6b62;
    outline-offset: 2px;
  }

  .is-dev-mode [data-dev-section-reorderable].is-section-dragging .dev-section-drag-handle {
    cursor: grabbing;
    opacity: 1;
    pointer-events: auto;
  }

