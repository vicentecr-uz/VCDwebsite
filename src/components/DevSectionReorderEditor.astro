---
/** Lift-and-scroll reorder for project page blocks in dev mode (sections[]). */
import '../styles/sectionReorderChrome.css';
---

<script>
  import {
    captureSectionOrder,
    ensureSectionOrderIds,
    getDropZone,
    getSectionRootsInDomOrder,
    sectionOrderId,
  } from '../scripts/devSectionPaths';
  import { syncDevSectionOutlineSidebar, getDevSectionOutline } from '../scripts/devSectionOutlineSync';
  import {
    createReorderController,
    REORDER_TIMING,
    resolveGapLaneSide,
    resolveInsertIndexFromY,
  } from '../scripts/sectionReorder';
  import { shouldKeepLeadingSpacingSeam } from '../lib/projectStack';
  import { setIntroFoldOffsets } from '../lib/safeVh';
  import { isDevContentEditing } from '../scripts/devSectionMount';
  import {
    createSectionReorderHandle,
    SECTION_DRAG_HANDLE_ATTR,
  } from '../lib/sectionReorderChrome';

  import { createPageScope, onPageLoad } from '../lib/pageLifecycle';

  const disposePage = onPageLoad(() => {
  const pageScope = createPageScope();
  const DRAG_HANDLE_ATTR = SECTION_DRAG_HANDLE_ATTR;
  const DRAG_BRIDGE_CLASS = 'dev-section-drag-bridge';
  const DROP_INDICATOR_CLASS = 'dev-section-drop-indicator';
  const DROP_INDICATOR_BODY_CLASS = 'dev-section-drop-indicator__body';
  const LIFT_BACKDROP_CLASS = 'dev-section-lift-backdrop';
  const LIFT_BACKDROP_VISIBLE_CLASS = 'is-visible';
  // Shared with the controller, which holds the drop slot back behind this fade.
  const LIFT_BACKDROP_FADE_MS = REORDER_TIMING.LIFT_CARD_FADE_MS;
  const SECTION_DRAGGING_CLASS = 'is-section-reorder-dragging';
  const SECTION_CONTROLS_REVEAL_CLASS = 'is-section-reorder-controls-revealing';
  const SECTION_CONTROLS_SETTLING_CLASS = 'is-section-reorder-controls-settling';
  /** Fist cursor only while the button is down — settle may continue after. */
  const SECTION_HOLDING_CLASS = 'is-section-reorder-holding';
  const SPACER_CLASS = 'dev-section-reorder-spacer';
  const SOURCE_GAP_INDICATOR_CLASS = 'dev-section-source-gap-indicator';
  const FLIP_MOVING_CLASS = 'is-section-flip-moving';
  const SOURCE_PLACEMENT_KEY = 'source';
  const START_PLACEMENT_KEY = 'start';
  const END_PLACEMENT_KEY = 'end';
  const GAP_BEFORE_PLACEMENT_KEY = 'gap-before';
  const GAP_AFTER_PLACEMENT_KEY = 'gap-after';

  let reorderActive = false;
  let dragItem: HTMLElement | null = null;
  let dragHandle: HTMLElement | null = null;
  let dragPointerId: number | null = null;
  let liftBackdrop: HTMLElement | null = null;
  let grabOrderSnapshot: number[] | null = null;
  // Every drop-zone child at grab time, so an abort puts the page back exactly —
  // sections and the non-section children they were dragged past alike.
  let grabNodeSnapshot: ChildNode[] | null = null;
  let grabSpacingSnapshot: HTMLElement[] | null = null;
  let sourceGapIndicator: HTMLElement | null = null;
  let sourceGapIndicatorFollowsSlot = false;
  let sourceGapIndicatorStartsAfterSource = false;
  let sourceGapIndicatorInitialOwner: HTMLElement | null = null;
  let preservedGapPaintOwner: HTMLElement | null = null;
  let sourceGapPlacementSide: 'before' | 'after' | null = null;
  let sourceGapPreview: {
    element: HTMLElement;
    marginTop: string;
    previousValue: string;
    previousPriority: string;
    applied: boolean;
    suppressDirty: boolean;
  } | null = null;
  let destinationGapPreview: {
    element: HTMLElement;
    previousValue: string;
    previousPriority: string;
    suppressDirty: boolean;
  } | null = null;
  let grabMarginSnapshot = new Map<HTMLElement, string>();
  let baselineOrder: number[] | null = null;
  const baselineOrders = new Map<string, number[]>();
  let documentKey = '';
  let sessionPointerActive = false;
  let sessionButtonDown = false;
  let activeItems: HTMLElement[] | null = null;
  let activeIntroDrag = false;
  let activeSourceIndex = 0;
  let activePlacementKey = '';
  // A drop keeps running (settle glide, then card fade) after the controller
  // goes idle, so a re-grab can start while the previous session is still
  // finishing. Tag each lift so that tail only tears down chrome it still owns.
  let sessionSeq = 0;
  let activeSessionId = 0;
  let droppingSessionId = 0;
  let controlsRevealFrame = 0;
  let reorderSuspendedForSectionNav = false;

  const dropZone = () => getDropZone(documentKey || undefined);

  const isChromeNode = (el: HTMLElement) =>
    el.classList.contains(SPACER_CLASS)
    || el.classList.contains(DROP_INDICATOR_CLASS);

  const getContentSections = () =>
    (activeItems ?? getSectionRootsInDomOrder(dropZone())).filter((el) => el !== dragItem && !isChromeNode(el));

  const ordersMatch = (left: number[], right: number[]) =>
    JSON.stringify(left) === JSON.stringify(right);

  /**
   * Refill the slots the snapshot's nodes currently occupy, in snapshot order.
   * Appending each node to the drop zone instead would strand every other child
   * (component scripts, the scroll finale) in front of the whole project.
   */
  const restoreNodeOrder = (nodes: ChildNode[], targetZone: HTMLElement | null = dropZone()) => {
    const zone = targetZone;
    if (!zone) return;

    const wanted = new Set(nodes.filter((node) => node.parentNode === zone));
    const slots = [...zone.childNodes]
      .filter((node) => wanted.has(node))
      .map((node) => zone.insertBefore(document.createComment(''), node));

    let slotIndex = 0;
    for (const node of nodes) {
      if (!wanted.has(node)) continue;
      const slot = slots[slotIndex];
      if (!slot) break;
      slotIndex += 1;
      zone.insertBefore(node, slot);
    }

    slots.forEach((slot) => slot.remove());
  };

  /** Snapshot restore by section id — the save bar's baseline outlives its nodes. */
  const restoreDomOrder = (order: number[], targetZone: HTMLElement | null = dropZone()) => {
    const zone = targetZone;
    if (!zone) return;

    const rootsById = new Map<number, HTMLElement>();
    getSectionRootsInDomOrder(zone).forEach((root) => {
      const id = sectionOrderId(root);
      if (id !== null) rootsById.set(id, root);
    });

    restoreNodeOrder(
      order
        .map((id) => rootsById.get(id))
        .filter((root): root is HTMLElement => Boolean(root)),
      zone,
    );
  };

  const syncPending = () => {
    const zone = dropZone();
    if (!zone || !documentKey) return;

    if (!baselineOrder) {
      baselineOrder = baselineOrders.get(documentKey) ?? captureSectionOrder(zone);
      baselineOrders.set(documentKey, baselineOrder);
    }
    const baseline = baselineOrder;
    const current = captureSectionOrder(zone);
    const pendingId = `section-order:${documentKey}`;

    // Always rebuild sidebar from page order and fixed group boundaries,
    // including when order returns to baseline (otherwise the sidebar sticks
    // on the intermediate wrong state after a round-trip drag).
    if (documentKey !== 'home-intro') syncDevSectionOutlineSidebar();

    if (ordersMatch(baseline, current)) {
      zone.classList.remove('is-section-order-dirty');
      window.dispatchEvent(new CustomEvent('vcd:dev-pending-remove', { detail: { id: pendingId } }));
      return;
    }

    zone.classList.add('is-section-order-dirty');
    window.dispatchEvent(new CustomEvent('vcd:dev-pending-upsert', {
      detail: {
        id: pendingId,
        kind: 'section-order',
        payload: {
          document: documentKey,
          order: current,
          outline: getDevSectionOutline().map((entry) => ({ ...entry })),
        },
        revert: () => {
          restoreDomOrder(structuredClone(baseline), zone);
          zone.classList.remove('is-section-order-dirty');
          if (documentKey !== 'home-intro') syncDevSectionOutlineSidebar();
        },
      },
    }));
  };

  const controller = createReorderController({
    getItems: getContentSections,
    getFlipElements: () => activeIntroDrag
      ? [
          ...getSectionRootsInDomOrder(dropZone()).filter(
            (section) => section !== dragItem && !isChromeNode(section),
          ),
          ...(sourceGapIndicator?.isConnected ? [sourceGapIndicator] : []),
        ]
      : [],
    getDropZone: dropZone,
    getDragItem: () => dragItem,
    onIndicatorCreate: (indicator) => {
      const zone = dropZone();
      if (!zone || !dragItem) return;
      const zoneRect = zone.getBoundingClientRect();
      const rootRect = dragItem.getBoundingClientRect();
      const innerInset = (name: string) => {
        const value = Number.parseFloat(dragItem!.style.getPropertyValue(name));
        return Number.isFinite(value) ? value : 0;
      };
      indicator.style.setProperty(
        '--dev-section-inset',
        `${Math.max(0, rootRect.left - zoneRect.left) + innerInset('--dev-section-inset')}px`,
      );
      indicator.style.setProperty(
        '--dev-section-inset-end',
        `${Math.max(0, zoneRect.right - rootRect.right) + innerInset('--dev-section-inset-end')}px`,
      );
    },
    moveIndicatorWithFlip: false,
    classes: {
      indicator: DROP_INDICATOR_CLASS,
      indicatorBody: DROP_INDICATOR_BODY_CLASS,
      flipMoving: FLIP_MOVING_CLASS,
      lifted: 'is-section-lifted',
      fadeGhost: 'is-drop-indicator-fade-ghost',
      liftBackdrop: LIFT_BACKDROP_CLASS,
      dropPreviewBelow: 'is-drop-preview-below',
    },
    measureLiftGaps: (item) => ({
      top: getComputedStyle(item).marginTop || '0px',
      bottom: '0px',
    }),
    // Tapico spaces via margin-top. Put that margin on the indicator itself
    // (not --gap-top) so collapse matches the live section and the dashed
    // body lines up with the border box. Internal rails stay at 0.
    get initialPlacementKey() {
      return activeIntroDrag ? SOURCE_PLACEMENT_KEY : '';
    },
    measureInsertGaps: (insertIndex, sourceIndex, liftGaps, placementKey) => {
      const remaining = (grabSpacingSnapshot ?? []).filter((section) => section !== dragItem);
      const destinationNext = remaining[insertIndex];
      const movedAway = activeIntroDrag
        ? placementKey !== SOURCE_PLACEMENT_KEY
        : insertIndex !== sourceIndex;
      const destinationGap = destinationNext
        ? sourceGapPreview?.element === destinationNext && movedAway
          ? sourceGapPreview.marginTop
          : (grabMarginSnapshot.get(destinationNext) ?? getComputedStyle(destinationNext).marginTop)
        : 'var(--space-related)';
      return {
        top: '0px',
        bottom: '0px',
        marginTop: !movedAway
          ? liftGaps.top
          : insertIndex === 0
            ? '0px'
            : !destinationNext || (activeIntroDrag && placementKey === GAP_BEFORE_PLACEMENT_KEY)
              ? 'var(--space-related)'
              : destinationGap,
      };
    },
    resolveInsertPlacement: ({ items, centerY, currentIndex, currentKey, sourceIndex, direction, slot }) => {
      if (!activeIntroDrag) {
        let target = resolveInsertIndexFromY(items, centerY, currentIndex, direction);
        const full = getSectionRootsInDomOrder(dropZone()).filter((el) => !isChromeNode(el));
        for (let i = 0; i < full.length;) {
          if (full[i].dataset.devIntro !== 'true') { i += 1; continue; }
          const run = [];
          while (i < full.length && full[i].dataset.devIntro === 'true') run.push(full[i++]);
          const positions = run.map((el) => items.indexOf(el)).filter((index) => index >= 0);
          if (!positions.length) continue;
          const start = Math.min(...positions);
          const end = Math.max(...positions) + 1;
          if (target > start && target < end) {
            if (direction < 0) target = start;
            else if (direction > 0) target = end;
            else {
              const midpoint = (run[0].getBoundingClientRect().top + run.at(-1).getBoundingClientRect().bottom) / 2;
              target = centerY < midpoint ? start : end;
            }
          }
        }
        return { index: target };
      }

      const slotRect = slot?.getBoundingClientRect();
      const currentGapSide = currentKey === SOURCE_PLACEMENT_KEY
        ? sourceGapPlacementSide
        : currentKey === GAP_BEFORE_PLACEMENT_KEY
          ? 'before'
          : currentKey === GAP_AFTER_PLACEMENT_KEY
            ? 'after'
            : null;
      if (slotRect && currentGapSide) {
        const previousBottom = items[currentIndex - 1]?.getBoundingClientRect().bottom;
        const nextTop = items[currentIndex]?.getBoundingClientRect().top;
        const gapTop = currentGapSide === 'before' ? slotRect.bottom : previousBottom;
        const gapBottom = currentGapSide === 'before' ? nextTop : slotRect.top;
        if (gapTop !== undefined && gapBottom !== undefined && gapBottom > gapTop) {
          const nextSide = resolveGapLaneSide(
            gapTop,
            gapBottom,
            centerY,
            direction,
            currentGapSide,
          );
          if (nextSide !== currentGapSide) {
            return {
              index: currentIndex,
              key: nextSide === 'before'
                ? GAP_BEFORE_PLACEMENT_KEY
                : GAP_AFTER_PLACEMENT_KEY,
            };
          }
        }
      }

      const target = resolveInsertIndexFromY(items, centerY, currentIndex, direction);
      if (currentKey === SOURCE_PLACEMENT_KEY && target === sourceIndex) {
        return { index: target, key: SOURCE_PLACEMENT_KEY };
      }
      if (activeIntroDrag && target === sourceIndex) {
        return { index: target, key: SOURCE_PLACEMENT_KEY };
      }
      if (target <= 0) return { index: 0, key: START_PLACEMENT_KEY };
      if (target >= items.length) return { index: items.length, key: END_PLACEMENT_KEY };
      if (target !== currentIndex) {
        const previousRect = items[target - 1]?.getBoundingClientRect();
        const nextRect = items[target]?.getBoundingClientRect();
        const initialSide = direction < 0 ? 'after' : 'before';
        const gapSide = previousRect && nextRect && nextRect.top > previousRect.bottom
          ? resolveGapLaneSide(
              previousRect.bottom,
              nextRect.top,
              centerY,
              direction,
              initialSide,
            )
          : initialSide;
        return {
          index: target,
          key: gapSide === 'before' ? GAP_BEFORE_PLACEMENT_KEY : GAP_AFTER_PLACEMENT_KEY,
        };
      }

      return {
        index: currentIndex,
        key: currentKey || (direction < 0 ? GAP_AFTER_PLACEMENT_KEY : GAP_BEFORE_PLACEMENT_KEY),
      };
    },
    onSlotSync: (indicator, insertIndex, placementKey) => {
      activePlacementKey = placementKey;
      const movedAway = activeIntroDrag
        ? placementKey !== SOURCE_PLACEMENT_KEY
        : insertIndex !== activeSourceIndex;
      indicator.classList.toggle('project-block--intro', activeIntroDrag);
      if (activeIntroDrag) {
        indicator.dataset.devIntroHeightValue = dragItem?.dataset.devIntroHeightValue || '75';
      } else {
        delete indicator.dataset.devIntroHeightValue;
      }
      indicator.toggleAttribute(
        'data-dev-section-insert-at-start',
        movedAway && insertIndex === 0,
      );
      indicator.removeAttribute('data-dev-section-preserved-gap-dirty');
      indicator.style.removeProperty('--dev-section-preserved-gap-height');
      if (destinationGapPreview?.suppressDirty) {
        destinationGapPreview.element.classList.remove('is-dev-gap-preview-suppressed');
      }
      if (destinationGapPreview?.previousValue) {
        destinationGapPreview.element.style.setProperty(
          'margin-top',
          destinationGapPreview.previousValue,
          destinationGapPreview.previousPriority,
        );
      } else {
        destinationGapPreview?.element.style.removeProperty('margin-top');
      }
      destinationGapPreview = null;

      if (sourceGapPreview && sourceGapPreview.applied !== movedAway) {
        if (movedAway) {
          sourceGapPreview.element.style.setProperty(
            'margin-top',
            sourceGapPreview.marginTop,
            'important',
          );
          if (sourceGapPreview.suppressDirty) {
            sourceGapPreview.element.classList.add('is-dev-gap-preview-suppressed');
          }
        } else if (sourceGapPreview.previousValue) {
          sourceGapPreview.element.style.setProperty(
            'margin-top',
            sourceGapPreview.previousValue,
            sourceGapPreview.previousPriority,
          );
        } else {
          sourceGapPreview.element.style.removeProperty('margin-top');
        }
        if (!movedAway && sourceGapPreview.suppressDirty) {
          sourceGapPreview.element.classList.remove('is-dev-gap-preview-suppressed');
        }
        sourceGapPreview.applied = movedAway;
      }

      const remaining = (grabSpacingSnapshot ?? []).filter((section) => section !== dragItem);
      const destinationNext = movedAway ? remaining[insertIndex] : null;
      let sourceGapOwner = movedAway || sourceGapIndicatorStartsAfterSource
        ? sourceGapPreview?.element
        : indicator;
      const insertsAfterGap = !activeIntroDrag || placementKey !== GAP_BEFORE_PLACEMENT_KEY;
      if (destinationNext && insertsAfterGap) {
        const preserveDestinationGap = insertIndex > 0;
        const suppressDirty = destinationNext.classList.contains('is-dev-spacing-dirty');
        const sourceGapMovesToSlot = Boolean(
          preserveDestinationGap
          && sourceGapIndicator
          && sourceGapPreview?.element === destinationNext,
        );
        destinationGapPreview = {
          element: destinationNext,
          previousValue: destinationNext.style.getPropertyValue('margin-top'),
          previousPriority: destinationNext.style.getPropertyPriority('margin-top'),
          suppressDirty,
        };
        if (suppressDirty) destinationNext.classList.add('is-dev-gap-preview-suppressed');
        if (preserveDestinationGap && suppressDirty && !sourceGapMovesToSlot) {
          indicator.setAttribute('data-dev-section-preserved-gap-dirty', '');
          indicator.style.setProperty(
            '--dev-section-preserved-gap-height',
            sourceGapPreview?.element === destinationNext
              ? sourceGapPreview.marginTop
              : (grabMarginSnapshot.get(destinationNext) ?? getComputedStyle(destinationNext).marginTop),
          );
        }
        if (sourceGapMovesToSlot) sourceGapOwner = indicator;
        destinationNext.style.setProperty('margin-top', 'var(--space-related)', 'important');
      }
      if (sourceGapIndicator && sourceGapOwner) {
        sourceGapIndicatorFollowsSlot = sourceGapOwner === indicator;
        if (activeIntroDrag && movedAway && sourceGapPreview?.element.parentElement) {
          // Keep the source marker in the page stack. Nesting it in the adjacent
          // text block constrains its 75vh card to that block's narrow track.
          sourceGapPreview.element.before(sourceGapIndicator);
          sourceGapIndicatorFollowsSlot = false;
        } else {
          sourceGapOwner.append(sourceGapIndicator);
        }
      }
    },
    onSlotLayout: (indicator) => {
      if (indicator.isConnected) setIntroFoldOffsets();
    },
  });

  const removeLiftBackdrop = () => {
    liftBackdrop?.remove();
    liftBackdrop = null;
    dragItem?.querySelector(`.${LIFT_BACKDROP_CLASS}`)?.remove();
  };

  const removeSourceGapIndicator = () => {
    sourceGapIndicatorInitialOwner?.classList.remove('is-dev-gap-preview-suppressed');
    preservedGapPaintOwner?.classList.remove('is-dev-gap-preview-suppressed');
    sourceGapIndicator?.remove();
    sourceGapIndicator = null;
    sourceGapIndicatorFollowsSlot = false;
    sourceGapIndicatorStartsAfterSource = false;
    sourceGapIndicatorInitialOwner = null;
    preservedGapPaintOwner = null;
  };

  const clearSourceGapPreview = (preserveIndicator = false) => {
    if (!preserveIndicator) removeSourceGapIndicator();
    else {
      sourceGapIndicatorInitialOwner?.classList.remove('is-dev-gap-preview-suppressed');
      sourceGapIndicatorInitialOwner = null;
      sourceGapIndicatorStartsAfterSource = false;
    }
    if (destinationGapPreview?.suppressDirty) {
      destinationGapPreview.element.classList.remove('is-dev-gap-preview-suppressed');
    }
    if (destinationGapPreview?.previousValue) {
      destinationGapPreview.element.style.setProperty(
        'margin-top',
        destinationGapPreview.previousValue,
        destinationGapPreview.previousPriority,
      );
    } else {
      destinationGapPreview?.element.style.removeProperty('margin-top');
    }
    destinationGapPreview = null;
    if (sourceGapPreview?.suppressDirty) {
      sourceGapPreview.element.classList.remove('is-dev-gap-preview-suppressed');
    }
    if (sourceGapPreview?.previousValue) {
      sourceGapPreview.element.style.setProperty(
        'margin-top',
        sourceGapPreview.previousValue,
        sourceGapPreview.previousPriority,
      );
    } else {
      sourceGapPreview?.element.style.removeProperty('margin-top');
    }
    sourceGapPreview = null;
    sourceGapPlacementSide = null;
    grabMarginSnapshot.clear();
    activePlacementKey = '';
    setIntroFoldOffsets();
  };

  const prepareSourceGapPreview = (
    root: HTMLElement,
    sections: HTMLElement[],
    sourceIndex: number,
  ) => {
    clearSourceGapPreview();
    const previous = sections[sourceIndex - 1];
    const next = sections[sourceIndex + 1];
    if (!next) return;

    const rootGap = Number.parseFloat(getComputedStyle(root).marginTop) || 0;
    const nextGap = Number.parseFloat(getComputedStyle(next).marginTop) || 0;
    const rootDirty = root.classList.contains('is-dev-spacing-dirty');
    const nextDirty = next.classList.contains('is-dev-spacing-dirty');
    const sourceGapWins = !previous || shouldKeepLeadingSpacingSeam(
      rootGap,
      nextGap,
      rootDirty,
      nextDirty,
    );
    const winningGapOwner = sourceGapWins ? root : next;
    sourceGapPlacementSide = sourceGapWins ? 'after' : 'before';
    const height = previous
      ? Math.max(rootGap, nextGap)
      : 0;
    sourceGapPreview = {
      element: next,
      marginTop: `${Math.max(0, height)}px`,
      previousValue: next.style.getPropertyValue('margin-top'),
      previousPriority: next.style.getPropertyPriority('margin-top'),
      applied: false,
      suppressDirty: sourceGapWins && nextDirty,
    };

    if (
      !previous
      || height <= 0
      || !winningGapOwner.classList.contains('is-dev-spacing-dirty')
      || winningGapOwner.dataset.devSpacingValue === 'none'
    ) return;

    sourceGapIndicator = document.createElement('div');
    sourceGapIndicator.className = SOURCE_GAP_INDICATOR_CLASS;
    sourceGapIndicator.setAttribute('aria-hidden', 'true');
    sourceGapIndicator.style.height = `${height}px`;
    sourceGapIndicatorStartsAfterSource = !sourceGapWins;
    sourceGapIndicatorInitialOwner = winningGapOwner;
    winningGapOwner.classList.add('is-dev-gap-preview-suppressed');
  };

  const commitReorderSpacing = (root: HTMLElement | null, preserveIndicator = false) => {
    const before = grabSpacingSnapshot;
    grabSpacingSnapshot = null;
    if (!before || !root) {
      clearSourceGapPreview(preserveIndicator);
      return;
    }

    const members = new Set(before);
    const after = getSectionRootsInDomOrder(dropZone()).filter((section) => members.has(section));
    const orderChanged = before.some((section, index) => section !== after[index]);
    const seamChanged = activeIntroDrag
      && activePlacementKey !== ''
      && activePlacementKey !== SOURCE_PLACEMENT_KEY;
    if (orderChanged || seamChanged) {
      window.dispatchEvent(new CustomEvent('vcd:dev-section-reordered', {
        detail: {
          document: root.dataset.devSpacingDocument || documentKey,
          moved: root,
          before,
          after,
          destinationSide: activePlacementKey === GAP_BEFORE_PLACEMENT_KEY
            ? 'before'
            : 'after',
        },
      }));
    }
    clearSourceGapPreview(preserveIndicator);
    if (preserveIndicator) {
      const owner = sourceGapIndicator?.parentElement;
      if (owner && !owner.classList.contains(DROP_INDICATOR_CLASS)) {
        preservedGapPaintOwner = owner;
        owner.classList.add('is-dev-gap-preview-suppressed');
      }
    }
  };

  const attachLiftBackdrop = (root: HTMLElement) => {
    removeLiftBackdrop();
    liftBackdrop = document.createElement('div');
    liftBackdrop.className = LIFT_BACKDROP_CLASS;
    liftBackdrop.setAttribute('aria-hidden', 'true');
    root.prepend(liftBackdrop);
    // Next frame so opacity 0 → 1 transitions (same beat as is-lifted-raised).
    pageScope.frame(() => {
      liftBackdrop?.classList.add(LIFT_BACKDROP_VISIBLE_CLASS);
    });
  };

  const fadeOutLiftBackdrop = () => {
    const el = liftBackdrop ?? dragItem?.querySelector<HTMLElement>(`.${LIFT_BACKDROP_CLASS}`) ?? null;
    if (!el) return Promise.resolve();

    el.classList.remove(LIFT_BACKDROP_VISIBLE_CLASS);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.remove();
      if (liftBackdrop === el) liftBackdrop = null;
      return Promise.resolve();
    }

    return new Promise<void>((resolve) => {
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        el.remove();
        if (liftBackdrop === el) liftBackdrop = null;
        resolve();
      };
      pageScope.listen(el, 'transitionend', finish, { once: true });
      pageScope.timeout(finish, LIFT_BACKDROP_FADE_MS + 50);
    });
  };

  const setSectionDragging = (active: boolean) => {
    const page = document.documentElement;
    const controlsAlreadySettling = page.classList.contains(SECTION_CONTROLS_SETTLING_CLASS);
    window.cancelAnimationFrame(controlsRevealFrame);
    controlsRevealFrame = 0;
    if (active) {
      page.classList.remove(SECTION_CONTROLS_REVEAL_CLASS);
      page.classList.remove(SECTION_CONTROLS_SETTLING_CLASS);
    }
    const shouldReveal = !active
      && page.classList.contains(SECTION_DRAGGING_CLASS)
      && !controlsAlreadySettling
      && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (shouldReveal) page.classList.add(SECTION_CONTROLS_REVEAL_CLASS);
    else if (!active) page.classList.remove(SECTION_CONTROLS_REVEAL_CLASS);
    page.classList.toggle(SECTION_DRAGGING_CLASS, active);
    if (!active) {
      page.classList.remove(SECTION_CONTROLS_SETTLING_CLASS);
      page.classList.remove(SECTION_HOLDING_CLASS);
      window.dispatchEvent(new Event('vcd:intro-layout-sync'));
      if (shouldReveal) {
        controlsRevealFrame = pageScope.frame(() => {
          controlsRevealFrame = pageScope.frame(() => {
            controlsRevealFrame = 0;
            page.classList.remove(SECTION_CONTROLS_REVEAL_CLASS);
          });
        });
      }
    }
    if (active) {
      document.querySelector('.site-header')?.classList.toggle(
        'is-scrolled-hidden',
        window.scrollY > 8,
      );
    }
  };

  const setSectionHolding = (active: boolean) => {
    document.documentElement.classList.toggle(SECTION_HOLDING_CLASS, active);
  };

  const pinSectionControls = (root: HTMLElement) => {
    root.classList.add('is-dev-section-controls-visible');
  };

  /** Pin persists through an active drag/drop session — everything else unpins on leave. */
  const unpinSectionControls = (root: HTMLElement | null) => {
    if (!root) return;
    if (root.classList.contains('is-section-lifted-session')) return;
    root.classList.remove('is-dev-section-controls-visible');
  };

  const releaseSessionRoot = (root: HTMLElement | null) => {
    if (!root) return;
    root.classList.remove('is-section-lifted-session');
    root.style.pointerEvents = '';
    unpinSectionControls(root);
  };

  const clearHostLiftChrome = () => {
    removeLiftBackdrop();
    getSectionRootsInDomOrder(dropZone()).forEach((item) => {
      if (!isChromeNode(item)) item.classList.remove('is-section-drop-target');
    });
    dragItem?.classList.remove('is-section-dragging');
  };

  const enterLift = (
    root: HTMLElement,
    handle: HTMLButtonElement,
    pointerId: number,
    x: number,
    y: number,
  ) => {
    // A settling block is still grabbable: the same handle catches it mid-drop
    // and lifts it again from where it is; another block's handle lands the
    // settling one in its slot right away and lifts the new one. Only a block
    // that is actively held (not settling) blocks a second lift.
    const previous = dragItem;
    let resumed = false;
    if (controller.isActive()) {
      if (root === previous) {
        if (!controller.resumeLift(root, handle, x, y)) return;
        resumed = true;
      } else if (!controller.settleNow()) {
        return;
      } else {
        commitReorderSpacing(previous);
        syncPending();
        releaseSessionRoot(previous);
      }
    }

    dragItem = root;
    dragHandle = handle;
    dragPointerId = pointerId;
    sessionButtonDown = true;
    sessionSeq += 1;
    activeSessionId = sessionSeq;

    grabOrderSnapshot = captureSectionOrder(dropZone());
    grabNodeSnapshot = [...(dropZone()?.childNodes ?? [])];

    try {
      handle.setPointerCapture(pointerId);
    } catch {
      // Document listeners still track pointer position.
    }

    if (!resumed) {
      const sections = getSectionRootsInDomOrder(dropZone()).filter((el) => !isChromeNode(el));
      activeIntroDrag = root.dataset.devIntro === 'true';
      if (activeIntroDrag) {
        const all = sections;
        const at = all.indexOf(root);
        let start = at;
        let end = at;
        while (start > 0 && all[start - 1].dataset.devIntro === 'true') start -= 1;
        while (end + 1 < all.length && all[end + 1].dataset.devIntro === 'true') end += 1;
        activeItems = all.slice(start, end + 1);
      } else {
        activeItems = sections;
      }
      grabSpacingSnapshot = [...activeItems];
      let sourceIndex = activeItems.indexOf(root);
      if (sourceIndex < 0) sourceIndex = 0;
      activeSourceIndex = sourceIndex;

      prepareSourceGapPreview(root, activeItems, sourceIndex);
      grabMarginSnapshot = new Map(
        activeItems.map((section) => [section, getComputedStyle(section).marginTop]),
      );
      controller.beginLift(root, handle, x, y, sourceIndex);
      attachLiftBackdrop(root);
    }

    pinSectionControls(root);
    getSectionRootsInDomOrder(dropZone()).forEach((section) => {
      if (isChromeNode(section) || section === root) return;
      section.classList.remove('is-dev-section-controls-visible');
    });
    setSectionDragging(true);
    setSectionHolding(true);
    root.classList.add('is-section-lifted-session');
    bindSessionPointerListeners();
  };

  const finishPointerSession = async () => {
    if (!dragItem || droppingSessionId === activeSessionId) return;
    if (!controller.isActive() && !sessionButtonDown) return;

    const root = dragItem;
    const sessionId = activeSessionId;
    sessionButtonDown = false;
    // Open the fist immediately — settle / card fade can keep running.
    setSectionHolding(false);
    const releaseState = controller.getState();
    if (
      releaseState.placedIndex === releaseState.sourceIndex
      && (!activeIntroDrag || releaseState.placedKey === SOURCE_PLACEMENT_KEY)
    ) {
      document.documentElement.classList.add(SECTION_CONTROLS_SETTLING_CLASS);
    }
    unbindSessionPointerListeners();

    if (dragHandle && dragPointerId != null) {
      try {
        dragItem?.releasePointerCapture(dragPointerId);
      } catch {
        // Pointer may already be released.
      }
      try {
        dragHandle.releasePointerCapture(dragPointerId);
      } catch {
        // Pointer may already be released.
      }
    }

    droppingSessionId = sessionId;
    try {
      if (controller.isActive()) {
        await controller.endDrop();
      }
      // A re-grab (mid-settle or during the fade) owns the lift chrome now —
      // leave its card alone and only publish the order this session committed.
      if (sessionId === activeSessionId) {
        if (sourceGapIndicatorFollowsSlot && sourceGapIndicator && !sourceGapIndicator.isConnected) {
          root.append(sourceGapIndicator);
        }
        commitReorderSpacing(root, true);
        // Card stays visible through the settle; fade it only after it lands.
        await fadeOutLiftBackdrop();
      }
      if (sessionId === activeSessionId) {
        clearHostLiftChrome();
        grabOrderSnapshot = null;
        grabNodeSnapshot = null;
        grabSpacingSnapshot = null;
      }
      syncPending();
    } finally {
      if (droppingSessionId === sessionId) droppingSessionId = 0;
      if (sessionId === activeSessionId) {
        setSectionDragging(false);
        releaseSessionRoot(root);
        removeSourceGapIndicator();
        dragItem = null;
        dragHandle = null;
        dragPointerId = null;
        activeItems = null;
        activeIntroDrag = false;
      }
    }
  };

  const onSessionPointerUp = (event: PointerEvent) => {
    if (!sessionButtonDown || !dragItem) return;
    if (dragPointerId !== null && event.pointerId !== dragPointerId) return;
    void finishPointerSession();
  };

  const onSessionMouseUp = (event: MouseEvent) => {
    if (!sessionButtonDown || !dragItem) return;
    if (event.button !== 0) return;
    void finishPointerSession();
  };

  const bindSessionPointerListeners = () => {
    if (sessionPointerActive) return;
    sessionPointerActive = true;
    pageScope.listen(document, 'pointerup', onSessionPointerUp, { capture: true });
    pageScope.listen(document, 'mouseup', onSessionMouseUp, { capture: true });
  };

  const unbindSessionPointerListeners = () => {
    if (!sessionPointerActive) return;
    sessionPointerActive = false;
    document.removeEventListener('pointerup', onSessionPointerUp, { capture: true });
    document.removeEventListener('mouseup', onSessionMouseUp, { capture: true });
  };

  pageScope.listen(document, 'pointermove', (event) => {
    controller.setPointer(event.clientX, event.clientY);
  }, { capture: true, passive: true });

  pageScope.listen(document, 'mousemove', (event) => {
    controller.setPointer(event.clientX, event.clientY);
  }, { capture: true, passive: true });

  const wireSectionControlHover = (root: HTMLElement) => {
    if (root.dataset.devSectionControlsWired === 'true') return;
    root.dataset.devSectionControlsWired = 'true';
    pageScope.listen(root, 'mouseenter', () => pinSectionControls(root));
    pageScope.listen(root, 'mouseleave', () => unpinSectionControls(root));
  };

  const wireDragHandle = (root: HTMLElement, handle: HTMLButtonElement) => {
    if (handle.dataset.devSectionDragWired === 'true') return;
    handle.dataset.devSectionDragWired = 'true';

    pageScope.listen(handle, 'click', (event) => event.preventDefault());

    pageScope.listen(handle, 'pointerdown', (event) => {
      if (!reorderActive) return;
      if (event.button !== 0) return;

      enterLift(root, handle, event.pointerId, event.clientX, event.clientY);
      event.preventDefault();
    });
  };

  /** Prefer the crop/media frame so the handle tracks the visible box, not captions. */
  const cropFrameForHandle = (root: HTMLElement): HTMLElement => {
    const media = (
      root.classList.contains('project-cropped')
      || root.classList.contains('project-media')
      || root.classList.contains('project-image')
    )
      ? root
      : root.querySelector<HTMLElement>(
        ':scope > .project-cropped, :scope > .project-media, :scope > figure.project-media',
      ) ?? root;

    // A below-image caption lives inside the figure, so the figure box is taller
    // than the picture. Anchor to the crop frame so controls sit beside the
    // image rather than beside the image-plus-caption.
    return media.querySelector<HTMLElement>(':scope > .project-crop-clip') ?? media;
  };

  /** Media element → its section root, so frame resizes can re-anchor the section. */
  const anchorFrameOwners = new WeakMap<HTMLElement, HTMLElement>();

  /**
   * Publish the media box on the section root as custom properties.
   *
   * Section chrome (drag handle, delete) is positioned against the section,
   * which spans the full column. But a block *is* its image: constrain the width
   * or cap the height and the media becomes narrower than the column, leaving the
   * controls stranded out in the margin. These vars let them track the media —
   * and the caption already does, since it lives inside the figure.
   */
  const syncDragHandleAnchor = (root: HTMLElement) => {
    const handle = root.querySelector<HTMLButtonElement>(`:scope > [${DRAG_HANDLE_ATTR}]`);
    const frame = cropFrameForHandle(root);

    if (frame === root) {
      handle?.style.removeProperty('top');
      root.style.removeProperty('--dev-section-anchor-y');
      root.style.removeProperty('--dev-section-inset');
      root.style.removeProperty('--dev-section-inset-end');
      return;
    }

    const rootRect = root.getBoundingClientRect();
    const frameRect = frame.getBoundingClientRect();

    // Vertical centre of the media, not of the section — a below-caption adds
    // height that the controls should not be centred on.
    root.style.setProperty(
      '--dev-section-anchor-y',
      `${Math.round(frameRect.top - rootRect.top + frameRect.height / 2)}px`,
    );
    // Left and right measured separately: constrained media is centred today,
    // but this stays correct if a block is ever aligned to one edge.
    const insetStart = Math.max(0, Math.round(frameRect.left - rootRect.left));
    const insetEnd = Math.max(0, Math.round(rootRect.right - frameRect.right));
    root.style.setProperty('--dev-section-inset', `${insetStart}px`);
    root.style.setProperty('--dev-section-inset-end', `${insetEnd}px`);

    // The section is always full width, so only the frame resizing signals a
    // change (e.g. switching max view height). Observe it too.
    if (!anchorFrameOwners.has(frame)) {
      anchorFrameOwners.set(frame, root);
      handleAnchorObserver?.observe(frame);
    }
  };

  const handleAnchorObserver = typeof ResizeObserver !== 'undefined'
    ? new ResizeObserver((entries) => {
      entries.forEach((entry) => {
        const target = entry.target;
        if (!(target instanceof HTMLElement)) return;
        syncDragHandleAnchor(anchorFrameOwners.get(target) ?? target);
      });
    })
    : null;

  const mountDragHandle = (root: HTMLElement) => {
    let bridge = root.querySelector<HTMLElement>(`.${DRAG_BRIDGE_CLASS}`);
    if (!bridge) {
      bridge = document.createElement('div');
      bridge.className = DRAG_BRIDGE_CLASS;
      bridge.setAttribute('aria-hidden', 'true');
      root.prepend(bridge);
    }

    let handle = root.querySelector<HTMLButtonElement>(`[${DRAG_HANDLE_ATTR}]`);
    if (!handle) {
      handle = createSectionReorderHandle(document);
      root.append(handle);
    }

    root.setAttribute('data-dev-section-reorderable', '');
    handle.tabIndex = -1;
    wireSectionControlHover(root);
    wireDragHandle(root, handle);
    syncDragHandleAnchor(root);
    handleAnchorObserver?.observe(root);
  };

  const syncDragHandles = () => {
    const zone = dropZone();
    if (!zone) return;

    if (!documentKey) {
      const first = getSectionRootsInDomOrder(zone).find((el) => !isChromeNode(el));
      documentKey = first?.dataset.devSpacingDocument || zone.dataset.pageDocument || '';
    }

    ensureSectionOrderIds(zone);
    getSectionRootsInDomOrder(dropZone()).forEach((root) => {
      if (isChromeNode(root)) return;
      mountDragHandle(root);
      root.toggleAttribute('data-dev-section-reorderable', reorderActive);
      const handle = root.querySelector<HTMLButtonElement>(`[${DRAG_HANDLE_ATTR}]`);
      if (handle) {
        handle.hidden = !reorderActive;
        handle.tabIndex = -1;
      }
      syncDragHandleAnchor(root);
    });

  };

  const abortActiveSession = () => {
    if (!controller.isActive() && !dragItem) return;
    const root = dragItem;
    // Retire the session so an in-flight drop tail can't tear down after us.
    activeSessionId = 0;
    droppingSessionId = 0;
    sessionButtonDown = false;
    setSectionHolding(false);
    unbindSessionPointerListeners();
    if (grabNodeSnapshot) restoreNodeOrder(grabNodeSnapshot);
    else if (grabOrderSnapshot) restoreDomOrder(grabOrderSnapshot);
    controller.destroy();
    clearSourceGapPreview();
    clearHostLiftChrome();
    if (root) {
      root.classList.remove('is-section-lifted-session');
      root.style.pointerEvents = '';
    }
    setSectionDragging(false);
    dragItem = null;
    dragHandle = null;
    dragPointerId = null;
    grabOrderSnapshot = null;
    grabNodeSnapshot = null;
    grabSpacingSnapshot = null;
    activeItems = null;
    activeIntroDrag = false;
  };

  const setReorderActive = (active: boolean, preserveBaseline = false) => {
    reorderActive = active;
    if (active) {
      syncDragHandles();
      if (!baselineOrder) {
        baselineOrder = baselineOrders.get(documentKey) ?? captureSectionOrder(dropZone());
        if (documentKey) baselineOrders.set(documentKey, baselineOrder);
      }
    } else {
      abortActiveSession();

    }
    syncDragHandles();
  };

  const onDevModeChange = () => {
    if (document.documentElement.classList.contains('show-section-nav-editor')) {
      reorderSuspendedForSectionNav = true;
      setReorderActive(false, true);
      return;
    }
    const exposed = getDropZone();
    const exposedKey = exposed?.dataset.pageDocument || exposed?.querySelector<HTMLElement>('[data-dev-spacing-document]')?.dataset.devSpacingDocument || '';
    if (exposedKey !== documentKey) {
      if (documentKey && baselineOrder) baselineOrders.set(documentKey, baselineOrder);
      documentKey = exposedKey;
      baselineOrder = baselineOrders.get(documentKey) ?? null;
    }
    const active = isDevContentEditing() && Boolean(dropZone());
    const preserveBaseline = reorderSuspendedForSectionNav;
    reorderSuspendedForSectionNav = false;
    setReorderActive(active, preserveBaseline);
  };

  pageScope.listen(window, 'vcd:dev-mode-change', onDevModeChange);
  const onPageSurfaceChange = ((event: CustomEvent<{ documentKey?: string; document?: string }>) => {
    const previousZone = dropZone();
    if (documentKey && baselineOrder) baselineOrders.set(documentKey, baselineOrder);
    abortActiveSession();
    const requested = event.detail?.documentKey || event.detail?.document || '';
    const zone = getDropZone(requested || undefined);
    const first = zone && getSectionRootsInDomOrder(zone).find((el) => !isChromeNode(el));
    documentKey = requested || first?.dataset.devSpacingDocument || zone?.dataset.pageDocument || '';
    if (previousZone === zone) return;
    baselineOrder = baselineOrders.get(documentKey) ?? null;
    if (reorderActive) {
      syncDragHandles();
      if (!baselineOrder) {
        baselineOrder = captureSectionOrder(dropZone());
        baselineOrders.set(documentKey, baselineOrder);
      }
    }
  }) as EventListener;
  pageScope.listen(window, 'vcd:page-surface-change', onPageSurfaceChange);
  pageScope.listen(window, 'vcd:section-nav-editor-change', () => {
    const sectionNavEditor = document.documentElement.classList.contains('show-section-nav-editor');
    if (sectionNavEditor) {
      reorderSuspendedForSectionNav = true;
      setReorderActive(false, true);
      return;
    }
    const wasSuspended = reorderSuspendedForSectionNav;
    reorderSuspendedForSectionNav = false;
    if (wasSuspended) setReorderActive(isDevContentEditing() && Boolean(dropZone()), true);
  });
  pageScope.listen(window, 'vcd:dev-section-structure-changed', ((event: CustomEvent<{ document?: string }>) => {
    if (!reorderActive) return;
    if (event.detail?.document && event.detail.document !== documentKey) return;
    syncDragHandles();

    // An insert or delete renumbers every section after it, which invalidates
    // both halves of the pending reorder: the baseline it is diffed against and
    // the snapshot payload itself. Leaving them stale is what made Save fail
    // with "Section order does not match the document" — the payload still
    // described a document one section shorter than the one on disk.
    //
    // Order ids are JSON indices, so the document's own order is simply those
    // ids ascending. Re-derive the baseline that way rather than recapturing
    // DOM order, which is the *edited* order whenever a reorder is pending.
    const zone = dropZone();
    if (!zone) return;
    baselineOrder = [...captureSectionOrder(zone)].sort((a, b) => a - b);
    baselineOrders.set(documentKey, baselineOrder);
    syncPending();
  }) as EventListener);

  /**
   * Re-anchor when a tuner reshapes a frame. The ResizeObserver covers passive
   * layout changes, but not a crop clip created mid-session (live-first crop) —
   * that node is new and unobserved until the next sync. Editors announce frame
   * changes here so the chrome never lags the image it belongs to.
   */
  pageScope.listen(window, 'vcd:dev-frame-changed', ((event: CustomEvent<{ target?: HTMLElement }>) => {
    const scope = event.detail?.target?.closest<HTMLElement>('[data-dev-spacing-document], .project-block');
    if (scope) {
      syncDragHandleAnchor(scope);
      return;
    }
    getSectionRootsInDomOrder(dropZone()).forEach((root) => {
      if (!isChromeNode(root)) syncDragHandleAnchor(root);
    });
  }) as EventListener);

  pageScope.listen(window, 'resize', () => {
    getSectionRootsInDomOrder(dropZone()).forEach((root) => {
      if (!isChromeNode(root)) syncDragHandleAnchor(root);
    });
  });

  pageScope.listen(window, 'vcd:dev-pending-committed', ((event: CustomEvent<{ ids?: string[] }>) => {
    const zone = dropZone();
    if (!zone) return;
    const ids = event.detail?.ids;
    if (ids && !ids.includes(`section-order:${documentKey}`)) return;
    baselineOrder = captureSectionOrder(zone);
    baselineOrders.set(documentKey, baselineOrder);
    zone.classList.remove('is-section-order-dirty');
  }) as EventListener);

  pageScope.listen(window, 'vcd:dev-pending-reverted', () => {
    dropZone()?.classList.remove('is-section-order-dirty');
    if (reorderActive) {
      baselineOrder = captureSectionOrder(dropZone());
      syncDevSectionOutlineSidebar();
    }
  });

  pageScope.listen(document, 'keydown', (event) => {
    if (!reorderActive || event.key !== 'Escape') return;
    if (!controller.isActive() && !dragItem) return;
    event.preventDefault();
    abortActiveSession();
  });

  onDevModeChange();
  return () => {
    abortActiveSession();
    controller.destroy();
    unbindSessionPointerListeners();
    handleAnchorObserver?.disconnect();
    document.querySelectorAll<HTMLElement>(`[${DRAG_HANDLE_ATTR}]`).forEach((handle) => delete handle.dataset.devSectionDragWired);
    document.querySelectorAll<HTMLElement>('[data-dev-section-controls-wired]').forEach((root) => delete root.dataset.devSectionControlsWired);
    clearSourceGapPreview();
    clearHostLiftChrome();
    setSectionDragging(false);
    setSectionHolding(false);
    removeLiftBackdrop();
    document.documentElement.classList.remove(SECTION_CONTROLS_REVEAL_CLASS, SECTION_CONTROLS_SETTLING_CLASS);
    pageScope.destroy();
  };
  });
  import.meta.hot?.dispose(disposePage);
</script>
