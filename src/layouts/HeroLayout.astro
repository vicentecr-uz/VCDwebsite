---
import type { ComponentProps } from 'astro/types';
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
import '../styles/project.css';

type Props = Pick<ComponentProps<typeof Layout>,
  'title' | 'description' | 'columnStyle' | 'canonicalUrl' | 'ogImage' | 'ogImageDetails' | 'favicon'
>;
---

<Layout persistentNavigation {...Astro.props}>
  <div data-page-shell class="project-page hero-page flex flex-col min-h-dvh">
    <main id="main-content" class="project-page__main flex-1">
      <slot />
    </main>
    <Footer />
  </div>
</Layout>
