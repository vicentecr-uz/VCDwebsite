---
import '../styles/global.css';

interface Props { title: string; captureAssets?: boolean; scrolling?: boolean; authoring?: boolean }
const { title, captureAssets = false, scrolling = false, authoring = false } = Astro.props;
const connections = captureAssets
  ? "'self' https://fonts.googleapis.com https://fonts.gstatic.com"
  : "'none'";
const policy = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: blob:",
  `connect-src ${import.meta.env.DEV ? `${captureAssets ? connections : authoring ? "'self'" : ''} ws:` : connections}`,
  "form-action 'none'",
  "object-src 'none'",
  "base-uri 'none'",
].join('; ');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={policy} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {scrolling ? <div class="demo-scroll-viewport">
      <main class="demo-page demo-page--scrolling" data-page-viewport><slot /></main>
    </div> : <main class="demo-page"><slot /></main>}
  </body>
</html>

<style>
  html, body {
    --section-lift-background: var(--comp-demo-frame-container);
    height: 100%;
    min-height: 100%;
    background: var(--comp-demo-frame-container);
  }

  html:has(.demo-page--scrolling),
  body:has(.demo-page--scrolling) {
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .demo-page {
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-height: 100%;
    padding: calc(var(--space-unit) * 4) calc(var(--space-unit) * 2);
  }

  .demo-page :global(.dev-panel) {
    width: 100%;
  }

  .demo-scroll-viewport {
    position: fixed;
    inset: 0;
    overflow: hidden;
    /* A stationary containing block keeps fixed drag lifts in the content mask. */
    transform: translateZ(0);
    mask-image: linear-gradient(to bottom,
      transparent 0.5rem,
      rgb(0 0 0 / 0.04) 0.8rem,
      rgb(0 0 0 / 0.18) 1.1rem,
      rgb(0 0 0 / 0.5) 1.5rem,
      rgb(0 0 0 / 0.82) 1.9rem,
      rgb(0 0 0 / 0.96) 2.2rem,
      black 2.5rem,
      black calc(100% - 2.5rem),
      rgb(0 0 0 / 0.96) calc(100% - 2.2rem),
      rgb(0 0 0 / 0.82) calc(100% - 1.9rem),
      rgb(0 0 0 / 0.5) calc(100% - 1.5rem),
      rgb(0 0 0 / 0.18) calc(100% - 1.1rem),
      rgb(0 0 0 / 0.04) calc(100% - 0.8rem),
      transparent calc(100% - 0.5rem));
  }

  .demo-page--scrolling {
    display: block;
    height: 100%;
    min-height: 0;
    padding-block: calc(var(--space-unit) * 5);
    overflow-x: hidden;
    overflow-y: auto;
    overflow-anchor: none;
  }

  .demo-page.demo-page--scrolling :global(.demo-controls) {
    position: fixed;
    z-index: 100;
    bottom: 3rem;
  }

  .demo-page :global(.demo-controls) {
    position: absolute;
    right: var(--space-unit);
    bottom: var(--space-unit);
    display: flex;
    gap: calc(var(--space-unit) * 2);
  }

  .demo-page :global(.demo-controls .dev-btn) {
    --dev-btn-hit-inset: 8px;
  }

  @media (pointer: coarse) {
    .demo-page :global(.demo-controls .dev-btn) { min-height: 44px; }
  }

  @media (max-width: 40em) {
    .demo-page { padding-inline: var(--space-unit); }
  }
</style>
