---
import '../styles/global.css';

interface Props { title: string; captureAssets?: boolean; scrolling?: boolean; authoring?: boolean }
const { title, captureAssets = false, scrolling = false, authoring = false } = Astro.props;
const connections = captureAssets ? "'self'" : "'none'";
const policy = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data: blob:",
  `connect-src ${import.meta.env.DEV ? `${captureAssets ? connections : authoring ? "'self'" : ''} ws:` : connections}`,
  "form-action 'none'",
  "object-src 'none'",
  "base-uri 'none'",
].join('; ');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={policy} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preload" href="/fonts/hanken-grotesk/normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/hanken-grotesk/hanken.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    {scrolling ? <main class="demo-page demo-page--scrolling"><slot /></main> : <main class="demo-page"><slot /></main>}
  </body>
</html>

<style>
  html, body {
    --section-lift-background: var(--comp-demo-frame-container);
    height: 100%;
    min-height: 100%;
    background: var(--comp-demo-frame-container);
  }

  html:has(.demo-page--scrolling) {
    overflow-y: auto;
    overscroll-behavior: auto;
  }

  body:has(.demo-page--scrolling) {
    overflow: visible;
    overscroll-behavior: auto;
  }

  .demo-page {
    position: relative;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-height: 100%;
    padding: calc(var(--space-unit) * 4) calc(var(--space-unit) * 2);
  }

  .demo-page :global(.dev-panel) {
    width: 100%;
  }

  .demo-page--scrolling {
    display: block;
    padding-block: calc(var(--space-unit) * 5);
    overflow-anchor: none;
  }

  .demo-page.demo-page--scrolling :global(.demo-controls) {
    position: fixed;
    z-index: 100;
    bottom: 3rem;
  }

  .demo-page :global(.demo-controls) {
    position: absolute;
    right: var(--space-unit);
    bottom: var(--space-unit);
    display: flex;
    gap: calc(var(--space-unit) * 2);
  }

  .demo-page :global(.demo-controls .dev-btn) {
    --dev-btn-hit-inset: 8px;
  }

  @media (pointer: coarse) {
    .demo-page :global(.demo-controls .dev-btn) { min-height: 44px; }
  }

  @media (max-width: 40em) {
    .demo-page { padding-inline: var(--space-unit); }
  }
</style>
