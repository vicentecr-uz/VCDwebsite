---
import '../styles/global.css';
import DevModeController from '../components/DevModeController.astro';
import DevTextEditor from '../components/DevTextEditor.astro';

interface Props {
  title: string;
  description?: string;
  /** Load EB Garamond (serif). Only pages that use --font-serif need this. */
  serif?: boolean;
}

const {
  title,
  description = 'Portfolio of Vicente Cruz — London-based industrial designer.',
  serif = false,
} = Astro.props;
const showDevTools = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800;900&display=swap" />
    {serif && (
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Safe-area overlay: covers browser chrome inset (Zen, Safari mobile) -->
    <div id="safe-area-overlay"></div>

    <!-- Page transition overlay (GSAP fades this in/out) -->
    <div id="transition-overlay"></div>

    <div id="site-wrapper">
      <slot />
    </div>

    {showDevTools && <DevTextEditor />}
    {showDevTools && <DevModeController />}

    <script>
      import gsap from 'gsap';
      import { registerHyperellipse } from '../vendor/hyperellipse/index.js';

      // Polyfill CSS corner-shape (squircle) in Safari / Firefox; no-op in Chromium.
      registerHyperellipse();

      const overlay = document.getElementById('transition-overlay');
      const REVEAL_EASE = 'cubic-bezier(0.55, 0.055, 0.675, 0.19)';
      const MIN_HOLD_MS = 500;
      const MAX_WAIT_MS = 4000;

      const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

      const isInViewport = (el: Element) => {
        const rect = el.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const vw = window.innerWidth || document.documentElement.clientWidth;
        return rect.bottom > 0 && rect.right > 0 && rect.top < vh && rect.left < vw;
      };

      const whenImageReady = async (img: HTMLImageElement) => {
        if (!img.complete) {
          await new Promise<void>((resolve) => {
            img.addEventListener('load', () => resolve(), { once: true });
            img.addEventListener('error', () => resolve(), { once: true });
          });
        }
        // Decode so pixels are paint-ready, not just network-complete.
        if (typeof img.decode === 'function' && img.naturalWidth > 0) {
          try {
            await img.decode();
          } catch {
            /* broken / unsupported — still reveal */
          }
        }
      };

      const waitForVisibleContent = async () => {
        const visibleImages = Array.from(document.images).filter(isInViewport);
        await Promise.all([
          document.fonts?.ready ?? Promise.resolve(),
          ...visibleImages.map(whenImageReady),
        ]);
      };

      let revealing = false;

      const revealPage = async () => {
        if (!overlay || revealing) return;
        revealing = true;

        // Take over from the CSS safety-net animation.
        overlay.style.animation = 'none';
        overlay.style.opacity = '1';

        const started = performance.now();
        await Promise.race([waitForVisibleContent(), sleep(MAX_WAIT_MS)]);

        const remaining = MIN_HOLD_MS - (performance.now() - started);
        if (remaining > 0) await sleep(remaining);

        gsap.to(overlay, {
          opacity: 0,
          duration: 0.5,
          ease: REVEAL_EASE,
          onComplete: () => {
            revealing = false;
          },
        });
      };

      // ── Enter: hold white until visible media is ready ─────
      void revealPage();

      // ── Exit: fade overlay in, then navigate ───────────────
      document.querySelectorAll('a[href]').forEach((link) => {
        const anchor = link as HTMLAnchorElement;
        const href = anchor.href;
        const isSameOrigin = href.startsWith(window.location.origin);
        const isHash = href.includes('#');
        const opensInNewTab = anchor.target === '_blank';
        const isDownload = anchor.hasAttribute('download');

        if (!isSameOrigin || isHash || opensInNewTab || isDownload) return;

        link.addEventListener('click', (e) => {
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          ) {
            return;
          }

          e.preventDefault();
          const target = anchor.href;

          if (overlay) {
            overlay.style.animation = 'none';
          }

          gsap.to('#transition-overlay', {
            opacity: 1,
            duration: 0.5,
            ease: 'power2.in',
            onComplete: () => {
              window.location.href = target;
            },
          });
        });
      });

      // ── Back/forward (bfcache): replay enter reveal ────────
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) {
          revealing = false;
          void revealPage();
        }
      });
    </script>
  </body>
</html>
