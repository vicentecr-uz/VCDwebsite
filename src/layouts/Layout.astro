---
import '../styles/global.css';
// The dev-chrome atoms (.dev-btn, .dev-field, .dev-panel, …) are consumed by
// every Dev*.astro panel below, but none of them import this stylesheet
// themselves — only the ui/*.astro primitives on /styles do. Without a
// site-wide import, every real page (dev tools included) rendered those
// classes with no CSS at all.
import '../styles/dev-chrome.css';
import DevModeController from '../components/DevModeController.astro';
import DevTextEditor from '../components/DevTextEditor.astro';
import DevProjectGridEditor from '../components/DevProjectGridEditor.astro';
import DevGalleryReorder from '../components/DevGalleryReorder.astro';
import DevSectionReorderEditor from '../components/DevSectionReorderEditor.astro';
import DevLogIssue from '../components/DevLogIssue.astro';
import DevNewProject from '../components/DevNewProject.astro';
import ProjectImageCropTuner from '../components/project/ProjectImageCropTuner.astro';
import DevGalleryPages from '../components/DevGalleryPages.astro';
import DevShortcutsHelp from '../components/DevShortcutsHelp.astro';
import DevAssetManager from '../components/DevAssetManager.astro';
import DevPageColumn from '../components/DevPageColumn.astro';
import DevAwardBadgeSize from '../components/DevAwardBadgeSize.astro';
import DevAwardBlockSize from '../components/DevAwardBlockSize.astro';
import ArchivedDevPanels from '../components/archive/ArchivedDevPanels.astro';
import GalleryMediaInk from '../components/GalleryMediaInk.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { ADAPTIVE_PAGE_COLUMNS_ENABLED } from '../lib/pageColumn';

if (import.meta.env.DEV) {
  await import('../styles/dev-token-alarms.css');
}

/**
 * Site-wide share card. Points at a build-generated `preview` derivative (2560px
 * long edge) rather than the 4MB original — social scrapers refuse large files.
 * Placeholder until a purpose-built 1200x630 card exists (#39).
 */
const DEFAULT_OG_IMAGE = '/images/IMG_5523-2.preview.webp';

interface Props {
  title: string;
  description?: string;
  /** Load EB Garamond (serif). Only pages that use --font-serif need this. */
  serif?: boolean;
  /**
   * Share-card image, root-relative (e.g. `/images/foo.preview.webp`).
   * Project pages pass their own cover; everything else gets the site default.
   */
  ogImage?: string;
  /**
   * Candidate inline style for #site-wrapper. ADAPTIVE_PAGE_COLUMNS_ENABLED
   * controls whether Layout applies it and mounts the dev/HMR synchronizer.
   */
  columnStyle?: string;
}

const {
  title,
  description = 'Born in Rome, IT. Based in London, UK.',
  serif = false,
  ogImage = DEFAULT_OG_IMAGE,
  columnStyle,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Absolute URLs are required:
// og:image and canonical are both ignored by scrapers when relative.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const showDevTools = import.meta.env.DEV;
// Production is light until dark mode ships (#256): pin data-theme="light" and
// omit the OS media query from the generated production sheet. Local DEV omits
// the attribute so the theme toggle can still set Dark.
---

<!doctype html>
<html
  lang="en"
  data-theme={showDevTools ? undefined : 'light'}
  data-adaptive-page-columns={ADAPTIVE_PAGE_COLUMNS_ENABLED ? '' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {showDevTools && (
      <script is:inline>
        try {
          var storedMode = localStorage.getItem('vcd:theme');
          if (storedMode === 'light' || storedMode === 'dark') {
            document.documentElement.setAttribute('data-theme', storedMode);
          }
        } catch (e) {
          /* private mode / storage disabled — falls back to OS theme */
        }
      </script>
    )}
    {showDevTools && (
      <script is:inline>
        try {
          const transitionMode = new URLSearchParams(location.search).get('dev-transition');
          if (transitionMode === 'visible') {
            document.documentElement.setAttribute('data-dev-transition', transitionMode);
          }
        } catch (e) {
          /* malformed or unavailable URL APIs leave the normal transition intact */
        }
      </script>
    )}
    {!showDevTools && (
      <script is:inline>
        try {
          const loopbackHosts = new Set(['localhost', '127.0.0.1', '::1', '[::1]']);
          const transitionMode = new URLSearchParams(location.search).get('dev-transition');
          if (loopbackHosts.has(location.hostname) && transitionMode === 'visible') {
            document.documentElement.setAttribute('data-dev-transition', transitionMode);
          }
        } catch (e) {
          /* malformed or unavailable URL APIs leave the normal transition intact */
        }
      </script>
    )}
    {showDevTools && (
      <style is:inline>
        html[data-dev-transition="visible"] #transition-overlay { opacity: 0 !important; visibility: hidden !important; animation: none !important; }
        #transition-readiness-marker {
          position: fixed;
          top: max(24px, env(safe-area-inset-top));
          left: max(24px, env(safe-area-inset-left));
          z-index: 101;
          pointer-events: none;
          padding: 0.3em 0.42em;
          background: #ff1493;
          color: #19000d;
          font-family: inherit;
          font-size: clamp(2.5rem, 7vw, 6rem);
          font-weight: 900;
          line-height: 0.9;
          letter-spacing: -0.055em;
          text-transform: uppercase;
        }
      </style>
    )}
    {!showDevTools && (
      <style is:inline>
        html[data-dev-transition="visible"] #transition-overlay { opacity: 0 !important; visibility: hidden !important; animation: none !important; }
      </style>
    )}
    {showDevTools && (
      <>
        <script is:inline>
          if (new URLSearchParams(location.search).get('font-reveal') === 'trickle') {
            document.documentElement.dataset.fontRevealPrototype = 'pending';
          }
        </script>
        <style is:inline>
          html[data-font-reveal-prototype="pending"] #site-wrapper,
          html[data-font-reveal-prototype="pending"] #site-wrapper * {
            font-family: system-ui, sans-serif !important;
          }
        </style>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" />
    {serif && (
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vicente Cruz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    {showDevTools && <script is:inline type="module" src="/src/scripts/fontRevealPrototype.ts"></script>}

    <ImageLightbox />

    <!-- Page transition overlay (GSAP fades this in/out) -->
    <div id="transition-overlay"></div>
    {showDevTools && <output id="transition-readiness-marker" class="dev-surface" hidden role="status">Fade would start</output>}

    <div id="site-wrapper" style={ADAPTIVE_PAGE_COLUMNS_ENABLED ? columnStyle : undefined}>
      <slot />
    </div>

    <script is:inline>
      (() => {
        const overlay = document.getElementById('transition-overlay');
        if (!overlay || document.documentElement.dataset.devTransition === 'visible') return;
        const mark = (name, detail) => {
          try {
            if (typeof performance?.mark !== 'function') return;
            try { performance.mark(`vcd:${name}`, { detail }); } catch { performance.mark(`vcd:${name}`); }
          } catch {}
        };
        const visible = (image) => {
          const rect = image.getBoundingClientRect();
          const viewport = document.documentElement;
          return rect.bottom > 0 && rect.right > 0 && rect.top < (innerHeight || viewport.clientHeight) && rect.left < (innerWidth || viewport.clientWidth);
        };
        const images = Array.from(document.querySelectorAll('img[data-image-preview]')).filter(visible);
        const imageReady = images.map((image) => new Promise((resolve) => {
          if (image.complete) { resolve(); return; }
          const done = () => { image.removeEventListener('load', done); image.removeEventListener('error', done); resolve(); };
          image.addEventListener('load', done, { once: true });
          image.addEventListener('error', done, { once: true });
        }));
        overlay.dataset.vcdInitialReveal = 'running';
        overlay.style.animation = 'none';
        mark('initial-readiness-start');
        const introLayoutReady = new Promise((resolve) => {
          if (!document.querySelector('.project-block--intro') || document.documentElement.dataset.introLayoutReady === 'true') { resolve(); return; }
          window.addEventListener('vcd:intro-layout-ready', resolve, { once: true });
        });
        const timeout = new Promise((resolve) => setTimeout(resolve, 4000));
        Promise.race([Promise.all([introLayoutReady, ...imageReady]), timeout]).then(() => {
          mark('initial-readiness-satisfied');
          requestAnimationFrame(() => requestAnimationFrame(() => {
            if (overlay.dataset.vcdInitialReveal !== 'running') return;
            mark('initial-fade-start');
            overlay.style.transition = 'opacity 250ms cubic-bezier(0.25, 0.46, 0.45, 0.94)';
            overlay.style.opacity = '0';
            let finished = false;
            const finish = () => {
              if (finished) return;
              finished = true;
              overlay.removeEventListener('transitionend', finish);
              if (overlay.dataset.vcdInitialReveal !== 'running') return;
              overlay.style.removeProperty('transition');
              overlay.hidden = true;
              overlay.dataset.vcdInitialReveal = 'complete';
              mark('initial-fade-end');
              window.dispatchEvent(new Event('vcd:initial-reveal-complete'));
            };
            overlay.addEventListener('transitionend', finish, { once: true });
            setTimeout(finish, 250);
          }));
        });
      })();
    </script>

    {showDevTools && <DevTextEditor />}
    {showDevTools && <DevModeController />}
    {showDevTools && <DevProjectGridEditor />}
    {showDevTools && <DevGalleryReorder />}
    {showDevTools && <DevAwardBadgeSize />}
    {showDevTools && <DevAwardBlockSize />}
    {showDevTools && <DevSectionReorderEditor />}
    {showDevTools && <DevLogIssue />}
    {showDevTools && <DevNewProject />}
    {showDevTools && <ProjectImageCropTuner />}
    {showDevTools && <DevGalleryPages />}
    {showDevTools && <DevShortcutsHelp />}
    {showDevTools && <DevAssetManager />}
    {showDevTools && ADAPTIVE_PAGE_COLUMNS_ENABLED && <DevPageColumn />}
    {showDevTools && <ArchivedDevPanels />}
    <GalleryMediaInk />

    {showDevTools && (
      <script>
        import '../lib/lapseDev';
      </script>
    )}

    {showDevTools && (
      <!-- Inline DEV source keeps Agentation and React out of production output. -->
      <script is:inline type="module" src="/src/lib/agentationDev.ts"></script>
    )}

    <script>
      import gsap from 'gsap';
      import { bindSafeVh } from '../lib/safeVh';
      import { bindImagePreviewUpgrade, openImagePreviewUpgrade } from '../lib/imagePreviewUpgrade';

      // Stable 1vh unit for max-height caps (Edge/iOS svh is buggy mid-scroll).
      bindSafeVh();

      const overlay = document.getElementById('transition-overlay');
      const readinessMarker = document.getElementById('transition-readiness-marker') as HTMLOutputElement | null;
      const visibleTransition = document.documentElement.dataset.devTransition === 'visible';
      const initialRevealState = overlay?.dataset.vcdInitialReveal;
      bindImagePreviewUpgrade();
      if (initialRevealState === 'running') {
        window.addEventListener('vcd:initial-reveal-complete', () => openImagePreviewUpgrade(), { once: true });
      } else if (initialRevealState === 'complete') {
        openImagePreviewUpgrade();
      }
      if (!overlay) {
        openImagePreviewUpgrade();
      }

      // Squircle shaping disabled (issue #161). To re-enable, restore:
      // import { registerHyperellipse } from '../vendor/hyperellipse/index.js';
      // and call registerHyperellipse() here.
      const REVEAL_EASE = 'power1.out';
      const MAX_WAIT_MS = 4000;
      const emitTransitionMilestone = (name: string, detail: Record<string, unknown> = {}) => {
        try {
          const mark = performance?.mark;
          if (typeof mark === 'function') {
            try {
              mark.call(performance, `vcd:${name}`, { detail });
            } catch {
              mark.call(performance, `vcd:${name}`);
            }
          }
        } catch {
          // Performance marks are diagnostic only and must never affect reveal.
        }
        if (!readinessMarker) return;
        const eventDetail = { name, time: performance.now(), ...detail };
        const win = window as Window & { __vcdTransitionMilestones?: Array<Record<string, unknown>> };
        (win.__vcdTransitionMilestones ??= []).push(eventDetail);
        window.dispatchEvent(new CustomEvent('vcd:transition-milestone', { detail: eventDetail }));
      };
      emitTransitionMilestone('transition-script-start');

      const isInViewport = (el: Element) => {
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const vw = window.innerWidth || document.documentElement.clientWidth;
        let rect = el.getBoundingClientRect();
        const intersect = (left: number, top: number, right: number, bottom: number) => {
          const next = {
            left: Math.max(rect.left, left), top: Math.max(rect.top, top),
            right: Math.min(rect.right, right), bottom: Math.min(rect.bottom, bottom),
          };
          if (next.right <= next.left || next.bottom <= next.top) return false;
          rect = next;
          return true;
        };
        if (!intersect(0, 0, vw, vh)) return false;
        for (let current: Element | null = el; current; current = current.parentElement) {
          const style = getComputedStyle(current);
          if (style.display === 'none' || style.visibility === 'hidden') return false;
          const overflowX = style.overflowX || style.overflow;
          const overflowY = style.overflowY || style.overflow;
          const ancestorRect = current.getBoundingClientRect();
          const clipX = ['hidden', 'clip', 'auto', 'scroll'].includes(overflowX);
          const clipY = ['hidden', 'clip', 'auto', 'scroll'].includes(overflowY);
          if (clipX || clipY) {
            if (!intersect(
              clipX ? ancestorRect.left : rect.left,
              clipY ? ancestorRect.top : rect.top,
              clipX ? ancestorRect.right : rect.right,
              clipY ? ancestorRect.bottom : rect.bottom,
            )) return false;
          }
        }
        return true;
      };

      let generation = 0;
      let activeTween: gsap.core.Tween | null = null;
      let readinessAbort: AbortController | null = null;
      let readinessCleanup: (() => void) | null = null;
      let navigationWatchdog: ReturnType<typeof setTimeout> | null = null;
      let destinationLocked = false;
      let suspended = false;

      const invalidate = () => {
        if (overlay?.dataset.vcdInitialReveal === 'running') {
          overlay.dataset.vcdInitialReveal = 'cancelled';
          overlay.style.removeProperty('transition');
        }
        generation += 1;
        activeTween?.kill();
        activeTween = null;
        readinessAbort?.abort();
        readinessAbort = null;
        readinessCleanup?.();
        readinessCleanup = null;
        if (navigationWatchdog !== null) {
          clearTimeout(navigationWatchdog);
          navigationWatchdog = null;
        }
        destinationLocked = false;
      };

      const waitForReadiness = (signal: AbortSignal) => {
        let timer: ReturnType<typeof setTimeout> | null = null;
        let settled = false;
        let releaseReason: 'resources' | 'timeout' | 'aborted' = 'resources';
        const cleanups: Array<() => void> = [];
        let resolveReady!: () => void;
        const ready = new Promise<void>((resolve) => {
          resolveReady = resolve;
        });
        const settle = (reason: 'resources' | 'timeout' | 'aborted' = 'resources') => {
          if (settled) return;
          settled = true;
          releaseReason = reason;
          if (timer !== null) clearTimeout(timer);
          for (const cleanup of cleanups) cleanup();
          resolveReady();
        };
        const onAbort = () => settle('aborted');
        signal.addEventListener('abort', onAbort, { once: true });
        cleanups.push(() => signal.removeEventListener('abort', onAbort));

        const waits: Promise<unknown>[] = [];
        void Promise.resolve(document.fonts?.ready).then(() => emitTransitionMilestone('fonts-ready')).catch(() => undefined);
        let thumbIndex = 0;
        const readinessImages = Array.from(document.querySelectorAll('img[data-image-preview]')).filter(isInViewport).sort((a, b) => { const ar = a.getBoundingClientRect(); const br = b.getBoundingClientRect(); return ar.top - br.top || ar.left - br.left; });
        for (const img of readinessImages) {
          const currentThumbIndex = thumbIndex++;
          waits.push((async () => {
            if (!img.complete) {
              await new Promise<void>((resolve) => {
                let finished = false;
                const done = () => {
                  if (finished) return;
                  finished = true;
                  img.removeEventListener('load', done);
                  img.removeEventListener('error', done);
                  signal.removeEventListener('abort', done);
                  resolve();
                };
                img.addEventListener('load', done, { once: true });
                img.addEventListener('error', done, { once: true });
                signal.addEventListener('abort', done, { once: true });
                cleanups.push(done);
              });
            }
            if (signal.aborted || settled) return;
            if (typeof img.decode === 'function' && img.naturalWidth > 0) {
              await Promise.resolve(img.decode()).catch(() => undefined);
            }
            emitTransitionMilestone('thumb-ready', { index: currentThumbIndex + 1 });
          })());
        }
        Promise.all(waits).then(() => settle('resources'), () => settle('resources'));
        timer = setTimeout(() => settle('timeout'), MAX_WAIT_MS);
        return { ready, cleanup: settle, get releaseReason() { return releaseReason; } };
      };

      const waitForOpaquePaint = (signal: AbortSignal) =>
        new Promise<void>((resolve) => {
          let first: number | null = null;
          let second: number | null = null;
          const finish = () => {
            if (first !== null) cancelAnimationFrame(first);
            if (second !== null) cancelAnimationFrame(second);
            signal.removeEventListener('abort', finish);
            resolve();
          };
          first = requestAnimationFrame(() => {
            second = requestAnimationFrame(finish);
          });
          signal.addEventListener('abort', finish, { once: true });
        });

      const revealPage = async () => {
        if (!overlay || suspended) return;
        invalidate();
        if (readinessMarker) readinessMarker.hidden = true;
        const current = generation;
        const controller = new AbortController();
        readinessAbort = controller;
        overlay.style.animation = 'none';
        overlay.hidden = visibleTransition;
        overlay.style.opacity = visibleTransition ? '0' : '1';
        try {
          const wait = waitForReadiness(controller.signal);
          readinessCleanup = wait.cleanup;
          const opaquePaint = waitForOpaquePaint(controller.signal).then(() => emitTransitionMilestone('opaque-paint'));
          const readiness = wait.ready.then(() => emitTransitionMilestone('readiness-satisfied', {
            release: wait.releaseReason === 'timeout' ? 'timeout' : 'resources',
          }));
          await readiness;
          if (current !== generation || suspended) return;
          await opaquePaint;
          if (current !== generation || suspended) return;
          emitTransitionMilestone('fade-authorized');
          readinessCleanup?.();
          readinessCleanup = null;
          readinessAbort = null;
          if (readinessMarker && visibleTransition) readinessMarker.hidden = false;
          emitTransitionMilestone('preview-gate-open');
          openImagePreviewUpgrade();
          if (visibleTransition) {
            overlay.style.opacity = '0';
            emitTransitionMilestone('veil-fade-start');
            if (visibleTransition) emitTransitionMilestone('veil-fade-end');
            return;
          }
          emitTransitionMilestone('veil-fade-start');
          activeTween = gsap.to(overlay, {
            opacity: 0,
            duration: 0.25,
            ease: REVEAL_EASE,
            onComplete: () => {
              emitTransitionMilestone('veil-fade-end');
              if (current === generation) {
                overlay.hidden = true;
                activeTween = null;
              }
            },
          });
        } catch {
          if (current === generation) {
            controller.abort();
            readinessCleanup?.();
            readinessCleanup = null;
            readinessAbort = null;
            overlay.style.opacity = '0';
            overlay.hidden = true;
          }
        }
      };

      if (!initialRevealState) void revealPage();

      document.querySelectorAll('a').forEach((link) => {
        const anchor = link as HTMLAnchorElement;
        link.addEventListener('click', (e) => {
          if (
            e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey
          ) return;
          const rawHref = anchor.getAttribute('href');
          if (!rawHref || anchor.hasAttribute('download') || (anchor.target && anchor.target !== '_self')) return;
          let target: URL;
          try {
            target = new URL(rawHref, window.location.href);
          } catch {
            return;
          }
          if (target.origin !== window.location.origin || target.href.includes('#')) return;
          if (!overlay) return;
          e.preventDefault();
          if (suspended || destinationLocked) return;
          invalidate();
          const current = generation;
          destinationLocked = true;
          overlay.style.animation = 'none';
          const navigate = () => {
            if (current !== generation || !destinationLocked) return;
            try {
              // Recover a canceled or stalled navigation attempt after a bounded wait.
              navigationWatchdog = setTimeout(() => {
                if (current !== generation) return;
                void revealPage();
              }, MAX_WAIT_MS);
              window.location.href = target.href;
            } catch {
              void revealPage();
            }
          };
          if (visibleTransition) {
            target.searchParams.set('dev-transition', 'visible');
            navigate();
            return;
          }
          try {
            overlay.hidden = false;
            activeTween = gsap.to(overlay, {
              opacity: 1,
              duration: 0.25,
              ease: REVEAL_EASE,
              onComplete: navigate,
            });
          } catch {
            navigate();
          }
        });
      });

      window.addEventListener('pagehide', () => {
        invalidate();
        suspended = true;
      });

      window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        suspended = false;
        void revealPage();
      });
    </script>
  </body>
</html>
