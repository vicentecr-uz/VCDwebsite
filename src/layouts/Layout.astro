---
import '../styles/global.css';
// The dev-chrome atoms (.dev-btn, .dev-field, .dev-panel, …) are consumed by
// every Dev*.astro panel below, but none of them import this stylesheet
// themselves — only the ui/*.astro primitives on /styles do. Without a
// site-wide import, every real page (dev tools included) rendered those
// classes with no CSS at all.
import '../styles/dev-chrome.css';
import DevModeController from '../components/DevModeController.astro';
import DevTextEditor from '../components/DevTextEditor.astro';
import DevProjectGridEditor from '../components/DevProjectGridEditor.astro';
import DevGalleryReorder from '../components/DevGalleryReorder.astro';
import DevSectionReorderEditor from '../components/DevSectionReorderEditor.astro';
import DevLogIssue from '../components/DevLogIssue.astro';
import DevNewProject from '../components/DevNewProject.astro';
import ProjectImageCropTuner from '../components/project/ProjectImageCropTuner.astro';
import DevGalleryPages from '../components/DevGalleryPages.astro';
import DevShortcutsHelp from '../components/DevShortcutsHelp.astro';
import DevAssetManager from '../components/DevAssetManager.astro';
import DevPageColumn from '../components/DevPageColumn.astro';
import GalleryMediaInk from '../components/GalleryMediaInk.astro';

if (import.meta.env.DEV) {
  await import('../styles/dev-token-alarms.css');
}

/**
 * Site-wide share card. Points at a build-generated `preview` derivative (2560px
 * long edge) rather than the 4MB original — social scrapers refuse large files.
 * Placeholder until a purpose-built 1200x630 card exists (#39).
 */
const DEFAULT_OG_IMAGE = '/images/IMG_5523-2.preview.webp';

interface Props {
  title: string;
  description?: string;
  /** Load EB Garamond (serif). Only pages that use --font-serif need this. */
  serif?: boolean;
  /**
   * Share-card image, root-relative (e.g. `/images/foo.preview.webp`).
   * Project pages pass their own cover; everything else gets the site default.
   */
  ogImage?: string;
  /**
   * Inline style for #site-wrapper, used to narrow the page column to what the
   * page's own content needs. Build it with `pageColumnStyle()` from
   * src/lib/pageColumn.ts; omit it to keep the default column.
   */
  columnStyle?: string;
}

const {
  title,
  description = 'Portfolio of Vicente Cruz — London-based industrial designer.',
  serif = false,
  ogImage = DEFAULT_OG_IMAGE,
  columnStyle,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Absolute URLs are required:
// og:image and canonical are both ignored by scrapers when relative.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const showDevTools = import.meta.env.DEV;
// Production is light until dark mode ships (#256): pin data-theme="light" and
// omit the OS media query from the generated production sheet. Local DEV omits
// the attribute so the theme toggle can still set Dark.
---

<!doctype html>
<html lang="en" data-theme={showDevTools ? undefined : 'light'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {showDevTools && (
      <script is:inline>
        try {
          var storedMode = localStorage.getItem('vcd:theme');
          if (storedMode === 'light' || storedMode === 'dark') {
            document.documentElement.setAttribute('data-theme', storedMode);
          }
        } catch (e) {
          /* private mode / storage disabled — falls back to OS theme */
        }
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" />
    {serif && (
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vicente Cruz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <!-- Safe-area overlay: covers browser chrome inset (Zen, Safari mobile) -->
    <div id="safe-area-overlay"></div>

    <!-- Page transition overlay (GSAP fades this in/out) -->
    <div id="transition-overlay"></div>

    <div id="site-wrapper" style={columnStyle}>
      <slot />
    </div>

    {showDevTools && <DevTextEditor />}
    {showDevTools && <DevModeController />}
    {showDevTools && <DevProjectGridEditor />}
    {showDevTools && <DevGalleryReorder />}
    {showDevTools && <DevSectionReorderEditor />}
    {showDevTools && <DevLogIssue />}
    {showDevTools && <DevNewProject />}
    {showDevTools && <ProjectImageCropTuner />}
    {showDevTools && <DevGalleryPages />}
    {showDevTools && <DevShortcutsHelp />}
    {showDevTools && <DevAssetManager />}
    {showDevTools && <DevPageColumn />}
    <GalleryMediaInk />

    {showDevTools && (
      <script>
        import '../lib/lapseDev';
      </script>
    )}

    <script>
      import gsap from 'gsap';
      import { bindSafeVh } from '../lib/safeVh';
      import { bindImagePreviewUpgrade, openImagePreviewUpgrade } from '../lib/imagePreviewUpgrade';

      // Stable 1vh unit for max-height caps (Edge/iOS svh is buggy mid-scroll).
      bindSafeVh();

      const overlay = document.getElementById('transition-overlay');
      bindImagePreviewUpgrade();
      if (!overlay) {
        openImagePreviewUpgrade();
      }

      // Squircle shaping disabled (issue #161). To re-enable, restore:
      // import { registerHyperellipse } from '../vendor/hyperellipse/index.js';
      // and call registerHyperellipse() here.
      const REVEAL_EASE = 'cubic-bezier(0.55, 0.055, 0.675, 0.19)';
      const MAX_WAIT_MS = 4000;

      const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

      const isInViewport = (el: Element) => {
        const rect = el.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const vw = window.innerWidth || document.documentElement.clientWidth;
        return rect.bottom > 0 && rect.right > 0 && rect.top < vh && rect.left < vw;
      };

      const whenImageReady = async (img: HTMLImageElement) => {
        if (!img.complete) {
          await new Promise<void>((resolve) => {
            img.addEventListener('load', () => resolve(), { once: true });
            img.addEventListener('error', () => resolve(), { once: true });
          });
        }
        // Decode so pixels are paint-ready, not just network-complete.
        if (typeof img.decode === 'function' && img.naturalWidth > 0) {
          try {
            await img.decode();
          } catch {
            /* broken / unsupported — still reveal */
          }
        }
      };

      const waitForVisibleImages = async () => {
        const visibleImages = Array.from(document.images).filter(isInViewport);
        await Promise.all(visibleImages.map(whenImageReady));
      };

      let revealing = false;

      const revealPage = async () => {
        if (!overlay || revealing) return;
        revealing = true;

        // Take over from the CSS safety-net animation.
        overlay.style.animation = 'none';
        overlay.style.opacity = '1';

        await Promise.race([waitForVisibleImages(), sleep(MAX_WAIT_MS)]);
        openImagePreviewUpgrade();

        gsap.to(overlay, {
          opacity: 0,
          duration: 0.25,
          ease: REVEAL_EASE,
          onComplete: () => {
            revealing = false;
          },
        });
      };

      // ── Enter: hold white until visible LQIP/thumb media is ready ──
      void revealPage();

      // ── Exit: fade overlay in, then navigate ───────────────
      document.querySelectorAll('a[href]').forEach((link) => {
        const anchor = link as HTMLAnchorElement;
        const href = anchor.href;
        const isSameOrigin = href.startsWith(window.location.origin);
        const isHash = href.includes('#');
        const opensInNewTab = anchor.target === '_blank';
        const isDownload = anchor.hasAttribute('download');

        if (!isSameOrigin || isHash || opensInNewTab || isDownload) return;

        link.addEventListener('click', (e) => {
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          ) {
            return;
          }

          // Edit mode may strip href from gallery cards so titles are editable.
          // The .href IDL still resolves to this page — navigating would white-flash
          // reload the same URL. Only transition when an href attribute is present.
          const rawHref = anchor.getAttribute('href');
          if (!rawHref) return;

          e.preventDefault();
          const target = anchor.href;

          if (overlay) {
            overlay.style.animation = 'none';
          }

          gsap.to('#transition-overlay', {
            opacity: 1,
            duration: 0.5,
            ease: 'power2.in',
            onComplete: () => {
              window.location.href = target;
            },
          });
        });
      });

      // ── Back/forward (bfcache): replay enter reveal ────────
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) {
          revealing = false;
          void revealPage();
        }
      });
    </script>
  </body>
</html>
