---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import { loadPageDocument } from '../lib/projects';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const homePage = loadPageDocument('home');
---

<Layout title="Vicente Cruz — Industrial Designer">
  <div class="flex flex-col min-h-dvh">
    <Header navMenu wordmarkAsH1 />

    <main id="main-content" class="listing-main" style="flex: 1;">
      <p class="home-role">Product Design Engineer</p>
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="home" sections={homePage.sections} />
        <div
          class:list={[projectStackClass('none')]}
          {...(spacingDevAttrs('home', ['sections', homePage.sections.length], 'none') ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }

  .home-role {
    /* Eat the header's bottom padding so this sits under the wordmark,
       not under the full logo-tall row. 0.35em is the leftover air. */
    margin: calc(-1 * var(--space-unit) + 0.35em) 0 0;
    font-size: var(--header-menu-link-size, 1.2em);
    font-weight: var(--text-nav-weight);
    color: var(--sys-color-on-srf-variant);
  }
</style>
