---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import DevImageDrop from '../components/DevImageDrop.astro';
import HomeIntroController from '../components/home/HomeIntroController.astro';
import { loadPageDocument } from '../lib/projects';
import { pageColumnStyle } from '../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const homePage = loadPageDocument('home');
const homeIntroPage = loadPageDocument('home-intro');
---

<Layout persistentNavigation title="Vicente Cruz" columnStyle={pageColumnStyle(homePage.sections)}>
  <div data-page-shell class="home-page flex flex-col min-h-dvh" data-home-page>
    <Header navMenu wordmarkAsH1 />

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone data-page-document="home">
        <ProjectSections documentKey="home" sections={homePage.sections} introHeight={homePage.introHeight} />
        <div
          class:list={[projectStackClass(homePage.trailingSpacing ?? 'none')]}
          {...(spacingDevAttrs('home', ['sections', homePage.sections.length], homePage.trailingSpacing ?? 'none', { writePath: ['trailingSpacing'] }) ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
  <HomeIntroController page={homeIntroPage} />
  <DevImageDrop documentKey="home" />
</Layout>

<script>
  import { bindHomeReveal } from '../lib/homeReveal';
  import { onPageLoad } from '../lib/pageLifecycle';
  const dispose = onPageLoad(() => bindHomeReveal()?.destroy);
  import.meta.hot?.dispose(dispose);
</script>

<style>
  .listing-main {
    padding: 0;
  }

  .home-page {
    position: relative;
    z-index: 0;
  }
</style>
