---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import { loadPageDocument } from '../lib/projects';
import { pageColumnStyle } from '../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const homePage = loadPageDocument('home');
---

<Layout title="Vicente Cruz — Industrial Designer" columnStyle={pageColumnStyle(homePage.sections)}>
  <div class="flex flex-col min-h-dvh">
    <Header navMenu wordmarkAsH1 />

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="home" sections={homePage.sections} introHeight={homePage.introHeight} />
        <div
          class:list={[projectStackClass('none')]}
          {...(spacingDevAttrs('home', ['sections', homePage.sections.length], 'none') ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
