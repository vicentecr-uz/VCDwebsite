---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

type HomeProject = {
  order?: number;
  slug: string;
  title: string;
  year: string;
  image: string;
  bg: string;
  dark: boolean;
  full: boolean;
};

const homeEntries = Object.values(
  import.meta.glob('../content/home/*.json', { eager: true }),
) as { default: HomeProject }[];

const projects = homeEntries
  .map((entry) => entry.default)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
---

<Layout title="Vicente Cruz — Industrial Designer">
  <div class="flex flex-col min-h-dvh">
    <Header navMenu />

    <main class="listing-main" style="flex: 1;">
      <ProjectGrid
        variant="home"
        items={projects.map((project) => ({
          title: project.title,
          subtitle: project.year,
          image: project.image,
          bg: project.bg,
          dark: project.dark,
          full: project.full,
          href: `/${project.slug}`,
        }))}
      />
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
