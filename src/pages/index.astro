---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
type HomeProject = {
  order?: number;
  slug: string;
  title: string;
  year: string;
  image: string;
  bg: string;
  dark: boolean;
  full: boolean;
};

const homeEntries = Object.values(
  import.meta.glob('../content/home/*.json', { eager: true }),
) as { default: HomeProject }[];

const projects = homeEntries
  .map((entry) => entry.default)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
---

<Layout title="Vicente Cruz — Industrial Designer">
  <div class="flex flex-col min-h-dvh">
    <Header navMenu />

    <main class="project-main" style="flex: 1;">
      <ul class="project-grid">
        {projects.map((project) => (
          <li class={project.full ? 'project-item project-item--full' : 'project-item'}>
            <a href={`/${project.slug}`} class="project-card block">
              <div
                class="project-cover relative overflow-hidden"
                style={`background-color: ${project.bg}`}
              >
                <img
                  src={project.image}
                  alt={project.title}
                  class="project-img w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="project-meta absolute bottom-0 left-0 right-0">
                  <div class="flex items-baseline gap-2">
                    <h2
                      class="project-title font-bold"
                      style={`color: ${project.dark ? '#f7f7f7' : '#6d6d6d'}`}
                    >
                      {project.title}
                    </h2>
                    <span
                      class="project-title font-bold"
                      style={`color: ${project.dark ? 'rgba(247,247,247,0.5)' : 'rgba(109,109,109,0.5)'}`}
                    >
                      {project.year}
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  /* ── Layout ─────────────────────────────────────────────── */
  .project-main {
    padding: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
  }

  .project-item--full {
    grid-column: span 2;
  }

  .project-item--full .project-cover {
    aspect-ratio: 16 / 12;
  }

  .project-item--full .project-img {
    object-position: center center;
  }

  /* ── Cover image container ──────────────────────────────── */
  .project-cover {
    aspect-ratio: 4 / 3;
    transform: translateZ(0);
  }

  /* ── Title typography (global) ──────────────────────────── */
  .project-title {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  /* ── Image & overlay (desktop default) ─────────────────── */
  .project-img {
    filter: none;
    transform: scale(1.18);
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.22);
  }

  .project-meta {
    opacity: 0;
    padding: 1em;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-meta {
    opacity: 1;
  }

  /* ── Tablet and below (≤768px):
       disable blur, always show titles ──────────────────── */
  @media (max-width: 768px) {
    .project-img {
      filter: none !important;
      transform: scale(1) !important;
      transition: transform 0.4s ease !important;
    }

    .project-card:hover .project-img {
      transform: scale(1.03) !important;
    }

    .project-meta {
      opacity: 1 !important;
      transition: none !important;
    }
  }

  /* ── Mobile landscape and below (≤667px):
       keep single-column stack for featured project ───────── */
  @media (max-width: 667px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-item--full {
      grid-column: span 1;
    }
  }

  /* ── Narrow portrait (≤480px):
       single column, resume 4:3 ──────────────────────────── */
  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-cover,
    .project-item--full .project-cover {
      aspect-ratio: 4 / 3;
    }
  }
</style>
