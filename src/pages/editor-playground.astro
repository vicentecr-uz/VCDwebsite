---
import DemoLayout from '../layouts/DemoLayout.astro';
import ProjectInteractiveDemo from '../components/project/ProjectInteractiveDemo.astro';
---

<DemoLayout title="Site editor playground" scrolling>
  <div class="playground-page">
    <ProjectInteractiveDemo demo="editor-playground" />
    <a href="https://github.com/vicentecr-uz/VCDwebsite">View source on GitHub</a>
  </div>
</DemoLayout>

<style>
  .playground-page { width: min(100%, 60rem); margin-inline: auto; --page-gutter: var(--space-unit); }
  a { display: inline-block; margin-top: 16px; text-underline-offset: 0.2em; }
</style>
