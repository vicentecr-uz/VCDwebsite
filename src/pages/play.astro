---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

type PlayItem = {
  order?: number;
  title: string;
  meta?: string;
  image: string;
  bg: string;
  dark: boolean;
  href?: string;
};

const playEntries = Object.values(
  import.meta.glob('../content/play/*.json', { eager: true }),
) as { default: PlayItem }[];

const playItems = playEntries
  .map((entry) => entry.default)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
---

<Layout title="Play — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header title="Play" navMenu />

    <main class="listing-main" style="flex: 1;">
      <ProjectGrid
        variant="play"
        items={playItems.map((item) => ({
          title: item.title,
          subtitle: item.meta,
          image: item.image,
          bg: item.bg,
          dark: item.dark,
          href: item.href,
        }))}
      />
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
