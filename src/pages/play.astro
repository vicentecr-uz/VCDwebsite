---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getPlayGridItems } from '../lib/projects';

const playItems = getPlayGridItems();
---

<Layout title="Play — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header title="Play" navMenu />

    <main class="listing-main" style="flex: 1;">
      <ProjectGrid
        variant="play"
        items={playItems.map((item) => {
          if ('isLink' in item) {
            return {
              title: item.title,
              subtitle: item.meta,
              image: item.image,
              bg: item.bg,
              dark: item.dark,
              href: item.href,
              playLinkId: item.id,
            };
          }
          return {
            title: item.title,
            subtitle: item.subtitle,
            image: item.image,
            bg: item.bg,
            dark: item.dark,
            href: item.href,
            teaser: item.teaser,
            teaserLabel: item.teaserLabel,
            status: item.status,
            slug: item.slug,
          };
        })}
      />
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
