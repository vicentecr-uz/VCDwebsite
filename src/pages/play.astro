---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import playPage from '../content/pages/play.json';
---

<Layout title="Play — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header title="Play" navMenu />

    <h1 class="sr-only">Play — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="play" sections={playPage.sections} />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
