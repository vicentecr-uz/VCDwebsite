---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import { loadPageDocument } from '../lib/projects';
import { pageColumnStyle } from '../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const playPage = loadPageDocument('play');
---

<Layout title="Play — Vicente Cruz" columnStyle={pageColumnStyle(playPage.sections)}>
  <div class="flex flex-col min-h-dvh">
    <Header title="Play" navMenu />

    <h1 class="sr-only">Play — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="play" sections={playPage.sections} introHeight={playPage.introHeight} />
        <div
          class:list={[projectStackClass('none')]}
          {...(spacingDevAttrs('play', ['sections', playPage.sections.length], 'none') ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
