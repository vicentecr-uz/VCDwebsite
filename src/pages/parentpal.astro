---
import ProjectLayout from '../components/ProjectLayout.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectTagline from '../components/project/ProjectTagline.astro';
import ProjectProse from '../components/project/ProjectProse.astro';
import ProjectImage from '../components/project/ProjectImage.astro';
import { projectImage } from '../lib/images';
import projectCopy from '../content/projects/parentpal.json';
---

<ProjectLayout
  title={projectCopy.title}
  description={projectCopy.description}
>
  <ProjectHero src="Phone Render w bkgd.png" alt="ParentPal app" />

  <ProjectTagline text={projectCopy.tagline} />

  <ProjectProse tightTop>
    <p set:html={projectCopy.copyBlocks.intro[0]} />
  </ProjectProse>

  <div class="project-block project-block--before-image">
    <div class="project-system-grid">
      <img src={projectImage('Monitor in Hub with Crib.3.png')} alt="ParentPal monitor in hub with crib" loading="lazy" />
      <img src={projectImage('Hero.png')} alt="ParentPal monitor and hub" loading="lazy" />
    </div>
  </div>

  <ProjectProse tightTop>
    <h4 class="project-section-title">{projectCopy.sectionTitles.research}</h4>
    <p set:html={projectCopy.copyBlocks.research[0]} />
    <p set:html={projectCopy.copyBlocks.research[1]} />
  </ProjectProse>

  <div class="project-block project-block--before-image">
    <div class="project-research-grid">
      <div class="project-research-col">
        <img src={projectImage('IMG_0377.jpeg')} alt="ParentPal research" loading="lazy" />
        <img src={projectImage('competitor analysis.jpg')} alt="Competitor analysis" loading="lazy" />
      </div>
      <div class="project-research-col">
        <img src={projectImage('key insights.png')} alt="Key insights" loading="lazy" />
      </div>
      <div class="project-research-col">
        <img src={projectImage('Prototype V2 CAD Remake.png')} alt="Prototype V2 CAD" loading="lazy" />
        <img src={projectImage('Prototype V2 CAD Remake.png')} alt="Prototype V2 CAD" loading="lazy" />
        <img src={projectImage('baby product reviews 2.jpg')} alt="Baby product reviews research" loading="lazy" />
      </div>
    </div>
  </div>

  <ProjectProse tightTop>
    <p set:html={projectCopy.copyBlocks.assist[0]} />
  </ProjectProse>

  <ProjectImage src="MVP Storyboard.png" alt="MVP storyboard" />

  <div class="project-block project-block--before-image">
    <div class="project-detail-grid project-detail-grid--wide">
      <img
        src={projectImage('20220531_051716785_iOS cropped.png')}
        alt="3D printed parts sitting in cardboard box for spray painting"
        loading="lazy"
      />
      <img src={projectImage('20220531_090451301_iOS.png')} alt="ParentPal prototype assembly" loading="lazy" />
    </div>
  </div>

  <ProjectProse tightTop>
    <p set:html={projectCopy.copyBlocks.assembly[0]} />
  </ProjectProse>

  <div class="project-block project-block--before-image">
    <div class="project-triple-grid">
      <img src={projectImage('20220531_043902902_iOS.JPG')} alt="ParentPal prototype detail" loading="lazy" />
      <img src={projectImage('20220527_021834264_iOS.JPG')} alt="ParentPal prototype testing" loading="lazy" />
      <img src={projectImage('20220527_021834264_iOS.JPG')} alt="ParentPal prototype testing" loading="lazy" />
    </div>
  </div>

  <ProjectProse tightTop>
    <p set:html={projectCopy.copyBlocks.feedback[0]} />
    <p set:html={projectCopy.copyBlocks.feedback[1]} />
    <p set:html={projectCopy.copyBlocks.feedback[2]} />
  </ProjectProse>

  <ProjectImage src="Monitor in Hub.png" alt="ParentPal monitor in hub" />

  <div class="project-block project-block--before-image">
    <div class="project-detail-grid">
      <img src={projectImage('Button Close-up w bkgd.png')} alt="Power/deafen button close-up" loading="lazy" />
      <img src={projectImage('Base Close-up w bkgd.png')} alt="Monitor base close-up" loading="lazy" />
    </div>
  </div>

  <div class="project-block project-block--before-image">
    <figure class="project-media">
      <img
        src={projectImage('Design Development Sketches.png')}
        alt="Design development sketches"
        class="project-media__img project-media__img--mobile-short"
        loading="lazy"
      />
    </figure>
  </div>

  <div class="project-block project-block--flush">
    <figure class="project-media">
      <img
        src={projectImage('IMG_6163.jpg')}
        alt="ParentPal prototype in use"
        class="project-media__img"
        loading="lazy"
      />
    </figure>
  </div>
</ProjectLayout>
