---
import Layout from '../layouts/Layout.astro';
import ProjectVideo from '../components/project/ProjectVideo.astro';
import WriteupBacklink from '../components/WriteupBacklink.astro';
import DevVideoPoster from '../components/DevVideoPoster.astro';
import '../styles/project.css';
import { loadVideoPageMaxHeights } from '../lib/videoPageMaxHeight';
import VideoSideClip from '../components/VideoSideClip.astro';
import { existsSync } from 'node:fs';
import path from 'node:path';

const sideClipYoutube = 'QPW3XwBoQlw';
const sideClipArtFile = 'the-bridge-side-clip-board.png';
const sideClipArt = existsSync(path.join(process.cwd(), 'media', sideClipArtFile)) ? `/images/${sideClipArtFile}` : undefined;
const maxHeight = loadVideoPageMaxHeights();
---
<Layout title="The Bridge Residency — Vicente Cruz" noindex>
  <main id="main-content" class="application-video">
    <div class="application-video__column" style={`--saved-max-vh-desktop: ${maxHeight.desktop}; --saved-max-vh-tablet: ${maxHeight.tablet}; --saved-max-vh-mobile: ${maxHeight.mobile};`}>
      <header class="application-video__masthead">
        <WriteupBacklink href="/" label="Home" />
        <h1 class="sr-only">Vicente Cruz — The Bridge Residency application video</h1>
      </header>
      <div class="application-video__stage">
        <ProjectVideo
          src="the-bridge-1min-video-nov2026-application.mp4"
          poster="the-bridge-1min-video-nov2026-application-poster.jpg"
          alt="Vicente Cruz introduces himself"
          aspectRatio="9:16"
          spacing="none"
          rounded
        />
        <VideoSideClip youtube={sideClipYoutube} label="skateboard" art={sideClipArt} />
      </div>
    </div>
  </main>
  {import.meta.env.DEV && <DevVideoPoster />}
</Layout>

<style>
  .application-video {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: var(--space-unit);
  }

  .application-video__column {
    --masthead-height: calc(var(--text-body-size) * var(--text-body-leading) + var(--space-unit));
    --max-vh: var(--video-page-max-vh-desktop, var(--saved-max-vh-desktop));
    position: relative;
    width: min(100%, calc(min(100dvh - 2 * var(--space-unit) - 2 * var(--masthead-height), var(--max-vh) * 1dvh) * 9 / 16));
  }

  @media (max-width: 991px) {
    .application-video__column { --max-vh: var(--video-page-max-vh-tablet, var(--saved-max-vh-tablet)); }
  }

  @media (max-width: 767px) {
    .application-video__column { --max-vh: var(--video-page-max-vh-mobile, var(--saved-max-vh-mobile)); }
  }

  .application-video__stage {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
  }

  .application-video__stage > :global(.project-block) {
    position: relative;
    z-index: 1;
  }

  .application-video__masthead {
    position: absolute;
    bottom: 100%;
    left: 0;
    display: flex;
    height: calc(var(--text-body-size) * var(--text-body-leading));
    margin-bottom: var(--space-unit);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
  }
</style>
