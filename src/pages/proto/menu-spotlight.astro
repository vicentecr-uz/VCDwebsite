---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectSections from '../../components/project/ProjectSections.astro';
import SpotlightHarness from '../../prototypes/menu-spotlight/SpotlightHarness.astro';
import HomeIntroController from '../../components/home/HomeIntroController.astro';
import { loadPageDocument } from '../../lib/projects';
import { pageColumnStyle } from '../../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../../lib/projectStack';

const homePage = loadPageDocument('home');
const introPage = loadPageDocument('home-intro');
---

<Layout title="Menu spotlight prototype" columnStyle={pageColumnStyle(homePage.sections)}>
  <meta name="robots" content="noindex, nofollow" />
  <div class="spotlight-page" data-page-shell>
    <Header navMenu wordmarkAsH1 />
    <script is:inline>
      {
        // Keep this isolated prototype's header semantics aligned with Home.
        const header = document.querySelector('.spotlight-page .site-header');
        header.querySelector('.header-trigger--start').classList.add('header-trigger--home');
        header.querySelectorAll('.header-trigger__brand-link').forEach((link) => link.removeAttribute('href'));
        header.querySelectorAll('.header-menu__link').forEach((link) => {
          const path = new URL(link.getAttribute('href'), window.location.href).pathname.replace(/\/+$/, '') || '/';
          const current = path === '/';
          link.toggleAttribute('data-current-page', current);
          if (current) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
          link.closest('.header-menu__item').classList.toggle('header-menu__item--current-page', current);
        });
      }
    </script>
    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone data-page-document="home">
        <ProjectSections documentKey="home" sections={homePage.sections} introHeight={homePage.introHeight} />
        <div class:list={[projectStackClass(homePage.trailingSpacing ?? 'none')]} {...(spacingDevAttrs('home', ['sections', homePage.sections.length], homePage.trailingSpacing ?? 'none', { writePath: ['trailingSpacing'] }) ?? {})} />
      </div>
    </main>
    <Footer />
  </div>
  <template data-spotlight-home-intro><HomeIntroController page={introPage} /></template>
  <SpotlightHarness />
</Layout>

<style>
  .spotlight-page { position: relative; z-index: 0; min-height: calc(var(--vh-safe, 1svh) * 100); display: flex; flex-direction: column; }
  .listing-main { padding: 0; }
</style>
