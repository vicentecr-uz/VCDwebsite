---
import DemoLayout from '../../layouts/DemoLayout.astro';
import ProjectSignup from '../../components/project/ProjectSignup.astro';
---

<DemoLayout title="Signup success motion">
  {import.meta.env.DEV && (
    <script>
      import '@aiforui/lapse/install';
      import { mountLapse } from '@aiforui/lapse/panel';
      mountLapse();
    </script>
  )}
  <div id="proto-root" class="proto-root">
    <section class="proto-context">
      <p class="proto-kicker">Newsletter</p>
      <p class="proto-lede">No faff. Just newsletter-exclusive content every whenever, once a month at most.</p>
      <div id="stage" data-signup-proto>
        <ProjectSignup />
      </div>
    </section>
  </div>

  <aside class="proto-panel" aria-label="Motion controls">
    <p class="proto-panel-title">Success motion</p>
    <label>Speed
      <select data-ctrl="speed">
        <option value="1" selected>1×</option>
        <option value="0.5">0.5×</option>
        <option value="0.25">0.25×</option>
      </select>
    </label>
    <label>Ease
      <select data-ctrl="ease">
        <option value="cubic-bezier(0.25, 0.46, 0.45, 0.94)">ease-out-quad</option>
        <option value="cubic-bezier(0.215, 0.61, 0.355, 1)">ease-out-cubic</option>
        <option value="cubic-bezier(0.165, 0.84, 0.44, 1)">ease-out-quart</option>
        <option value="cubic-bezier(0.23, 1, 0.32, 1)" selected>ease-out-quint</option>
        <option value="cubic-bezier(0.32, 0.72, 0, 1)">ease-out-strong</option>
        <option value="cubic-bezier(0.645, 0.045, 0.355, 1)">ease-in-out-cubic</option>
      </select>
    </label>
    <p class="proto-panel-group">Letters out</p>
    <label>Stagger <output data-out="stagger">10ms</output>
      <input data-ctrl="stagger" type="range" min="0" max="80" step="1" value="10" />
    </label>
    <label>Char duration <output data-out="charMs">500ms</output>
      <input data-ctrl="charMs" type="range" min="80" max="1000" step="10" value="500" />
    </label>
    <label>Travel <output data-out="move">8px</output>
      <input data-ctrl="move" type="range" min="0" max="40" step="1" value="8" />
    </label>
    <label>Edge extra travel <output data-out="taper">0.20</output>
      <input data-ctrl="taper" type="range" min="0" max="100" step="5" value="20" />
    </label>
    <label>Scale to <output data-out="scale">0.97</output>
      <input data-ctrl="scale" type="range" min="90" max="100" step="1" value="97" />
    </label>
    <label>Blur <output data-out="blur">10px</output>
      <input data-ctrl="blur" type="range" min="0" max="12" step="0.5" value="10" />
    </label>
    <p class="proto-panel-group">Check</p>
    <label>Start early <output data-out="overlap">400ms</output>
      <input data-ctrl="overlap" type="range" min="0" max="1000" step="10" value="400" />
    </label>
    <label>Check duration <output data-out="checkMs">160ms</output>
      <input data-ctrl="checkMs" type="range" min="80" max="500" step="10" value="160" />
    </label>
    <label>Hold <output data-out="hold">1400ms</output>
      <input data-ctrl="hold" type="range" min="400" max="4000" step="100" value="1400" />
    </label>
    <p class="proto-panel-group">Email out</p>
    <label>Vs check-out <output data-out="emailVsCheck">0ms</output>
      <input data-ctrl="emailVsCheck" type="range" min="-400" max="400" step="10" value="0" />
    </label>
    <label>Anticipate <output data-out="anticipate">10px</output>
      <input data-ctrl="anticipate" type="range" min="0" max="24" step="1" value="10" />
    </label>
    <label>Anticipate time <output data-out="anticipateMs">100ms</output>
      <input data-ctrl="anticipateMs" type="range" min="40" max="240" step="10" value="100" />
    </label>
    <label>Travel <output data-out="emailMs">520ms</output>
      <input data-ctrl="emailMs" type="range" min="200" max="1200" step="10" value="520" />
    </label>
    <p class="proto-panel-group">Letters back</p>
    <label>Start at <output data-out="returnAt">25%</output>
      <input data-ctrl="returnAt" type="range" min="0" max="100" step="5" value="25" />
    </label>
    <label>Spread <output data-out="returnSpan">55%</output>
      <input data-ctrl="returnSpan" type="range" min="10" max="100" step="5" value="55" />
    </label>
    <label>Return duration <output data-out="returnMs">220ms</output>
      <input data-ctrl="returnMs" type="range" min="80" max="800" step="10" value="220" />
    </label>
    <p class="proto-panel-group">Placeholder</p>
    <label>Wait <output data-out="placeholderWait">400ms</output>
      <input data-ctrl="placeholderWait" type="range" min="0" max="2000" step="50" value="400" />
    </label>
    <p class="proto-panel-note">Empty / invalid submit uses the real field status. Scale and blur for letters back come from Letters out.</p>
    <button type="button" class="proto-copy">Copy config</button>
    <button type="button" class="proto-copy proto-save">Save</button>
    <button type="button" class="proto-copy proto-revert">Revert</button>
  </aside>

  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    <button class="proto-picker-item" data-active aria-current="true">Success</button>
    <span class="proto-picker-divider" aria-hidden="true"></span>
    <button class="proto-picker-item proto-picker-replay" aria-label="Replay animation (R)">↻</button>
  </nav>
</DemoLayout>

<style is:global>
  html, body {
    background: var(--sys-color-srf);
  }

  .proto-root {
    --stagger: 10;
    --char-ms: 500;
    --move: 8;
    --taper: 20;
    --scale-to: 0.97;
    --blur: 10;
    --overlap: 400;
    --check-ms: 160;
    --hold: 1400;
    --email-vs-check: 0;
    --anticipate: 10;
    --anticipate-ms: 100;
    --email-ms: 520;
    --return-at: 25;
    --return-span: 55;
    --return-ms: 220;
    --placeholder-wait: 400;
    --speed: 1;
    --ease: cubic-bezier(0.23, 1, 0.32, 1);
    width: min(40em, 100%);
  }

  .proto-context {
    width: min(40em, 100%);
    padding-bottom: 4.5rem;
  }

  .proto-kicker {
    margin: 0 0 0.5rem;
    font: 600 0.75rem / 1.3 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sys-color-on-srf-subtle);
  }

  .proto-lede {
    margin: 0 0 1.25rem;
    font: 400 var(--text-body-size) / var(--text-body-leading) var(--font-sans);
    color: var(--sys-color-on-srf);
    max-width: 36em;
  }

  .proto-root .project-signup__check:not([hidden]) {
    transform: scale(1.03);
    transition-duration: calc(var(--check-ms) * var(--speed) * 1ms);
    transition-timing-function: var(--ease);
  }

  .proto-root .project-signup__check.is-in {
    transform: scale(1);
  }

  .proto-root .project-signup__check.is-out {
    opacity: 0;
    transform: scale(0.97);
    filter: blur(4px);
    -webkit-filter: blur(4px);
  }

  .proto-email-ghost {
    position: absolute;
    display: inline-flex;
    align-items: center;
    margin: 0;
    white-space: nowrap;
    pointer-events: none;
    z-index: 1;
    color: var(--sys-color-on-srf);
  }

  .proto-email-ghost.is-placeholder {
    color: var(--sys-color-on-srf-subtle);
  }

  .proto-root .dev-field__input.is-proto-ghosted {
    color: transparent;
    caret-color: transparent;
  }

  .proto-root .dev-field__input.is-proto-placeholder-pending::placeholder {
    color: transparent;
    opacity: 0;
  }

  .proto-root .dev-text-field.is-proto-fade::after {
    opacity: 1;
  }

  .proto-panel-note {
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    line-height: 1.35;
  }

  .proto-panel {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 2147483647;
    width: 260px;
    max-height: calc(100vh - 96px);
    overflow: auto;
    padding: 12px;
    border-radius: 12px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(0, 0, 0, 0.24);
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 12px;
    line-height: 1.3;
    -webkit-font-smoothing: antialiased;
  }

  .proto-panel-title,
  .proto-panel-group {
    margin: 0 0 8px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .proto-panel-group {
    margin-top: 12px;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
  }

  .proto-panel label {
    display: grid;
    gap: 4px;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.8);
  }

  .proto-panel output {
    float: right;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }

  .proto-panel input[type="range"],
  .proto-panel select {
    width: 100%;
    accent-color: #fff;
  }

  .proto-panel select {
    height: 28px;
    border: 0;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .proto-copy {
    width: 100%;
    height: 28px;
    margin-top: 4px;
    border: 0;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  .proto-copy:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 2px;
  }

  .proto-picker {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2147483647;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(0, 0, 0, 0.24),
      0 2px 6px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }

  .proto-picker-highlight {
    position: absolute;
    top: 4px;
    left: 0;
    height: 28px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    will-change: transform;
  }

  .proto-picker[data-ready] .proto-picker-highlight {
    transition:
      transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
      width 250ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .proto-picker[data-ready] .proto-picker-highlight { transition: none; }
  }

  .proto-picker-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font: inherit;
    cursor: pointer;
    transition: color 150ms ease-out;
  }

  .proto-picker-item:hover { color: rgba(255, 255, 255, 0.85); }
  .proto-picker-item:active { transform: scale(0.97); }
  .proto-picker-item:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 2px;
  }
  .proto-picker-item[data-active] { color: #fff; }

  .proto-picker-divider {
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: rgba(255, 255, 255, 0.12);
  }

  .proto-picker-replay {
    padding: 0 10px;
    font-size: 14px;
  }
</style>

<script>
  const root = document.getElementById('proto-root');
  const stage = document.getElementById('stage');
  const picker = document.querySelector('.proto-picker');
  const highlight = picker.querySelector('.proto-picker-highlight');
  const items = [...picker.querySelectorAll('.proto-picker-item:not(.proto-picker-replay)')];
  const replay = picker.querySelector('.proto-picker-replay');
  const DEMO_EMAIL = 'jternus@apple.com';
  let current = 0;
  let playing = false;
  let playId = 0;
  let ghost = null;

  const form = () => stage.querySelector('[data-project-signup-form]');
  const parts = () => {
    const el = form();
    return {
      form: el,
      input: el?.querySelector('[data-signup-email]'),
      label: el?.querySelector('[data-signup-label]'),
      check: el?.querySelector('[data-signup-check]'),
      button: el?.querySelector('button[type=submit]'),
      shortcut: el?.querySelector('[data-signup-shortcut]'),
      textField: el?.querySelector('.dev-text-field'),
      content: el?.querySelector('.dev-text-field__content'),
    };
  };

  const num = (name, fallback) => {
    const raw = getComputedStyle(root).getPropertyValue(name).trim();
    const parsed = Number.parseFloat(raw);
    return Number.isFinite(parsed) ? parsed : fallback;
  };

  const cfg = () => {
    const speed = num('--speed', 1);
    return {
      stagger: num('--stagger', 10) * speed,
      charMs: num('--char-ms', 500) * speed,
      move: num('--move', 8),
      taper: num('--taper', 20) / 100,
      scale: num('--scale-to', 0.97),
      blur: num('--blur', 10),
      overlap: num('--overlap', 400) * speed,
      checkMs: num('--check-ms', 160) * speed,
      hold: num('--hold', 1400) * speed,
      emailVsCheck: num('--email-vs-check', 0) * speed,
      anticipate: num('--anticipate', 10),
      anticipateMs: num('--anticipate-ms', 100) * speed,
      emailMs: num('--email-ms', 520) * speed,
      returnAt: num('--return-at', 25) / 100,
      returnSpan: num('--return-span', 55) / 100,
      returnMs: num('--return-ms', 220) * speed,
      placeholderWait: num('--placeholder-wait', 400) * speed,
      ease: getComputedStyle(root).getPropertyValue('--ease').trim() || 'cubic-bezier(0.23, 1, 0.32, 1)',
      speed,
    };
  };

  const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
  const settled = (animation) => animation.finished.catch(() => undefined);

  const waitCheck = (el, ms) => new Promise((resolve) => {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      el.removeEventListener('transitionend', onEnd);
      resolve();
    };
    const onEnd = (event) => {
      if (event.target === el && event.propertyName === 'opacity') finish();
    };
    el.addEventListener('transitionend', onEnd);
    setTimeout(finish, ms + 80);
  });

  const teardownGhost = () => {
    const { input, textField } = parts();
    ghost?.remove();
    ghost = null;
    input?.classList.remove('is-proto-ghosted');
    textField?.classList.remove('is-proto-fade');
  };

  const fillDemoEmail = () => {
    const { input } = parts();
    if (!input) return;
    input.value = DEMO_EMAIL;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  };

  const resetVisuals = () => {
    const { form: el, input, label, check, button } = parts();
    playId += 1;
    playing = false;
    if (el) delete el.dataset.protoPlaying;
    teardownGhost();
    [label, check, input, el].forEach((node) => {
      node?.getAnimations?.().forEach((a) => a.cancel());
    });
    label?.querySelectorAll('[data-char]').forEach((node) => {
      node.getAnimations().forEach((a) => a.cancel());
      node.style.cssText = '';
    });
    if (label) {
      label.hidden = false;
      label.getAnimations().forEach((a) => a.cancel());
    }
    if (check) {
      check.hidden = true;
      check.classList.remove('is-in', 'is-out', 'is-reduced');
    }
    if (input) {
      input.readOnly = false;
      input.classList.remove('is-proto-placeholder-pending');
    }
    button?.removeAttribute('aria-busy');
    el?.classList.remove('is-error', 'has-status');
  };

  const mountEmailGhost = () => {
    const { input, textField } = parts();
    const track = textField?.querySelector('.dev-text-field__track');
    if (!input || !textField || !track) return null;
    const next = document.createElement('span');
    next.className = 'proto-email-ghost';
    next.setAttribute('aria-hidden', 'true');
    const style = getComputedStyle(input);
    const inputRect = input.getBoundingClientRect();
    const trackRect = track.getBoundingClientRect();
    next.style.font = style.font;
    next.style.letterSpacing = style.letterSpacing;
    next.style.left = `${inputRect.left - trackRect.left + track.scrollLeft}px`;
    next.style.top = `${inputRect.top - trackRect.top}px`;
    next.style.height = `${inputRect.height}px`;
    next.textContent = input.value;
    track.append(next);
    input.classList.add('is-proto-ghosted');
    textField.classList.add('is-proto-fade');
    ghost = next;
    return next;
  };

  const playEmailAndReturn = async (c, reduce, label, chars, input) => {
    const emailEl = reduce ? null : mountEmailGhost();
    const { textField } = parts();
    const fadeWidth = Number.parseFloat(
      getComputedStyle(textField ?? document.documentElement)
        .getPropertyValue('--dev-text-field-fade-width'),
    ) || 22;
    const travelPx = emailEl && textField
      ? textField.getBoundingClientRect().right - emailEl.getBoundingClientRect().left + fadeWidth
      : 0;
    const runEmail = async () => {
      if (reduce) {
        input.classList.add('is-proto-ghosted');
        await settled(input.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: c.emailMs, easing: c.ease, fill: 'forwards' },
        ));
        return;
      }
      if (!emailEl) return;
      if (c.anticipate > 0 && c.anticipateMs > 0) {
        await settled(emailEl.animate(
          [
            { transform: 'translateX(0)' },
            { transform: `translateX(${-c.anticipate}px)` },
          ],
          { duration: c.anticipateMs, easing: 'cubic-bezier(0.645, 0.045, 0.355, 1)', fill: 'forwards' },
        ));
      }
      await settled(emailEl.animate(
        [
          { transform: `translateX(${-c.anticipate}px)` },
          { transform: `translateX(${travelPx}px)` },
        ],
        { duration: c.emailMs, easing: c.ease, fill: 'forwards' },
      ));
    };
    const emailDone = runEmail();
    label.hidden = false;
    const n = chars.length;
    const start = reduce ? 0 : c.anticipateMs + c.returnAt * c.emailMs;
    const span = reduce ? Math.max(0, n - 1) * 30 : c.returnSpan * c.emailMs;
    const returnAnims = chars.map((el, i) => el.animate(
      reduce
        ? [{ opacity: 0 }, { opacity: 1 }]
        : [
          { opacity: 0, filter: `blur(${c.blur}px)`, transform: `scale(${c.scale})` },
          { opacity: 1, filter: 'blur(0px)', transform: 'scale(1)' },
        ],
      {
        duration: c.returnMs,
        delay: start + (n <= 1 ? 0 : (i / (n - 1)) * span),
        easing: c.ease,
        fill: 'both',
      },
    ));
    await Promise.all([emailDone, ...returnAnims.map(settled)]);
    if (input) {
      input.classList.add('is-proto-placeholder-pending');
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.getAnimations().forEach((a) => a.cancel());
    }
    teardownGhost();
    chars.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
    label.getAnimations().forEach((a) => a.cancel());
  };

  const revealPlaceholder = async (c, reduce, input, id) => {
    if (id !== playId || !input) return;
    if (input.value || document.activeElement === input) {
      input.classList.remove('is-proto-placeholder-pending');
      return;
    }
    const { textField } = parts();
    const track = textField?.querySelector('.dev-text-field__track');
    if (!track) {
      input.classList.remove('is-proto-placeholder-pending');
      return;
    }
    const next = document.createElement('span');
    next.className = 'proto-email-ghost is-placeholder';
    next.setAttribute('aria-hidden', 'true');
    const style = getComputedStyle(input);
    const inputRect = input.getBoundingClientRect();
    const trackRect = track.getBoundingClientRect();
    next.style.font = style.font;
    next.style.letterSpacing = style.letterSpacing;
    next.style.left = `${inputRect.left - trackRect.left + track.scrollLeft}px`;
    next.style.top = `${inputRect.top - trackRect.top}px`;
    next.style.height = `${inputRect.height}px`;
    next.textContent = input.placeholder;
    track.append(next);
    ghost = next;
    await settled(next.animate(
      reduce
        ? [{ opacity: 0 }, { opacity: 1 }]
        : [
          { opacity: 0, filter: 'blur(4px)' },
          { opacity: 1, filter: 'blur(0px)' },
        ],
      { duration: 220 * c.speed, easing: c.ease, fill: 'forwards' },
    ));
    if (id !== playId) return;
    next.remove();
    if (ghost === next) ghost = null;
    input.classList.remove('is-proto-placeholder-pending');
  };

  const startCheckOut = (check) => {
    check.classList.remove('is-in');
    check.classList.add('is-out');
  };

  const play = async () => {
    const { form: el, input, label, check, button, shortcut } = parts();
    if (!el || !input || !label || !check || playing) return;
    const id = ++playId;
    playing = true;
    el.dataset.protoPlaying = 'true';
    button?.setAttribute('aria-busy', 'true');
    input.readOnly = true;
    if (shortcut) shortcut.hidden = true;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const c = cfg();
    const chars = [...label.querySelectorAll('[data-char]')];
    const n = chars.length;
    const center = Math.max(n - 1, 1) / 2;
    const lastEnd = Math.max(...chars.map((_, i) => Math.min(i, n - 1 - i) * c.stagger + c.charMs));
    chars.forEach((node, i) => {
      const fromEdge = Math.min(i, n - 1 - i);
      const dist = Math.abs(i - center) / center;
      const dir = i < center ? 1 : i > center ? -1 : 0;
      const travel = c.move * (c.taper * dist + (1 - c.taper));
      const x = reduce ? 0 : dir * travel;
      node.animate(
        [
          { opacity: 1, filter: 'blur(0px)', transform: 'translateX(0) scale(1)' },
          { opacity: 0, filter: `blur(${reduce ? 0 : c.blur}px)`, transform: `translateX(${x}px) scale(${reduce ? 1 : c.scale})` },
        ],
        { duration: c.charMs, delay: fromEdge * c.stagger, easing: c.ease, fill: 'forwards' },
      );
    });
    await wait(Math.max(0, lastEnd - c.overlap));
    check.hidden = false;
    check.classList.remove('is-in', 'is-out');
    void check.offsetWidth;
    requestAnimationFrame(() => requestAnimationFrame(() => check.classList.add('is-in')));
    await waitCheck(check, c.checkMs);
    await Promise.all(chars.map((node) => Promise.all(node.getAnimations().map(settled))));
    label.hidden = true;
    chars.forEach((node) => node.getAnimations().forEach((a) => a.cancel()));
    await wait(c.hold);
    let exitPromise = Promise.resolve();
    if (c.emailVsCheck >= 0) {
      startCheckOut(check);
      const checkDone = waitCheck(check, c.checkMs);
      if (c.emailVsCheck > 0) await wait(c.emailVsCheck);
      exitPromise = playEmailAndReturn(c, reduce, label, chars, input);
      await checkDone;
    } else {
      exitPromise = playEmailAndReturn(c, reduce, label, chars, input);
      await wait(-c.emailVsCheck);
      startCheckOut(check);
      await waitCheck(check, c.checkMs);
    }
    check.hidden = true;
    check.classList.remove('is-out');
    await exitPromise;
    if (input) input.readOnly = false;
    button?.removeAttribute('aria-busy');
    delete el.dataset.protoPlaying;
    playing = false;
    if (id !== playId) return;
    await wait(c.placeholderWait);
    await revealPlaceholder(c, reduce, input, id);
  };

  const remount = () => {
    resetVisuals();
    fillDemoEmail();
    requestAnimationFrame(() => void play());
  };

  const moveHighlight = () => {
    const el = items[current];
    highlight.style.width = el.offsetWidth + 'px';
    highlight.style.transform = `translateX(${el.offsetLeft}px)`;
  };

  const setActive = (i) => {
    if (i < 0 || i >= items.length) return;
    current = i;
    items.forEach((el, j) => {
      el.toggleAttribute('data-active', j === i);
      if (j === i) el.setAttribute('aria-current', 'true');
      else el.removeAttribute('aria-current');
    });
    moveHighlight();
    const url = new URL(location);
    url.searchParams.set('v', String(i + 1));
    history.replaceState(null, '', url);
    remount();
  };

  items.forEach((el, i) => el.addEventListener('click', () => setActive(i)));
  replay?.addEventListener('click', () => remount());
  window.addEventListener('resize', moveHighlight);
  document.addEventListener('keydown', (e) => {
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const n = parseInt(e.key, 10);
    if (n >= 1 && n <= items.length) setActive(n - 1);
    else if (e.key === 'ArrowRight') setActive((current + 1) % items.length);
    else if (e.key === 'ArrowLeft') setActive((current - 1 + items.length) % items.length);
    else if (e.key === 'r' || e.key === 'R') remount();
  });
  stage.addEventListener('signup:proto-success', () => void play());

  const readControls = () => {
    const speed = Number(document.querySelector('[data-ctrl=speed]').value);
    const ease = document.querySelector('[data-ctrl=ease]').value;
    const stagger = Number(document.querySelector('[data-ctrl=stagger]').value);
    const charMs = Number(document.querySelector('[data-ctrl=charMs]').value);
    const move = Number(document.querySelector('[data-ctrl=move]').value);
    const taper = Number(document.querySelector('[data-ctrl=taper]').value);
    const scale = Number(document.querySelector('[data-ctrl=scale]').value) / 100;
    const blur = Number(document.querySelector('[data-ctrl=blur]').value);
    const overlap = Number(document.querySelector('[data-ctrl=overlap]').value);
    const checkMs = Number(document.querySelector('[data-ctrl=checkMs]').value);
    const hold = Number(document.querySelector('[data-ctrl=hold]').value);
    const emailVsCheck = Number(document.querySelector('[data-ctrl=emailVsCheck]').value);
    const anticipate = Number(document.querySelector('[data-ctrl=anticipate]').value);
    const anticipateMs = Number(document.querySelector('[data-ctrl=anticipateMs]').value);
    const emailMs = Number(document.querySelector('[data-ctrl=emailMs]').value);
    const returnAt = Number(document.querySelector('[data-ctrl=returnAt]').value);
    const returnSpan = Number(document.querySelector('[data-ctrl=returnSpan]').value);
    const returnMs = Number(document.querySelector('[data-ctrl=returnMs]').value);
    const placeholderWait = Number(document.querySelector('[data-ctrl=placeholderWait]').value);
    root.style.setProperty('--speed', String(speed));
    root.style.setProperty('--ease', ease);
    root.style.setProperty('--stagger', String(stagger));
    root.style.setProperty('--char-ms', String(charMs));
    root.style.setProperty('--move', String(move));
    root.style.setProperty('--taper', String(taper));
    root.style.setProperty('--scale-to', String(scale));
    root.style.setProperty('--blur', String(blur));
    root.style.setProperty('--overlap', String(overlap));
    root.style.setProperty('--check-ms', String(checkMs));
    root.style.setProperty('--hold', String(hold));
    root.style.setProperty('--email-vs-check', String(emailVsCheck));
    root.style.setProperty('--anticipate', String(anticipate));
    root.style.setProperty('--anticipate-ms', String(anticipateMs));
    root.style.setProperty('--email-ms', String(emailMs));
    root.style.setProperty('--return-at', String(returnAt));
    root.style.setProperty('--return-span', String(returnSpan));
    root.style.setProperty('--return-ms', String(returnMs));
    root.style.setProperty('--placeholder-wait', String(placeholderWait));
    document.querySelector('[data-out=stagger]').textContent = `${stagger}ms`;
    document.querySelector('[data-out=charMs]').textContent = `${charMs}ms`;
    document.querySelector('[data-out=move]').textContent = `${move}px`;
    document.querySelector('[data-out=taper]').textContent = (taper / 100).toFixed(2);
    document.querySelector('[data-out=scale]').textContent = scale.toFixed(2);
    document.querySelector('[data-out=blur]').textContent = `${blur}px`;
    document.querySelector('[data-out=overlap]').textContent = `${overlap}ms`;
    document.querySelector('[data-out=checkMs]').textContent = `${checkMs}ms`;
    document.querySelector('[data-out=hold]').textContent = `${hold}ms`;
    document.querySelector('[data-out=emailVsCheck]').textContent = `${emailVsCheck}ms`;
    document.querySelector('[data-out=anticipate]').textContent = `${anticipate}px`;
    document.querySelector('[data-out=anticipateMs]').textContent = `${anticipateMs}ms`;
    document.querySelector('[data-out=emailMs]').textContent = `${emailMs}ms`;
    document.querySelector('[data-out=returnAt]').textContent = `${returnAt}%`;
    document.querySelector('[data-out=returnSpan]').textContent = `${returnSpan}%`;
    document.querySelector('[data-out=returnMs]').textContent = `${returnMs}ms`;
    document.querySelector('[data-out=placeholderWait]').textContent = `${placeholderWait}ms`;
  };

  document.querySelectorAll('[data-ctrl]').forEach((el) => {
    el.addEventListener('input', readControls);
  });

  const STORAGE_KEY = 'vcd:proto-signup-success';
  const factoryValues = Object.fromEntries(
    [...document.querySelectorAll('[data-ctrl]')].map((el) => [el.dataset.ctrl, el.value]),
  );

  const readSaved = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return null;
      return parsed;
    } catch {
      return null;
    }
  };

  const applyCtrlMap = (map) => {
    document.querySelectorAll('[data-ctrl]').forEach((el) => {
      const key = el.dataset.ctrl;
      if (Object.hasOwn(map, key)) el.value = String(map[key]);
    });
  };

  const snapshotControls = () => Object.fromEntries(
    [...document.querySelectorAll('[data-ctrl]')].map((el) => [el.dataset.ctrl, el.value]),
  );

  const flashButton = (btn, temp, original) => {
    btn.textContent = temp;
    setTimeout(() => { btn.textContent = original; }, 1200);
  };

  document.querySelector('.proto-copy').addEventListener('click', async () => {
    const text = [
      `stagger: ${document.querySelector('[data-ctrl=stagger]').value}ms`,
      `charDuration: ${document.querySelector('[data-ctrl=charMs]').value}ms`,
      `maxMove: ${document.querySelector('[data-ctrl=move]').value}px`,
      `edgeTaper: ${Number(document.querySelector('[data-ctrl=taper]').value) / 100}`,
      `scale: ${Number(document.querySelector('[data-ctrl=scale]').value) / 100}`,
      `blur: ${document.querySelector('[data-ctrl=blur]').value}px`,
      `checkOverlap: ${document.querySelector('[data-ctrl=overlap]').value}ms`,
      `checkDuration: ${document.querySelector('[data-ctrl=checkMs]').value}ms`,
      `hold: ${document.querySelector('[data-ctrl=hold]').value}ms`,
      `emailVsCheck: ${document.querySelector('[data-ctrl=emailVsCheck]').value}ms`,
      `anticipate: ${document.querySelector('[data-ctrl=anticipate]').value}px`,
      `anticipateMs: ${document.querySelector('[data-ctrl=anticipateMs]').value}ms`,
      `emailTravel: ${document.querySelector('[data-ctrl=emailMs]').value}ms`,
      `returnAt: ${document.querySelector('[data-ctrl=returnAt]').value}%`,
      `returnSpan: ${document.querySelector('[data-ctrl=returnSpan]').value}%`,
      `returnDuration: ${document.querySelector('[data-ctrl=returnMs]').value}ms`,
      `placeholderWait: ${document.querySelector('[data-ctrl=placeholderWait]').value}ms`,
      `ease: ${document.querySelector('[data-ctrl=ease]').value}`,
      `speed: ${document.querySelector('[data-ctrl=speed]').value}x`,
    ].join(' · ');
    await navigator.clipboard.writeText(text);
    const copyBtn = document.querySelector('.proto-copy');
    flashButton(copyBtn, 'Copied', 'Copy config');
  });

  document.querySelector('.proto-save').addEventListener('click', () => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(snapshotControls()));
    } catch { /* private mode */ }
    flashButton(document.querySelector('.proto-save'), 'Saved', 'Save');
  });

  document.querySelector('.proto-revert').addEventListener('click', () => {
    applyCtrlMap({ ...factoryValues, ...(readSaved() ?? {}) });
    readControls();
    flashButton(document.querySelector('.proto-revert'), 'Reverted', 'Revert');
  });

  const saved = readSaved();
  if (saved) applyCtrlMap(saved);
  readControls();
  setActive((parseInt(new URLSearchParams(location.search).get('v'), 10) || 1) - 1);
  requestAnimationFrame(() => requestAnimationFrame(() => picker.setAttribute('data-ready', '')));
</script>
