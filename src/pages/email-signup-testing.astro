---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectBodyText from '../components/project/ProjectBodyText.astro';
import ProjectSignup from '../components/project/ProjectSignup.astro';
import '../styles/project.css';

const results = Astro.url.searchParams.has('results');
---

<Layout
  title="Email signup testing — Vicente Cruz"
  description="Try two subscribe animations and pick the one that felt better."
  robots="noindex,nofollow"
>
  <div class="flex min-h-dvh flex-col">
    <Header navMenu />
    <h1 class="sr-only">Email signup testing</h1>
    <main id="main-content" class="listing-main signup-test" style="flex: 1;">
      <ProjectBodyText
        spacing="section"
        balance
        paragraphs={[
          '<span class="text-emphasis">Email signup</span>',
          'Two versions of the subscribe animation. Type any email and press Enter — this page does not add you to the list. Then pick the one that felt better.',
        ]}
      />
      <div class="signup-test__pair" data-signup-compare>
        <article class="signup-test__col" data-variant="current">
          <h2 class="signup-test__label">Current</h2>
          <ProjectSignup
            compare
            variant="current"
            spacing="related"
            sectionId="signup-current"
            placeholder="jternus@apple.com"
          />
          <label class="signup-test__pick">
            <input type="radio" name="signup-pref" value="current" form="signup-pref" />
            I prefer this
          </label>
        </article>
        <article class="signup-test__col" data-variant="throw">
          <h2 class="signup-test__label">Throw first</h2>
          <ProjectSignup
            compare
            variant="throw"
            spacing="related"
            sectionId="signup-throw"
            placeholder="jternus@apple.com"
          />
          <label class="signup-test__pick">
            <input type="radio" name="signup-pref" value="throw" form="signup-pref" />
            I prefer this
          </label>
        </article>
      </div>
      <form class="signup-test__vote" id="signup-pref" data-signup-pref-form>
        <label class="signup-test__why">
          Why? <span class="signup-test__optional">(optional)</span>
          <textarea name="why" rows="3" maxlength="2000" autocomplete="off"></textarea>
        </label>
        <button type="submit">Submit preference</button>
        <p class="signup-test__status" data-signup-pref-status hidden></p>
      </form>
      {results && (
        <section class="signup-test__results" data-signup-pref-results hidden>
          <h2>Tally</h2>
          <p data-signup-pref-tally>Loading…</p>
          <ul data-signup-pref-comments></ul>
        </section>
      )}
    </main>
    <Footer />
  </div>
</Layout>

<script>
  const pair = document.querySelector<HTMLElement>('[data-signup-compare]');
  const form = document.querySelector<HTMLFormElement>('[data-signup-pref-form]');
  const status = document.querySelector<HTMLElement>('[data-signup-pref-status]');
  if (pair && pair.children[0] && Math.random() < 0.5) {
    pair.append(pair.children[0]);
  }
  const order = pair
    ? ([...pair.querySelectorAll<HTMLElement>('[data-variant]')]
      .map((el) => el.dataset.variant)
      .filter((value): value is 'current' | 'throw' => value === 'current' || value === 'throw'))
    : [];

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const picked = document.querySelector<HTMLInputElement>('input[name="signup-pref"]:checked');
    if (!picked) {
      if (status) {
        status.hidden = false;
        status.textContent = 'Pick a version first.';
      }
      return;
    }
    const why = form.querySelector<HTMLTextAreaElement>('[name="why"]')?.value ?? '';
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      const response = await fetch('/api/signup-pref', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ choice: picked.value, why, order }),
      });
      const body = await response.json().catch(() => ({})) as { error?: string };
      if (!response.ok) {
        if (status) {
          status.hidden = false;
          status.textContent = body.error || 'Could not save that.';
        }
        if (submit) submit.disabled = false;
        return;
      }
      form.hidden = true;
      pair?.querySelectorAll<HTMLInputElement>('input[name="signup-pref"]').forEach((input) => {
        input.disabled = true;
      });
      if (status) {
        status.hidden = false;
        status.textContent = 'Saved. Thanks.';
        form.after(status);
      }
    } catch {
      if (status) {
        status.hidden = false;
        status.textContent = 'Could not save that.';
      }
      if (submit) submit.disabled = false;
    }
  });

  const results = document.querySelector<HTMLElement>('[data-signup-pref-results]');
  if (results) {
    results.hidden = false;
    const tally = results.querySelector('[data-signup-pref-tally]');
    const comments = results.querySelector('[data-signup-pref-comments]');
    const key = new URLSearchParams(location.search).get('key');
    const url = key ? `/api/signup-pref?key=${encodeURIComponent(key)}` : '/api/signup-pref';
    void fetch(url).then(async (response) => {
      const body = await response.json().catch(() => ({})) as {
        current?: number;
        throw?: number;
        total?: number;
        error?: string;
        votes?: Array<{ choice: string; why: string; at: string }>;
      };
      if (!response.ok) {
        if (tally) tally.textContent = body.error || 'Could not load results.';
        return;
      }
      if (tally) {
        tally.textContent = `Current ${body.current ?? 0} · Throw first ${body.throw ?? 0} · ${body.total ?? 0} total`;
      }
      body.votes?.forEach((vote) => {
        if (!vote.why || !comments) return;
        const item = document.createElement('li');
        const label = vote.choice === 'throw' ? 'Throw first' : 'Current';
        item.textContent = `${label} — ${vote.why}`;
        comments.append(item);
      });
    });
  }
</script>

<style>
  .listing-main {
    padding: 0;
  }

  .signup-test {
    padding-bottom: calc(var(--space-unit) * 4);
  }

  .signup-test__pair {
    display: grid;
    gap: calc(var(--space-unit) * 3);
    grid-template-columns: 1fr;
    padding-inline: 0;
  }

  @media (min-width: 64em) {
    .signup-test__pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: calc(var(--space-unit) * 2);
    }
  }

  .signup-test__col {
    min-width: 0;
  }

  .signup-test__label {
    margin: 0 0 var(--space-related);
    color: var(--sys-color-on-srf);
    font-size: var(--text-heading-2-size, 1.25rem);
    font-weight: var(--text-heading-2-weight, 600);
    letter-spacing: var(--text-heading-2-tracking, -0.02em);
    line-height: var(--text-heading-2-leading, 1.2);
  }

  .signup-test__pick {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-group);
    min-height: 44px;
    color: var(--sys-color-on-srf);
    font-size: 1rem;
    cursor: pointer;
  }

  .signup-test__pick input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--sys-color-on-srf);
  }

  .signup-test__vote {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-related);
    margin-top: calc(var(--space-unit) * 3);
    max-width: 40em;
  }

  .signup-test__why {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    color: var(--sys-color-on-srf);
    font-size: 1rem;
  }

  .signup-test__optional {
    color: var(--sys-color-on-srf-subtle);
  }

  .signup-test__why textarea {
    width: 100%;
    min-height: 5.5rem;
    padding: 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--sys-color-srf-container-lowest);
    color: var(--sys-color-on-srf);
    font: inherit;
    font-size: 1rem;
    resize: vertical;
  }

  .signup-test__why textarea:focus-visible {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: 2px;
  }

  .signup-test__vote button {
    appearance: none;
    min-height: 2.625rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--comp-button-filled-container);
    color: var(--comp-button-filled-label);
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }

  .signup-test__vote button:hover,
  .signup-test__vote button:active {
    background: var(--comp-button-filled-container-hover);
  }

  .signup-test__vote button:focus-visible {
    outline: 2px solid var(--sys-color-on-srf);
    outline-offset: 2px;
  }

  .signup-test__vote button:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .signup-test__status {
    margin: 0;
    color: var(--sys-color-on-srf-subtle);
    font-size: 1rem;
  }

  .signup-test__results {
    margin-top: calc(var(--space-unit) * 4);
    max-width: 40em;
  }

  .signup-test__results h2 {
    margin: 0 0 var(--space-related);
    font-size: var(--text-heading-2-size, 1.25rem);
    font-weight: var(--text-heading-2-weight, 600);
  }

  .signup-test__results ul {
    padding-left: 1.2rem;
  }

  .signup-test__results li {
    margin: 0.4rem 0;
  }
</style>
