---
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';
import ProjectSections from '../../components/project/ProjectSections.astro';
import { loadPageDocument } from '../../lib/projects';

import { sabiDocsPages } from '../../lib/sabi-docs-pages';

export function getStaticPaths() {
  return sabiDocsPages
    .filter(({ optional, key }) => import.meta.env.DEV || !optional || loadPageDocument(key).sections.length)
    .map(({ slug }) => ({ params: { page: slug } }));
}
const pages = sabiDocsPages.map(({ key, ...entry }) => ({ ...entry, document: loadPageDocument(key), key }))
  .filter(({ optional, document }) => !optional || document.sections.length);
const index = pages.findIndex(page => page.slug === Astro.params.page);
const current = pages[index] ?? sabiDocsPages.find(page => page.slug === Astro.params.page)!;
const page = 'document' in current ? current.document : loadPageDocument(current.key);
// Deployed builds serve the docs from the root of sabi.vicentecr.uz (functions/_middleware.ts
// redirects every /sabi path there), so /sabi links would cost a redirect on each click.
const base = import.meta.env.DEV ? '/sabi' : '';
const links = pages.map(({ slug, label, group, document }) => ({
  href: `${base}/${slug}`,
  current: slug === Astro.params.page,
  label: slug === 'introduction' ? document.title ?? label : label,
  group,
}));
const contents = page.sections.filter(section => section.type === 'sectionTitle' && section.sectionId)
  .map(section => ({ id: String(section.sectionId), label: String(section.title) }));
---
<DocumentationLayout homeHref={base || '/'} title={page.title ?? current.label} documentKey={current.key} canonicalUrl={`https://sabi.vicentecr.uz/${current.slug}`} description={page.description} pages={links} contents={contents} previous={links[index - 1]} next={links[index + 1]}>
  <div data-dev-project-drop-zone>
    <ProjectSections documentKey={current.key} sections={page.sections} />
  </div>
</DocumentationLayout>
