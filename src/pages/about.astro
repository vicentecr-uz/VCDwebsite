---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import DevImageDrop from '../components/DevImageDrop.astro';
import '../styles/project.css';
import { loadPageDocument } from '../lib/projects';
import { pageColumnStyle } from '../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const aboutPage = loadPageDocument('about');
---
<Layout persistentNavigation title="About — Vicente Cruz" columnStyle={pageColumnStyle(aboutPage.sections)}>
  <div data-page-shell class="flex flex-col min-h-dvh">
    <Header />

    <h1 class="sr-only">About — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="about" sections={aboutPage.sections} introHeight={aboutPage.introHeight} />
        <div
          class:list={[projectStackClass(aboutPage.trailingSpacing ?? 'none')]}
          {...(spacingDevAttrs('about', ['sections', aboutPage.sections.length], aboutPage.trailingSpacing ?? 'none', { writePath: ['trailingSpacing'] }) ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
  <DevImageDrop documentKey="about" />
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
