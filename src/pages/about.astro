---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const experience = [
  { years: "'25",        role: 'Junior Industrial Designer',   company: 'Kingfisher' },
  { years: "'24–'25",    role: 'Graduate Industrial Designer', company: 'Kingfisher' },
  { years: "'23–'24",    role: 'Assistant CAD Designer',       company: 'Billy Lloyd / Monno Design' },
  { years: "'22–'24",    role: 'Art Direction',                company: 'FixIts' },
  { years: "'22–'23",    role: 'Assistant CMF Designer',       company: 'Chris Lefteri Design' },
  { years: "'20–'24",    role: 'BA Product & Industrial Design', company: 'UAL: CSM' },
  { years: "'18–'22",    role: 'Graphic Designer',             company: 'MH Customs' },
];
---

<Layout title="About — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header />

    <main class="flex-1 py-8">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 max-w-4xl">

        <!-- Photo -->
        <div class="aspect-[3/4] bg-[#e8e6e1] overflow-hidden">
          <img
            src="/images/1Q1A6418%20(Custom).jpg"
            alt="Vicente Cruz"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Content -->
        <div class="flex flex-col gap-10">
          <!-- Bio -->
          <section>
            <p class="leading-relaxed mb-3" style="font-family: var(--font-serif); font-size: 1.25rem">
              Hey there, I'm Vince, a London-based industrial designer with a keen interest in digital sculpting.
            </p>
          </section>

          <!-- Experience -->
          <section>
            <h2 class="text-xs uppercase tracking-widest mb-4" style="color: var(--color-text-muted)">Experience</h2>
            <ul class="space-y-3">
              {experience.map((item) => (
                <li class="flex items-baseline justify-between gap-4 border-b pb-3" style="border-color: var(--color-border)">
                  <div>
                    <span class="text-sm font-medium">{item.role}</span>
                    <span class="text-sm" style="color: var(--color-text-muted)"> — {item.company}</span>
                  </div>
                  <span class="text-xs shrink-0" style="color: var(--color-text-muted)">{item.years}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Contact -->
          <section>
            <h2 class="text-xs uppercase tracking-widest mb-4" style="color: var(--color-text-muted)">Contact</h2>
            <ul class="flex flex-col gap-2">
              <li>
                <a href="mailto:heya@vcruzdesigns.com" class="text-sm hover:opacity-60 transition-opacity duration-200">
                  heya@vcruzdesigns.com
                </a>
              </li>
              <li>
                <a href="https://instagram.com/vcruzdesigns" target="_blank" rel="noopener" class="text-sm hover:opacity-60 transition-opacity duration-200">
                  @vcruzdesigns
                </a>
              </li>
              <li>
                <a href="https://linkedin.com/in/vcruzdesigns" target="_blank" rel="noopener" class="text-sm hover:opacity-60 transition-opacity duration-200">
                  LinkedIn
                </a>
              </li>
            </ul>
          </section>
        </div>

      </div>
    </main>

    <Footer />
  </div>
</Layout>
