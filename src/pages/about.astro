---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projectImageTier } from '../lib/images';
import aboutContent from '../content/about.json';

const experience = aboutContent.experience;
const contactRows = aboutContent.contactRows;
---

<style>
  /* Contact links: grey, darkening to ink on hover (Webflow .contact-body.link).
     Duration cut from the original 1s (read as laggy) to 0.3s — same bezier shape
     so the "slow, considered" darken character survives, just not at 1s. */
  .contact-link { color: var(--sys-color-on-srf-variant); letter-spacing: -0.3px; transition: color 0.3s cubic-bezier(0, .206, .304, .995); }
  .contact-link:hover { color: var(--sys-color-on-srf); }

  /* Section headers (Webflow .contact-header) — About heading role */
  .section-header {
    font-size: var(--text-about-heading-size);
    font-weight: var(--text-about-heading-weight);
    letter-spacing: var(--text-about-heading-tracking);
    line-height: var(--text-about-heading-leading);
    color: var(--sys-color-on-srf);
  }

  .about-grid {
    display: grid;
    gap: 2em;
    align-items: start;
    /* Body text (Webflow .contact-body + element-level p tracking) — About body role */
    font-weight: var(--text-about-body-weight);
    font-size: var(--text-about-body-size);
    line-height: var(--text-about-body-leading);
    letter-spacing: var(--text-about-body-tracking);
    /* Default: narrow (mobile-first) */
    grid-template-columns: 1fr;
    grid-template-areas:
      "photo"
      "contact"
      "about"
      "experience";
  }

  /* Mobile type step-down (Webflow ≤479px) */
  @media (max-width: 30em) {
    .about-grid { font-size: 1.1rem; }
    .section-header { font-size: 1.7rem; }
  }

  @media (min-width: 40em) {
    .about-grid {
      grid-template-columns: 17em 1fr;
      grid-template-areas:
        "photo       contact"
        "about       about"
        "experience  experience";
    }
  }
  @media (min-width: 50em) {
    .about-grid {
      grid-template-areas:
        "photo   contact"
        ".       about"
        ".       experience";
    }
    .about-grid .area-photo {
      aspect-ratio: 3/4;
      object-position: 50% 50%;
    }
  }

  .area-photo {
    grid-area: photo;
    width: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 1/1;
    object-position: 50% 35%;
  }
  .area-contact    { grid-area: contact; }
  .area-about      { grid-area: about; }
  .area-experience { grid-area: experience; }
</style>

<Layout title="About — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header />

    <h1 class="sr-only">About — Vicente Cruz</h1>

    <main id="main-content" class="flex-1" style="padding-top: 2em; padding-bottom: 3em">
      <div class="about-grid">

        <img
          class="area-photo"
          src={projectImageTier(aboutContent.photo.src, 'thumb')}
          data-image-preview={projectImageTier(aboutContent.photo.src, 'preview')}
          alt={aboutContent.photo.alt}
        />

        <div class="area-contact">
          <h2 class="section-header" style="margin-bottom: 0.6em">{aboutContent.contactTitle}</h2>
          {contactRows.map((row, i) => (
            <p style={`margin-bottom: ${i < contactRows.length - 1 ? '0.35em' : '0'}`}>
              {row.label && <span>{row.label}: </span>}
              {row.prefix && <span>{row.prefix}{' '}</span>}
              <a href={row.href} target={row.href.startsWith('mailto:') ? undefined : '_blank'} rel={row.href.startsWith('mailto:') ? undefined : 'noopener'} class="contact-link" style="font-weight: 800">{row.text}</a>
            </p>
          ))}
        </div>

        <div class="area-about">
          <h2 class="section-header" style="margin-bottom: 0.4em">{aboutContent.aboutTitle}</h2>
          <p style="max-width: 38em">
            {aboutContent.aboutText}
          </p>
        </div>

        <ul class="area-experience" style="list-style: none; padding: 0; margin: 0">
          {experience.map((item) => (
            <li style="margin-bottom: 0.4em">
              <span style="font-weight: 900; letter-spacing: -0.3px">{item.years}:</span>{' '}{item.role}{' '}{item.prep}{' '}{item.company}
            </li>
          ))}
        </ul>

      </div>
    </main>

    <Footer />
  </div>
</Layout>
