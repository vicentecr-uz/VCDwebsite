---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import DevImageDrop from '../components/DevImageDrop.astro';
import '../styles/project.css';
import { loadPageDocument } from '../lib/projects';
import { pageColumnStyle } from '../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const aboutPage = loadPageDocument('about');
const editable = import.meta.env.DEV;
---
<Layout title="About — Vicente Cruz" columnStyle={pageColumnStyle(aboutPage.sections)}>
  <div class="flex flex-col min-h-dvh">
    <Header />

    <h1 class="sr-only">About — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <p
        class="home-role"
        data-dev-text-document={editable ? 'about' : undefined}
        data-dev-text-path={editable ? JSON.stringify(['subtitle']) : undefined}
        data-dev-text-kind={editable ? 'text' : undefined}
      >{String(aboutPage.subtitle ?? 'Product Design Engineer')}</p>
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="about" sections={aboutPage.sections} />
        <div
          class:list={[projectStackClass('none')]}
          {...(spacingDevAttrs('about', ['sections', aboutPage.sections.length], 'none') ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
  <DevImageDrop documentKey="about" />
</Layout>

<style>
  .listing-main {
    padding: 0;
  }

  .home-role {
    /* Same role line as the home page — tracks the header row. */
    max-width: var(--page-header-width, 100%);
    margin-inline: auto;
    line-height: 1;
    margin-block: -0.1515em 0;
    font-size: var(--header-menu-link-size, 1.2em);
    font-weight: var(--text-nav-weight);
    color: var(--sys-color-on-srf-variant);
  }

  /* Contact / experience are line lists, not narrative paragraphs. */
  :global(.listing-main .project-body-text p + p) {
    margin-top: 0;
  }
</style>
