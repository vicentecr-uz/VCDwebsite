---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import aboutContent from '../content/about.json';

const experience = aboutContent.experience;
const contactRows = aboutContent.contactRows;
---

<style>
  /* Contact links: grey, slowly darkening to black on hover (Webflow .contact-body.link) */
  .contact-link { color: var(--color-text-muted); letter-spacing: -0.3px; transition: color 1s cubic-bezier(0, .206, .304, .995); }
  .contact-link:hover { color: #000000; }

  /* Section headers (Webflow .contact-header) */
  .section-header {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.5px;
    line-height: 1;
    color: #000000;
  }

  .about-grid {
    display: grid;
    gap: 2em;
    align-items: start;
    /* Body text (Webflow .contact-body + element-level p tracking) */
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.4px;
    /* Default: narrow (mobile-first) */
    grid-template-columns: 1fr;
    grid-template-areas:
      "photo"
      "contact"
      "about"
      "experience";
  }

  /* Mobile type step-down (Webflow ≤479px) */
  @media (max-width: 30em) {
    .about-grid { font-size: 1.1rem; }
    .section-header { font-size: 1.7rem; }
  }

  /* ── noscript / pre-JS fallback via media queries ── */
  @media (min-width: 40em) {
    .about-grid:not([data-layout]) {
      grid-template-columns: 17em 1fr;
      grid-template-areas:
        "photo       contact"
        "about       about"
        "experience  experience";
    }
  }
  @media (min-width: 50em) {
    .about-grid:not([data-layout]) {
      grid-template-areas:
        "photo   contact"
        ".       about"
        ".       experience";
    }
    .about-grid:not([data-layout]) .area-photo {
      aspect-ratio: 3/4;
      object-position: 50% 50%;
    }
  }

  /* ── JS-managed layout states ── */
  .about-grid[data-layout="narrow"] {
    grid-template-columns: 1fr;
    grid-template-areas:
      "photo"
      "contact"
      "about"
      "experience";
  }
  .about-grid[data-layout="medium"] {
    grid-template-columns: 17em 1fr;
    grid-template-areas:
      "photo       contact"
      "about       about"
      "experience  experience";
  }
  .about-grid[data-layout="wide"] {
    grid-template-columns: 17em 1fr;
    grid-template-areas:
      "photo   contact"
      ".       about"
      ".       experience";
  }

  .area-photo {
    grid-area: photo;
    width: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 1/1;
    object-position: 50% 35%;
  }
  .area-contact    { grid-area: contact; }
  .area-about      { grid-area: about; }
  .area-experience { grid-area: experience; }
</style>

<Layout title="About — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header />

    <main class="flex-1" style="padding-top: 2em; padding-bottom: 3em">
      <div class="about-grid">

        <img
          class="area-photo"
          src={aboutContent.photo.src}
          alt={aboutContent.photo.alt}
        />

        <div class="area-contact">
          <h2 class="section-header" style="margin-bottom: 0.6em">{aboutContent.contactTitle}</h2>
          {contactRows.map((row, i) => (
            <p style={`margin-bottom: ${i < contactRows.length - 1 ? '0.35em' : '0'}`}>
              {row.label && <span>{row.label}: </span>}
              {row.prefix && <span>{row.prefix}{' '}</span>}
              <a href={row.href} target={row.href.startsWith('mailto:') ? undefined : '_blank'} rel={row.href.startsWith('mailto:') ? undefined : 'noopener'} class="contact-link" style="font-weight: 800">{row.text}</a>
            </p>
          ))}
        </div>

        <div class="area-about">
          <h2 class="section-header" style="margin-bottom: 0.4em">{aboutContent.aboutTitle}</h2>
          <p style="max-width: 38em">
            {aboutContent.aboutText}
          </p>
        </div>

        <ul class="area-experience" style="list-style: none; padding: 0; margin: 0">
          {experience.map((item) => (
            <li style="margin-bottom: 0.4em">
              <span style="font-weight: 900; letter-spacing: -0.3px">{item.years}:</span>{' '}{item.role}{' '}{item.prep}{' '}{item.company}
            </li>
          ))}
        </ul>

      </div>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  const grid = document.querySelector('.about-grid') as HTMLElement;
  const photo = document.querySelector('.area-photo') as HTMLImageElement;
  const allTargets = gsap.utils.toArray<HTMLElement>('.about-grid > *');
  const movers = allTargets.filter(el => el !== photo);

  /* ── breakpoint helpers ── */
  function emWidth(): number {
    return window.innerWidth / parseFloat(getComputedStyle(document.documentElement).fontSize);
  }
  function getLayout(): 'wide' | 'medium' | 'narrow' {
    const w = emWidth();
    if (w >= 50) return 'wide';
    if (w >= 40) return 'medium';
    return 'narrow';
  }

  /* ── photo aspect helpers ── */
  function photoProps(layout: string) {
    const sq = layout !== 'wide';
    return {
      aspectRatio: sq ? '1 / 1' : '3 / 4',
      objectPosition: sq ? '50% 35%' : '50% 50%',
    };
  }

  function applyPhoto(layout: string) {
    const p = photoProps(layout);
    photo.style.aspectRatio = p.aspectRatio;
    photo.style.objectPosition = p.objectPosition;
  }

  /* ── initialise (overlay still covers the page) ── */
  let current = getLayout();
  grid.dataset.layout = current;
  applyPhoto(current);

  /* ── transition between layouts ── */
  function transition(next: 'wide' | 'medium' | 'narrow') {
    const prev = current;
    const aspectChanges = (prev === 'wide') !== (next === 'wide');

    /* 1 ── snapshot mover positions */
    const moverState = Flip.getState(movers);

    /* 2 ── snapshot photo geometry */
    const oldPhotoRect = photo.getBoundingClientRect();
    const oldObjPos = photo.style.objectPosition;

    /* 3 ── apply final layout + photo style */
    current = next;
    grid.dataset.layout = next;
    applyPhoto(next);

    /* 4 ── read new photo geometry */
    const newPhotoRect = photo.getBoundingClientRect();

    /* 5 ── animate movers with Flip */
    Flip.from(moverState, {
      duration: 0.6,
      ease: 'power2.inOut',
    });

    /* 6 ── animate photo (height wipe + position) */
    if (aspectChanges || oldPhotoRect.width !== newPhotoRect.width) {
      const dx = oldPhotoRect.left - newPhotoRect.left;
      const dy = oldPhotoRect.top - newPhotoRect.top;

      /*  Lock to old pixel dims, remove aspect-ratio so height is
          driven purely by the GSAP tween (wipe effect).           */
      photo.style.aspectRatio = 'auto';
      photo.style.width  = oldPhotoRect.width + 'px';
      photo.style.height = oldPhotoRect.height + 'px';
      photo.style.objectPosition = oldObjPos;

      const newP = photoProps(next);
      gsap.to(photo, {
        x: 0,
        y: 0,
        width:  newPhotoRect.width,
        height: newPhotoRect.height,
        objectPosition: newP.objectPosition,
        duration: 0.6,
        ease: 'power2.inOut',
        onStart() {
          gsap.set(photo, { x: dx, y: dy });
        },
        onComplete() {
          gsap.set(photo, { clearProps: 'x,y,width,height' });
          photo.style.aspectRatio = newP.aspectRatio;
        },
      });
    }
  }

  /* ── debounced resize listener ── */
  let timeout: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(timeout);
    timeout = setTimeout(() => {
      const next = getLayout();
      if (next !== current) transition(next);
    }, 80);
  });
</script>
