---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const experience = [
  { years: "'25",      role: 'Junior Industrial Designer',     prep: 'at',   company: 'Kingfisher' },
  { years: "'24–'25",  role: 'Graduate Industrial Designer',   prep: 'at',   company: 'Kingfisher' },
  { years: "'23–'24",  role: 'Assistant CAD Designer',         prep: 'at',   company: 'Monno Design' },
  { years: "'22–'24",  role: 'Art Direction Assistant',        prep: 'for',  company: 'FixIts' },
  { years: "'22–'23",  role: 'Assistant CMF Designer',         prep: 'at',   company: 'Chris Lefteri Design' },
  { years: "'20–'24",  role: 'BA Product and Industrial Design', prep: 'from', company: 'UAL: CSM' },
  { years: "'18–'22",  role: 'Graphic Designer',               prep: 'for',  company: 'MH Customs' },
];
---

<style>
  .contact-link { color: inherit; transition: color 0.2s; }
  .contact-link:hover { color: #000000; }
</style>

<Layout title="About — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header />

    <main class="flex-1" style="padding-top: 2em; padding-bottom: 3em">

      <!-- Top row: Photo + Contact -->
      <div style="display: grid; grid-template-columns: 14em 1fr; gap: 2em; align-items: start; margin-bottom: 2em">
        <img
          src="/images/1Q1A6418%20(Custom).jpg"
          alt="Vicente Cruz"
          style="width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block"
        />
        <div>
          <h2 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.01em; margin-bottom: 0.6em">Contact</h2>
          <p style="margin-bottom: 0.35em"><span style="color: var(--color-text-muted)">Email: </span><a href="mailto:heya@vcruzdesigns.com" class="contact-link" style="font-weight: 700">heya@vcruzdesigns.com</a></p>
          <p style="margin-bottom: 0.35em"><span style="color: var(--color-text-muted)">Insta: </span><a href="https://instagram.com/vcruzdesigns" target="_blank" rel="noopener" class="contact-link" style="font-weight: 700">@vcruzdesigns</a></p>
          <p><span style="color: var(--color-text-muted)">Also on </span><a href="https://linkedin.com/in/v1c3ntecruz" target="_blank" rel="noopener" class="contact-link" style="font-weight: 700">LinkedIn</a></p>
        </div>
      </div>

      <!-- About -->
      <h2 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.01em; margin-bottom: 0.4em">About</h2>
      <p style="margin-bottom: 2em; max-width: 38em; line-height: 1.55">
        Hey there, I'm Vince, a London-based industrial designer with a keen interest in digital sculpting.
      </p>

      <!-- Experience -->
      <ul style="list-style: none; padding: 0; margin: 0; max-width: 40em">
        {experience.map((item) => (
          <li style="margin-bottom: 0.4em">
            <span style="font-weight: 700">{item.years}:</span>{' '}{item.role}{' '}{item.prep}{' '}{item.company}
          </li>
        ))}
      </ul>

    </main>

    <Footer />
  </div>
</Layout>
