---
import ProjectLayout from '../components/ProjectLayout.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import LegacyProjectSections from '../components/project/legacy/LegacyProjectSections.astro';
import DevImageDrop from '../components/DevImageDrop.astro';
import TeaserGate from '../components/TeaserGate.astro';
import { resolveProjectOutline, resolveProjectSectionLinks } from '../lib/projectOutline';
import { projectImageTier } from '../lib/images';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';
import { pageColumnStyle } from '../lib/pageColumn';
import {
  getProjectSlugsForBuild,
  loadProjectBySlug,
  shouldIncludeProjectInBuild,
} from '../lib/projects';

// Static output makes `prerender = false` a no-op in DEV; new slugs become routable when
// the create/settings/rename API sends `astro:content-changed` to clear RouteCache.
export const prerender = import.meta.env.PROD;

export function getStaticPaths() {
  return getProjectSlugsForBuild().map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const project = loadProjectBySlug(slug);

if (!project || !shouldIncludeProjectInBuild(project)) {
  return Astro.redirect('/404');
}

const sections = project.sections;
const outline = resolveProjectOutline(project);
const sectionLinks = resolveProjectSectionLinks(project);

// Share card = the project's own gallery cover, at the `preview` tier so
// scrapers get a ~150KB webp rather than the multi-MB original.
const listingCover = Object.values(project.listings ?? {})
  .map((listing) => listing?.image)
  .find((image): image is string => Boolean(image));
const ogImage = listingCover ? projectImageTier(listingCover, 'preview') : undefined;
---

{project.stack === 'legacy' ? (
  <ProjectLayout title={project.title} description={project.description}>
    <LegacyProjectSections sections={sections} documentKey={slug} />
  </ProjectLayout>
) : (
<ProjectLayout
  title={project.title}
  description={project.description}
  outline={outline}
  sectionLinks={sectionLinks}
  sectionNavLabel={`${project.title} sections`}
  sectionNavDocument={slug}
  ogImage={ogImage}
  columnStyle={pageColumnStyle(sections)}
>
  <TeaserGate slug={slug} status={project.status}>
    <div data-dev-project-drop-zone>
      <ProjectSections documentKey={slug} sections={sections} scrollFinale={project.scrollFinale} />
      <div
        class:list={[projectStackClass(project.trailingSpacing ?? 'none')]}
        {...(spacingDevAttrs(slug, ['sections', sections.length], project.trailingSpacing ?? 'none', { writePath: ['trailingSpacing'] }) ?? {})}
      />
    </div>
    <DevImageDrop documentKey={slug} />
  </TeaserGate>
</ProjectLayout>
)}
