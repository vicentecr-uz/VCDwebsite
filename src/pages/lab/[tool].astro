---
import DevCarouselDragTool from '../../components/dev/DevCarouselDragTool.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { tool: 'carousel-drag' } }] : [];
}

if (!import.meta.env.DEV || Astro.params.tool !== 'carousel-drag') return Astro.redirect('/404');
---

<DevCarouselDragTool />
