---
import '../../styles/global.css';
import SelectFieldDemo from '../../components/project/demos/SelectFieldDemo.astro';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Select field preview</title>
  </head>
  <body>
    <main class="select-demo-page">
      <SelectFieldDemo />
    </main>
  </body>
</html>

<style>
  .select-demo-page {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-height: 100%;
    padding: var(--space-unit);
    background: var(--sys-color-srf);
  }
</style>
