---
import DemoLayout from '../../layouts/DemoLayout.astro';
import { CRAFT_DEMOS } from '../../lib/craftDemos';
---

<DemoLayout title="Craft demos">
  <section class="craft-index">
    <h1>Craft demos</h1>
    <ol>
      {CRAFT_DEMOS.map((demo) => <li><a href={`/preview/${demo.id}`}>{demo.title}<span aria-hidden="true">↗</span></a></li>)}
    </ol>
    {import.meta.env.DEV && <nav aria-label="Project previews">
      <a href="/devpanel">DevPanel</a>
      <a href="/low-res-image-loader">Low-res Image Loader</a>
      <a href="/image-framing">Image Framing</a>
      <a href="/gap-spacing">Draggable Block System</a>
      <a href="/page-composition">Page Composition</a>
    </nav>}
  </section>
</DemoLayout>

<style>
  .craft-index { width: min(100%, 38em); }
  h1 { font-size: 2em; font-weight: 600; letter-spacing: -0.04em; margin-bottom: calc(var(--space-unit) * 2); }
  ol { list-style: none; padding: 0; margin: 0; }
  li { border-top: 1px solid var(--sys-color-outline-variant); }
  li:last-child { border-bottom: 1px solid var(--sys-color-outline-variant); }
  li a { display: flex; justify-content: space-between; align-items: center; gap: var(--space-unit); padding-block: var(--space-unit); font-size: 1.125em; min-height: 3em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  nav { display: flex; gap: calc(var(--space-unit) * 2); flex-wrap: wrap; margin-top: calc(var(--space-unit) * 2); }
  nav a { padding-block: var(--space-unit); }
</style>
