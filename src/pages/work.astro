---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import { loadPageDocument } from '../lib/projects';

const workPage = loadPageDocument('work');
---

<Layout title="Work — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header title="Work" navMenu />

    <h1 class="sr-only">Work — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="work" sections={workPage.sections} />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
