---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjectGridListings } from '../lib/projects';

const projects = getProjectGridListings('work');
---

<Layout title="Work — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header title="Work" navMenu />

    <h1 class="sr-only">Work — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <ProjectGrid
        variant="work"
        items={projects.map((project) => ({
          title: project.title,
          subtitle: project.subtitle,
          image: project.image,
          hoverImage: project.hoverImage,
          hoverDark: project.hoverDark,
          bg: project.bg,
          dark: project.dark,
          full: project.full,
          href: project.href,
          teaser: project.teaser,
          teaserLabel: project.teaserLabel,
          status: project.status,
          slug: project.slug,
          variants: project.variants,
          hoverVariants: project.hoverVariants,
          srcWidth: project.srcWidth,
          srcHeight: project.srcHeight,
        }))}
      />
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
