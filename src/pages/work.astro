---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectSections from '../components/project/ProjectSections.astro';
import { loadPageDocument } from '../lib/projects';
import { pageColumnStyle } from '../lib/pageColumn';
import { projectStackClass, spacingDevAttrs } from '../lib/projectStack';

const workPage = loadPageDocument('work');
if (!import.meta.env.DEV) return Astro.redirect('/404');
---

<Layout title="Work — Vicente Cruz" columnStyle={pageColumnStyle(workPage.sections)}>
  <div class="flex flex-col min-h-dvh">
    <Header title="Work" navMenu />

    <h1 class="sr-only">Work — Vicente Cruz</h1>

    <main id="main-content" class="listing-main" style="flex: 1;">
      <div data-dev-project-drop-zone>
        <ProjectSections documentKey="work" sections={workPage.sections} introHeight={workPage.introHeight} />
        <div
          class:list={[projectStackClass('none')]}
          {...(spacingDevAttrs('work', ['sections', workPage.sections.length], 'none') ?? {})}
        />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .listing-main {
    padding: 0;
  }
</style>
