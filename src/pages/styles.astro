---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionSidebarNav from '../components/SectionSidebarNav.astro';
import StyleColorTokenEditor from '../components/StyleColorTokenEditor.astro';
import ProjectSectionNavEditor from '../components/project/ProjectSectionNavEditor.astro';
import ProjectCaptionShadow from '../components/project/ProjectCaptionShadow.astro';
import ProjectImage from '../components/project/ProjectImage.astro';
import ProjectImageGrid from '../components/project/ProjectImageGrid.astro';
import ProjectBodyText from '../components/project/ProjectBodyText.astro';
import ProjectSectionTitle from '../components/project/ProjectSectionTitle.astro';
import ProjectPressQuoteTicker from '../components/project/ProjectPressQuoteTicker.astro';
import ProjectRedditCommentCarousel from '../components/project/ProjectRedditCommentCarousel.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import stylesNav from '../content/pages/styles.json';
import {
  deriveNavFromOutline,
  normalizeOutline,
  outlineFromNav,
} from '../lib/projectOutline';
import globalCssSource from '../styles/global.css?raw';
import '../styles/project.css';

/** Shared preview assets (Tapico) */
const previewHero = 'Tapico White Hero Center Crop.jpg';
const previewDetail = 'IMG_5609.jpg';

const previewPressQuotes = [
  {
    name: 'Yanko Design',
    quote: '"It’s a single-function device that does only one thing but does it to perfection."',
    logoSrc: '/images/press-logos/yanko-design.png',
    logoAlt: 'Yanko Design',
    href: 'https://www.yankodesign.com/',
  },
  {
    name: 'Hackster.io',
    quote: '"Tapico Typer is a minimalist writer\'s dream machine"',
    logoSrc: '/images/press-logos/hackster-dark.png',
    logoAlt: 'Hackster.io',
    href: 'https://www.hackster.io/',
  },
];

const previewRedditComments = [
  {
    author: 'bookworm1103',
    score: 13,
    avatarSrc: '/images/reddit/avatar_default_4.png',
    paragraphs: ['This is exactly the kind of focused writing device I’ve been looking for.'],
    href: 'https://www.reddit.com/',
    theme: 'light' as const,
  },
  {
    author: 'minimalist_writer',
    score: 8,
    avatarSrc: '/images/reddit/avatar_default_1.png',
    paragraphs: ['Love the tactile keys and the e-ink screen. No distractions.'],
    href: 'https://www.reddit.com/',
    theme: 'dark' as const,
  },
];

type ComponentCategory = 'site' | 'project-shell' | 'project-content' | 'project-media';

type PreviewKey =
  | 'header'
  | 'footer'
  | 'sidebar-nav'
  | 'project-grid'
  | 'project-layout'
  | 'image-lead'
  | 'body-text'
  | 'section-title'
  | 'image-grid'
  | 'press-quote-ticker'
  | 'reddit-comment-carousel';

type ComponentEntry = {
  id: string;
  name: string;
  category: ComponentCategory;
  purpose: string;
  classRef: string;
  source: string;
  props: string;
  usedOn: string[];
  checklist: string;
  preview: PreviewKey;
};

const categoryLabels: Record<ComponentCategory, string> = {
  site: 'Site chrome',
  'project-shell': 'Project shell',
  'project-content': 'Project content',
  'project-media': 'Project media',
};

const componentCatalog: ComponentEntry[] = [
  {
    id: 'component-header',
    name: 'Header',
    category: 'site',
    purpose: 'Global nav, wordmark swap on inner pages, menu overlay.',
    classRef: '.site-header / .site-header--nav-menu',
    source: 'src/components/Header.astro',
    props: 'title?, navMenu? (default true)',
    usedOn: ['All pages'],
    checklist: 'Wordmark kerning pairs, menu open/close, active route state.',
    preview: 'header',
  },
  {
    id: 'component-footer',
    name: 'Footer',
    category: 'site',
    purpose: 'Copyright line anchored to page bottom.',
    classRef: '.footer-text',
    source: 'src/components/Footer.astro',
    props: '(none)',
    usedOn: ['All pages'],
    checklist: 'Hover tone stays subtle; year updates automatically.',
    preview: 'footer',
  },
  {
    id: 'component-section-sidebar-nav',
    name: 'SectionSidebarNav',
    category: 'site',
    purpose: 'Scroll-spy section nav for long single-column pages.',
    classRef: '.section-sidebar-nav',
    source: 'src/components/SectionSidebarNav.astro',
    props: 'sectionLinks, ariaLabel?, enableEasingDevPanel?',
    usedOn: ['/styles', '/about', '/tapico'],
    checklist: 'Click scroll offset, active section highlight, mobile hide.',
    preview: 'sidebar-nav',
  },
  {
    id: 'component-project-grid',
    name: 'ProjectGrid',
    category: 'site',
    purpose: 'Project/play listing grid on Home, Work, and Play — cover cards with hover title reveal.',
    classRef: '.project-grid / .project-grid__card / .project-grid__cover',
    source: 'src/components/ProjectGrid.astro',
    props: 'items[] (title, image, bg, dark, subtitle?, href?, full?), variant? (home | work | play)',
    usedOn: ['Home', 'Work', 'Play'],
    checklist: '2-col desktop; featured full-width on home/work; titles always visible ≤768px; play placeholders when href omitted. Not legacy case-study media grids.',
    preview: 'project-grid',
  },
  {
    id: 'component-project-layout',
    name: 'ProjectLayout',
    category: 'project-shell',
    purpose: 'Case-study page shell: Layout + Header + main slot + Footer + project.css.',
    classRef: '.project-page / .project-page__main',
    source: 'src/components/ProjectLayout.astro',
    props: 'title, description, outline?, sectionLinks?, sectionNavDocument?',
    usedOn: ['Tapico'],
    checklist: 'Title prop matches header wordmark; description feeds meta. Other case studies are legacy Webflow migrations — rebuild with signed-off components only.',
    preview: 'project-layout',
  },
  {
    id: 'component-project-image',
    name: 'ProjectImage',
    category: 'project-media',
    purpose: 'Single project image — lead/crop (variant) or inline media between prose, with optional captions (overlay or below-image).',
    classRef: '.project-image / .project-media',
    source: 'src/components/project/ProjectImage.astro',
    props: 'src, alt?, kind? (lead | inline), variants?, caption?, captions?, captionReveal?, captionStyle?, captionPosition?, constrained?, maxVh?, spacing?',
    usedOn: ['Tapico'],
    checklist: 'Lead crop focal point; overlay caption reveal defaults (hover desktop, always touch); Below image style is always visible under media; Dev Mode crop + caption tuners.',
    preview: 'image-lead',
  },
  {
    id: 'component-project-image-grid',
    name: 'ProjectImageGrid',
    category: 'project-media',
    purpose: 'Responsive multi-image grid with per-cell crop and captions.',
    classRef: '.project-image-grid / .project-image-grid__item',
    source: 'src/components/project/ProjectImageGrid.astro',
    props: 'items[], columns?, defaultAspectRatio?, matchHeight?, constrained?, layouts?, document?, basePath?, spacing?',
    usedOn: ['Tapico'],
    checklist: 'Column count per breakpoint; captions match ProjectImage (overlay or below); match-height equalizes below-slot whitespace across the row; grid tuner in Dev Mode.',
    preview: 'image-grid',
  },
  {
    id: 'component-project-body-text',
    name: 'ProjectBodyText',
    category: 'project-content',
    purpose: 'Narrative body copy between media blocks.',
    classRef: '.project-body-text / .project-block',
    source: 'src/components/project/ProjectBodyText.astro',
    props: 'paragraphs[], documentKey?, pathPrefix?, spacing?, sectionId?',
    usedOn: ['Tapico'],
    checklist: 'Comfortable line length; stack gap from spacing prop; inline HTML allowed in paragraphs.',
    preview: 'body-text',
  },
  {
    id: 'component-project-section-title',
    name: 'ProjectSectionTitle',
    category: 'project-content',
    purpose: 'In-page section break heading (Research, Process, etc.).',
    classRef: '.project-section-title',
    source: 'src/components/project/ProjectSectionTitle.astro',
    props: 'title, spacing?, tightBottom? (default true → related after), level? (2 | 3), showTitle?, hideWhenSidebarVisible?',
    usedOn: ['Tapico'],
    checklist: 'Default precede-related so body after a heading sits at 1em; per-breakpoint show/hide when sidebar is active.',
    preview: 'section-title',
  },
  {
    id: 'component-project-press-quote-ticker',
    name: 'ProjectPressQuoteTicker',
    category: 'project-content',
    purpose: 'Horizontally scrolling press quotes with outlet logos.',
    classRef: '.press-quote-ticker',
    source: 'src/components/project/ProjectPressQuoteTicker.astro',
    props: 'items[] (quote, logoSrc, logoAlt, href, name?), documentKey?, sectionPath?, spacing?, speed?, logoOpacity?',
    usedOn: ['Tapico'],
    checklist: 'Seamless loop; logo opacity; pause on hover/focus; links open in new tab.',
    preview: 'press-quote-ticker',
  },
  {
    id: 'component-project-reddit-comment-carousel',
    name: 'ProjectRedditCommentCarousel',
    category: 'project-content',
    purpose: 'Masonry board of Reddit-style comment cards with vertical paging.',
    classRef: '.reddit-comment-carousel',
    source: 'src/components/project/ProjectRedditCommentCarousel.astro',
    props: 'items[] (author, paragraphs[], score, avatarSrc?, href?, theme?), documentKey?, sectionPath?, spacing?',
    usedOn: ['Tapico'],
    checklist: 'Three-column stagger; wheel scroll passes through to page; infinite loop per column.',
    preview: 'reddit-comment-carousel',
  },
];

/** Legacy Webflow-migration markup on other case studies — not signed off. Do not copy into new work. */
const legacyPatterns = [
  {
    name: 'Case-study media grid',
    classRef: '.project-grid--2 / .project-grid--3 / .project-grid--5',
    usedOn: ['The Rams', 'Conic Collection'],
    note: 'Legacy case-study image clusters via legacy/LegacyProjectGrid.astro — not the home/work/play portfolio grid.',
  },
  {
    name: 'Stacked grid cell',
    classRef: '.project-cell--stack',
    usedOn: ['The Rams', 'Conic Collection'],
    note: 'Tall two-image stack inside a 5-column grid. Legacy only — not used on Tapico.',
  },
  {
    name: 'Responsive hide / show pair',
    classRef: '.project-hide-mobile + .project-show-mobile-only',
    usedOn: ['Conic Collection'],
    note: 'Desktop grid cell hidden on mobile, alternate full image shown instead. Legacy only.',
  },
  {
    name: 'Captioned image (legacy)',
    classRef: '.project-captioned-image',
    usedOn: ['Conic Collection'],
    note: 'Superseded by ProjectImage with caption props. See legacy/LegacyProjectCaptionedImage.astro.',
  },
];

const readCssToken = (name: string, fallback: string) =>
  globalCssSource.match(new RegExp(`^\\s*${name}:\\s*([^;]+);`, 'm'))?.[1].trim() ?? fallback;

const colorTokens = [
  { name: '--color-bg', fallback: '#ffffff', role: 'Primary page background' },
  { name: '--color-surface-soft', fallback: '#f7f5f1', role: 'Borderless cards and controls' },
  { name: '--color-surface-strong', fallback: '#eeebe5', role: 'Selected and nested surfaces' },
  { name: '--color-text', fallback: '#1a1a1a', role: 'Main reading text' },
  { name: '--color-text-soft', fallback: '#5a5a5a', role: 'Header menu links and subtle emphasis text' },
  { name: '--color-link-strong', fallback: 'var(--color-text)', role: 'Default for dark links' },
  { name: '--color-link-strong-hover', fallback: 'var(--color-text-soft)', role: 'Hover for dark links' },
  { name: '--color-link-soft', fallback: 'var(--color-text-soft)', role: 'Default for softer links' },
  { name: '--color-link-soft-hover', fallback: 'var(--color-text)', role: 'Hover for softer links' },
  { name: '--color-text-muted', fallback: '#888888', role: 'Secondary labels and UI hints' },
  { name: '--color-border', fallback: '#e0ddd8', role: 'Necessary separators and diagrams' },
].map((token) => ({
  ...token,
  value: readCssToken(token.name, token.fallback),
}));

const typographyScale = [
  {
    token: 'Display / h1',
    value: 'clamp(1.95rem, 2.5vw, 2.85rem)',
    sample: 'Industrial design, made tactile.',
    note: 'Page-level title and hero intro',
  },
  {
    token: 'Section heading / h2',
    value: 'clamp(1.35rem, 1.8vw, 2rem)',
    sample: 'Process and outputs',
    note: 'Top-level section breaks',
  },
  {
    token: 'Subheading / h3',
    value: '1.1rem',
    sample: 'Materials and ergonomics',
    note: 'Nested sections and card titles',
  },
  {
    token: 'Body copy',
    value: '1rem / 1.55',
    sample:
      'Used for narrative sections. Keep width around 52-62ch so dense process writing remains easy to scan.',
    note: 'Long-form description text',
  },
  {
    token: 'Caption',
    value: '1.2em / 1.1 · weight 600 · tracking -0.05ch',
    sample: 'Foam model before final chamfer direction',
    note: 'White image-overlay style (Styles → Caption). Dev Mode caption tuner also offers Black (overlay) and Below image (body-sized text under the media, always visible; match-height grids leave matching empty space under sibling cells).',
  },
];

const spacingScale = [
  { token: '--space-related', value: '1em', use: 'Continuous / related blocks in a project stack' },
  { token: '--space-group', value: '4em', use: 'Same chapter, new beat (e.g. press → community)' },
  { token: '--space-section', value: '8em', use: 'Gap between imagery and narrative text' },
  { token: '--space-major', value: '12em', use: 'Major section / chapter break' },
  // `value` is injected straight into the sample bar's width/height, so it has
  // to stay a valid CSS length. Referencing the token keeps the bar honest —
  // it renders whatever the unit currently is at this breakpoint.
  {
    token: '--space-unit',
    value: 'var(--space-unit)',
    use: 'Core unit: gutter, header/footer padding, grid gaps — 1rem, 0.75rem below 40em',
  },
];

const layoutRules = [
  {
    name: 'Project stack rhythm',
    value: 'margin-top on siblings via --space-*',
    why: 'One gap between sections (related / group / section / major). Blocks do not pad top and bottom.',
  },
  {
    name: 'Fluid site gutter',
    value: 'max(var(--space-unit), calc((100% - 60em) / 2))',
    why: 'Keeps content comfortable at every size while preserving edge breathing room.',
  },
  {
    name: 'Core unit',
    value: '--space-unit — 1rem, 0.75rem below 40em',
    why: 'Build gutter, chrome padding and gaps on the unit before introducing custom values. Phones step it down together so nothing drifts out of sync.',
  },
  {
    name: 'Page transition',
    value: '0.5s overlay fade (after visible media)',
    why: 'Shared entry/exit timing from `Layout.astro`; enter waits for viewport images.',
  },
];

const foundationLinks = [
  { id: 'styles-colors', label: 'Color tokens' },
  { id: 'styles-typography', label: 'Typography' },
  { id: 'styles-spacing', label: 'Spacing' },
  { id: 'styles-layout-rules', label: 'Layout rules' },
];

const catalogByCategory = (Object.keys(categoryLabels) as ComponentCategory[]).map((category) => ({
  category,
  label: categoryLabels[category],
  items: componentCatalog.filter((entry) => entry.category === category),
}));

/** Match page render order (grouped by category), not raw catalog order. */
const componentLinks = catalogByCategory.flatMap(({ items }) =>
  items.map((component) => ({
    id: component.id,
    label: component.name,
  })),
);

const catalogSectionLinks = [
  { id: 'styles-intro', label: 'Design system' },
  {
    label: 'Foundations',
    defaultOpen: true,
    children: foundationLinks,
  },
  {
    label: 'Components',
    children: [
      { id: 'styles-components', label: 'Overview' },
      ...componentLinks,
    ],
  },
  {
    label: 'Patterns',
    children: [
      { id: 'styles-pending', label: 'Legacy patterns' },
      { id: 'styles-interaction', label: 'Interaction sample' },
    ],
  },
];

const savedOutline = normalizeOutline(stylesNav.outline ?? []);
const outline = savedOutline.length ? savedOutline : outlineFromNav(catalogSectionLinks);
const sectionLinks = savedOutline.length
  ? deriveNavFromOutline(outline)
  : catalogSectionLinks;
---

<Layout title="Design System — Vicente Cruz" serif>
  <div
    class="styles-page"
    data-section-nav-root
    data-section-nav-document="styles"
    data-section-nav-outline-only="true"
    data-section-nav={JSON.stringify(sectionLinks)}
    data-section-outline={JSON.stringify(outline)}
  >
    <Header title="Design System" />

    <div class="styles-layout">
      <SectionSidebarNav
        sectionLinks={sectionLinks}
        ariaLabel="Design System page sections"
        desktopOnly
      />

      <main class="styles-main" data-section-nav-main>
        <section id="styles-intro" class="styles-intro section-block">
          <p class="intro-copy">
            This page is the single source of truth for site components, tokens, and signed-off patterns.
            <strong>Tapico</strong> (<a href="/tapico" class="project-inline-link">/tapico</a>) is the reference
            case study; <strong>Home</strong>, <strong>Work</strong>, and <strong>Play</strong> define the vetted
            portfolio grid. Other project routes are legacy Webflow migrations — do not copy their markup when
            building or porting content.
          </p>
        </section>

        <section id="styles-colors" class="section-block">
          <h2>Color tokens</h2>
          <div class="token-grid">
            {colorTokens.map((token) => {
              const editable = import.meta.env.DEV && /^#[0-9a-f]{3,6}$/i.test(token.value);
              return (
                <article class="token-card">
                  {editable ? (
                    <button
                      type="button"
                      class="token-card__swatch"
                      style={`background:${token.value};`}
                      aria-label={`Edit ${token.name}`}
                      data-dev-edit-trigger="style-color-token"
                      data-color-token-name={token.name}
                      data-color-token-value={token.value}
                      data-color-token-saved-value={token.value}
                      disabled
                    ></button>
                  ) : (
                    <div class="token-card__swatch" style={`background:${token.value};`}></div>
                  )}
                  <p class="meta-label">{token.name}</p>
                  <p class="meta-values" data-token-value>{token.value}</p>
                  <p class="token-note">{token.role}</p>
                </article>
              );
            })}
          </div>
        </section>

        <section id="styles-typography" class="section-block">
          <h2>Typography</h2>
          <div class="stack">
            {typographyScale.map((item) => (
              <article class="type-card">
                <div class="type-card__meta">
                  <div>
                    <p class="meta-label">{item.token}</p>
                    <p class="meta-values">{item.value}</p>
                  </div>
                  <p class="token-note">{item.note}</p>
                </div>

                {item.token === 'Display / h1' && <h1 class="preview-h1">{item.sample}</h1>}
                {item.token === 'Section heading / h2' && <h2 class="preview-h2">{item.sample}</h2>}
                {item.token === 'Subheading / h3' && <h3 class="preview-h3">{item.sample}</h3>}
                {item.token === 'Body copy' && <p class="preview-body">{item.sample}</p>}
                {item.token === 'Caption' && (
                  <div class="caption-preview">
                    <img src={`/images/${previewDetail}`} alt="Caption style preview" />
                    <span class="project-caption">{item.sample}</span>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>

        <section id="styles-spacing" class="section-block">
          <h2>Spacing</h2>
          <div class="stack">
            {spacingScale.map((item) => (
              <article class="spacing-row">
                <div class="spacing-row__meta">
                  <p class="meta-label">{item.token}</p>
                  <p class="token-note">{item.use}</p>
                </div>
                <div class="spacing-row__samples">
                  <div class="spacing-row__sample">
                    <p class="meta-label">Horizontal</p>
                    <div class="spacing-row__sample-area">
                      <div class="spacing-row__bar-h" style={`width:${item.value};`}></div>
                    </div>
                  </div>
                  <div class="spacing-row__sample">
                    <p class="meta-label">Vertical</p>
                    <div class="spacing-row__sample-area spacing-row__sample-area--vertical">
                      <div class="spacing-row__bar-v" style={`height:${item.value};`}></div>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-layout-rules" class="section-block">
          <h2>Layout rules</h2>
          <div class="stack">
            {layoutRules.map((rule) => (
              <article class="rule-card">
                <div class="token-row__top">
                  <span class="token-name">{rule.name}</span>
                  <span class="token-value">{rule.value}</span>
                </div>
                <p class="token-note">{rule.why}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-components" class="section-block">
          <h2>Component library</h2>
          <p class="section-note">
            {componentCatalog.length} signed-off components and patterns across site chrome, portfolio listings,
            and project pages (vetted on Home/Work/Play + Tapico). Each is built for reuse on future case studies.
            Cards show a live preview, source file, props, and where it is used today.
          </p>

          {catalogByCategory.map(({ category, label, items }) => (
            <div class="component-group">
              <h3 class="component-group__title">{label}</h3>
              <div class="stack">
                {items.map((component) => (
                  <article id={component.id} class="component-card section-block">
                    <div class="component-card__head">
                      <h4>{component.name}</h4>
                      <p>{component.purpose}</p>
                    </div>

                    <div class="component-meta-grid">
                      <div>
                        <p class="meta-label">Source</p>
                        <p class="meta-values"><code>{component.source}</code></p>
                      </div>
                      <div>
                        <p class="meta-label">Props</p>
                        <p class="meta-values"><code>{component.props}</code></p>
                      </div>
                      <div>
                        <p class="meta-label">Class reference</p>
                        <p class="meta-values">{component.classRef}</p>
                      </div>
                      <div>
                        <p class="meta-label">Used on</p>
                        <p class="meta-values">{component.usedOn.join(', ')}</p>
                      </div>
                      <div class="component-meta-grid__full">
                        <p class="meta-label">QA checklist</p>
                        <p class="meta-values">{component.checklist}</p>
                      </div>
                    </div>

                    <div class="component-preview">
                      {component.preview === 'header' && (
                        <p class="preview-note">Rendered at the top of this page.</p>
                      )}
                      {component.preview === 'footer' && (
                        <p class="preview-note">Rendered at the bottom of this page.</p>
                      )}
                      {component.preview === 'sidebar-nav' && (
                        <p class="preview-note">Fixed nav on the left of this page (desktop).</p>
                      )}
                      {component.preview === 'project-grid' && (
                        <ProjectGrid
                          variant="work"
                          items={[
                            {
                              title: 'Tapico Typer',
                              subtitle: '2024',
                              image: '/images/Tapico White Hero Center Crop.jpg',
                              bg: '#e8e4dc',
                              dark: false,
                              href: '/tapico',
                            },
                            {
                              title: 'Another project',
                              subtitle: '2023',
                              image: '/images/IMG_5609.jpg',
                              bg: '#1a1a1a',
                              dark: true,
                              href: '/tapico',
                            },
                          ]}
                        />
                      )}
                      {component.preview === 'project-layout' && (
                        <p class="preview-note">
                          Wraps project pages — see any case study (e.g.{' '}
                          <a href="/tapico" class="project-inline-link">Tapico</a>).
                        </p>
                      )}
                      {component.preview === 'image-lead' && (
                        <ProjectImage src={previewHero} alt="ProjectImage lead preview" kind="lead" />
                      )}
                      {component.preview === 'body-text' && (
                        <ProjectBodyText
                          paragraphs={[
                            'Designed for narrative flow between media modules. Keep this block comfortable and readable, then let images carry detail.',
                          ]}
                        />
                      )}
                      {component.preview === 'section-title' && (
                        <ProjectSectionTitle title="Research" />
                      )}
                      {component.preview === 'image-grid' && (
                        <ProjectImageGrid
                          columns={2}
                          defaultAspectRatio="4:3"
                          items={[
                            { src: previewHero, alt: 'Three-quarter view' },
                            { src: previewDetail, alt: 'Screen close-up' },
                          ]}
                        />
                      )}
                      {component.preview === 'press-quote-ticker' && (
                        <ProjectPressQuoteTicker items={previewPressQuotes} />
                      )}
                      {component.preview === 'reddit-comment-carousel' && (
                        <ProjectRedditCommentCarousel items={previewRedditComments} />
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>

        <section id="styles-pending" class="section-block">
          <h2>Legacy patterns</h2>
          <p class="section-note">
            Raw markup still present on older Webflow-migration case studies. These are <strong>not</strong> signed
            off — do not copy into new pages or when porting content to Tapico-style layouts.
          </p>
          <div class="stack">
            {legacyPatterns.map((pattern) => (
              <article class="rule-card">
                <div class="token-row__top">
                  <span class="token-name">{pattern.name}</span>
                  <span class="token-value">{pattern.classRef}</span>
                </div>
                <p class="token-note">
                  <strong>Used on:</strong> {pattern.usedOn.join(', ')}. {pattern.note}
                </p>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-interaction" class="section-block">
          <h2>Interaction sample</h2>
          <article class="rule-card">
            <p class="section-note">
              Hover tone should stay subtle. This link uses the same transition behavior as inline project links:
              <a href="#" class="project-inline-link"> read case-study details</a>.
            </p>
          </article>
        </section>
      </main>
    </div>

    {import.meta.env.DEV && <StyleColorTokenEditor />}
    {import.meta.env.DEV && <ProjectSectionNavEditor />}
    <ProjectCaptionShadow />
    <Footer />
  </div>
</Layout>

