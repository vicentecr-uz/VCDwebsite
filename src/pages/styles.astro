---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionSidebarNav from '../components/SectionSidebarNav.astro';
import StyleColorTokenEditor from '../components/StyleColorTokenEditor.astro';
import ProjectImage from '../components/project/ProjectImage.astro';
import ProjectTagline from '../components/project/ProjectTagline.astro';
import ProjectProse from '../components/project/ProjectProse.astro';
import ProjectSectionTitle from '../components/project/ProjectSectionTitle.astro';
import ProjectGrid from '../components/project/ProjectGrid.astro';
import ProjectCaptionImage from '../components/project/ProjectCaptionImage.astro';
import ProjectDetailImage from '../components/project/ProjectDetailImage.astro';
import ProjectContextImage from '../components/project/ProjectContextImage.astro';
import ProjectReferenceImage from '../components/project/ProjectReferenceImage.astro';
import globalCssSource from '../styles/global.css?raw';
import '../styles/project.css';

/** Shared preview assets (Tapico) */
const previewHero = 'Tapico White Hero Center Crop.jpg';
const previewWide = 'IMG_5776.jpg';
const previewDetail = 'IMG_5609.jpg';
const previewSquare = 'Remarkable Tablet.jpg';

type ComponentCategory = 'site' | 'project-shell' | 'project-content' | 'project-media';

type PreviewKey =
  | 'header'
  | 'footer'
  | 'sidebar-nav'
  | 'project-layout'
  | 'image-lead'
  | 'tagline'
  | 'prose'
  | 'section-title'
  | 'image'
  | 'grid'
  | 'caption-image'
  | 'detail-image'
  | 'context-image'
  | 'reference-image';

type ComponentEntry = {
  id: string;
  name: string;
  category: ComponentCategory;
  purpose: string;
  classRef: string;
  source: string;
  props: string;
  usedOn: string[];
  checklist: string;
  preview: PreviewKey;
};

const categoryLabels: Record<ComponentCategory, string> = {
  site: 'Site chrome',
  'project-shell': 'Project shell',
  'project-content': 'Project content',
  'project-media': 'Project media',
};

const componentCatalog: ComponentEntry[] = [
  {
    id: 'component-header',
    name: 'Header',
    category: 'site',
    purpose: 'Global nav, wordmark swap on inner pages, menu overlay.',
    classRef: '.site-header / .site-header--nav-menu',
    source: 'src/components/Header.astro',
    props: 'title?, navMenu? (default true)',
    usedOn: ['All pages'],
    checklist: 'Wordmark kerning pairs, menu open/close, active route state.',
    preview: 'header',
  },
  {
    id: 'component-footer',
    name: 'Footer',
    category: 'site',
    purpose: 'Copyright line anchored to page bottom.',
    classRef: '.footer-text',
    source: 'src/components/Footer.astro',
    props: '(none)',
    usedOn: ['All pages'],
    checklist: 'Hover tone stays subtle; year updates automatically.',
    preview: 'footer',
  },
  {
    id: 'component-section-sidebar-nav',
    name: 'SectionSidebarNav',
    category: 'site',
    purpose: 'Scroll-spy section nav for long single-column pages.',
    classRef: '.section-sidebar-nav',
    source: 'src/components/SectionSidebarNav.astro',
    props: 'sectionLinks, ariaLabel?, enableEasingDevPanel?',
    usedOn: ['/styles', '/about'],
    checklist: 'Click scroll offset, active section highlight, mobile hide.',
    preview: 'sidebar-nav',
  },
  {
    id: 'component-project-layout',
    name: 'ProjectLayout',
    category: 'project-shell',
    purpose: 'Case-study page shell: Layout + Header + main slot + Footer + project.css.',
    classRef: '.project-page / .project-page__main',
    source: 'src/components/ProjectLayout.astro',
    props: 'title, description',
    usedOn: ['Tapico', 'The Rams', 'Conic Collection', 'ParentPal'],
    checklist: 'Title prop matches header wordmark; description feeds meta.',
    preview: 'project-layout',
  },
  {
    id: 'component-project-image',
    name: 'ProjectImage',
    category: 'project-media',
    purpose: 'Single project image — lead/crop (variant) or simple media between prose.',
    classRef: '.project-image / .project-media',
    source: 'src/components/project/ProjectImage.astro',
    props: 'src, alt?, kind? (lead | inline), layout? (default | conic), variants?, constrained?, mobileHeight?, flush?',
    usedOn: ['All project pages'],
    checklist: 'Lead crop focal point; constrained 80% desktop; mobileHeight at 767px.',
    preview: 'image-lead',
  },
  {
    id: 'component-project-tagline',
    name: 'ProjectTagline',
    category: 'project-content',
    purpose: 'Large display headline under the lead image.',
    classRef: '.project-tagline',
    source: 'src/components/project/ProjectTagline.astro',
    props: 'text',
    usedOn: ['Tapico', 'The Rams', 'ParentPal'],
    checklist: '80% width desktop; scales to 2em at tablet.',
    preview: 'tagline',
  },
  {
    id: 'component-project-prose',
    name: 'ProjectProse',
    category: 'project-content',
    purpose: 'Main narrative body for case-study explanations.',
    classRef: '.project-prose / .project-block',
    source: 'src/components/project/ProjectProse.astro',
    props: 'spacing? (related | section | major | none), tightBottom? + default slot',
    usedOn: ['All project pages'],
    checklist: 'Stay around 80% width desktop, 100% tablet and below. Stack gap from spacing prop.',
    preview: 'prose',
  },
  {
    id: 'component-project-section-title',
    name: 'ProjectSectionTitle',
    category: 'project-content',
    purpose: 'In-page section break heading (Research, Process, etc.).',
    classRef: '.project-section-title',
    source: 'src/components/project/ProjectSectionTitle.astro',
    props: 'title, spacing?, tightBottom? (default true → related after), level? (2 | 3)',
    usedOn: ['Tapico', 'The Rams', 'Conic Collection'],
    checklist: 'Default precede-related so body after a heading sits at 1em; level 3 for nested sections.',
    preview: 'section-title',
  },
  {
    id: 'component-project-grid',
    name: 'ProjectGrid',
    category: 'project-media',
    purpose: 'Two-, three-, or five-column media clusters.',
    classRef: '.project-grid--2/3/5',
    source: 'src/components/project/ProjectGrid.astro',
    props: 'cols (2 | 3 | 5) + default slot',
    usedOn: ['Tapico', 'The Rams', 'Conic Collection'],
    checklist: 'Validate collapse path at 991px and 767px breakpoints.',
    preview: 'grid',
  },
  {
    id: 'component-project-caption-image',
    name: 'ProjectCaptionImage',
    category: 'project-media',
    purpose: 'Grid cell with overlay caption (competitor refs, labeled shots).',
    classRef: '.project-cell / .project-caption',
    source: 'src/components/project/ProjectCaptionImage.astro',
    props: 'src, alt?, caption, variant?, square?',
    usedOn: ['Tapico'],
    checklist: 'Caption short; hidden on mobile per project.css.',
    preview: 'caption-image',
  },
  {
    id: 'component-project-detail-image',
    name: 'ProjectDetailImage',
    category: 'project-media',
    purpose: 'Grid detail shot with optional caption variants.',
    classRef: '.project-detail / .project-detail__img',
    source: 'src/components/project/ProjectDetailImage.astro',
    props: 'src, alt?, caption?, captionVariant? (light | dark | black)',
    usedOn: ['Tapico', 'The Rams', 'Conic Collection'],
    checklist: 'Min-height 16em; caption variant matches image tone.',
    preview: 'detail-image',
  },
  {
    id: 'component-project-context-image',
    name: 'ProjectContextImage',
    category: 'project-media',
    purpose: 'Moodboard/context cell with caption above image.',
    classRef: '.project-context-cell / .project-context-caption',
    source: 'src/components/project/ProjectContextImage.astro',
    props: 'src, alt?, caption',
    usedOn: ['The Rams'],
    checklist: 'Caption above image; used inside context grids.',
    preview: 'context-image',
  },
  {
    id: 'component-project-reference-image',
    name: 'ProjectReferenceImage',
    category: 'project-media',
    purpose: 'Linked reference tile with overlay caption.',
    classRef: '.project-reference-cell / .project-reference-cell__link',
    source: 'src/components/project/ProjectReferenceImage.astro',
    props: 'src, alt?, caption, href',
    usedOn: ['Conic Collection'],
    checklist: 'External link opens new tab; caption readable on image.',
    preview: 'reference-image',
  },
];

const pendingPatterns = [
  {
    name: 'Captioned constrained image',
    classRef: '.project-media--constrained + .project-caption--black/dark',
    usedOn: ['Tapico'],
    note: 'Full-width image with caption above (V2 exploded view, keyboard). Candidate: extend ProjectImage with caption prop.',
  },
  {
    name: 'Stacked grid cell',
    classRef: '.project-cell--stack',
    usedOn: ['Tapico'],
    note: 'Tall two-image stack inside a 5-column grid. Candidate: ProjectDetailImage stack variant or ProjectStackedCell.',
  },
  {
    name: 'Responsive hide / show pair',
    classRef: '.project-hide-mobile + .project-show-mobile-only',
    usedOn: ['Tapico', 'Conic Collection'],
    note: 'Desktop grid cell hidden on mobile, alternate full image shown instead.',
  },
];

const readCssToken = (name: string, fallback: string) =>
  globalCssSource.match(new RegExp(`^\\s*${name}:\\s*([^;]+);`, 'm'))?.[1].trim() ?? fallback;

const colorTokens = [
  { name: '--color-bg', fallback: '#ffffff', role: 'Primary page background' },
  { name: '--color-surface-soft', fallback: '#f7f5f1', role: 'Borderless cards and controls' },
  { name: '--color-surface-strong', fallback: '#eeebe5', role: 'Selected and nested surfaces' },
  { name: '--color-text', fallback: '#1a1a1a', role: 'Main reading text' },
  { name: '--color-text-soft', fallback: '#5a5a5a', role: 'Header menu links and subtle emphasis text' },
  { name: '--color-link-strong', fallback: 'var(--color-text)', role: 'Default for dark links' },
  { name: '--color-link-strong-hover', fallback: 'var(--color-text-soft)', role: 'Hover for dark links' },
  { name: '--color-link-soft', fallback: 'var(--color-text-soft)', role: 'Default for softer links' },
  { name: '--color-link-soft-hover', fallback: 'var(--color-text)', role: 'Hover for softer links' },
  { name: '--color-text-muted', fallback: '#888888', role: 'Secondary labels and UI hints' },
  { name: '--color-border', fallback: '#e0ddd8', role: 'Necessary separators and diagrams' },
].map((token) => ({
  ...token,
  value: readCssToken(token.name, token.fallback),
}));

const typographyScale = [
  {
    token: 'Display / h1',
    value: 'clamp(1.95rem, 2.5vw, 2.85rem)',
    sample: 'Industrial design, made tactile.',
    note: 'Page-level title and hero intro',
  },
  {
    token: 'Section heading / h2',
    value: 'clamp(1.35rem, 1.8vw, 2rem)',
    sample: 'Process and outputs',
    note: 'Top-level section breaks',
  },
  {
    token: 'Subheading / h3',
    value: '1.1rem',
    sample: 'Materials and ergonomics',
    note: 'Nested sections and card titles',
  },
  {
    token: 'Body copy',
    value: '1rem / 1.55',
    sample:
      'Used for narrative sections. Keep width around 52-62ch so dense process writing remains easy to scan.',
    note: 'Long-form description text',
  },
  {
    token: 'Caption',
    value: '1.2em / 1.1',
    sample: 'Foam model before final chamfer direction',
    note: 'Image overlays in case-study grids',
  },
];

const spacingScale = [
  { token: '--space-related', value: '1em', use: 'Continuous / related blocks in a project stack' },
  { token: '--space-section', value: '5em / 3em tablet', use: 'Default gap between project sections' },
  { token: '--space-major', value: '8em / 5em tablet', use: 'Provisional chapter break — tune later' },
  { token: '1em', value: '1em', use: 'Default gutter + grid gap' },
];

const layoutRules = [
  {
    name: 'Project stack rhythm',
    value: 'margin-top on siblings via --space-*',
    why: 'One gap between sections (related / section / major). Blocks do not pad top and bottom.',
  },
  {
    name: 'Fluid site gutter',
    value: 'max(1em, calc((100% - 60em) / 2))',
    why: 'Keeps content comfortable at every size while preserving edge breathing room.',
  },
  {
    name: 'Core unit',
    value: '1em',
    why: 'Use 1em steps before introducing custom values so pages feel related.',
  },
  {
    name: 'Page transition',
    value: '0.5s overlay fade',
    why: 'Shared entry/exit timing from `Layout.astro` keeps navigation calm.',
  },
];

const foundationLinks = [
  { id: 'styles-colors', label: 'Color tokens' },
  { id: 'styles-typography', label: 'Typography' },
  { id: 'styles-spacing', label: 'Spacing' },
  { id: 'styles-layout-rules', label: 'Layout rules' },
];

const componentLinks = componentCatalog.map((component) => ({
  id: component.id,
  label: component.name,
}));

const sectionLinks = [
  { id: 'styles-intro', label: 'Design system' },
  {
    label: 'Foundations',
    defaultOpen: true,
    children: foundationLinks,
  },
  {
    label: 'Components',
    children: [
      { id: 'styles-components', label: 'Overview' },
      ...componentLinks,
    ],
  },
  {
    label: 'Patterns',
    children: [
      { id: 'styles-pending', label: 'Pending patterns' },
      { id: 'styles-interaction', label: 'Interaction sample' },
    ],
  },
];

const catalogByCategory = (Object.keys(categoryLabels) as ComponentCategory[]).map((category) => ({
  category,
  label: categoryLabels[category],
  items: componentCatalog.filter((entry) => entry.category === category),
}));
---

<Layout title="Design System — Vicente Cruz" serif>
  <div class="styles-page">
    <Header title="Design System" />

    <div class="styles-layout">
      <SectionSidebarNav
        sectionLinks={sectionLinks}
        ariaLabel="Design System page sections"
        enableEasingDevPanel={false}
      />

      <main class="styles-main">
        <section id="styles-intro" class="styles-intro section-block">
          <p class="intro-copy">
            This page is the single source of truth for site components, tokens, and project-page patterns.
            Edit a component in <code>src/components/</code> — every project page imports from here. Use the live
            previews below to QA before shipping updates to Work, Play, and case studies.
          </p>
        </section>

        <section id="styles-colors" class="section-block">
          <h2>Color tokens</h2>
          <div class="token-grid">
            {colorTokens.map((token) => {
              const editable = import.meta.env.DEV && /^#[0-9a-f]{3,6}$/i.test(token.value);
              return (
                <article class="token-card">
                  {editable ? (
                    <button
                      type="button"
                      class="token-card__swatch"
                      style={`background:${token.value};`}
                      aria-label={`Edit ${token.name}`}
                      data-dev-edit-trigger="style-color-token"
                      data-color-token-name={token.name}
                      data-color-token-value={token.value}
                      data-color-token-saved-value={token.value}
                      disabled
                    ></button>
                  ) : (
                    <div class="token-card__swatch" style={`background:${token.value};`}></div>
                  )}
                  <p class="meta-label">{token.name}</p>
                  <p class="meta-values" data-token-value>{token.value}</p>
                  <p class="token-note">{token.role}</p>
                </article>
              );
            })}
          </div>
        </section>

        <section id="styles-typography" class="section-block">
          <h2>Typography</h2>
          <div class="stack">
            {typographyScale.map((item) => (
              <article class="type-card">
                <div class="type-card__meta">
                  <div>
                    <p class="meta-label">{item.token}</p>
                    <p class="meta-values">{item.value}</p>
                  </div>
                  <p class="token-note">{item.note}</p>
                </div>

                {item.token === 'Display / h1' && <h1 class="preview-h1">{item.sample}</h1>}
                {item.token === 'Section heading / h2' && <h2 class="preview-h2">{item.sample}</h2>}
                {item.token === 'Subheading / h3' && <h3 class="preview-h3">{item.sample}</h3>}
                {item.token === 'Body copy' && <p class="preview-body">{item.sample}</p>}
                {item.token === 'Caption' && (
                  <div class="caption-preview">
                    <img src={`/images/${previewDetail}`} alt="Caption style preview" />
                    <span class="project-caption">{item.sample}</span>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>

        <section id="styles-spacing" class="section-block">
          <h2>Spacing</h2>
          <div class="stack">
            {spacingScale.map((item) => (
              <article class="spacing-row">
                <div class="spacing-row__meta">
                  <p class="meta-label">{item.token}</p>
                  <p class="token-note">{item.use}</p>
                </div>
                <div class="spacing-row__samples">
                  <div class="spacing-row__sample">
                    <p class="meta-label">Horizontal</p>
                    <div class="spacing-row__sample-area">
                      <div class="spacing-row__bar-h" style={`width:${item.value};`}></div>
                    </div>
                  </div>
                  <div class="spacing-row__sample">
                    <p class="meta-label">Vertical</p>
                    <div class="spacing-row__sample-area spacing-row__sample-area--vertical">
                      <div class="spacing-row__bar-v" style={`height:${item.value};`}></div>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-layout-rules" class="section-block">
          <h2>Layout rules</h2>
          <div class="stack">
            {layoutRules.map((rule) => (
              <article class="rule-card">
                <div class="token-row__top">
                  <span class="token-name">{rule.name}</span>
                  <span class="token-value">{rule.value}</span>
                </div>
                <p class="token-note">{rule.why}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-components" class="section-block">
          <h2>Component library</h2>
          <p class="section-note">
            {componentCatalog.length} components across site chrome and project pages. Each card shows a live
            preview, source file, props, and where it is used today.
          </p>

          {catalogByCategory.map(({ category, label, items }) => (
            <div class="component-group">
              <h3 class="component-group__title">{label}</h3>
              <div class="stack">
                {items.map((component) => (
                  <article id={component.id} class="component-card section-block">
                    <div class="component-card__head">
                      <h4>{component.name}</h4>
                      <p>{component.purpose}</p>
                    </div>

                    <div class="component-meta-grid">
                      <div>
                        <p class="meta-label">Source</p>
                        <p class="meta-values"><code>{component.source}</code></p>
                      </div>
                      <div>
                        <p class="meta-label">Props</p>
                        <p class="meta-values"><code>{component.props}</code></p>
                      </div>
                      <div>
                        <p class="meta-label">Class reference</p>
                        <p class="meta-values">{component.classRef}</p>
                      </div>
                      <div>
                        <p class="meta-label">Used on</p>
                        <p class="meta-values">{component.usedOn.join(', ')}</p>
                      </div>
                      <div class="component-meta-grid__full">
                        <p class="meta-label">QA checklist</p>
                        <p class="meta-values">{component.checklist}</p>
                      </div>
                    </div>

                    <div class="component-preview">
                      {component.preview === 'header' && (
                        <p class="preview-note">Rendered at the top of this page.</p>
                      )}
                      {component.preview === 'footer' && (
                        <p class="preview-note">Rendered at the bottom of this page.</p>
                      )}
                      {component.preview === 'sidebar-nav' && (
                        <p class="preview-note">Fixed nav on the left of this page (desktop).</p>
                      )}
                      {component.preview === 'project-layout' && (
                        <p class="preview-note">
                          Wraps project pages — see any case study (e.g.{' '}
                          <a href="/tapico" class="project-inline-link">Tapico</a>).
                        </p>
                      )}
                      {component.preview === 'image-lead' && (
                        <ProjectImage src={previewHero} alt="ProjectImage lead preview" kind="lead" />
                      )}
                      {component.preview === 'tagline' && (
                        <ProjectTagline text="A calculator, but for words." />
                      )}
                      {component.preview === 'prose' && (
                        <ProjectProse>
                          <p>
                            Designed for narrative flow between media modules. Keep this block comfortable and
                            readable, then let images carry detail.
                          </p>
                        </ProjectProse>
                      )}
                      {component.preview === 'section-title' && (
                        <ProjectSectionTitle title="Research" />
                      )}
                      {component.preview === 'image' && (
                        <ProjectImage src={previewWide} alt="ProjectImage preview" constrained mobileHeight="35" />
                      )}
                      {component.preview === 'grid' && (
                        <ProjectGrid cols={3}>
                          <ProjectDetailImage src={previewDetail} alt="Grid cell 1" />
                          <ProjectDetailImage src="IMG_5695.jpg" alt="Grid cell 2" />
                          <ProjectDetailImage src="IMG_5818.jpg" alt="Grid cell 3" />
                        </ProjectGrid>
                      )}
                      {component.preview === 'caption-image' && (
                        <ProjectGrid cols={3}>
                          <ProjectCaptionImage
                            src={previewSquare}
                            alt="Caption preview"
                            caption="reMarkable 2"
                            square
                          />
                          <ProjectCaptionImage
                            src="TextingUpdated.jpg"
                            alt="Caption preview"
                            caption="Light Phone II"
                            square
                          />
                          <ProjectCaptionImage
                            src="pomera dm30.png"
                            alt="Caption preview"
                            caption="Pomera DM30"
                            square
                          />
                        </ProjectGrid>
                      )}
                      {component.preview === 'detail-image' && (
                        <ProjectGrid cols={2}>
                          <ProjectDetailImage
                            src="first click snap.jpg"
                            alt="Detail with caption"
                            caption="First snap"
                            captionVariant="dark"
                          />
                          <ProjectDetailImage src="IMG_5842.jpg" alt="Detail without caption" />
                        </ProjectGrid>
                      )}
                      {component.preview === 'context-image' && (
                        <div class="project-context-grid project-context-grid--preview">
                          <ProjectContextImage
                            src="Dieter Rams Radio Inspiration.png"
                            alt="Context preview"
                            caption="Dieter Rams BT 3 radio"
                          />
                          <ProjectContextImage
                            src="205_2_dieter_rams_the_jf_chen_co.png"
                            alt="Context preview"
                            caption="Dieter Rams 606 shelving"
                          />
                        </div>
                      )}
                      {component.preview === 'reference-image' && (
                        <div class="project-reference-grid project-reference-grid--preview">
                          <ProjectReferenceImage
                            src="Porcelain Jugs reference.jpeg"
                            alt="Reference preview"
                            caption="Stacking jugs reference"
                            href="https://example.com"
                          />
                          <ProjectReferenceImage
                            src="Stacking Mugs reference.jpg"
                            alt="Reference preview"
                            caption="Stacking mugs reference"
                            href="https://example.com"
                          />
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>

        <section id="styles-pending" class="section-block">
          <h2>Pending patterns</h2>
          <p class="section-note">
            Raw markup still used on some project pages — not yet extracted into components. Promote these when
            a second page needs the same pattern.
          </p>
          <div class="stack">
            {pendingPatterns.map((pattern) => (
              <article class="rule-card">
                <div class="token-row__top">
                  <span class="token-name">{pattern.name}</span>
                  <span class="token-value">{pattern.classRef}</span>
                </div>
                <p class="token-note">
                  <strong>Used on:</strong> {pattern.usedOn.join(', ')}. {pattern.note}
                </p>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-interaction" class="section-block">
          <h2>Interaction sample</h2>
          <article class="rule-card">
            <p class="section-note">
              Hover tone should stay subtle. This link uses the same transition behavior as inline project links:
              <a href="#" class="project-inline-link"> read case-study details</a>.
            </p>
          </article>
        </section>
      </main>
    </div>

    {import.meta.env.DEV && <StyleColorTokenEditor />}
    <Footer />
  </div>
</Layout>

<style>
  .styles-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .styles-main {
    flex: 1;
    padding-block: 2em 3em;
    display: flex;
    flex-direction: column;
    gap: 2.5em;
  }

  .styles-layout {
    position: relative;
  }

  .section-block[id] {
