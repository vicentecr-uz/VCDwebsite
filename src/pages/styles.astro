                          <TextField label="Prefixed" prefix="example.com/" placeholder="project-name" />
                        </div>
                      )}
                      {component.preview === 'ui-text-area' && (
                        <div style="background: var(--sys-color-srf); border-radius: var(--radius-control); padding: 1em;">
                          <TextArea
                            label="Notes"
                            value={'First line of notes.\nSecond line with a bit more detail.\nThird line.'}
                          />
                        </div>
                      )}
                      {component.preview === 'ui-select-field' && (
                        <div style="background: var(--sys-color-srf); border-radius: var(--radius-control); padding: 1em;">
                          <SelectField
                            label="Label"
                            options={[
                              { value: 'a', label: 'Option A' },
                              { value: 'b', label: 'Option B' },
                              { value: 'c', label: 'Option C' },
                            ]}
                          />
                        </div>
                      )}
                      {component.preview === 'ui-toggle-row' && (
                        <div style="background: var(--sys-color-srf); border-radius: var(--radius-control); padding: 1em; display: flex; flex-direction: column; gap: 0.5em;">
                          <ToggleRow label="Unchecked" />
                          <ToggleRow label="Checked" checked />
                        </div>
                      )}
                      {component.preview === 'ui-panel-actions' && (
                        <div style="background: var(--sys-color-srf); border-radius: var(--radius-control); padding: 1em;">
                          <PanelActions>
                            <Button emphasis="ghost" label="Cancel" />
                            <Button emphasis="ghost" label="Revert changes" />
                            <Button emphasis="filled" label="Save changes" />
                          </PanelActions>
                        </div>
                      )}
                      {component.preview === 'ui-badge' && (
                        <div style="background: var(--sys-color-srf); border-radius: var(--radius-control); padding: 1em; display: flex; flex-wrap: wrap; gap: 0.5em;">
                          <Badge label="On page" />
                          <Badge label="Library" />
                          <Badge label="Draft" />
                        </div>
                      )}
                      {component.preview === 'ui-hairline' && (
                        <div style="background: var(--sys-color-srf); border-radius: var(--radius-control); padding: 1em; display: flex; flex-direction: column; gap: 0.75em; max-width: 20em;">
                          <p class="preview-note">Line above</p>
                          <Hairline />
