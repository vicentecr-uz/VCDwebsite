                  </article>
                ))}
              </div>
            </div>
          ))}
        </section>

        {!hiddenSectionIds.has('styles-pending') && (
        <section id="styles-pending" class="section-block">
          <h2>Legacy patterns</h2>
          <p class="section-note">
            Raw markup still present on older Webflow-migration case studies. These are <strong>not</strong> signed
            off — do not copy into new pages or when porting content to Tapico-style layouts.
          </p>
          <div class="stack">
            {legacyPatterns.map((pattern) => (
              <article class="rule-card">
                <div class="token-row__top">
                  <span class="token-name">{pattern.name}</span>
                  <span class="token-value">{pattern.classRef}</span>
                </div>
                <p class="token-note">
                  <strong>Used on:</strong> {pattern.usedOn.join(', ')}. {pattern.note}
                </p>
              </article>
            ))}
          </div>
        </section>
        )}

        {!hiddenSectionIds.has('styles-interaction') && (
        <section id="styles-interaction" class="section-block">
          <h2>Interaction sample</h2>
          <article class="rule-card">
            <p class="section-note">
              Hover tone should stay subtle. This link uses the same transition behavior as inline project links:
              <a href="#" class="project-inline-link"> read case-study details</a>.
            </p>
          </article>
        </section>
        )}
      </main>
    </div>

    {import.meta.env.DEV && <StyleColorTokenEditor />}
    {import.meta.env.DEV && <ProjectSectionNavEditor />}
    <Footer />
  </div>
</Layout>

<style>
  @font-face {
    font-family: 'Paper Mono';
    src: url('/fonts/paper-mono/PaperMono-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .styles-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .styles-main {
    flex: 1;
    padding-block: 2em 3em;
    display: flex;
    flex-direction: column;
    gap: 2.5em;
  }

  .styles-intro > :global(.project-block--text),
  #styles-components > :global(.project-block--text) {
    width: 100%;
  }

  .styles-layout {
    position: relative;
  }

  .section-block[id] {
    scroll-margin-top: 9.5em;
  }

  .section-block {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  h1,
  h2,
  h3,
  h4 {
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  h2 {
    font-weight: var(--text-heading-1-weight);
    font-size: var(--text-heading-1-size);
    line-height: var(--text-heading-1-leading);
    letter-spacing: var(--text-heading-1-tracking);
  }

  h1 {
    font-size: clamp(1.9rem, 2.4vw, 2.6rem);
  }

  h3,
  h4 {
    font-size: 1.1rem;
  }

  .meta-values {
    font-family: var(--font-mono);
  }

  .meta-values code,
  .token-note code {
    font-size: 0.92em;
    font-family: var(--font-mono);
  }

  /* This page prints technical strings — file paths, prop lists, CSS values —
     that carry no natural break opportunity, so each sets a min-content width
     as wide as the whole string. Grid and flex items default to a min size of
     auto and refuse to shrink below that, which pushed the page wider than the
     viewport on a phone. `anywhere` (not `break-word`) is the one that also
     lowers min-content, so the tracks can actually shrink. */
  .meta-values,
  .meta-values code,
  .token-note code,
  .token-value,
  .token-name,
  .token-note,
  .meta-label,
  .section-note,
  .preview-note,
  .card-heading,
  .component-group__title {
    overflow-wrap: anywhere;
  }

  .component-meta-grid > *,
  .token-grid > *,
  .spacing-row > *,
  .spacing-row__samples > *,
  .type-card__meta > *,
  .token-row__top > * {
    min-width: 0;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 0.85em;
  }

  .type-card,
  .rule-card,
  .spacing-row,
  .component-card,
  .token-group {
    border: 0;
    border-radius: var(--radius-card-smooth);
    corner-shape: var(--squircle-shape);
    --corner-shape: var(--squircle-shape);
    padding: 1em;
    background-color: var(--sys-color-srf-container-low);
  }

  /*
    Colour swatches: plain border-radius + box-shadow hover ring.
    Squircle + Hyperellipse here fought nested clipping and could not keep a
    uniform hover stroke (concentric squircles ≠ constant width).
  */
  .token-card {
    border: 0;
    border-radius: var(--radius-card-smooth);
    padding: 1em;
    background-color: var(--sys-color-srf-container-low);
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .token-tier-heading {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--sys-color-on-srf-variant);
    margin-block: 1.4em 0.6em;
  }

  .token-tier-heading:first-of-type {
    margin-block-start: 0;
  }

  .token-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85em;
  }

  .token-card__swatch {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 2.5;
    border: 0;
    border-radius: var(--radius-control);
    padding: 0;
    appearance: none;
