const readCssToken = (name: string, fallback: string) =>
  globalCssSource.match(new RegExp(`^\\s*${name}:\\s*([^;]+);`, 'm'))?.[1].trim() ?? fallback;

/**
 * Follow a `var(--x)` chain down to the literal it eventually resolves to.
 * Only `ref` tokens hold literal hex, so a `sys` role has to be walked to
 * find the swatch colour — and to know which palette entry backs it.
 */
const resolveCssToken = (name: string, seen = new Set<string>()): string => {
  if (seen.has(name)) return '';
  seen.add(name);
  const raw = readCssToken(name, '');
  const alias = /^var\(\s*(--[a-z0-9-]+)\s*\)$/i.exec(raw);
  return alias ? resolveCssToken(alias[1], seen) : raw;
};

/** The `ref` palette — the only tier holding literal hex, so the only editable one. */
const paletteTokens = [...globalCssSource.matchAll(/^\s*(--ref-palette-[a-z0-9-]+):\s*(#[0-9a-f]{3,8});/gim)]
  .map((m) => ({ name: m[1], value: m[2] }))
  .filter((token, i, all) => all.findIndex((t) => t.name === token.name) === i);

/**
 * `sys` roles. Derived, never hand-edited — edit the palette entry each one
 * points at instead. Listed in dependency order, not alphabetically.
 */
const roleTokens = [
  { name: '--sys-color-srf', role: 'The page itself' },
  { name: '--sys-color-srf-container-low', role: 'Subtly raised — panels, soft button fills' },
  { name: '--sys-color-srf-container', role: 'Filled control that reads as a shape with no border' },
  { name: '--sys-color-srf-container-high', role: 'Strongest normal surface — pressed states' },
  { name: '--sys-color-inverse-srf', role: 'Deliberately opposes the page — solid buttons' },
  { name: '--sys-color-on-srf', role: 'Default ink' },
  { name: '--sys-color-on-srf-variant', role: 'Secondary ink — menu links, subtle emphasis' },
  { name: '--sys-color-on-srf-variant', role: 'Muted ink — captions, field labels' },
  { name: '--sys-color-inverse-on-srf', role: 'Ink sitting on inverse-srf' },
  { name: '--sys-color-outline', role: 'Visible edge — button rings, dividers' },
  { name: '--sys-color-outline-variant', role: 'Quieter hairline — separators' },
  { name: '--sys-color-error', role: 'Danger accent' },
  { name: '--sys-color-error-container', role: 'Danger surface' },
  { name: '--sys-color-on-error-container', role: 'Ink on a danger surface' },
  { name: '--sys-color-link', role: 'Default link' },
  { name: '--sys-color-link-soft', role: 'Softer link' },
  { name: '--sys-color-link-soft-hover', role: 'Hover for softer links' },
].map((token) => ({
  ...token,
  alias: readCssToken(token.name, ''),
  value: resolveCssToken(token.name),
}));

