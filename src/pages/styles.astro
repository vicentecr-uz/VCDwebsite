  {
    name: 'Page transition',
    value: '0.25s entry fade + 0.25s exit fade',
    why: 'Enter waits for fonts + viewport-visible LQIP/thumbs plus a painted veil frame; both use `Layout.astro` and keep the 4s fallback.',
  },
];

const foundationLinks = [
  { id: 'styles-typography', label: 'Typography' },
  { id: 'styles-spacing', label: 'Spacing' },
  { id: 'styles-layout-rules', label: 'Layout rules' },
];

const hiddenSectionIds = new Set([
  'styles-colors',
  'styles-surface-base',
  'styles-pending',
  'styles-interaction',
  'patterns',
]);

const catalogByCategory = (Object.keys(categoryLabels) as ComponentCategory[]).map((category) => ({
  category,
  label: categoryLabels[category],
  items: componentCatalog.filter((entry) => entry.category === category),
}));

/** Match page render order (grouped by category), not raw catalog order. */
const pageBlockLinks = catalogByCategory
  .filter(({ category }) => category !== 'ui-primitives')
  .flatMap(({ items }) => items.map((component) => ({ id: component.id, label: component.name })));
const devComponentLinks =
  catalogByCategory.find(({ category }) => category === 'ui-primitives')?.items.map((component) => ({
    id: component.id,
    label: component.name,
  })) ?? [];

const catalogSectionLinks = [
  { id: 'styles-intro', label: 'Design system' },
  {
    label: 'Foundations',
    defaultOpen: true,
    children: foundationLinks,
  },
  {
    label: 'Page Blocks',
    children: [
      { id: 'styles-components', label: 'Overview' },
      ...pageBlockLinks,
    ],
  },
  {
    label: 'Dev Components',
    children: devComponentLinks,
  },
];

const savedOutline = normalizeOutline(stylesNav.outline ?? []);
const hasSavedOutline = savedOutline.length > 0 || ('outlineConfigured' in stylesNav && stylesNav.outlineConfigured === true);
const outline = hasSavedOutline ? savedOutline : outlineFromNav(catalogSectionLinks);
const visibleOutline = outline.filter((entry) =>
  entry.kind === 'group'
    ? !hiddenSectionIds.has(entry.id) && entry.label !== 'Patterns'
    : !hiddenSectionIds.has(entry.anchor ?? entry.id),
).map((entry) =>
  entry.kind === 'group' && hiddenSectionIds.has(entry.anchor ?? '')
    ? { ...entry, anchor: undefined }
    : entry,
);
const sectionLinks = deriveNavFromOutline(visibleOutline);
---

<Layout title="Design System — Vicente Cruz">
  <div
    class="styles-page"
    data-section-nav-root
    data-section-nav-document="styles"
    data-section-nav-outline-only="true"
    data-section-nav={JSON.stringify(sectionLinks)}
    data-section-outline={JSON.stringify(visibleOutline)}
  >
    <Header title="Design System" />

    <div class="styles-layout">
      <SectionSidebarNav
        sectionLinks={sectionLinks}
        ariaLabel="Design System page sections"
        desktopOnly
      />

      <main id="main-content" class="styles-main" data-section-nav-main>
        <section id="styles-intro" class="styles-intro section-block">
          <ProjectBodyText
            paragraphs={stylesNav.introParagraphs ?? []}
            documentKey="styles"
            pathPrefix={['introParagraphs']}
            spacing="none"
          />
        </section>

        {hiddenSectionIds.has('styles-colors') ? null : (
          <section id="styles-colors" class="section-block">
            <h2>Color tokens</h2>

            <h3 class="token-tier-heading">ref &middot; palette</h3>
            <div class="token-grid">
              {paletteTokens.map((token) => {
                const editable = import.meta.env.DEV;
                return (
                  <article class="token-card">
                    {editable ? (
                      <button
                        type="button"
                        class="token-card__swatch"
                        style={`background:var(${token.name});`}
                        aria-label={`Edit ${token.name}`}
                        data-dev-edit-trigger="style-color-token"
                        data-color-token-name={token.name}
                        data-color-token-value={token.value}
                        data-color-token-saved-value={token.value}
                        disabled
                      ></button>
                    ) : (
                      <div class="token-card__swatch" style={`background:var(${token.name});`}></div>
                    )}
                    <p class="meta-label">{token.name}</p>
                    <p class="meta-values" data-token-value>{token.value}</p>
                  </article>
                );
              })}
            </div>

            <h3 class="token-tier-heading">sys &middot; roles</h3>
            <div class="token-grid">
              {roleTokens.map((token) => (
                <article class="token-card">
                  <div class="token-card__swatch" style={`background:var(${token.name});`}></div>
                  <p class="meta-label">{token.name}</p>
                  <p class="meta-values" data-token-value>{token.alias}</p>
                  <p class="token-note">{token.role}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section id="styles-typography" class="section-block">
          <h2>Typography</h2>
          <div class="stack">
            {typographyScale.map((item) => (
              <article class="type-card">
                <div class="type-card__meta">
                  <div>
                    <h3 class="card-heading">{item.label}</h3>
                    <p class="meta-values">{item.spec}</p>
                  </div>
                  <p class="token-note">{item.note}</p>
                </div>
                <p class:list={['type-preview', `type-preview--${item.role}`]}>{item.sample}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-spacing" class="section-block">
          <h2>Spacing</h2>
          <div class="stack">
            {spacingScale.map((item) => (
              <article class="spacing-row">
                <div class="spacing-row__meta">
                  <p class="meta-label">{item.token}</p>
                  <p class="token-note">{item.use}</p>
                </div>
                <div class="spacing-row__samples">
                  <div class="spacing-row__sample">
                    <p class="meta-label">Horizontal</p>
                    <div class="spacing-row__sample-area">
                      <div class="spacing-row__bar-h" style={`width:${item.value};`}></div>
                    </div>
                  </div>
                  <div class="spacing-row__sample">
                    <p class="meta-label">Vertical</p>
                    <div class="spacing-row__sample-area spacing-row__sample-area--vertical">
                      <div class="spacing-row__bar-v" style={`height:${item.value};`}></div>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="styles-layout-rules" class="section-block">
          <h2>Layout rules</h2>
          <div class="stack">
            {layoutRules.map((rule) => (
              <article class="rule-card">
                <div class="token-row__top">
                  <span class="token-name">{rule.name}</span>
                  <span class="token-value">{rule.value}</span>
                </div>
                <p class="token-note">
                  {rule.why.split('`').map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}
                </p>
              </article>
            ))}
          </div>
        </section>

        {hiddenSectionIds.has('styles-surface-base') ? null : (
          <section id="styles-surface-base" class="section-block">
            <h2>Surface Base</h2>
            <div class="component-preview styles-surface-preview">
              <div class="dev-surface styles-surface-specimen">
                <span class="meta-label">Surface Base</span>
              </div>
            </div>
          </section>
        )}

        <section class="section-block">
          <div id="styles-components" class="section-block">
            <h2>Page Blocks</h2>
            <ProjectBodyText
              paragraphs={[`${componentCatalog.length} signed-off components and patterns across site chrome, portfolio listings, and project pages (vetted on Home/Work/Play + Tapico). Each is built for reuse on future case studies. Cards show a live preview, source file, props, and where it is used today.`]}
              spacing="none"
            />
          </div>

          {catalogByCategory.map(({ category, label, items }) => (
            <div class="component-group">
              {category === 'ui-primitives' ? (
                <h2 id="styles-dev-components" class="component-group__title component-group__title--major">
                  Dev Components
                </h2>
              ) : (
                <h3 class="component-group__title">{label}</h3>
              )}
              <div class="stack">
                {items.map((component) => (
                  <article id={component.id} class="component-card section-block">
                    <div class="component-card__head">
                      <h4 class="card-heading">{component.name}</h4>
                      <div class="project-body-text">
                        <p>{component.purpose}</p>
                      </div>
                    </div>

                    <div class="component-meta-grid">
                      <div>
                        <p class="meta-label">Source</p>
                        <p class="meta-values"><code>{component.source}</code></p>
                      </div>
                      <div>
                        <p class="meta-label">Props</p>
                        <p class="meta-values"><code>{component.props}</code></p>
                      </div>
                      <div>
                        <p class="meta-label">Class reference</p>
                        <p class="meta-values">{component.classRef}</p>
                      </div>
                      <div>
                        <p class="meta-label">Used on</p>
                        <p class="meta-values">{component.usedOn.join(', ')}</p>
                      </div>
                    </div>

                    <div class:list={['component-preview', { 'component-preview--video': component.preview === 'video' }]}>
                      {component.preview === 'header' && (
                        <p class="preview-note">Rendered at the top of this page.</p>
                      )}
                      {component.preview === 'footer' && (
                        <p class="preview-note">Rendered at the bottom of this page.</p>
                      )}
                      {component.preview === 'sidebar-nav' && (
                        <p class="preview-note">Fixed nav on the left of this page (desktop).</p>
                      )}
                      {component.preview === 'project-grid' && (
                        <ProjectGrid
                          variant="work"
                          items={[
                            {
                              title: 'Tapico Typer',
                              subtitle: '2024',
                              image: 'Tapico White Hero Center Crop.jpg',
                              hoverImage: 'IMG_5609.jpg',
                              bg: '#e8e4dc',
                              dark: false,
                              href: '/tapico',
                            },
                            {
                              title: 'Another project',
                              subtitle: '2023',
                              image: 'IMG_5609.jpg',
                              bg: '#1a1a1a',
                              dark: true,
                              href: '/tapico',
                            },
                          ]}
                        />
                      )}
                      {component.preview === 'project-layout' && (
                        <p class="preview-note">
                          Wraps project pages — see any case study (e.g.{' '}
                          <a href="/tapico" class="project-inline-link">Tapico</a>).
                        </p>
                      )}
                      {component.preview === 'image-lead' && (
                        <ProjectImage src={previewHero} alt="ProjectImage lead preview" kind="lead" />
                      )}
                      {component.preview === 'project-award' && (
                        <ProjectAward href="https://ifdesign.com/en/winner-ranking/project/goodhome-painting-tools/768056" spacing="none" />
                      )}
                      {component.preview === 'project-details' && (
                        <ProjectDetails title="Project details & credits" rows={[
                          { label: 'Role', value: 'Industrial Designer' },
                          { label: 'Dates', value: '2024–2025' },
                          { label: 'Employer', value: 'Kingfisher' },
                          { label: 'Brand', value: 'GoodHome' },
                          { label: 'Status', value: 'In production' },
                          { label: 'Contribution', value: 'CAD, iterative prototyping, roller-handle development and scraper adaptation.' },
                          { label: 'Collaborator', value: 'David Needham, senior designer — introduced the structured benchmarking method.' },
                        ]} />
                      )}
                      {component.preview === 'body-text' && (
                        <ProjectBodyText
                          paragraphs={[
                            'Default body text. <span class="text-subtle">Subtle context.</span> <strong>Bold text.</strong> <span class="text-emphasis">Existing medium-weight emphasis.</span>',
                          ]}
                        />
                      )}
                      {component.preview === 'section-title' && (
                        <ProjectSectionTitle title="Research" />
                      )}
                      {component.preview === 'image-grid' && (
                        <ProjectImageGrid
                          columns={2}
                          defaultAspectRatio="4:3"
                          items={[
                            { src: previewHero, alt: 'Three-quarter view' },
                            { src: previewDetail, alt: 'Screen close-up' },
                          ]}
                        />
                      )}
                      {component.preview === 'press-quote-ticker' && (
                        <ProjectPressQuoteTicker items={previewPressQuotes} />
                      )}
                      {component.preview === 'reddit-comment-carousel' && (
                        <ProjectRedditCommentCarousel items={previewRedditComments} />
                      )}
                      {component.preview === 'video' && (
                        <ProjectVideo
                          src="/images/DJI_20240617_171949_018_video-3.mp4"
                          alt="New Classic utility knife video demo"
                          spacing="none"
                        />
