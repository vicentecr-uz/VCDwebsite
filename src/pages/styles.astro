<script>
  document.querySelectorAll('.component-preview .dev-segmented').forEach((group) => {
    group.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement | null)?.closest('.dev-btn');
      if (!(btn instanceof HTMLElement) || !group.contains(btn)) return;
      group.querySelectorAll('.dev-btn').forEach((sibling) => {
        sibling.classList.remove('is-selected', 'is-active');
        sibling.removeAttribute('aria-pressed');
      });
      btn.classList.add('is-selected', 'is-active');
      btn.setAttribute('aria-pressed', 'true');
    });
  });
</script>
