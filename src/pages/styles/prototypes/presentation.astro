---
import DocumentationLayout from '../../../layouts/DocumentationLayout.astro';
import Button from '../../../components/ui/Button.astro';
import { loadPageDocument } from '../../../lib/projects';
import { stylesPages } from '../../../lib/stylesCatalog';
import '../../../styles/demoFrame.css';

if (import.meta.env.PROD) return new Response(null, { status: 404 });
const { examples } = loadPageDocument('styles');
if (!examples) return Astro.redirect('/404');
const pages = stylesPages(examples);
const layoutRules = [
  { name: 'Project stack rhythm', value: 'margin-top: var(--project-stack-margin)', why: 'One gap between sections, set on the following block: related, group, section or major. Blocks never pad their own top and bottom.' },
  { name: 'Fluid site gutter', value: '--page-gutter: max(var(--space-unit), calc((100% - var(--page-max-width)) / 2))', why: 'Content stays off the edge at every width. Below 40em the gutter is a fixed 2rem.' },
  { name: 'Core unit', value: '--space-unit: calc(var(--text-body-size) * (var(--text-body-leading) - 0.697))', why: 'The ink gap between two body lines, about 15.4px. A line is 1u; a paragraph break or title gap is 2u.' },
  { name: 'Column caps', value: '--page-text-max-width: 37.5em; --page-media-max-width: 50em', why: 'Text and media cap separately. The outer column is the wider of the two.' },
  { name: 'Page transition', value: 'opacity 0.25s', why: 'Pages fade in once fonts and visible image previews are ready, and fade out on navigation. Nothing moves.' },
];
const typeRoles = [
  { role: 'body', label: 'Text', spec: '400 · 1.0625rem/1.6 · 0 · 60ch · 1u · on-srf (1rem/1.6 phone)', sample: 'Used for narrative sections. Measure capped at 60ch.', note: 'Long-form description text (.project-body-text)' },
  { role: 'heading-1', label: 'Heading 1', spec: '700 · 1.25rem/1.25 · -0.02em', sample: 'Process and outputs', note: 'Project section headings, level 2 (.project-section-title)' },
  { role: 'heading-2', label: 'Heading 2', spec: '700 · body size/leading · 0', sample: 'Material selection', note: 'Project section headings, level 3 (h3.project-section-title)' },
  { role: 'caption', label: 'Caption', spec: '600 · 1.2em/1.1 · -0.05ch', sample: 'Foam model before final chamfer direction', note: 'On-image overlay — ink sampled from media (.project-caption)' },
  { role: 'press-quote', label: 'Press quote', spec: 'italic 400 · 1.05em/1.35 · -0.01em', sample: '"An elegant, tactile solution."', note: 'Press quote ticker (.press-quote-ticker__quote)' },
];
const spacing = [
  { token: '--space-unit', value: '≈15.4px', length: 'var(--space-unit)', use: 'Line gap, chrome padding, grid gaps' },
  { token: '--space-related', value: '1u', length: 'var(--space-related)', use: 'Blocks that continue each other' },
  { token: '--space-group', value: '4rem', length: 'var(--space-group)', use: 'Same chapter, new beat' },
  { token: '--space-section', value: '8rem', length: 'var(--space-section)', use: 'Imagery to narrative text' },
  { token: '--space-major', value: '12rem', length: 'var(--space-major)', use: 'Chapter break' },
];
const button = {
  purpose: 'The one button. Emphasis sets how loudly it asks; everything else about it is fixed.',
  usage: [
    { when: 'Default action in a panel', use: 'Soft' },
    { when: 'The one action a panel exists for', use: 'Filled' },
    { when: 'Rows in a menu or segmented control', use: 'Ghost' },
    { when: 'A control sitting directly on the page', use: 'Page' },
    { when: 'Deleting something', use: 'Danger' },
    { when: 'A filled or soft button that must stand out a little more', use: 'Raised, opt-in' },
  ],
  props: [
    { name: 'emphasis', type: "'ghost' | 'soft' | 'filled' | 'page' | 'danger'", default: "'soft'" },
    { name: 'label', type: 'string', default: 'required' },
    { name: 'raised', type: 'boolean', default: 'false' },
    { name: 'selected', type: 'boolean', default: 'false' },
    { name: 'disabled', type: 'boolean', default: 'false' },
    { name: 'align', type: "'center' | 'start'", default: "'center'" },
    { name: 'width', type: "'hug' | 'fill'", default: "'hug'" },
    { name: 'type', type: "'button' | 'submit'", default: "'button'" },
  ],
  reference: [
    { name: 'Source', value: 'src/components/ui/Button.astro' },
    { name: 'Styles', value: 'src/styles/dev-chrome.css' },
    { name: 'Classes', value: '.dev-btn .dev-btn--{ghost,soft,filled,page,danger} .dev-btn--raised' },
    { name: 'Hit area', value: '8px beyond every visual edge' },
  ],
};
---

<DocumentationLayout title="Presentation" product="VCD" homeHref="/" pages={pages} hideContents contents={[]} githubHref="https://github.com/vicentecr-uz/VCDwebsite">
  <div class="presentation-variants">
  {[1, 2, 3].map((variant) => (
    <div class:list={['presentation', `presentation--${variant}`]} data-variant={variant} hidden={variant !== 1}>
      <section>
        <h2>Layout rules</h2>
        {variant === 1 && <div class="editorial-list">{layoutRules.map((rule) => (
          <div class="editorial-rule"><h3>{rule.name}</h3><p>{rule.why}</p><p class="mono variant rule-value">{rule.value}</p></div>
        ))}</div>}
        {variant === 2 && <div role="table" aria-label="Layout rules" class="ledger ledger--layout">
          <div role="row" class="ledger-head"><span role="columnheader">Rule</span><span role="columnheader">Value</span></div>
          {layoutRules.map((rule) => <div role="row" class="ledger-row"><span role="cell" class="medium">{rule.name}</span><div role="cell" class="layout-value"><span class="mono">{rule.value}</span><span class="variant small">{rule.why}</span></div></div>)}
        </div>}
        {variant === 3 && <div class="plate-list">{layoutRules.map((rule, index) => (
          <figure>
            <div class="demo-frame plate-frame">
              {index === 0 && <div class="schematic stack" aria-hidden="true"><div class="shape" /><div class="stack-gap stack-gap--small" /><div class="shape" /><div class="stack-gap stack-gap--large" /><div class="shape" /></div>}
              {index === 1 && <div class="schematic viewport" aria-hidden="true"><div class="gutter" /><div class="viewport-column" /><div class="gutter" /></div>}
              {index === 2 && <div class="schematic core-unit"><span class="bracket" aria-hidden="true" /><div>Hamburgefonstiv<br />Hamburgefonstiv</div></div>}
              {index === 3 && <div class="schematic caps" aria-hidden="true"><div class="shape caps-text" /><div class="shape" /></div>}
              {index === 4 && <div class="transition-squares" aria-hidden="true"><div /><div /><div /></div>}
            </div>
            <figcaption><div class="caption-row"><span class="medium">{rule.name}</span><span class="mono variant">{rule.value}</span></div><p class="variant small">{rule.why}</p></figcaption>
          </figure>
        ))}</div>}
      </section>

      <section>
        <h2>Typography</h2>
        {variant === 1 && <div class="editorial-list">{typeRoles.map((role) => <div>
          <p class:list={['type-preview', `type-preview--${role.role}`]}>{role.sample}</p>
          <div class="type-meta"><span class="medium">{role.label}</span><span class="mono variant">{role.spec}</span></div>
          <p class="subtle small">{role.note}</p>
        </div>)}</div>}
        {variant === 2 && <div role="table" aria-label="Typography" class="ledger ledger--type">
          <div role="row" class="ledger-head"><span role="columnheader">Role</span><span role="columnheader">Spec</span><span role="columnheader">Sample</span></div>
          {typeRoles.map((role) => <div role="row" class="ledger-row"><span role="cell" class="medium">{role.label}</span><span role="cell" class="mono variant">{role.spec}</span><span role="cell" class:list={['type-preview', 'ellipsis', `type-preview--${role.role}`]}>{role.sample}</span></div>)}
        </div>}
        {variant === 3 && <div class="plate-list">{typeRoles.map((role) => <figure>
          <div class="demo-frame plate-frame"><p class:list={['type-preview', `type-preview--${role.role}`]}>{role.sample}</p></div>
          <figcaption><div class="caption-row"><span class="medium">{role.label}</span><span class="mono variant">{role.spec}</span></div><p class="variant small">{role.note}</p></figcaption>
        </figure>)}</div>}
      </section>

      <section>
        <h2>Spacing</h2>
        {variant === 1 && <div class="spacing-list">{spacing.map((item) => <div>
          <div class="space-bar" style={{ width: item.length }} />
          <div class="spacing-meta"><span class="mono">{item.token}</span><span class="variant">{item.value}</span><span class="subtle">{item.use}</span></div>
        </div>)}</div>}
        {variant === 2 && <div role="table" aria-label="Spacing" class="ledger ledger--spacing">
          <div role="row" class="ledger-head"><span role="columnheader">Token</span><span role="columnheader">Value</span><span role="columnheader" aria-label="Measure" /><span role="columnheader">Use</span></div>
          {spacing.map((item) => <div role="row" class="ledger-row"><span role="cell" class="mono">{item.token}</span><span role="cell" class="variant">{item.value}</span><div role="cell"><div class="space-bar" style={{ width: item.length }} /></div><span role="cell" class="variant small">{item.use}</span></div>)}
        </div>}
        {variant === 3 && <figure>
          <div class="demo-frame plate-frame"><div class="spacing-specimen">{spacing.map((item) => <div class="space-bar" style={{ width: item.length }} />)}</div></div>
          <figcaption><ul class="spacing-caption">{spacing.map((item) => <li><span class="mono">{item.token}</span><span class="variant">{item.value}</span><span class="subtle">{item.use}</span></li>)}</ul></figcaption>
        </figure>}
      </section>

      <section>
        <h2>Button</h2>
        {variant === 1 && <p>{button.purpose}</p>}
        <figure class="button-example">
          <div class:list={['demo-frame', { 'plate-frame': variant === 3, 'button-plate': variant === 3 }]}>
            <div class="button-row">
              <Button emphasis="ghost" label="Ghost" />
              <Button emphasis="soft" label="Soft" />
              <Button emphasis="filled" label="Filled" />
              <Button emphasis="page" label="Page" />
              <Button emphasis="danger" label="Danger" />
              <Button emphasis="filled" label="Raised filled" raised />
              <Button emphasis="soft" label="Raised soft" raised />
            </div>
          </div>
          {variant === 3 && <figcaption><div class="caption-row"><span class="medium">Button</span><span class="mono variant">{button.reference[0].value}</span></div><p class="variant small">{button.purpose}</p></figcaption>}
        </figure>
        {variant === 1 && <>
          <h3 class="subheading">Usage</h3>
          <div class="usage-prose">{button.usage.map((item) => <p>{item.when} — <span class="medium">{item.use}</span>.</p>)}</div>
          <h3 class="subheading">Reference</h3>
          <dl class="reference-list">
            {button.props.map((prop) => <div><dt class="mono">{prop.name}</dt><dd><span class="mono variant">{prop.type}</span>{' '}<span class="subtle">Default {prop.default}</span></dd></div>)}
            {button.reference.map((item) => <div><dt class="subtle">{item.name}</dt><dd class="mono">{item.value}</dd></div>)}
          </dl>
        </>}
        {variant === 2 && <>
          <h3 class="subheading">Usage</h3>
          <div role="table" aria-label="Button usage" class="ledger ledger--usage">
            <div role="row" class="ledger-head"><span role="columnheader">When</span><span role="columnheader">Use</span></div>
            {button.usage.map((item) => <div role="row" class="ledger-row"><span role="cell">{item.when}</span><span role="cell" class="medium">{item.use}</span></div>)}
          </div>
          <h3 class="subheading">Props</h3>
          <div role="table" aria-label="Button props" class="ledger ledger--props">
            <div role="row" class="ledger-head"><span role="columnheader">Prop</span><span role="columnheader">Type</span><span role="columnheader">Default</span></div>
            {button.props.map((prop) => <div role="row" class="ledger-row"><span role="cell" class="mono">{prop.name}</span><span role="cell" class="mono variant">{prop.type}</span><span role="cell" class="mono subtle">{prop.default}</span></div>)}
          </div>
          <h3 class="subheading">Reference</h3>
          <div role="table" aria-label="Button reference" class="ledger ledger--reference">
            <div role="row" class="ledger-head"><span role="columnheader">Label</span><span role="columnheader">Value</span></div>
            {button.reference.map((item) => <div role="row" class="ledger-row"><span role="cell" class="subtle">{item.name}</span><span role="cell" class="mono">{item.value}</span></div>)}
          </div>
        </>}
        {variant === 3 && <div class="button-columns">
          <div><h3>Usage</h3><dl class="plate-usage">{button.usage.map((item) => <div><dt class="variant">{item.when}</dt><dd class="medium">{item.use}</dd></div>)}</dl></div>
          <div><h3>Reference</h3><dl class="plate-reference">
            {button.props.map((prop) => <div><dt class="mono">{prop.name}</dt><dd class="mono variant">{prop.type}</dd></div>)}
            {button.reference.map((item) => <div><dt class="subtle">{item.name}</dt><dd class="mono">{item.value}</dd></div>)}
          </dl></div>
        </div>}
      </section>
    </div>
  ))}
  </div>
  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    <button class="proto-picker-item" data-active aria-current="true">Editorial</button>
    <button class="proto-picker-item">Ledger</button>
    <button class="proto-picker-item">Plates</button>
  </nav>
</DocumentationLayout>

<script>
  import { createPageScope, onPageLoad } from '../../../lib/pageLifecycle';

  onPageLoad(() => {
    const picker = document.querySelector<HTMLElement>('.proto-picker');
    const highlight = picker?.querySelector<HTMLElement>('.proto-picker-highlight');
    if (!picker || !highlight) return;
    const items = [...picker.querySelectorAll<HTMLButtonElement>('.proto-picker-item')];
    const variants = [...document.querySelectorAll<HTMLElement>('[data-variant]')];
    const scope = createPageScope();
    let current = 0;

    function moveHighlight() {
      const el = items[current];
      highlight!.style.width = el.offsetWidth + 'px';
      highlight!.style.transform = `translateX(${el.offsetLeft}px)`;
    }

    function setActive(i: number) {
      if (i < 0 || i >= variants.length) return;
      current = i;
      items.forEach((el, j) => {
        el.toggleAttribute('data-active', j === i);
        if (j === i) el.setAttribute('aria-current', 'true');
        else el.removeAttribute('aria-current');
      });
      variants.forEach((el, j) => { el.hidden = j !== i; });
      moveHighlight();
      const url = new URL(location.href);
      url.searchParams.set('v', String(i + 1));
      history.replaceState(null, '', url);
    }

    items.forEach((el, i) => scope.listen(el, 'click', () => setActive(i)));
    scope.listen(window, 'resize', moveHighlight);
    scope.listen(document, 'keydown', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable)) return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      const num = parseInt(e.key, 10);
      if (num >= 1 && num <= variants.length) setActive(num - 1);
      else if (e.key === 'ArrowRight') { e.preventDefault(); setActive((current + 1) % variants.length); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); setActive((current - 1 + variants.length) % variants.length); }
    });

    const requested = parseInt(new URLSearchParams(location.search).get('v') ?? '', 10);
    setActive(requested >= 1 && requested <= variants.length ? requested - 1 : 0);
    scope.frame(() => scope.frame(() => picker.setAttribute('data-ready', '')));
    return () => scope.destroy();
  });
</script>

<style>
  .presentation-variants { padding-bottom: 6rem; }
  .presentation { color: var(--sys-color-on-srf); min-width: 0; margin-top: 0; overflow-wrap: anywhere; }
  .presentation[hidden] { display: none; }
  .presentation :is(div, section, figure, figcaption, dl, dt, dd, ul, li, p, span) { min-width: 0; }
  .presentation :is(p, h2, h3, figure, dl, dd, ul) { margin: 0; }
  .presentation :is(h2, h3) { font-size: inherit; line-height: inherit; }
  .presentation h2 { font-weight: 700; margin: 0; }
  .presentation section > h2 + * { margin-top: calc(2 * var(--space-unit)); }
  .presentation h3 { font-weight: 500; }
  .presentation section + section { margin-top: calc(8 * var(--space-unit)); }
  .mono { font-family: var(--font-mono); font-size: 0.92em; overflow-wrap: anywhere; }
  .variant { color: var(--sys-color-on-srf-variant); }
  .subtle { color: var(--sys-color-on-srf-subtle); }
  .medium { font-weight: 500; }
  .small { font-size: 0.875rem; }
  .editorial-list { display: grid; gap: calc(3 * var(--space-unit)); }
  .editorial-rule .rule-value { margin-top: calc(0.5 * var(--space-unit)); }
  .type-meta { display: flex; flex-wrap: wrap; gap: var(--space-unit); margin-top: var(--space-unit); align-items: baseline; }
  .spacing-list { display: grid; gap: calc(2 * var(--space-unit)); }
  .space-bar { height: 6px; max-width: 100%; background: var(--sys-color-on-srf); border-radius: 999px; }
  .spacing-meta { display: flex; flex-wrap: wrap; gap: var(--space-unit); margin-top: calc(0.75 * var(--space-unit)); align-items: baseline; }
  .demo-frame { padding: var(--demo-frame-inset); }
  .button-row { display: flex; flex-wrap: wrap; gap: 0.75em; }
  .presentation--1 .button-example { margin-top: calc(2 * var(--space-unit)); }
  .presentation .subheading { margin-top: calc(2 * var(--space-unit)); margin-bottom: var(--space-unit); }
  .usage-prose { display: grid; gap: var(--space-unit); }
  .reference-list > div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); padding-block: calc(0.75 * var(--space-unit)); border-top: 1px solid var(--sys-color-outline-subtle); }
  .ledger { --columns: minmax(0, 1fr) minmax(0, 1fr); }
  .ledger-head, .ledger-row { display: grid; grid-template-columns: var(--columns); column-gap: calc(2 * var(--space-unit)); align-items: baseline; }
  .ledger-head { font-size: 12px; line-height: 1.4; color: var(--sys-color-on-srf-subtle); padding-bottom: calc(0.5 * var(--space-unit)); border-bottom: 1px solid var(--sys-color-outline); }
  .ledger-row { padding-block: calc(0.75 * var(--space-unit)); border-bottom: 1px solid var(--sys-color-outline-subtle); }
  .ledger--layout { --columns: 9rem minmax(0, 1fr); }
  .layout-value { display: grid; gap: calc(0.25 * var(--space-unit)); }
  .ledger--type { --columns: 8rem minmax(0, 1fr) minmax(0, 1.4fr); }
  .ledger--spacing { --columns: 10rem 5rem minmax(0, 1fr) minmax(0, 1fr); }
  .ledger--props { --columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); }
  .ledger .space-bar { height: 4px; }
  .ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .plate-list { display: grid; gap: calc(4 * var(--space-unit)); }
  .plate-frame { min-height: 8rem; display: grid; place-items: center start; }
  figcaption { margin-top: var(--space-unit); }
  .caption-row { display: flex; justify-content: space-between; flex-wrap: wrap; column-gap: var(--space-unit); align-items: baseline; }
  .schematic { width: 100%; max-width: 22rem; }
  .shape { height: 1.25rem; background: var(--sys-color-srf-container-high); }
  .stack-gap { position: relative; }
  .stack-gap::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--sys-color-on-srf); }
  .stack-gap::after { content: ''; position: absolute; left: 6px; top: 0; bottom: 0; width: 6px; border-block: 2px solid var(--sys-color-on-srf); }
  .stack-gap--small { height: 0.5rem; }
  .stack-gap--large { height: 1.5rem; }
  .viewport { height: 5rem; display: grid; grid-template-columns: 20% 60% 20%; border: 1px solid var(--sys-color-on-srf-variant); border-radius: 8px; overflow: hidden; }
  .gutter { background: var(--sys-color-srf-container); }
  .viewport-column { background: var(--sys-color-srf-container-high); }
  .core-unit { position: relative; padding-left: 6px; font-size: var(--text-body-size); line-height: var(--text-body-leading); font-weight: var(--text-body-weight); letter-spacing: var(--text-body-tracking); }
  .bracket { position: absolute; left: 0; top: calc(var(--text-body-size) * 1.2); height: var(--space-unit); width: 6px; border: 1px solid var(--sys-color-on-srf); border-right: 0; }
  .caps { display: grid; gap: 0.5rem; justify-items: center; }
  .caps .shape { width: 100%; }
  .caps .caps-text { width: 75%; }
  .transition-squares { display: flex; gap: 0.75rem; }
  .transition-squares > div { width: 3rem; height: 3rem; background: var(--sys-color-srf-container-high); }
  .transition-squares > div:nth-child(1) { opacity: 0.08; }
  .transition-squares > div:nth-child(2) { opacity: 0.4; }
  .spacing-specimen { width: 100%; display: grid; gap: var(--space-unit); }
  .spacing-caption { padding: 0; list-style: none; }
  .spacing-caption li { display: grid; grid-template-columns: 10rem 5rem minmax(0, 1fr); gap: var(--space-unit); padding-block: calc(0.75 * var(--space-unit)); }
  .spacing-caption li + li { border-top: 1px solid var(--sys-color-outline-subtle); }
  .button-plate { place-items: start; }
  .button-columns { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(4 * var(--space-unit)); margin-top: calc(4 * var(--space-unit)); }
  .button-columns :is(.plate-usage, .plate-reference) { margin-top: var(--space-unit); }
  .plate-usage > div, .plate-reference > div { display: grid; grid-template-columns: minmax(0, 1fr) 9rem; gap: var(--space-unit); padding-block: calc(0.75 * var(--space-unit)); }
  .plate-reference > div { grid-template-columns: 9rem minmax(0, 1fr); }
  .plate-usage > div + div, .plate-reference > div + div { border-top: 1px solid var(--sys-color-outline-subtle); }
  @media (width < 40em) {
    .reference-list > div, .spacing-caption li, .ledger-row, .plate-usage > div, .plate-reference > div { grid-template-columns: minmax(0, 1fr); gap: calc(0.25 * var(--space-unit)); }
    .ledger-head { display: none; }
  }
  .type-preview--body {
    font-weight: var(--text-body-weight);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    letter-spacing: var(--text-body-tracking);
  }
  .type-preview--heading-1 {
    font-weight: var(--text-heading-1-weight);
    font-size: var(--text-heading-1-size);
    line-height: var(--text-heading-1-leading);
    letter-spacing: var(--text-heading-1-tracking);
  }
  .type-preview--heading-2 {
    font-weight: var(--text-heading-2-weight);
    font-size: var(--text-heading-2-size);
    line-height: var(--text-heading-2-leading);
    letter-spacing: var(--text-heading-2-tracking);
  }
  .type-preview--caption {
    font-weight: var(--text-caption-weight);
    font-size: var(--text-caption-size);
    line-height: var(--text-caption-leading);
    letter-spacing: var(--text-caption-tracking);
  }
  .type-preview--press-quote {
    font-style: var(--text-press-quote-style);
    font-weight: var(--text-press-quote-weight);
    font-size: var(--text-press-quote-size);
    line-height: var(--text-press-quote-leading);
    letter-spacing: var(--text-press-quote-tracking);
  }
.proto-picker {
