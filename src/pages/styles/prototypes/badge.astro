---
import Layout from '../../../layouts/Layout.astro';
import Badge from '../../../components/ui/Badge.astro';
import '../../../styles/demoFrame.css';
import '../../../styles/project.css';

if (import.meta.env.PROD) return new Response(null, { status: 404 });
---

<Layout title="Badge layout explorations · VCD" description="Three layout directions for the VCD Badge component.">
  <main class="badge-prototype">
    <header class="badge-prototype__header">
      <a class="text-link" href="/styles">← Design System</a>
      <h1>Badge layout explorations</h1>
      <p><a class="project-inline-link" href="/styles/component-ui-badge">Current Badge page</a></p>
    </header>

    <div id="stage" class="badge-prototype__stage">
      <section class="badge-variant badge-variant--quiet" data-variant="1" aria-labelledby="quiet-title">
        <div class="badge-variant__copy">

          <h2 id="quiet-title">Badge</h2>
          <p>Short status labels for compact metadata and asset states.</p>
          <dl class="badge-variant__meta"><div><dt>Source</dt><dd><code>src/components/ui/Badge.astro</code></dd></div><div><dt>Props</dt><dd><code>label, ...rest</code></dd></div></dl>
        </div>
        <div class="badge-variant__demo demo-frame"><Badge label="On page" /><Badge label="Library" /><Badge label="Draft" /></div>
      </section>

      <section class="badge-variant badge-variant--split" data-variant="2" aria-labelledby="split-title" hidden>
        <div class="badge-variant__demo demo-frame"><Badge label="On page" /><Badge label="Library" /><Badge label="Draft" /></div>
        <div class="badge-variant__copy">

          <h2 id="split-title">Badge</h2>
          <p>Short status labels for compact metadata and asset states.</p>
          <dl class="badge-variant__meta"><div><dt>Source</dt><dd><code>src/components/ui/Badge.astro</code></dd></div><div><dt>Props</dt><dd><code>label, ...rest</code></dd></div></dl>
        </div>
      </section>

      <section class="badge-variant badge-variant--sections" data-variant="3" aria-labelledby="sections-title" hidden>
        <div class="badge-variant__copy">

          <h2 id="sections-title">Badge</h2>
          <p>Short status labels for compact metadata and asset states.</p>
          <div class="badge-variant__section"><h3>Example</h3><div class="badge-variant__demo demo-frame"><Badge label="On page" /><Badge label="Library" /><Badge label="Draft" /></div></div>
          <div class="badge-variant__section"><h3>API</h3><p><code>label</code> is the visible status text. Additional attributes pass through to the root element.</p><p><code>src/components/ui/Badge.astro</code></p></div>
          <div class="badge-variant__section"><h3>Usage</h3><p>Keep labels short enough to scan in a gallery or asset list.</p></div>
        </div>
      </section>
    </div>

    <nav class="proto-picker" aria-label="Prototype variants">
      <span class="proto-picker-highlight" aria-hidden="true"></span>
      <button class="proto-picker-item" data-active aria-current="true" data-variant-button="1">Quiet</button>
      <button class="proto-picker-item" data-variant-button="2">Split</button>
      <button class="proto-picker-item" data-variant-button="3">Sections</button>
    </nav>
  </main>
</Layout>

<script>
  const picker = document.querySelector<HTMLElement>('.proto-picker');
  const highlight = picker?.querySelector<HTMLElement>('.proto-picker-highlight');
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-variant-button]')];
  const variants = [...document.querySelectorAll<HTMLElement>('[data-variant]')];
  let current = 1;
  const moveHighlight = () => {
    const item = items[current - 1];
    if (!item || !highlight) return;
    highlight.style.width = `${item.offsetWidth}px`;
    highlight.style.transform = `translateX(${item.offsetLeft}px)`;
  };
  const setActive = (value: number) => {
    if (value < 1 || value > items.length) return;
    current = value;
    items.forEach((item, index) => {
      const active = index + 1 === value;
      item.toggleAttribute('data-active', active);
      active ? item.setAttribute('aria-current', 'true') : item.removeAttribute('aria-current');
    });
    variants.forEach((variant) => { variant.hidden = variant.dataset.variant !== String(value); });
    const url = new URL(location.href);
    url.searchParams.set('v', String(value));
    history.replaceState(null, '', url);
    moveHighlight();
  };
  items.forEach((item) => item.addEventListener('click', () => setActive(Number(item.dataset.variantButton))));
  window.addEventListener('resize', moveHighlight);
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    if (target && (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable)) return;
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    if (event.key === 'ArrowRight') setActive(current === items.length ? 1 : current + 1);
    if (event.key === 'ArrowLeft') setActive(current === 1 ? items.length : current - 1);
    const number = Number(event.key);
    if (number >= 1 && number <= items.length) setActive(number);
  });
  const requested = Number(new URLSearchParams(location.search).get('v'));
  setActive(requested >= 1 && requested <= items.length ? requested : 1);
  requestAnimationFrame(() => requestAnimationFrame(() => picker?.setAttribute('data-ready', '')));
</script>

<style>
  .badge-prototype { min-height: 100vh; padding: 5rem max(1rem, 5vw) 8rem; background: var(--sys-color-srf); color: var(--sys-color-on-srf); }
  .badge-prototype__header, .badge-prototype__stage { width: min(100%, 58rem); margin-inline: auto; }
  .badge-prototype__header { margin-bottom: 3rem; }
  .badge-prototype__header h1 { margin: .4rem 0 .8rem; font-size: clamp(2rem, 5vw, 4rem); }
  .badge-prototype__header > p:last-child { max-width: 38rem; color: var(--sys-color-on-srf-variant); }
  .badge-variant { min-height: 24rem; padding: clamp(1.25rem, 4vw, 3rem); display: grid; gap: 2rem; align-content: center; }
  .badge-variant__copy { max-width: 32rem; }
  .badge-variant h2 { margin: .35rem 0 .65rem; font-size: clamp(1.8rem, 4vw, 3rem); }
  .badge-variant p { color: var(--sys-color-on-srf-variant); }
  .badge-variant__demo { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; padding: var(--demo-frame-inset); min-width: 0; }
  .badge-variant__meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .badge-variant__meta dt, .badge-variant__section h3 { margin-bottom: .35rem; color: var(--sys-color-on-srf-variant); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
  .badge-variant__meta dd { margin: 0; }
  .badge-variant--split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  .badge-variant--split .badge-variant__demo { justify-content: center; min-height: 10rem;  }
  .badge-variant--sections { display: block; }
  .badge-variant[hidden] { display: none; }
  .badge-variant code { overflow-wrap: anywhere; }
  .badge-variant__section { padding-block: 1rem; border-top: 1px solid var(--sys-color-outline-variant); }
  .badge-variant__section h3 { margin-top: 0; }
  .badge-variant__section .badge-variant__demo { margin-top: .75rem; }
  .proto-picker { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 2147483647; display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 999px; background: rgba(10,10,10,.82); -webkit-backdrop-filter: blur(12px) saturate(1.4); backdrop-filter: blur(12px) saturate(1.4); box-shadow: 0 0 0 1px rgba(255,255,255,.08) inset, 0 8px 24px rgba(0,0,0,.24), 0 2px 6px rgba(0,0,0,.12); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 13px; line-height: 1; -webkit-font-smoothing: antialiased; user-select: none; -webkit-user-select: none; }
  .proto-picker-highlight { position: absolute; top: 4px; left: 0; height: 28px; border-radius: 999px; background: rgba(255,255,255,.12); will-change: transform; }
  .proto-picker[data-ready] .proto-picker-highlight { transition: transform 250ms cubic-bezier(.23,1,.32,1), width 250ms cubic-bezier(.23,1,.32,1); }
  .proto-picker-item { position: relative; display: flex; align-items: center; height: 28px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: rgba(255,255,255,.55); font: inherit; cursor: pointer; transition: color 150ms ease-out; }
  .proto-picker-item:hover { color: rgba(255, 255, 255, 0.85); }
  .proto-picker-item:active { transform: scale(0.97); }
  .proto-picker-item[data-active] { color: #fff; }
  .proto-picker-item:focus-visible { outline: 2px solid rgba(255,255,255,.4); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .proto-picker[data-ready] .proto-picker-highlight { transition: none; } }
  @media (max-width: 42em) { .badge-variant--split { grid-template-columns: 1fr; } .badge-variant__meta { grid-template-columns: 1fr; } }
</style>
