---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Vicente Cruz">
  <div class="flex flex-col min-h-dvh">
    <Header title="404" navMenu />

    <main class="notfound" style="flex: 1;">
      <div class="notfound__inner">
        <p class="notfound__message">Page not found.</p>
        <a href="/" class="notfound__link">Return home</a>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .notfound {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 2em 0;
  }

  .notfound__inner {
    max-width: 38em;
  }

  .notfound__message {
    font-family: var(--font-sans);
    font-size: 1.5em;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--sys-color-on-srf-variant);
    margin-top: 0.5em;
  }

  .notfound__link {
    display: inline-block;
    margin-top: 1.5em;
    font-family: var(--font-sans);
    font-size: 1.1em;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sys-color-link);
    transition: opacity 0.2s ease;
  }

  .notfound__link:hover {
    opacity: 0.6;
  }

</style>
