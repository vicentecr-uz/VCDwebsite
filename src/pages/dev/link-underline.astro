---
import Layout from '../../layouts/Layout.astro';
import '../../styles/project.css';
import ProjectBodyText from '../../components/project/ProjectBodyText.astro';
import DevPanel from '../../components/ui/DevPanel.astro';
import Button from '../../components/ui/Button.astro';

if (!import.meta.env.DEV) {
  return Astro.redirect('/404');
}

const paragraphs = [
  'The wardrobe was heavily inspired by the <a href="/the-rams">RT 20 radio designed by Dieter Rams in 1961</a>.',
];
---

<Layout title="Link underline (dev)">
  <main class="link-underline-prototype" style="--link-underline-rest-opacity: 25%; --link-underline-hover-opacity: 35%; --link-underline-fade-duration: 150ms;">
    <ProjectBodyText paragraphs={paragraphs} />

    <DevPanel title="Link underline" class="link-underline-prototype__panel" draggable>
      <div class="link-underline-prototype__controls">
        <label class="link-underline-prototype__field" for="link-underline-rest">
          <span>Rest</span>
          <output id="link-underline-rest-output" for="link-underline-rest">25%</output>
        </label>
        <input id="link-underline-rest" type="range" min="0" max="100" step="1" value="25" />

        <label class="link-underline-prototype__field" for="link-underline-hover">
          <span>Hover</span>
          <output id="link-underline-hover-output" for="link-underline-hover">35%</output>
        </label>
        <input id="link-underline-hover" type="range" min="0" max="100" step="1" value="35" />

        <label class="link-underline-prototype__field" for="link-underline-fade">
          <span>Fade</span>
          <output id="link-underline-fade-output" for="link-underline-fade">150ms</output>
        </label>
        <input id="link-underline-fade" type="range" min="0" max="1000" step="10" value="150" />

        <Button label="Copy" emphasis="soft" class="link-underline-prototype__copy">
          <span id="link-underline-copy-label">Copy</span>
        </Button>
      </div>
    </DevPanel>
  </main>
</Layout>

<script>
  const root = document.querySelector('.link-underline-prototype') as HTMLElement | null;
  const rest = document.querySelector('#link-underline-rest') as HTMLInputElement | null;
  const hover = document.querySelector('#link-underline-hover') as HTMLInputElement | null;
  const fade = document.querySelector('#link-underline-fade') as HTMLInputElement | null;
  const restOutput = document.querySelector('#link-underline-rest-output');
  const hoverOutput = document.querySelector('#link-underline-hover-output');
  const fadeOutput = document.querySelector('#link-underline-fade-output');
  const copy = document.querySelector('.link-underline-prototype__copy') as HTMLButtonElement | null;
  const copyLabel = document.querySelector('#link-underline-copy-label');

  const updateValue = (input: HTMLInputElement | null, output: Element | null, variable: string) => {
    if (!input || !root || !output) return;
    const value = `${input.value}%`;
    root.style.setProperty(variable, value);
    output.textContent = value;
  };

  const updateFade = () => {
    if (!fade || !root || !fadeOutput) return;
    const value = `${fade.value}ms`;
    root.style.setProperty('--link-underline-fade-duration', value);
    fadeOutput.textContent = value;
  };

  const update = () => {
    updateValue(rest, restOutput, '--link-underline-rest-opacity');
    updateValue(hover, hoverOutput, '--link-underline-hover-opacity');
    updateFade();
  };

  const copyText = (value: string) => {
    const fallback = () => {
      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      let copied = false;
      try {
        copied = document.execCommand('copy');
      } finally {
        textarea.remove();
      }
      return copied ? Promise.resolve() : Promise.reject(new Error('Copy failed'));
    };

    return navigator.clipboard?.writeText
      ? navigator.clipboard.writeText(value).catch(fallback)
      : fallback();
  };

  rest?.addEventListener('input', update);
  hover?.addEventListener('input', update);
  fade?.addEventListener('input', update);
  copy?.addEventListener('click', async () => {
    const config = `--link-underline-rest-opacity: ${rest?.value ?? 25}%;\n--link-underline-hover-opacity: ${hover?.value ?? 35}%;\n--link-underline-fade-duration: ${fade?.value ?? 150}ms;`;
    try {
      await copyText(config);
      if (copyLabel) copyLabel.textContent = 'Copied';
    } catch {
      if (copyLabel) copyLabel.textContent = 'Copy failed';
    }
    window.setTimeout(() => {
      if (copyLabel) copyLabel.textContent = 'Copy';
    }, 1200);
  });

  update();
</script>

<style>
  .link-underline-prototype {
    min-height: 100vh;
    padding: 12em 2em;
  }

  .link-underline-prototype :global(.project-body-text a:not(.is-underline-off)) {
    text-decoration-color: color-mix(in srgb, currentColor var(--link-underline-rest-opacity), transparent);
    transition: text-decoration-color var(--link-underline-fade-duration) ease;
  }

  .link-underline-prototype__panel {
    position: fixed;
    top: 1.5em;
    right: 1.5em;
    z-index: 10;
    width: min(18em, calc(100vw - 3em));
  }

  .link-underline-prototype__controls {
    display: grid;
    gap: 0.5em;
  }

  .link-underline-prototype__field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75em;
    font: var(--dev-text-field-label);
    color: var(--sys-color-on-srf-variant);
    cursor: pointer;
    touch-action: manipulation;
  }

  .link-underline-prototype__field output {
    font-variant-numeric: tabular-nums;
  }

  .link-underline-prototype__controls input[type='range'] {
    width: 100%;
    min-height: 44px;
    font-size: 16px;
    margin: 0;
    accent-color: var(--sys-color-on-srf);
    cursor: pointer;
    touch-action: manipulation;
  }

  .link-underline-prototype__controls input[type='range']:focus-visible {
    outline: 2px solid var(--sys-color-outline);
    outline-offset: 2px;
  }

  .link-underline-prototype__copy {
    margin-top: 0.5em;
    min-height: 44px;
    touch-action: manipulation;
  }

  @media (hover: hover) and (pointer: fine) {
    .link-underline-prototype :global(.project-body-text a:not(.is-underline-off):hover) {
      text-decoration-color: color-mix(in srgb, currentColor var(--link-underline-hover-opacity), transparent);
    }
  }
</style>
