---
/**
 * Dev-only probe: uniform section blocks + drop indicator insert preview.
 * Isolates lift, indicator fade/collapse, and neighbouring-block shift from Tapico.
 */
import Layout from '../../layouts/Layout.astro';

if (!import.meta.env.DEV) {
  return Astro.redirect('/404');
}

const BLOCK_COUNT = 10;
const blocks = Array.from({ length: BLOCK_COUNT }, (_, i) => i + 1);
---

<Layout title="Drop indicator probe (dev)">
  <main class="probe">
    <header class="probe__intro">
      <h1>Drop indicator probe</h1>
      <p>
        Uniform test blocks with lift + drop indicator. Grab a handle, hold and move up or
        down to scroll the page (same driver as Tapico), then release over a new insert point.
        Neighbouring blocks should shift smoothly as the indicator collapses and reopens.
      </p>
      <p class="probe__status" id="probe-status" aria-live="polite">Idle · insert —</p>
      <p class="probe__links">
        <a href="/dev/scroll-hold">Scroll-hold probe</a>
      </p>
    </header>

    <div class="probe__spacer" aria-hidden="true"></div>

    <div class="probe__drop-zone" id="probe-drop-zone" data-probe-drop-zone>
      {
        blocks.map((n) => (
          <section class="probe-block" data-probe-block>
            <button
              type="button"
              class="probe-block__handle"
              data-probe-handle
              aria-label={`Reorder block ${n}`}
            >
              <span aria-hidden="true">⋮⋮</span>
            </button>
            <div class="probe-block__body">
              <span class="probe-block__label">Block {n}</span>
              <span class="probe-block__meta">6em fixed height</span>
            </div>
          </section>
        ))
      }
    </div>

    <div class="probe__spacer probe__spacer--tail" aria-hidden="true"></div>
  </main>
</Layout>

<script>
  import {
    REORDER_TIMING,
    SCROLL_HOLD,
    computeIdealLiftTop,
    createScrollDriver,
    getAffectedItems,
    measureBlockHeight,
    measureGapAbove,
    measureGapBelow,
    prefersReducedMotion,
    resolveInsertIndexFromY,
    setLiftTransformOrigin,
    smoothToward,
  } from '../../scripts/sectionReorder';

  const DROP_INDICATOR_CLASS = 'probe-drop-indicator';
  const DROP_INDICATOR_BODY_CLASS = 'probe-drop-indicator__body';
  const DROP_PREVIEW_ABOVE_CLASS = 'is-drop-preview-above';
  const FLIP_MOVING_CLASS = 'is-probe-flip-moving';
  const {
    DROP_INDICATOR_FADE_MS,
    DROP_INDICATOR_EXIT_MS,
    FLIP_REPOSITION_MS,
    FADE_IN_DELAY_MS,
    DROP_ANIMATION_MS,
    DROP_SCALE_MS,
  } = REORDER_TIMING;

  const status = document.getElementById('probe-status');
  const dropZone = document.getElementById('probe-drop-zone');
  const scrollDriver = createScrollDriver();

  let dragItem: HTMLElement | null = null;
  let dragHandle: HTMLButtonElement | null = null;
  let dropIndicator: HTMLElement | null = null;
  let dropIndicatorAnimationToken = 0;
  let dropIndicatorAnimationTimer: ReturnType<typeof setTimeout> | null = null;

  let sourceIndex = 0;
  let targetInsertIndex = 0;
  let blockHeightPx = 0;
  let liftGapTop = '0px';
  let liftGapBottom = '0px';
  let dropNeighborAbove: HTMLElement | null = null;
  let liftInitialTop = 0;
  let liftGrabOffsetY = 0;
  let liftCurrentTop = 0;
  let grabPointerY = 0;
  let lastClientY = 0;
  let sessionActive = false;
  let sessionTickRafId = 0;
  let syncedPreviewIndex = -1;
  let flipCleanupTimer: ReturnType<typeof setTimeout> | null = null;
  let flipMovingElements: HTMLElement[] = [];
  let repositionAnimationToken = 0;
  let indicatorOpacityAnimToken = 0;
  let indicatorDelayTimer: ReturnType<typeof setTimeout> | null = null;
  let indicatorOpacityLevel = 1;
  let placedInsertIndex = 0;
  let repositionRunnerActive = false;
  let dropInProgress = false;
  let activeFadeGhosts: HTMLElement[] = [];

  const setStatus = (text: string) => {
    if (status) status.textContent = text;
  };

  const resetScrollDriver = () => {
    scrollDriver.reset();
  };

  const applySmoothedScroll = (dtMs: number) => {
    scrollDriver.apply(dtMs, grabPointerY, lastClientY);
  };

  const applyLiftFollow = (dtMs: number) => {
    if (!dragItem) return;

    const ideal = computeIdealLiftTop({
      lastClientY,
      grabPointerY,
      liftGrabOffsetY,
      liftInitialTop,
    });
    liftCurrentTop = prefersReducedMotion()
      ? ideal
      : smoothToward(liftCurrentTop, ideal, dtMs, SCROLL_HOLD.LIFT_FOLLOW_SMOOTHING);

    dragItem.style.top = `${liftCurrentTop}px`;
  };

  const liftedBlockCenterY = () => liftCurrentTop + blockHeightPx / 2;

  const isDropPreviewAnimating = () =>
    Boolean(dropIndicator?.classList.contains('is-fading-out')
      || dropIndicator?.classList.contains('is-exiting'));

  const syncDropPreview = () => {
    if (!sessionActive || !dragItem || !dropIndicator) return;
    if (isDropPreviewAnimating()) return;
    const next = resolveInsertIndex(liftedBlockCenterY());
    if (next === syncedPreviewIndex) return;
    syncedPreviewIndex = next;
    void setDropPreviewIndex(next);
  };

  const flushPendingPreview = () => {
    if (!sessionActive || !dragItem || !dropIndicator || isDropPreviewAnimating()) return;
    const next = resolveInsertIndex(liftedBlockCenterY());
    if (next === targetInsertIndex && dropIndicator.classList.contains('is-visible')) return;
    syncedPreviewIndex = next;
    void setDropPreviewIndex(next);
  };

  const sessionTick = (now: number) => {
    sessionTickRafId = 0;
    if (!sessionActive) return;
    const lastTick = scrollDriver.getLastTickTime();
    if (!lastTick) scrollDriver.setLastTickTime(now);
    const dtMs = Math.min(48, now - scrollDriver.getLastTickTime());
    scrollDriver.setLastTickTime(now);
    applySmoothedScroll(dtMs);
    applyLiftFollow(dtMs);
    syncDropPreview();
    if (sessionActive) {
      sessionTickRafId = requestAnimationFrame(sessionTick);
    }
  };

  const startSessionTick = () => {
    if (sessionTickRafId) return;
    sessionTickRafId = requestAnimationFrame(sessionTick);
  };

  const stopSessionTick = () => {
    if (!sessionTickRafId) return;
    cancelAnimationFrame(sessionTickRafId);
    sessionTickRafId = 0;
  };

  const trackClientPosition = (event: MouseEvent | PointerEvent) => {
    lastClientY = event.clientY;
  };

  document.addEventListener('pointermove', trackClientPosition, { capture: true, passive: true });
  document.addEventListener('mousemove', trackClientPosition, { capture: true, passive: true });

  const getBlocks = () =>
    [...dropZone?.querySelectorAll<HTMLElement>('[data-probe-block]') ?? []]
      .filter((el) => el !== dragItem);

  const clearDropIndicatorAnimationTimer = () => {
    if (dropIndicatorAnimationTimer) clearTimeout(dropIndicatorAnimationTimer);
    dropIndicatorAnimationTimer = null;
  };

  const waitMs = (ms: number) => new Promise<void>((resolve) => {
    dropIndicatorAnimationTimer = setTimeout(resolve, ms);
  });

  const removeDropIndicator = () => {
    releaseDropNeighbors();
    activeFadeGhosts.forEach((ghost) => ghost.remove());
    activeFadeGhosts = [];
    dropIndicator?.remove();
    dropIndicator = null;
  };

  const captureInsertGapTop = (insertIndex: number) => {
    const blocks = getBlocks();
    if (insertIndex <= 0) return '0px';
    if (insertIndex < blocks.length) {
      return getComputedStyle(blocks[insertIndex - 1]).marginBottom;
    }
    return measureGapBelow(blocks[blocks.length - 1]);
  };

  const captureInsertGapBottom = (insertIndex: number) => {
    const blocks = getBlocks();
    if (insertIndex >= blocks.length) return '0px';
    const marginTop = getComputedStyle(blocks[insertIndex]).marginTop;
    return marginTop && marginTop !== '0px' ? marginTop : '0px';
  };

  const createDropIndicatorElement = () => {
    const indicator = document.createElement('div');
    indicator.className = DROP_INDICATOR_CLASS;
    indicator.setAttribute('aria-hidden', 'true');
    const body = document.createElement('div');
    body.className = DROP_INDICATOR_BODY_CLASS;
    body.setAttribute('aria-hidden', 'true');
    indicator.append(body);
    return indicator;
  };

  const resolveDropNeighborAbove = (insertIndex: number) => {
    const blocks = getBlocks();
    if (insertIndex <= 0) return null;
    return blocks[insertIndex - 1] ?? null;
  };

  const releaseDropNeighbors = () => {
    dropNeighborAbove?.classList.remove(DROP_PREVIEW_ABOVE_CLASS);
    dropNeighborAbove = null;
  };

  const bindDropNeighbors = (insertIndex: number) => {
    const above = resolveDropNeighborAbove(insertIndex);
    if (above) {
      dropNeighborAbove = above;
      above.classList.add(DROP_PREVIEW_ABOVE_CLASS);
    }
  };

  const applyDropSlotMetrics = (insertIndex: number) => {
    if (!dropIndicator) return;

    const atSource = insertIndex === sourceIndex;
    dropIndicator.style.setProperty('--gap-top', atSource ? liftGapTop : captureInsertGapTop(insertIndex));
    dropIndicator.style.setProperty('--gap-bottom', atSource ? liftGapBottom : captureInsertGapBottom(insertIndex));
    dropIndicator.style.setProperty('--gap-height', `${blockHeightPx}px`);
  };

  const syncDropPreviewPlacement = (insertIndex: number) => {
    releaseDropNeighbors();
    applyDropSlotMetrics(insertIndex);
    placeDropIndicatorBeforeIndex(insertIndex);
    bindDropNeighbors(insertIndex);
  };

  const getAffectedBlocks = (fromIndex: number, toIndex: number) =>
    getAffectedItems(getBlocks(), fromIndex, toIndex);

  const clearActiveFlip = () => {
    if (flipCleanupTimer) {
      clearTimeout(flipCleanupTimer);
      flipCleanupTimer = null;
    }
    flipMovingElements.forEach((el) => {
      el.classList.remove(FLIP_MOVING_CLASS);
      el.style.transition = '';
      el.style.transform = '';
    });
    flipMovingElements = [];
  };

  const getIndicatorBody = () =>
    dropIndicator?.querySelector<HTMLElement>(`.${DROP_INDICATOR_BODY_CLASS}`) ?? null;

  const setIndicatorBodyOpacity = (value: number) => {
    const body = getIndicatorBody();
    if (!body) return;
    indicatorOpacityLevel = value;
    body.style.opacity = String(value);
  };

  const syncIndicatorOpacityFromDom = () => {
    const body = getIndicatorBody();
    if (!body) return;
    const computed = Number.parseFloat(getComputedStyle(body).opacity);
    if (Number.isFinite(computed)) indicatorOpacityLevel = computed;
  };

  const cancelIndicatorOpacityAnimation = () => {
    indicatorOpacityAnimToken += 1;
    if (indicatorDelayTimer) {
      clearTimeout(indicatorDelayTimer);
      indicatorDelayTimer = null;
    }
    activeFadeGhosts.forEach((ghost) => ghost.remove());
    activeFadeGhosts = [];
    const body = getIndicatorBody();
    if (!body) return;
    body.style.transition = '';
    syncIndicatorOpacityFromDom();
  };

  const spawnIndicatorFadeGhost = () => {
    const body = getIndicatorBody();
    if (!body || indicatorOpacityLevel <= 0.05) return null;

    const rect = body.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return null;

    const ghost = document.createElement('div');
    ghost.className = `${DROP_INDICATOR_BODY_CLASS} is-drop-indicator-fade-ghost`;
    ghost.setAttribute('aria-hidden', 'true');
    ghost.style.top = `${rect.top}px`;
    ghost.style.left = `${rect.left}px`;
    ghost.style.width = `${rect.width}px`;
    ghost.style.height = `${rect.height}px`;
    ghost.style.opacity = String(indicatorOpacityLevel);
    (dropZone ?? document.body).appendChild(ghost);
    activeFadeGhosts.push(ghost);
    return ghost;
  };

  const ensureIndicatorVisibleAtTarget = () => {
    if (!dropIndicator || dropInProgress) return;
    if (placedInsertIndex !== targetInsertIndex) return;
    if (indicatorOpacityLevel < 0.95) {
      setIndicatorBodyOpacity(1);
    }
  };

  const animateFadeGhost = (
    ghost: HTMLElement,
    durationMs: number,
    repositionToken: number,
  ) => {
    if (durationMs <= 0) {
      ghost.remove();
      activeFadeGhosts = activeFadeGhosts.filter((item) => item !== ghost);
      return Promise.resolve();
    }

    return new Promise<void>((resolve) => {
      requestAnimationFrame(() => {
        if (repositionToken !== repositionAnimationToken) {
          ghost.remove();
          activeFadeGhosts = activeFadeGhosts.filter((item) => item !== ghost);
          resolve();
          return;
        }

        const finish = () => {
          ghost.remove();
          activeFadeGhosts = activeFadeGhosts.filter((item) => item !== ghost);
          resolve();
        };

        const onEnd = (event: TransitionEvent) => {
          if (event.propertyName !== 'opacity') return;
          ghost.removeEventListener('transitionend', onEnd);
          finish();
        };

        ghost.addEventListener('transitionend', onEnd);
        ghost.style.transition = `opacity ${durationMs}ms ease-out`;
        ghost.style.opacity = '0';

        setTimeout(() => {
          ghost.removeEventListener('transitionend', onEnd);
          finish();
        }, durationMs + 50);
      });
    });
  };

  const animateIndicatorBodyOpacity = (
    target: number,
    durationMs: number,
    repositionToken: number,
  ) => {
    const body = getIndicatorBody();
    if (!body || durationMs <= 0) {
      setIndicatorBodyOpacity(target);
      return Promise.resolve();
    }

    const animToken = ++indicatorOpacityAnimToken;
    const from = indicatorOpacityLevel;
    body.style.transition = 'none';
    body.style.opacity = String(from);

    return new Promise<void>((resolve) => {
      requestAnimationFrame(() => {
        if (animToken !== indicatorOpacityAnimToken || repositionToken !== repositionAnimationToken) {
          resolve();
          return;
        }

        const finish = () => {
          if (animToken !== indicatorOpacityAnimToken) return;
          indicatorOpacityLevel = target;
          resolve();
        };

        const onEnd = (event: TransitionEvent) => {
          if (event.propertyName !== 'opacity') return;
          body.removeEventListener('transitionend', onEnd);
          finish();
        };

        body.addEventListener('transitionend', onEnd);
        body.style.transition = `opacity ${durationMs}ms ease-out`;
        body.style.opacity = String(target);

        setTimeout(() => {
          body.removeEventListener('transitionend', onEnd);
          finish();
        }, durationMs + 50);
      });
    });
  };

  const waitForIndicatorDelay = (ms: number, repositionToken: number) =>
    new Promise<void>((resolve) => {
      if (indicatorDelayTimer) clearTimeout(indicatorDelayTimer);
      indicatorDelayTimer = setTimeout(() => {
        indicatorDelayTimer = null;
        if (repositionToken === repositionAnimationToken) resolve();
      }, ms);
    });

  const performDomRepositionWithFlip = (fromIndex: number, toIndex: number) => {
    if (!dropIndicator) return Promise.resolve();

    if (fromIndex === toIndex) {
      syncDropPreviewPlacement(toIndex);
      return Promise.resolve();
    }

    const affected = getAffectedBlocks(fromIndex, toIndex);
    const captureElements = [...new Set([...flipMovingElements, ...affected])];
    const firstRects = new Map(
      captureElements.map((el) => [el, el.getBoundingClientRect()]),
    );

    clearActiveFlip();

    dropIndicator.classList.add('is-repositioning');
    syncDropPreviewPlacement(toIndex);
    void dropIndicator.offsetHeight;

    const motionMs = prefersReducedMotion() ? 0 : FLIP_REPOSITION_MS;
    const moving: HTMLElement[] = [];

    affected.forEach((el) => {
      const first = firstRects.get(el);
      if (!first) return;
      const deltaY = first.top - el.getBoundingClientRect().top;
      if (Math.abs(deltaY) < 0.5) return;
      el.classList.add(FLIP_MOVING_CLASS);
      el.style.transition = 'none';
      el.style.transform = `translateY(${deltaY}px)`;
      moving.push(el);
    });

    flipMovingElements = moving;
    void dropIndicator.offsetHeight;

    if (!motionMs || moving.length === 0) {
      clearActiveFlip();
      dropIndicator.classList.remove('is-repositioning');
      return Promise.resolve();
    }

    return new Promise<void>((resolve) => {
      requestAnimationFrame(() => {
        moving.forEach((el) => {
          el.style.transition = `transform ${motionMs}ms ease-out`;
          el.style.transform = '';
        });

        flipCleanupTimer = setTimeout(() => {
          flipCleanupTimer = null;
          clearActiveFlip();
          dropIndicator?.classList.remove('is-repositioning');
          resolve();
        }, motionMs);
      });
    });
  };

  const notifyRepositionIdle = () => {
    ensureIndicatorVisibleAtTarget();
  };

  const ensureRepositionRunner = async () => {
    if (repositionRunnerActive || !dropIndicator) return;

    repositionRunnerActive = true;
    const runnerToken = ++repositionAnimationToken;

    try {
      while (placedInsertIndex !== targetInsertIndex) {
        if (runnerToken !== repositionAnimationToken) return;

        const fromIndex = placedInsertIndex;
        const toIndex = targetInsertIndex;

        const fadeOutMs = prefersReducedMotion() ? 0 : DROP_INDICATOR_FADE_MS;
        const shouldFadeOut = indicatorOpacityLevel > 0.05 && fadeOutMs > 0;
        const fadeGhost = shouldFadeOut ? spawnIndicatorFadeGhost() : null;

        if (fadeGhost) {
          setIndicatorBodyOpacity(0);
        }

        const fadeOutPromise = fadeGhost
          ? animateFadeGhost(fadeGhost, fadeOutMs, runnerToken)
          : shouldFadeOut
            ? animateIndicatorBodyOpacity(0, fadeOutMs, runnerToken)
            : Promise.resolve(setIndicatorBodyOpacity(0));

        await Promise.all([
          fadeOutPromise,
          performDomRepositionWithFlip(fromIndex, toIndex),
        ]);
        placedInsertIndex = toIndex;

        if (runnerToken !== repositionAnimationToken) return;
        if (placedInsertIndex !== targetInsertIndex) continue;

        const fadeInDelayMs = prefersReducedMotion() ? 0 : FADE_IN_DELAY_MS;
        if (fadeInDelayMs > 0) {
          await waitForIndicatorDelay(fadeInDelayMs, runnerToken);
          if (runnerToken !== repositionAnimationToken) return;
          if (placedInsertIndex !== targetInsertIndex) continue;
        }

        const fadeInMs = prefersReducedMotion() ? 0 : DROP_INDICATOR_FADE_MS;
        if (fadeInMs > 0) {
          await animateIndicatorBodyOpacity(1, fadeInMs, runnerToken);
        } else {
          setIndicatorBodyOpacity(1);
        }
        ensureIndicatorVisibleAtTarget();
      }
    } finally {
      repositionRunnerActive = false;
      if (placedInsertIndex !== targetInsertIndex && dropIndicator) {
        void ensureRepositionRunner();
      }
      notifyRepositionIdle();
    }
  };

  const moveBlockToIndex = (item: HTMLElement, insertIndex: number) => {
    if (!dropZone) return;

    const blocks = getBlocks();
    if (insertIndex >= blocks.length) dropZone.append(item);
    else blocks[insertIndex].before(item);
  };

  const finalizeDropPlacement = () => {
    const finalIndex = resolveInsertIndex(liftedBlockCenterY());
    targetInsertIndex = finalIndex;
    syncedPreviewIndex = finalIndex;
    repositionAnimationToken += 1;
    cancelIndicatorOpacityAnimation();
    clearActiveFlip();
    dropIndicator?.classList.remove('is-repositioning');

    if (!dropIndicator) return;

    syncDropPreviewPlacement(targetInsertIndex);
    placedInsertIndex = targetInsertIndex;
    setIndicatorBodyOpacity(1);
  };

  const animateDropToSlot = () => {
    if (!dragItem || !dropIndicator) return Promise.resolve();

    const body = getIndicatorBody();
    const targetRect = body?.getBoundingClientRect();
    if (!targetRect) return Promise.resolve();

    const motionMs = prefersReducedMotion() ? 0 : DROP_ANIMATION_MS;
    const settleMs = prefersReducedMotion() ? 0 : DROP_SCALE_MS;

    dragItem.classList.add('is-dropping');
    void dragItem.offsetHeight;

    if (motionMs <= 0 && settleMs <= 0) {
      dragItem.classList.remove('is-lifted-raised');
      dragItem.style.top = `${targetRect.top}px`;
      dragItem.style.left = `${targetRect.left}px`;
      dragItem.classList.remove('is-dropping');
      return Promise.resolve();
    }

    return new Promise<void>((resolve) => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (!dragItem) {
            resolve();
            return;
          }

          dragItem.classList.remove('is-lifted-raised');
          dragItem.style.top = `${targetRect.top}px`;
          dragItem.style.left = `${targetRect.left}px`;

          setTimeout(() => {
            dragItem?.classList.remove('is-dropping');
            resolve();
          }, Math.max(motionMs, settleMs));
        });
      });
    });
  };

  const placeDropIndicatorBeforeIndex = (index: number) => {
    if (!dropZone || !dropIndicator) return;

    if (index === sourceIndex && dragItem) {
      dragItem.before(dropIndicator);
      return;
    }

    const blocks = getBlocks();
    if (index >= blocks.length) dropZone.append(dropIndicator);
    else blocks[index].before(dropIndicator);
  };

  const setDropPreviewIndex = async (nextIndex: number) => {
    const clamped = Math.max(0, Math.min(nextIndex, getBlocks().length));
    if (!dropIndicator) return;

    if (clamped === targetInsertIndex && dropIndicator.classList.contains('is-visible')) {
      if (placedInsertIndex !== clamped) {
        void ensureRepositionRunner();
      } else {
        syncDropPreviewPlacement(clamped);
      }
      return;
    }

    dropIndicatorAnimationToken += 1;
    clearDropIndicatorAnimationTimer();

    // Already open: swap DOM position in one layout pass so only blocks between
    // the old and new insert indices shift (no collapse-then-expand wave).
    if (dropIndicator.classList.contains('is-visible')) {
      targetInsertIndex = clamped;
      syncedPreviewIndex = clamped;
      setStatus(`Grabbing · insert ${targetInsertIndex} / ${getBlocks().length}`);
      void ensureRepositionRunner();
      flushPendingPreview();
      return;
    }

    const token = dropIndicatorAnimationToken;

    if (!prefersReducedMotion()) {
      dropIndicator.classList.add('is-fading-out');
      await waitMs(DROP_INDICATOR_FADE_MS);
      if (token !== dropIndicatorAnimationToken || !dropIndicator) return;
      dropIndicator.classList.remove('is-fading-out');
      dropIndicator.classList.add('is-exiting');
      await waitMs(DROP_INDICATOR_EXIT_MS);
      if (token !== dropIndicatorAnimationToken || !dropIndicator) return;
      dropIndicator.classList.remove('is-visible', 'is-exiting');
    } else {
      dropIndicator.classList.remove('is-visible');
    }

    targetInsertIndex = clamped;
    syncedPreviewIndex = clamped;
    syncDropPreviewPlacement(clamped);
    setStatus(`Grabbing · insert ${targetInsertIndex} / ${getBlocks().length}`);

    if (prefersReducedMotion()) {
      dropIndicator.classList.add('is-visible');
      flushPendingPreview();
      return;
    }

    requestAnimationFrame(() => {
      if (token !== dropIndicatorAnimationToken || !dropIndicator) return;
      void dropIndicator.offsetHeight;
      requestAnimationFrame(() => {
        if (token !== dropIndicatorAnimationToken || !dropIndicator) return;
        dropIndicator.classList.add('is-visible');
        flushPendingPreview();
      });
    });
  };

  const resolveInsertIndex = (clientY: number) =>
    resolveInsertIndexFromY(getBlocks(), clientY);

  const applyLift = (root: HTMLElement, handle: HTMLElement) => {
    const rect = root.getBoundingClientRect();
    blockHeightPx = measureBlockHeight(root);
    liftGapTop = measureGapAbove(root);
    liftGapBottom = measureGapBelow(root);
    liftInitialTop = rect.top;
    liftGrabOffsetY = grabPointerY - rect.top;
    liftCurrentTop = rect.top;

    dropIndicator = createDropIndicatorElement();
    root.before(dropIndicator);
    syncDropPreviewPlacement(sourceIndex);
    placedInsertIndex = sourceIndex;
    dropIndicator.classList.add('is-visible');
    setIndicatorBodyOpacity(1);

    root.classList.add('is-lifted');
    root.classList.remove('is-lifted-raised');
    root.style.position = 'fixed';
    root.style.left = `${rect.left}px`;
    root.style.top = `${rect.top}px`;
    root.style.width = `${rect.width}px`;
    root.style.margin = '0';
    root.style.zIndex = '100';
    setLiftTransformOrigin(root, handle);

    if (prefersReducedMotion()) {
      root.classList.add('is-lifted-raised');
    } else {
      requestAnimationFrame(() => {
        root.classList.add('is-lifted-raised');
      });
    }
  };

  const clearLift = () => {
    if (!dragItem) return;
    dragItem.classList.remove('is-lifted', 'is-lifted-raised', 'is-dropping');
    dragItem.style.position = '';
    dragItem.style.left = '';
    dragItem.style.top = '';
    dragItem.style.width = '';
    dragItem.style.margin = '';
    dragItem.style.zIndex = '';
    dragItem.style.transformOrigin = '';
    dragItem.style.removeProperty('transition');
    getIndicatorBody()?.style.removeProperty('opacity');
    getIndicatorBody()?.style.removeProperty('transition');
  };

  const finishDropSession = async () => {
    if (!sessionActive || dropInProgress || !dragItem) return;

    dropInProgress = true;
    sessionActive = false;
    stopSessionTick();
    resetScrollDriver();

    await finalizeDropPlacement();
    await animateDropToSlot();

    if (targetInsertIndex !== sourceIndex) {
      moveBlockToIndex(dragItem, targetInsertIndex);
    }

    clearActiveFlip();
    cancelIndicatorOpacityAnimation();
    repositionAnimationToken += 1;
    dropIndicatorAnimationToken += 1;
    clearDropIndicatorAnimationTimer();
    removeDropIndicator();
    clearLift();
    document.documentElement.classList.remove('is-probe-lifting');

    dragItem = null;
    dragHandle = null;
    dropInProgress = false;
    setStatus('Idle · insert —');
  };

  const endSession = () => {
    void finishDropSession();
  };

  document.addEventListener('pointerup', (event) => {
    if (!sessionActive || event.button !== 0) return;
    endSession();
  }, { capture: true });

  document.addEventListener('mouseup', (event) => {
    if (!sessionActive || event.button !== 0) return;
    endSession();
  }, { capture: true });

  dropZone?.querySelectorAll<HTMLButtonElement>('[data-probe-handle]').forEach((handle) => {
    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || sessionActive) return;
      event.preventDefault();

      const root = handle.closest<HTMLElement>('[data-probe-block]');
      if (!root) return;

      const allBlocks = [...dropZone?.querySelectorAll<HTMLElement>('[data-probe-block]') ?? []];
      sourceIndex = allBlocks.indexOf(root);
      if (sourceIndex < 0) sourceIndex = 0;
      targetInsertIndex = sourceIndex;
      placedInsertIndex = sourceIndex;

      dragItem = root;
      dragHandle = handle;
      grabPointerY = event.clientY;
      lastClientY = event.clientY;
      syncedPreviewIndex = sourceIndex;
      sessionActive = true;

      document.documentElement.classList.add('is-probe-lifting');
      resetScrollDriver();
      applyLift(root, handle);
      setStatus(`Grabbing block ${sourceIndex + 1} · insert ${targetInsertIndex} · scrollY ${Math.round(window.scrollY)}`);

      try {
        handle.setPointerCapture(event.pointerId);
      } catch {
        // Document listeners still work.
      }

      startSessionTick();
    });
  });
</script>

<style>
  .probe {
    padding-block: 2em;
    min-height: 100%;
    background-color: var(--color-bg, #ffffff);
    background-image:
      radial-gradient(circle, color-mix(in srgb, var(--color-text-muted, #6f6b62) 48%, transparent) 1px, transparent 1px);
    background-size: 1.25em 1.25em;
  }

  .probe__intro {
    max-width: 40em;
    margin-inline: auto;
    padding-inline: 1em;
  }

  .probe__intro h1 {
    font-size: 1.25em;
    font-weight: 600;
    margin-bottom: 0.5em;
  }

  .probe__status {
    margin-top: 1em;
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    color: var(--color-text-muted, #6f6b62);
  }

  .probe__links {
    margin-top: 0.75em;
    font-size: 0.9em;
  }

  .probe__spacer {
    height: 30vh;
  }

  .probe__spacer--tail {
    height: 80vh;
  }

  .probe__drop-zone {
    position: relative;
    isolation: isolate;
    max-width: 40em;
    margin-inline: auto;
    padding-inline: 1em;
  }

  .probe-block {
    position: relative;
    height: 6em;
    margin-bottom: 1em;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--color-text-muted, #6f6b62) 22%, transparent);
    border-radius: var(--radius-control-smooth, 0.35em);
    background: var(--color-bg, #fff);
    box-shadow: 0 0.15em 0.5em rgb(0 0 0 / 0.04);
  }

  .probe-block:last-child {
    margin-bottom: 0;
  }

  .probe-block.is-lifted {
    transform: scale(1);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
    box-shadow: 0 0.6em 2em rgb(0 0 0 / 0.14);
  }

  .probe-block.is-lifted.is-dropping {
    transition:
      top 350ms ease-out,
      left 350ms ease-out,
      transform 200ms ease-out,
      box-shadow 200ms ease-out;
    transform: scale(1);
    box-shadow: none;
  }

  .probe-block.is-lifted.is-lifted-raised {
    transform: scale(1.02);
    box-shadow: 0 0.85em 2.4em rgb(0 0 0 / 0.18);
  }

  .probe-block.is-lifted.is-lifted-raised.is-dropping {
    transform: scale(1.02);
    box-shadow: 0 0.85em 2.4em rgb(0 0 0 / 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .probe-block.is-lifted {
      transition: none;
    }
  }

  .probe-block__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding-inline: 1.25em;
    gap: 0.25em;
  }

  .probe-block__label {
    font-weight: 600;
  }

  .probe-block__meta {
    font-size: 0.85em;
    color: var(--color-text-muted, #6f6b62);
  }

  .probe-block__handle {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-control, 0.7em);
    background: var(--color-surface-soft, #f4f3f0);
    padding: 0.45em 0.55em;
    color: var(--color-text);
    box-shadow: 0 0.25em 0.8em rgb(0 0 0 / 0.08);
    cursor: grab;
    transform: translate(calc(-100% - 0.55em), -50%);
    touch-action: none;
  }

  .probe-block.is-probe-flip-moving {
    position: relative;
    z-index: 2;
    will-change: transform;
  }

  html.is-probe-lifting {
    touch-action: none;
    user-select: none;
  }

  html.is-probe-lifting .probe-block__handle {
    cursor: grabbing;
  }

  html.is-probe-lifting .probe-block:not(.is-lifted) .probe-block__handle {
    opacity: 0;
    pointer-events: none;
  }
</style>

<style is:global>
  .probe__drop-zone > .is-drop-preview-above {
    margin-bottom: 0 !important;
  }

  .probe-drop-indicator {
    display: grid;
    grid-template-rows: var(--gap-top, 0px) auto var(--gap-bottom, 0px);
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    pointer-events: none;
  }

  .probe-drop-indicator__body {
    grid-row: 2;
    min-height: 0;
    height: 0;
    box-sizing: border-box;
    border: 1px dashed transparent;
    background: transparent;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition:
      height 140ms ease-out,
      opacity 90ms ease-out,
      background-color 90ms ease-out,
      border-color 90ms ease-out;
  }

  .probe-drop-indicator.is-visible .probe-drop-indicator__body {
    height: var(--gap-height, 6em);
    opacity: 1;
    border-color: color-mix(in srgb, var(--color-text-muted, #6f6b62) 45%, transparent);
    background: color-mix(in srgb, var(--color-surface-soft, #f4f3f0) 85%, transparent);
  }

  .probe-drop-indicator.is-fading-out .probe-drop-indicator__body {
    opacity: 0;
    transition:
      opacity 90ms ease-out,
      background-color 90ms ease-out,
      border-color 90ms ease-out;
  }

  .probe-drop-indicator.is-visible.is-exiting .probe-drop-indicator__body,
  .probe-drop-indicator.is-exiting .probe-drop-indicator__body {
    height: 0;
    opacity: 0;
    transition:
      height 140ms ease-out,
      opacity 90ms ease-out,
      background-color 90ms ease-out,
      border-color 90ms ease-out;
  }

  .probe-drop-indicator.is-repositioning {
    transition: none !important;
  }

  .probe-drop-indicator.is-repositioning .probe-drop-indicator__body {
    transition-property: height, background-color, border-color;
    transition-duration: 0s;
    transition-timing-function: ease-out;
  }

  .probe-drop-indicator__body.is-drop-indicator-fade-ghost {
    position: fixed;
    margin: 0;
    box-sizing: border-box;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
    border: 1px dashed color-mix(in srgb, var(--color-text-muted, #6f6b62) 45%, transparent);
    background: color-mix(in srgb, var(--color-surface-soft, #f4f3f0) 85%, transparent);
    border-radius: var(--radius-control-smooth, 0.35em);
  }

  @media (prefers-reduced-motion: reduce) {
    .probe-drop-indicator__body {
      transition: none;
    }

    .probe-drop-indicator.is-visible .probe-drop-indicator__body {
      height: var(--gap-height, 6em);
      opacity: 1;
    }
  }
</style>
