---
import Button from '../../components/ui/Button.astro';
import Hairline from '../../components/ui/Hairline.astro';
import rotateIcon from 'lucide-static/icons/rotate-ccw.svg?raw';
import '../../styles/global.css';
import '../../styles/project.css';
const { mode = 'dome' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{mode === 'dome' ? 'Dome' : 'Flat lens'} — glass prototype</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" />
</head>
<body>
  <main class="prototype" data-mode={mode}>
    <div class="composition"><div class="composition-grid">
      <div class="image-area">
        <div class="image-stack" data-image-root>
          <img data-progressive-image src="/images/IMG_2480.thumb.webp" width="4032" height="3024" alt="Disassembled utility knife arranged on a gridded cutting mat" />
          <template data-image-template><img data-progressive-image src="/images/IMG_2480.thumb.webp" width="4032" height="3024" alt="Disassembled utility knife arranged on a gridded cutting mat" /></template>
        </div>
        <div class="glass-root">
          <canvas class="glass-source" aria-hidden="true"></canvas>
          <div class="lens" tabindex="0" role="group" aria-label="Magnifying glass. Drag or use arrow keys to move." hidden></div>
        </div>
      </div>
      <div class="actions dev-surface" role="group" aria-label="Image loading">
        <Button label="Load" emphasis="ghost" data-load />
        <Hairline orientation="vertical" />
        <Button label="" emphasis="ghost" aria-label="Reset" data-reset><span slot="icon" aria-hidden="true" set:html={rotateIcon} /></Button>
      </div>
      <p class="status" role="status">Preparing glass…</p>
    </div></div>
  </main>
</body>
</html>
<style>
  html, body { height: 100%; margin: 0; background: var(--comp-demo-frame-container); }
  .prototype { height: 100%; overflow: clip; display: grid; place-items: center; padding-inline: var(--space-unit); box-sizing: border-box; }
  .composition { position: relative; width: min(100%, 28em); height: 100%; container-type: inline-size; }
  .composition-grid { display: grid; height: 100%; grid-template-rows: 1fr 75cqw 1fr; justify-items: center; }
  .image-area { grid-row: 2; position: relative; width: 100%; height: 100%; }
  .image-stack { position: absolute; inset: 0; border-radius: var(--radius-control-smooth); overflow: hidden; }
  .image-stack img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .glass-root { position: absolute; inset: 0; }
  .glass-source { display: block; width: 100%; height: 100%; border-radius: var(--radius-control-smooth); pointer-events: none; }
  .prototype[data-mode="flat"] .glass-source { opacity: 0; }
  .lens { position: absolute; left: 0; top: 0; width: 180px; height: 180px; border-radius: 50%; z-index: 1; cursor: grab; touch-action: none; outline-offset: 4px; }
  .lens[hidden] { display: none; }
  .lens:focus-visible { outline: 2px solid var(--sys-color-on-srf); }
  .actions { grid-row: 3; align-self: center; display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: 12px; }
  .actions :global(.dev-hairline) { margin-inline: 2px; }
  .actions :global(.dev-btn__icon svg) { width: 16px; height: 16px; }
  .actions :global([data-load]::before) { right: -6px; }
  .actions :global([data-reset]::before) { left: -6px; }
  .status { position: absolute; bottom: 8px; margin: 0; font: var(--dev-text-label); color: var(--sys-color-on-srf-variant); }
  .status:empty { display: none; }
  @media (pointer: coarse) { .actions :global(.dev-btn) { min-height: 44px; } }
</style>
<script>
  import { LiquidGlass } from '@ybouane/liquidglass';
  import { createImagePreviewUpgrade } from '../../lib/imagePreviewUpgrade';
  const host = document.querySelector('.prototype');
  const root = host.querySelector('.glass-root');
  const source = host.querySelector('.glass-source');
  const stack = host.querySelector('[data-image-root]');
  const lens = host.querySelector('.lens');
  const load = host.querySelector('[data-load]');
  const reset = host.querySelector('[data-reset]');
  const status = host.querySelector('.status');
  const toolbar = host.querySelector('.actions');
  let toolbarImage;
  let toolbarPending = false;
  let toolbarCapturing = false;
  const template = host.querySelector('template');
  const context = source.getContext('2d');
  const mask = document.createElement('canvas');
  const maskContext = mask.getContext('2d');
  const lifecycle = new AbortController();
  const { signal } = lifecycle;
  let glass;
  let upgrade;
  let generation = 0;
  let frame = 0;
  let config = { diameter: 180, boundaryCircle: 26, zoom: 2.5, zRadius: 36, bevelWidth: 32, rimWidth: 1.2, sheen: 0.6, colourPickup: 0.12, glowStrength: 0.33, glowSpread: 10, refraction: 0.5, edgeHighlight: 0.01, specular: 0.3, shadowOpacity: 0.33 };
  let position = { x: 0, y: 0 };
  let pointer;
  let springFrame = 0;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const bounds = () => {
    const inset = lens.offsetWidth * (1 - config.boundaryCircle / 100) / 2;
    return { min: -inset, x: Math.max(0, root.clientWidth - lens.offsetWidth) + inset, y: Math.max(0, root.clientHeight - lens.offsetHeight) + inset };
  };
  const clamp = (value, max) => Math.max(bounds().min, Math.min(max, value));
  const resistance = (value, max) => {
    const edge = clamp(value, max);
    const distance = value - edge;
    const reach = config.diameter * 0.16;
    return edge + distance / (1 + Math.abs(distance) / reach);
  };
  const unresist = (value, max) => {
    const edge = clamp(value, max);
    const distance = value - edge;
    return edge + distance / Math.max(0.01, 1 - Math.abs(distance) / (config.diameter * 0.16));
  };
  function stopSpring() { cancelAnimationFrame(springFrame); springFrame = 0; }
  function settle(velocity = { x: 0, y: 0 }) {
    stopSpring();
    const limit = bounds();
    const target = { x: clamp(position.x, limit.x), y: clamp(position.y, limit.y) };
    const offset = { x: position.x - target.x, y: position.y - target.y };
    if (reducedMotion.matches || (!offset.x && !offset.y)) { position = target; place(); return; }
    const start = performance.now();
    const tick = (now) => {
      const t = (now - start) / 1000;
      let complete = true;
      for (const axis of ['x', 'y']) {
        let speed = offset[axis] ? Math.max(-600, Math.min(600, velocity[axis])) : 0;
        if (speed * offset[axis] > 0) speed = Math.sign(speed) * Math.min(Math.abs(speed), Math.max(0, config.diameter * 0.16 - Math.abs(offset[axis])) * 14);
        const delta = Math.exp(-22 * t) * (offset[axis] * Math.cos(14 * t) + (speed + 22 * offset[axis]) / 14 * Math.sin(14 * t));
        position[axis] = target[axis] + delta;
        if (Math.abs(delta) > 0.05) complete = false;
      }
      place();
      if ((complete && t > 0.15) || t >= 0.65) { position = target; place(); springFrame = 0; }
      else springFrame = requestAnimationFrame(tick);
    };
    springFrame = requestAnimationFrame(tick);
  }

  async function captureToolbar() {
    toolbarPending = true;
    if (!glass || toolbarCapturing || signal.aborted) return;
    toolbarCapturing = true;
    try {
      while (toolbarPending && !signal.aborted) {
        toolbarPending = false;
        const rect = toolbar.getBoundingClientRect();
        const captured = await glass.capture.captureToCanvas(toolbar, rect.width, rect.height);
        if (signal.aborted) return;
        toolbarImage = captured;
        drawSource();
      }
    } finally { toolbarCapturing = false; }
  }

  function currentImage() { return stack.querySelector('[data-progressive-image]'); }

  function drawSource() {
    const image = currentImage();
    if (!image?.complete || !image.naturalWidth) return;
    const padding = host.dataset.mode === 'flat' ? config.diameter : 0;
    const cssWidth = root.clientWidth + padding * 2;
    const cssHeight = root.clientHeight + padding * 2;
    const width = Math.min(2048, Math.round(cssWidth * Math.min(devicePixelRatio, 2) * 2));
    const scale = width / cssWidth;
    const height = Math.round(cssHeight * scale);
    const imageWidth = root.clientWidth * scale;
    const imageHeight = root.clientHeight * scale;
    const origin = padding * scale;
    source.style.position = 'absolute';
    source.style.left = source.style.top = `${-padding}px`;
    source.style.width = `${cssWidth}px`;
    source.style.height = `${cssHeight}px`;
    if (source.width !== width || source.height !== height) {
      source.width = width;
      source.height = height;
    }
    if (mask.width !== Math.round(imageWidth) || mask.height !== Math.round(imageHeight)) {
      mask.width = Math.round(imageWidth);
      mask.height = Math.round(imageHeight);
    }
    context.resetTransform();
    context.clearRect(0, 0, width, height);
    context.fillStyle = getComputedStyle(document.body).backgroundColor;
    context.fillRect(0, 0, width, height);
    context.save();
    if (host.dataset.mode === 'flat') {
      // The invisible canvas supplies magnified pixels only to the glass renderer.
      const centerX = (position.x + lens.offsetWidth / 2 + padding) * scale;
      const centerY = (position.y + lens.offsetHeight / 2 + padding) * scale;
      context.setTransform(config.zoom, 0, 0, config.zoom, centerX * (1 - config.zoom), centerY * (1 - config.zoom));
    }
    const style = getComputedStyle(stack);
    const radii = [style.borderTopLeftRadius, style.borderTopRightRadius, style.borderBottomRightRadius, style.borderBottomLeftRadius].map((radius) => parseFloat(radius) * scale);
    context.save();
    context.beginPath();
    context.roundRect(origin, origin, imageWidth, imageHeight, radii);
    context.clip();
    context.drawImage(image, origin, origin, imageWidth, imageHeight);
    const reveal = stack.querySelector('[data-preview-reveal]');
    if (reveal?.complete && reveal.naturalWidth) {
      // Mirror the shared loader's 22% feather; replace this adapter if its mask changes.
      const progress = parseFloat(getComputedStyle(reveal).getPropertyValue('--preview-reveal-y')) / 100 || 0;
      const start = Math.max(0, progress - 0.22);
      const end = Math.min(1, progress + 0.22);
      maskContext.clearRect(0, 0, mask.width, mask.height);
      maskContext.globalCompositeOperation = 'source-over';
      maskContext.drawImage(reveal, 0, 0, mask.width, mask.height);
      const gradient = maskContext.createLinearGradient(0, 0, 0, mask.height);
      gradient.addColorStop(start, '#000');
      gradient.addColorStop(end, 'transparent');
      maskContext.globalCompositeOperation = 'destination-in';
      maskContext.fillStyle = gradient;
      maskContext.fillRect(0, 0, mask.width, mask.height);
      maskContext.globalCompositeOperation = 'source-over';
      context.drawImage(mask, origin, origin, imageWidth, imageHeight);
    }
    context.restore();
    if (toolbarImage && host.dataset.mode === 'flat') {
      const rect = toolbar.getBoundingClientRect();
      const rootRect = root.getBoundingClientRect();
      context.drawImage(toolbarImage, (rect.left - rootRect.left + padding) * scale, (rect.top - rootRect.top + padding) * scale, rect.width * scale, rect.height * scale);
    }
    context.restore();
    glass?.markChanged(source);
  }

  function followReveal() {
    cancelAnimationFrame(frame);
    const tick = () => {
      if (signal.aborted) return;
      drawSource();
      if (stack.querySelector('[data-preview-reveal]')) frame = requestAnimationFrame(tick);
    };
    tick();
  }

  function place() {
    lens.style.transform = `translate(${position.x}px, ${position.y}px)`;
    if (host.dataset.mode === 'flat') drawSource();
    glass?.markChanged();
  }

  function configure() {
    stopSpring();
    if (pointer) { const id = pointer.id; pointer = undefined; if (lens.hasPointerCapture(id)) lens.releasePointerCapture(id); lens.style.cursor = 'grab'; }
    const diameter = Math.min(config.diameter, root.clientWidth - 16, root.clientHeight - 16);
    lens.style.width = lens.style.height = `${diameter}px`;
    lens.dataset.config = JSON.stringify({
      floating: false, blurAmount: 0, refraction: config.refraction,
      cornerRadius: diameter / 2, zRadius: host.dataset.mode === 'dome' ? diameter / 2 : config.zRadius,
      bevelMode: host.dataset.mode === 'dome' ? 1 : 2,
      bevelWidth: config.bevelWidth, rimWidth: config.rimWidth, sheen: config.sheen,
      colourPickup: config.colourPickup, glowStrength: config.glowStrength, glowSpread: config.glowSpread,
      edgeHighlight: config.edgeHighlight, specular: config.specular, shadowOpacity: config.shadowOpacity,
      chromAberration: 0.025, shadowSpread: 10,
    });
    const limit = bounds();
    position = { x: clamp(position.x, limit.x), y: clamp(position.y, limit.y) };
    place();
  }

  lens.addEventListener('pointerdown', (event) => {
    if (!event.isPrimary || event.button !== 0) return;
    if (pointer) return;
    stopSpring();
    const limit = bounds();
    pointer = { id: event.pointerId, x: event.clientX, y: event.clientY,
      origin: { x: unresist(position.x, limit.x), y: unresist(position.y, limit.y) },
      time: performance.now(), velocity: { x: 0, y: 0 } };
    lens.setPointerCapture(event.pointerId);
    lens.style.cursor = 'grabbing';
    event.preventDefault();
  }, { signal });
  lens.addEventListener('pointermove', (event) => {
    if (!pointer || pointer.id !== event.pointerId) return;
    const limit = bounds();
    const next = { x: resistance(pointer.origin.x + event.clientX - pointer.x, limit.x), y: resistance(pointer.origin.y + event.clientY - pointer.y, limit.y) };
    const now = performance.now();
    const elapsed = Math.max(1, now - pointer.time) / 1000;
    pointer.velocity = { x: (next.x - position.x) / elapsed, y: (next.y - position.y) / elapsed };
    pointer.time = now;
    position = next;
    place();
  }, { signal });
  const release = (event) => {
    if (!pointer || pointer.id !== event.pointerId) return;
    const velocity = event.type === 'pointerup' && performance.now() - pointer.time < 80 ? pointer.velocity : { x: 0, y: 0 };
    const id = pointer.id;
    pointer = undefined;
    if (lens.hasPointerCapture(id)) lens.releasePointerCapture(id);
    lens.style.cursor = 'grab';
    settle(velocity);
  };
  for (const event of ['pointerup', 'pointercancel', 'lostpointercapture']) lens.addEventListener(event, release, { signal });
  lens.addEventListener('keydown', (event) => {
    const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
    const direction = directions[event.key];
    if (!direction) return;
    event.preventDefault();
    if (pointer) return;
    stopSpring();
    const limit = bounds();
    const step = event.shiftKey ? 20 : 8;
    position.x = clamp(position.x + direction[0] * step, limit.x);
    position.y = clamp(position.y + direction[1] * step, limit.y);
    place();
  }, { signal });

  load.addEventListener('click', () => {
    if (load.disabled) return;
    const run = ++generation;
    upgrade?.destroy();
    load.disabled = true;
    status.textContent = '';
    currentImage().dataset.imagePreview = '/images/IMG_2480.preview.webp';
    upgrade = createImagePreviewUpgrade({ onError: () => {
      if (run !== generation || signal.aborted) return;
      upgrade?.destroy();
      load.disabled = false;
      status.textContent = 'Image unavailable. Try Load again.';
      drawSource();
    } });
    upgrade.bind(stack);
    upgrade.open();
  }, { signal });

  reset.addEventListener('click', () => {
    generation += 1;
    upgrade?.destroy();
    cancelAnimationFrame(frame);
    currentImage().remove();
    stack.prepend(template.content.cloneNode(true));
    currentImage().addEventListener('load', drawSource, { once: true, signal });
    load.disabled = false;
    status.textContent = '';
    drawSource();
  }, { signal });

  reducedMotion.addEventListener('change', () => { if (reducedMotion.matches && springFrame) settle(); }, { signal });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { configure(); }
  }, { signal });
  const observer = new MutationObserver(followReveal);
  observer.observe(stack, { childList: true, subtree: true, attributes: true, attributeFilter: ['src', 'data-image-upgraded', 'class'] });
  const toolbarObserver = new MutationObserver(captureToolbar);
  toolbarObserver.observe(toolbar, { attributes: true, childList: true, characterData: true, subtree: true });
  for (const event of ['pointerover', 'pointerout', 'pointerdown', 'pointerup', 'focusin', 'focusout', 'transitionend']) toolbar.addEventListener(event, captureToolbar, { signal });
  const toolbarResize = new ResizeObserver(captureToolbar);
  toolbarResize.observe(toolbar);
  const resize = new ResizeObserver(() => { configure(); drawSource(); });
  resize.observe(root);
  window.addEventListener('message', (event) => {
    if (event.origin !== location.origin || event.source !== parent || event.data?.type !== 'glass-proto-config') return;
    const next = event.data.config;
    const ranges = { diameter: [100, 220], boundaryCircle: [0, 100], zoom: [1, 4], zRadius: [1, 50], bevelWidth: [12, 48], rimWidth: [0.5, 3], sheen: [0, 1], colourPickup: [0, 1], glowStrength: [0, 0.5], glowSpread: [4, 40], refraction: [0, 2], edgeHighlight: [0, 0.3], specular: [0, 1], shadowOpacity: [0, 0.5] };
    for (const key of Object.keys(ranges)) {
      const value = Number(next?.[key]);
      if (Number.isFinite(value)) config[key] = Math.max(ranges[key][0], Math.min(ranges[key][1], value));
    }
    configure();
  }, { signal });

  async function initialize() {
    try {
      await currentImage().decode();
      await document.fonts.ready;
      if (signal.aborted) return;
      drawSource();
      lens.hidden = false;
      position = { x: root.clientWidth * 0.76 - config.diameter / 2, y: root.clientHeight * 0.31 - config.diameter / 2 };
      configure();
      const instance = await LiquidGlass.init({ root, glassElements: [lens] });
      if (signal.aborted) { instance.destroy(); return; }
      glass = instance;
      await captureToolbar();
      drawSource();
      status.textContent = '';
    } catch (error) {
      lens.hidden = true;
      status.textContent = 'Glass unavailable in this browser. Load and Reset still work.';
      console.error('Liquid glass prototype:', error);
    }
  }
  initialize();
  window.addEventListener('pagehide', () => {
    stopSpring();
    lifecycle.abort();
    generation += 1;
    observer.disconnect();
    toolbarObserver.disconnect();
    toolbarResize.disconnect();
    toolbarImage = undefined;
    resize.disconnect();
    cancelAnimationFrame(frame);
    upgrade?.destroy();
    glass?.destroy();
  }, { once: true });
</script>
