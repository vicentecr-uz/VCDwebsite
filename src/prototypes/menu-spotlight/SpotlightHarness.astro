---
const sliders = [
  { key: 'radius', label: 'Circle radius', min: 24, max: 400, step: 1, value: 140 },
  { key: 'feather', label: 'Feather width', min: 0, max: 300, step: 1, value: 80 },
  { key: 'opacity', label: 'Veil opacity', min: 0, max: 1, step: 0.01, value: 0.8 },
  { key: 'startDelay', label: 'Circle start delay', min: 0, max: 2000, step: 25, value: 0 },
  { key: 'circleIn', label: 'Circle in duration', min: 100, max: 2400, step: 25, value: 700 },
  { key: 'veilHold', label: 'Minimum veil hold', min: 0, max: 3000, step: 25, value: 300 },
  { key: 'circleOut', label: 'Circle out duration', min: 0, max: 2000, step: 25, value: 500 },
  { key: 'exitOffset', label: 'Veil exit offset from demo start', min: -2000, max: 2000, step: 25, value: 0 },
  { key: 'cursorOffset', label: 'Cursor fade offset from circle end', min: -2000, max: 2000, step: 25, value: -200 },
  { key: 'cursorWait', label: 'Cursor wait after fade', min: 0, max: 3000, step: 25, value: 600 },
];
---

<div data-menu-spotlight-harness>
  <div class="spotlight-veil" data-spotlight-veil aria-hidden="true" hidden>
    <svg class="spotlight-surface" width="100%" height="100%" aria-hidden="true">
      <defs>
        <radialGradient id="menu-spotlight-feather" color-interpolation="sRGB">
          <stop offset="0" stop-color="#000" />
          <stop data-spotlight-stop="0" offset="0" stop-color="#000" />
          <stop data-spotlight-stop=".25" offset=".25" stop-color="#282828" />
          <stop data-spotlight-stop=".5" offset=".5" stop-color="#808080" />
          <stop data-spotlight-stop=".75" offset=".75" stop-color="#d7d7d7" />
          <stop data-spotlight-stop="1" offset="1" stop-color="#fff" />
        </radialGradient>
        <mask id="menu-spotlight-mask" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%" style="mask-type: luminance">
          <rect width="100%" height="100%" fill="#fff" />
          <circle class="spotlight-iris" data-spotlight-iris cx="0" cy="0" r="220" fill="url(#menu-spotlight-feather)" />
        </mask>
      </defs>
      <rect class="spotlight-fill" width="100%" height="100%" mask="url(#menu-spotlight-mask)" />
    </svg>
  </div>
  <aside class="spotlight-controls" data-spotlight-panel data-dev-panel-draggable aria-label="Spotlight controls">
    <header data-drag-handle><span>Spotlight</span><span aria-hidden="true">⠿</span></header>
    <div class="spotlight-states" role="group" aria-label="Hold demo state">
      <button type="button" data-spotlight-state="start" aria-pressed="false">Start</button>
      <button type="button" data-spotlight-state="settled" aria-pressed="false">Spotlight settled</button>
      <button type="button" data-spotlight-state="menu" aria-pressed="false">Menu open</button>
      <button type="button" data-spotlight-state="end" aria-pressed="false">End</button>
    </div>
    <details open data-spotlight-controls>
      <summary>Controls</summary>
      <div class="spotlight-control-list">
        {sliders.map(({ key, label, min, max, step, value }) => (
          <label for={`spotlight-${key}`}>
            <span>{label}</span>
            <output for={`spotlight-${key}`} data-value={key}></output>
            <input id={`spotlight-${key}`} data-control={key} type="range" min={min} max={max} step={step} value={value} />
          </label>
        ))}
        <label for="spotlight-easing">
          <span>Circle easing</span>
          <select id="spotlight-easing" data-control="easing">
            <option value="cubic-bezier(.215,.61,.355,1)">Ease out cubic</option>
            <option value="cubic-bezier(.165,.84,.44,1)">Ease out quart</option>
            <option value="cubic-bezier(.23,1,.32,1)">Ease out quint</option>
            <option value="cubic-bezier(.645,.045,.355,1)">Ease in-out cubic</option>
          </select>
        </label>
        <label for="spotlight-speed">
          <span>Playback speed</span>
          <select id="spotlight-speed" data-control="speed">
            <option value="1">1×</option>
            <option value=".5">0.5×</option>
            <option value=".25">0.25×</option>
          </select>
        </label>
        <dl class="spotlight-anchors">
          <div><dt>Circle settled</dt><dd data-anchor="circleEnd">0 ms</dd></div>
          <div><dt>Cursor visible</dt><dd data-anchor="cursorVisible">0 ms</dd></div>
          <div><dt>Demo starts</dt><dd data-anchor="demoStart">0 ms</dd></div>
          <div><dt>Veil out starts</dt><dd data-anchor="veilOutStart">0 ms</dd></div>
        </dl>
        <button type="button" data-copy-settings>Copy settings</button>
        <textarea readonly rows="3" data-settings-output aria-label="Spotlight settings" spellcheck="false"></textarea>
      </div>
    </details>
  </aside>
  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    <button class="proto-picker-item" data-active aria-current="true">Spotlight</button>
    <span class="proto-picker-divider" aria-hidden="true"></span>
    <button class="proto-picker-item proto-picker-replay" aria-label="Replay animation (R)">↻</button>
  </nav>
</div>

<script>
  import './spotlight';
</script>

<style>
  .spotlight-veil {
    position: fixed;
    inset: 0;
    z-index: 199;
    pointer-events: none;
    overflow: hidden;
  }

  .spotlight-surface { display: block; width: 100%; height: 100%; }
  [data-spotlight-iris] { transform-box: view-box; transform-origin: 0 0; }
  .spotlight-fill { fill: var(--sys-color-srf); opacity: var(--spotlight-opacity, .8); }
  .spotlight-states { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 0 16px 8px; }
  .spotlight-states button[aria-pressed="true"] { border-color: rgba(255, 255, 255, .72); background: rgba(255, 255, 255, .16); }

  .spotlight-controls {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 2147483647;
    width: min(320px, calc(100vw - 32px));
    border-radius: 12px;
    background: rgba(10, 10, 10, .92);
    color: #fff;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .12) inset, 0 8px 24px rgba(0, 0, 0, .24);
    font: 13px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .spotlight-controls > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0 16px;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .spotlight-controls.is-dragging > header { cursor: grabbing; }
  .spotlight-controls summary { min-height: 44px; padding: 12px 16px; cursor: pointer; user-select: none; }

  .spotlight-control-list {
    display: grid;
    gap: 12px;
    max-height: calc(var(--vh-safe, 1svh) * 100 - 312px);
    overflow: auto;
    padding: 0 16px 16px;
    border-radius: 0 0 12px 12px;
  }

  .spotlight-control-list label { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 12px; }
  .spotlight-control-list input, .spotlight-control-list select, .spotlight-control-list textarea {
    width: 100%; min-width: 0; font-size: 16px; accent-color: #fff;
  }
  .spotlight-control-list input[type="range"], .spotlight-control-list select {
    grid-column: 1 / -1; min-height: 44px; touch-action: manipulation;
  }
  .spotlight-control-list select {
    padding: 0 8px; border: 1px solid rgba(255, 255, 255, .24); border-radius: 6px; background: #262626; color: #fff;
  }
  .spotlight-control-list output, .spotlight-anchors dd { color: rgba(255, 255, 255, .75); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .spotlight-control-list button, .spotlight-states button {
    min-height: 44px; border: 1px solid rgba(255, 255, 255, .24); border-radius: 6px; background: transparent;
    color: #fff; font: inherit; cursor: pointer; touch-action: manipulation;
  }
  .spotlight-control-list button:active, .spotlight-states button:active { background: rgba(255, 255, 255, .12); }
  .spotlight-controls :focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .spotlight-control-list textarea {
    padding: 8px; resize: vertical; border: 1px solid rgba(255, 255, 255, .24); border-radius: 6px;
    background: #262626; color: #fff; font-family: ui-monospace, monospace; line-height: 1.4;
  }
  .spotlight-anchors { display: grid; gap: 4px; margin: 0; }
  .spotlight-anchors div { display: flex; justify-content: space-between; gap: 12px; }
  .spotlight-anchors dt, .spotlight-anchors dd { margin: 0; }

  @media (max-width: 40em) {
    .spotlight-controls { top: 16px; right: 16px; }
  }

.proto-picker {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2147483647;
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 4px;
  border-radius: 999px;
  background: rgba(10, 10, 10, 0.82);
  -webkit-backdrop-filter: blur(12px) saturate(1.4);
  backdrop-filter: blur(12px) saturate(1.4);
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, 0.08) inset,
    0 8px 24px rgba(0, 0, 0, 0.24),
    0 2px 6px rgba(0, 0, 0, 0.12);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 13px;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  user-select: none;
  -webkit-user-select: none;
}

.proto-picker-highlight {
  position: absolute;
  top: 4px;
  left: 0;
  height: 28px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  will-change: transform;
}

/* The slide is enabled only after first paint (data-ready), so load doesn't animate. */
.proto-picker[data-ready] .proto-picker-highlight {
  transition:
    transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
    width 250ms cubic-bezier(0.23, 1, 0.32, 1);
}

@media (prefers-reduced-motion: reduce) {
  .proto-picker[data-ready] .proto-picker-highlight { transition: none; }
}

.proto-picker-item {
  position: relative; /* sits above the highlight */
  display: flex;
  align-items: center;
  height: 28px;
  padding: 0 12px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: rgba(255, 255, 255, 0.55);
  font: inherit;
  cursor: pointer;
  transition: color 150ms ease-out;
}

.proto-picker-item:hover {
  color: rgba(255, 255, 255, 0.85);
}

.proto-picker-item:active {
  transform: scale(0.97);
}

.proto-picker-item:focus-visible {
  outline: 2px solid rgba(255, 255, 255, 0.4);
  outline-offset: 2px;
}

.proto-picker-item[data-active] {
  color: #fff;
}

.proto-picker-divider {
  width: 1px;
  height: 16px;
  margin: 0 4px;
  background: rgba(255, 255, 255, 0.12);
}

.proto-picker-replay {
  padding: 0 10px;
  font-size: 14px;
}

.proto-picker[data-position="top"] {
  bottom: auto;
  top: 24px;
}
</style>
