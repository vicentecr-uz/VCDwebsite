  "sys": {
    "color": {
      "srf": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.1000}",
            "dark": "{ref.palette.grey.100}"
          }
        },
        "$value": "{ref.palette.grey.1000}"
      },
      "srf-container": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.900}",
            "dark": "{ref.palette.grey.200}"
          }
        },
        "$value": "{ref.palette.grey.900}"
      },
      "srf-container-high": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.800}",
            "dark": "{ref.palette.grey.300}"
          }
        },
        "$value": "{ref.palette.grey.800}"
      },
      "inverse-srf": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.0}",
            "dark": "{ref.palette.grey.950}"
          }
        },
        "$value": "{ref.palette.grey.0}"
      },
      "inverse-srf-hover": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.100}",
            "dark": "{ref.palette.grey.1000}"
          }
        },
        "$value": "{ref.palette.grey.100}"
      },
      "on-srf": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.100}",
            "dark": "{ref.palette.grey.1000}"
          }
        },
        "$value": "{ref.palette.grey.100}"
      },
      "on-srf-variant": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.300}",
            "dark": "{ref.palette.grey.700}"
          }
        },
        "$value": "{ref.palette.grey.300}",
        "$description": "Secondary ink - de-emphasised copy that is still primary content. Absorbed the old on-srf-muted (Material 3 stops at two ink weights, so the third was dropped)."
      },
      "on-srf-subtle": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.600}",
            "dark": "{ref.palette.grey.400}"
          }
        },
        "$value": "{ref.palette.grey.600}"
      },
      "on-light-media": {
        "$type": "color",
        "$extensions": {
          "modes": {
            "light": "{ref.palette.grey.400}",
            "dark": "{ref.palette.grey.400}"
          }
        },
        "$value": "{ref.palette.grey.400}",
        "$description": "Theme-stable ink for content sitting on imagery; light/dark modes are identical on purpose (page theme must not remap). Photo ground, not page ground."
