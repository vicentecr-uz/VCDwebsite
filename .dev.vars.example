# Local / Cloudflare Pages secrets for homepage signup → listmonk.
# Copy to `.dev.vars` in the repo root (gitignored). Never commit real tokens.
#
# LISTMONK_LIST_ID is the numeric id of list "Vicente Cruz — Updates".

LISTMONK_URL=https://listmonk.example.com
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_LIST_ID=

# Optional. In local DEV, GET /api/signup-pref works without this.
# Production results: /email-signup-testing?results=1&key=...
# SIGNUP_PREF_KEY=
